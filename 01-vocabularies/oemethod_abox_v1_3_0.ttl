configuration:DocumentationFileConvention a configuration:NamingConvention,
        owl:NamedIndividual ;
    rdfs:label "Documentation File Naming Convention"@en ;
    configuration:appliesToArtifactType configuration:DocumentationFile ;
    configuration:filenamePattern "{name}_v{M}_{m}.md" ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD sprint April 2026 — gap remediation. ISO/IEC 26514:2022 documentation engineering."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    skos:definition "The mandatory filename pattern for a reliability ontology ecosystem documentation files (configuration:DocumentationFile): {name}_v{M}_{m}.md — underscore delimiter, two-part versioning (major.minor). Example: ontology_ecosystem_architecture_v1.1.md. Uses UNDERSCORE (not DOT) to be consistent with all other ecosystem artefact types. Only configuration:SafeguardDocument uses DOT delimiter — see configuration:SafeguardDotDelimiterException for the rationale."@en ;
    skos:example """ontology_ecosystem_architecture_v1.1.md — name='ontology_ecosystem_architecture', M=1, m=1 ✓
oqc_bridge_guide_v1.0.md — name='oqc_bridge_guide', M=1, m=0 ✓"""@en .

configuration:USOShapeModuleConvention a configuration:NamingConvention,
        owl:NamedIndividual ;
    rdfs:label "USOShapeModule Convention"@en ;
    configuration:appliesToArtifactType configuration:USOShapeModule ;
    configuration:filenamePattern "uso-{module}-shacl-v{M}_{m}.ttl" ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "USO v2 modular ecosystem. AMOD BS-04 gap remediation April 2026."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    skos:definition "Naming convention for USO SHACL shape modules. Parallel to USOVocabularyModuleConvention with '-shacl-' infix. Differs from AMOD ShapeFileConvention (underscore, three-part)."@en ;
    skos:example "uso-discovery-shacl-v1_0.ttl (module=discovery, M=1, m=0)"@en .

configuration:USOTestModuleConvention a configuration:NamingConvention,
        owl:NamedIndividual ;
    rdfs:label "USOTestModule Convention"@en ;
    configuration:appliesToArtifactType configuration:USOTestModule ;
    configuration:filenamePattern "uso-{module}-tests-v{M}_{m}.ttl" ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "USO v2 modular ecosystem. AMOD BS-04 gap remediation April 2026."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    skos:definition "Naming convention for USO test suite modules. Parallel to USOVocabularyModuleConvention with '-tests-' infix. No equivalent AMOD convention existed before this registration."@en ;
    skos:example "uso-discovery-tests-v1_0.ttl (module=discovery, M=1, m=0)"@en .

configuration:USOVocabularyModuleConvention a configuration:NamingConvention,
        owl:NamedIndividual ;
    rdfs:label "USOVocabularyModule Convention"@en ;
    configuration:appliesToArtifactType configuration:USOVocabularyModule ;
    configuration:filenamePattern "uso-{module}-v{M}_{m}.ttl" ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "USO v2 modular ecosystem. AMOD BS-04 gap remediation April 2026."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    skos:definition "Naming convention for USO domain vocabulary modules. Uses HYPHEN separator between 'uso', the module name, and the version token. Version is two-part (M_m) without a patch component. This differs from AMOD OntologyFileConvention (underscore separator, three-part version) — see configuration:USODelimiterException."@en ;
    skos:example "uso-discovery-v1_0.ttl (module=discovery, M=1, m=0)"@en .

measurement:MC_AnnotationRichness a measurement:MetricCategory,
        owl:NamedIndividual ;
    rdfs:label "AnnotationRichness"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    skos:definition "Metrics on documentation/annotation density (e.g. annotation properties per class)."@en ;
    skos:scopeNote "OEE ruling 2026-06-07: admits BOTH annotation DENSITY metrics (e.g. ANOnto: annotations per class) and annotation COVERAGE metrics (e.g. % classes carrying >=1 annotation). These measure different attributes (density vs coverage) and are COMPLEMENTARY, not duplicative under the T3 federated duplication rule."@en .

