ae:QuadraticTime a ae:EfficiencyClass,
        owl:NamedIndividual ;
    rdfs:label "Quadratic Time"@en ;
    ae:growthOrder "n^2" ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Table 2.2"@en ;
    skos:definition "The efficiency class typical of algorithms with two nested loops, including elementary sorting algorithms and brute-force solutions to the element uniqueness problem."@en ;
    skos:example "Element uniqueness via brute force: C_worst(n) = n(n-1)/2." .

ae:SETH_Hypothesis a ae:TractabilityAssumption,
        owl:NamedIndividual ;
    rdfs:label "Strong Exponential Time Hypothesis"@en ;
    ae:yearIntroduced "2001"^^xsd:int ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Impagliazzo and Paturi 2001 On the Complexity of k-SAT JCSS 62(2)"@en ;
    skos:definition "The hypothesis that for every epsilon > 0 there exists k such that k-SAT cannot be solved in O(2^((1-epsilon)*n)) time, providing conditional lower bounds for many polynomial-time problems in fine-grained complexity."@en ;
    skos:example "SETH implies no O(n^(2-epsilon)) algorithm for Edit Distance." .

ae:SPEC_Suite a ae:BenchmarkingSuite,
        owl:NamedIndividual ;
    rdfs:label "SPEC CPU Benchmark"@en ;
    ae:benchmarkURL "https://www.spec.org/cpu/"^^xsd:anyURI ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Standard Performance Evaluation Corporation SPEC CPU 2017"@en ;
    skos:definition "A standardized CPU benchmarking suite providing compute-intensive workloads for measuring and comparing processor performance, widely used in empirical algorithm analysis and hardware evaluation."@en ;
    skos:example "SPEC CPU 2017 integer benchmarks include compilation and AI workloads." .

ae:SortingOutSorting a ae:HistoricalCaseStudy,
        owl:NamedIndividual ;
    rdfs:label "Sorting Out Sorting Film"@en ;
    ae:publicationYear "1981"^^xsd:int ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Baecker 1981 Sorting Out Sorting University of Toronto"@en ;
    skos:definition "A landmark 1981 algorithm visualization film animating nine sorting algorithms with bar and scatterplot representations, establishing algorithm animation as a field and demonstrating practical impact of complexity differences."@en ;
    skos:example "The film visually showed O(n log n) mergesort outperforming O(n^2) selection sort." .

ae:SpielmanTeng_Contributors a ae:KeyContributor,
        owl:NamedIndividual ;
    rdfs:label "Spielman and Teng"@en ;
    ae:publicationYear "2004"^^xsd:int ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Spielman and Teng 2004 Smoothed Analysis of Algorithms JACM 51(3)"@en ;
    skos:definition "Daniel Spielman and Shang-Hua Teng who introduced smoothed analysis in 2001, resolving why the simplex algorithm performs well in practice despite exponential worst-case complexity."@en ;
    skos:example "Smoothed analysis shows simplex runs in polynomial expected time under perturbation." .

ae:Tarjan_Contributor a ae:KeyContributor,
        owl:NamedIndividual ;
    rdfs:label "Robert Tarjan"@en ;
    ae:publicationYear "1985"^^xsd:int ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Tarjan 1985 Amortized Computational Complexity SIAM J"@en ;
    skos:definition "American computer scientist who formalized amortized analysis in 1985, invented splay trees and self-adjusting data structures, and made fundamental contributions to graph algorithms with tight complexity analyses."@en ;
    skos:example "Tarjan introduced the potential method for amortized analysis of splay trees." .

ae:ThreeSUM_Hypothesis a ae:TractabilityAssumption,
        owl:NamedIndividual ;
    rdfs:label "3SUM Hypothesis"@en ;
    ae:yearIntroduced "1999"^^xsd:int ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Gajentaan and Overmars 1995 n^2-hard Problems in Computational Geometry CGTA"@en ;
    skos:definition "The conjecture that no algorithm can solve the 3SUM problem (finding three numbers summing to zero among n integers) in truly subquadratic time, used to derive conditional lower bounds for computational geometry problems."@en ;
    skos:example "3SUM-hardness implies Omega(n^2) for testing point set degeneracy." .

