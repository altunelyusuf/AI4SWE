    rdfs:seeAlso <https://oops.linkeddata.es/catalogue.jsp> ;
    skos:definition "The contents of some annotation properties are swapped or misused. May affect annotation properties related to natural language information, temporal, versioning information, among others."@en .

quality:Pitfall_P21 a quality:Pitfall,
        owl:NamedIndividual ;
    rdfs:label "P21: Using a miscellaneous class"@en ;
    quality:hasImportance quality:Importance_Minor ;
