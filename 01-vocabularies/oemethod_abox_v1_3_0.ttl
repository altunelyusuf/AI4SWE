quality:I_AttributeRichness a measurement:DescriptiveMetric,
        measurement:QualityMetric,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Attribute Richness"@en ;
    quality:hasSPARQLImplementation """SELECT (?dp_count / ?class_count AS ?value) WHERE {
  { SELECT (COUNT(DISTINCT ?dp) AS ?dp_count) WHERE { ?dp a owl:DatatypeProperty } }
  { SELECT (COUNT(DISTINCT ?c) AS ?class_count) WHERE { ?c a owl:Class . FILTER(isIRI(?c)) } }
}""" ;
    quality:measuresCriterion quality:QualityCriterion_OntologyStructuralQuality ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OQC v2.3.3 — declared in metric bridge PATCH. SPARQL formula copied from http://example.org/quality/sparql-impl-v1.0.0#I_AttributeRichness. owl:sameAs bridge preserves bidirectional reasoning between the two namespaces."@en ;
    owl:sameAs <http://example.org/quality/sparql-impl-v1.0.0#I_AttributeRichness> .

quality:I_ClassRichness a measurement:DescriptiveMetric,
        measurement:QualityMetric,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Class Richness"@en ;
    quality:hasSPARQLImplementation """SELECT (?populated / ?total AS ?value) WHERE {
  { SELECT (COUNT(DISTINCT ?c) AS ?populated) WHERE { ?c a owl:Class . FILTER(isIRI(?c)) ?inst a ?c . FILTER(?inst != ?c) } }
  { SELECT (COUNT(DISTINCT ?c) AS ?total) WHERE { ?c a owl:Class . FILTER(isIRI(?c)) } }
}""" ;
    quality:measuresCriterion quality:QualityCriterion_OntologyStructuralQuality ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OQC v2.3.3 — declared in metric bridge PATCH. SPARQL formula copied from http://example.org/quality/sparql-impl-v1.0.0#I_ClassRichness. owl:sameAs bridge preserves bidirectional reasoning between the two namespaces."@en ;
    owl:sameAs <http://example.org/quality/sparql-impl-v1.0.0#I_ClassRichness> .

quality:I_InheritanceRichness a measurement:DescriptiveMetric,
        measurement:QualityMetric,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Inheritance Richness"@en ;
    quality:hasSPARQLImplementation """SELECT (?subclass_count / ?class_count AS ?value) WHERE {
  { SELECT (COUNT(*) AS ?subclass_count) WHERE { ?s rdfs:subClassOf ?super . FILTER(isIRI(?s) && isIRI(?super) && ?super != owl:Thing) } }
  { SELECT (COUNT(DISTINCT ?c) AS ?class_count) WHERE { ?c a owl:Class . FILTER(isIRI(?c)) } }
}""" ;
    quality:measuresCriterion quality:QualityCriterion_OntologyStructuralQuality ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OQC v2.3.3 — declared in metric bridge PATCH. SPARQL formula copied from http://example.org/quality/sparql-impl-v1.0.0#I_InheritanceRichness. owl:sameAs bridge preserves bidirectional reasoning between the two namespaces."@en ;
    owl:sameAs <http://example.org/quality/sparql-impl-v1.0.0#I_InheritanceRichness> .

quality:I_NumberOfLeafClasses a measurement:DescriptiveMetric,
        measurement:QualityMetric,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Number of Leaf Classes"@en ;
    quality:hasSPARQLImplementation """SELECT (COUNT(DISTINCT ?leaf) AS ?value) WHERE {
  ?leaf a owl:Class . FILTER(isIRI(?leaf))
  FILTER NOT EXISTS { ?sub rdfs:subClassOf ?leaf . FILTER(isIRI(?sub) && ?sub != ?leaf) }
}""" ;
    quality:measuresCriterion quality:QualityCriterion_OntologyStructuralQuality ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OQC v2.3.3 — declared in metric bridge PATCH. SPARQL formula copied from http://example.org/quality/sparql-impl-v1.0.0#I_NumberOfLeafClasses. owl:sameAs bridge preserves bidirectional reasoning between the two namespaces."@en ;
    owl:sameAs <http://example.org/quality/sparql-impl-v1.0.0#I_NumberOfLeafClasses> .

quality:I_NumberOfRootClasses a measurement:DescriptiveMetric,
        measurement:QualityMetric,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Number of Root Classes"@en ;
    quality:hasSPARQLImplementation """SELECT (COUNT(DISTINCT ?root) AS ?value) WHERE {
  ?root a owl:Class . FILTER(isIRI(?root))
  FILTER NOT EXISTS { ?root rdfs:subClassOf ?super . FILTER(isIRI(?super) && ?super != owl:Thing) }
}""" ;
    quality:measuresCriterion quality:QualityCriterion_OntologyStructuralQuality ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OQC v2.3.3 — declared in metric bridge PATCH. SPARQL formula copied from http://example.org/quality/sparql-impl-v1.0.0#I_NumberOfRootClasses. owl:sameAs bridge preserves bidirectional reasoning between the two namespaces."@en ;
    owl:sameAs <http://example.org/quality/sparql-impl-v1.0.0#I_NumberOfRootClasses> .

quality:I_RelationshipRichness a measurement:DescriptiveMetric,
        measurement:QualityMetric,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Relationship Richness"@en ;
    quality:hasSPARQLImplementation """SELECT ((?op_count) / (?op_count + ?subclass_count) AS ?value) WHERE {
  { SELECT (COUNT(DISTINCT ?op) AS ?op_count) WHERE { ?op a owl:ObjectProperty } }
  { SELECT (COUNT(*) AS ?subclass_count) WHERE { ?s rdfs:subClassOf ?super . FILTER(isIRI(?s) && isIRI(?super) && ?super != owl:Thing) } }
}""" ;
    quality:measuresCriterion quality:QualityCriterion_OntologyStructuralQuality ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OQC v2.3.3 — declared in metric bridge PATCH. SPARQL formula copied from http://example.org/quality/sparql-impl-v1.0.0#I_RelationshipRichness. owl:sameAs bridge preserves bidirectional reasoning between the two namespaces."@en ;
    owl:sameAs <http://example.org/quality/sparql-impl-v1.0.0#I_RelationshipRichness> .

