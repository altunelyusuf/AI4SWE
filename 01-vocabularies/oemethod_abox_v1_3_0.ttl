ae:AProVE_Tool a ae:ComplexityAnalysisTool,
        owl:NamedIndividual ;
    rdfs:label "AProVE"@en ;
    ae:publicationYear "2017"^^xsd:int ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Giesl et al 2017 Analyzing Program Complexity Using Term Rewriting Acta Informatica 54(1)"@en ;
    skos:definition "An automated prover for termination and complexity analysis via transformation to term rewrite systems, supporting Java, Haskell, and C with polynomial bound inference through matrix interpretations."@en ;
    skos:example "AProVE transforms a Haskell function into a rewrite system and derives O(n log n)." .

ae:AlgorithmVisualizer_Tool a ae:VisualizationTool,
        owl:NamedIndividual ;
    rdfs:label "Algorithm Visualizer"@en ;
    ae:benchmarkURL "https://algorithm-visualizer.org"^^xsd:anyURI ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Algorithm Visualizer open-source project"@en ;
    skos:definition "An open-source interactive online platform for visualizing algorithms from code, supporting multiple programming languages with a community-contributed library and real-time execution tracing."@en ;
    skos:example "Users write JavaScript quicksort code and see the animated partition process." .

ae:AverageCaseAnalysis a ae:CaseAnalysisStrategy,
        owl:NamedIndividual ;
    rdfs:label "Average-Case Analysis"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Sec2.1"@en ;
    skos:definition "The strategy computing expected basic operation count under an assumed input distribution, providing a measure of typical performance that is often more informative than worst-case for practical applications."@en ;
    skos:example "Sequential search with equal probability: C_avg(n) = (n+1)/2 comparisons." .

ae:BestCaseAnalysis a ae:CaseAnalysisStrategy,
        owl:NamedIndividual ;
    rdfs:label "Best-Case Analysis"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Sec2.1"@en ;
    skos:definition "The strategy of analyzing efficiency for the best-case input of size n that minimizes basic operation count, useful for identifying algorithms performing well on structured or nearly-sorted inputs."@en ;
    skos:example "Sequential search best case: first element matches, C_best(n) = 1." .

ae:BigO_n a ae:AsymptoticNotation,
        owl:NamedIndividual ;
    rdfs:label "O(n)"@en ;
    ae:formalDefinition "O(g(n)) = {f(n) : ∃ c > 0, n₀ ≥ 0 such that 0 ≤ f(n) ≤ c·g(n) for all n ≥ n₀}"^^xsd:string ;
    kb:isAuthoredFromReleaseHistory true ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "OE Pack v17.33.0 Option E — instance authored per L-49 design-intent extraction from real release history / the method author LLM reliability research / benchmark measurements. Per L-40: NOT a synthetic placeholder."@en ;
    prov:generatedAtTime "2026-05-15T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor ;
    prov:wasGeneratedBy oe-prov:Activity_OEPackRelease_v17_33_0 .

ae:BigOmega_n a ae:AsymptoticNotation,
        owl:NamedIndividual ;
    rdfs:label "Ω(n)"@en ;
    ae:formalDefinition "Ω(g(n)) = {f(n) : ∃ c > 0, n₀ ≥ 0 such that 0 ≤ c·g(n) ≤ f(n) for all n ≥ n₀}"^^xsd:string ;
    kb:isAuthoredFromReleaseHistory true ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "OE Pack v17.33.0 Option E — instance authored per L-49 design-intent extraction from real release history / the method author LLM reliability research / benchmark measurements. Per L-40: NOT a synthetic placeholder."@en ;
    prov:generatedAtTime "2026-05-15T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor ;
    prov:wasGeneratedBy oe-prov:Activity_OEPackRelease_v17_33_0 .

ae:BigTheta_n a ae:AsymptoticNotation,
        owl:NamedIndividual ;
    rdfs:label "Θ(n)"@en ;
    ae:formalDefinition "Θ(g(n)) = {f(n) : ∃ c₁, c₂ > 0, n₀ ≥ 0 such that 0 ≤ c₁·g(n) ≤ f(n) ≤ c₂·g(n) for all n ≥ n₀}"^^xsd:string ;
    kb:isAuthoredFromReleaseHistory true ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "OE Pack v17.33.0 Option E — instance authored per L-49 design-intent extraction from real release history / the method author LLM reliability research / benchmark measurements. Per L-40: NOT a synthetic placeholder."@en ;
    prov:generatedAtTime "2026-05-15T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor ;
    prov:wasGeneratedBy oe-prov:Activity_OEPackRelease_v17_33_0 .

ae:CLRS_4e a ae:Textbook,
        owl:NamedIndividual ;
    rdfs:label "Introduction to Algorithms (CLRS 4th ed.)"@en ;
    ae:publicationYear "2022"^^xsd:int ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Cormen et al 2022 Introduction to Algorithms 4e MIT Press"@en ;
    skos:definition "The most widely used algorithms textbook, covering design and analysis with extensive treatment of asymptotic notation, recurrence solving, amortized analysis, and randomized algorithms."@en ;
    skos:example "CLRS Chapter 4 introduces the Master Theorem with three cases." .

ae:COSTA_Tool a ae:ComplexityAnalysisTool,
        owl:NamedIndividual ;
    rdfs:label "COSTA"@en ;
    ae:publicationYear "2012"^^xsd:int ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Albert et al 2012 COSTA ENTCS 289"@en ;
    skos:definition "A static analysis tool for Java bytecode that automatically infers upper bounds on resource consumption using abstract interpretation and recurrence solving, producing symbolic cost expressions."@en ;
    skos:example "COSTA analyzes Java bytecode and outputs bounds like O(n^2) for nested loops." .

ae:ClassBQP a ae:ComplexityClass,
        owl:NamedIndividual ;
    rdfs:label "BQP"@en ;
    ae:yearIntroduced "1997"^^xsd:int ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Bernstein and Vazirani 1997 Quantum Complexity Theory SIAM J Computing"@en ;
    skos:definition "The class of problems solvable by a quantum computer in polynomial time with bounded error, containing problems like integer factoring believed outside classical BPP."@en ;
    skos:example "Integer factoring is in BQP via Shor algorithm." .

ae:ClassFPT a ae:ParameterizedComplexityClass,
        owl:NamedIndividual ;
    rdfs:label "FPT"@en ;
    ae:yearIntroduced "1992"^^xsd:int ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Downey and Fellows 2013 Fundamentals of Parameterized Complexity"@en ;
    skos:definition "The parameterized class of problems solvable in f(k)*n^O(1) time where k is a parameter and f any computable function, representing problems tractable when the parameter is small."@en ;
    skos:example "Vertex Cover parameterized by solution size k: O(2^k * n)." .

ae:ClassNP a ae:ComplexityClass,
        owl:NamedIndividual ;
    rdfs:label "NP"@en ;
    ae:yearIntroduced "1965"^^xsd:int ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Cook 1971 The Complexity of Theorem-Proving Procedures STOC"@en ;
    skos:definition "The class of decision problems whose yes-instances have polynomial-time verifiable certificates, containing both tractable problems in P and believed-intractable NP-complete problems."@en ;
    skos:example "Boolean satisfiability (SAT) is NP-complete." .

ae:ClassP a ae:ComplexityClass,
        owl:NamedIndividual ;
    rdfs:label "P"@en ;
    ae:yearIntroduced "1965"^^xsd:int ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Cobham 1965"@en ;
    skos:definition "The complexity class containing all decision problems solvable by a deterministic Turing machine in time polynomial in input size, widely identified with the class of tractable problems."@en ;
    skos:example "Sorting, shortest paths, and matching are in P." .

ae:ClassPSPACE a ae:ComplexityClass,
        owl:NamedIndividual ;
    rdfs:label "PSPACE"@en ;
    ae:yearIntroduced "1972"^^xsd:int ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Savitch 1970 Relationships between Nondeterministic and Deterministic Tape Complexities JCSS"@en ;
    skos:definition "The class of problems solvable using polynomial space, containing NP and believed strictly larger, with complete problems including quantified Boolean formula satisfiability."@en ;
    skos:example "TQBF (True Quantified Boolean Formula) is PSPACE-complete." .

ae:ClassW1 a ae:ParameterizedComplexityClass,
        owl:NamedIndividual ;
    rdfs:label "W[1]"@en ;
    ae:yearIntroduced "1992"^^xsd:int ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Downey and Fellows 2013 Fundamentals of Parameterized Complexity"@en ;
    skos:definition "The first level of the W-hierarchy in parameterized complexity, believed to strictly contain FPT, with the canonical complete problem being k-Clique."@en ;
    skos:example "k-Clique is W[1]-complete." .

ae:ConstantTime a ae:EfficiencyClass,
        owl:NamedIndividual ;
    rdfs:label "Constant Time"@en ;
    ae:growthOrder "1" ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Table 2.2"@en ;
    skos:definition "The efficiency class of algorithms whose running time does not depend on input size, executing a fixed number of basic operations regardless of n, characteristic of direct formula evaluations and hash table lookups."@en ;
    skos:example "Accessing an array element by index runs in Theta(1) time." .

ae:CookKarp_Contributors a ae:KeyContributor,
        owl:NamedIndividual ;
    rdfs:label "Cook and Karp"@en ;
    ae:publicationYear "1971"^^xsd:int ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Cook 1971 STOC; Karp 1972 Reducibility Among Combinatorial Problems"@en ;
    skos:definition "Stephen Cook and Richard Karp who independently established NP-completeness theory in 1971-1972, providing the foundational framework for understanding algorithmic intractability."@en ;
    skos:example "Cook proved SAT is NP-complete; Karp identified 21 NP-complete problems." .

ae:CubicTime a ae:EfficiencyClass,
        owl:NamedIndividual ;
    rdfs:label "Cubic Time"@en ;
    ae:growthOrder "n^3" ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Table 2.2"@en ;
    skos:definition "The efficiency class of algorithms with three nested loops, exemplified by standard matrix multiplication computing n^3 scalar multiplications for n x n matrices."@en ;
    skos:example "Definition-based matrix multiplication: M(n) = n^3 multiplications." .

ae:DIMACS_Suite a ae:BenchmarkingSuite,
        owl:NamedIndividual ;
    rdfs:label "DIMACS Challenge"@en ;
    ae:benchmarkURL "http://dimacs.rutgers.edu/Challenges/"^^xsd:anyURI ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "DIMACS Implementation Challenges Rutgers University"@en ;
    skos:definition "A series of implementation challenges from the Center for Discrete Mathematics providing standardized problem instances and evaluation protocols for graph algorithms and optimization."@en ;
    skos:example "DIMACS shortest-path instances benchmark Dijkstra implementations." .

ae:Erickson_Algorithms a ae:Textbook,
        owl:NamedIndividual ;
    rdfs:label "Algorithms (Erickson 2019)"@en ;
    ae:publicationYear "2019"^^xsd:int ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Erickson 2019 Algorithms self-published open-access"@en ;
    skos:definition "A modern open-access algorithms textbook emphasizing proof techniques and mathematical rigor, freely available online and widely adopted in graduate-level courses since 2019."@en ;
    skos:example "Erickson backtracking chapter provides detailed recurrence analyses." .

ae:EuclidGCDCaseStudy a ae:HistoricalCaseStudy,
        owl:NamedIndividual ;
    rdfs:label "Euclid GCD Case Study"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Knuth 1997 TAOCP Vol2 Sec4.5.3"@en ;
    skos:definition "The analysis of Euclid GCD algorithm notable for worst-case inputs being consecutive Fibonacci numbers and its O(log min(m,n)) division count, one of the earliest and most elegant algorithm analyses."@en ;
    skos:example "Consecutive Fibonacci numbers F(n+1), F(n) maximize Euclidean divisions." .

ae:ExponentialTime a ae:EfficiencyClass,
        owl:NamedIndividual ;
    rdfs:label "Exponential Time"@en ;
    ae:growthOrder "2^n" ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Table 2.2"@en ;
    skos:definition "The efficiency class of algorithms generating all subsets of an n-element set, growing so rapidly that even moderate n yields astronomical operation counts."@en ;
    skos:example "Tower of Hanoi requires exactly 2^n - 1 moves for n disks." .

ae:FactorialTime a ae:EfficiencyClass,
        owl:NamedIndividual ;
    rdfs:label "Factorial Time"@en ;
    ae:growthOrder "n!" ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Table 2.2"@en ;
    skos:definition "The efficiency class of algorithms generating all permutations of an n-element set, growing even faster than exponential and representing the upper extreme of practically encountered complexity classes."@en ;
    skos:example "Brute-force traveling salesman: checking all n! city permutations." .

ae:FibonacciCaseStudy a ae:HistoricalCaseStudy,
        owl:NamedIndividual ;
    rdfs:label "Fibonacci Numbers Case Study"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Sec2.5"@en ;
    skos:definition "The analysis of multiple Fibonacci algorithms from recursive exponential through iterative linear to matrix exponentiation logarithmic, illustrating how different approaches to the same problem yield dramatically different efficiencies."@en ;
    skos:example "Naive recursive Fibonacci: Theta(phi^n) additions; iterative: n-1 additions." .

ae:GoldenRatio_Constant a ae:ClosedFormSolution,
        owl:NamedIndividual ;
    rdfs:label "Golden Ratio Constant"@en ;
    ae:solutionForm "phi = (1 + sqrt(5)) / 2 approx 1.61803" ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Sec2.5"@en ;
    skos:definition "The golden ratio phi = (1+sqrt(5))/2, appearing as the base of the exponential growth in Fibonacci numbers and determining the Theta(phi^n) complexity of the naive recursive Fibonacci algorithm."@en ;
    skos:example "F(n) = (phi^n - psi^n) / sqrt(5) where psi = (1-sqrt(5))/2." .

ae:HanoiRecurrence a ae:RecurrenceRelation,
        owl:NamedIndividual ;
    rdfs:label "Tower of Hanoi Recurrence"@en ;
    ae:recurrenceForm "M(n) = 2M(n-1) + 1" ;
    ae:solutionForm "M(n) = 2^n - 1" ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Sec2.4"@en ;
    skos:definition "The recurrence relation for the Tower of Hanoi puzzle expressing the minimum number of moves needed for n disks as twice the moves for n-1 disks plus one, solved by backward substitution to 2^n - 1."@en ;
    skos:example "M(1)=1, M(2)=3, M(3)=7 confirming the exponential pattern." .

ae:KnuthTAOCP a ae:Textbook,
        owl:NamedIndividual ;
    rdfs:label "The Art of Computer Programming (Knuth)"@en ;
    ae:publicationYear "1968"^^xsd:int ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Knuth 1997 The Art of Computer Programming Addison-Wesley"@en ;
    skos:definition "Donald Knuth foundational multi-volume reference establishing the mathematical discipline of algorithm analysis with unprecedented rigor, introducing asymptotic notation conventions to computer science."@en ;
    skos:example "TAOCP Volume 3 provides the definitive average-case analysis of quicksort." .

ae:Knuth_Contributor a ae:KeyContributor,
        owl:NamedIndividual ;
    rdfs:label "Donald Knuth"@en ;
    ae:publicationYear "1968"^^xsd:int ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Knuth 1997 The Art of Computer Programming Addison-Wesley"@en ;
    skos:definition "Pioneering computer scientist who founded the discipline of algorithm analysis with The Art of Computer Programming and established asymptotic notation use in computer science."@en ;
    skos:example "Knuth 1976 paper formalized Big Omicron and Big Omega notation for CS." .

ae:KoAT_Tool a ae:ComplexityAnalysisTool,
        owl:NamedIndividual ;
    rdfs:label "KoAT"@en ;
    ae:publicationYear "2014"^^xsd:int ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Brockschmidt et al 2014 Analyzing Runtime Complexity ACM TOPLAS 38(4)"@en ;
    skos:definition "A tool for analyzing runtime complexity of integer transition systems using ranking functions and recurrence solving to derive polynomial upper bounds on worst-case execution time."@en ;
    skos:example "KoAT proves termination in O(n^3) by finding polynomial ranking functions." .

ae:Levitin_3e a ae:Textbook,
        owl:NamedIndividual ;
    rdfs:label "Design and Analysis of Algorithms (Levitin 3rd ed.)"@en ;
    ae:publicationYear "2012"^^xsd:int ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Introduction to the Design and Analysis of Algorithms 3e Pearson"@en ;
    skos:definition "An accessible algorithms textbook notable for its systematic analysis framework presentation in Chapter 2, covering nonrecursive and recursive analysis, Fibonacci case study, empirical analysis, and visualization."@en ;
    skos:example "Chapter 2 introduces the framework: input size, basic operation, case analysis, order of growth." .

ae:LinearCongruentialGenerator a ae:InputDistribution,
        owl:NamedIndividual ;
    rdfs:label "Linear Congruential Generator"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Knuth 1997 TAOCP Vol2 Sec3.2.1"@en ;
    skos:definition "A pseudorandom number generator defined by x_{n+1} = (a*x_n + c) mod m, commonly used to generate random test inputs for empirical analysis of algorithm efficiency."@en ;
    skos:example "LCG with a=1664525 c=1013904223 m=2^32 generates benchmark input sequences." .

ae:LinearTime a ae:EfficiencyClass,
        owl:NamedIndividual ;
    rdfs:label "Linear Time"@en ;
    ae:growthOrder "n" ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Table 2.2"@en ;
    skos:definition "The efficiency class of algorithms scanning each input element a constant number of times, with running time directly proportional to input size."@en ;
    skos:example "Sequential search inspects each of n elements once in the worst case." .

ae:LinearithmicTime a ae:EfficiencyClass,
        owl:NamedIndividual ;
    rdfs:label "Linearithmic Time"@en ;
    ae:growthOrder "n log n" ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Table 2.2"@en ;
    skos:definition "The efficiency class characteristic of optimal comparison-based sorting algorithms and many divide-and-conquer algorithms, representing the information-theoretic lower bound for comparison-based sorting."@en ;
    skos:example "Mergesort achieves Theta(n log n) comparisons in all cases." .

ae:LogarithmicTime a ae:EfficiencyClass,
        owl:NamedIndividual ;
    rdfs:label "Logarithmic Time"@en ;
    ae:growthOrder "log n" ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Table 2.2"@en ;
    skos:definition "The efficiency class of algorithms reducing the problem size by a constant factor per iteration, growing so slowly that even astronomically large inputs yield manageable operation counts."@en ;
    skos:example "Binary search on a sorted array performs Theta(log n) comparisons." .

ae:MasterTheorem_DivideConquer a ae:RecurrenceRelation,
        owl:NamedIndividual ;
    rdfs:label "Standard Divide-and-Conquer Recurrence"@en ;
    ae:recurrenceForm "T(n) = aT(n/b) + f(n)" ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Cormen et al 2022 Sec4.5"@en ;
    skos:definition "The general form of divide-and-conquer recurrence with a subproblems of size n/b and combining cost f(n), solvable by the Master Theorem when a >= 1 and b > 1."@en ;
    skos:example "Mergesort: T(n) = 2T(n/2) + Theta(n) gives Theta(n log n) by Case 2." .

