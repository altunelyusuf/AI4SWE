    rdfs:isDefinedBy <http://example.org/oqc-measurements> ;
    skos:definition "0.7 × 0.9978 + 0.3 × 0.952 = 0.9841. Composite produced under the AggregationRule named in qc:appliesAggregationRule. Different aggregation rules instantiated in this graph would produce different values; the named rule fixes which composite is canonical."@en .

<http://example.org/quality/sparql-impl-v1.0.0#I_AttributeRichness> a quality:AttributeRichness,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Attribute Richness"@en ;
    quality:hasSPARQLImplementation """SELECT (?dp_count / ?class_count AS ?value) WHERE {
  { SELECT (COUNT(DISTINCT ?dp) AS ?dp_count) WHERE { ?dp a owl:DatatypeProperty } }
  { SELECT (COUNT(DISTINCT ?c) AS ?class_count) WHERE { ?c a owl:Class . FILTER(isIRI(?c)) } }
}""" ;
    quality:hasScore <http://example.org/quality/sparql-impl-v1.0.0#Score_Template_AttributeRichness> ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_StructuralCharacteristic> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Tartir et al. (2005)."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Average attributes per class."@en .

<http://example.org/quality/sparql-impl-v1.0.0#I_AutonomousDetectionRateMetric> a measurement:QualityMetric,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: AutonomousDetectionRate (computed from incident ABox)"@en ;
    quality:hasSPARQLImplementation """
PREFIX rel: <http://example.org/reliability#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
SELECT (?autonomous / ?total AS ?value) WHERE {
  {
    SELECT (COUNT(DISTINCT ?inc) AS ?autonomous) WHERE {
      ?inc a/rdfs:subClassOf* rel:Drift .
      ?inc a owl:NamedIndividual .
      ?inc rel:detectedBy rel:LLMAutonomousDetection .
    }
  }
  {
    SELECT (COUNT(DISTINCT ?inc) AS ?total) WHERE {
      ?inc a/rdfs:subClassOf* rel:Drift .
      ?inc a owl:NamedIndividual .
      ?inc rel:detectedBy ?mech .
    }
  }
}
""" ;
    quality:hasScore <http://example.org/quality/sparql-impl-v1.0.0#Score_Template_AutonomousDetectionRate> ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_Reliability> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OQC v2.9.0 Phase 2.7 Gap 3 — mechanically-computed counterpart to rel:autonomousDetectionRate (which is itself derived from a reliability ontology v2.5.5 prior empirical work)."@en ;
    rdfs:isDefinedBy <http://example.org/quality/v2.9.0/autonomous-detection-metric> ;
    skos:definition "Computes the ratio: (count of Drift incidents whose :detectedBy is LLMAutonomousDetection) / (total count of Drift incidents with any :detectedBy attribution). Falsifiable from data: if more incidents are recorded over time with LLMAutonomousDetection attribution, the rate rises; if more are attributed to external mechanisms, it falls. Distinct from the hand-authored a reliability ontology N=37 reference value (0.486) — this metric measures the OE Pack ecosystem's own recorded incidents, the reference value measures broader a reliability ontology development sessions."@en .

<http://example.org/quality/sparql-impl-v1.0.0#I_ClassRichness> a quality:ClassRichness,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Class Richness"@en ;
    quality:hasSPARQLImplementation """SELECT (?populated / ?total AS ?value) WHERE {
  { SELECT (COUNT(DISTINCT ?c) AS ?populated) WHERE { ?c a owl:Class . FILTER(isIRI(?c)) ?inst a ?c . FILTER(?inst != ?c) } }
  { SELECT (COUNT(DISTINCT ?c) AS ?total) WHERE { ?c a owl:Class . FILTER(isIRI(?c)) } }
}""" ;
    quality:hasScore <http://example.org/quality/sparql-impl-v1.0.0#Score_Template_ClassRichness> ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_StructuralCharacteristic> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Tartir et al. (2005)."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Fraction of classes that have instances."@en .

<http://example.org/quality/sparql-impl-v1.0.0#I_InheritanceRichness> a quality:InheritanceRichness,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Inheritance Richness"@en ;
    quality:hasSPARQLImplementation """SELECT (?subclass_count / ?class_count AS ?value) WHERE {
  { SELECT (COUNT(*) AS ?subclass_count) WHERE { ?s rdfs:subClassOf ?super . FILTER(isIRI(?s) && isIRI(?super) && ?super != owl:Thing) } }
  { SELECT (COUNT(DISTINCT ?c) AS ?class_count) WHERE { ?c a owl:Class . FILTER(isIRI(?c)) } }
}""" ;
    quality:hasScore <http://example.org/quality/sparql-impl-v1.0.0#Score_Template_InheritanceRichness> ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_StructuralCharacteristic> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Tartir et al. (2005)."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Average subclasses per class."@en .

<http://example.org/quality/sparql-impl-v1.0.0#I_NumberOfLeafClasses> a quality:NumberOfLeafClasses,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Number of Leaf Classes"@en ;
    quality:hasSPARQLImplementation """SELECT (COUNT(DISTINCT ?leaf) AS ?value) WHERE {
  ?leaf a owl:Class . FILTER(isIRI(?leaf))
  FILTER NOT EXISTS { ?sub rdfs:subClassOf ?leaf . FILTER(isIRI(?sub) && ?sub != ?leaf) }
}""" ;
    quality:hasScore <http://example.org/quality/sparql-impl-v1.0.0#Score_Template_NumberOfLeafClasses> ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_StructuralCharacteristic> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OntoMetrics 2016."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Counts owl:Class instances with no subclasses."@en .

<http://example.org/quality/sparql-impl-v1.0.0#I_NumberOfRootClasses> a quality:NumberOfRootClasses,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Number of Root Classes"@en ;
    quality:hasSPARQLImplementation """SELECT (COUNT(DISTINCT ?root) AS ?value) WHERE {
  ?root a owl:Class . FILTER(isIRI(?root))
  FILTER NOT EXISTS { ?root rdfs:subClassOf ?super . FILTER(isIRI(?super) && ?super != owl:Thing) }
}""" ;
    quality:hasScore <http://example.org/quality/sparql-impl-v1.0.0#Score_Template_NumberOfRootClasses> ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_StructuralCharacteristic> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Tartir et al. (2005); OntoMetrics 2016."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Counts owl:Class instances with no rdfs:subClassOf to another non-Thing class."@en .

<http://example.org/quality/sparql-impl-v1.0.0#I_RelationshipRichness> a quality:RelationshipRichness,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Relationship Richness"@en ;
    quality:hasSPARQLImplementation """SELECT ((?op_count) / (?op_count + ?subclass_count) AS ?value) WHERE {
  { SELECT (COUNT(DISTINCT ?op) AS ?op_count) WHERE { ?op a owl:ObjectProperty } }
  { SELECT (COUNT(*) AS ?subclass_count) WHERE { ?s rdfs:subClassOf ?super . FILTER(isIRI(?s) && isIRI(?super) && ?super != owl:Thing) } }
}""" ;
    quality:hasScore <http://example.org/quality/sparql-impl-v1.0.0#Score_Template_RelationshipRichness> ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_StructuralCharacteristic> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Tartir et al. (2005)."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Ratio of non-inheritance relationships to total relationships."@en .

