<http://example.org/configuration-v1-4-0-naming-extension#CQ1_ProjectMarkdownTypes> a core:CompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "What artefact subclasses does ProjectMarkdownDocument cover?"@en ;
    quality:hasSPARQLImplementation "SELECT ?sub WHERE { ?sub rdfs:subClassOf+ configuration:ProjectMarkdownDocument }"^^xsd:string ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD v1.4.0 §1 class hierarchy."@en ;
    rdfs:isDefinedBy <http://example.org/configuration-v1-4-0-naming-extension> ;
    skos:definition "Resolved by SPARQL: SELECT ?cls WHERE { ?cls rdfs:subClassOf configuration:ProjectMarkdownDocument }. Returns ProjectClosureMarkdown, PlanMarkdown, AuditReportMarkdown."@en .

<http://example.org/configuration-v1-4-0-naming-extension#CQ2_FilenamePattern> a core:CompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "What filename pattern applies to a ProjectClosureMarkdown?"@en ;
    quality:hasSPARQLImplementation "SELECT ?example WHERE { configuration:ProjectClosureMarkdown skos:example ?example }"^^xsd:string ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD v1.4.0 §2 NamingConvention individuals."@en ;
    rdfs:isDefinedBy <http://example.org/configuration-v1-4-0-naming-extension> ;
    skos:definition "Resolved by SPARQL: SELECT ?pattern WHERE { ?conv configuration:appliesToArtifactType configuration:ProjectClosureMarkdown ; configuration:filenamePattern ?pattern }. Returns '{Capitalised_name}_Closure_v{M}_{m}_{p}.md'."@en .

<http://example.org/configuration-v1-4-0-naming-extension#CQ3_ConventionParallelism> a core:CompetencyQuestion,
        core:DescriptiveCompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "Why do SafeguardDocConvention and ProjectClosureMarkdownConvention coexist?"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD v1.4.0 configuration:ProjectMarkdownVsSafeguardException."@en,
        "OE Pack v17.30.0 — reclassified as core:DescriptiveCompetencyQuestion (DesignRationale subtype). Inherently NOT SPARQL-operationalizable per L-49; design rationale / procedural / session-context. Answer lives in skos:definition prose."@en ;
    rdfs:comment "NOT-OPERATIONALIZABLE per L-40: Asks \"Why?\" — design rationale lives in skos:definition / dcterms:source, not queryable data"@en ;
    rdfs:isDefinedBy <http://example.org/configuration-v1-4-0-naming-extension> ;
    skos:definition "Resolved by reading skos:definition of configuration:ProjectMarkdownVsSafeguardException — the two conventions apply to different artefact subclasses (SafeguardDocument vs ProjectMarkdownDocument); they are parallel, not in conflict."@en .

<http://example.org/configuration-v1-4-1-archive-extension#CQ1_ArchiveType> a core:CompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "What artefact class does ProjectArchive sit under?"@en ;
    quality:hasSPARQLImplementation "SELECT ?super WHERE { configuration:ProjectArchive rdfs:subClassOf ?super }"^^xsd:string ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD v1.4.1 §1 class hierarchy."@en ;
    rdfs:isDefinedBy <http://example.org/configuration-v1-4-1-archive-extension> ;
    skos:definition "Resolved by SPARQL: SELECT ?super WHERE { configuration:ProjectArchive rdfs:subClassOf ?super }. Returns configuration:EngineeringArtefact."@en .

<http://example.org/configuration-v1-4-1-archive-extension#CQ2_ArchivePattern> a core:CompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "What is the canonical filename pattern for a ProjectArchive?"@en ;
    quality:hasSPARQLImplementation "SELECT ?example WHERE { configuration:ProjectArchive skos:example ?example }"^^xsd:string ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD v1.4.1 §2 ProjectArchiveConvention."@en ;
    rdfs:isDefinedBy <http://example.org/configuration-v1-4-1-archive-extension> ;
    skos:definition "Resolved by SPARQL: SELECT ?pattern WHERE { configuration:ProjectArchiveConvention configuration:filenamePattern ?pattern }. Returns 'oepack-{scope}-v{M}_{m}_{p}.zip'."@en .

<http://example.org/configuration-v1-4-1-archive-extension#CQ3_AcceptedVariants> a core:CompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "Which historical zip naming variants are accepted?"@en ;
    quality:hasSPARQLImplementation "SELECT ?ex WHERE { ?cls rdfs:subClassOf* configuration:ProjectArchive ; skos:example ?ex }"^^xsd:string ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD v1.4.1 §3 exception individuals."@en ;
    rdfs:isDefinedBy <http://example.org/configuration-v1-4-1-archive-extension> ;
    skos:definition "Resolved by SPARQL: SELECT ?conv ?pattern WHERE { ?conv configuration:appliesToArtifactType configuration:ProjectArchive ; configuration:filenamePattern ?pattern }. Returns 3 patterns: canonical underscore-version + DOT-version exception + Capitalised exception."@en .

<http://example.org/configuration-v1-4-1-archive-extension#CQ4_NextArchiveName> a core:CompetencyQuestion,
        core:DescriptiveCompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "What should the current session's parallel-integration zip be named?"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD v1.4.1 §2 + current-session deliverables (Parallel_Phase1_2_3_Assessment v1.0.0 + v1.0.1 addendum + 3 PATCH artifacts)."@en,
        "OE Pack v17.30.0 — reclassified as core:DescriptiveCompetencyQuestion (SessionContext subtype). Inherently NOT SPARQL-operationalizable per L-49; design rationale / procedural / session-context. Answer lives in skos:definition prose."@en ;
    rdfs:comment "NOT-OPERATIONALIZABLE per L-40: Computed from current-session context; not in ontology"@en ;
    rdfs:isDefinedBy <http://example.org/configuration-v1-4-1-archive-extension> ;
    skos:definition "Per configuration:ProjectArchiveConvention 'oepack-{scope}-v{M}_{m}_{p}.zip', and given scope = 'parallel-integration' (the work being packaged) and version = 1.0.1 (PATCH bump per BP-3 since the v1.0.0 assessment exists): the canonical name is oepack-parallel-integration-v1_0_1.zip."@en .

<http://example.org/configuration-v1-5-0-plan-extension#CQ1_AmodPlanCoverage> a core:CompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "Which plan: classes does AMOD v1.5.0 promote?"@en ;
    quality:hasSPARQLImplementation "SELECT ?cls WHERE { ?cls rdf:type owl:Class . FILTER(STRSTARTS(STR(?cls), \"http://example.org/configuration#Plan\")) }"^^xsd:string ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD v1.5.0 §2."@en ;
    rdfs:isDefinedBy <http://example.org/configuration-v1-5-0-plan-extension> ;
    skos:definition "Resolved by SPARQL: SELECT ?amodCls ?planCls WHERE { ?amodCls owl:equivalentClass ?planCls . FILTER(STRSTARTS(STR(?planCls), 'http://example.org/oepack-expansion-plan')) }. Returns 12 alignments."@en .

<http://example.org/configuration-v1-5-0-plan-extension#CQ2_PlanArtefactCount> a core:CompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "How many AMOD plan-related classes exist after v1.5.0?"@en ;
    quality:hasSPARQLImplementation "SELECT (COUNT(?cls) AS ?n) WHERE { ?cls rdf:type owl:Class . FILTER(STRSTARTS(STR(?cls), \"http://example.org/configuration#Plan\")) }"^^xsd:string ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD v1.5.0 §1-2."@en ;
    rdfs:isDefinedBy <http://example.org/configuration-v1-5-0-plan-extension> ;
    skos:definition "Resolved by SPARQL: SELECT (COUNT(?c) AS ?n) WHERE { ?c rdfs:subClassOf*/rdfs:subClassOf* configuration:PlanArtefact }. Returns 13 (1 superclass + 12 subclasses)."@en .

<http://example.org/configuration-v1-5-0-plan-extension#CQ3_FilenameVsStructural> a core:CompetencyQuestion,
        core:DescriptiveCompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "Why are configuration:PlanMarkdown and configuration:PlanProposal both in AMOD?"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD v1.4.0 + v1.5.0 design rationale."@en,
        "OE Pack v17.30.0 — reclassified as core:DescriptiveCompetencyQuestion (DesignRationale subtype). Inherently NOT SPARQL-operationalizable per L-49; design rationale / procedural / session-context. Answer lives in skos:definition prose."@en ;
    rdfs:comment "NOT-OPERATIONALIZABLE per L-40: Asks \"Why?\" — design rationale"@en ;
    rdfs:isDefinedBy <http://example.org/configuration-v1-5-0-plan-extension> ;
    skos:definition "configuration:PlanMarkdown (v1.4.0) is a FILENAME convention class — what the .md file is called on disk. configuration:PlanProposal (v1.5.0) is a STRUCTURAL class — what the in-document plan vocabulary models. Different concerns, both needed: PlanMarkdown for AMOD S6 filename validation; PlanProposal for SPARQL queries over the plan content."@en .

core:CQ1_Roles a core:CompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "Which roles participate in engineering processes defined by CORE?"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    dcterms:source "CORE Role primitive. Roles must be traceable to Processes (CORE design constraint)."@en ;
    rdfs:comment "SPARQL: SELECT ?r ?p WHERE { ?r a core:Role ; core:participatesIn ?p . ?p a core:Process }"@en ;
    rdfs:isDefinedBy <http://example.org/core> ;
    skos:definition "Which roles participate in engineering processes defined by CORE?"@en .

core:CQ2_Metrics a core:CompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "Which metrics measure which quality characteristics in the CORE model?"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    dcterms:source "CORE Metric primitive. Metrics must link to measurable QualityCharacteristics."@en ;
    rdfs:comment "SPARQL: SELECT ?m ?q WHERE { ?m a core:Metric ; core:measures ?q . ?q a core:QualityCharacteristic }"@en ;
    rdfs:isDefinedBy <http://example.org/core> ;
    skos:definition "Which metrics measure which quality characteristics in the CORE model?"@en .

core:CQ3_Versions a core:CompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "What version information is declared for each ontology artefact in the ecosystem?"@en ;
