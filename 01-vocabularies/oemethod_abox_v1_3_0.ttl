quality:Framework_OOPS a quality:Framework,
        owl:NamedIndividual ;
    rdfs:label "OOPS! (OntOlogy Pitfall Scanner!)"@en ;
    dcterms:date "2014-04-01"^^xsd:date ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Poveda-Villalón M., Gómez-Pérez A., Suárez-Figueroa M.C. (2014). OOPS! (OntOlogy Pitfall Scanner!): An On-line Tool for Ontology Evaluation. International Journal on Semantic Web and Information Systems 10(2), 7-34."@en ;
    rdfs:seeAlso <https://oops.linkeddata.es/> ;
    skos:definition "OOPS! is an online ontology evaluation tool that detects modeling pitfalls from a catalogue of 41 pitfalls classified along three dimensions: Structural, Functional, and Usability-Profiling. Each pitfall carries an importance level of Critical, Important, or Minor. Derived from an empirical analysis of over 693 ontologies."@en .

measurement:Tier_A_StaticAlgorithmic a measurement:ConfidenceTier,
        owl:NamedIndividual ;
    rdfs:label "TIER-A: Static Algorithmic"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "OE Pack v19.6.0 Phase J1 / BP-D47."@en ;
    skos:definition "TIER-A confidence tier: scores produced by deterministic computation from TTL files using SPARQL or rdflib graph traversal. Bit-reproducible across runs and machines. Examples: OQuaRE LCOMOnto/WMCOnto/DITOnto, OntoQA richness metrics, SHACL violation counts, OOPS P04/P08/P10/P11 detector outputs. Aggregations of only TIER-A scores remain TIER-A."@en .

