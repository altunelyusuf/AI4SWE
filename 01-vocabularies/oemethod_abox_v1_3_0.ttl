reliability:DetectionMechanism_ReleasePreflight_v1_0_1 a reliability:DetectionMechanism,
        owl:NamedIndividual ;
    rdfs:label "release_preflight v1.0.1 pattern scanner"@en ;
    reliability:detectionImplementation "release_preflight_v1_0_1.py P1 pattern: scan owl:DatatypeProperty rdfs:range declarations; for each property with rdfs:range == xsd:string, cross-reference all ABox literal triples and flag any with non-None .language attribute."@en ;
    reliability:mechanismType "Programmatic raw scan"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Phase 2.9 pipeline-fix sprint, 2026-05-11."@en ;
    rdfs:isDefinedBy <http://example.org/reliability/v2_10_0_phase29_followup> ;
    skos:definition "Release-preflight detection mechanism v1.0.1: runs HermiT + pyshacl + manifest checks before any release bundle ships, blocking the release if gates fail. Captures drift signals proactively before publication."@en .

