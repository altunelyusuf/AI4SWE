    rdfs:seeAlso <https://oops.linkeddata.es/catalogue.jsp> ;
    skos:definition "The domain or range (or both) of a property is defined by stating more than one rdfs:domain or rdfs:range statements. In OWL multiple rdfs:domain or rdfs:range axioms are interpreted as conjunction (intersection)."@en .

quality:Pitfall_P20 a quality:Pitfall,
        owl:NamedIndividual ;
    rdfs:label "P20: Misusing ontology annotations"@en ;
    quality:hasImportance quality:Importance_Minor ;
