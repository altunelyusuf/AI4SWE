configuration:IndependentPackageArchiveConvention a configuration:NamingConvention,
        owl:NamedIndividual ;
    rdfs:label "Independent package archive convention"@en ;
    configuration:appliesToArtifactType configuration:ProjectArchive ;
    configuration:filenamePattern "{package}-v{M}_{m}_{p}.zip"^^xsd:string ;
    dcterms:isPartOf <http://example.org/configuration> ;
    rdfs:comment "Open question deliberately left unresolved by the proposer: whether a family token is needed once more than one independent package exists. Not resolved this round — premature for a set of one."@en ;
    skos:definition "RATIFIED 2026-07-28 (proposed by a registrant package round 1). Filename pattern for an archive authored under OE discipline but distributed independently of the OE Pack: lowercase hyphen-delimited package name, hyphenated 'v' marker, underscore-delimited 3-part SemVer, .zip extension. Regex: ^[a-z][a-z0-9-]*-v\\d+_\\d+_\\d+\\.zip$. Differs from configuration:ProjectArchiveConvention in exactly one respect (no mandatory 'oepack-' prefix) so an independent package does not assert pack membership it does not have; governance is instead declared inside the bundle via a staging declaration and README provenance section."@en ;
    skos:example "a registrant package.zip"@en .

