reliability:RawInspectionProtocol a reliability:FailureMitigation,
        owl:NamedIndividual ;
    rdfs:label "Raw Inspection Protocol (operationalizes BP-D2)"@en ;
    core:mitigates reliability:PartialReadDrift,
        reliability:PreflightInputDrift,
        reliability:SearchResultStalenessDrift ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.8.0 drift-mitigation-links PATCH — strategy authored to close R3 of oepack-ecosystem-assessment-v1_0_0."@en ;
    rdfs:isDefinedBy <http://example.org/redo/v2.8.0/drift-mitigation-links> ;
    skos:definition "A mitigation strategy in which every claim about an artifact's content is grounded in raw byte-level inspection of the artifact itself, not in summaries or descriptions. Operationalizes BP-D2 from the OE Pack discipline catalogue. Applies during pre-flight (verifying input artifacts) and during authoring (verifying ontology content before writing PATCHes)."@en .

