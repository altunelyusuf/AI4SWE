quality:Pitfall_P01 a quality:Pitfall,
        owl:NamedIndividual ;
    rdfs:label "P01: Creating polysemous elements"@en ;
    quality:hasImportance quality:Importance_Critical ;
    quality:hasOOPSCode "P01"^^xsd:string ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source quality:Framework_OOPS,
        "Poveda-Villalón M., Gómez-Pérez A., Suárez-Figueroa M.C. (2014). OOPS! (OntOlogy Pitfall Scanner!): An On-line Tool for Ontology Evaluation. International Journal on Semantic Web and Information Systems 10(2), 7-34. Live catalogue fetched from https://oops.linkeddata.es/catalogue.jsp on 2026-05-19 with 41 pitfalls (P01-P41); paper documented 35 (P01-P35); catalogue expanded post-paper."@en ;
    rdfs:seeAlso <https://oops.linkeddata.es/catalogue.jsp> ;
    skos:definition "An ontology element (class, object property or datatype property) whose identifier has different senses is included in the ontology to represent more than one conceptual idea or property."@en .

quality:Pitfall_P02 a quality:Pitfall,
        owl:NamedIndividual ;
    rdfs:label "P02: Creating synonyms as classes"@en ;
    quality:hasImportance quality:Importance_Minor ;
    quality:hasOOPSCode "P02"^^xsd:string ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source quality:Framework_OOPS,
        "Poveda-Villalón M., Gómez-Pérez A., Suárez-Figueroa M.C. (2014). OOPS! (OntOlogy Pitfall Scanner!): An On-line Tool for Ontology Evaluation. International Journal on Semantic Web and Information Systems 10(2), 7-34. Live catalogue fetched from https://oops.linkeddata.es/catalogue.jsp on 2026-05-19 with 41 pitfalls (P01-P41); paper documented 35 (P01-P35); catalogue expanded post-paper."@en ;
    rdfs:seeAlso <https://oops.linkeddata.es/catalogue.jsp> ;
    skos:definition "Several classes whose identifiers are synonyms are created and defined as equivalent (owl:equivalentClass) in the same namespace. Synonyms for the same concept do not represent different classes."@en .

quality:Pitfall_P03 a quality:Pitfall,
        owl:NamedIndividual ;
    rdfs:label "P03: Creating the relationship \"is\" instead of using rdfs:subClassOf, rdf:type or owl:sameAs"@en ;
    quality:hasImportance quality:Importance_Critical ;
    quality:hasOOPSCode "P03"^^xsd:string ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source quality:Framework_OOPS,
        "Poveda-Villalón M., Gómez-Pérez A., Suárez-Figueroa M.C. (2014). OOPS! (OntOlogy Pitfall Scanner!): An On-line Tool for Ontology Evaluation. International Journal on Semantic Web and Information Systems 10(2), 7-34. Live catalogue fetched from https://oops.linkeddata.es/catalogue.jsp on 2026-05-19 with 41 pitfalls (P01-P41); paper documented 35 (P01-P35); catalogue expanded post-paper."@en ;
    rdfs:seeAlso <https://oops.linkeddata.es/catalogue.jsp> ;
    skos:definition "The relationship \"is\" is created in the ontology instead of using OWL primitives for representing the subclass relationship (rdfs:subClassOf), class membership (rdf:type), or the equality between instances (owl:sameAs)."@en .

quality:Pitfall_P04 a quality:Pitfall,
        owl:NamedIndividual ;
    rdfs:label "P04: Creating unconnected ontology elements"@en ;
    quality:hasImportance quality:Importance_Minor ;
    quality:hasOOPSCode "P04"^^xsd:string ;
