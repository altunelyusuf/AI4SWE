configuration:CodeModuleConvention a configuration:NamingConvention,
        owl:NamedIndividual ;
    rdfs:label "Code Module Naming Convention"@en ;
    configuration:appliesToArtifactType configuration:CodeModule ;
    configuration:filenamePattern "{name}_v{M}_{m}_{p}.{ext}" ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Semantic Versioning 2.0.0 (semver.org). ISO/IEC 15289:2019 Systems and software engineering — Content of life-cycle information items. a reliability ontology ecosystem sprint engineering practice, April 2026. USO v2.0 Sprint 12 post-mortem."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    skos:definition "The mandatory filename pattern for code module artefacts (configuration:CodeModule): {name}_v{M}_{m}_{p}.{ext}, where {name} is a descriptive snake_case identifier, v{M}_{m}_{p} is the three-part semantic version, and {ext} is the language extension (jsx, py, js, json, yaml). The pattern is identical to HtmlArtifact except the extension is variable."@en ;
    skos:example """course_material_pipeline_v3_11_0.jsx — M=3, m=11, p=0 ✓
robolearn_v9.html — VIOLATION: no minor/patch token"""@en .

configuration:HtmlArtifactConvention a configuration:NamingConvention,
        owl:NamedIndividual ;
    rdfs:label "HTML Artifact Naming Convention"@en ;
    configuration:appliesToArtifactType configuration:HtmlArtifact ;
    configuration:filenamePattern "{name}_v{M}_{m}_{p}.html" ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Semantic Versioning 2.0.0 (semver.org). ISO/IEC 15289:2019 Systems and software engineering — Content of life-cycle information items. a reliability ontology ecosystem sprint engineering practice, April 2026. USO v2.0 Sprint 12 post-mortem."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    skos:definition "The mandatory filename pattern for interactive HTML tools and artifacts (configuration:HtmlArtifact): {name}_v{M}_{m}_{p}.html, where {name} is a descriptive snake_case identifier for the tool and v{M}_{m}_{p} encodes the three-part semantic version using underscore delimiter."@en ;
    skos:example """ontology_workbench_v26_1_5.html — name='ontology_workbench', M=26, m=1, p=5 ✓
gppt_generator_v17.html — VIOLATION: no minor/patch"""@en .

configuration:OntologyFileConvention a configuration:NamingConvention,
        owl:NamedIndividual ;
    rdfs:label "Ontology File Naming Convention"@en ;
    configuration:appliesToArtifactType configuration:OntologyFile ;
    configuration:filenamePattern "{prefix}_v{M}_{m}_{p}.ttl" ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Semantic Versioning 2.0.0 (semver.org). W3C OWL 2 — owl:versionInfo. a reliability ontology ecosystem sprint engineering practice, April 2026. USO v2.0 Sprint 12 post-mortem."@en ;
    rdfs:comment "Applies to: redo_v2_4_9.ttl, amod_v1_0_1.ttl, core_v1_1_0.ttl, meta_v6_1_1.ttl, oqc_v2_1_1.ttl."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    skos:definition "The mandatory filename pattern for OWL ontology files (configuration:OntologyFile) in the a reliability ontology ecosystem: {prefix}_v{M}_{m}_{p}.ttl, where {prefix} is the short name of the ontology (e.g., 'redo', 'amod', 'core'), {M} is the major version, {m} is the minor version, {p} is the patch version, and the extension is always .ttl. The version token v{M}_{m}_{p} must match owl:versionInfo declared inside the file."@en ;
    skos:example """redo_v2_4_9.ttl — prefix='redo', M=2, m=4, p=9, owl:versionInfo='2.4.9' ✓
redo_v2_4.ttl — VIOLATION: missing patch token"""@en .

configuration:SafeguardDocConvention a configuration:NamingConvention,
        owl:NamedIndividual ;
    rdfs:label "Safeguard Document Naming Convention"@en ;
    configuration:appliesToArtifactType configuration:SafeguardDocument ;
    configuration:filenamePattern "{prefix}_safeguard_{variant}_v{M}.{m}.md" ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "ISO/IEC 15289:2019 Systems and software engineering — Content of life-cycle information items. a reliability ontology ecosystem sprint engineering practice, April 2026. USO v2.0 Sprint 12 post-mortem."@en ;
    rdfs:comment "Note: delimiter is DOT (v1.1) not underscore (v1_1). This is intentional: safeguard documents use two-part versioning (major.minor), TTL files use three-part (major.minor.patch)."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    skos:definition "The mandatory filename pattern for a reliability ontology safeguard documents (configuration:SafeguardDocument): {prefix}_safeguard_{variant}_v{M}.{m}.md, where {prefix} is the framework name (e.g., 'redo'), {variant} is the task domain (e.g., 'ontology', 'code_module', 'html_js', 'zt4swe_component'), and v{M}.{m} encodes a two-part version using DOT delimiter (not underscore). The dot delimiter distinguishes safeguard documents from TTL files and reflects that safeguards version at major.minor granularity only — patch-level changes are not meaningful for governance documents."@en ;
    skos:example """redo_safeguard_ontology_v1.2.md — variant='ontology', M=1, m=2 ✓
redo_safeguard_code_module_v1.2.md — variant='code_module', M=1, m=2 ✓"""@en .

configuration:ShapeFileConvention a configuration:NamingConvention,
        owl:NamedIndividual ;
    rdfs:label "Shape File Naming Convention"@en ;
    configuration:appliesToArtifactType configuration:ShapeFile ;
    configuration:filenamePattern "{prefix}_shacl_v{M}_{m}_{p}.ttl" ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Semantic Versioning 2.0.0 (semver.org). W3C SHACL Specification (2017). a reliability ontology ecosystem sprint engineering practice, April 2026. USO v2.0 Sprint 12 post-mortem."@en ;
    rdfs:comment "Failure case that motivated this convention: redo_v2_shacl_shapes.ttl (no version token) was silently replaced on directory copy. Correct form: redo_shacl_v2_0_3.ttl."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    skos:definition "The mandatory filename pattern for SHACL shape files (configuration:ShapeFile) in the a reliability ontology ecosystem: {prefix}_shacl_v{M}_{m}_{p}.ttl, where {prefix} is the ontology family the shapes enforce, 'shacl' is a fixed type qualifier, and v{M}_{m}_{p} encodes the shape file's own version (independent of the ontology version it validates). The type qualifier 'shacl' prevents silent overwrite when copied alongside the ontology file it governs."@en ;
    skos:example """redo_shacl_v2_0_3.ttl — prefix='redo', M=2, m=0, p=3 ✓
redo_v2_shacl_shapes.ttl — VIOLATION: no version token"""@en .

configuration:Sprint_OEPack_v17_30_0 a configuration:SprintManifest,
        owl:NamedIndividual ;
