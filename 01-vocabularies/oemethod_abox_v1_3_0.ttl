    measurement:inMetricCategory measurement:MC_StructuralComplexity ;
    dcterms:isPartOf <http://example.org/measurement> .

measurement:WMCOnto a measurement:Metric,
        owl:NamedIndividual ;
    rdfs:label "WMCOnto"@en ;
    measurement:inMetricCategory measurement:MC_Coupling ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Duque-Ramos A. et al. (2013/2016) OQuaRE — Expert Systems with Applications 40 / Journal of Biomedical Semantics 7:63. OQuaRE primary structural metric."@en ;
    skos:definition "Weighted Method Count — mean number of datatype properties, object properties, and subclasses per class. Higher values indicate heavier interface per class."@en .

