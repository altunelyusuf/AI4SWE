measurement:TR_PerformanceEfficiency_band1 a measurement:PerformanceEfficiencyThresholdRow,
        owl:NamedIndividual ;
    rdfs:label "PerformanceEfficiency 1/5: Very slow (>=7.0 ms/tr)"@en ;
    measurement:appliesToMetric quality:PerformanceEfficiency ;
    measurement:combinedMsPerTripleMax 999999.0 ;
    measurement:combinedMsPerTripleMin 7.0 ;
    measurement:oquareScore 1 ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "OE Pack v17.25.0 Option P — empirically grounded in v17.22.0 baseline combined-timing distribution per BP-D2."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    skos:definition "Threshold band 1/5 for quality:PerformanceEfficiency. Triggers when (HermiT_s + SHACL_s) / triples * 1000 is in [7.0, 999999.0). Cut points chosen from v17.22.0 distribution: 12 subjects span 0.272..10.484 ms/triple combined. Median ~1.1; high-density region 0.5..1.5 mapped to band 4; reliability outlier (10.5 ms/tr) separates band 1 cleanly."@en .

