quality:ArithmeticMeanRule_QualityComposite_v1_0_0 a quality:ArithmeticMeanRule,
        owl:NamedIndividual ;
    rdfs:label "Arithmetic-mean rule for CompositeQuality"@en ;
    quality:hasSPARQLImplementation """PREFIX quality: <http://example.org/quality#>
PREFIX oem: <http://example.org/measurement#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT ?subject ((?s + ?sy + ?pe) / 3.0 AS ?composite) WHERE {
  ?subject quality:hasScore [ rdf:type quality:StructuralQuality ; quality:value ?s ] ;
           quality:hasScore [ rdf:type quality:SyntaxQuality ; quality:value ?sy ] ;
           quality:hasScore [ rdf:type quality:PerformanceEfficiency ; quality:value ?pe ] .
}"""^^xsd:string ;
    quality:weightedMetric quality:PerformanceEfficiency,
        quality:StructuralQuality,
        quality:SyntaxQuality ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OE Pack v17.25.0 Option P — codifies the CompositeQuality aggregation previously ad-hoc in v17.22.0 measurement report per L-52."@en ;
    skos:definition "CompositeQuality is the arithmetic mean of three sub-dimensions: quality:StructuralQuality (from 12 OQuaRE structural metrics × 4 roles, 247 ThresholdRows), quality:SyntaxQuality (from SHACL V/W counts, 6 ThresholdRows), and quality:PerformanceEfficiency (from combined (HermiT+SHACL)/triple ms, 5 ThresholdRows). Output range [1.0, 5.0]."@en .

