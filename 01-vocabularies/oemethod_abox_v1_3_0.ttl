reliability:CitationExistenceVerification a reliability:VerificationModality,
        owl:NamedIndividual ;
    rdfs:label "Citation Existence Verification"@en ;
    reliability:detectsPathology reliability:DataFabrication,
        reliability:ProvenanceFabrication ;
    reliability:verificationCost "low" ;
    reliability:verificationLatency "minutes" ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NEEDS_EXPERT_REVIEW: a reliability ontology-native process control concept from v2.0.7."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    skos:definition """A verification modality that checks whether every cited 
    source in a bibliography or reference list corresponds to an artifact that 
    actually exists and can be independently accessed. For published sources: 
    DOI resolution, database lookup, or web search confirmation. For 
    unpublished sources: file existence, repository link, or author 
    confirmation. For primary research: explicit labeling as 'Primary 
    research reported in this document (Section X)' with no fictional 
    external attribution. This modality addresses the gap in GroundingScore, 
    which verifies claims against sources but does not verify that the 
    sources themselves exist."""@en ;
    skos:example """For each reference [N] in the bibliography:
    (1) Published paper: resolve DOI or search title in Google Scholar/DBLP/PubMed
    (2) ArXiv preprint: verify arXiv ID at arxiv.org/abs/XXXX.XXXXX
    (3) Court case: verify case number in legal database
    (4) Industry report: verify URL accessibility
    (5) Unpublished/in-preparation: confirm the document exists as a file 
        or the author confirms its existence
    (6) Primary research: must be labeled 'Primary research reported in 
        this paper/report (Section X)' — no fictional manuscript attribution
    
    Any reference that fails all verification paths is flagged as 
    potential ProvenanceFabrication."""@en .

