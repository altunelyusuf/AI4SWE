    rdfs:isDefinedBy <http://example.org/oqc-measurements-v17/> ;
    skos:definition "Measurement score: OEE v3.0.0 — Version History Documentation Depth Score. Per Sprint F1 (Track A4 type-redirect from quality:Score → measurement:Score), oe-measurement SHACL requires skos:definition on Score individuals."@en .

<http://example.org/oqc-thresholds#CQ1_RowCount> a core:CompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "How many ThresholdRows does v1.0.0 ship?"@en ;
    quality:hasSPARQLImplementation "SELECT (COUNT(?r) AS ?n) WHERE { ?r rdf:type oem:ThresholdRow }"^^xsd:string ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OQC Thresholds v1.0.0."@en ;
    rdfs:isDefinedBy <http://example.org/oqc-thresholds> ;
    skos:definition "Resolved by SPARQL: SELECT (COUNT(?r) AS ?n) WHERE { ?r a qc:ThresholdRow }. Returns 240."@en .

<http://example.org/oqc-thresholds#CQ2_RoleAwareLookup> a core:CompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "What threshold band applies for InheritanceRichness=0.45 on a domain ontology?"@en ;
    quality:hasSPARQLImplementation "SELECT ?row ?band WHERE { ?row rdf:type oem:ThresholdRow ; oem:appliesToMetric ?metric ; oem:appliesToRole ?role . FILTER(CONTAINS(STR(?metric), \"InheritanceRichness\")) FILTER(CONTAINS(STR(?role), \"omain\")) OPTIONAL { ?row oem:bandLabel ?band } }"^^xsd:string ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OQC Thresholds v1.0.0."@en ;
    rdfs:isDefinedBy <http://example.org/oqc-thresholds> ;
    skos:definition "Resolved by SPARQL: SELECT ?band WHERE { ?row a qc:ThresholdRow ; qc:appliesToMetric qc:InheritanceRichness ; qc:appliesToRole 'domain' ; qc:lowerBound ?lo ; qc:upperBound ?hi . FILTER(?lo <= 0.45 && 0.45 <= ?hi) ... }."@en .

<http://example.org/oqc-thresholds#CQ3_BandsPerMetric> a core:CompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "How many bands per metric per role?"@en ;
    quality:hasSPARQLImplementation "SELECT ?metric ?role (COUNT(?row) AS ?n) WHERE { ?row rdf:type oem:ThresholdRow ; oem:appliesToMetric ?metric ; oem:appliesToRole ?role } GROUP BY ?metric ?role"^^xsd:string ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OQC Thresholds v1.0.0."@en ;
    rdfs:isDefinedBy <http://example.org/oqc-thresholds> ;
    skos:definition "5. Each metric × role pair has 5 ThresholdRow individuals corresponding to OQuaRE bands 1..5."@en .

<http://example.org/oqc-thresholds#OQuaREStructuralThresholdTable_v1_0_0> a measurement:ThresholdTable,
        owl:NamedIndividual ;
    rdfs:label "OQuaRE structural threshold table (v1.0.0)"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Aggregator for the 240 ThresholdRow individuals shipped in this file."@en ;
    rdfs:isDefinedBy <http://example.org/oqc-thresholds> ;
    skos:definition "The canonical OQuaRE structural threshold table for OE Pack v17.1.0. Aggregates 240 ThresholdRow individuals covering 12 structural metrics × 4 ontology roles × 5 OQuaRE bands. Used by score_v17_1.py (and successor scripts) as the lookup table for converting raw metric values into 1-5 band scores."@en .

<http://example.org/oqc-thresholds#TR_AnnotationRichness_app_1> a measurement:RoleAwareThresholdRow,
        measurement:ThresholdRow,
        owl:NamedIndividual ;
    rdfs:label "AnnotationRichness × application → 1/5 if 0.0..2.0"@en ;
    measurement:appliesToMetric quality:AnnotationRichness ;
    measurement:appliesToRole "application" ;
    measurement:lowerBound 0.0 ;
    measurement:oquareScore 1 ;
    measurement:upperBound 2.0 ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Duque-Ramos et al. (2011) §3.5 OQuaRE band for AnnotationRichness; role-aware adjustment per OQC v2.3.0 §threshold extension."@en ;
    rdfs:isDefinedBy <http://example.org/oqc-thresholds> ;
    skos:definition "OQuaRE band 1/5 for AnnotationRichness when assessed on a application ontology. Values in [0.0, 2.0] receive band-level 1."@en .

<http://example.org/oqc-thresholds#TR_AnnotationRichness_app_2> a measurement:RoleAwareThresholdRow,
        measurement:ThresholdRow,
        owl:NamedIndividual ;
    rdfs:label "AnnotationRichness × application → 2/5 if 2.0..3.0"@en ;
    measurement:appliesToMetric quality:AnnotationRichness ;
    measurement:appliesToRole "application" ;
    measurement:lowerBound 2.0 ;
    measurement:oquareScore 2 ;
    measurement:upperBound 3.0 ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Duque-Ramos et al. (2011) §3.5 OQuaRE band for AnnotationRichness; role-aware adjustment per OQC v2.3.0 §threshold extension."@en ;
    rdfs:isDefinedBy <http://example.org/oqc-thresholds> ;
    skos:definition "OQuaRE band 2/5 for AnnotationRichness when assessed on a application ontology. Values in [2.0, 3.0] receive band-level 2."@en .

<http://example.org/oqc-thresholds#TR_AnnotationRichness_app_3> a measurement:RoleAwareThresholdRow,
        measurement:ThresholdRow,
        owl:NamedIndividual ;
    rdfs:label "AnnotationRichness × application → 3/5 if 3.0..4.0"@en ;
    measurement:appliesToMetric quality:AnnotationRichness ;
    measurement:appliesToRole "application" ;
    measurement:lowerBound 3.0 ;
    measurement:oquareScore 3 ;
    measurement:upperBound 4.0 ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Duque-Ramos et al. (2011) §3.5 OQuaRE band for AnnotationRichness; role-aware adjustment per OQC v2.3.0 §threshold extension."@en ;
    rdfs:isDefinedBy <http://example.org/oqc-thresholds> ;
    skos:definition "OQuaRE band 3/5 for AnnotationRichness when assessed on a application ontology. Values in [3.0, 4.0] receive band-level 3."@en .

<http://example.org/oqc-thresholds#TR_AnnotationRichness_app_4> a measurement:RoleAwareThresholdRow,
        measurement:ThresholdRow,
        owl:NamedIndividual ;
    rdfs:label "AnnotationRichness × application → 4/5 if 4.0..6.0"@en ;
    measurement:appliesToMetric quality:AnnotationRichness ;
    measurement:appliesToRole "application" ;
    measurement:lowerBound 4.0 ;
    measurement:oquareScore 4 ;
    measurement:upperBound 6.0 ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Duque-Ramos et al. (2011) §3.5 OQuaRE band for AnnotationRichness; role-aware adjustment per OQC v2.3.0 §threshold extension."@en ;
    rdfs:isDefinedBy <http://example.org/oqc-thresholds> ;
    skos:definition "OQuaRE band 4/5 for AnnotationRichness when assessed on a application ontology. Values in [4.0, 6.0] receive band-level 4."@en .

<http://example.org/oqc-thresholds#TR_AnnotationRichness_app_5> a measurement:RoleAwareThresholdRow,
        measurement:ThresholdRow,
        owl:NamedIndividual ;
    rdfs:label "AnnotationRichness × application → 5/5 if 4.0..8.0"@en ;
    measurement:appliesToMetric quality:AnnotationRichness ;
    measurement:appliesToRole "application" ;
    measurement:lowerBound 4.0 ;
    measurement:oquareScore 5 ;
