quality:CQ1_DimensionMetrics a core:CompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "Which quality dimensions in OQC are measured by which quality metrics?"@en ;
    kb:hasVerificationQuery quality:VQ1_DimensionMetrics_SPARQL ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OQC QualityDimension–QualityMetric relationship."@en ;
    rdfs:comment "SPARQL: SELECT ?d ?m WHERE { ?d a qc:QualityDimension ; qc:measuredBy ?m . ?m a qc:QualityMetric }"@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    skos:definition "Which quality dimensions in OQC are measured by which quality metrics?"@en .

quality:I_OEE_AlignmentDocumentationCompleteness a measurement:Metric,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Alignment Documentation Completeness"@en ;
    measurement:inMetricCategory measurement:MC_ProcessCompleteness ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OE Pack Phase 2.3 OEE v3.0.0 measurement of an external alignment ontology (not shipped). Historical measurement record."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Documentation completeness of an alignment ontology, scored in [0,1]. Measured in OE Pack Phase 2.3 against the external OEE v3.0.0 alignment ontology (value 1.0). NOTE: the measured target is not shipped in this pack; this metric carries no re-runnable SPARQL implementation because its measurement input is absent (L-65: no fabricated computation)."@en .

quality:I_OEE_AlignmentRationaleCount a measurement:Metric,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Alignment Rationale Instance Count"@en ;
    measurement:inMetricCategory measurement:MC_ProcessCompleteness ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OE Pack Phase 2.3 OEE v3.0.0 measurement of an external alignment ontology (not shipped). Historical measurement record."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Count of alignment-rationale instances, normalized against a target density (raw / 5 for a mature alignment ontology). Measured in OE Pack Phase 2.3 against the external OEE v3.0.0 alignment ontology (raw 1, normalized 0.2). NOTE: measured target not shipped; no re-runnable SPARQL (L-65)."@en .

quality:I_OEE_CQCount a measurement:CoverageMetric,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Competency Question Count"@en ;
    quality:hasSPARQLImplementation """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT (COUNT(DISTINCT ?cq) AS ?value) WHERE {
  ?cq a ?type . FILTER(CONTAINS(STR(?type),"CompetencyQuestion"))
}""" ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_StructuralCharacteristic> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OE Pack Phase 2.3 OEE v3.0.0 measurement basis; CQ-count mechanic computable. OE-pack-internal rationale."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Count of CompetencyQuestion-typed individuals, normalized against a target density (raw / 10 for a focused alignment ontology). Test-drive verified 2026-05-28: 35 CQ individuals computable across the pack via SPARQL."@en .

quality:I_OEE_CQResolutionCompleteness a measurement:Metric,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Competency Question Resolution Completeness"@en ;
    measurement:inMetricCategory measurement:MC_ProcessCompleteness ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OE Pack Phase 2.3 OEE v3.0.0 measurement of an external alignment ontology (not shipped). Historical measurement record."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Fraction of competency questions resolved by an alignment ontology, in [0,1]. Measured in OE Pack Phase 2.3 against the external OEE v3.0.0 alignment ontology (value 1.0). NOTE: measured target not shipped; no re-runnable SPARQL (L-65)."@en .

quality:I_OEE_CQSourceTraceability a measurement:Metric,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Competency Question Source Traceability"@en ;
    measurement:inMetricCategory measurement:MC_ProcessCompleteness ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OE Pack Phase 2.3 OEE v3.0.0 measurement of an external alignment ontology (not shipped). Historical measurement record."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Fraction of competency questions traceable to a documented source, in [0,1]. Measured in OE Pack Phase 2.3 against the external OEE v3.0.0 alignment ontology (value 1.0). NOTE: measured target not shipped; no re-runnable SPARQL (L-65)."@en .

quality:I_OEE_VersionHistoryDepth a measurement:SizeMetric,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Version History Documentation Depth"@en ;
    quality:hasSPARQLImplementation """PREFIX owl: <http://www.w3.org/2002/07/owl#>
SELECT ?ont (COUNT(?pv) AS ?value) WHERE { ?ont owl:priorVersion ?pv } GROUP BY ?ont""" ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_Maintainability> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OE Pack Phase 2.3 OEE v3.0.0 measurement basis; version-chain depth computable. OE-pack-internal rationale."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Count of owl:priorVersion links in an ontology's version chain, normalized against an expected full evolution chain (raw / 3). Test-drive verified 2026-05-28: 156 priorVersion links across 18 ontologies computable via SPARQL."@en .

quality:TC_SHACL_Conformance a quality:TestCase,
        owl:NamedIndividual ;
    rdfs:label "TestCase: pyshacl conformance of OQC v2.2.4 against oqc_shacl_v1_1_1"@en ;
    quality:verifiesCompetencyQuestion quality:CQ1_DimensionMetrics ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OQC v2.2.4 — required member of TS_OQC_v2_2_4_TestSuite to satisfy 'TestSuite must contain at least one TestCase' shape."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    skos:definition "Real runtime evidence: pyshacl 0.31+ validates oqc_v2_2_4.ttl + core_v1_1_6.ttl against oqc_shacl_v1_1_1.ttl with conforms=True (target). Re-runnable via `pyshacl -s oqc_shacl_v1_1_1.ttl -d combined_oqc_v2_2_4.ttl --inference rdfs`."@en .

quality:VQ1_DimensionMetrics_SPARQL a kb:VerificationQuery,
        owl:NamedIndividual ;
    rdfs:label "VQ1 — SPARQL implementation of CQ1"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OQC v2.2.4 — promoted from CQ1 rdfs:comment to satisfy oqc_shacl CQ→VQ minCount=1."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    skos:definition "SELECT ?d ?m WHERE { ?d a qc:QualityDimension ; qc:measuredBy ?m . ?m a qc:QualityMetric }"@en .

quality:VQ2_CompletenessAssessment_SPARQL a kb:VerificationQuery,
        owl:NamedIndividual ;
    rdfs:label "VQ2 — SPARQL implementation of CQ2"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OQC v2.2.4 — promoted from CQ2 rdfs:comment to satisfy oqc_shacl CQ→VQ minCount=1."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    skos:definition "SELECT ?a ?metric WHERE { ?a a qc:OntologyArtifact . ?assess a qc:CompletenessAssessment ; qc:assessesArtifact ?a ; qc:hasMetric ?metric }"@en .

quality:VQ3_GateDecisions_SPARQL a kb:VerificationQuery,
        owl:NamedIndividual ;
    rdfs:label "VQ3 — SPARQL implementation of CQ3"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OQC v2.2.4 — promoted from CQ3 rdfs:comment to satisfy oqc_shacl CQ→VQ minCount=1."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    skos:definition "SELECT ?gate ?decision WHERE { ?gate a qc:QualityGate ; qc:gateProducesDecision ?decision . ?decision a qc:GateDecision }"@en .

<http://example.org/quality/sparql-impl-v1.0.0#I_AccuracyMetric> a measurement:AccuracyMetric,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Accuracy (provenance-based)"@en ;
    quality:hasSPARQLImplementation """SELECT (?provenanced / ?total AS ?value) WHERE {
  { SELECT (COUNT(DISTINCT ?e) AS ?provenanced) WHERE {
      ?e a ?type . FILTER(?type IN (owl:Class, owl:ObjectProperty, owl:DatatypeProperty))
      ?e <http://purl.org/dc/terms/source> ?s .
    } }
  { SELECT (COUNT(DISTINCT ?e) AS ?total) WHERE { ?e a ?type . FILTER(?type IN (owl:Class, owl:ObjectProperty, owl:DatatypeProperty)) } }
}""" ;
    quality:hasScore <http://example.org/quality/sparql-impl-v1.0.0#Score_Template_AccuracyMetric> ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_Reliability> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OQuaRE adapted."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Fraction of entities with dcterms:source provenance."@en .

<http://example.org/quality/sparql-impl-v1.0.0#I_AnnotationRichness> a quality:AnnotationRichness,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Annotation Richness"@en ;
    quality:hasSPARQLImplementation """SELECT (?annotated / ?total AS ?value) WHERE {
  { SELECT (COUNT(DISTINCT ?e) AS ?annotated) WHERE {
      ?e a ?type . FILTER(?type IN (owl:Class, owl:ObjectProperty, owl:DatatypeProperty))
      { ?e rdfs:label ?l } UNION { ?e rdfs:comment ?c } UNION { ?e <http://www.w3.org/2004/02/skos/core#definition> ?d }
    } }
  { SELECT (COUNT(DISTINCT ?e) AS ?total) WHERE { ?e a ?type . FILTER(?type IN (owl:Class, owl:ObjectProperty, owl:DatatypeProperty)) } }
}""" ;
    quality:hasScore <http://example.org/quality/sparql-impl-v1.0.0#Score_Template_AnnotationRichness> ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_Maintainability> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OntoMetrics 2016."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Fraction of entities with rdfs:label, rdfs:comment, or skos:definition."@en .

<http://example.org/quality/sparql-impl-v1.0.0#I_AverageBreadth> a quality:AverageBreadth,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Average Breadth"@en ;
    quality:hasSPARQLImplementation """SELECT (AVG(?children) AS ?value) WHERE {
  { SELECT ?parent (COUNT(DISTINCT ?child) AS ?children) WHERE {
      ?child rdfs:subClassOf ?parent .
      FILTER(isIRI(?parent) && isIRI(?child) && ?parent != owl:Thing)
    } GROUP BY ?parent }
}""" ;
    quality:hasScore <http://example.org/quality/sparql-impl-v1.0.0#Score_Template_AverageBreadth> ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_StructuralCharacteristic> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OntoMetrics 2016."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Average number of direct subclasses per class."@en .

<http://example.org/quality/sparql-impl-v1.0.0#I_AveragePopulation> a quality:AveragePopulation,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Average Population"@en ;
    quality:hasSPARQLImplementation """SELECT (?total_individuals / ?class_count AS ?value) WHERE {
  { SELECT (COUNT(DISTINCT ?i) AS ?total_individuals) WHERE { ?i a owl:NamedIndividual } }
  { SELECT (COUNT(DISTINCT ?c) AS ?class_count) WHERE { ?c a owl:Class . FILTER(isIRI(?c)) } }
}""" ;
    quality:hasScore <http://example.org/quality/sparql-impl-v1.0.0#Score_Template_AveragePopulation> ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_StructuralCharacteristic> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Tartir et al. (2005)."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Average instances per class."@en .

<http://example.org/quality/sparql-impl-v1.0.0#I_ClassChildrenCount> a quality:ClassChildrenCount,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Class Children Count"@en ;
    quality:hasSPARQLImplementation """SELECT (AVG(?children) AS ?value) WHERE {
  { SELECT ?parent (COUNT(DISTINCT ?child) AS ?children) WHERE {
      ?parent a owl:Class . FILTER(isIRI(?parent) && ?parent != owl:Thing)
      OPTIONAL { ?child rdfs:subClassOf ?parent . FILTER(isIRI(?child)) }
    } GROUP BY ?parent }
}""" ;
    quality:hasScore <http://example.org/quality/sparql-impl-v1.0.0#Score_Template_ClassChildrenCount> ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_StructuralCharacteristic> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OntoMetrics 2016."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Average number of direct subclasses per class."@en .

<http://example.org/quality/sparql-impl-v1.0.0#I_ClassConnectivity> a quality:ClassConnectivity,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Class Connectivity"@en ;
    quality:hasSPARQLImplementation """SELECT (AVG(?conn) AS ?value) WHERE {
  { SELECT ?c (COUNT(DISTINCT ?p) AS ?conn) WHERE {
      ?c a owl:Class . FILTER(isIRI(?c))
      { ?p rdfs:domain ?c } UNION { ?p rdfs:range ?c }
    } GROUP BY ?c }
}""" ;
    quality:hasScore <http://example.org/quality/sparql-impl-v1.0.0#Score_Template_ClassConnectivity> ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_StructuralCharacteristic> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OntoQA."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Average property attachments per class."@en .

<http://example.org/quality/sparql-impl-v1.0.0#I_ClassFullness> a quality:ClassFullness,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Class Fullness"@en ;
    quality:hasSPARQLImplementation """SELECT (AVG(?ratio) AS ?value) WHERE {
  { SELECT ?c (?actual_inst / 1 AS ?ratio) WHERE {
      ?c a owl:Class . FILTER(isIRI(?c))
      { SELECT ?c (COUNT(DISTINCT ?i) AS ?actual_inst) WHERE { ?i a ?c } GROUP BY ?c }
    } }
}""" ;
    quality:hasScore <http://example.org/quality/sparql-impl-v1.0.0#Score_Template_ClassFullness> ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_StructuralCharacteristic> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OntoQA."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Ratio of actual to expected instances per class."@en .

<http://example.org/quality/sparql-impl-v1.0.0#I_ClassImportance> a quality:ClassImportance,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Class Importance"@en ;
    quality:hasSPARQLImplementation """SELECT (AVG(?ratio) AS ?value) WHERE {
  { SELECT ?c (?inst_in_c / ?total_inst AS ?ratio) WHERE {
      ?c a owl:Class . FILTER(isIRI(?c))
      { SELECT ?c (COUNT(DISTINCT ?i) AS ?inst_in_c) WHERE { ?i a ?c } GROUP BY ?c }
      { SELECT (COUNT(DISTINCT ?j) AS ?total_inst) WHERE { ?j a owl:NamedIndividual } }
      FILTER(?total_inst > 0)
    } }
}""" ;
    quality:hasScore <http://example.org/quality/sparql-impl-v1.0.0#Score_Template_ClassImportance> ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_StructuralCharacteristic> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OntoQA."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Fraction of total instances that belong to a given class."@en .

<http://example.org/quality/sparql-impl-v1.0.0#I_ClassReadability> a quality:ClassReadability,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Class Readability"@en ;
    quality:hasSPARQLImplementation """SELECT (?with_doc / ?total AS ?value) WHERE {
  { SELECT (COUNT(DISTINCT ?c) AS ?with_doc) WHERE {
      ?c a owl:Class . FILTER(isIRI(?c))
      { ?c rdfs:label ?l } UNION { ?c <http://www.w3.org/2004/02/skos/core#definition> ?d }
    } }
  { SELECT (COUNT(DISTINCT ?c) AS ?total) WHERE { ?c a owl:Class . FILTER(isIRI(?c)) } }
}""" ;
    quality:hasScore <http://example.org/quality/sparql-impl-v1.0.0#Score_Template_ClassReadability> ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_Maintainability> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OntoMetrics 2016."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Fraction of classes with rdfs:label or skos:definition."@en .

<http://example.org/quality/sparql-impl-v1.0.0#I_CohesionMetric> a measurement:CohesionMetric,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Cohesion"@en ;
    quality:hasSPARQLImplementation """SELECT (1 - (?cross_module_links / ?total_links) AS ?value) WHERE {
  { SELECT (COUNT(*) AS ?total_links) WHERE { ?s rdfs:subClassOf ?p . FILTER(isIRI(?s) && isIRI(?p)) } }
  { SELECT (COUNT(*) AS ?cross_module_links) WHERE {
      ?s rdfs:subClassOf ?p . FILTER(isIRI(?s) && isIRI(?p))
      FILTER(REPLACE(STR(?s), "#.*", "") != REPLACE(STR(?p), "#.*", ""))
    } }
  FILTER(?total_links > 0)
}""" ;
    quality:hasScore <http://example.org/quality/sparql-impl-v1.0.0#Score_Template_CohesionMetric> ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_Maintainability> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OQuaRE."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Fraction of intra-namespace subClassOf links."@en .

<http://example.org/quality/sparql-impl-v1.0.0#I_CompletenessMetric> a measurement:CompletenessMetric,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Completeness"@en ;
    quality:hasSPARQLImplementation """SELECT (?fully_documented / ?total AS ?value) WHERE {
  { SELECT (COUNT(DISTINCT ?e) AS ?fully_documented) WHERE {
      ?e a ?type . FILTER(?type IN (owl:Class, owl:ObjectProperty, owl:DatatypeProperty))
      ?e rdfs:label ?l . ?e <http://www.w3.org/2004/02/skos/core#definition> ?d .
    } }
  { SELECT (COUNT(DISTINCT ?e) AS ?total) WHERE { ?e a ?type . FILTER(?type IN (owl:Class, owl:ObjectProperty, owl:DatatypeProperty)) } }
}""" ;
    quality:hasScore <http://example.org/quality/sparql-impl-v1.0.0#Score_Template_CompletenessMetric> ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_Maintainability> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OQuaRE."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Fraction of entities fully documented (label + definition)."@en .

<http://example.org/quality/sparql-impl-v1.0.0#I_ConsistencyMetric> a measurement:ConsistencyMetric,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Consistency"@en ;
    quality:hasSPARQLImplementation """SELECT (1 AS ?value) WHERE {
  FILTER NOT EXISTS { ?x owl:disjointWith ?y . ?inst a ?x . ?inst a ?y . FILTER(?x != ?y) }
}""" ;
    quality:hasScore <http://example.org/quality/sparql-impl-v1.0.0#Score_Template_ConsistencyMetric> ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_Reliability> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OQuaRE."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Returns 1 if no instance is in disjoint classes simultaneously."@en .

<http://example.org/quality/sparql-impl-v1.0.0#I_CorrectnessMetric> a measurement:CorrectnessMetric,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Correctness (DRIFT-18-aware)"@en ;
    quality:hasSPARQLImplementation """SELECT ((?total_classes - ?invalid_classes) / ?total_classes AS ?value) WHERE {
  { SELECT (COUNT(DISTINCT ?c) AS ?invalid_classes) WHERE {
      ?c a owl:Class . FILTER(isIRI(?c))
      ?c rdfs:subClassOf+ ?d1 . ?c rdfs:subClassOf+ ?d2 .
      ?d1 owl:disjointWith ?d2 . FILTER(?d1 != ?d2)
    } }
  { SELECT (COUNT(DISTINCT ?c) AS ?total_classes) WHERE { ?c a owl:Class . FILTER(isIRI(?c)) } }
  FILTER(?total_classes > 0)
}""" ;
    quality:hasScore <http://example.org/quality/sparql-impl-v1.0.0#Score_Template_CorrectnessMetric> ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_Reliability> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "WS-6 / DRIFT-18 informed."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Fraction of classes WITHOUT disjoint-ancestor inconsistencies."@en .

<http://example.org/quality/sparql-impl-v1.0.0#I_CouplingMetric> a measurement:CouplingMetric,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Coupling"@en ;
    quality:hasSPARQLImplementation """SELECT (?cross_ns_refs / ?total_refs AS ?value) WHERE {
  { SELECT (COUNT(*) AS ?total_refs) WHERE { ?s rdfs:subClassOf ?p . FILTER(isIRI(?s) && isIRI(?p)) } }
  { SELECT (COUNT(*) AS ?cross_ns_refs) WHERE {
      ?s rdfs:subClassOf ?p . FILTER(isIRI(?s) && isIRI(?p))
      FILTER(REPLACE(STR(?s), "#.*", "") != REPLACE(STR(?p), "#.*", ""))
    } }
}""" ;
    quality:hasScore <http://example.org/quality/sparql-impl-v1.0.0#Score_Template_CouplingMetric> ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_Maintainability> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OQuaRE."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Fraction of cross-namespace subClassOf links."@en .

<http://example.org/quality/sparql-impl-v1.0.0#I_CoverageMetric> a measurement:CoverageMetric,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Coverage"@en ;
    quality:hasSPARQLImplementation """SELECT (?with_inst / ?total AS ?value) WHERE {
  { SELECT (COUNT(DISTINCT ?c) AS ?with_inst) WHERE { ?c a owl:Class . FILTER(isIRI(?c)) ?i a ?c } }
  { SELECT (COUNT(DISTINCT ?c) AS ?total) WHERE { ?c a owl:Class . FILTER(isIRI(?c)) } }
}""" ;
    quality:hasScore <http://example.org/quality/sparql-impl-v1.0.0#Score_Template_CoverageMetric> ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_StructuralCharacteristic> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OQuaRE."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Fraction of classes that have at least one instance."@en .

<http://example.org/quality/sparql-impl-v1.0.0#I_DepthMetric> a measurement:DepthMetric,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Depth"@en ;
    quality:hasSPARQLImplementation """SELECT (MAX(?depth) AS ?value) WHERE {
  { SELECT ?leaf (COUNT(DISTINCT ?super) AS ?depth) WHERE {
      ?leaf a owl:Class . FILTER(isIRI(?leaf))
      FILTER NOT EXISTS { ?sub rdfs:subClassOf ?leaf . FILTER(isIRI(?sub) && ?sub != ?leaf) }
      ?leaf rdfs:subClassOf+ ?super . FILTER(isIRI(?super))
    } GROUP BY ?leaf }
}""" ;
    quality:hasScore <http://example.org/quality/sparql-impl-v1.0.0#Score_Template_DepthMetric> ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_StructuralCharacteristic> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OntoMetrics 2016."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Maximum depth of the class hierarchy."@en .

<http://example.org/quality/sparql-impl-v1.0.0#I_EntropyOfClassGraph> a quality:EntropyOfClassGraph,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Entropy of Class Graph"@en ;
    quality:hasSPARQLImplementation """SELECT (COUNT(DISTINCT ?c) AS ?value) WHERE {
  ?c a owl:Class . FILTER(isIRI(?c))
  ?i a ?c . FILTER(?i != ?c)
}""" ;
    quality:hasScore <http://example.org/quality/sparql-impl-v1.0.0#Score_Template_EntropyOfClassGraph> ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_StructuralCharacteristic> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OntoMetrics 2016 (simplified)."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Approximated as count of distinct populated classes."@en .

<http://example.org/quality/sparql-impl-v1.0.0#I_F1ScoreMetric> a measurement:F1ScoreMetric,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: F1 (placeholder)"@en ;
    quality:hasSPARQLImplementation """SELECT ((2 * ?precision * ?recall) / (?precision + ?recall) AS ?value) WHERE {
  BIND(0 AS ?precision) BIND(0 AS ?recall)
}""" ;
    quality:hasScore <http://example.org/quality/sparql-impl-v1.0.0#Score_Template_F1ScoreMetric> ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_Reliability> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Standard IR; full implementation deferred to v16.x."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Requires gold-standard reference; placeholder formula returns 0."@en .

<http://example.org/quality/sparql-impl-v1.0.0#I_Formalization> a quality:Formalization,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Formalization"@en ;
    quality:hasSPARQLImplementation """SELECT (?with_axioms / ?total_classes AS ?value) WHERE {
  { SELECT (COUNT(DISTINCT ?c) AS ?with_axioms) WHERE {
      ?c a owl:Class . FILTER(isIRI(?c))
      { ?c rdfs:subClassOf ?super . FILTER(isIRI(?super) && ?super != owl:Thing) }
      UNION { ?c owl:disjointWith ?d } UNION { ?c owl:equivalentClass ?eq }
    } }
  { SELECT (COUNT(DISTINCT ?c) AS ?total_classes) WHERE { ?c a owl:Class . FILTER(isIRI(?c)) } }
}""" ;
    quality:hasScore <http://example.org/quality/sparql-impl-v1.0.0#Score_Template_Formalization> ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_StructuralCharacteristic> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OQuaRE."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Fraction of classes with formal axioms beyond label."@en .

<http://example.org/quality/sparql-impl-v1.0.0#I_ModularityMetric> a measurement:ModularityMetric,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Modularity"@en ;
    quality:hasSPARQLImplementation """SELECT (COUNT(DISTINCT ?ns) AS ?value) WHERE {
  ?c a owl:Class . FILTER(isIRI(?c))
  BIND(REPLACE(STR(?c), "#.*", "") AS ?ns)
}""" ;
    quality:hasScore <http://example.org/quality/sparql-impl-v1.0.0#Score_Template_ModularityMetric> ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_Maintainability> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OQuaRE."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Number of distinct namespaces."@en .

<http://example.org/quality/sparql-impl-v1.0.0#I_PerformanceMetric> a measurement:PerformanceMetric,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Performance (size-inverse)"@en ;
    quality:hasSPARQLImplementation """SELECT (1 / (1 + ?triple_count / 100000) AS ?value) WHERE {
  { SELECT (COUNT(*) AS ?triple_count) WHERE { ?s ?p ?o } }
}""" ;
    quality:hasScore <http://example.org/quality/sparql-impl-v1.0.0#Score_Template_PerformanceMetric> ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_StructuralCharacteristic> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Heuristic; closes WS-3 placeholder."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Inversely proportional to graph size."@en .

<http://example.org/quality/sparql-impl-v1.0.0#I_PrecisionMetric> a measurement:PrecisionMetric,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Precision (placeholder)"@en ;
    quality:hasSPARQLImplementation """SELECT (?true_positives / (?true_positives + ?false_positives) AS ?value) WHERE {
  BIND(0 AS ?true_positives) BIND(0 AS ?false_positives)
}""" ;
    quality:hasScore <http://example.org/quality/sparql-impl-v1.0.0#Score_Template_PrecisionMetric> ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_Reliability> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Standard IR; full implementation deferred to v16.x."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Requires gold-standard reference; placeholder formula returns 0."@en .

<http://example.org/quality/sparql-impl-v1.0.0#I_QualityMetric> a measurement:QualityMetric,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Composite Quality"@en ;
    quality:hasSPARQLImplementation """SELECT (?fully_specified / ?total AS ?value) WHERE {
  { SELECT (COUNT(DISTINCT ?e) AS ?fully_specified) WHERE {
      ?e a ?type . FILTER(?type IN (owl:Class, owl:ObjectProperty, owl:DatatypeProperty))
      ?e rdfs:label ?l . ?e <http://www.w3.org/2004/02/skos/core#definition> ?d .
      ?e <http://purl.org/dc/terms/source> ?s . ?e rdfs:isDefinedBy ?o .
    } }
  { SELECT (COUNT(DISTINCT ?e) AS ?total) WHERE { ?e a ?type . FILTER(?type IN (owl:Class, owl:ObjectProperty, owl:DatatypeProperty)) } }
}""" ;
    quality:hasScore <http://example.org/quality/sparql-impl-v1.0.0#Score_Template_QualityMetric> ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_Reliability> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "a reliability ontology C2-C5 derived."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Fraction of entities with full a reliability ontology C2-C5 documentation."@en .

<http://example.org/quality/sparql-impl-v1.0.0#I_RecallMetric> a measurement:RecallMetric,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Recall (placeholder)"@en ;
    quality:hasSPARQLImplementation """SELECT (?true_positives / (?true_positives + ?false_negatives) AS ?value) WHERE {
  BIND(0 AS ?true_positives) BIND(0 AS ?false_negatives)
}""" ;
    quality:hasScore <http://example.org/quality/sparql-impl-v1.0.0#Score_Template_RecallMetric> ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_Reliability> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Standard IR; full implementation deferred to v16.x."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Requires gold-standard reference; placeholder formula returns 0."@en .

<http://example.org/quality/sparql-impl-v1.0.0#I_SizeMetric> a measurement:SizeMetric,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Size"@en ;
    quality:hasSPARQLImplementation """SELECT (COUNT(DISTINCT ?c) AS ?value) WHERE {
  { ?c a owl:Class } UNION { ?c a owl:ObjectProperty } UNION
  { ?c a owl:DatatypeProperty } UNION { ?c a owl:NamedIndividual }
  FILTER(isIRI(?c))
}""" ;
    quality:hasScore <http://example.org/quality/sparql-impl-v1.0.0#Score_Template_SizeMetric> ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_StructuralCharacteristic> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OntoMetrics 2016."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Total count of named entities."@en .

<http://example.org/quality/sparql-impl-v1.0.0#I_TaxonomicRichness> a quality:TaxonomicRichness,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Taxonomic Richness"@en ;
    quality:hasSPARQLImplementation """SELECT (?subs / ?classes AS ?value) WHERE {
  { SELECT (COUNT(*) AS ?subs) WHERE { ?s rdfs:subClassOf ?p . FILTER(isIRI(?s) && isIRI(?p) && ?p != owl:Thing) } }
  { SELECT (COUNT(DISTINCT ?c) AS ?classes) WHERE { ?c a owl:Class . FILTER(isIRI(?c)) } }
}""" ;
    quality:hasScore <http://example.org/quality/sparql-impl-v1.0.0#Score_Template_TaxonomicRichness> ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_StructuralCharacteristic> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Tartir et al. (2005)."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Density of taxonomic relationships."@en .

