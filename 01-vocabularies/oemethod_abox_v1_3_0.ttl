configuration:TBoxFileConvention a configuration:NamingConvention,
        owl:NamedIndividual ;
    rdfs:label "TBox File Naming Convention"@en ;
    configuration:appliesToArtifactType configuration:TBoxFile ;
    configuration:filenamePattern "{prefix}_tbox_v{M}_{m}_{p}.ttl"^^xsd:string ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Parallels ShapeFileConvention's {prefix}_shacl_v{M}_{m}_{p}.ttl pattern. The 'tbox' type qualifier prevents silent overwrite when copied alongside the ABox or combined ontology file."@en ;
    rdfs:comment "Applies when an ontology is split into terminology + instances. The combined form (using OntologyFileConvention) remains the default; TBoxFileConvention is used only when the split is intentional. Examples: meta_tbox_v6_7_1.ttl (TBox of META synthesized at v6.7.1), amod_tbox_v1_5_0.ttl."@en ;
    rdfs:isDefinedBy <http://example.org/configuration-v1-4-4-tbox-abox-extension> ;
    skos:definition "The mandatory filename pattern for TBox-only ontology files (configuration:TBoxFile): {prefix}_tbox_v{M}_{m}_{p}.ttl, where {prefix} is the short name of the ontology subject (e.g., 'meta', 'amod', 'core'), 'tbox' is a fixed type qualifier, and v{M}_{m}_{p} encodes the file's own version (which should match the equivalent ABoxFile companion's version when a split is shipped together)."@en ;
    skos:example """meta_tbox_v6_7_1.ttl — prefix='meta', M=6, m=7, p=1 ✓
meta_tbox_v6_7.ttl — VIOLATION: missing patch token
meta-tbox-v6_7_1.ttl — VIOLATION: hyphens not allowed in TBox infix"""@en .

configuration:USODelimiterException a configuration:VersionInFilenamePolicy,
        owl:NamedIndividual ;
    rdfs:label "USO Hyphen Delimiter Exception"@en ;
    configuration:appliesToArtifactType configuration:USOVocabularyModule ;
    configuration:filenamePattern "uso-{module}-v{M}_{m}.ttl" ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD BS-04 remediation April 2026. USO naming gap identified in USO v1 assessment. Parallel to amd:SafeguardDotDelimiterException (SafeguardDocument uses DOT)."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    skos:definition "INTENTIONAL EXCEPTION: USO module files use HYPHEN separator ('uso-discovery-v1_0.ttl') while AMOD OntologyFileConvention requires UNDERSCORE ('redo_v2_5_2.ttl'). USO also uses TWO-PART versioning (v{M}_{m}) rather than THREE-PART (v{M}_{m}_{p}). Rationale: USO predates the AMOD convention and uses a multi-segment prefix ('uso-{module}') rather than a single prefix token. Both deviations are intentional and ecosystem-wide. Machine-findable via AMOD S8 SHACL shape which validates USO filenames against USOVocabularyModuleConvention rather than OntologyFileConvention."@en .

configuration:USOEcosystemSchema a configuration:ArtifactNamingSchema,
        owl:NamedIndividual ;
    rdfs:label "USO Modular Ontology Ecosystem Naming Schema"@en ;
    configuration:filenamePattern "uso-{module}-v{M}_{m}.ttl | uso-{module}-shacl-v{M}_{m}.ttl | uso-{module}-tests-v{M}_{m}.ttl" ;
    configuration:includesConvention configuration:USOShapeModuleConvention,
        configuration:USOTestModuleConvention,
        configuration:USOVocabularyModuleConvention ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD BS-04. April 2026."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    skos:definition "Collects all three NamingConvention instances for the USO v2 modular ecosystem: USOVocabularyModuleConvention, USOShapeModuleConvention, USOTestModuleConvention."@en .

