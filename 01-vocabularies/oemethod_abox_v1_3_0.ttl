quality:DatatypePropertyDomainCompleteness quality:hasSPARQLImplementation """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
# Parameterised by ?subjectNS
SELECT (xsd:decimal(?n_with) / xsd:decimal(?n_total) AS ?completeness) WHERE {
  {
    SELECT (COUNT(DISTINCT ?p) AS ?n_with) WHERE {
      ?p rdf:type owl:DatatypeProperty ; rdfs:domain ?d .
      FILTER(STRSTARTS(STR(?p), ?subjectNS))
    }
  }
  {
    SELECT (COUNT(DISTINCT ?p) AS ?n_total) WHERE {
      ?p rdf:type owl:DatatypeProperty .
      FILTER(STRSTARTS(STR(?p), ?subjectNS))
    }
  }
  FILTER(?n_total > 0)
}"""^^xsd:string ;
    dcterms:isPartOf <http://example.org/quality> .

quality:DatatypePropertyUsageRate quality:hasSPARQLImplementation """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
# Parameterised by ?subjectNS
SELECT (xsd:decimal(?n_used) / xsd:decimal(?n_total) AS ?usageRate) WHERE {
  {
    SELECT (COUNT(DISTINCT ?p) AS ?n_used) WHERE {
      ?p rdf:type owl:DatatypeProperty .
      ?s ?p ?o .
      FILTER(STRSTARTS(STR(?p), ?subjectNS))
    }
  }
  {
    SELECT (COUNT(DISTINCT ?p) AS ?n_total) WHERE {
      ?p rdf:type owl:DatatypeProperty .
      FILTER(STRSTARTS(STR(?p), ?subjectNS))
    }
  }
  FILTER(?n_total > 0)
}"""^^xsd:string ;
    dcterms:isPartOf <http://example.org/quality> .

quality:EcosystemAttributeRichness quality:hasSPARQLImplementation """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
# Parameterised by ?nsPrefix (e.g. "http://example.org/core#"); ecosystem must be merged graph
SELECT ?subjectNS (xsd:decimal(?n_dt) / xsd:decimal(?n_cls) AS ?EcoAttrR) WHERE {
  {
    SELECT ?subjectNS (COUNT(DISTINCT ?cls) AS ?n_cls) WHERE {
      ?cls rdf:type owl:Class .
      FILTER(STRSTARTS(STR(?cls), ?subjectNS))
    } GROUP BY ?subjectNS
  }
  {
    SELECT ?subjectNS (COUNT(DISTINCT ?prop) AS ?n_dt) WHERE {
      ?prop rdf:type owl:DatatypeProperty ; rdfs:domain ?dom .
      ?dom rdf:type owl:Class .
      FILTER(STRSTARTS(STR(?dom), ?subjectNS))
    } GROUP BY ?subjectNS
  }
  FILTER(?n_cls > 0)
}"""^^xsd:string ;
    dcterms:isPartOf <http://example.org/quality> .

quality:Framework_FAIR a quality:Framework,
        owl:NamedIndividual ;
    rdfs:label "FAIR Guiding Principles"@en ;
    dcterms:date "2016-03-15"^^xsd:date ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Wilkinson M.D., Dumontier M., Aalbersberg I.J. et al. (2016). The FAIR Guiding Principles for scientific data management and stewardship. Scientific Data 3, 160018."@en ;
    rdfs:seeAlso <https://www.nature.com/articles/sdata201618> ;
    skos:definition "FAIR Guiding Principles for scientific data management and stewardship — data should be Findable, Accessible, Interoperable, and Reusable for both humans and machines. Applies to ontology assessment when ontologies are treated as data products: emphasises persistent identifiers, machine-readable metadata, formal vocabularies, and rich provenance."@en .

quality:Framework_IEEE_828 a quality:Framework,
        owl:NamedIndividual ;
    rdfs:label "IEEE 828-2012"@en ;
    dcterms:date "2012-03-16"^^xsd:date ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "IEEE Std 828-2012. IEEE Standard for Configuration Management in Systems and Software Engineering. IEEE Computer Society."@en ;
    rdfs:seeAlso <https://standards.ieee.org/ieee/828/5367/> ;
    skos:definition "IEEE 828-2012 Standard for Configuration Management in Systems and Software Engineering. Defines six CM activities: configuration identification, change control, status accounting, audits, release engineering, and CM planning. Anchors the OE Pack configuration: subject (renamed from amod: in v19.0.3)."@en .

quality:Framework_ISO_IEC_25010 a quality:Framework,
        owl:NamedIndividual ;
    rdfs:label "ISO/IEC 25010:2011"@en ;
    dcterms:date "2011-03-01"^^xsd:date ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2011. Systems and software engineering — Systems and software Quality Requirements and Evaluation (SQuaRE) — System and software quality models. International Organization for Standardization."@en ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    skos:definition "ISO/IEC 25010:2011 Systems and software engineering — SQuaRE — System and software quality models. Defines a quality-in-use model and a product quality model with 8 characteristics: FunctionalSuitability, PerformanceEfficiency, Compatibility, Usability, Reliability, Security, Maintainability, Portability. OQuaRE adapts this for ontology assessment."@en .

quality:Framework_OQuaRE a quality:Framework,
        owl:NamedIndividual ;
    rdfs:label "OQuaRE"@en ;
    dcterms:date "2013-12-01"^^xsd:date ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Duque-Ramos A. et al. (2013). Evaluation of the OQuaRE framework for ontology quality. Expert Systems with Applications 40, 2696-2703. Updated with static and dynamic scales in Duque-Ramos A. et al. (2016). Journal of Biomedical Semantics 7:63."@en ;
    rdfs:seeAlso <https://www.sciencedirect.com/science/article/abs/pii/S0957417412012146> ;
    skos:definition "Ontology Quality Requirements and Evaluation framework — a SQuaRE-based approach for evaluating ontology quality through 13 quality characteristics (FunctionalAdequacy, Reliability, Operability, PerformanceEfficiency, Compatibility, Transferability, Maintainability, StructuralCharacteristic, etc.) and a catalogue of metrics including LCOMOnto, WMCOnto, DITOnto, NACOnto, NOCOnto, CBOnto, RFCOnto, NOMOnto."@en .

quality:Framework_OntoQA a quality:Framework,
        owl:NamedIndividual ;
    rdfs:label "OntoQA"@en ;
    dcterms:date "2005-11-01"^^xsd:date ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Tartir S., Arpinar I.B., Moore M., Sheth A.P., Aleman-Meza B. (2005). OntoQA: Metric-Based Ontology Quality Analysis. In: IEEE Workshop on Knowledge Acquisition from Distributed, Autonomous, Semantically Heterogeneous Data and Knowledge Sources."@en ;
    rdfs:seeAlso <https://corescholar.libraries.wright.edu/knoesis/108/> ;
    skos:definition "OntoQA is a metric-based ontology quality analysis framework that quantifies knowledge-base richness via class richness, importance distribution, inheritance richness, attribute richness, and class-instance assertion ratios. Complements OQuaRE by emphasising the population (ABox) dimension of ontology quality."@en .

