    reliability:clopperPearsonCI "Aggregate:[0.32,0.65], Knowledge:[0.30,0.93], Structural:[0.42,1.00], Behavioral:[0.10,0.82], AssessorCognitive:[0.05,0.51]" ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology development sessions v1.2-v2.2.0, February 2026."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    skos:definition """Category-specific autonomous detection rates (N=37): 
    Knowledge 6/9=67% (CI:[30%,93%]), 
    Structural 6/7=86% (CI:[42%,100%]), 
    Behavioral 3/7=43% (CI:[10%,82%]), 
    Assessor Cognitive 3/14=21% (CI:[5%,51%]). 
