configuration:USO_Sprint12_Manifest a configuration:SprintManifest,
        owl:NamedIndividual ;
    rdfs:label "USO v2.0 Sprint 12 Deliverable Manifest"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Schwaber, K. & Sutherland, J. (2020). The Scrum Guide. a reliability ontology ecosystem sprint engineering practice, April 2026. USO v2.0 Sprint 12 post-mortem."@en ;
    rdfs:comment "26 total entries: 13 OntologyFile + 12 ShapeFile + 1 ShapeFile. The 13 missing files (12 module test suites + 1 integration suite) are the failure case that demonstrated the need for typed, machine-checkable sprint manifests."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    skos:definition "The sprint deliverable manifest for USO v2.0 Sprint 12 (April 2026), declaring 26 output artefacts: 12 vocabulary module OntologyFiles (uso-{module}-v1_0.ttl for innovation, discovery, hypothesis, product, team, finance, legal, ops, gtm, sales, funding, ecosystem), 12 test suite ShapeFiles (uso-{module}-tests-v1_0.ttl), 1 integration test ShapeFile (uso-v2-integration-tests-v1_0.ttl), and 1 alignment OntologyFile (uso-v2-alignment-v1_0.ttl). This manifest documents the post-mortem finding that motivated the AMOD SprintManifest class: the 13 test suite files were absent at initial sprint closure, causing a false C8Out GATE PASS."@en ;
    skos:example "Entry: uso-innovation-v1_0.ttl — OntologyFile, SHA-256 confirmed at sprint close. Entry: uso-innovation-tests-v1_0.ttl — ShapeFile, MISSING at initial close → C8Out FAIL."@en ;
    prov:wasGeneratedBy oe-prov:Activity_SprintPROVRetrofit_v19_0_1 .

reliability:Outcome_Open a reliability:ResolutionOutcome,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Outcome: Open"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.10 IssueLifecycleRecord vocabulary."@en ;
    rdfs:isDefinedBy <http://example.org/redo/v2.10.0/issue-lifecycle> ;
    skos:definition "The issue is acknowledged and recorded but no remediation has been applied. Either work has not yet started, or it is awaiting further triage/decision. Default state on first record."@en ;
    skos:inScheme reliability:resolutionOutcomeScheme ;
    skos:prefLabel "Open"@en .

<http://example.org/oemethod> a owl:Ontology ;
    dcterms:created "2026-10-06T00:00:00"^^xsd:dateTime ;
    dcterms:creator oe-prov:Agent_MethodAuthor,
        "the method author" ;
    dcterms:description "The A-Box of the OE Method's domain vocabularies as ONE file (BP-D54): the ten vocabulary A-Boxes, each a module (an untyped resource at its former ontology IRI carrying the old header's statements). Every named subject says dcterms:isPartOf <its module>. A pure union, proved. The governance data (knowledge base, release history, provenance registry, lineage backlogs) is a unit of its own."@en ;
    dcterms:identifier "oemethod" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T00:00:00"^^xsd:dateTime,
