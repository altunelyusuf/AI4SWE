reliability:SprintCC_USO_Sprint12 a reliability:SprintClosureChecklist,
        owl:NamedIndividual ;
    rdfs:label "Sprint Closure Checklist — USO v2.0 Sprint 12"@en ;
    core:validates configuration:USO_Sprint12_Manifest ;
