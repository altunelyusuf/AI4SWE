reliability:TV_SingleResearcherPair a reliability:ThreatsToValidity,
        owl:NamedIndividual ;
    rdfs:label "TV-1: Single Researcher-LLM Pair"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Wohlin, C. et al. (2012). Experimentation in Software Engineering. Springer."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    skos:definition "All 37 instances from one human researcher and one LLM (Claude, Anthropic). External validity requires replication with different researchers and models."@en .

reliability:TV_SmallSampleSize a reliability:ThreatsToValidity,
        owl:NamedIndividual ;
    rdfs:label "TV-5: Small Sample Size"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Wohlin, C. et al. (2012). Experimentation in Software Engineering. Springer."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    skos:definition "N=37 total, with per-category N ranging from 7 to 14. Wide confidence intervals limit statistical power. All quantitative claims are descriptive, not inferential."@en .

reliability:TV_SurvivorshipBias a reliability:ThreatsToValidity,
        owl:NamedIndividual ;
    rdfs:label "TV-4: Survivorship Bias"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Wohlin, C. et al. (2012). Experimentation in Software Engineering. Springer."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    skos:definition """Only detected failures appear in evidence. True failure count 
    unknown. The undetected fraction is coverage-dependent: for formalized 
    categories with a reliability ontology in context, detection approaches 100% and 
    survivorship bias is minimal. For novel/unformalized categories, 
    survivorship bias may be substantial (detection starts at ~0%). The 
    primary source of undetected failures is therefore novel categories 
    not yet covered by the framework, not a fixed undetectable fraction 
    within known categories."""@en .

