    rdfs:seeAlso <https://oops.linkeddata.es/catalogue.jsp> ;
    skos:definition "Using a 'some not' structure when a 'not some' is required. This is due to the misplacement of the existential quantifier (owl:someValuesFrom) and the negative operator (owl:complementOf)."@en .

quality:Pitfall_P16 a quality:Pitfall,
        owl:NamedIndividual ;
    rdfs:label "P16: Using a primitive class in place of a defined one"@en ;
    quality:hasImportance quality:Importance_Critical ;
    quality:hasOOPSCode "P16"^^xsd:string ;
