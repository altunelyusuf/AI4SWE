    rdfs:seeAlso <https://oops.linkeddata.es/catalogue.jsp> ;
    skos:definition "Primitive classes (necessary conditions, owl:subClassOf) are used instead of defined classes (necessary and sufficient conditions, owl:equivalentClass), preventing automatic classification of individuals by the reasoner."@en .

quality:Pitfall_P17 a quality:Pitfall,
        owl:NamedIndividual ;
    rdfs:label "P17: Overspecializing a hierarchy"@en ;
    quality:hasImportance quality:Importance_Important ;
