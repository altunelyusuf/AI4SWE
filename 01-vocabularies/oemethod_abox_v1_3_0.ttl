measurement:NACOnto a measurement:Metric,
        owl:NamedIndividual ;
    rdfs:label "NACOnto"@en ;
    measurement:inMetricCategory measurement:MC_StructuralComplexity ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Duque-Ramos A. et al. (2013/2016) OQuaRE — Expert Systems with Applications 40 / Journal of Biomedical Semantics 7:63. OQuaRE primary structural metric."@en ;
    skos:definition "Number of Ancestor Classes — mean number of superclasses per leaf class. Higher values complicate inheritance reasoning."@en .

measurement:NOCOnto a measurement:Metric,
        owl:NamedIndividual ;
    rdfs:label "NOCOnto"@en ;
    measurement:inMetricCategory measurement:MC_StructuralComplexity ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Duque-Ramos A. et al. (2013/2016) OQuaRE — Expert Systems with Applications 40 / Journal of Biomedical Semantics 7:63. OQuaRE primary structural metric."@en ;
    skos:definition "Number of Children — mean number of direct subclasses per class minus the subclasses of Thing. Higher values can indicate either rich vocabulary or shallow modeling."@en .

measurement:NOMOnto a measurement:Metric,
        owl:NamedIndividual ;
    rdfs:label "NOMOnto"@en ;
    measurement:inMetricCategory measurement:MC_Coupling ;
    dcterms:isPartOf <http://example.org/measurement> ;
