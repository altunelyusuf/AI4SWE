measurement:CBOnto a measurement:Metric,
        owl:NamedIndividual ;
    rdfs:label "CBOnto"@en ;
    measurement:inMetricCategory measurement:MC_Coupling ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Duque-Ramos A. et al. (2013/2016) OQuaRE — Expert Systems with Applications 40 / Journal of Biomedical Semantics 7:63. OQuaRE primary structural metric."@en ;
    skos:definition "Coupling Between Objects — mean number of related classes per class through object properties. Higher values indicate stronger coupling."@en .

measurement:CROnto a measurement:Metric,
        owl:NamedIndividual ;
    measurement:inMetricCategory measurement:MC_InstancePopulation ;
    dcterms:isPartOf <http://example.org/measurement> .

measurement:DITOnto a measurement:Metric,
        owl:NamedIndividual ;
    rdfs:label "DITOnto"@en ;
    measurement:inMetricCategory measurement:MC_StructuralComplexity ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Duque-Ramos A. et al. (2013/2016) OQuaRE — Expert Systems with Applications 40 / Journal of Biomedical Semantics 7:63. OQuaRE primary structural metric."@en ;
    skos:definition "Depth of Inheritance Tree — length of the largest path from Thing to a leaf class. Deeper trees increase classification complexity."@en .

measurement:INROnto a measurement:Metric,
        owl:NamedIndividual ;
    measurement:inMetricCategory measurement:MC_StructuralComplexity ;
    dcterms:isPartOf <http://example.org/measurement> .

measurement:LCOMOnto a measurement:Metric,
        owl:NamedIndividual ;
    rdfs:label "LCOMOnto"@en ;
    measurement:inMetricCategory measurement:MC_StructuralComplexity ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Duque-Ramos A. et al. (2013/2016) OQuaRE — Expert Systems with Applications 40 / Journal of Biomedical Semantics 7:63. OQuaRE primary structural metric."@en ;
    skos:definition "Lack of Cohesion in Methods — mean length of all paths from leaf classes to Thing. Higher values indicate weaker cohesion."@en .

measurement:MC_ProcessCompleteness a measurement:MetricCategory,
        owl:NamedIndividual ;
    rdfs:label "ProcessCompleteness"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
