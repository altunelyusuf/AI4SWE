quality:I_IssueResolutionRate a measurement:Metric,
        owl:NamedIndividual ;
    rdfs:label "Metric instance: Issue Resolution Rate"@en ;
    measurement:inMetricCategory measurement:MC_ProcessCompleteness ;
    quality:hasSPARQLImplementation """PREFIX rel: <http://example.org/reliability#>
SELECT (?resolved / ?total AS ?value) WHERE {
  { SELECT (COUNT(DISTINCT ?r) AS ?resolved) WHERE { ?r a rel:IssueLifecycleRecord ; rel:hasResolutionOutcome rel:Outcome_Resolved } }
  { SELECT (COUNT(DISTINCT ?t) AS ?total) WHERE { ?t a rel:IssueLifecycleRecord } }
}""" ;
    quality:measuresCriterion <http://example.org/oqc-measurements#CritDim_Reliability> ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OE Pack reliability lifecycle measurement; computable from oqc lifecycle-records ABox. OE-pack-internal rationale."@en ;
    rdfs:isDefinedBy <http://example.org/quality/sparql-impl-v1.0.0> ;
    skos:definition "Fraction of reliability IssueLifecycleRecord individuals whose hasResolutionOutcome is Outcome_Resolved, over total issue lifecycle records. Test-drive verified 2026-05-28: 234 resolved / 323 total = 0.7245 against the current lifecycle ABox."@en .

