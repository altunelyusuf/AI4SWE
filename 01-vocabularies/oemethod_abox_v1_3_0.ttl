    skos:example "roadmap_report_run_v1_170_0.md"@en .

configuration:SafeguardDocVersionPolicy a configuration:VersionInFilenamePolicy,
        owl:NamedIndividual ;
    rdfs:label "Safeguard Document Version-in-Filename Policy"@en ;
    configuration:appliesToArtifactType configuration:SafeguardDocument ;
    configuration:filenamePattern "{prefix}_safeguard_{variant}_v{M}.{m}.md" ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD SafeguardDocConvention comment: 'delimiter is DOT (v1.1) not underscore (v1_1). This is intentional.' a reliability ontology ecosystem sprint post-mortem, April 2026."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    skos:definition "Enforces that every SafeguardDocument filename encodes its version using the DOT-delimited two-part format vM.m (e.g., v1.2), NOT the underscore three-part format vM_m_p used by OntologyFile and ShapeFile artefacts. Regex: ^(.+)_safeguard_(.+)_v(\\d+)\\.(\\d+)\\.md$. Mismatch between the filename version token and the document's internal version declaration constitutes a C8-V GATE FAIL."@en .

configuration:SafeguardDotDelimiterException a configuration:VersionInFilenamePolicy,
        owl:NamedIndividual ;
    rdfs:label "Safeguard Document DOT Delimiter Exception"@en ;
    configuration:appliesToArtifactType configuration:SafeguardDocument ;
    configuration:filenamePattern "{prefix}_safeguard_{variant}_v{M}.{m}.md" ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD SafeguardDocConvention rdfs:comment. AMOD sprint post-mortem April 2026: exception was buried in one rdfs:comment — promoted to named individual for machine-findability via SPARQL."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    skos:definition "INTENTIONAL EXCEPTION: configuration:SafeguardDocument filenames use DOT delimiter (v1.2) while ALL other a reliability ontology ecosystem artefact types use UNDERSCORE (v1_2 or v1_2_3). Rationale: safeguard documents carry a two-part version (M.m only) that must be visually distinct from the three-part underscore version of OntologyFile and ShapeFile artefacts to prevent accidental confusion (e.g., redo_safeguard_base_v1.2.md vs redo_v2_5_2.ttl — different delimiter signals different artefact type immediately). Applies to: all configuration:SafeguardDocument instances. Does NOT apply to: configuration:DocumentationFile, configuration:HtmlArtifact, configuration:CodeModule. Machine-checkable via AMOD S6 and AMOD S7 SHACL shapes."@en .

