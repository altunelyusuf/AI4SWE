    rdfs:seeAlso <https://oops.linkeddata.es/catalogue.jsp> ;
    skos:definition "Defining a domain or range not general enough for a property, i.e., not considering all the individuals or datatypes that might be involved in such a domain or range."@en .

quality:Pitfall_P19 a quality:Pitfall,
        owl:NamedIndividual ;
    rdfs:label "P19: Defining multiple domains or ranges in properties"@en ;
    quality:hasImportance quality:Importance_Critical ;
