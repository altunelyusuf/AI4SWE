    rdfs:comment "SPARQL: SELECT ?o ?v WHERE { ?o a owl:Ontology ; owl:versionInfo ?v }"@en ;
    rdfs:isDefinedBy <http://example.org/core> ;
    skos:definition "What version information is declared for each ontology artefact in the ecosystem?"@en .

