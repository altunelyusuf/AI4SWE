    dcterms:source "OE Pack Phase 2.3 — measured value. Normalization: Already in [0,1] — no normalization needed. Raw measurement value: 1.0. Normalized to [0,1]: 1.0."@en ;
    rdfs:isDefinedBy <http://example.org/oqc-measurements-v17/> ;
    skos:definition "Measurement score: OEE v3.0.0 — Competency Question Resolution Completeness Score. Per Sprint F1 (Track A4 type-redirect from quality:Score → measurement:Score), oe-measurement SHACL requires skos:definition on Score individuals."@en .

<http://example.org/oqc-measurements-v17/Score_oee_v3_0_0_OEE_CQSourceTraceability> a measurement:Score,
        owl:NamedIndividual ;
    rdfs:label "OEE v3.0.0 — Competency Question Source Traceability Score"@en ;
    measurement:derivedFromMetric quality:I_OEE_CQSourceTraceability ;
    measurement:hasConfidenceTier measurement:Tier_A_StaticAlgorithmic ;
    quality:value 1.0 ;
