    rdfs:seeAlso <https://oops.linkeddata.es/catalogue.jsp> ;
    skos:definition "Using the universal restriction (owl:allValuesFrom) as the default qualifier instead of the existential restriction (owl:someValuesFrom)."@en .

quality:Pitfall_P15 a quality:Pitfall,
        owl:NamedIndividual ;
    rdfs:label "P15: Using 'some not' in place of 'not some'"@en ;
    quality:hasImportance quality:Importance_Critical ;
    quality:hasOOPSCode "P15"^^xsd:string ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source quality:Framework_OOPS,
