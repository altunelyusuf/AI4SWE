    skos:definition "Number of Methods (properties) — mean number of datatype and object properties per class."@en .

measurement:RFCOnto a measurement:Metric,
        owl:NamedIndividual ;
    rdfs:label "RFCOnto"@en ;
    measurement:inMetricCategory measurement:MC_Coupling ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Duque-Ramos A. et al. (2013/2016) OQuaRE — Expert Systems with Applications 40 / Journal of Biomedical Semantics 7:63. OQuaRE primary structural metric."@en ;
    skos:definition "Response For a Class — number of datatype properties and object properties directly accessible from the class, divided by class count minus subclasses of Thing."@en .

measurement:RROnto a measurement:Metric,
