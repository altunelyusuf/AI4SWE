    skos:example "Example: ex:testing_phase redo:consumesArtifact ex:requirements_doc . Links a testing phase to the requirements document it consumes as input."@en .

reliability:contradictsOwnPriorClaim a owl:ObjectProperty ;
    rdfs:label "contradicts own prior claim"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:SycophanticReversal ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:LLMBehavioralPathology ;
