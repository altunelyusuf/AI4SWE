    prov:wasDerivedFrom reliability:limitsResource_Budget .

testing:migrationDate a owl:AnnotationProperty ;
    rdfs:label "migration date"@en ;
    dcterms:isPartOf <http://example.org/testing> ;
    skos:definition "Date this class was migrated from its prior canonical home."@en .

testing:probesFor_Adversarial a owl:ObjectProperty ;
    rdfs:label "probesFor_Adversarial"@en ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:probesFor_Adversarial ;
    rdfs:domain testing:AdversarialTesting ;
    rdfs:isDefinedBy <http://example.org/testing> ;
