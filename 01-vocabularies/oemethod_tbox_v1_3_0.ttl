@prefix acap: <http://example.org/artifact-capability#> .
@prefix ae: <http://example.org/ae#> .
@prefix configuration: <http://example.org/configuration#> .
@prefix core: <http://example.org/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix kb: <http://example.org/knowledge-base#> .
@prefix measurement: <http://example.org/measurement#> .
@prefix meta: <http://example.org/meta#> .
@prefix oe-prov: <http://example.org/oe-prov#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix performance: <http://example.org/performance#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qc: <http://example.org/quality#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix reliability: <http://example.org/reliability#> .
@prefix risk: <http://example.org/risk#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix testing: <http://example.org/testing#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

qc:Cohesion a rdfs:Class,
        owl:Class ;
    rdfs:label "Cohesion"@en ;
    qc:hasMetric measurement:LCOMOnto ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Duque-Ramos A. et al. (2013). Evaluation of the OQuaRE framework for ontology quality. Expert Systems with Applications 40, 2696-2703.; Tartir S. et al. (2005). OntoQA: Metric-Based Ontology Quality Analysis.; OE Pack v19.0.4 Phase F1 closure of named-attribute gap (Cohesiveness present in measurement: as CohesionMetric but absent as a quality dimension). Added per Proposal F v1.0.0."@en ;
    rdfs:comment "A quality dimension under Maintainability that evaluates the degree of internal conceptual relatedness within an ontology — how strongly the classes and properties within a module or namespace belong together as a coherent whole. Higher cohesion indicates each ontology module addresses a single focused responsibility; lower cohesion suggests the module mixes unrelated concerns. Measured operationally via class-connectivity graph entropy and the OntoQA Cohesion metric. Aligned with the configuration-management principle that artifacts should have a single coherent scope."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso measurement:CohesionMetric ;
    rdfs:subClassOf qc:Maintainability ;
    skos:definition "A quality dimension under Maintainability that evaluates the degree of internal conceptual relatedness within an ontology — how strongly the classes and properties within a module or namespace belong together as a coherent whole. Higher cohesion indicates each ontology module addresses a single focused responsibility; lower cohesion suggests the module mixes unrelated concerns. Measured operationally via class-connectivity graph entropy and the OntoQA Cohesion metric. Aligned with the configuration-management principle that artifacts should have a single coherent scope."@en .

ae:AlgorithmSelection a owl:Class ;
    rdfs:label "Algorithm Selection"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Rice 1976 The Algorithm Selection Problem Advances in Computers 15"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf [ ],
        ae:UseCase ;
    owl:disjointWith ae:AlgorithmPortfolio,
        ae:AutomatedAlgorithmDesign,
        ae:CompetitiveProgramming,
        ae:CompilerOptimization,
        ae:EducationalApplication,
        ae:MLAugmentedAnalysis,
        ae:PerformancePrediction ;
    skos:definition "The practical task of choosing the most suitable algorithm for a problem instance based on efficiency analysis, considering size, structure, and platform characteristics to minimize expected running time."@en .

ae:AmortizedAnalysisParadigm a owl:Class ;
    rdfs:label "Amortized Analysis Paradigm"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Tarjan 1985 Amortized Computational Complexity SIAM J Algebraic Discrete Methods 6(2)"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:AnalysisParadigm ;
    skos:definition "An analysis paradigm evaluating average cost per operation over an entire sequence of operations on a data structure, demonstrating that expensive individual operations are compensated by many cheap ones, using aggregate, accounting, or potential methods."@en .

ae:AnalysisFramework a owl:Class ;
    rdfs:label "Analysis Framework"@en ;
    measurement:hasMeasurementSubject measurement:AlgorithmAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Sec2.1"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:AnalysisArchitecture ;
    owl:disjointWith ae:AnalysisParadigm,
        ae:CaseAnalysisStrategy,
        ae:FrameworkPhase ;
    skos:definition "The established systematic procedure for analyzing algorithm efficiency involving measuring input size, identifying basic operations, distinguishing case scenarios, setting up summations or recurrences, and deriving order-of-growth expressions."@en .

ae:ApproximationAlgorithmFamily a owl:Class ;
    rdfs:label "Approximation Algorithm Family"@en ;
    measurement:hasMeasurementSubject measurement:AlgorithmAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Vazirani 2001 Approximation Algorithms Springer"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:AlgorithmFamily ;
    owl:disjointWith ae:BacktrackingFamily,
        ae:DivideAndConquerFamily,
        ae:DynamicProgrammingFamily,
        ae:GreedyFamily,
        ae:RandomizedFamily ;
    skos:definition "Algorithms that find provably near-optimal solutions to NP-hard optimization problems in polynomial time, with quality measured by approximation ratios relating the achieved solution value to the optimal."@en .

ae:BigOhNotation a owl:Class ;
    rdfs:label "Big-Oh Notation"@en ;
    measurement:hasMeasurementSubject measurement:AlgorithmAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Cormen et al 2022 Ch3"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:AsymptoticNotation ;
    owl:disjointWith ae:BigOmegaNotation,
        ae:BigThetaNotation,
        ae:LittleOhNotation,
        ae:LittleOmegaNotation ;
    skos:definition "The notation O(g(n)) denoting all functions t(n) bounded above by some constant multiple of g(n) for sufficiently large n, formally requiring positive c and non-negative n0 such that t(n) <= c*g(n) for all n >= n0."@en .

ae:ClassicalFoundationPeriod a owl:Class ;
    rdfs:label "Classical Foundation Period"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Hartmanis and Stearns 1965 Trans AMS"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:FieldEvolution ;
    owl:disjointWith ae:BeyondWorstCaseEra,
        ae:NPCompletenessEra ;
    skos:definition "The foundational period from 1960s through early 1970s when computational complexity was formalized, asymptotic notation adopted, and the basic framework for algorithm analysis established by Knuth and Hartmanis-Stearns."@en .

ae:ComputabilityTheory a owl:Class ;
    rdfs:label "Computability Theory"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Sipser 2013 Introduction to the Theory of Computation 3e Ch3-5"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:PhilosophicalFoundation ;
    owl:disjointWith ae:ChurchTuringThesis,
        ae:ComplexityTheoreticWorldview,
        ae:ComputationalModelTheory,
        ae:InformationTheoreticBound,
        ae:QuantumComputabilityPrinciple,
        ae:ReductionismInAnalysis,
        ae:TractabilityAssumption ;
    skos:definition "The branch of mathematical logic and computer science that studies which problems are solvable by algorithms in principle, providing the theoretical ceiling against which efficiency analysis operates by distinguishing decidable from undecidable problems."@en .

ae:DataStructureRelationship a owl:Class ;
    rdfs:label "Data Structure Relationship"@en ;
    measurement:hasMeasurementSubject measurement:DataStructureAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Cormen et al 2022 Introduction to Algorithms 4e"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:InterDomainRelationship ;
    owl:disjointWith ae:CryptographyRelationship,
        ae:FormalVerificationRelationship,
        ae:MachineLearningRelationship,
        ae:ParallelComputingRelationship,
        ae:ProgrammingParadigmRelationship,
        ae:QuantumComputingRelationship,
        ae:SoftwareEngineeringRelationship ;
    skos:definition "The bidirectional relationship between algorithm efficiency and data structure design, where data structure choice fundamentally affects operation costs and efficiency requirements drive novel data structure development."@en .

ae:DecisionProblem a owl:Class ;
    rdfs:label "Decision Problem"@en ;
    measurement:hasMeasurementSubject measurement:ComputationalProblemAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Sipser 2013 Introduction to the Theory of Computation 3e"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:ProblemCategory ;
    owl:disjointWith ae:CountingProblem,
        ae:EnumerationProblem,
        ae:OptimizationProblem,
        ae:SearchProblem ;
    skos:definition "A problem requiring a yes/no answer for a given input, serving as the canonical form studied in complexity theory where membership in complexity classes like P and NP is defined."@en .

ae:FineGrainedAnalysisParadigm a owl:Class ;
    rdfs:label "Fine-Grained Analysis Paradigm"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Williams 2018 On Some Fine-Grained Questions in Algorithms and Complexity ICM 2018"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf [ ],
        ae:AnalysisParadigm ;
    skos:definition "A modern paradigm seeking the exact polynomial exponent of the best possible algorithm for a problem within P, using conditional lower bounds from hypotheses like SETH, OV, 3SUM, and APSP conjectures."@en .

ae:GraduateTextbook a owl:Class ;
    rdfs:label "Graduate-Level Textbook"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "ACM Digital Library"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:Textbook ;
    owl:disjointWith ae:UndergraduateTextbook ;
    skos:definition "An advanced textbook targeting graduate students with rigorous mathematical treatment of algorithm analysis, covering topics like randomized algorithms, approximation, and complexity theory."@en .

ae:InputSizeMeasure a owl:Class ;
    rdfs:label "Input Size Measure"@en ;
    measurement:hasMeasurementSubject measurement:AlgorithmAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Sec2.1"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:StructuralConcept ;
    owl:disjointWith ae:BasicOperation,
        ae:CaseDistinction,
        ae:ClosedFormSolution,
        ae:GeneratingFunction,
        ae:GrowthRateFunction,
        ae:InputDistribution,
        ae:RecurrenceRelation,
        ae:SummationFormula ;
    skos:definition "A parameter n characterizing the size of an algorithm input such as the number of list elements, matrix order, number of graph vertices, or bit-length of a number, serving as the independent variable in efficiency functions."@en .

ae:MasterTheorem a owl:Class ;
    rdfs:label "Master Theorem"@en ;
    measurement:hasMeasurementSubject measurement:AlgorithmAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Cormen et al 2022 Sec4.5"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf [ ],
        ae:AnalysisTool ;
    owl:disjointWith ae:AccountingMethod,
        ae:AggregateMethod,
        ae:AkraBazziMethod,
        ae:BackwardSubstitution,
        ae:CharacteristicEquation,
        ae:DecisionTreeTechnique,
        ae:LimitComparison,
        ae:PotentialMethod,
        ae:RecursionTreeMethod,
        ae:StirlingApproximation,
        ae:SubstitutionMethod ;
    skos:definition "A theorem providing closed-form solutions for divide-and-conquer recurrences T(n) = aT(n/b) + f(n) by comparing f(n) with n^(log_b a) across three cases, enabling rapid classification of many recursive algorithms."@en .

ae:NonrecursiveAnalysis a owl:Class ;
    rdfs:label "Nonrecursive Algorithm Analysis"@en ;
    measurement:hasMeasurementSubject measurement:AlgorithmAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Sec2.3"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf [ ],
        ae:AnalysisMethod ;
    owl:disjointWith ae:AdversaryArgumentMethod,
        ae:AutomatedComplexityAnalysis,
        ae:EmpiricalAnalysisMethod,
        ae:HybridAnalysis,
        ae:ProbabilisticAnalysis,
        ae:RecursiveAnalysis,
        ae:VisualizationAnalysis ;
    skos:definition "A systematic method for analyzing iterative algorithms by identifying the basic operation, setting up a summation for its execution count as a function of loop bounds, and simplifying using standard summation formulas."@en .

ae:ParameterizedComplexityW2 a owl:Class ;
    rdfs:label "W[2] Complexity Class"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Downey and Fellows 2013 Fundamentals of Parameterized Complexity"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:ParameterizedComplexityClass ;
    skos:definition "The second level of the W-hierarchy believed to strictly contain W[1], with the canonical complete problem being k-Dominating Set, representing problems requiring nondeterministic circuits of bounded weft and unbounded depth."@en .

ae:SmoothedAnalysisParadigm a owl:Class ;
    rdfs:label "Smoothed Analysis Paradigm"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Spielman and Teng 2004 Smoothed Analysis of Algorithms JACM 51(3) 385-463"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf [ ],
        ae:AnalysisParadigm ;
    skos:definition "An analysis paradigm that measures worst-case expected running time over slight random perturbations of any input, explaining why algorithms like the simplex method perform well in practice despite exponential worst-case bounds."@en .

ae:TheoreticalContribution a owl:Class ;
    rdfs:label "Theoretical Contribution"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "ACM A.M. Turing Award Lectures"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:FoundationalContribution ;
    owl:disjointWith ae:MethodologicalContribution ;
    skos:definition "A foundational contribution establishing a new theoretical result, complexity class, or impossibility theorem that fundamentally advanced understanding of algorithmic efficiency limits."@en .

ae:TimeComplexityClass a owl:Class ;
    rdfs:label "Time Complexity Class"@en ;
    measurement:hasMeasurementSubject measurement:ComputationalProblemAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Arora and Barak 2009 Ch1-Ch3"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:ComplexityClass ;
    owl:disjointWith ae:SpaceComplexityClass ;
    skos:definition "A complexity class defined by bounds on the number of computational steps or time units required by algorithms, encompassing DTIME, P, NP, EXP, and related time-bounded hierarchies."@en .

ae:TimingExperiment a owl:Class ;
    rdfs:label "Timing Experiment"@en ;
    measurement:hasMeasurementSubject measurement:ProgramAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Sec2.6"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:EmpiricalMethod ;
    owl:disjointWith ae:OperationCounting,
        ae:ProfilingMethod,
        ae:RatioBasedEstimation,
        ae:ScatterplotAnalysis,
        ae:StatisticalInference ;
    skos:definition "An empirical method measuring wall-clock running time of an algorithm implementation on various input sizes, requiring careful control of system load, clock precision, and warm-up effects."@en .

ae:analyzedBy a owl:ObjectProperty ;
    rdfs:label "analyzed by"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    owl:inverseOf ae:analyzes ;
    skos:definition "Relates an algorithm family to the analysis method used to study its efficiency."@en .

ae:appliesKnowledgeFrom a owl:ObjectProperty ;
    rdfs:label "applies knowledge from"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    skos:definition "Relates a use case to the domain knowledge it draws upon."@en .

ae:benchmarkURL a owl:DatatypeProperty ;
    rdfs:label "benchmark URL"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "OE Pack v17.27.0 Challenge 2 — design-intent rdfs:domain extraction with LCA correction per L-48. benchmarkURL is used on BenchmarkingSuite AND VisualizationTool instances (which are owl:disjointWith). LCA walk identified ae:AnalysisResource as common ancestor (no disjointness). Per skos:definition: \"where a benchmarking suite or tool can be accessed.\""@en,
        "OE Pack v17.27.0 Challenge 2 — design-intent rdfs:domain extraction. Per skos:definition: \"web address where a benchmarking suite or tool can be accessed.\" Same-NS class."@en ;
    rdfs:domain ae:AnalysisResource ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:range xsd:anyURI ;
    skos:definition "The web address where a benchmarking suite or tool can be accessed."@en .

ae:characterizedByNotation a owl:ObjectProperty ;
    rdfs:label "characterized by notation"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    rdfs:domain ae:EfficiencyClass ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:range ae:AsymptoticNotation ;
    skos:definition "Relates an efficiency class to the asymptotic notation used to express its growth rate bounds."@en .

ae:classifiedBy a owl:ObjectProperty ;
    rdfs:label "classified by"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    rdfs:domain ae:GrowthRateFunction ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:range ae:AsymptoticNotation ;
    skos:definition "Relates a growth rate function to the asymptotic notation describing its order of growth."@en .

ae:combinesDomain a owl:ObjectProperty ;
    rdfs:label "combines domain"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    skos:definition "Relates a use case to the inter-domain relationship it leverages."@en .

ae:competitiveRatio a owl:DatatypeProperty ;
    rdfs:label "competitive ratio"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "OE Pack v17.27.0 Challenge 2 — design-intent rdfs:domain extraction. Per skos:definition: \"worst-case ratio of an online algorithm cost to the optimal offline cost.\" CompetitiveAnalysisParadigm is the analysis context where competitive ratios are defined."@en ;
    rdfs:domain ae:CompetitiveAnalysisParadigm ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:range xsd:decimal ;
    skos:definition "The worst-case ratio of an online algorithm cost to the optimal offline cost."@en .

ae:constrains a owl:ObjectProperty ;
    rdfs:label "constrains"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    rdfs:domain ae:PhilosophicalFoundation ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:range ae:AnalysisArchitecture ;
    skos:definition "Relates a philosophical foundation to the analysis architectures it constrains or informs."@en .

ae:derivedUsing a owl:ObjectProperty ;
    rdfs:label "derived using"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    skos:definition "Relates a result to the tool used in its derivation."@en .

ae:establishes a owl:ObjectProperty ;
    rdfs:label "establishes"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    skos:definition "Relates a technique or method to the type of bound or result it establishes."@en .

ae:exemplifiedBy a owl:ObjectProperty ;
    rdfs:label "exemplified by"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    skos:definition "Relates a concept to a specific named individual that exemplifies it."@en .

ae:extendsParadigm a owl:ObjectProperty ;
    rdfs:label "extends paradigm"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    skos:definition "Relates a concept that extends or generalizes an existing analysis paradigm."@en .

ae:formalDefinition a owl:DatatypeProperty ;
    rdfs:label "formal definition"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "OE Pack v17.27.0 Challenge 2 — design-intent rdfs:domain extraction. Per skos:definition: \"mathematical formula expressing the precise definition of an asymptotic notation or bound.\" AsymptoticNotation is same-NS class."@en ;
    rdfs:domain ae:AsymptoticNotation ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:range xsd:string ;
    skos:definition "A mathematical formula expressing the precise definition of an asymptotic notation or bound."@en .

ae:generalizes a owl:ObjectProperty ;
    rdfs:label "generalizes"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    skos:definition "Relates a more general tool or concept to a more specific one it subsumes."@en .

ae:growthOrder a owl:DatatypeProperty ;
    rdfs:label "growth order"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "OE Pack v17.26.0 Option N — Inferred from EfficiencyClass instances using growthOrder"@en ;
    rdfs:domain ae:EfficiencyClass ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:range xsd:string ;
    skos:definition "The canonical expression for a function order of growth."@en .

ae:hasEfficiencyClass a owl:ObjectProperty ;
    rdfs:label "has efficiency class"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:range ae:EfficiencyClass ;
    skos:definition "Relates an algorithm or problem instance to its asymptotic efficiency class."@en .

ae:implementedBy a owl:ObjectProperty ;
    rdfs:label "implemented by"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    skos:definition "Relates a method to the resource or tool that implements it."@en .

ae:influencesAnalysisOf a owl:ObjectProperty ;
    rdfs:label "influences analysis of"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    rdfs:domain ae:PhilosophicalFoundation ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:range ae:AnalysisArchitecture ;
    skos:definition "Relates a philosophical principle to the analysis framework it fundamentally shapes."@en .

ae:inputSizeParameter a owl:DatatypeProperty ;
    rdfs:label "input size parameter"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "OE Pack v17.27.0 Challenge 2 — design-intent rdfs:domain extraction. Per skos:definition: \"variable representing input size in an analysis context.\" AnalysisParadigm is most general analysis-context class."@en ;
    rdfs:domain ae:AnalysisParadigm ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:range xsd:string ;
    skos:definition "The variable representing input size in an analysis context."@en .

ae:publicationYear a owl:DatatypeProperty ;
    rdfs:label "publication year"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "OE Pack v17.27.0 Challenge 2 — design-intent extraction attempted but reverted per L-48 LCA analysis. See rdfs:comment for full rationale."@en ;
    rdfs:comment "Per L-48: publicationYear is used on instances of HistoricalCaseStudy, KeyContributor, ComplexityAnalysisTool, and Textbook. These 4 classes share NO common ancestor in the algorithm-efficiency hierarchy (HistoricalContext vs AnalysisResource are sibling top-level branches), so no single rdfs:domain assignment exists without OWL 2 DL inconsistency. publicationYear correctly remains domain-less."@en,
        "v19.0.1: range changed from xsd:string to xsd:int per Proposal E F1. The xsd:string range was a workaround for xsd:gYear lexical form pre-migration; after v19.0.0 migrated xsd:gYear → xsd:int, the range should follow per BP-D21 semantic correctness."@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:range xsd:int ;
    skos:definition "The year in which a foundational work was first published."@en .

ae:recurrenceForm a owl:DatatypeProperty ;
    rdfs:label "recurrence form"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "OE Pack v17.26.0 Option N — Inferred from RecurrenceRelation instances using recurrenceForm"@en ;
    rdfs:domain ae:RecurrenceRelation ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:range xsd:string ;
    skos:definition "The mathematical expression of a recurrence relation."@en .

ae:refinesClassification a owl:ObjectProperty ;
    rdfs:label "refines classification"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    skos:definition "Relates a finer-grained classification to a coarser one it refines."@en .

ae:requiresInput a owl:ObjectProperty ;
    rdfs:label "requires input"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    skos:definition "Relates an analysis strategy to the type of input information it requires."@en .

ae:solutionForm a owl:DatatypeProperty ;
    rdfs:label "solution form"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "OE Pack v17.26.0 N (corrected): rdfs:domain reverted to StructuralConcept (common superclass of RecurrenceRelation and ClosedFormSolution) after HermiT detected inconsistency from initial RecurrenceRelation-only domain. Per BP-D23+L-48: usage inference must check class disjointness before asserting domain."@en,
        "OE Pack v17.26.0 Option N — Inferred from RecurrenceRelation + ClosedFormSolution usage. Single-domain assignment chosen for OWL 2 DL simplicity; ClosedFormSolution usage is via inheritance/sibling property"@en ;
    rdfs:domain ae:StructuralConcept ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:range xsd:string ;
    skos:definition "The closed-form or asymptotic solution to a recurrence."@en .

ae:solves a owl:ObjectProperty ;
    rdfs:label "solves"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    owl:inverseOf ae:solvedBy ;
    skos:definition "Relates an analysis tool to the class of recurrences it is capable of solving."@en .

ae:supportsParadigm a owl:ObjectProperty ;
    rdfs:label "supports paradigm"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    skos:definition "Relates a tool or resource to the analysis paradigm it supports."@en .

ae:toolVersion a owl:DatatypeProperty ;
    rdfs:label "tool version"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "OE Pack v17.27.0 Challenge 2 — design-intent rdfs:domain extraction. Per skos:definition: \"version identifier of a software tool.\" AnalysisTool is same-NS analogue."@en ;
    rdfs:domain ae:AnalysisTool ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:range xsd:string ;
    skos:definition "The version identifier of a software tool."@en .

ae:usesHypothesis a owl:ObjectProperty ;
    rdfs:label "uses hypothesis"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    skos:definition "Relates an analysis paradigm to the computational hardness hypothesis it relies upon."@en .

ae:usesTool a owl:ObjectProperty ;
    rdfs:label "uses tool"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    rdfs:domain ae:AnalysisMethod ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:range ae:AnalysisTool ;
    skos:definition "Relates an analysis method to the mathematical tool it employs."@en .

ae:yearIntroduced a owl:DatatypeProperty ;
    rdfs:label "year introduced"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    rdfs:comment "v19.0.1: range changed from xsd:string to xsd:int per Proposal E F1 extension. Same defect pattern as ae:publicationYear; year values are integer-valued."@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:range xsd:int ;
    skos:definition "The year in which a concept or complexity class was first introduced."@en .

acap:hasCapabilityLevel a owl:ObjectProperty ;
    rdfs:label "has capability level"@en ;
    dcterms:isPartOf <http://example.org/artifact-capability> ;
    rdfs:range acap:ArtifactCapabilityLevel .

acap:hasMaturityLevel a owl:ObjectProperty ;
    rdfs:label "has maturity level"@en ;
    dcterms:isPartOf <http://example.org/artifact-capability> ;
    rdfs:range acap:ArtifactMaturityLevel .

acap:hasScoreBasis a owl:DatatypeProperty ;
    rdfs:label "has score basis"@en ;
    dcterms:isPartOf <http://example.org/artifact-capability> ;
    rdfs:range xsd:string ;
    skos:definition "The measured values behind a level, so the score can be disputed by re-derivation rather than trusted."@en .

configuration:ABoxFile a owl:Class ;
    rdfs:label "ABox file"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    rdfs:comment "An OntologyFile whose contents are restricted to assertional axioms (NamedIndividual declarations, type assertions, property assertions on individuals) WITHOUT terminological axioms. Imports its companion TBoxFile via owl:imports. Used when a subject's ontology is split for separation of concerns. Pairs with configuration:TBoxFile."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf configuration:OntologyFile ;
    skos:definition "An OntologyFile whose contents are restricted to assertional axioms (NamedIndividual declarations, type assertions, property assertions on individuals) WITHOUT terminological axioms. Imports its companion TBoxFile via owl:imports. Used when a subject's ontology is split for separation of concerns. Pairs with configuration:TBoxFile."@en ;
    skos:example "meta_abox_v6_7_1.ttl, amod_abox_v1_5_0.ttl, oqc_abox_v2_3_2.ttl"@en .

configuration:AtomicChange a owl:Class ;
    rdfs:label "Atomic Change"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Single indivisible modification."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html>,
        <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:ChangeOperation ;
    skos:definition "A change operation representing the smallest indivisible modification to the ontology, such as adding or removing a single triple, that cannot be meaningfully decomposed into smaller sub-operations."@en ;
    skos:example "Atomic change adds one class."@en .

configuration:AuditReportMarkdown a owl:Class ;
    rdfs:label "audit report markdown"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "OE Pack family v15-v16 prior-report filename patterns (PR1-PR8)."@en ;
    rdfs:comment "A markdown document recording an audit, review, or assessment report. Filename pattern in OE Pack convention: '{lowercase_name}_v{M}_{m}_{p}.md' (note: prior-reports use lowercase + underscore + 3-part). Both capitalised and lowercase forms are accepted under this convention since OE Pack history mixes them."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf configuration:ProjectMarkdownDocument ;
    skos:definition "A markdown document recording an audit, review, or assessment report. Filename pattern in OE Pack convention: '{lowercase_name}_v{M}_{m}_{p}.md' (note: prior-reports use lowercase + underscore + 3-part). Both capitalised and lowercase forms are accepted under this convention since OE Pack history mixes them."@en ;
    skos:example "oee_methodology_audit_v1_0_0.md ; OEEcosystem_Review_v1_0_0.md ; compliance_reliability_versioning_audit_v1_0_0.md"@en .

configuration:BackwardCompatibility a owl:Class ;
    rdfs:label "Backward Compatibility"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "semver.org §3-4; W3C OWL 2 §3.5 owl:backwardCompatibleWith."@en ;
    rdfs:comment "Property of a new version asserting that it is backwards-compatible with an earlier version — consumers depending on the older version continue to work. In OWL: every entailment of the prior version is also an entailment of the new version."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf configuration:ConfigurationManagementConcept ;
    skos:definition "Property of a new version asserting that it is backwards-compatible with an earlier version — consumers depending on the older version continue to work. In OWL: every entailment of the prior version is also an entailment of the new version."@en .

configuration:BackwardMigration a owl:Class ;
    rdfs:label "Backward Migration"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Backward Migration."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1>,
        <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf configuration:MigrationManagement ;
    skos:definition "A migration management strategy that reverts the ontology and its dependent systems to a previous version when the current version is found to have unacceptable defects or incompatibilities."@en ;
    skos:example "Reverting oqc_v2_2_1.ttl's owl:imports declaration for AMOD after discovering that a legacy system's rdflib 5.x does not support the AMOD prefix resolution, downgrading to pre-import state, is BackwardMigration."@en .

configuration:BreakingChange a owl:Class ;
    rdfs:label "Breaking Change"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "semver.org §8; ISO/IEC 14764:2022 software maintenance."@en ;
    rdfs:comment "A change to an artifact's public surface (API, IRI vocabulary, file structure) that requires a SemVer MAJOR version increment because it is not backwards-compatible. Examples: removing a class, narrowing a property domain, renaming an IRI."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf configuration:ConfigurationManagementConcept ;
    skos:definition "A change to an artifact's public surface (API, IRI vocabulary, file structure) that requires a SemVer MAJOR version increment because it is not backwards-compatible. Examples: removing a class, narrowing a property domain, renaming an IRI."@en .

configuration:BulkChange a owl:Class ;
    rdfs:label "Bulk Change"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Multiple changes applied together."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html>,
        <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:ChangeOperation ;
    skos:definition "A change operation that applies multiple atomic modifications as a single batch transaction, ensuring all changes succeed or fail together to maintain ontology consistency during large-scale updates."@en ;
    skos:example "Bulk renaming 20 classes with new prefix."@en .

configuration:ChangeType a owl:Class ;
    rdfs:label "Change Type"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Conventional Commits 1.0.0; Angular Commit Message Conventions."@en ;
    rdfs:comment "Categorisation of a single change: feat / fix / perf / refactor / docs / test / build / ci / style / revert / chore. Drives automated changelog generation and SemVer increment selection."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf configuration:ConfigurationManagementConcept ;
    skos:definition "Categorisation of a single change: feat / fix / perf / refactor / docs / test / build / ci / style / revert / chore. Drives automated changelog generation and SemVer increment selection."@en .

configuration:ChangelogEntry a owl:Class ;
    rdfs:label "Changelog Entry"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Keep a Changelog 1.1.0 (keepachangelog.com); Conventional Commits 1.0.0 (conventionalcommits.org)."@en ;
    rdfs:comment "A single entry in a project's CHANGELOG.md describing user-facing changes for one release. Convention: organised under headings Added / Changed / Deprecated / Removed / Fixed / Security."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf configuration:DocumentationFile ;
    skos:definition "A single entry in a project's CHANGELOG.md describing user-facing changes for one release. Convention: organised under headings Added / Changed / Deprecated / Removed / Fixed / Security."@en .

configuration:ClassMerge a owl:Class ;
    rdfs:label "Class Merge"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Class Merge - ontology evolution operation."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:StructuralChange ;
    skos:definition "A structural change that combines two or more existing classes into a single class, unifying their subclasses, restrictions, and instance populations while establishing equivalence mappings for backward compatibility."@en ;
    skos:example "Combining ex:OntologyTool and ex:ReasonerTool into a single ex:OntologyProcessingTool class after discovering they share all properties and no individual belongs exclusively to one is ClassMerge."@en .

configuration:ClassRename a owl:Class ;
    rdfs:label "Class Rename"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Changing the URI or label of an existing class."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:ClassModification ;
    skos:definition "A class modification that changes the URI identifier of an existing class while preserving all its axioms and annotations, requiring coordinated updates across all references in the ontology."@en ;
    skos:example "Renaming class 'Car' to 'Automobile' by updating URI and adding label."@en .

configuration:ClassRestrictionChange a owl:Class ;
    rdfs:label "Class Restriction Change"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Modifying cardinality, value, or property restrictions on a class."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:ClassModification ;
    skos:definition "A class modification that adds, removes, or alters the OWL restrictions associated with an existing class, changing the necessary or sufficient conditions for individual classification."@en ;
    skos:example "Changing Vehicle restriction 'hasEngine exactly 1' to 'hasEngine min 1'."@en .

configuration:ClassSplit a owl:Class ;
    rdfs:label "Class Split"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Class Split - ontology evolution operation."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:StructuralChange ;
    skos:definition "A structural change that divides an existing class into two or more more-specific classes, distributing the original class's instances among the new subclasses based on distinguishing criteria."@en ;
    skos:example "Dividing ex:ValidationProcess into ex:SHACLValidationProcess and ex:ReasonerValidationProcess because they differ in inputs, outputs, and tool requirements, is ClassSplit to increase ontological precision."@en .

configuration:CommentChange a owl:Class ;
    rdfs:label "Comment Change"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Modifying rdfs:comment descriptions."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/> ;
    rdfs:subClassOf configuration:AnnotationChange ;
    skos:definition "An annotation change that modifies the rdfs:comment of an existing ontology element, updating the informal description without affecting the element's formal semantics or reasoning behavior."@en ;
    skos:example "Expanding comment to include usage examples and design rationale."@en .

configuration:CompositeChange a owl:Class ;
    rdfs:label "Composite Change"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Multiple related atomic changes."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html>,
        <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:ChangeOperation ;
    skos:definition "A change operation that combines multiple related atomic changes into a semantically meaningful unit, such as 'add class with all annotations and restrictions' as a single trackable modification."@en ;
    skos:example "Composite change adds class with 3 properties."@en .

configuration:ConceptRedefinition a owl:Class ;
    rdfs:label "Concept Redefinition"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Changing the definition or scope of a class concept."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:MeaningChange ;
    skos:definition "A meaning change where the intended interpretation of a class is altered through updated definitions, scope documentation, or usage guidelines, even without modifying the formal axiom set."@en ;
    skos:example "Redefining 'Car' to include only passenger vehicles, excluding racing cars."@en .

configuration:CrossArtefactDependency a owl:Class ;
    rdfs:label "Cross-Artefact Dependency"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "ISO/IEC 15289:2019 Systems and software engineering — Content of life-cycle information items. SWEBOK v4.0 (IEEE, 2024) — Software Configuration Management. Decan, A., Mens, T. & Grosjean, P. (2019). On the evolution of technical lag in the npm package dependency network. Empirical Software Engineering."@en ;
    rdfs:comment "A versioned reference from one EngineeringArtefact (the dependent) to another (the dependency), declaring that the dependent requires a specific version of the dependency to be valid. Makes implicit owl:imports and SHACL shape references explicit and version-pinned."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html>,
        <https://www.w3.org/TR/prov-o/#wasDerivedFrom> ;
    rdfs:subClassOf configuration:ConfigurationManagementConcept,
        prov:Entity ;
    skos:definition "A versioned reference from one EngineeringArtefact (the dependent) to another (the dependency), declaring that the dependent requires a specific version of the dependency to be valid. Makes implicit owl:imports and SHACL shape references explicit and version-pinned."@en ;
    skos:example "redo_shacl_v2_0_3.ttl → validates-against → redo_v2_4_9.ttl@2.4.9"@en .

configuration:CrossTrackDependency a owl:Class ;
    rdfs:label "cross-track dependency"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "OE Pack expansion-plan ontology plan:CrossTrackDependency."@en ;
    rdfs:comment "A dependency relation between two Tracks (e.g., Track-B can't start until Track-A delivers Sprint-3). Captured explicitly so the SequencingOption can reason about feasibility."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf configuration:PlanArtefact ;
    skos:definition "A dependency relation between two Tracks (e.g., Track-B can't start until Track-A delivers Sprint-3). Captured explicitly so the SequencingOption can reason about feasibility."@en .

configuration:DeprecationNotice a owl:Class ;
    rdfs:label "Deprecation Notice"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "W3C OWL 2 §3.5 owl:deprecated; OBO Foundry deprecation policy."@en ;
    rdfs:comment "A formal notice that an entity (class, property, individual) or an entire artifact version is deprecated and will be removed in a future MAJOR release. Implemented in OWL via owl:deprecated true, plus a replacement-pointer via dcterms:isReplacedBy."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf configuration:ConfigurationManagementConcept ;
    skos:definition "A formal notice that an entity (class, property, individual) or an entire artifact version is deprecated and will be removed in a future MAJOR release. Implemented in OWL via owl:deprecated true, plus a replacement-pointer via dcterms:isReplacedBy."@en .

configuration:DisjointnessChange a owl:Class ;
    rdfs:label "Disjointness Change"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Modifying disjointness declarations between classes."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:AxiomChange ;
    skos:definition "An axiom change that adds or removes disjointness declarations between classes, directly affecting which individuals can be simultaneously classified under multiple classes in the ontology."@en ;
    skos:example "Declaring 'ElectricVehicle' and 'GasolineVehicle' as disjoint classes."@en .

configuration:DomainChange a owl:Class ;
    rdfs:label "Domain Change"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Modifying the domain class constraint of a property."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:PropertyModification ;
    skos:definition "A property modification that alters the rdfs:domain declaration of an existing property, changing which classes are inferred as types of subjects that use the property in assertions."@en ;
    skos:example "Expanding 'hasDriver' domain from 'Car' to all 'Vehicle' subclasses."@en .

configuration:EntailmentChange a owl:Class ;
    rdfs:label "Entailment Change"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Change affecting logical entailments under specific semantics."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:LogicalChange ;
    skos:definition "A logical change where the set of logical entailments derivable from the ontology's axiom set is altered, potentially affecting query results that depend on inferred rather than asserted triples."@en ;
    skos:example "Removing axiom changes what statements are entailed under OWL DL semantics."@en .

configuration:ExampleChange a owl:Class ;
    rdfs:label "Example Change"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Adding, removing, or updating usage examples in annotations."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/> ;
    rdfs:subClassOf configuration:DocumentationChange ;
    skos:definition "A documentation change that modifies the skos:example annotations of an ontology element, updating the illustrative usage instances that help consumers understand the element's intended application."@en ;
    skos:example "Adding example 'A Tesla Model 3 is an instance of ElectricVehicle'."@en .

configuration:FilenameSubjectPrefixAlignment a owl:Class ;
    rdfs:label "Filename Subject-Prefix Alignment"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Authored in AMOD v2.0.0 (step 13, 2026-05-13). Vocabulary anchor for the operational discipline in PROTOCOL-BINDING v1.0.3 B8. Same vocabulary-vs-enforcement separation as oqc:OntologyFileStructureCompliance (step 8)."@en ;
    rdfs:comment "AMOD discipline rule: the filename prefix of a TTL file MUST equal the local-name portion of its owl:Ontology IRI. For example, a file declaring <http://example.org/ae> must be named algorithm_efficiency_*.ttl, not ae_*.ttl. The discipline is operationally enforced by a reliability ontology protocol binding B8 (FilenameIriAlignmentCheck). Surfaced by 4 cases this consolidation session: step 5 oem_bridge → oe_measurement, step 6 ae → algorithm_efficiency, step 8 oqc → quality, step 9 redo → reliability."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf configuration:ConfigurationManagementConcept ;
    skos:definition "AMOD discipline rule: the filename prefix of a TTL file MUST equal the local-name portion of its owl:Ontology IRI. For example, a file declaring <http://example.org/ae> must be named algorithm_efficiency_*.ttl, not ae_*.ttl. The discipline is operationally enforced by a reliability ontology protocol binding B8 (FilenameIriAlignmentCheck). Surfaced by 4 cases this consolidation session: step 5 oem_bridge → oe_measurement, step 6 ae → algorithm_efficiency, step 8 oqc → quality, step 9 redo → reliability."@en .

configuration:ForwardMigration a owl:Class ;
    rdfs:label "Forward Migration"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Forward Migration."@en,
        "Migrating from older version to newer version."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1>,
        <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf configuration:MigrationManagement,
        configuration:MigrationStrategy ;
    skos:definition "A migration management strategy that advances consumers and data from the current ontology version to a newer version, providing transformation scripts and compatibility layers to ease the transition."@en ;
    skos:example "Upgrading dataset from ontology v1.5 to v2.0 with automated transformations."@en .

configuration:HierarchyDeepening a owl:Class ;
    rdfs:label "Hierarchy Deepening"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Increasing hierarchy depth by adding intermediate abstraction levels."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:HierarchyChange ;
    skos:definition "A hierarchy change that inserts new intermediate classes between existing levels, adding specialization depth to a part of the class hierarchy that was previously too flat for domain accuracy."@en ;
    skos:example "Adding 'PassengerVehicle' level between 'Vehicle' and 'Car' for more specific classification."@en .

configuration:HierarchyFlattening a owl:Class ;
    rdfs:label "Hierarchy Flattening"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Reducing hierarchy depth by removing intermediate classes."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:HierarchyChange ;
    skos:definition "A hierarchy change that removes intermediate classes from the hierarchy, reducing specialization depth in areas where excessive granularity adds complexity without providing useful distinctions for consumers."@en ;
    skos:example "Removing intermediate class 'IntermediateVehicle' and connecting children directly to 'Vehicle'."@en .

configuration:HierarchyReorganization a owl:Class ;
    rdfs:label "Hierarchy Reorganization"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Hierarchy Reorganization - ontology evolution operation."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/>,
        <https://www.w3.org/TR/owl2-primer/> ;
    rdfs:subClassOf configuration:StructuralChange ;
    skos:definition "A structural change that restructures a significant portion of the class hierarchy, such as introducing new intermediate classes, removing unnecessary levels, or rebalancing heavily skewed subtrees."@en ;
    skos:example "Moving ex:SHACLApacheJena from under ex:CommandLineTool to under ex:ApacheJenaFamilyTool after discovering it shares more structural properties with Jena siblings than with generic CLI tools is HierarchyReorganization."@en .

configuration:HotfixRelease a owl:Class ;
    rdfs:label "Hotfix Release"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Git Flow (Driessen 2010); industry release-engineering practice."@en ;
    rdfs:comment "An out-of-cycle PATCH release addressing a critical production incident on a stable MAJOR.MINOR baseline, branched from the latest tag rather than the development trunk."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf configuration:SemVerVersion ;
    skos:definition "An out-of-cycle PATCH release addressing a critical production incident on a stable MAJOR.MINOR baseline, branched from the latest tag rather than the development trunk."@en .

configuration:InferenceChange a owl:Class ;
    rdfs:label "Inference Change"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Change that modifies what facts can be derived through reasoning."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:LogicalChange ;
    skos:definition "A logical change where modifications to axioms cause the reasoner to derive different conclusions than before, adding new entailments or removing previously available inferences from the computed closure."@en ;
    skos:example "Adding property chain axiom enables inference of new relationships."@en .

configuration:LabelChange a owl:Class ;
    rdfs:label "Label Change"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Modifying rdfs:label annotations."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/> ;
    rdfs:subClassOf configuration:AnnotationChange ;
    skos:definition "An annotation change that modifies the rdfs:label of an existing ontology element, changing the human-readable display name while preserving the element's URI and formal definitions."@en ;
    skos:example "Changing label from 'Vehicle' to 'Transportation Vehicle' for specificity."@en .

configuration:MigrationGuide a owl:Class ;
    rdfs:label "Migration Guide"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Industry standard release artefact (e.g., Angular Update Guide, Python What's New)."@en ;
    rdfs:comment "A user-facing document accompanying a MAJOR release that explains breaking changes and the migration path from the previous MAJOR version."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf configuration:DocumentationFile ;
    skos:definition "A user-facing document accompanying a MAJOR release that explains breaking changes and the migration path from the previous MAJOR version."@en .

configuration:ObjectPropertyAddition a owl:Class ;
    rdfs:label "Object Property Addition"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Adding a new object property connecting individual entities."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:PropertyAddition ;
    skos:definition "A property addition specifically creating a new object property that relates ontology individuals to other individuals, with specified domain class, range class, and inverse or functional characteristics."@en ;
    skos:example "Adding 'ownedBy' object property from Vehicle to Person."@en .

configuration:OpenQuestion a owl:Class ;
    rdfs:label "open question"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "OE Pack expansion-plan ontology plan:OpenQuestion."@en ;
    rdfs:comment "A planning-time question that requires resolution (typically by user decision) before execution can proceed. Each has a recommendedAnswer (the planner's best-guess) and a requiresUserDecision flag."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf configuration:PlanArtefact ;
    skos:definition "A planning-time question that requires resolution (typically by user decision) before execution can proceed. Each has a recommendedAnswer (the planner's best-guess) and a requiresUserDecision flag."@en .

configuration:PlanMarkdown a owl:Class ;
    rdfs:label "plan markdown"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "OE Pack family Implementation_Plan_v1_0_0.md actual filename pattern."@en ;
    rdfs:comment "A markdown document recording an implementation plan, expansion plan, or sprint plan. Filename pattern: '{Capitalised_name}_Plan_v{M}_{m}_{p}.md'."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf configuration:ProjectMarkdownDocument ;
    skos:definition "A markdown document recording an implementation plan, expansion plan, or sprint plan. Filename pattern: '{Capitalised_name}_Plan_v{M}_{m}_{p}.md'."@en ;
    skos:example "Implementation_Plan_v1_0_0.md ; Post_Implementation_Expansion_Plan_v1_0_0.md"@en .

configuration:ProjectClosureDocument a owl:Class ;
    rdfs:label "Project Closure Document"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Issue I-04 (Phase 1 Structural Cleanup); user house-style observation."@en ;
    rdfs:comment "A project-internal markdown document that captures the closure of a sprint, plan, review, or remediation activity. Sibling of configuration:DocumentationFile under configuration:EngineeringArtefact (NOT a subclass) to avoid inheriting AMOD S7's 2-part-version constraint. Filename uses 3-part underscore-delimited version per configuration:ProjectClosureMarkdownConvention."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf configuration:EngineeringArtefact ;
    owl:disjointWith configuration:DocumentationFile,
        configuration:SafeguardDocument ;
    skos:definition "A project-internal markdown document that captures the closure of a sprint, plan, review, or remediation activity. Sibling of configuration:DocumentationFile under configuration:EngineeringArtefact (NOT a subclass) to avoid inheriting AMOD S7's 2-part-version constraint. Filename uses 3-part underscore-delimited version per configuration:ProjectClosureMarkdownConvention."@en ;
    skos:example "Sprint_8_Closure_v1_0_0.md, Implementation_Plan_v1_0_0.md, STEP_0_I17_Closure_v1_0_0.md, Phase1_Lessons_Refined_v1_0_0.md"@en .

configuration:ProjectClosureMarkdown a owl:Class ;
    rdfs:label "project closure markdown"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "OE Pack family Sprint 0-8 closure document filename pattern."@en ;
    rdfs:comment "A markdown document recording the closure of a sprint, phase, or review — typically structured with §0 What this document is, §N deliverables, §Honest disclosures, §Lessons. Filename pattern: '{Capitalised_name}_Closure_v{M}_{m}_{p}.md'."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf configuration:ProjectMarkdownDocument ;
    skos:definition "A markdown document recording the closure of a sprint, phase, or review — typically structured with §0 What this document is, §N deliverables, §Honest disclosures, §Lessons. Filename pattern: '{Capitalised_name}_Closure_v{M}_{m}_{p}.md'."@en ;
    skos:example "Sprint_8_Closure_v1_0_0.md ; Phase1_Closure_v1_0_0.md ; ReviewSprint_Closure_v1_0_0.md"@en .

configuration:PropertyDeletion a owl:Class ;
    rdfs:label "Property Deletion"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Removing a property from the ontology."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:PropertyChange ;
    skos:definition "A property change that removes an existing property from the ontology, requiring removal of all restrictions referencing it and migration of any instance data using the deleted property."@en ;
    skos:example "Removing deprecated property 'oldAttribute' and its usage in restrictions."@en .

configuration:PropertyMerge a owl:Class ;
    rdfs:label "Property Merge"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Property Merge - ontology evolution operation."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/>,
        <https://www.w3.org/TR/owl2-primer/> ;
    rdfs:subClassOf configuration:StructuralChange ;
    skos:definition "A structural change that combines two or more existing properties into a single property, typically when they are found to represent the same relationship with unnecessarily different identifiers."@en ;
    skos:example "Replacing both ex:hasEvaluator and ex:assessedByAgent with a single ex:assessedBy (already defined in CORE) after discovering both map to the same semantic role is PropertyMerge."@en .

configuration:PropertySplit a owl:Class ;
    rdfs:label "Property Split"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Property Split - ontology evolution operation."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/>,
        <https://www.w3.org/TR/owl2-primer/> ;
    rdfs:subClassOf configuration:StructuralChange ;
    skos:definition "A structural change that divides an existing property into two or more more-specific properties, creating finer-grained relationship types to distinguish use cases that were previously conflated."@en ;
    skos:example "Dividing a single ex:hasRelatedResource property into ex:rdfs:seeAlso (external reference) and ex:owl:equivalentClass (formal equivalence) to capture distinct semantic relationships is PropertySplit."@en .

configuration:ProposedDeliverable a owl:Class ;
    rdfs:label "proposed deliverable"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "OE Pack expansion-plan ontology plan:ProposedDeliverable."@en ;
    rdfs:comment "An artifact a ProposedSprint commits to producing. Examples: 'oqc_aggregation_rules_v1_0_0.ttl', 'release_check.sh', 'Phase 1 Closure document'. Contrast: an executed Deliverable would be modelled as configuration:EngineeringArtefact (or one of its subclasses), not as ProposedDeliverable."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf configuration:PlanArtefact ;
    skos:definition "An artifact a ProposedSprint commits to producing. Examples: 'oqc_aggregation_rules_v1_0_0.ttl', 'release_check.sh', 'Phase 1 Closure document'. Contrast: an executed Deliverable would be modelled as configuration:EngineeringArtefact (or one of its subclasses), not as ProposedDeliverable."@en .

configuration:RangeChange a owl:Class ;
    rdfs:label "Range Change"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Modifying the range class constraint of a property."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:PropertyModification ;
    skos:definition "A property modification that alters the rdfs:range declaration of an existing property, changing which classes or datatypes are valid as objects when the property is used in assertions."@en ;
    skos:example "Restricting 'hasColor' range from 'String' to 'ColorEnum' class."@en .

configuration:RelationshipRedefinition a owl:Class ;
    rdfs:label "Relationship Redefinition"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Changing the meaning or interpretation of a property relationship."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:MeaningChange ;
    skos:definition "A meaning change where the intended interpretation of a property is altered through updated definitions or usage conventions, changing how the relationship should be understood and applied."@en ;
    skos:example "Redefining 'uses' property from 'currently using' to 'has capability to use'."@en .

configuration:ReleaseCandidate a owl:Class ;
    rdfs:label "Release Candidate"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "semver.org §9 pre-release identifiers; existing meta:ReleaseCandidateVersion."@en ;
    rdfs:comment "A version build pending final QA approval, typically named v<X.Y.Z>-rc.<N>. AMOD-side anchor for meta:ReleaseCandidateVersion."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf configuration:ConfigurationManagementConcept,
        kb:VersionConcept ;
    skos:definition "A version build pending final QA approval, typically named v<X.Y.Z>-rc.<N>. AMOD-side anchor for meta:ReleaseCandidateVersion."@en .

configuration:ReleaseTag a owl:Class ;
    rdfs:label "Release Tag"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Git documentation: git-tag(1); GitHub Releases."@en ;
    rdfs:comment "A version-control tag (typically Git annotated tag) marking a specific commit as a released version. Conventionally named 'v<SemVer>' (e.g., 'v15.4.0'). Required for SLSA Level 1+ provenance."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf configuration:ConfigurationManagementConcept ;
    skos:definition "A version-control tag (typically Git annotated tag) marking a specific commit as a released version. Conventionally named 'v<SemVer>' (e.g., 'v15.4.0'). Required for SLSA Level 1+ provenance."@en .

configuration:RestrictionChange a owl:Class ;
    rdfs:label "Restriction Change"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Modifying value, cardinality, or existential restrictions."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:AxiomChange ;
    skos:definition "An axiom change that modifies OWL restriction axioms on classes, altering the conditions that determine whether individuals qualify for membership in those classes based on their property values."@en ;
    skos:example "Changing 'hasWheel exactly 4' to 'hasWheel min 3' for Vehicle class."@en .

configuration:RoadmapReportMarkdown a owl:Class ;
    rdfs:label "roadmap report markdown"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "a registrant package's own RegisterPackageShape/Role_ProgressReport requirement, proposed brsf-continuation session, ratified by direct verification against configuration:AuditReportMarkdown's own real, already-shipped shape."@en ;
    rdfs:comment "A retained run of a roadmap/progress report, evidencing a register's trajectory over time rather than only its current state."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf configuration:ProjectMarkdownDocument ;
    skos:definition "A retained run of a roadmap/progress report, evidencing a register's trajectory over time rather than only its current state. Filename pattern identical to AuditReportMarkdown's own: '{name}_v{M}_{m}_{p}.md' — the two report kinds share the same real naming discipline (name, version, extension) but differ in what the artifact actually is, which appliesToArtifactType exists to distinguish."@en ;
    skos:example "roadmap_report_run_v1_170_0.md"@en .

configuration:RollbackMigration a owl:Class ;
    rdfs:label "Rollback Migration"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Reverting to previous version if migration encounters problems."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf configuration:MigrationStrategy ;
    skos:definition "A migration strategy variant that specifically addresses rapid reversion to the previous ontology version when a forward migration encounters critical failures during or after execution."@en ;
    skos:example "Rolling back from v2.0 to v1.5 after discovering critical inference errors."@en .

configuration:SBOMReference a owl:Class ;
    rdfs:label "SBOM Reference"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "NTIA Minimum Elements for an SBOM (2021); ISO/IEC 5962:2021 SPDX."@en ;
    rdfs:comment "A reference from an artifact to its Software Bill of Materials. The actual SBOM (SPDX, CycloneDX) is typed as redo:SBOM in the reliability namespace; AMOD owns the file-level reference."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf configuration:DocumentationFile ;
    skos:definition "A reference from an artifact to its Software Bill of Materials. The actual SBOM (SPDX, CycloneDX) is typed as redo:SBOM in the reliability namespace; AMOD owns the file-level reference."@en .

configuration:SafeClassDeletion a owl:Class ;
    rdfs:label "Safe Class Deletion"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Class removal that preserves data integrity by checking dependencies first."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:ClassDeletion ;
    skos:definition "A class deletion variant that includes pre-deletion impact analysis and migration procedures, ensuring all subclasses are re-parented and instances are reclassified before the class is removed."@en ;
    skos:example "Deleting 'TemporaryClass' only after confirming zero instances and references."@en .

configuration:SemanticEvolution a owl:Class ;
    rdfs:label "Semantic Evolution"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Changes affecting the semantic meaning and logical constraints of the ontology."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1>,
        <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:Evolution ;
    skos:definition "The process by which the meaning and logical content of an ontology changes over time through axiom modifications, concept redefinitions, and constraint adjustments that alter reasoning outcomes."@en ;
    skos:example "Recognizing that ex:Maintainer and ex:Tester were originally modeled as disjoint roles but now may co-occur in a DevOps engineer's responsibilities, and removing the owl:disjointWith axiom, is SemanticEvolution."@en .

configuration:SequencingOption a owl:Class ;
    rdfs:label "sequencing option"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "OE Pack expansion-plan ontology plan:SequencingOption."@en ;
    rdfs:comment "An ordering of Tracks/Sprints within a PlanProposal. Examples: 'sequential' (one track at a time), 'parallel' (concurrent tracks), 'priority-first' (highest-impact track first). A PlanProposal carries one recommendedSequencing — others are alternatives."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf configuration:PlanArtefact ;
    skos:definition "An ordering of Tracks/Sprints within a PlanProposal. Examples: 'sequential' (one track at a time), 'parallel' (concurrent tracks), 'priority-first' (highest-impact track first). A PlanProposal carries one recommendedSequencing — others are alternatives."@en .

configuration:StructuralEvolution a owl:Class ;
    rdfs:label "Structural Evolution"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Changes affecting the structural organization and taxonomy of the ontology."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1>,
        <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:Evolution ;
    skos:definition "The process by which the organizational architecture of an ontology changes over time through hierarchy modifications, module restructuring, and property reorganization that alter its formal structure."@en ;
    skos:example "Promoting ex:LLMBehavioralPathology from a standalone class to a subClassOf ex:QualityDefect after a review of the OQC framework identifies it as a quality-relevant concept requiring metrics is StructuralEvolution."@en .

configuration:SubClassAddition a owl:Class ;
    rdfs:label "Subclass Addition"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Adding a new class as a specialization of an existing class."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:ClassAddition ;
    skos:definition "A class addition that specifically creates a new class as a subclass of an existing parent, inheriting the parent's restrictions and fitting into the established hierarchical structure."@en ;
    skos:example "Adding 'Tesla' as subclass of 'ElectricVehicle' with rdfs:subClassOf axiom."@en .

configuration:SubtreeMove a owl:Class ;
    rdfs:label "Subtree Move"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Moving an entire branch of the taxonomy to a new parent location."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:HierarchyRestructuring ;
    skos:definition "A hierarchy restructuring operation that relocates an entire subtree of classes from one parent to another, changing the inherited properties and semantic context for all classes in the moved subtree."@en ;
    skos:example "Moving 'Truck' and all its subclasses from under 'Vehicle' to under 'CommercialVehicle'."@en .

configuration:TBoxFile a owl:Class ;
    rdfs:label "TBox file"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    rdfs:comment "An OntologyFile whose contents are restricted to terminological axioms (classes, properties, subClassOf relationships, restrictions, equivalent classes, domain/range, etc.) WITHOUT individual assertions. Used when a subject's ontology is split into terminology + instances (ABox) for separation of concerns. Pairs with configuration:ABoxFile."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf configuration:OntologyFile ;
    skos:definition "An OntologyFile whose contents are restricted to terminological axioms (classes, properties, subClassOf relationships, restrictions, equivalent classes, domain/range, etc.) WITHOUT individual assertions. Used when a subject's ontology is split into terminology + instances (ABox) for separation of concerns. Pairs with configuration:ABoxFile."@en ;
    skos:example "meta_tbox_v6_7_1.ttl, amod_tbox_v1_5_0.ttl, oqc_tbox_v2_3_2.ttl"@en .

configuration:USOShapeModule a owl:Class ;
    rdfs:label "USO Shape Module"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "USO v2 modular ontology ecosystem (http://purl.org/uso/ontology). AMOD BS-04 remediation, April 2026: USO uses a domain-specific naming convention distinct from the AMOD OntologyFileConvention — registered here for machine-findability."@en ;
    rdfs:comment "A SHACL shape file for a USO vocabulary module. Follows USOShapeModuleConvention: uso-{module}-shacl-v{M}_{m}.ttl."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/shacl/> ;
    rdfs:subClassOf configuration:EngineeringArtefact ;
    skos:definition "A SHACL shape file for a USO vocabulary module. Follows USOShapeModuleConvention: uso-{module}-shacl-v{M}_{m}.ttl."@en ;
    skos:example "uso-discovery-shacl-v1_0.ttl is a USOShapeModule: it declares SHACL NodeShapes that validate individuals in the companion uso-discovery-v1_0.ttl vocabulary module, following the USOShapeModuleConvention pattern uso-{module}-shacl-v{M}_{m}.ttl."@en .

configuration:USOTestModule a owl:Class ;
    rdfs:label "USO Test Module"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "USO v2 modular ontology ecosystem (http://purl.org/uso/ontology). AMOD BS-04 remediation, April 2026: USO uses a domain-specific naming convention distinct from the AMOD OntologyFileConvention — registered here for machine-findability."@en ;
    rdfs:comment "A SPARQL-based test file for a USO vocabulary module. Follows USOTestModuleConvention: uso-{module}-tests-v{M}_{m}.ttl."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html>,
        <https://www.w3.org/TR/shacl/> ;
    rdfs:subClassOf configuration:EngineeringArtefact ;
    skos:definition "A SPARQL-based test file for a USO vocabulary module. Follows USOTestModuleConvention: uso-{module}-tests-v{M}_{m}.ttl."@en ;
    skos:example "uso-discovery-tests-v1_0.ttl is a USOTestModule: it contains SPARQL ASK or SELECT queries that verify competency questions for the USO discovery vocabulary, following the pattern uso-{module}-tests-v{M}_{m}.ttl and referenced via configuration:usesVerificationQuery triples in the sprint manifest."@en .

configuration:USOVocabularyModule a owl:Class ;
    rdfs:label "USO Vocabulary Module"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "USO v2 modular ontology ecosystem (http://purl.org/uso/ontology). AMOD BS-04 remediation, April 2026: USO uses a domain-specific naming convention distinct from the AMOD OntologyFileConvention — registered here for machine-findability."@en ;
    rdfs:comment "A USO ontology vocabulary module — one of the 12 domain-specific OWL ontology files in the USO v2 modular ecosystem. Follows the USOVocabularyModuleConvention: uso-{module}-v{M}_{m}.ttl with hyphen separator and two-part versioning."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl2-primer/> ;
    rdfs:subClassOf configuration:EngineeringArtefact ;
    skos:definition "A USO ontology vocabulary module — one of the 12 domain-specific OWL ontology files in the USO v2 modular ecosystem. Follows the USOVocabularyModuleConvention: uso-{module}-v{M}_{m}.ttl with hyphen separator and two-part versioning."@en ;
    skos:example "uso-discovery-v1_0.ttl is a USOVocabularyModule: one of the 12 domain-specific OWL 2 DL ontology files in the USO v2 ecosystem, following the hyphen-and-two-part pattern uso-{module}-v{M}_{m}.ttl (configuration:USODelimiterException)."@en .

configuration:VersionIRIPolicy a owl:Class ;
    rdfs:label "Version IRI Policy"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "W3C OWL 2 Structural Specification §3.5 owl:versionIRI."@en ;
    rdfs:comment "An organisation-level policy specifying how owl:versionIRI values are constructed for ontology releases. Common patterns: <ontology-iri>/<semver>, <ontology-iri>/<date>, <ontology-iri>/<commit>."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf configuration:ConfigurationManagementConcept,
        kb:VersioningPattern ;
    skos:definition "An organisation-level policy specifying how owl:versionIRI values are constructed for ontology releases. Common patterns: <ontology-iri>/<semver>, <ontology-iri>/<date>, <ontology-iri>/<commit>."@en .

configuration:VersionInFilenamePolicy a owl:Class ;
    rdfs:label "Version-in-Filename Policy"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD SafeguardDocConvention rdfs:comment: 'delimiter is DOT (v1.1) not underscore (v1_1). This is intentional: safeguard documents use two-part versioning (major.minor), TTL files use three-part (major.minor.patch).' a reliability ontology C8-V sprint gate. AMOD compliance sprint post-mortem BS-03, April 2026."@en ;
    rdfs:comment "A policy prescribing exactly how version information must be encoded in the filename of a specific subtype of EngineeringArtefact. Each artefact type has a distinct policy: OntologyFile and ShapeFile use underscore-delimited three-part versioning (_vM_m_p); SafeguardDocument uses dot-delimited two-part versioning (_vM.m); HtmlArtifact and CodeModule use underscore three-part. A VersionInFilenamePolicy violation is detected by the C8-V gate in the a reliability ontology sprint harness and by AMOD S6 SHACL for SafeguardDocument artefacts."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://semver.org/>,
        <https://www.iso.org/standard/54846.html> ;
    rdfs:subClassOf configuration:NamingConvention ;
    skos:definition "A policy prescribing exactly how version information must be encoded in the filename of a specific subtype of EngineeringArtefact. Each artefact type has a distinct policy: OntologyFile and ShapeFile use underscore-delimited three-part versioning (_vM_m_p); SafeguardDocument uses dot-delimited two-part versioning (_vM.m); HtmlArtifact and CodeModule use underscore three-part. A VersionInFilenamePolicy violation is detected by the C8-V gate in the a reliability ontology sprint harness and by AMOD S6 SHACL for SafeguardDocument artefacts."@en ;
    skos:example "VersionInFilenamePolicy governs that redo_v2_5_6.ttl must declare owl:versionInfo '2.5.6' — the filename token '2_5_6' must match the dot-delimited internal version string with underscores substituted for dots. C8-V enforces this as a two-condition gate: content match AND format match."@en .

configuration:appliesToArtifact a owl:ObjectProperty ;
    rdfs:label "appliesToArtifact"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    rdfs:domain configuration:ChangeOperation ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range core:Artifact ;
    skos:definition "Subject-link (registration) hook: the artifact this ChangeOperation applies to. A component registers its version/change-management activity against itself via this property. Range core:Artifact."@en .

configuration:appliesToArtifactType a owl:ObjectProperty ;
    rdfs:label "applies to artifact type"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Sprint F4 (2026-05-14): property declared from raw usage analysis (domain/range inferred per BP-D2 from existing ABox patterns). Per L-47v2: full skos:definition included."@en ;
    rdfs:domain configuration:NamingConvention ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    skos:definition "Links a NamingConvention (or VersionInFilenamePolicy) to the artifact-type class it applies to (e.g., ProjectClosureMarkdown, USOTestModule, HtmlArtifact). Captures convention-applicability without forcing a narrow range constraint. Per Sprint F4."@en .

configuration:archiveCompressionRatio a owl:DatatypeProperty ;
    rdfs:label "archive compression ratio"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD v1.6.0 data-attributes extension — Phase 2.4 AttributeRichness improvement."@en ;
    rdfs:domain configuration:ProjectArchive ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range xsd:decimal ;
    skos:definition "Compressed/uncompressed ratio."@en .

configuration:archiveSizeBytes a owl:DatatypeProperty ;
    rdfs:label "archive size in bytes"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD v1.6.0 data-attributes extension — Phase 2.4 AttributeRichness improvement."@en ;
    rdfs:domain configuration:ProjectArchive ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range xsd:long ;
    skos:definition "Size of a project archive in bytes."@en .

configuration:artifactAuthor a owl:DatatypeProperty ;
    rdfs:label "artifact author"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD v1.6.0 data-attributes extension — Phase 2.4 AttributeRichness improvement."@en ;
    rdfs:domain configuration:EngineeringArtefact ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range xsd:string ;
    skos:definition "Name of an artifact's author."@en .

configuration:artifactFilename a owl:DatatypeProperty ;
    rdfs:label "artifact filename"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD S6 shape (amod_shacl_v1_0_1.ttl): sh:sparql constraint uses configuration:artifactFilename to verify SafeguardDocConvention compliance. a reliability ontology C8-V gate: harness-level regex check of filename convention. Sprint post-mortem BS-02, April 2026."@en ;
    rdfs:domain configuration:EngineeringArtefact ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range xsd:string ;
    skos:definition "The declared filename (including extension) of an EngineeringArtefact as it appears on disk. Used by AMOD S6 to verify SafeguardDocument filenames conform to SafeguardDocConvention ({prefix}_safeguard_{variant}_v{M}.{m}.md), and by the C8-V gate in the a reliability ontology sprint harness to confirm version-token consistency. Value must be a plain filename with no path component — e.g., 'redo_safeguard_ontology_v1.2.md' not './outputs/redo_safeguard_ontology_v1.2.md'."@en .

configuration:artifactLastModified a owl:DatatypeProperty ;
    rdfs:label "artifact last modified timestamp"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD v1.6.0 data-attributes extension — Phase 2.4 AttributeRichness improvement."@en ;
    rdfs:domain configuration:EngineeringArtefact ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range xsd:dateTime ;
    skos:definition "When the artifact file was last edited."@en .

configuration:artifactWordCount a owl:DatatypeProperty ;
    rdfs:label "documentation word count"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD v1.6.0 data-attributes extension — Phase 2.4 AttributeRichness improvement."@en ;
    rdfs:domain configuration:DocumentationFile ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range xsd:integer ;
    skos:definition "Word count of a documentation file."@en .

configuration:checksumSHA256 a owl:DatatypeProperty ;
    rdfs:label "checksum SHA-256"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "NIST FIPS PUB 180-4: Secure Hash Standard (SHS)."@en ;
    rdfs:domain configuration:EngineeringArtefact ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range xsd:string ;
    skos:definition "The SHA-256 hex digest of the artefact file at sprint delivery, recorded in the SprintManifest for a reliability ontology C8Out gate verification."@en .

configuration:criterionPriority a owl:DatatypeProperty ;
    rdfs:label "acceptance criterion priority"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD v1.6.0 data-attributes extension — Phase 2.4 AttributeRichness improvement."@en ;
    rdfs:domain configuration:AcceptanceCriterion ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range xsd:string ;
    skos:definition "Priority level (must-have, should-have, nice-to-have)."@en .

configuration:criterionTestable a owl:DatatypeProperty ;
    rdfs:label "is criterion testable"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD v1.6.0 data-attributes extension — Phase 2.4 AttributeRichness improvement."@en ;
    rdfs:domain configuration:AcceptanceCriterion ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether a criterion is testable via automated checks."@en .

configuration:declaredInManifest a owl:ObjectProperty ;
    rdfs:label "declared in manifest"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Schwaber, K. & Sutherland, J. (2020). The Scrum Guide."@en ;
    rdfs:domain configuration:EngineeringArtefact ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range configuration:SprintManifest ;
    skos:definition "Relates an EngineeringArtefact to the SprintManifest in which it was declared as a deliverable."@en .

configuration:dependsOn a owl:ObjectProperty ;
    rdfs:label "depends on"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "ISO/IEC 15289:2019 Systems and software engineering — Content of life-cycle information items."@en ;
    rdfs:domain configuration:EngineeringArtefact ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range configuration:EngineeringArtefact ;
    skos:definition "Relates a dependent EngineeringArtefact to the EngineeringArtefact it imports, validates-against, or references."@en .

configuration:derivedFrom a owl:ObjectProperty ;
    rdfs:label "derived from"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    rdfs:domain configuration:DerivativeArchive ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range configuration:ProjectArchive ;
    skos:definition "Links a DerivativeArchive to the ProjectArchive it was derived from. The source archive's release SHA-256 SHOULD be cited in the DerivativeArchive's README under 'Derived from:'. Multiple sources allowed (a derivative may merge content from two sources, though rare)."@en .

configuration:estimatedHours a owl:DatatypeProperty ;
    rdfs:label "estimated hours"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD v1.5.0 alias of plan:estimatedHours."@en,
        "OE Pack v17.27.0 Challenge 2 — design-intent rdfs:domain extraction. Per skos:definition: \"Estimated effort in hours for any PlanArtefact (PlanProposal aggregate, Track, ProposedSprint, ProposedDeliverable).\" Design intent explicit; class exists same-NS."@en ;
    rdfs:domain configuration:PlanArtefact ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range xsd:decimal ;
    owl:equivalentProperty <http://example.org/oepack-expansion-plan#estimatedHours> ;
    skos:definition "Estimated effort in hours for any PlanArtefact (PlanProposal aggregate, Track, ProposedSprint, ProposedDeliverable)."@en .

configuration:fileExtension a owl:DatatypeProperty ;
    rdfs:label "file extension"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "ISO/IEC 15289:2019 Systems and software engineering — Content of life-cycle information items."@en ;
    rdfs:domain configuration:EngineeringArtefact ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range xsd:string ;
    skos:definition "The file extension of the artefact encoding its format (ttl, md, html, jsx, py)."@en .

configuration:filenamePattern a owl:DatatypeProperty ;
    rdfs:label "filename pattern"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "SWEBOK v4.0 (IEEE, 2024) — Software Configuration Management."@en ;
    rdfs:domain configuration:NamingConvention ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range xsd:string ;
    skos:definition "A string expressing the required filename structure for a NamingConvention using EBNF or regex notation with named tokens: {prefix}, {M}, {m}, {p}, {ext}."@en .

configuration:hasMitigation a owl:ObjectProperty ;
    rdfs:label "has mitigation"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD v1.5.0 alias of plan:hasMitigation."@en ;
    rdfs:domain configuration:RiskItem ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    owl:equivalentProperty <http://example.org/oepack-expansion-plan#hasMitigation> ;
    skos:definition "A RiskItem has zero or more MitigationStrategies."@en .

configuration:hasNamingConvention a owl:ObjectProperty ;
    rdfs:label "has naming convention"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "ISO/IEC 15289:2019 Systems and software engineering — Content of life-cycle information items."@en ;
    rdfs:domain configuration:EngineeringArtefact ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range configuration:NamingConvention ;
    skos:definition "Relates an EngineeringArtefact class to its required NamingConvention."@en .

configuration:hasRisk a owl:ObjectProperty ;
    rdfs:label "has risk"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD v1.5.0 alias of plan:hasRisk."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    owl:equivalentProperty <http://example.org/oepack-expansion-plan#hasRisk> ;
    skos:definition "A PlanProposal/Track/Sprint carries zero or more RiskItems."@en .

configuration:hasSBOM a owl:ObjectProperty ;
    rdfs:label "has SBOM"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD v1.3.0 supply-chain extension."@en ;
    rdfs:domain configuration:EngineeringArtefact ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range reliability:SBOM ;
    skos:definition "Links an EngineeringArtefact to its SBOM. Recommended for any artifact that imports or depends on third-party ontologies, code, or data."@en .

configuration:hasSLSALevel a owl:ObjectProperty ;
    rdfs:label "has SLSA build level"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "slsa.dev v1.0; AMOD v1.3.0 supply-chain extension."@en ;
    rdfs:domain configuration:EngineeringArtefact ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range reliability:SLSABuildLevel ;
    skos:definition "Links an EngineeringArtefact to the SLSA build level its build process satisfies. Cross-namespace anchor to the redo:SLSABuildLevel hierarchy."@en .

configuration:hasSemVer a owl:ObjectProperty ;
    rdfs:label "has SemVer"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD v1.3.0 SemVer alignment."@en ;
    rdfs:domain configuration:EngineeringArtefact ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range configuration:SemVerVersion ;
    skos:definition "Links an EngineeringArtefact to its formal SemVer version individual (instead of, or in addition to, a free-text configuration:tokenValue)."@en .

configuration:hasSignature a owl:ObjectProperty ;
    rdfs:label "has release signature"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD v1.3.0 supply-chain extension."@en ;
    rdfs:domain configuration:EngineeringArtefact ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range configuration:ReleaseSignature ;
    skos:definition "Links an EngineeringArtefact to its cryptographic release signature."@en .

configuration:hasSourceSHA256 a owl:DatatypeProperty ;
    rdfs:label "has source SHA-256"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    rdfs:domain configuration:ProjectArchive ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range xsd:string ;
    skos:definition "The lowercase-hexadecimal SHA-256 of the source release ZIP. Cited on the configuration:ProjectArchive individual that an configuration:DerivativeArchive's configuration:derivedFrom triple points to. Used by release_check Gate G (v1.3.0+) to verify that the named source bundle's actual SHA matches the declared value."@en ;
    skos:example "\"3cc81f436cfc136fe7f559473b90d846824b294e395b45878ea192393fded693\""@en .

configuration:hasTrack a owl:ObjectProperty ;
    rdfs:label "has track"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD v1.5.0 alias of plan:hasTrack."@en ;
    rdfs:domain configuration:PlanProposal ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range configuration:Track ;
    owl:equivalentProperty <http://example.org/oepack-expansion-plan#hasTrack> ;
    skos:definition "Aggregation: a PlanProposal has one or more Tracks."@en .

configuration:hasVersionToken a owl:ObjectProperty ;
    rdfs:label "has version token"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Semantic Versioning 2.0.0 (semver.org)."@en ;
    rdfs:domain configuration:EngineeringArtefact ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range configuration:VersionToken ;
    skos:definition "Relates an EngineeringArtefact to the VersionToken embedded in its filename."@en .

configuration:includesConvention a owl:ObjectProperty ;
    rdfs:label "includes convention"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Sprint F4 (2026-05-14): property declared from raw usage analysis (domain/range inferred per BP-D2 from existing ABox patterns). Per L-47v2: full skos:definition included."@en ;
    rdfs:domain configuration:ArtifactNamingSchema ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range configuration:NamingConvention ;
    skos:definition "Links an ArtifactNamingSchema to its constituent NamingConvention rules. Per Sprint F4: 9 usages."@en .

configuration:includesSprint a owl:ObjectProperty ;
    rdfs:label "includes sprint"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD v1.5.0 alias of plan:includesSprint."@en ;
    rdfs:domain configuration:Track ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range configuration:ProposedSprint ;
    owl:equivalentProperty <http://example.org/oepack-expansion-plan#includesSprint> ;
    skos:definition "A Track includes one or more ProposedSprints."@en .

configuration:integratesInto a owl:ObjectProperty ;
    rdfs:label "integrates into"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    rdfs:domain configuration:StagingArchive ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range configuration:ProjectArchive ;
    skos:definition "Links a StagingArchive to the ProjectArchive (typically a future ecosystem release) it is intended to be integrated into. The target may not yet exist on disk; this is a forward-looking declaration. Once the target ships and absorbs the staging contents, the staging archive is SUPERSEDED."@en .

configuration:matchesOntologyVersion a owl:ObjectProperty ;
    rdfs:label "matches ontology version"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "W3C OWL 2 — owl:versionInfo."@en ;
    rdfs:domain configuration:VersionToken ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range core:Version ;
    skos:definition "Asserts that this VersionToken corresponds to the owl:versionInfo declared inside the file. Formal expression of the VersionInFilenamePolicy coupling."@en .

configuration:releaseNotes a owl:DatatypeProperty ;
    rdfs:label "release notes summary"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD v1.6.0 data-attributes extension — Phase 2.4 AttributeRichness improvement."@en ;
    rdfs:domain configuration:ReleaseSignature ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range xsd:string ;
    skos:definition "Brief summary of changes in a release."@en .

configuration:riskMitigation a owl:DatatypeProperty ;
    rdfs:label "risk mitigation summary"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD v1.6.0 data-attributes extension — Phase 2.4 AttributeRichness improvement."@en ;
    rdfs:domain configuration:RiskItem ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range xsd:string ;
    skos:definition "Brief description of how a risk is being mitigated."@en .

configuration:riskProbability a owl:DatatypeProperty ;
    rdfs:label "risk probability"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD v1.6.0 data-attributes extension — Phase 2.4 AttributeRichness improvement."@en ;
    rdfs:domain configuration:RiskItem ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range xsd:decimal ;
    skos:definition "Probability [0,1] of a risk occurring."@en .

configuration:satisfiesAcceptanceCriterion a owl:ObjectProperty ;
    rdfs:label "satisfiesAcceptanceCriterion"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    rdfs:domain configuration:ChangeOperation ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range configuration:AcceptanceCriterion ;
    skos:definition "Links a ChangeOperation to an AcceptanceCriterion it satisfies; the completeness signal for the configuration conformance gate (a change at high criticality must be validated against acceptance criteria)."@en .

configuration:semVerBuildMetadata a owl:DatatypeProperty ;
    rdfs:label "SemVer build metadata"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "semver.org §10."@en ;
    rdfs:domain configuration:SemVerVersion ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range xsd:string ;
    skos:definition "SemVer build metadata — string suffix after '+' (e.g., '20130313144700', 'sha.5114f85'). Ignored for version-precedence purposes."@en .

configuration:semVerPreRelease a owl:DatatypeProperty ;
    rdfs:label "SemVer pre-release identifier"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "semver.org §9."@en ;
    rdfs:domain configuration:SemVerVersion ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range xsd:string ;
    skos:definition "SemVer pre-release identifier — string suffix after '-' (e.g., 'alpha.1', 'rc.2'). Versions with pre-release < same version without pre-release per §11."@en .

configuration:sprintCapacityPoints a owl:DatatypeProperty ;
    rdfs:label "sprint capacity in story points"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD v1.6.0 data-attributes extension — Phase 2.4 AttributeRichness improvement."@en ;
    rdfs:domain configuration:SprintManifest ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range xsd:integer ;
    skos:definition "Total story points capacity for a sprint."@en .

configuration:sprintGoal a owl:DatatypeProperty ;
    rdfs:label "sprint goal statement"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD v1.6.0 data-attributes extension — Phase 2.4 AttributeRichness improvement."@en ;
    rdfs:domain configuration:SprintManifest ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range xsd:string ;
    skos:definition "Single-sentence summary of a sprint's goal."@en .

configuration:targetRelease a owl:DatatypeProperty ;
    rdfs:label "target release"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    rdfs:domain configuration:StagingArchive ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range xsd:string ;
    skos:definition "A string identifier for the target release (e.g., 'family-v17.1.2' or 'family-v17.2.0'). Use when configuration:integratesInto cannot point to an actual ProjectArchive IRI because the target hasn't been authored yet."@en .

configuration:versionToken a owl:DatatypeProperty ;
    rdfs:label "version token"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "OE Pack v17.26.0 Option N — Inferred from configuration:HtmlArtifact instances using versionToken in ABox"@en,
        "Sprint F4 (2026-05-14): property declared from raw usage analysis (domain/range inferred per BP-D2 from existing ABox patterns). Per L-47v2: full skos:definition included."@en ;
    rdfs:domain configuration:HtmlArtifact ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range xsd:string ;
    skos:definition "String form of a version identifier embedded in a filename or artifact identifier (e.g., \"v54_0_0\", \"v17_1_1\"). Per Sprint F4."@en .

core:AgentClassification a owl:Class ;
    rdfs:label "Agent Classification"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 42010:2011. Systems and software engineering — Architecture description. Section 4: stakeholders and concerns."@en ;
    rdfs:comment "Use as the shared superclass for Role and Stakeholder. Do not instantiate directly — use the appropriate subclass based on whether you are classifying by functional capacity (Role) or by interest relationship (Stakeholder)."@en ;
    rdfs:isDefinedBy <http://example.org/core> ;
    rdfs:seeAlso <https://www.w3.org/TR/prov-o/> ;
    skos:definition "A classification scheme for categorizing agents participating in or affected by reliability engineering activities. Distinguished into orthogonal axes: Role (functional capacity) and Stakeholder (interest relationship). An agent may simultaneously hold a Role and be a Stakeholder."@en ;
    skos:example "Example: Classifying agents as HumanAgent vs AutomatedAgent for role assignment."@en .

core:OperationalizableCompetencyQuestion a owl:Class ;
    rdfs:label "Operationalizable Competency Question"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    dcterms:source "OE Pack v17.30.0 industrial-hardening item #8 — subdivide CompetencyQuestion to honestly classify which questions require SPARQL operationalization vs. those that are inherently descriptive (design rationale, procedural, session-context)."@en ;
    rdfs:subClassOf core:CompetencyQuestion ;
    owl:disjointWith core:DescriptiveCompetencyQuestion ;
    skos:definition "A competency question whose answer can be computed mechanically via SPARQL over the ontology graph (TBox + ABox) or over the SHACL shape graph. Every OperationalizableCompetencyQuestion MUST carry a quality:hasSPARQLImplementation literal containing the SPARQL query that answers it. Enforced by SHACL shape core:OperationalizableCQShape."@en .

core:assessedBy a owl:ObjectProperty ;
    rdfs:label "assessed by"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    dcterms:source "ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:isDefinedBy <http://example.org/core> ;
    skos:definition "Relates an engineering artifact or characteristic to a metric or agent that evaluates it."@en .

core:derivedFrom a owl:ObjectProperty ;
    rdfs:label "derived from"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    dcterms:source "W3C PROV-O: The PROV Ontology — prov:wasDerivedFrom."@en ;
    rdfs:isDefinedBy <http://example.org/core> ;
    skos:definition "Traces the provenance of an artifact or concept to the source artifact or concept from which it was created, adapted, or specialized."@en .

core:governedBy a owl:ObjectProperty ;
    rdfs:label "governed by"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    dcterms:source "ISO 38500:2015 Information technology — Governance of IT for the organization."@en ;
    rdfs:isDefinedBy <http://example.org/core> ;
    skos:definition "Relates an engineering entity to the governance model, regulatory framework, or organizational policy that constrains its creation, modification, or use."@en .

core:hasCriticalityProfile a owl:ObjectProperty ;
    rdfs:label "has criticality profile"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    rdfs:domain core:Artifact ;
    rdfs:isDefinedBy <http://example.org/core> ;
    rdfs:range core:CriticalityProfile ;
    skos:definition "Declares the CriticalityProfile (case) of a component artifact; facet conformance gates read this to select the required process-completeness level."@en .

core:hasRole a owl:ObjectProperty ;
    rdfs:label "has role"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    dcterms:source "ISO/IEC 12207:2017 Systems and software engineering — Software life cycle processes §6.2 — Role definition."@en ;
    rdfs:domain core:Agent ;
    rdfs:isDefinedBy <http://example.org/core> ;
    rdfs:range core:Role ;
    skos:definition "Relates an agent or activity to the role performed within it."@en .

core:hasSeverity a owl:ObjectProperty ;
    rdfs:label "has severity"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software Quality Models — §4.2 Severity classification."@en ;
    rdfs:comment "Domain is owl:Thing by design — severity is universally applicable across the engineering ontology stack (findings, defects, failures, drifts, etc.). Downstream ontologies tighten via rdfs:subPropertyOf."@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy <http://example.org/core> ;
    rdfs:range core:SeverityLevel ;
    skos:definition "Relates a finding, defect, or failure to its severity classification."@en .

core:precedes a owl:ObjectProperty ;
    rdfs:label "precedes"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    dcterms:source "OWL-Time ontology (W3C); Allen's interval algebra for temporal relations."@en ;
    rdfs:isDefinedBy <http://example.org/core> ;
    skos:definition "Establishes a temporal or sequential ordering between two entities, indicating that the subject comes before the object in a defined sequence."@en .

core:validates a owl:ObjectProperty ;
    rdfs:label "validates"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    dcterms:source "ISO/IEC/IEEE 29119-1:2022 Software and systems engineering — Software testing."@en ;
    rdfs:isDefinedBy <http://example.org/core> ;
    skos:definition "Relates a test, verification method, or assessment to the artifact whose correctness, completeness, or conformance it confirms."@en .

measurement:AccuracyMetric a owl:Class ;
    rdfs:label "Accuracy Metric"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F5 (2026-05-15)."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:CompletenessMetric ;
    skos:definition "Metric measuring classification accuracy. Per Sprint F5."@en .

measurement:CodeCoverage a owl:Class ;
    rdfs:label "Code Coverage"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Migrated to OEM in v1.2.0 (step 10b, 2026-05-13) from legacy meta_v6_5_1.ttl as part of correcting step 10's misclassification: this is a metric (measurement), not a performance characteristic. Re-rooted as subclass of oem:CoverageMetric."@en,
        "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Coverage metric specifically for ontology structure."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf measurement:CoverageMetric ;
    skos:definition "A test coverage metric that measures the proportion of ontology elements such as classes, properties, and axioms that are directly referenced or exercised by at least one test case in the suite."@en ;
    skos:example "Measuring that the C5 EmpiricalTest harness exercises all five ontology files (AMOD, CORE, META, OQC, a reliability ontology) with at least one mutation each, achieving 100% file coverage, is CodeCoverage for the test suite."@en .

measurement:CompetencyQuestionPassRate a owl:Class ;
    rdfs:label "Competency Question Pass Rate"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Duque-Ramos A. et al. (2014) Evaluating GoodOD with OQuaRE. PLoS ONE 9:e104463 — competency-question-based evaluation comparison. OE Pack v19.3.0 Phase F4."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:seeAlso qc:CompetencyQuestion ;
    rdfs:subClassOf measurement:Metric ;
    skos:definition "A Metric measuring the proportion of an ontology's competency questions (quality:CompetencyQuestion individuals) that can be successfully answered via SPARQL execution against the ontology. Computed as: (count of CQs whose SPARQL query returns the expected result) / (total CQs defined). Value range [0,1] where 1.0 indicates all competency questions pass. Operationalises the functional-adequacy assessment dimension by quantifying how completely an ontology fulfills its design requirements. Source-anchored in Boeker et al. competency-question-based evaluation method and OQuaRE FunctionalAdequacy characteristic."@en .

measurement:ConsistencyMetric a owl:Class ;
    rdfs:label "Consistency Metric"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F5 (2026-05-15)."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:CompletenessMetric ;
    skos:definition "Metric measuring consistency of an ontology. Per Sprint F5."@en .

measurement:CouplingMetric a owl:Class ;
    rdfs:label "Coupling Metric"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F5 (2026-05-15)."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:CohesionMetric ;
    skos:definition "Metric measuring inter-class coupling. Per Sprint F5."@en .

measurement:CoverageMeasureSuite a owl:Class ;
    rdfs:label "Coverage Measure Suite"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Tartir S. et al. (2005). OntoQA: Metric-Based Ontology Quality Analysis.; OE Pack v19.0.4 Phase F1 (Proposal F). Resolves the v19.0.3 finding that 6 Coverage classes existed across subjects with no aggregation point."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:seeAlso qc:Coverage ;
    rdfs:subClassOf measurement:MeasurementConcept ;
    skos:definition "An aggregation class collecting all coverage-quantifying measurements for an ontology: CodeCoverage (test-driven element coverage), TestCoverage (test-case coverage), requirement coverage, term-mapping coverage, population coverage. A CoverageMeasureSuite instance represents a single assessment run that captures the full coverage profile of a target ontology. Operationalises the quality:Coverage dimension by combining the existing distributed coverage classes into a coherent assessment unit."@en .

measurement:DescriptiveMetric a owl:Class ;
    rdfs:label "Descriptive Metric"@en ;
    measurement:hasMeasurementSubject measurement:OntologyMeasurementSubject ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F3 (2026-05-14): umbrella class implicit via subClassOf claims but never declared. Per BP-D2 + L-47v2: declared with full skos:definition to satisfy target class constraints."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:Measurement ;
    skos:definition "Umbrella class for metrics that describe properties of ontology components without prescriptive thresholds — informational rather than evaluative. Per Sprint F3: implicit umbrella now declared from 6 children claiming subClassOf."@en .

measurement:DocumentMeasurementSubject a owl:Class ;
    rdfs:label "Document Measurement Subject"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:MeasurementSubject ;
    skos:definition "A written, natural-language deliverable (report, paper, specification, manual) as a measurement subject."@en .

measurement:F1ScoreMetric a owl:Class ;
    rdfs:label "F1 Score Metric"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F5 (2026-05-15)."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:CompletenessMetric ;
    skos:definition "Metric measuring F1 score (harmonic mean of precision and recall). Per Sprint F5."@en .

measurement:Formula a owl:Class ;
    rdfs:label "Formula"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Authored in OEM v1.1.0 as canonical foundational measurement vocabulary. Analogous OQC class (quality:Formula) currently co-exists; step 8 will collapse to this canonical home."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:Measurement ;
    skos:definition "The computational expression of a Metric — the formula that transforms raw observations into a Score."@en .

measurement:GeometricMeanRule a owl:Class ;
    rdfs:label "Geometric Mean Rule"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F5 (2026-05-15)."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:AggregationRule ;
    skos:definition "An aggregation rule computing the geometric mean of input values. Per Sprint F5."@en .

measurement:Measure a owl:Class ;
    rdfs:label "Measure"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Authored in OEM v1.1.0 as canonical foundational measurement vocabulary. Analogous OQC class (quality:Measure) currently co-exists; step 8 will collapse to this canonical home."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:Measurement ;
    skos:definition "A concrete measurement-act instance: applying a Metric to an artifact and producing a Score. Distinguished from Metric (the procedure) and Score (the result)."@en .

measurement:MemoryUsage a owl:Class ;
    rdfs:label "Memory Usage"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "ISO/IEC 25010:2011 Systems and Software Quality Models."@en,
        "Migrated to OEM in v1.2.0 (step 10b, 2026-05-13) from legacy meta_v6_5_1.ttl as part of correcting step 10's misclassification: this is a metric (measurement), not a performance characteristic. Re-rooted as subclass of oem:Metric."@en ;
    rdfs:comment "Memory consumed by ontology loading and reasoning."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2014.6816804>,
        <https://www.iso.org/standard/35734.html> ;
    rdfs:subClassOf measurement:Metric ;
    skos:definition "A performance metric that measures the amount of system memory consumed by the ontology when loaded into a triple store or reasoner, indicating the resource requirements for deployment and operation."@en ;
    skos:example "Profiling that loading all five framework ontologies simultaneously into an rdflib ConjunctiveGraph uses 1.2 GB peak RSS — within the 2 GB container memory limit — is a MemoryUsage measurement for the OE stack."@en .

measurement:ModularityMetric a owl:Class ;
    rdfs:label "Modularity Metric"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F5 (2026-05-15)."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:SizeMetric ;
    skos:definition "Metric measuring ontology modularity — how cleanly an ontology decomposes into modules. Per Sprint F5."@en .

measurement:OntologyAsSubject a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Ontology As Subject"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:AlgorithmicStructureMeasurementSubject ;
    skos:definition "Ontologies under reasoning, query execution, and loading. Inference time, query latency, classification cost are functions of the ontology's algorithmic structure (axiom count, expressivity, ABox size). Captures the user insight that ontologies are algorithmic per the user observation."@en .

measurement:PerformanceMetric a owl:Class ;
    rdfs:label "Performance Metric"@en ;
    measurement:hasMeasurementSubject measurement:OperationalEnvironmentMeasurementSubject ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F5 (2026-05-15)."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:Measurement ;
    skos:definition "Metric measuring runtime performance — query latency, reasoning time. Per Sprint F5."@en .

measurement:PrecisionMetric a owl:Class ;
    rdfs:label "Precision Metric"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F5 (2026-05-15)."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:CompletenessMetric ;
    skos:definition "Metric measuring precision (true positives / predicted positives). Per Sprint F5."@en .

measurement:ProgrammingLanguageMeasurementSubject a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Programming Language Measurement Subject"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:MeasurementSubject ;
    skos:definition "Subject category for measurements taken on programming languages, language features, or language implementations. Reserved for future use; no current metric subclasses populate this category as of v2.4.0."@en .

measurement:QueryAsSubject a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Query As Subject"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:AlgorithmicStructureMeasurementSubject ;
    skos:definition "Queries (SPARQL, SQL, etc.) whose execution time is a function of query structure and data scale. Distinct from program measurement: the query is declarative; cost depends on query planner choices."@en .

measurement:QueryResponseTime a owl:Class ;
    rdfs:label "Query Response Time"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "ISO/IEC 25010:2011 Systems and Software Quality Models."@en,
        "Migrated to OEM in v1.2.0 (step 10b, 2026-05-13) from legacy meta_v6_5_1.ttl as part of correcting step 10's misclassification: this is a metric (measurement), not a performance characteristic. Re-rooted as subclass of oem:Metric."@en ;
    rdfs:comment "Time required to execute SPARQL queries."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:seeAlso <https://www.iso.org/standard/35734.html>,
        <https://www.w3.org/TR/sparql11-query/> ;
    rdfs:subClassOf measurement:Metric ;
    skos:definition "A performance metric that measures the elapsed time between submitting a SPARQL query to the ontology endpoint and receiving the complete result set, indicating the system's interactive responsiveness."@en ;
    skos:example "Measuring that a SPARQL SELECT returning all 339 a reliability ontology class labels completes in under 150ms on Apache Jena Fuseki with the redo_v2_5_6.ttl dataset is a QueryResponseTime benchmark."@en .

measurement:ReasoningTime a owl:Class ;
    rdfs:label "Reasoning Time"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "ISO/IEC 25010:2011 Systems and Software Quality Models."@en,
        "Migrated to OEM in v1.2.0 (step 10b, 2026-05-13) from legacy meta_v6_5_1.ttl as part of correcting step 10's misclassification: this is a metric (measurement), not a performance characteristic. Re-rooted as subclass of oem:Metric."@en ;
    rdfs:comment "Time required for reasoning operations."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:seeAlso <https://www.iso.org/standard/35734.html>,
        <https://www.w3.org/TR/owl2-primer/> ;
    rdfs:subClassOf measurement:Metric ;
    skos:definition "A performance metric measuring the wall-clock time required for a reasoner to complete a specific task such as classification, consistency checking, or query answering over the loaded ontology."@en ;
    skos:example "HermiT 1.5 completing full classification of meta_v6_2_2.ttl (600 classes, 62 object properties) in 4.3 seconds is a ReasoningTime measurement, confirming the ontology is tractable for interactive use."@en .

measurement:RecallMetric a owl:Class ;
    rdfs:label "Recall Metric"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F5 (2026-05-15)."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:CompletenessMetric ;
    skos:definition "Metric measuring recall (true positives / actual positives). Per Sprint F5."@en .

measurement:RoleAwareThresholdRow a owl:Class ;
    rdfs:label "Role-aware ThresholdRow"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "OE Pack v17.25.0 Option P — declared to relax OQC TR-V2 SHACL shape targetClass for role-agnostic bands."@en ;
    rdfs:subClassOf measurement:ThresholdRow ;
    skos:definition "A ThresholdRow that is keyed on an explicit ontology role (foundation, meta, domain, application). All 247 OQuaRE structural-metric ThresholdRows are of this subtype. The SyntaxQuality and PerformanceEfficiency ThresholdRow subclasses are role-agnostic because their metric inputs (V/W counts; ms/triple combined) are already role-independent per BP-D2 baseline distribution analysis."@en .

measurement:Threshold a owl:Class ;
    rdfs:label "Threshold"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Authored in OEM v1.1.0 as canonical foundational measurement vocabulary. Analogous OQC class (quality:Threshold) currently co-exists; step 8 will collapse to this canonical home."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:Measurement ;
    skos:definition "An interpretive bound for a Score, dividing the result space into ranges (e.g., excellent / good / acceptable / poor). A QualityGate or assessment policy may have a threshold."@en .

measurement:WorkflowAsSubject a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Workflow As Subject"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:AlgorithmicStructureMeasurementSubject ;
    skos:definition "Workflows, processes, and protocols whose throughput, latency, or completion time scales with input. Includes a reliability ontology protocols and ontology-engineering processes (DevelopmentProcess, VerificationProcess)."@en .

measurement:appliesToRole a owl:DatatypeProperty ;
    rdfs:label "applies to role"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F2 broad consolidation 2026-05-14. Consolidated from quality: namespace where the property was previously declared (or used undeclared, in the case of appliesToMetric and hasThresholdRow)."@en ;
    rdfs:domain measurement:ThresholdRow ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:range xsd:string ;
    skos:definition "The ontology role this row applies to (foundation, domain, application, meta). Per OQC v2.3.0 role-aware threshold extension: the same metric value can map to different band scores depending on which role the ontology serves."@en .

measurement:bindsArtifact a owl:ObjectProperty ;
    rdfs:label "binds artifact"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "OEM Bridge v1.0.0."@en ;
    rdfs:domain measurement:MeasurementBinding ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:range core:Artifact ;
    skos:definition "The qc:OntologyArtifact that this Binding measured."@en .

measurement:bindsMetric a owl:ObjectProperty ;
    rdfs:label "binds metric"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "OEM Bridge v1.0.0."@en ;
    rdfs:domain measurement:MeasurementBinding ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:range measurement:Metric ;
    skos:definition "The qc:Metric that this Binding evaluated."@en .

measurement:combinedMsPerTripleMax a owl:DatatypeProperty ;
    rdfs:label "combinedMsPerTripleMax"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "OE Pack v17.25.0 Option P"@en,
        "OE Pack v17.26.0 Option N — Per L-47 self-application: BP-D23 inference from P-codified PerformanceEfficiencyThresholdRow instances"@en ;
    rdfs:domain measurement:PerformanceEfficiencyThresholdRow ;
    rdfs:range xsd:decimal ;
    skos:definition "Maximum (HermiT + SHACL) milliseconds per triple, exclusive"@en .

measurement:combinedMsPerTripleMin a owl:DatatypeProperty ;
    rdfs:label "combinedMsPerTripleMin"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "OE Pack v17.25.0 Option P"@en,
        "OE Pack v17.26.0 Option N — Per L-47 self-application: BP-D23 inference from P-codified PerformanceEfficiencyThresholdRow instances"@en ;
    rdfs:domain measurement:PerformanceEfficiencyThresholdRow ;
    rdfs:range xsd:decimal ;
    skos:definition "Minimum (HermiT + SHACL) milliseconds per triple, inclusive"@en .

measurement:derivedFromMetric a owl:ObjectProperty ;
    rdfs:label "derived from metric"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Authored in OEM v1.1.0 as canonical version. Analogous OQC property (quality:derivedFromMetric) currently co-exists; step 8 collapses."@en ;
    rdfs:domain measurement:Score ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:range measurement:Metric ;
    skos:definition "Links a Score back to the Metric procedure that produced it."@en .

measurement:hasConfidenceTier a owl:ObjectProperty ;
    rdfs:label "has confidence tier"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "OE Pack v19.6.0 Phase J1 of Proposal J v1.0.0 (Test-Driven Maximum-Score Plan). Establishes confidence-tier disclosure infrastructure required by subsequent phases that introduce statistical-proxy (TIER-B) and LLM-mediated (TIER-C) assessment items."@en ;
    rdfs:domain measurement:Score ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:range measurement:ConfidenceTier ;
    skos:definition "Links a measurement:Score to its methodological tier (Tier_A, Tier_B, Tier_C or Tier_D). Exactly one is required on every Score individual per BP-D47; the pack's SHACL shape of measurement:Score enforces it."@en .

measurement:hasEngineName a owl:DatatypeProperty ;
    rdfs:label "has engine name"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "OEM Bridge v1.0.0."@en ;
    rdfs:domain measurement:MeasurementContext ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:range xsd:string ;
    skos:definition "Name of the measurement engine (e.g., 'oee_measure.py', 'OQuaRE-Tool', 'OntoMetrics-Core')."@en .

measurement:hasEngineVersion a owl:DatatypeProperty ;
    rdfs:label "has engine version"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "OEM Bridge v1.0.0."@en ;
    rdfs:domain measurement:MeasurementContext ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:range xsd:string ;
    skos:definition "SemVer version string of the measurement engine."@en .

measurement:hasFrameworkVariant a owl:ObjectProperty ;
    rdfs:label "has framework variant"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "OEM Bridge v1.0.0."@en ;
    rdfs:domain measurement:MeasurementContext ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:range qc:Framework ;
    skos:definition "Which OQC framework (OQuaREFramework, OntoQAFramework, OntoMetricsFramework) was used."@en .

measurement:hasMeasurementContext a owl:ObjectProperty ;
    rdfs:label "has measurement context"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "OEM Bridge v1.0.0."@en ;
    rdfs:domain measurement:MeasurementRun ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:range measurement:MeasurementContext ;
    skos:definition "Links a MeasurementRun to its execution context (engine version, parameters, environment)."@en .

measurement:hasMeasurementRun a owl:ObjectProperty ;
    rdfs:label "has measurement run"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "OEM Bridge v1.0.0."@en ;
    rdfs:domain qc:OntologyArtifact ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:range measurement:MeasurementRun ;
    owl:inverseOf measurement:hasInputArtifact ;
    skos:definition "Inverse-direction shortcut: links an OntologyArtifact to the MeasurementRuns that have measured it."@en .

measurement:hasMeasurementSubject a owl:NamedIndividual,
        owl:ObjectProperty ;
    rdfs:label "has measurement subject"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:range measurement:MeasurementSubject ;
    skos:definition "Links a Measurement subclass (or other metric/quality concept) to the MeasurementSubject category that classifies what kind of system the measurement is taken on. Used at the CLASS level (punning permitted) to annotate umbrella metric classes with their subject-of-measurement scope, enabling clean filtering of \"which metrics apply to ontologies\" vs \"which apply to LLM outputs\" without textual analysis of class names."@en .

measurement:hasMetric a owl:ObjectProperty ;
    rdfs:label "has metric"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Authored in OEM v1.1.0 as canonical version."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    skos:definition "Generic relation linking a subject (assessment, characteristic, test) to the metric used to evaluate it. Subject ontologies may declare more specific subproperties (e.g., performance:measuresPerformance)."@en .

measurement:hasNormalizedValue a owl:DatatypeProperty ;
    rdfs:label "has normalized value"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "OEM Bridge v1.0.0."@en ;
    rdfs:domain measurement:MeasurementBinding ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:range xsd:decimal ;
    skos:definition "The threshold-normalised value (0..1 or 0..5) of the binding, produced by applying the metric's threshold table to the raw value."@en .

measurement:hasPassRate a owl:DatatypeProperty ;
    rdfs:label "has pass rate"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "OE Pack v19.3.0 Phase F4. Domain-range alignment with measurement:CompetencyQuestionEvaluation."@en ;
    rdfs:domain measurement:CompetencyQuestionEvaluation ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:range xsd:decimal ;
    skos:definition "Links a CompetencyQuestionEvaluation to its computed pass-rate value, expressed as xsd:decimal in the range [0.0, 1.0]. 0.0 = no CQs pass; 1.0 = all CQs pass. Computed by the evaluation tooling per CompetencyQuestionPassRate metric definition."@en .

measurement:hasRawValue a owl:DatatypeProperty ;
    rdfs:label "has raw value"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "OEM Bridge v1.0.0; closes WS-3 schema-relaxation gap noted in oee_methodology_audit_v1_0_0.md."@en ;
    rdfs:domain measurement:MeasurementBinding ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:range xsd:decimal ;
    skos:definition "The raw numerical value produced by evaluating the SPARQL formula on the artifact, before threshold normalisation."@en .

measurement:hasScore a owl:ObjectProperty ;
    rdfs:label "has score"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "OEM Bridge v1.0.0."@en ;
    rdfs:domain measurement:MeasurementBinding ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:range measurement:Score ;
    skos:definition "The qc:Score produced by this Binding."@en .

measurement:hasThresholdRow a owl:ObjectProperty ;
    rdfs:label "has threshold row"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F2 broad consolidation 2026-05-14. Consolidated from quality: namespace where the property was previously declared (or used undeclared, in the case of appliesToMetric and hasThresholdRow)."@en ;
    rdfs:domain measurement:ThresholdTable ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:range measurement:ThresholdRow ;
    skos:definition "Links a ThresholdTable to its constituent ThresholdRow individuals. The complete set of hasThresholdRow values for a table constitutes the table's coverage of the (metric × role × range) space."@en .

measurement:inMetricCategory a owl:ObjectProperty ;
    rdfs:label "in metric category"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    rdfs:domain measurement:Metric ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:range measurement:MetricCategory ;
    skos:definition "Registers a Metric under its governing MetricCategory (the single cross-domain axis for duplication detection)."@en .

measurement:lowerBound a owl:DatatypeProperty ;
    rdfs:label "lower bound"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F2 broad consolidation 2026-05-14. Consolidated from quality: namespace where the property was previously declared (or used undeclared, in the case of appliesToMetric and hasThresholdRow)."@en ;
    rdfs:domain measurement:ThresholdRow ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:range xsd:decimal ;
    skos:definition "The inclusive lower bound of this row's value range. A measured value v falls in this row iff lowerBound <= v < upperBound (half-open interval)."@en .

measurement:measures a owl:ObjectProperty ;
    rdfs:label "measures"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F4 (2026-05-14): property declared from raw usage analysis (domain/range inferred per BP-D2 from existing ABox patterns). Per L-47v2: full skos:definition included."@en ;
    rdfs:domain measurement:Measurement ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:range qc:QualityDimension ;
    skos:definition "Links a measurement to the QualityDimension it measures. Sibling of reliability:measures (distinct namespace; this is the canonical measurement: form). Per Sprint F4: 8 usages on ConsistencyScore, ZombieClaimRate, MTBF, and other measurement individuals."@en .

measurement:produceBinding a owl:ObjectProperty ;
    rdfs:label "produces binding"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "OEM Bridge v1.0.0."@en ;
    rdfs:domain measurement:MeasurementRun ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:range measurement:MeasurementBinding ;
    skos:definition "Links a MeasurementRun to the per-metric, per-artifact result bindings it produced."@en .

measurement:upperBound a owl:DatatypeProperty ;
    rdfs:label "upper bound"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F2 broad consolidation 2026-05-14. Consolidated from quality: namespace where the property was previously declared (or used undeclared, in the case of appliesToMetric and hasThresholdRow)."@en ;
    rdfs:domain measurement:ThresholdRow ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:range xsd:decimal ;
    skos:definition "The exclusive upper bound of this row's value range. See lowerBound."@en .

measurement:vMax a owl:DatatypeProperty ;
    rdfs:label "vMax"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "OE Pack v17.25.0 Option P"@en,
        "OE Pack v17.26.0 Option N — Per L-47 self-application: BP-D23 inference from P-codified SyntaxQualityThresholdRow instances"@en ;
    rdfs:domain measurement:SyntaxQualityThresholdRow ;
    rdfs:range xsd:decimal ;
    skos:definition "Maximum V (sh:Violation) count for this band, inclusive"@en .

measurement:vMin a owl:DatatypeProperty ;
    rdfs:label "vMin"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "OE Pack v17.25.0 Option P"@en,
        "OE Pack v17.26.0 Option N — Per L-47 self-application: BP-D23 inference from P-codified SyntaxQualityThresholdRow instances"@en ;
    rdfs:domain measurement:SyntaxQualityThresholdRow ;
    rdfs:range xsd:integer ;
    skos:definition "Minimum V (sh:Violation) count for this band, inclusive"@en .

measurement:wMax a owl:DatatypeProperty ;
    rdfs:label "wMax"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "OE Pack v17.25.0 Option P"@en,
        "OE Pack v17.26.0 Option N — Per L-47 self-application: BP-D23 inference from P-codified SyntaxQualityThresholdRow instances"@en ;
    rdfs:domain measurement:SyntaxQualityThresholdRow ;
    rdfs:range xsd:decimal ;
    skos:definition "Maximum W (sh:Warning) count for this band, inclusive"@en .

measurement:wMin a owl:DatatypeProperty ;
    rdfs:label "wMin"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "OE Pack v17.25.0 Option P"@en,
        "OE Pack v17.26.0 Option N — Per L-47 self-application: BP-D23 inference from P-codified SyntaxQualityThresholdRow instances"@en ;
    rdfs:domain measurement:SyntaxQualityThresholdRow ;
    rdfs:range xsd:integer ;
    skos:definition "Minimum W (sh:Warning) count for this band, inclusive"@en .

measurement:weightQCore a owl:DatatypeProperty ;
    rdfs:label "weight q core"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F4 (2026-05-14): property declared from raw usage analysis (domain/range inferred per BP-D2 from existing ABox patterns). Per L-47v2: full skos:definition included."@en ;
    rdfs:domain measurement:AggregationRule ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:range xsd:decimal ;
    skos:definition "Weight assigned to QCore composite when computing weighted aggregate scores. Used on WeightedSumRule and OQuaRETierWeightedRule individuals. Per Sprint F4: relocated from oqc-aggregation-rules: namespace (which has no formal TBox) to measurement: where AggregationRule was declared in Sprint F3. NOTE: existing usage uses oqc-aggregation-rules: IRI; this declaration declares the canonical form; F4 also rewrites usages to the canonical IRI."@en .

measurement:weightStructural a owl:DatatypeProperty ;
    rdfs:label "weight structural"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F4 (2026-05-14): property declared from raw usage analysis (domain/range inferred per BP-D2 from existing ABox patterns). Per L-47v2: full skos:definition included."@en ;
    rdfs:domain measurement:AggregationRule ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:range xsd:decimal ;
    skos:definition "Weight assigned to Structural composite when computing weighted aggregate scores. Sibling of weightQCore. Per Sprint F4: same relocation pattern."@en .

meta:AllegroGraph a owl:Class ;
    rdfs:label "AllegroGraph"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "RDF Database Systems: Triples Storage and SPARQL Query Processing (Sakr & Al-Naymat, 2010). Springer."@en ;
    rdfs:comment "Enterprise-grade graph database with advanced RDF and geospatial support."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://www.w3.org/TR/sparql11-query/> ;
    rdfs:subClassOf meta:NativeTripleStore ;
    skos:definition "A commercial graph database and triple store developed by Franz Inc., providing SPARQL query processing, reasoning support, geospatial and temporal indexing, and federation across distributed repositories."@en ;
    skos:example "AllegroGraph 7.0 scales to 1 trillion triples with distributed architecture."@en .

meta:ApplicationBasedEvaluation a owl:Class ;
    rdfs:label "Application-Based Evaluation"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Evaluation based on downstream task performance."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-642-38721-0> ;
    rdfs:subClassOf meta:AlignmentEvaluation ;
    skos:definition "An alignment evaluation method that measures mapping quality by assessing how well the alignment supports a specific downstream application task, such as data integration or cross-ontology querying."@en ;
    skos:example "Alignment enables 95% query success rate across ontologies."@en .

meta:CEL a owl:Class ;
    rdfs:label "CEL Reasoner"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "W3C OWL 2 Web Ontology Language (2012). https://www.w3.org/TR/owl2-overview/"@en ;
    rdfs:comment "Polynomial-time classifier for OWL EL ontologies using completion algorithms."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-642-17796-5_2> ;
    rdfs:subClassOf meta:ConsequenceBasedReasoner ;
    skos:definition "A consequence-based reasoner optimized for the EL++ description logic profile, providing polynomial-time classification for ontologies that use only existential restrictions, conjunction, and role hierarchies."@en ;
    skos:example "CEL is integrated in Protégé for fast classification of biomedical ontologies."@en .

meta:CommandLineTool a owl:Class ;
    rdfs:label "Command-Line Tool"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Terminal-based ontology tool."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2014.6816804> ;
    rdfs:subClassOf kb:EngineeringTool,
        meta:Tool ;
    skos:definition "A development tool operated through terminal commands that performs ontology operations such as validation, format conversion, reasoning, and metric computation in scriptable, automatable workflows."@en ;
    skos:example "ROBOT command-line tool for ontology processing."@en .

meta:DesktopApplication a owl:Class ;
    rdfs:label "Desktop Application"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Protégé: A Tool for Editing OWL Ontologies. Stanford University. https://protege.stanford.edu/"@en ;
    rdfs:comment "Native desktop ontology editor."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1145/2063518.2063520> ;
    rdfs:subClassOf meta:DesktopEditor ;
    skos:definition "A desktop editor variant distributed as a native application for a specific operating system, providing full-featured ontology editing with local file access and optional network-based collaboration."@en ;
    skos:example "Windows desktop application for OWL editing."@en .

meta:DiagramEditor a owl:Class ;
    rdfs:label "Diagram Editor"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Editor specialized in creating and editing ontology diagrams and visual representations."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://www.omg.org/spec/UML/2.5.1/> ;
    rdfs:subClassOf meta:VisualModeler ;
    skos:definition "A visual modeler that generates ontology visualizations as structured diagrams showing class hierarchies, property connections, and restriction patterns in publication-ready graphical formats."@en ;
    skos:example "Graffoo editor generates graphical representations of OWL ontologies automatically."@en .

meta:DisjointAlignment a owl:Class ;
    rdfs:label "Disjoint Alignment"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Classes that have no overlap in instances."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-642-38721-0> ;
    rdfs:subClassOf meta:ClassAlignment ;
    skos:definition "A class alignment type that declares two classes from different ontologies as mutually exclusive, meaning no individual can be simultaneously classified under both classes in a merged knowledge base."@en ;
    skos:example "Declaring Car in A disjoint with Bicycle in B."@en .

meta:ELK a owl:Class ;
    rdfs:label "ELK Reasoner"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "W3C OWL 2 Web Ontology Language (2012). https://www.w3.org/TR/owl2-overview/"@en ;
    rdfs:comment "Very fast reasoner optimized for OWL EL profile using parallel algorithms."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-642-17796-5_2> ;
    rdfs:subClassOf meta:ConsequenceBasedReasoner ;
    skos:definition "A consequence-based reasoner designed for efficient classification of OWL 2 EL ontologies, using concurrent rule application to achieve high-performance reasoning on large biomedical and scientific ontologies."@en ;
    skos:example "ELK 0.4.3 classifies SNOMED CT (300K+ classes) in seconds using multi-core processing."@en .

meta:Editor a owl:Class ;
    rdfs:label "Editor"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Musen, M.A. (2015). The Protégé project: a look back and a look forward. AI Matters 1(4); W3C Open-Source Editors list (https://www.w3.org/wiki/SemanticWebTools)."@en ;
    rdfs:comment "Concept previously referenced by meta:InfrastructureLayer meta:contains and meta:FR_007 meta:satisfiedBy. Declared with full annotations in v6.3.12 to satisfy META M2a/M2b/M2c."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1145/2757001.2757003> ;
    skos:definition "An interactive software tool for authoring, editing, refactoring, and visualising ontology artefacts (TBox, ABox, SHACL shapes). Distinct from a Reasoner (which derives entailments from a fixed ontology); an Editor mutates the ontology under user direction with optional reasoner integration."@en ;
    skos:example "Protégé Desktop 5.6 with HermiT plugin allows the method author to add a class to a reliability ontology v2.5.12, immediately see classification impact, and detect unsatisfiability before saving. Topbraid Composer and WebProtégé are alternative implementations."@en .

meta:EmacsOWLMode a owl:Class ;
    rdfs:label "Emacs OWL Mode"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Emacs major mode for editing OWL and RDF ontology files."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2014.6816804> ;
    rdfs:subClassOf meta:SyntaxAwareEditor ;
    skos:definition "A syntax-aware editor mode for the Emacs text editor that provides OWL-specific syntax highlighting, indentation, and navigation commands for editing ontology files in various serialization formats."@en ;
    skos:example "owl-mode provides syntax highlighting and abbreviation expansion for OWL in Emacs."@en .

meta:EmbeddedReasoner a owl:Class ;
    rdfs:label "Embedded Reasoner"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "W3C OWL 2 Web Ontology Language (2012). https://www.w3.org/TR/owl2-overview/"@en ;
    rdfs:comment "Reasoner integrated in application."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1145/1656274.1656281> ;
    rdfs:subClassOf meta:DLReasoner ;
    skos:definition "A description logic reasoner designed to run within an application process rather than as a separate service, providing low-latency reasoning with reduced deployment complexity at the cost of shared resource management."@en ;
    skos:example "Pellet embedded in Protégé."@en .

meta:FaCTPlusPlus a owl:Class ;
    rdfs:label "FaCT++"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Description Logic Handbook (Baader et al., 2003). Cambridge University Press."@en ;
    rdfs:comment "C++ implementation of tableau-based OWL DL reasoner with optimized performance."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1145/1656274.1656281> ;
    rdfs:subClassOf meta:TableauBasedReasoner ;
    skos:definition "A description logic reasoner implementing optimized tableau algorithms for OWL DL, implemented in C++ for performance and known for efficient handling of large terminological knowledge bases."@en ;
    skos:example "FaCT++ v1.6.5 provides fast classification for large biomedical ontologies."@en .

meta:GitHubOntologyRepo a owl:Class ;
    rdfs:label "GitHub Ontology Repository"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "RDF Database Systems: Triples Storage and SPARQL Query Processing (Sakr & Al-Naymat, 2010). Springer."@en ;
    rdfs:comment "GitHub Ontology Repository."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://git-scm.com/book/en/v2> ;
    rdfs:subClassOf meta:RepositorySystem ;
    skos:definition "A repository system that uses GitHub's version control platform for ontology file management, leveraging git branching, pull requests, and issue tracking for collaborative ontology development workflows."@en ;
    skos:example "Hosting the OE package TTL files at https://github.com/example/oe-package, with GitHub Actions CI and tagged releases for each sprint, is a GitHubOntologyRepo for versioned ontology distribution."@en .

meta:GitLabOntologyRepo a owl:Class ;
    rdfs:label "GitLab Ontology Repository"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "RDF Database Systems: Triples Storage and SPARQL Query Processing (Sakr & Al-Naymat, 2010). Springer."@en ;
    rdfs:comment "GitLab Ontology Repository."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://git-scm.com/book/en/v2> ;
    rdfs:subClassOf meta:RepositorySystem ;
    skos:definition "A repository system that uses GitLab's version control platform for ontology file management, providing self-hosted deployment options alongside git-based versioning and CI/CD pipeline integration."@en ;
    skos:example "A self-hosted GitLab instance where the a reliability ontology ecosystem TTL files are stored, with merge request pipelines that gate on pySHACL returning Conforms=True, is a GitLabOntologyRepo."@en .

meta:GoldStandardEvaluation a owl:Class ;
    rdfs:label "Gold Standard Evaluation"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Evaluation against expert-created reference alignment."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-642-38721-0> ;
    rdfs:subClassOf meta:AlignmentEvaluation ;
    skos:definition "An alignment evaluation method that computes precision, recall, and F-measure by comparing generated mappings against a manually curated reference alignment considered to be the authoritative correct answer."@en ;
    skos:example "Comparing automatic alignment to expert-created 200-mapping gold standard."@en .

meta:GraphicalOntologyEditor a owl:Class ;
    rdfs:label "Graphical Ontology Editor"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Editor combining visual modeling with direct ontology manipulation capabilities."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://www.omg.org/spec/UML/2.5.1/> ;
    rdfs:subClassOf meta:VisualModeler ;
    skos:definition "A visual modeler that provides full ontology editing capabilities through a graphical interface, allowing users to create, modify, and delete ontology elements through visual manipulation rather than text editing."@en ;
    skos:example "OntoGraf plugin for Protégé provides interactive graphical ontology visualization and editing."@en .

meta:HermiT a owl:Class ;
    rdfs:label "HermiT"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Description Logic Handbook (Baader et al., 2003). Cambridge University Press."@en ;
    rdfs:comment "OWL 2 reasoner using hypertableau calculus for efficient reasoning."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1145/1656274.1656281> ;
    rdfs:subClassOf meta:TableauBasedReasoner ;
    skos:definition "A description logic reasoner implementing the hypertableau calculus for OWL 2 DL, notable for its completeness guarantees, blocking optimization strategies, and support for datatype reasoning."@en ;
    skos:example "HermiT 1.4.3 is the default reasoner in Protégé 5 for classification tasks."@en .

meta:HighConfidenceMatch a owl:Class ;
    rdfs:label "High Confidence Match"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology Matching (Euzenat & Shvaiko, 2013). Springer."@en ;
    rdfs:comment "Mapping with confidence score above 0.8."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf meta:MatchingConfidence ;
    skos:definition "A matching confidence classification for correspondences supported by strong evidence from multiple matching techniques, typically suitable for automated acceptance without requiring manual verification."@en ;
    skos:example "Exact label match yields 1.0 confidence."@en .

meta:InconsistencyExplainer a owl:Class ;
    rdfs:label "Inconsistency Explainer"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Description Logic Handbook (Baader et al., 2003). Cambridge University Press."@en ;
    rdfs:comment "Tool providing human-readable explanations for why ontology is inconsistent."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl2-primer/> ;
    rdfs:subClassOf meta:InconsistencyDetector ;
    skos:definition "An inconsistency detection tool that not only identifies contradictions but generates minimal axiom sets responsible for each inconsistency, helping engineers understand and resolve specific conflict sources."@en ;
    skos:example "Protégé Explanation Workbench shows which axioms conflict to cause inconsistency."@en .

meta:JenaReasoner a owl:Class ;
    rdfs:label "Jena Reasoner"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Description Logic Handbook (Baader et al., 2003). Cambridge University Press."@en ;
    rdfs:comment "Rule-based reasoner from Apache Jena supporting RDFS, OWL, and custom rules."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://jena.apache.org/> ;
    rdfs:subClassOf meta:ForwardChaining ;
    skos:definition "A forward-chaining reasoner integrated with the Apache Jena framework, providing RDFS and OWL reasoning through rule-based inference over Jena's in-memory or TDB-backed RDF graph models."@en ;
    skos:example "Jena OWL reasoner with RDFS rule set performs forward-chaining RDFS inference on RDF graphs."@en .

meta:Konclude a owl:Class ;
    rdfs:label "Konclude"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "W3C OWL 2 Web Ontology Language (2012). https://www.w3.org/TR/owl2-overview/"@en ;
    rdfs:comment "High-performance parallel reasoner using concurrent tableaux algorithms."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1145/1656274.1656281> ;
    rdfs:subClassOf meta:HybridReasoner ;
    skos:definition "A hybrid reasoner that combines optimized tableau-based reasoning for OWL 2 DL with parallel computation strategies, designed for high-performance classification and consistency checking of expressive ontologies."@en ;
    skos:example "Konclude 0.7 achieves top performance in ORE reasoner competition using parallelization."@en .

meta:LibraryTool a owl:Class ;
    rdfs:label "Library Tool"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Programmatic API for ontologies."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2014.6816804> ;
    rdfs:subClassOf kb:EngineeringTool,
        meta:Tool ;
    skos:definition "A software library or SDK that provides programmatic APIs for ontology manipulation, enabling developers to create, read, modify, and query ontology data structures within custom application code."@en ;
    skos:example "OWL API library for Java applications."@en .

meta:LowConfidenceMatch a owl:Class ;
    rdfs:label "Low Confidence Match"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology Matching (Euzenat & Shvaiko, 2013). Springer."@en ;
    rdfs:comment "Mapping with confidence score below 0.5."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf meta:MatchingConfidence ;
    skos:definition "A matching confidence classification for correspondences with weak or ambiguous evidence, requiring detailed expert analysis and domain knowledge to determine whether the correspondence is valid."@en ;
    skos:example "Weak structural similarity yields 0.3 confidence."@en .

meta:ManyToManyMapping a owl:Class ;
    rdfs:label "Many-to-Many Mapping"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Complex multi-way mapping."@en,
        "Many-to-Many Mapping - ontology alignment cardinality pattern."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-642-38721-0> ;
    rdfs:subClassOf kb:MappingTechnique,
        meta:Mapping ;
    owl:disjointWith meta:ManyToOneMapping,
        meta:OneToManyMapping,
        meta:OneToOneMapping ;
    skos:definition "A mapping technique that establishes complex correspondences where groups of source elements collectively map to groups of target elements, representing structural differences between ontology designs."@en ;
    skos:example "2 concepts in A relate to 3 in B."@en .

meta:MediumConfidenceMatch a owl:Class ;
    rdfs:label "Medium Confidence Match"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology Matching (Euzenat & Shvaiko, 2013). Springer."@en ;
    rdfs:comment "Mapping with confidence score between 0.5 and 0.8."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf meta:MatchingConfidence ;
    skos:definition "A matching confidence classification for correspondences with moderate evidence, typically requiring brief human review to confirm before being accepted into a production alignment."@en ;
    skos:example "Partial label match yields 0.65 confidence."@en .

meta:MinimalInconsistency a owl:Class ;
    rdfs:label "Minimal Inconsistency Finder"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Description Logic Handbook (Baader et al., 2003). Cambridge University Press."@en ;
    rdfs:comment "Tool computing minimal inconsistent subsets (MIS) or minimal unsatisfiable subsets."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl2-primer/> ;
    rdfs:subClassOf meta:InconsistencyDetector ;
    skos:definition "An inconsistency detection tool that computes the smallest possible subsets of axioms that together cause a logical contradiction, isolating the root cause for efficient targeted repair."@en ;
    skos:example "Debugging tools find minimal axiom sets responsible for unsatisfiable classes."@en .

meta:NativeReasoner a owl:Class ;
    rdfs:label "Native Reasoner"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "W3C OWL 2 Web Ontology Language (2012). https://www.w3.org/TR/owl2-overview/"@en ;
    rdfs:comment "Reasoner implemented in compiled language."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1145/1656274.1656281> ;
    rdfs:subClassOf meta:DLReasoner ;
    skos:definition "A description logic reasoner built into a triple store or graph database, providing integrated reasoning capabilities without requiring external reasoner invocation, optimized for the store's native data structures."@en ;
    skos:example "HermiT native Java reasoner."@en .

meta:OWLAPIValidator a owl:Class ;
    rdfs:label "OWL API Validator"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Validator using OWL API library for parsing and syntax checking."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf meta:SyntaxValidator ;
    skos:definition "A syntax validator built on the OWL API library that checks OWL ontology files for structural conformance, detecting invalid axiom constructions and unsupported language features."@en ;
    skos:example "OWL API 5.x validates OWL 2 functional syntax and detects malformed axioms."@en .

meta:OWLimReasoner a owl:Class ;
    rdfs:label "OWLim Reasoner"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Description Logic Handbook (Baader et al., 2003). Cambridge University Press."@en ;
    rdfs:comment "High-performance forward-chaining reasoner for RDF/OWL (now GraphDB)."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://jena.apache.org/> ;
    rdfs:subClassOf meta:ForwardChaining ;
    skos:definition "A forward-chaining reasoner optimized for materialization of RDFS and OWL Horst entailments over large-scale RDF datasets, designed for efficiency in triple store pre-computation scenarios."@en ;
    skos:example "OWLim-SE materializes RDFS and OWL Horst semantics over 10 billion triples."@en .

meta:OntoUMLEditor a owl:Class ;
    rdfs:label "OntoUML Editor"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Editor for OntoUML, a UML profile based on UFO (Unified Foundational Ontology)."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://www.omg.org/spec/UML/2.5.1/> ;
    rdfs:subClassOf meta:UMLTool ;
    skos:definition "A UML tool specialized for ontology modeling that enforces OntoUML stereotypes and constraints, guiding modelers toward ontologically sound designs based on foundational ontology principles."@en ;
    skos:example "OLED is an OntoUML editor providing validation based on UFO ontological patterns."@en .

meta:OwlValidator a owl:Class ;
    rdfs:label "OWL Validator"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "OWL Validator."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf meta:SyntaxValidator ;
    skos:definition "A syntax validator that checks OWL ontology files for conformance to the OWL specification, verifying that class expressions, property assertions, and annotations follow valid construction patterns."@en ;
    skos:example "Running HermiT 1.5 on meta_v6_2_2.ttl to confirm that all 600 classes are satisfiable (no unsatisfiable class warnings) uses HermiT as an OwlValidator for the ontology's logical consistency."@en .

meta:Pellet a owl:Class ;
    rdfs:label "Pellet"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Description Logic Handbook (Baader et al., 2003). Cambridge University Press."@en ;
    rdfs:comment "Open-source OWL 2 reasoner with support for DL-safe rules and explanations."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1145/1656274.1656281> ;
    rdfs:subClassOf meta:TableauBasedReasoner ;
    skos:definition "A description logic reasoner for OWL 2 DL that combines tableau-based classification with SPARQL-DL query answering, supporting incremental reasoning, explanation generation, and integration with Jena."@en ;
    skos:example "Pellet 2.3.1 integrates with Protégé and provides explanation services for inferences."@en .

meta:PlainTextEditor a owl:Class ;
    rdfs:label "Plain Text Editor"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Simple text editor without ontology-specific features for manual serialization editing."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2014.6816804> ;
    rdfs:subClassOf meta:TextEditor ;
    skos:definition "A text editor used for ontology editing without any ontology-specific features, relying entirely on the engineer's knowledge of serialization syntax for correct file manipulation."@en ;
    skos:example "Notepad++ can edit Turtle files with manual syntax management."@en .

meta:PluginTool a owl:Class ;
    rdfs:label "Plugin Tool"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Extension for other applications."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2014.6816804> ;
    rdfs:subClassOf kb:EngineeringTool,
        meta:Tool ;
    skos:definition "A software extension that adds ontology engineering capabilities to an existing application or platform, such as a reasoner plugin for Protégé or an ontology browser plugin for a web platform."@en ;
    skos:example "Protégé plugin for SWRL rules."@en .

meta:PoolPartyEditor a owl:Class ;
    rdfs:label "PoolParty Editor"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Protégé: A Tool for Editing OWL Ontologies. Stanford University. https://protege.stanford.edu/"@en ;
    rdfs:comment "Commercial semantic technology platform with collaborative ontology management."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1145/1526709.1526786> ;
    rdfs:subClassOf meta:CollaborativeEditor ;
    skos:definition "A collaborative web-based ontology editor focused on SKOS vocabulary management and knowledge organization, providing taxonomy editing, text mining integration, and linked data publishing capabilities."@en ;
    skos:example "PoolParty Semantic Suite manages corporate taxonomies for Fortune 500 companies."@en .

meta:PrologBasedReasoner a owl:Class ;
    rdfs:label "Prolog-Based Reasoner"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Description Logic Handbook (Baader et al., 2003). Cambridge University Press."@en ;
    rdfs:comment "Reasoner leveraging Prolog logic programming for RDF/OWL inference."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://www.w3.org/Submission/SWRL/> ;
    rdfs:subClassOf meta:BackwardChaining ;
    skos:definition "A backward-chaining reasoner that translates ontology axioms and rules into Prolog clauses, leveraging Prolog's resolution engine for query-driven inference over ontological knowledge bases."@en ;
    skos:example "SWI-Prolog Semantic Web Library provides backward-chaining RDFS reasoning."@en .

meta:PropertyAlignment a owl:Class ;
    rdfs:label "Property Alignment"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Mapping between properties in different ontologies."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-642-38721-0> ;
    rdfs:subClassOf meta:AlignmentPattern ;
    skos:definition "An alignment pattern that establishes correspondences between properties in different ontologies, specifying equivalence, subsumption, or inverse relationships between relationship types across vocabularies."@en ;
    skos:example "Aligning 'hasAge' property with 'age' data property."@en .

meta:ProtegeEditor a owl:Class ;
    rdfs:label "Protégé Editor"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Protégé: A Tool for Editing OWL Ontologies. Stanford University. https://protege.stanford.edu/"@en ;
    rdfs:comment "Open-source ontology editor and framework developed by Stanford University."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1145/2063518.2063520> ;
    rdfs:subClassOf meta:DesktopEditor ;
    skos:definition "A desktop ontology editor developed at Stanford University that provides a plugin-extensible interface for OWL ontology development, with built-in reasoner integration and visualization capabilities."@en ;
    skos:example "Protégé 5.5.0 includes support for SWRL rules and SPARQL queries."@en .

meta:RDFValidator a owl:Class ;
    rdfs:label "RDF Validator"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "RDF Validator."@en,
        "Validator checking RDF syntax conformance and triple well-formedness."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf meta:SyntaxValidator ;
    skos:definition "A syntax validator that checks RDF files for conformance to the RDF specification, detecting invalid triple patterns, malformed literals, undeclared namespaces, and encoding errors."@en ;
    skos:example "Apache Jena RIOT validates RDF syntax and reports line-specific parsing errors."@en .

meta:RacerPro a owl:Class ;
    rdfs:label "RacerPro"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "W3C OWL 2 Web Ontology Language (2012). https://www.w3.org/TR/owl2-overview/"@en ;
    rdfs:comment "Commercial reasoner with optimized hybrid algorithms and concrete domain support."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1145/1656274.1656281> ;
    rdfs:subClassOf meta:HybridReasoner ;
    skos:definition "A hybrid reasoner providing OWL DL reasoning with integrated query answering capabilities, notable for early support of ABox reasoning and defined concept optimization in knowledge base applications."@en ;
    skos:example "RacerPro 2.0 offers nRQL query language and tight Protégé integration."@en .

meta:Reasoner a owl:Class ;
    rdfs:label "Reasoner"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Glimm, B., Horrocks, I., Motik, B., Stoilos, G., Wang, Z. (2014). HermiT: An OWL 2 Reasoner. J. Automated Reasoning 53(3); Sirin et al. (2007). Pellet: A practical OWL-DL reasoner."@en ;
    rdfs:comment "Concept previously referenced by meta:InfrastructureLayer meta:contains and meta:FR_007 meta:satisfiedBy. Declared with full annotations in v6.3.12 to satisfy META M2a/M2b/M2c."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1007/s10817-014-9305-1> ;
    skos:definition "A software component that derives logical entailments from an OWL 2 / RDFS / SHACL ontology under a chosen semantics (DL, RL, EL, QL profiles). Provides services: classification (compute subsumption hierarchy), realization (compute most specific class for individuals), satisfiability checking, and consistency checking."@en ;
    skos:example "HermiT classifies a reliability ontology v2.5.11 (10010 triples, 343 classes) consistent under OWL 2 DL in <2s; Pellet computes the same hierarchy and adds explanation generation for unsatisfiable classes."@en .

meta:SHACLApacheJena a owl:Class ;
    rdfs:label "Apache Jena SHACL"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Apache Jena SHACL."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://www.w3.org/TR/shacl/> ;
    rdfs:subClassOf meta:ApacheJenaSHACL ;
    skos:definition "An Apache Jena SHACL implementation variant providing SHACL constraint validation services integrated with the Jena triple store and SPARQL engine for combined query and validation workflows."@en ;
    skos:example "Running `shacl validate --shapes redo_shacl_v2_0_6.ttl --data core_v1_1_4.ttl` with Apache Jena 4.9 to produce a validation report as an alternative to pySHACL demonstrates SHACLApacheJena."@en .

meta:SVNOntologyRepo a owl:Class ;
    rdfs:label "SVN Ontology Repository"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "RDF Database Systems: Triples Storage and SPARQL Query Processing (Sakr & Al-Naymat, 2010). Springer."@en ;
    rdfs:comment "SVN Ontology Repository."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://subversion.apache.org/docs/> ;
    rdfs:subClassOf meta:RepositorySystem ;
    skos:definition "A repository system that uses Apache Subversion for ontology file version control, providing centralized versioning with atomic commits and directory-level branching for ontology management."@en ;
    skos:example "An enterprise Subversion repository where legacy ontology TTL files are committed with commit messages describing each class addition, used before the team migrated to Git, is an SVNOntologyRepo."@en .

meta:SWRLReasoner a owl:Class ;
    rdfs:label "SWRL Reasoner"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Description Logic Handbook (Baader et al., 2003). Cambridge University Press."@en ;
    rdfs:comment "Reasoner executing SWRL (Semantic Web Rule Language) rules over OWL ontologies."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://www.w3.org/Submission/SWRL/> ;
    rdfs:subClassOf meta:BackwardChaining ;
    skos:definition "A backward-chaining reasoner that processes rules written in the Semantic Web Rule Language, enabling Horn-clause style inference over OWL ontologies with variable binding and built-in predicates."@en ;
    skos:example "Jess rule engine with SWRL integration executes SWRL rules via backward chaining."@en .

meta:StrictEquivalence a owl:Class ;
    rdfs:label "Strict Equivalence"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Classes with identical extension in all possible worlds."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-642-38721-0> ;
    rdfs:subClassOf meta:EquivalenceAlignment ;
    skos:definition "An equivalence alignment variant that asserts exact semantic identity between two classes, requiring that they have identical extension and intension in all possible interpretations of the merged ontology."@en ;
    skos:example "Two classes defined with identical axioms are strictly equivalent."@en .

meta:SubsumptionAlignment a owl:Class ;
    rdfs:label "Subsumption Alignment"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "One class is more specific than another."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-642-38721-0> ;
    rdfs:subClassOf meta:ClassAlignment ;
    skos:definition "A class alignment type that declares a class in one ontology as a subclass of a class in another ontology, establishing a hierarchical relationship across ontology boundaries."@en ;
    skos:example "Car in A is subclass of Vehicle in B."@en .

meta:TeamEditor a owl:Class ;
    rdfs:label "Team Editor"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Protégé: A Tool for Editing OWL Ontologies. Stanford University. https://protege.stanford.edu/"@en ;
    rdfs:comment "Generic collaborative ontology editor supporting team workflows and role-based access."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1145/1526709.1526786> ;
    rdfs:subClassOf meta:CollaborativeEditor ;
    skos:definition "A collaborative editor feature set that supports team-based ontology development with shared workspaces, real-time or asynchronous editing, change notifications, and integrated discussion threads."@en ;
    skos:example "OntoStudio Team Server enables distributed ontology engineering teams."@en .

meta:TopBraidComposer a owl:Class ;
    rdfs:label "TopBraid Composer"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Protégé: A Tool for Editing OWL Ontologies. Stanford University. https://protege.stanford.edu/"@en ;
    rdfs:comment "Commercial ontology development environment with advanced modeling features."@en,
        "TopBraid Composer free edition - a Commercial ontology editor."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1145/2063518.2063520> ;
    rdfs:subClassOf meta:DesktopEditor ;
    skos:definition "A commercial ontology development environment by TopQuadrant, providing visual modeling, SPARQL support and SHACL validation."@en ;
    skos:example "TopBraid Composer Maestro Edition supports large-scale enterprise ontology projects."@en .

meta:TopBraidComposerME a owl:Class ;
    rdfs:label "TopBraid Composer Maestro Edition"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Protégé: A Tool for Editing OWL Ontologies. Stanford University. https://protege.stanford.edu/"@en ;
    rdfs:comment "TopBraid Composer professional edition - a Commercial ontology editor."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1145/2063518.2063520> ;
    rdfs:subClassOf meta:DesktopEditor ;
    skos:definition "A commercial ontology development environment by TopQuadrant, professional edition, providing visual modeling and SPARQL support."@en ;
    skos:example "Opening redo_v2_5_6.ttl in TopBraid Composer Maestro Edition, using its SHACL validation panel to run redo_shacl_v2_0_6.ttl, and reviewing the violation report in the built-in results view demonstrates TopBraidComposerME."@en .

meta:TopBraidSHACL a owl:Class ;
    rdfs:label "TopBraid SHACL"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Reference implementation of SHACL validation from TopQuadrant."@en,
        "TopBraid SHACL."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://www.w3.org/TR/shacl/> ;
    rdfs:subClassOf meta:SHACLValidator ;
    skos:definition "A SHACL validator developed by TopQuadrant that provides comprehensive SHACL constraint validation with advanced features including SHACL-AF rule execution and integration with enterprise data governance platforms."@en ;
    skos:example "TopBraid SHACL API integrates with Jena for enterprise SHACL validation."@en .

meta:UMLToOWL a owl:Class ;
    rdfs:label "UML to OWL Converter"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Tool converting UML models to OWL ontologies following transformation rules."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://www.omg.org/spec/UML/2.5.1/> ;
    rdfs:subClassOf meta:UMLTool ;
    skos:definition "A UML tool feature that transforms UML class diagrams into OWL ontology axioms, converting UML classes to OWL classes, associations to object properties, and inheritance to subclass relationships."@en ;
    skos:example "UML2OWL plugin converts UML class diagrams to OWL 2 ontologies automatically."@en .

meta:VSCodeExtension a owl:Class ;
    rdfs:label "VS Code Extension"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Visual Studio Code extension providing ontology language support."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2014.6816804> ;
    rdfs:subClassOf meta:SyntaxAwareEditor ;
    skos:definition "A syntax-aware editor extension for Visual Studio Code that provides ontology language support including syntax highlighting, linting, hover documentation, and SPARQL query execution integration."@en ;
    skos:example "stardog-rdf-grammars extension provides Turtle and SPARQL support in VS Code."@en .

meta:Virtuoso a owl:Class ;
    rdfs:label "Virtuoso"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "RDF Database Systems: Triples Storage and SPARQL Query Processing (Sakr & Al-Naymat, 2010). Springer."@en ;
    rdfs:comment "High-performance universal server supporting RDF, SQL, and document storage."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://www.w3.org/TR/sparql11-query/> ;
    rdfs:subClassOf meta:NativeTripleStore ;
    skos:definition "A hybrid relational-graph database system developed by OpenLink Software that stores RDF triples alongside relational data, providing SPARQL endpoints, linked data publishing, and large-scale triple management."@en ;
    skos:example "Virtuoso 7.2 powers DBpedia SPARQL endpoint serving millions of queries daily."@en .

meta:WebApplication a owl:Class ;
    rdfs:label "Web Application"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Protégé: A Tool for Editing OWL Ontologies. Stanford University. https://protege.stanford.edu/"@en ;
    rdfs:comment "Browser-based editing application."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf meta:WebBasedEditor ;
    skos:definition "A web-based editor variant accessible through standard web browsers, providing ontology editing capabilities through a responsive interface without requiring local software installation."@en ;
    skos:example "SaaS ontology editor in browser."@en .

meta:WebProtege a owl:Class ;
    rdfs:label "WebProtégé"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Protégé: A Tool for Editing OWL Ontologies. Stanford University. https://protege.stanford.edu/"@en ;
    rdfs:comment "Web-based version of Protégé supporting collaborative ontology development."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf meta:WebBasedEditor ;
    skos:definition "A web-based ontology editor developed at Stanford University that provides collaborative OWL editing through a browser interface with change tracking, discussion threads, and access control features."@en ;
    skos:example "WebProtégé enables distributed teams to work on BioPortal ontologies simultaneously."@en .

meta:WebServiceReasoner a owl:Class ;
    rdfs:label "Web Service Reasoner"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Description Logic Handbook (Baader et al., 2003). Cambridge University Press."@en ;
    rdfs:comment "Remote reasoning via HTTP API."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1145/1656274.1656281> ;
    rdfs:subClassOf meta:ReasoningTool ;
    skos:definition "A reasoning tool exposed as a network-accessible service endpoint, enabling remote clients to submit reasoning tasks and receive results through standardized web service protocols."@en ;
    skos:example "Reasoning-as-a-service endpoint."@en .

meta:WebVOWLViewer a owl:Class ;
    rdfs:label "WebVOWL Viewer"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Protégé: A Tool for Editing OWL Ontologies. Stanford University. https://protege.stanford.edu/"@en ;
    rdfs:comment "WebVOWL - web-based ontology visualization tool."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf meta:WebBasedEditor ;
    skos:definition "A browser-based tool for visualizing ontologies using the VOWL (Visual Notation for OWL Ontologies) graphical notation."@en ;
    skos:example "Loading oqc_v2_2_1.ttl into WebVOWL (webvowl.visualdataweb.org) to display the 92-class hierarchy as a force-directed graph, with class distance proportional to rdfs:subClassOf depth, uses the WebVOWLViewer."@en .

meta:hasLayer a owl:ObjectProperty ;
    rdfs:label "has layer"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Guarino, N., Oberle, D., Staab, S. (2009). What Is an Ontology? In: Handbook on Ontologies. Springer. ISO/IEC 42010:2011 Systems and software engineering — Architecture description."@en ;
    rdfs:domain meta:SymbioticOntologyModel ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:range kb:ArchitecturalLayer ;
    skos:definition "Associates a symbiotic ontology model with one of its architectural layers (navigational or computational)."@en .

meta:hasView a owl:ObjectProperty ;
    rdfs:label "has view"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Guarino, N., Oberle, D., Staab, S. (2009). What Is an Ontology? In: Handbook on Ontologies. Springer. ISO/IEC 42010:2011 Systems and software engineering — Architecture description."@en ;
    rdfs:domain meta:SymbioticOntologyModel ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:range kb:ArchitecturalView ;
    skos:definition "Associates a symbiotic ontology model with one of its representational views (human-readable or machine-processable)."@en .

meta:producesOutput a owl:ObjectProperty ;
    rdfs:label "produces output"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Guarino, N., Oberle, D., Staab, S. (2009). What Is an Ontology? In: Handbook on Ontologies. Springer. ISO/IEC 42010:2011 Systems and software engineering — Architecture description."@en ;
    rdfs:comment "Relates a tool to the type of artifacts it generates."@en ;
    rdfs:domain meta:Tool ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:range qc:OntologyArtifact ;
    skos:definition "A property that indicates what kind of ontology artifacts or outputs a tool creates during its operation."@en .

meta:supportsFormat a owl:ObjectProperty ;
    rdfs:label "supports format"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Guarino, N., Oberle, D., Staab, S. (2009). What Is an Ontology? In: Handbook on Ontologies. Springer. ISO/IEC 42010:2011 Systems and software engineering — Architecture description."@en ;
    rdfs:comment "Relates a tool to ontology formats it can process."@en ;
    rdfs:domain meta:Tool ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:range kb:OntologyFormat ;
    skos:definition "A property that indicates which ontology serialization formats a tool can read, write, or manipulate."@en .

performance:hasLastMeasuredDate a owl:DatatypeProperty ;
    rdfs:label "hasLastMeasuredDate"@en ;
    dcterms:isPartOf <http://example.org/performance> ;
    dcterms:source "OE Pack v17.31.1 — measurement-record property for completed Item 7 (benchmark execution)."@en ;
    rdfs:domain performance:PerformanceTest ;
    rdfs:range xsd:dateTime ;
    skos:definition "Date on which the most recent measurement was performed."@en .

performance:hasLastMeasuredMedianMs a owl:DatatypeProperty ;
    rdfs:label "hasLastMeasuredMedianMs"@en ;
    dcterms:isPartOf <http://example.org/performance> ;
    dcterms:source "OE Pack v17.31.1 — measurement-record property for completed Item 7 (benchmark execution)."@en ;
    rdfs:domain performance:PerformanceTest ;
    rdfs:range xsd:decimal ;
    skos:definition "Most-recently measured median wall-clock time in milliseconds for this benchmark. Recorded by scripts/benchmark_suite.py and written back into the ABox per v17.31.1."@en .

performance:hasLastMeasuredStatus a owl:DatatypeProperty ;
    rdfs:label "hasLastMeasuredStatus"@en ;
    dcterms:isPartOf <http://example.org/performance> ;
    dcterms:source "OE Pack v17.31.1 — measurement-record property for completed Item 7 (benchmark execution)."@en ;
    rdfs:domain performance:PerformanceTest ;
    rdfs:range xsd:string ;
    skos:definition "Status of most recent measurement: \"PASS\" (median <= 1.5 * target), \"FAIL\" (exceeds), or \"DEFERRED\" (could not be measured within reasonable window)."@en .

performance:hasTheoreticalComplexity a owl:ObjectProperty ;
    rdfs:label "has theoretical complexity"@en ;
    dcterms:isPartOf <http://example.org/performance> ;
    dcterms:source """DRY collapse of TWO source bridge properties from ae_bridge_v1_0_1.ttl (retired step 7):
  1. ae-bridge:hasTheoreticalComplexity
     (source: OQuaRE Duque-Ramos 2011 for the PE side; user's ae_v1_0_0.ttl per Cormen et al. 2022 Ch. 3 for the AE side; original domain quality:PerformanceEfficiency)
  2. ae-bridge:reliabilityHasTheoreticalComplexity
     (source: a reliability ontology the method author a reliability ontology v2.5.x for the reliability side; user's ae_v1_0_0.ttl for the AE side; original domain reliability:Performance)
Both source properties had identical range (AsymptoticNotation) and semantically equivalent relations — collapsed to a single Performance-subject property in v1.0.0; v1.0.1 corrects the attribution that v1.0.0 incompletely recorded."""@en ;
    rdfs:domain performance:PerformanceEfficiency ;
    rdfs:isDefinedBy <http://example.org/performance> ;
    rdfs:range ae:AsymptoticNotation ;
    skos:definition "Links a PerformanceEfficiency characteristic to its theoretical asymptotic complexity bound. Cross-subject bridge: Performance subject domain, AE subject range."@en .

performance:implementsAlgorithm a owl:ObjectProperty ;
    rdfs:label "implements algorithm (family)"@en ;
    dcterms:isPartOf <http://example.org/performance> ;
    dcterms:source """DRY collapse of THREE source bridge properties from ae_bridge_v1_0_1.ttl (retired step 7):
  1. ae-bridge:metricImplementsAlgorithm (source: OQC quality-metric pattern Duque-Ramos 2011 / OQuaRE; domain quality:QualityMetric)
  2. ae-bridge:measurementImplementsAlgorithm (source: OQC quality-measure pattern Duque-Ramos 2011 / OQuaRE; domain quality:QualityMeasure)
  3. ae-bridge:redoMetricImplementsAlgorithm (source: a reliability ontology ReliabilityMetric hierarchy a reliability ontology v2.5.x; domain reliability:ReliabilityMetric)
All three had identical range (AlgorithmFamily) and semantically equivalent 'this exercises that algorithm family' relations — collapsed in v1.0.0 with PerformanceTest as canonical domain. Metric→algorithm linkage may move to OEM at step 5 if needed."""@en ;
    rdfs:domain performance:PerformanceTest ;
    rdfs:isDefinedBy <http://example.org/performance> ;
    rdfs:range ae:AlgorithmFamily ;
    skos:definition "Links a performance test to the AE algorithm family it exercises."@en .

performance:justifiedByComplexity a owl:ObjectProperty ;
    rdfs:label "justified by theoretical complexity"@en ;
    dcterms:isPartOf <http://example.org/performance> ;
    dcterms:source "Folded in from ae-bridge:justifiedByComplexity (ae_bridge_v1_0_1.ttl, retired step 7). Original domain was quality:QualityThreshold; refactored to performance:PerformanceEfficiency where complexity claims belong conceptually. Source attributions from ae_bridge_v1_0_1.ttl: a reliability ontology Refinement_PreReleaseEmpiricalGating for the rationale."@en ;
    rdfs:domain performance:PerformanceEfficiency ;
    rdfs:isDefinedBy <http://example.org/performance> ;
    rdfs:range ae:AsymptoticNotation ;
    skos:definition "Links a performance efficiency claim or threshold to the asymptotic complexity bound that justifies it."@en .

performance:measuresArtifact a owl:ObjectProperty ;
    rdfs:label "measuresArtifact"@en ;
    dcterms:isPartOf <http://example.org/performance> ;
    rdfs:domain performance:PerformanceTest ;
    rdfs:isDefinedBy <http://example.org/performance> ;
    rdfs:range core:Artifact ;
    skos:definition "Subject-link (registration) hook: the artifact this PerformanceTest measures. A component registers its performance test of itself via this property. Range core:Artifact so any subject type can be tested."@en .

qc:AnnotationRichness a owl:Class ;
    rdfs:label "Annotation Richness"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Lantow, B. (2016) §3.1 OntoMetrics."@en ;
    rdfs:comment "Average number of annotations per class: AnnR = |ann| / |C|. OntoMetrics splits this by annotation type (rdfs:label, skos:definition, dcterms:source, etc.) for finer-grained coverage assessment."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf measurement:CompletenessMetric ;
    skos:definition "Average number of annotations per class: AnnR = |ann| / |C|. OntoMetrics splits this by annotation type (rdfs:label, skos:definition, dcterms:source, etc.) for finer-grained coverage assessment."@en ;
    skos:example "AnnR(meta_v6_3_13.ttl) on rdfs:label dimension = 1.0 (every named class carries at least one label)."@en .

qc:ArithmeticMeanRule a owl:Class ;
    rdfs:label "Arithmetic Mean Rule"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25023:2016 §7.1."@en ;
    rdfs:comment "Composite = (Σ scores) / |scores|. Equal weight; unbounded by individual extremes. Used in v1 of score_ontologies.py — produced 0.74 stack mean."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf measurement:AggregationRule ;
    skos:definition "Composite = (Σ scores) / |scores|. Equal weight; unbounded by individual extremes. Used in v1 of score_ontologies.py — produced 0.74 stack mean."@en .

qc:AttributeRichness a owl:Class ;
    rdfs:label "Attribute Richness"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Tartir, S. et al. (2005) §3.2.4 OntoQA schema metric."@en ;
    rdfs:comment "Schema metric measuring the average number of datatype-property attributes per class: AR = |att| / |C| where att = total datatype properties declared."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf measurement:SizeMetric ;
    skos:definition "Schema metric measuring the average number of datatype-property attributes per class: AR = |att| / |C| where att = total datatype properties declared."@en ;
    skos:example "AR(redo_v2_5_16.ttl) = 71 / 364 = 0.20."@en .

qc:AverageBreadth a owl:Class ;
    rdfs:label "Average Breadth"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Lantow, B. (2016) §3.1 OntoMetrics."@en ;
    rdfs:comment "Average branching factor of the class taxonomy: AB = Σ |children(c)| / |non-leaf classes|. Complements DepthMetric in describing taxonomy shape."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf measurement:DepthMetric ;
    skos:definition "Average branching factor of the class taxonomy: AB = Σ |children(c)| / |non-leaf classes|. Complements DepthMetric in describing taxonomy shape."@en .

qc:AveragePopulation a owl:Class ;
    rdfs:label "Average Population"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Tartir, S. et al. (2005) §3.3.1 OntoQA instance metric."@en ;
    rdfs:comment "Knowledge-base metric measuring the average number of instances per class: AP = |I| / |C|."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf measurement:CoverageMetric ;
    skos:definition "Knowledge-base metric measuring the average number of instances per class: AP = |I| / |C|."@en .

qc:ClassChildrenCount a owl:Class ;
    rdfs:label "Class Children Count"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Tartir, S. et al. (2005) §3.3.6 OntoQA instance metric."@en ;
    rdfs:comment "Per-class metric measuring the number of direct subclasses: CC(C_i) = |{c : c rdfs:subClassOf C_i}|. High values indicate broad parent concepts."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf measurement:SizeMetric ;
    skos:definition "Per-class metric measuring the number of direct subclasses: CC(C_i) = |{c : c rdfs:subClassOf C_i}|. High values indicate broad parent concepts."@en .

qc:ClassConnectivity a owl:Class ;
    rdfs:label "Class Connectivity"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Tartir, S. et al. (2005) §3.3.3 OntoQA instance metric."@en ;
    rdfs:comment "Per-class metric measuring the number of relationships instances of the class participate in: Conn(C_i) = |{r : r involves an instance of C_i}|. Identifies central concepts in the KB."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf measurement:CohesionMetric ;
    skos:definition "Per-class metric measuring the number of relationships instances of the class participate in: Conn(C_i) = |{r : r involves an instance of C_i}|. Identifies central concepts in the KB."@en .

qc:ClassFullness a owl:Class ;
    rdfs:label "Class Fullness"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Tartir, S. et al. (2005) §3.3.4 OntoQA instance metric."@en ;
    rdfs:comment "Per-class metric measuring how 'full' a class is relative to expected population: Full(C_i) = |inst(C_i)| / E[|inst(C_i)|]. Requires an expected-population baseline; in the absence of one, used as a relative ranking."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf measurement:CompletenessMetric ;
    skos:definition "Per-class metric measuring how 'full' a class is relative to expected population: Full(C_i) = |inst(C_i)| / E[|inst(C_i)|]. Requires an expected-population baseline; in the absence of one, used as a relative ranking."@en .

qc:ClassImportance a owl:Class ;
    rdfs:label "Class Importance"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Tartir, S. et al. (2005) §3.3.2 OntoQA instance metric."@en ;
    rdfs:comment "Per-class metric measuring the proportion of total instances belonging to a class: Imp(C_i) = |inst(C_i)| / |I|."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf measurement:CoverageMetric ;
    skos:definition "Per-class metric measuring the proportion of total instances belonging to a class: Imp(C_i) = |inst(C_i)| / |I|."@en .

qc:ClassReadability a owl:Class ;
    rdfs:label "Class Readability"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Tartir, S. et al. (2005) §3.3.5 OntoQA instance metric."@en ;
    rdfs:comment "Per-class metric measuring whether the class carries human-readable annotations (rdfs:label, rdfs:comment, skos:definition): Read(C_i) = |{ann : C_i has ann}| / |required_annotations|."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf measurement:QualityMetric ;
    skos:definition "Per-class metric measuring whether the class carries human-readable annotations (rdfs:label, rdfs:comment, skos:definition): Read(C_i) = |{ann : C_i has ann}| / |required_annotations|."@en .

qc:ClassRichness a owl:Class ;
    rdfs:label "Class Richness"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Tartir, S. et al. (2005) §3.2.1 OntoQA schema metric."@en ;
    rdfs:comment "Schema metric measuring the proportion of declared classes that are actually used (have at least one instance in the knowledge base): CR = |C'| / |C| where C' = {c ∈ C : ∃i. i rdf:type c}, C = all named owl:Class entities."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf measurement:SizeMetric ;
    skos:definition "Schema metric measuring the proportion of declared classes that are actually used (have at least one instance in the knowledge base): CR = |C'| / |C| where C' = {c ∈ C : ∃i. i rdf:type c}, C = all named owl:Class entities."@en ;
    skos:example "CR(amod_v1_2_6.ttl) = 7/16 = 0.438."@en .

qc:CompletenessAssessment a owl:Class ;
    rdfs:label "Completeness Assessment"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Vrandecic (2009). Ontology Evaluation. Handbook on Ontologies, Springer."@en ;
    rdfs:comment "A quality assessment focused specifically on evaluating the degree to which an ontology covers the relevant concepts, relationships, and axioms of its target domain."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35730.html>,
        <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf qc:QualityAssessment ;
    owl:disjointWith qc:CorrectnessAssessment ;
    skos:definition "A quality assessment focused specifically on evaluating the degree to which an ontology covers the relevant concepts, relationships, and axioms of its target domain."@en ;
    skos:example "A CompletenessAssessment of oqc_v2_2_0.ttl against ISO/IEC 25010:2023: checks whether all eight top-level product quality characteristics (Functional Suitability, Reliability, etc.) are represented as classes or subclasses."@en .

qc:CompositeQuality a owl:Class ;
    rdfs:label "CompositeQuality"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OE Pack v17.25.0 Option P — codified from v17.22.0 measurement report Family 7 (previously ad-hoc bands per L-52)."@en ;
    rdfs:comment "Composite quality score: arithmetic mean of StructuralQuality, SyntaxQuality, and PerformanceEfficiency."@en ;
    skos:definition "Composite quality score: arithmetic mean of StructuralQuality, SyntaxQuality, and PerformanceEfficiency."@en .

qc:DatatypePropertyDomainCompleteness a owl:Class ;
    rdfs:label "DatatypePropertyDomainCompleteness"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OE Pack v17.27.0 Challenge 1 — codify metrics that make L-47 dual-view AttrR + N's effects objectively measurable via SPARQL."@en ;
    rdfs:comment "Ratio of datatype properties (in subject namespace) that have at least one rdfs:domain assertion, to total datatype properties (in subject namespace). Measures how well DT properties declare their subjects. Range [0.0, 1.0]."@en ;
    rdfs:subClassOf qc:QualityMetric ;
    skos:definition "Ratio of datatype properties (in subject namespace) that have at least one rdfs:domain assertion, to total datatype properties (in subject namespace). Measures how well DT properties declare their subjects. Range [0.0, 1.0]."@en .

qc:DatatypePropertyUsageRate a owl:Class ;
    rdfs:label "DatatypePropertyUsageRate"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OE Pack v17.27.0 Challenge 1 — codify metrics that make L-47 dual-view AttrR + N's effects objectively measurable via SPARQL."@en ;
    rdfs:comment "Ratio of datatype properties (in subject namespace) that are actually used as predicates in at least one ABox triple, to total datatype properties (in subject namespace). Measures content coverage vs declared vocabulary. Range [0.0, 1.0]."@en ;
    rdfs:subClassOf qc:QualityMetric ;
    skos:definition "Ratio of datatype properties (in subject namespace) that are actually used as predicates in at least one ABox triple, to total datatype properties (in subject namespace). Measures content coverage vs declared vocabulary. Range [0.0, 1.0]."@en .

qc:DefectFinding a owl:Class ;
    rdfs:label "Defect Finding"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25040:2011 §7.3 - Analysis, Defect Identification" ;
    rdfs:comment "Indicates an error, inconsistency or violation."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35730.html> ;
    rdfs:subClassOf qc:Finding ;
    owl:disjointWith qc:GapFinding ;
    skos:definition """A type of finding that identifies errors, logical inconsistencies, constraint 
    violations, or incorrect content in an ontology. Defect findings indicate issues that affect 
    correctness and consistency, such as unsatisfiable classes, SHACL violations, failed test cases, 
    or reasoning inconsistencies."""@en ;
    skos:example """DefectFinding_UnsatisfiableClass: Identifies that class 'ProcessStep' is 
    unsatisfiable due to conflicting restrictions on property 'hasStatus'."""@en .

qc:EcosystemAttributeRichness a owl:Class ;
    rdfs:label "EcosystemAttributeRichness"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OE Pack v17.27.0 Challenge 1 — codify metrics that make L-47 dual-view AttrR + N's effects objectively measurable via SPARQL."@en ;
    rdfs:comment "OQuaRE-AttributeRichness variant that counts datatype properties with rdfs:domain ∈ subject classes (ecosystem-wide attribution), not just those declared in the subject namespace. Captures the L-47 dual-nature finding."@en ;
    rdfs:subClassOf qc:QualityMetric ;
    skos:definition "OQuaRE-AttributeRichness variant that counts datatype properties with rdfs:domain ∈ subject classes (ecosystem-wide attribution), not just those declared in the subject namespace. Captures the L-47 dual-nature finding."@en .

qc:Efficiency a owl:Class ;
    rdfs:label "Efficiency"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Duque-Ramos A. et al. (2013). Evaluation of the OQuaRE framework for ontology quality. Expert Systems with Applications 40, 2696-2703. PerformanceEfficiency characteristic; ISO/IEC 25010:2011 Systems and software engineering — SQuaRE — System and software quality models efficiency subcharacteristic; OE Pack v19.0.4 Phase F1 closure of named-attribute gap (Efficiency only present narrowly as PerformanceEfficiency). Added per Proposal F v1.0.0."@en ;
    rdfs:comment "A quality dimension under PerformanceEfficiency that evaluates the ratio of useful output to resources consumed by ontology operations. Generalises across reasoner efficiency (entailments computed per CPU-second), query efficiency (results returned per query-millisecond), and engineering efficiency (concepts modeled per author-hour). Distinguished from PerformanceEfficiency (which addresses raw resource consumption magnitude) by emphasising the ratio dimension — efficiency is about how much utility is obtained PER unit resource, not the absolute resource cost. Connected to ae:AlgorithmicEfficiencyConcept for algorithmic-complexity characterisation of ontology operations."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf qc:PerformanceEfficiency ;
    skos:definition "A quality dimension under PerformanceEfficiency that evaluates the ratio of useful output to resources consumed by ontology operations. Generalises across reasoner efficiency (entailments computed per CPU-second), query efficiency (results returned per query-millisecond), and engineering efficiency (concepts modeled per author-hour). Distinguished from PerformanceEfficiency (which addresses raw resource consumption magnitude) by emphasising the ratio dimension — efficiency is about how much utility is obtained PER unit resource, not the absolute resource cost. Connected to ae:AlgorithmicEfficiencyConcept for algorithmic-complexity characterisation of ontology operations."@en .

qc:EntropyOfClassGraph a owl:Class ;
    rdfs:label "Entropy of Class Graph"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Lantow, B. (2016) §3.2 OntoMetrics."@en ;
    rdfs:comment "Information-theoretic entropy of the class-graph degree distribution: H = -Σ p(d) log p(d) where p(d) is the probability that a randomly-chosen class has degree d. Captures structural diversity."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf measurement:CohesionMetric ;
    skos:definition "Information-theoretic entropy of the class-graph degree distribution: H = -Σ p(d) log p(d) where p(d) is the probability that a randomly-chosen class has degree d. Captures structural diversity."@en .

qc:Formalization a owl:Class ;
    rdfs:label "Formalization"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Lantow, B. (2016) §3.2 OntoMetrics."@en ;
    rdfs:comment "Degree to which an ontology commits to a formal logic profile: Formal = (axiom_count / triple_count) for ontologies in OWL 2 DL. Measures the ratio of logical axioms (subclass, disjointness, equivalence, property characteristics) to total triples."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf measurement:CorrectnessMetric ;
    skos:definition "Degree to which an ontology commits to a formal logic profile: Formal = (axiom_count / triple_count) for ontologies in OWL 2 DL. Measures the ratio of logical axioms (subclass, disjointness, equivalence, property characteristics) to total triples."@en .

qc:FunctionalAdequacy a owl:Class ;
    rdfs:label "Functional Adequacy"@en ;
    measurement:hasMeasurementSubject measurement:OntologyMeasurementSubject ;
    qc:hasMetric measurement:ANOnto,
        measurement:AROnto,
        measurement:CROnto,
        measurement:INROnto,
        measurement:NOMOnto,
        measurement:RROnto ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Duque-Ramos et al. (2011) §3.3 OQuaRE; ISO/IEC 25010:2023."@en ;
    rdfs:comment "OQuaRE characteristic: degree to which the ontology covers the intended domain functionality (competency questions answered, use cases supported, axioms expressing required constraints)."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf qc:QualityDimension ;
    skos:definition "OQuaRE characteristic: degree to which the ontology covers the intended domain functionality (competency questions answered, use cases supported, axioms expressing required constraints)."@en .

qc:FunctionalPitfall a owl:Class ;
    rdfs:label "Functional Pitfall"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Poveda-Villalón M., Gómez-Pérez A., Suárez-Figueroa M.C. (2014). OOPS! (OntOlogy Pitfall Scanner!): An On-line Tool for Ontology Evaluation. International Journal on Semantic Web and Information Systems 10(2), 7-34. Live catalogue fetched from https://oops.linkeddata.es/catalogue.jsp on 2026-05-19 with 41 pitfalls (P01-P41); paper documented 35 (P01-P35); catalogue expanded post-paper."@en ;
    rdfs:comment "A Pitfall affecting the functional dimension of an ontology — the suitability of the ontology for its intended purpose and domain coverage (e.g., missing domain information, polysemous elements, recursive definitions). Defined in Poveda-Villalón 2014."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf qc:Pitfall ;
    skos:definition "A Pitfall affecting the functional dimension of an ontology — the suitability of the ontology for its intended purpose and domain coverage (e.g., missing domain information, polysemous elements, recursive definitions). Defined in Poveda-Villalón 2014."@en .

qc:InheritanceRichness a owl:Class ;
    rdfs:label "Inheritance Richness"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Tartir, S. et al. (2005) §3.2.3 OntoQA schema metric."@en ;
    rdfs:comment "Schema metric measuring the average number of subclasses per class: IR = Σ|H_C| / |C| where H_C = direct subclasses of class C. Distinguishes horizontal vs vertical ontologies."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf measurement:SizeMetric ;
    skos:definition "Schema metric measuring the average number of subclasses per class: IR = Σ|H_C| / |C| where H_C = direct subclasses of class C. Distinguishes horizontal vs vertical ontologies."@en ;
    skos:example "IR(redo_v2_5_16.ttl) = 376 / 364 = 1.03."@en .

qc:Interoperability a owl:Class ;
    rdfs:label "Interoperability"@en ;
    qc:hasMetric measurement:AROnto,
        measurement:RROnto ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source <https://www.w3.org/TR/vocab-dcat-3/> ;
    rdfs:comment "The ability to integrate and exchange data with other systems."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35730.html> ;
    rdfs:subClassOf qc:PragmaticQuality ;
    skos:broader qc:PragmaticQuality ;
    skos:definition """A quality dimension that evaluates how easily the ontology can integrate 
    with other ontologies and systems. Interoperability is enhanced by standards compliance, 
    alignment mappings, common vocabulary usage, and machine-processable views."""@en ;
    skos:example """An interoperable ontology imports standard vocabularies (SKOS, DCTERMS), 
    provides alignment mappings to related ontologies, and exposes machine-processable RDF views."""@en ;
    skos:related qc:Reusability .

qc:NumberOfLeafClasses a owl:Class ;
    rdfs:label "Number of Leaf Classes"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Lantow, B. (2016) §3.1 OntoMetrics."@en ;
    rdfs:comment "Count of classes with no subclasses: NLeaf = |{c : ¬∃c'. c' rdfs:subClassOf c}|. High ratio of leaves indicates fine-grained terminal concepts."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf measurement:SizeMetric ;
    skos:definition "Count of classes with no subclasses: NLeaf = |{c : ¬∃c'. c' rdfs:subClassOf c}|. High ratio of leaves indicates fine-grained terminal concepts."@en .

qc:NumberOfRootClasses a owl:Class ;
    rdfs:label "Number of Root Classes"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Lantow, B. (2016) §3.1 OntoMetrics."@en ;
    rdfs:comment "Count of classes with no superclasses (or only owl:Thing as superclass): NRoot = |{c : c has no rdfs:subClassOf to a named class}|. High count indicates poor abstraction or modular design."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf measurement:SizeMetric ;
    skos:definition "Count of classes with no superclasses (or only owl:Thing as superclass): NRoot = |{c : c has no rdfs:subClassOf to a named class}|. High count indicates poor abstraction or modular design."@en .

qc:OOPSScanner a owl:Class ;
    rdfs:label "OOPS! Scanner"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Poveda-Villalon et al. (2014). OOPS! (OntOlogy Pitfall Scanner!): An On-line Tool for Ontology Evaluation. IJSWIS."@en ;
    rdfs:comment "A web-based quality analysis tool that scans OWL ontologies to detect common pitfalls and anti-patterns, providing automated identification of structural and semantic defects."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://doi.org/10.1007/s11280-013-0217-z>,
        <https://doi.org/10.3233/SW-130120> ;
    rdfs:subClassOf qc:QualityAnalyzer ;
    skos:definition "A web-based quality analysis tool that scans OWL ontologies to detect common pitfalls and anti-patterns, providing automated identification of structural and semantic defects."@en ;
    skos:example "OOPSScanner (oops.linkeddata.es) detects pitfall P08 (missing annotations) in ontologies. Running it on oqc_v2_2_0 before remediation flags 30 classes with no skos:example — an OOPS P08 severity warning."@en .

qc:OQuaREFramework a owl:Class ;
    rdfs:label "OQuaRE Framework"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Duque-Ramos, A., Fernández-Breis, J.T., Stevens, R., Aussenac-Gilles, N. (2011). OQuaRE: A SQuaRE-Based Approach for Evaluating the Quality of Ontologies. Journal of Research and Practice in Information Technology 43(2)."@en ;
    rdfs:comment "The Duque-Ramos 2011 SQuaRE-based ontology quality evaluation framework. Decomposes quality into 8 characteristics (Functional Adequacy, Reliability, Operability, Performance Efficiency, Compatibility, Maintainability, Transferability, Structural) each split into sub-characteristics, scored on a 1-5 ordinal scale per metric per role."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf qc:OntologyEvaluationFramework ;
    skos:definition "The Duque-Ramos 2011 SQuaRE-based ontology quality evaluation framework. Decomposes quality into 8 characteristics (Functional Adequacy, Reliability, Operability, Performance Efficiency, Compatibility, Maintainability, Transferability, Structural) each split into sub-characteristics, scored on a 1-5 ordinal scale per metric per role."@en .

qc:OQuaRETierWeightedRule a owl:Class ;
    rdfs:label "OQuaRE Tier-Weighted Rule"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Duque-Ramos et al. (2011) §3.5 OQuaRE composite."@en ;
    rdfs:comment "Specialised WeightedSumRule that separates Quality Core (binary defect dimensions) from Structural Profile (OQuaRE 1-5) and weights them differently per ontology role. The default 0.7/0.3 split is used in score_ontologies_v2.py."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf qc:WeightedSumRule ;
    skos:definition "Specialised WeightedSumRule that separates Quality Core (binary defect dimensions) from Structural Profile (OQuaRE 1-5) and weights them differently per ontology role. The default 0.7/0.3 split is used in score_ontologies_v2.py."@en .

qc:OntoQAFramework a owl:Class ;
    rdfs:label "OntoQA Framework"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Tartir, S., Arpinar, I.B., Moore, M., Sheth, A.P., Aleman-Meza, B. (2005). OntoQA: Metric-Based Ontology Quality Analysis. IEEE ICDM Workshop on Knowledge Acquisition from Distributed, Autonomous, Semantically Heterogeneous Data and Knowledge Sources."@en ;
    rdfs:comment "The Tartir 2005 metric-based ontology quality analysis framework. Defines schema metrics (Class/Relationship/Inheritance/Attribute Richness) and instance metrics (Class Importance, Connectivity, Fullness, Readability, Children Count) over an ontology graph."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf qc:OntologyEvaluationFramework ;
    skos:definition "The Tartir 2005 metric-based ontology quality analysis framework. Defines schema metrics (Class/Relationship/Inheritance/Attribute Richness) and instance metrics (Class Importance, Connectivity, Fullness, Readability, Children Count) over an ontology graph."@en .

qc:OntoQualityFramework a owl:Class ;
    rdfs:label "Ontology Quality Framework"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Duque-Ramos et al. (2011). OQuaRE: A SQuaRE-based approach for evaluating the quality of ontologies. Journal of Research and Practice in Information Technology."@en ;
    rdfs:comment "A quality analysis tool that evaluates ontologies against a comprehensive multi-dimensional quality framework, combining structural metrics, logical analysis, and annotation completeness."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-30203-2_5>,
        <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf qc:QualityAnalyzer ;
    skos:definition "A quality analysis tool that evaluates ontologies against a comprehensive multi-dimensional quality framework, combining structural metrics, logical analysis, and annotation completeness."@en ;
    skos:example "OntoQualityFramework evaluation of amod_v1_2_2.ttl: META score=98%, OQC score=77%, a reliability ontology score=100% — the overall framework score aggregates annotation, structural, and governance dimensions."@en .

qc:OntologyFileStructureCompliance a owl:Class ;
    rdfs:label "Ontology File Structure Compliance"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Authored in OQC v3.0.0 (2026-05-13) per user ruling. Implements the discipline first formalized in PROTOCOL-BINDING v1.0.3's B7 binding and now elevated to first-class quality criterion in OQC. The mechanical enforcement is in PROTOCOL-BINDING; this is the vocabulary classification."@en ;
    rdfs:comment "Quality criterion: an ontology artifact conforms to the 3-file canonical structure per BP-D18 (StructuralCanonicalForm). For each subject ontology, at most one TBox file + at most one ABox file + at most one SHACL file, all sharing the same owl:Ontology IRI per option-a discipline; no combined-form files, no extension/followup/patch files. Operationally enforced by a reliability ontology protocol binding B7 (ThreeFileCanonicalCheck) and B8 (FilenameIriAlignmentCheck). This criterion is the OQC-vocabulary anchor for the structural compliance discipline established across steps 1–14 of the OE Pack consolidation plan."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf qc:QualityCriterion ;
    skos:definition "Quality criterion: an ontology artifact conforms to the 3-file canonical structure per BP-D18 (StructuralCanonicalForm). For each subject ontology, at most one TBox file + at most one ABox file + at most one SHACL file, all sharing the same owl:Ontology IRI per option-a discipline; no combined-form files, no extension/followup/patch files. Operationally enforced by a reliability ontology protocol binding B7 (ThreeFileCanonicalCheck) and B8 (FilenameIriAlignmentCheck). This criterion is the OQC-vocabulary anchor for the structural compliance discipline established across steps 1–14 of the OE Pack consolidation plan."@en .

qc:QualityAssuranceProcess a owl:Class ;
    rdfs:label "Quality Assurance Process"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality requirements and evaluation (SQuaRE) — Product quality model."@en ;
    rdfs:comment "A systematic process for ensuring that ontology artifacts meet defined quality criteria through planned activities including testing, validation, review, and measurement."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35730.html>,
        <https://www.iso.org/standard/62085.html> ;
    rdfs:subClassOf core:Process ;
    skos:definition "A systematic process for ensuring that ontology artifacts meet defined quality criteria through planned activities including testing, validation, review, and measurement."@en ;
    skos:example "QualityAssuranceProcess for the OE package: Stage 0 pre-flight checks → pySHACL C4 gate → EmpiricalTest C5 gate → BlindSpot C7 enumeration → C8-OUT manifest verification."@en .

qc:QualityAssuranceSpecialist a owl:Class ;
    rdfs:label "Quality Assurance Specialist"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality requirements and evaluation (SQuaRE) — Product quality model."@en ;
    rdfs:comment "A specialized role responsible for establishing quality criteria, designing comprehensive test strategies, executing quality assessments, and mentoring team members on quality practices in ontology engineering."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35730.html>,
        <https://www.iso.org/standard/62085.html> ;
    rdfs:subClassOf core:Role ;
    owl:disjointWith qc:QualityAnalyzer ;
    skos:definition "A specialized role responsible for establishing quality criteria, designing comprehensive test strategies, executing quality assessments, and mentoring team members on quality practices in ontology engineering."@en ;
    skos:example "A QualityAssuranceSpecialist for the a reliability ontology ecosystem establishes the SHACL validation pipeline, authors the C5 mutation test harness, and certifies that all five ontologies achieve Conforms=True before sprint closure."@en .

qc:QualityPattern a owl:Class ;
    rdfs:label "Quality Pattern"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Gamma et al. (1994). Design Patterns: Elements of Reusable Object-Oriented Software. Addison-Wesley."@en ;
    rdfs:comment "A reusable solution template for addressing recurring quality assessment challenges in ontology engineering, encoding best practices for quality evaluation, testing, or validation."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-30203-2_5>,
        <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf qc:QualityConcept ;
    skos:definition "A reusable solution template for addressing recurring quality assessment challenges in ontology engineering, encoding best practices for quality evaluation, testing, or validation."@en ;
    skos:example "The 'annotation completeness' QualityPattern prescribes: every owl:Class MUST have rdfs:label + skos:definition + dcterms:source; violation detection via SHACL M2a/M2b/M2c shapes; fix via bulk rdflib patch script."@en .

qc:QualityRole a owl:Class ;
    rdfs:label "Quality Role"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality requirements and evaluation (SQuaRE) — Product quality model."@en ;
    rdfs:comment "A specialized role within ontology engineering focused on quality assessment, assurance, and control activities."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35730.html>,
        <https://www.iso.org/standard/62085.html> ;
    rdfs:subClassOf core:Role ;
    skos:definition "A specialized role within ontology engineering focused on quality assessment, assurance, and control activities."@en ;
    skos:example "The QualityRole of 'SHACL Shape Author' in the OE package involves writing and maintaining redo_shacl_v2_0_6.ttl's 22 NodeShapes, including rewriting SPARQL constraints for pySHACL compatibility."@en .

qc:RelationshipRichness a owl:Class ;
    rdfs:label "Relationship Richness"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Tartir, S. et al. (2005) §3.2.2 OntoQA schema metric."@en ;
    rdfs:comment "Schema metric measuring the diversity of relations in the schema: RR = |P| / (|H| + |P|) where P = non-inheritance relations (object properties) and H = inheritance relations (rdfs:subClassOf edges)."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf measurement:SizeMetric ;
    skos:definition "Schema metric measuring the diversity of relations in the schema: RR = |P| / (|H| + |P|) where P = non-inheritance relations (object properties) and H = inheritance relations (rdfs:subClassOf edges)."@en ;
    skos:example "RR(redo_v2_5_16.ttl) = 171 / (171 + 376) = 0.31."@en .

qc:SemanticQuality a owl:Class ;
    rdfs:label "Semantic Quality"@en ;
    measurement:hasMeasurementSubject measurement:OntologyMeasurementSubject ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Burton-Jones et al. (2005). A semiotic metrics suite for assessing the quality of ontologies. Data & Knowledge Engineering."@en ;
    rdfs:comment "A quality dimension assessing the meaningfulness and correctness of an ontology's semantic constructs, including proper use of axioms, appropriate domain/range constraints, and absence of semantic contradictions."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-30203-2_5>,
        <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf qc:QualityDimension ;
    skos:definition "A quality dimension assessing the meaningfulness and correctness of an ontology's semantic constructs, including proper use of axioms, appropriate domain/range constraints, and absence of semantic contradictions."@en ;
    skos:example "SemanticQuality assessment of meta_v6_2_0.ttl: all 600 skos:definition values were checked for tautology (label ≈ definition); 0 mechanical definitions found — SemanticQuality dimension passes ANTI-GAMING gate."@en .

qc:SocialQuality a owl:Class ;
    rdfs:label "Social Quality"@en ;
    measurement:hasMeasurementSubject measurement:OntologyMeasurementSubject ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Burton-Jones et al. (2005). A semiotic metrics suite for assessing the quality of ontologies. Data & Knowledge Engineering."@en ;
    rdfs:comment "A quality dimension assessing the degree to which an ontology meets the needs and expectations of its stakeholder community, including adoption, consensus, and collaborative development practices."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35730.html>,
        <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf qc:QualityDimension ;
    skos:definition "A quality dimension assessing the degree to which an ontology meets the needs and expectations of its stakeholder community, including adoption, consensus, and collaborative development practices."@en ;
    skos:example "SocialQuality dimension for OQC: evaluates whether the ontology is adopted by its target community. Indicator: oqc_shacl_v1_1_0.ttl is imported by redo_v2_5_5.ttl and referenced in the OE architecture guide."@en .

qc:StructuralCharacteristic a owl:Class ;
    rdfs:label "Structural Characteristic"@en ;
    measurement:hasMeasurementSubject measurement:OntologyMeasurementSubject ;
    qc:hasMetric measurement:LCOMOnto,
        measurement:RROnto,
        measurement:TMOnto ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Duque-Ramos et al. (2011) §3.3 OQuaRE."@en ;
    rdfs:comment "OQuaRE characteristic: structural properties of the ontology graph independent of its semantic content. Aggregates Tartir/OntoMetrics structural sub-metrics under a single OQuaRE-aligned umbrella."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf qc:QualityDimension ;
    skos:definition "OQuaRE characteristic: structural properties of the ontology graph independent of its semantic content. Aggregates Tartir/OntoMetrics structural sub-metrics under a single OQuaRE-aligned umbrella."@en .

qc:StructuralPitfall a owl:Class ;
    rdfs:label "Structural Pitfall"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Poveda-Villalón M., Gómez-Pérez A., Suárez-Figueroa M.C. (2014). OOPS! (OntOlogy Pitfall Scanner!): An On-line Tool for Ontology Evaluation. International Journal on Semantic Web and Information Systems 10(2), 7-34. Live catalogue fetched from https://oops.linkeddata.es/catalogue.jsp on 2026-05-19 with 41 pitfalls (P01-P41); paper documented 35 (P01-P35); catalogue expanded post-paper."@en ;
    rdfs:comment "A Pitfall affecting the structural dimension of an ontology — the formal organisation of classes, properties, and axioms (e.g., cycles in hierarchy, missing disjointness, wrong equivalent classes). Defined in Poveda-Villalón 2014."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf qc:Pitfall ;
    skos:definition "A Pitfall affecting the structural dimension of an ontology — the formal organisation of classes, properties, and axioms (e.g., cycles in hierarchy, missing disjointness, wrong equivalent classes). Defined in Poveda-Villalón 2014."@en .

qc:SyntaxQuality a owl:Class ;
    rdfs:label "Syntax Quality"@en ;
    measurement:hasMeasurementSubject measurement:OntologyMeasurementSubject ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Burton-Jones et al. (2005). A semiotic metrics suite for assessing the quality of ontologies. Data & Knowledge Engineering."@en ;
    rdfs:comment "A quality dimension assessing the syntactic correctness and well-formedness of an ontology's serialization, including conformance to the formal grammar of the representation language (OWL, RDF, etc.)."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html>,
        <https://www.w3.org/TR/owl2-syntax/> ;
    rdfs:subClassOf qc:QualityDimension ;
    skos:definition "A quality dimension assessing the syntactic correctness and well-formedness of an ontology's serialization, including conformance to the formal grammar of the representation language (OWL, RDF, etc.)."@en ;
    skos:example "SyntaxQuality gate for all OE package TTL files: rdflib g.parse() executes without exception for all 10 TTL files — SyntaxQuality passes C1 (Structural Integrity) for the complete package."@en .

qc:TaxonomicRichness a owl:Class ;
    rdfs:label "Taxonomic Richness"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Lantow, B. (2016) §3.1 OntoMetrics; aligned to Tartir 2005."@en ;
    rdfs:comment "Same as InheritanceRichness when restricted to rdfs:subClassOf edges only; OntoMetrics retains the alias for compatibility with pre-OntoQA literature."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf measurement:SizeMetric ;
    skos:definition "Same as InheritanceRichness when restricted to rdfs:subClassOf edges only; OntoMetrics retains the alias for compatibility with pre-OntoQA literature."@en .

qc:Transferability a owl:Class ;
    rdfs:label "Transferability"@en ;
    measurement:hasMeasurementSubject measurement:OntologyMeasurementSubject ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Duque-Ramos et al. (2011) §3.3 OQuaRE; ISO/IEC 25010:2023."@en ;
    rdfs:comment "OQuaRE characteristic: degree to which the ontology can be transferred from one environment to another — includes namespace stability, IRI dereferenceability, and serialisation portability."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf qc:QualityDimension ;
    skos:definition "OQuaRE characteristic: degree to which the ontology can be transferred from one environment to another — includes namespace stability, IRI dereferenceability, and serialisation portability."@en .

qc:Understandability a owl:Class ;
    rdfs:label "Understandability"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Duque-Ramos et al. (2011) §3.3 OQuaRE sub-characteristic."@en ;
    rdfs:comment "OQuaRE Operability sub-characteristic: degree to which the ontology can be understood by intended users without additional documentation. Measured primarily through annotation richness and structural depth."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf qc:Operability ;
    skos:definition "OQuaRE Operability sub-characteristic: degree to which the ontology can be understood by intended users without additional documentation. Measured primarily through annotation richness and structural depth."@en .

qc:UsabilityProfilingPitfall a owl:Class ;
    rdfs:label "UsabilityProfiling Pitfall"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Poveda-Villalón M., Gómez-Pérez A., Suárez-Figueroa M.C. (2014). OOPS! (OntOlogy Pitfall Scanner!): An On-line Tool for Ontology Evaluation. International Journal on Semantic Web and Information Systems 10(2), 7-34. Live catalogue fetched from https://oops.linkeddata.es/catalogue.jsp on 2026-05-19 with 41 pitfalls (P01-P41); paper documented 35 (P01-P35); catalogue expanded post-paper."@en ;
    rdfs:comment "A Pitfall affecting the usability-profiling dimension — how easily the ontology can be understood, navigated, and reused by humans and tools (e.g., missing annotations, inconsistent naming conventions, missing labels). Defined in Poveda-Villalón 2014."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf qc:Pitfall ;
    skos:definition "A Pitfall affecting the usability-profiling dimension — how easily the ontology can be understood, navigated, and reused by humans and tools (e.g., missing annotations, inconsistent naming conventions, missing labels). Defined in Poveda-Villalón 2014."@en .

qc:affectsDimension a owl:ObjectProperty ;
    rdfs:label "affects dimension"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:Finding ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:QualityDimension ;
    skos:definition "Associates a Finding with the QualityDimension it impacts, enabling dimension-level aggregation of quality issues for reporting and prioritization."@en ;
    skos:example "GapFinding_MissingDefinitions affectsDimension Completeness ."@en .

qc:appliesAggregationRule a owl:ObjectProperty ;
    rdfs:label "applies aggregation rule"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OQC v2.3.0."@en ;
    rdfs:domain qc:QualityAssessment ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:range measurement:AggregationRule ;
    skos:definition "Records which aggregation rule was used to compute a QualityAssessment's composite. REQUIRED for reproducibility — without this link, two assessments using different rules can show different composites for identical underlying measurements."@en .

qc:appliesTo a owl:ObjectProperty ;
    rdfs:label "applies to"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:QualityCriterion ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:OntologyArtifact ;
    skos:definition "Specifies which ontology artifact or component a quality criterion is meant to assess."@en .

qc:assessesArtifact a owl:ObjectProperty ;
    rdfs:label "assesses artifact"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en,
        "OQC v2.3.0 — formal-computation linkage extension."@en ;
    rdfs:comment "Links a quality assessment to the ontology artifact being assessed."@en ;
    rdfs:domain qc:QualityAssessment ;
    rdfs:isDefinedBy <http://example.org/quality>,
        <http://purl.org/oqc/ontology> ;
    rdfs:range core:Artifact ;
    skos:definition "Links a quality assessment to each artifact that is its subject: an ontology file and version, or any other subject the registration accepts. One assessment may assess several artifacts. This is the traceability between assessment results and the specific versions or components evaluated, and the v15.4 provenance chain requires it."@en ;
    skos:example "Assessment_2025_Q1 assessesArtifact OQC_v1.0.0 ."@en ;
    skos:scopeNote "Range widened OntologyArtifact->core:Artifact (v20.23.6, PAMG-surfaced): the registration hook must accept ANY subject type (ontology, document, code), matching OEE_Component_Compliance_Strategy §3. Previously OntologyArtifact-typed, which wrongly blocked document/code registration and would mis-infer non-ontology subjects as OntologyArtifact."@en .

qc:assessesClass a owl:ObjectProperty ;
    rdfs:label "assesses class"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:Finding ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:OntologyClass ;
    skos:definition "Associates a Finding with the specific OntologyClass it pertains to, enabling class-level quality issue tracking."@en .

qc:assessesFunctionalDimension a owl:ObjectProperty ;
    rdfs:label "assesses functional dimension"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:QualityAssessment ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range [ ] ;
    skos:definition "Associates a QualityAssessment with the specific functional quality dimensions it evaluates, including Completeness, Correctness, Comprehensiveness, Consistency, and Reliability."@en .

qc:assessesPragmaticDimension a owl:ObjectProperty ;
    rdfs:label "assesses pragmatic dimension"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:QualityAssessment ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range [ ] ;
    skos:definition "Associates a QualityAssessment with the specific pragmatic quality dimensions it evaluates, including Usability, Maintainability, Adaptability, Reusability, Interoperability, and Capacity."@en .

qc:assessesProperty a owl:ObjectProperty ;
    rdfs:label "assesses property"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:Finding ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:OntologyProperty ;
    skos:definition "Associates a Finding with the specific OntologyProperty it pertains to, enabling property-level quality issue tracking."@en .

qc:assessesStructuralDimension a owl:ObjectProperty ;
    rdfs:label "assesses structural dimension"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:QualityAssessment ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range [ ] ;
    skos:definition "Associates a QualityAssessment with the specific structural quality dimensions it evaluates, including Clarity, Conciseness, and Deepness."@en .

qc:belongsToDomain a owl:ObjectProperty ;
    rdfs:label "belongs to domain"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:QualityDomainEntity ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:QualityModel ;
    skos:definition "Associates any QualityDomainEntity with the QualityModel framework that provides its semantic context and evaluation criteria."@en .

qc:categorizedUnder a owl:ObjectProperty ;
    rdfs:label "categorized under"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:QualityDimension ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:QualityDimension ;
    skos:definition "Associates a leaf QualityDimension with its parent category dimension (FunctionalQuality, StructuralQuality, or PragmaticQuality) in the quality model hierarchy."@en .

qc:classifiesAs a owl:ObjectProperty ;
    rdfs:label "classifies as"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:Finding ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range [ ] ;
    skos:definition "Associates a Finding with its specific classification type, either GapFinding for missing content or DefectFinding for errors and violations."@en .

qc:computedBy a owl:ObjectProperty ;
    rdfs:label "computed by"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OQC v2.3.0 — formal-computation linkage extension."@en ;
    rdfs:domain measurement:Score ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:range measurement:MetricCalculation ;
    skos:definition "Links a Score to the MetricCalculation activity that produced it. Together with prov:wasGeneratedBy + prov:atTime this completes the provenance chain for a measurement: who computed it, when, and using which formula version."@en .

qc:configuresAssessment a owl:ObjectProperty ;
    rdfs:label "configures assessment"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain core:Stakeholder ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:AssessmentConfiguration ;
    skos:definition "Associates a Stakeholder with the AssessmentConfiguration parameters they define or maintain."@en .

qc:coverageRatio a owl:DatatypeProperty ;
    rdfs:label "coverage ratio"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en,
        "OE Pack v17.43.0 Option G — deprecation of DT property quality:coverageRatio per L-40 anti-gaming discipline. Was flagged DEFER-TO-G in v17.33.0 categorization (blank-node rdfs:domain). No direct replacement; review context-by-context."@en ;
    rdfs:comment """Per OE Pack v17.43.0 Option G: deprecated because rdfs:domain is a blank-node anonymous class expression rather than a named class. The original domain declaration referenced a SHACL-style property restriction encoded in OWL, making the intended subject class ambiguous and preventing principled instance authoring per L-49 design-intent extraction (executed in v17.33.0).

Per L-40 anti-gaming discipline: refusing to fabricate instances for inherently-ambiguous targets is honest. Instead of forcing 100% DT-Use via synthetic ABox, we deprecate these 5 properties and acknowledge them as DEFER-TO-G in the v17.33.0 instance authoring report.

Existing references SHOULD migrate; new ABox SHOULD NOT use this property."""@en,
        "The proportion of required elements that are present."@en ;
    rdfs:domain [ ] ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range xsd:decimal ;
    owl:deprecated true ;
    skos:definition """Specifies the ratio of covered elements to total required elements, 
    typically in [0,1] range. Used to quantify completeness and coverage metrics."""@en ;
    skos:example "Score_RequirementCoverage coverageRatio 0.87 ."@en .

qc:evaluatesDimension a owl:ObjectProperty ;
    rdfs:label "evaluates dimension"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain measurement:Metric ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:QualityDimension ;
    skos:definition "Associates a Metric with the specific QualityDimension it is designed to quantify, establishing traceability between measurements and quality characteristics."@en ;
    skos:example "DefinitionCoverageMetric evaluatesDimension Completeness ."@en .

qc:evidenceSupports a owl:ObjectProperty ;
    rdfs:label "evidence supports"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:Evidence ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:Finding ;
    skos:definition "Associates an Evidence artifact with the Finding it supports, providing the inverse path from evidence to the quality issue it substantiates."@en .

qc:evidencedBy a owl:ObjectProperty ;
    rdfs:label "evidenced by"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:comment "Links a finding or score to supporting evidence."@en ;
    rdfs:domain [ ] ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:Evidence ;
    skos:definition """Connects a Finding or Score to the concrete Evidence artifact that supports it. 
    Evidence provides verifiable justification for quality assessments and ensures reproducibility 
    and auditability."""@en ;
    skos:example "Score_Completeness_87 evidencedBy Evidence_SPARQL_RequirementCoverage ."@en .

qc:executesActivity a owl:ObjectProperty ;
    rdfs:label "executes activity"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain core:Stakeholder ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:AssessmentActivity ;
    skos:definition "Associates a Stakeholder with the AssessmentActivity they perform or are responsible for executing."@en .

qc:fulfillsRequirement a owl:ObjectProperty ;
    rdfs:label "fulfills requirement"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain core:CompetencyQuestion ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range kb:FunctionalRequirement ;
    skos:definition "Associates a CompetencyQuestion with the FunctionalRequirement it is designed to operationalize and verify through query execution."@en .

qc:gateProducesDecision a owl:ObjectProperty ;
    rdfs:label "gate produces decision"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:QualityGate ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:GateDecision ;
    skos:definition "Associates a QualityGate checkpoint with the GateDecision it produces after evaluating metrics against configured thresholds."@en .

qc:gateUsesConfig a owl:ObjectProperty ;
    rdfs:label "gate uses config"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:QualityGate ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:GateConfig ;
    skos:definition "Associates a QualityGate with the GateConfig that specifies its threshold values and metric weight parameters."@en .

qc:hasChangeLog a owl:ObjectProperty ;
    rdfs:label "has change log"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:comment "Links an ontology artifact to its change history."@en ;
    rdfs:domain qc:OntologyArtifact ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:ChangeLog ;
    skos:definition """Associates an OntologyArtifact with its ChangeLog documenting modifications 
    over time. Change logs support adaptability assessment, impact analysis, and understanding of 
    ontology evolution patterns."""@en ;
    skos:example "OQC_Ontology hasChangeLog ChangeLog_OQC_2025 ."@en .

qc:hasCriterion a owl:ObjectProperty ;
    rdfs:label "has criterion"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:QualityDimension ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:QualityCriterion ;
    skos:definition "Associates a quality dimension with the quality criteria that define measurable aspects within it, replacing the previous subclass modeling with a compositional relationship."@en .

qc:hasDimension a owl:ObjectProperty ;
    rdfs:label "has dimension"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:QualityModel ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:QualityDimension ;
    skos:definition "Associates a QualityModel with the QualityDimensions it organizes and evaluates as part of the overall quality assessment framework."@en ;
    skos:example "OQC_QualityModel hasDimension Completeness, Correctness, Usability ."@en .

qc:hasFinding a owl:ObjectProperty ;
    rdfs:label "has finding"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:comment "Links an assessment to identified quality findings."@en ;
    rdfs:domain qc:QualityAssessment ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:Finding ;
    owl:inverseOf qc:isFindingOf ;
    skos:definition """Associates a QualityAssessment with the Findings (gaps or defects) identified 
    during the assessment process. Findings represent specific quality issues that require attention 
    or remediation."""@en ;
    skos:example "Assessment_2025_Q1 hasFinding GapFinding_ClassDoc_001, DefectFinding_Inconsistency_003 ."@en .

qc:hasFunctionalCategory a owl:ObjectProperty ;
    rdfs:label "has functional category"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:QualityModel ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:FunctionalQuality ;
    skos:definition "Associates a QualityModel with its FunctionalQuality category grouping dimensions that assess functional fitness."@en .

qc:hasGate a owl:ObjectProperty ;
    rdfs:label "has gate"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:QualityAssessment ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:QualityGate ;
    skos:definition "Associates a QualityAssessment with the QualityGate decision checkpoint that determines whether the assessed artifact meets minimum quality standards."@en ;
    skos:example "Assessment_Phase2 hasGate QualityGate_Phase2_Release ."@en .

qc:hasMetric a owl:ObjectProperty ;
    rdfs:label "has metric"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Sprint F4 (2026-05-14): property declared from raw usage analysis (domain/range inferred per BP-D2 from existing ABox patterns). Per L-47v2: full skos:definition included."@en ;
    rdfs:domain qc:QualityAssessment ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:range qc:QualityMetric ;
    skos:definition "Links a QualityAssessment to the QualityMetric individuals computed as part of the assessment. An assessment may compute multiple metrics; each metric in turn has a Score (via hasScore). Per Sprint F4."@en .

qc:hasNormalizationRule a owl:ObjectProperty ;
    rdfs:label "has normalization rule"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    rdfs:domain measurement:Score ;
    rdfs:isDefinedBy <http://example.org/oqc/v2_4_0_metric_kind_extension> ;
    rdfs:range qc:NormalizationRule ;
    skos:definition "Links a qc:Score to the qc:NormalizationRule used to normalize its raw value. OPTIONAL. Absent on most Scores."@en .

qc:hasPragmaticCategory a owl:ObjectProperty ;
    rdfs:label "has pragmatic category"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:QualityModel ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:PragmaticQuality ;
    skos:definition "Associates a QualityModel with its PragmaticQuality category grouping dimensions that assess practical applicability."@en .

qc:hasPriority a owl:ObjectProperty ;
    rdfs:label "has priority"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:Finding ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:PriorityLevel ;
    skos:definition "Associates a Finding with its PriorityLevel classification indicating the urgency of remediation based on severity and implementation complexity."@en ;
    skos:example "GapFinding_MissingDefinitions hasPriority PriorityLevel_P2_High ."@en .

qc:hasQualityCriterion a owl:ObjectProperty ;
    rdfs:label "has quality criterion"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:QualityDimension ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:QualityCriterion ;
    skos:definition "Associates a QualityDimension with the specific QualityCriteria that define measurable aspects within that dimension."@en .

qc:hasRecommendation a owl:ObjectProperty ;
    rdfs:label "has recommendation"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:Finding ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:Recommendation ;
    skos:definition "Associates a Finding with one or more Recommendations that propose specific remediation actions to address the identified quality issue."@en ;
    skos:example "DefectFinding_UnsatisfiableClass hasRecommendation Recommendation_RemoveConflictingAxiom ."@en .

qc:hasReliabilityCharacteristic a owl:ObjectProperty ;
    rdfs:label "has reliability characteristic"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:Reliability ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:QualityDimension ;
    skos:definition "Associates the Reliability dimension with its sub-characteristics including Availability, FaultTolerance, Recoverability, and Faultlessness."@en .

qc:hasReliabilitySubCharacteristic a owl:ObjectProperty ;
    rdfs:label "has reliability sub-characteristic"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:Reliability ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range [ ] ;
    skos:definition "Associates the Reliability dimension with its ISO 25010 sub-characteristics: Availability, FaultTolerance, Recoverability, and Faultlessness."@en .

qc:hasSPARQLImplementation a owl:DatatypeProperty ;
    rdfs:label "has SPARQL implementation"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OQC v2.3.0 — formal-computation linkage extension (2026-05-04)."@en ;
    rdfs:domain measurement:Metric ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:range xsd:string ;
    skos:definition "Provides the SPARQL 1.1 SELECT query whose execution against an ontology graph computes the metric's raw numeric value. Stored as a literal string so that it is portable across triple stores and inspectable as data. Closes the gap where v2.2.5 had metric vocabulary but no executable definition."@en ;
    skos:example "qc:InheritanceRichness qc:hasSPARQLImplementation 'SELECT (xsd:decimal(?n_sub) / xsd:decimal(?n_class) AS ?ir) WHERE { { SELECT (COUNT(DISTINCT ?p) AS ?n_class) WHERE { ?p a owl:Class . FILTER(isIRI(?p)) } } { SELECT (COUNT(?h) AS ?n_sub) WHERE { ?h rdfs:subClassOf ?super . FILTER(isIRI(?h) && isIRI(?super)) } } }'."@en .

qc:hasScore a owl:ObjectProperty ;
    rdfs:label "has score"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Sprint F4 (2026-05-14): property declared from raw usage analysis (domain/range inferred per BP-D2 from existing ABox patterns). Per L-47v2: full skos:definition included."@en ;
    rdfs:domain measurement:Measurement ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:range qc:Score ;
    skos:definition "Links a measurement individual (typically a QualityMetric instance) to a Score individual capturing the measurement result. Per L-43: the Score carries the normalized [0,1] value per quality:ScoreClosedShape; raw values live on the MeasurementBinding. Per Sprint F4."@en .

qc:hasSeverity a owl:ObjectProperty ;
    rdfs:label "has severity"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:Finding ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range core:SeverityLevel ;
    skos:definition "Associates a Finding with its SeverityLevel classification indicating the magnitude of impact on ontology quality fitness for purpose."@en ;
    skos:example "DefectFinding_UnsatisfiableClass hasSeverity SeverityLevel_Critical ."@en .

qc:hasStakeholder a owl:ObjectProperty ;
    rdfs:label "has stakeholder"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:QualityAssessment ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range core:Stakeholder ;
    skos:definition "Associates a QualityAssessment with the Stakeholders who are interested in, affected by, or responsible for the assessment results and remediation actions."@en ;
    skos:example "Assessment_2025 hasStakeholder Stakeholder_DomainExpert, Stakeholder_OntologyDeveloper ."@en .

qc:hasStructuralCategory a owl:ObjectProperty ;
    rdfs:label "has structural category"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:QualityModel ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:StructuralQuality ;
    skos:definition "Associates a QualityModel with its StructuralQuality category grouping dimensions that assess internal architecture."@en .

qc:hasSubDimension a owl:ObjectProperty ;
    rdfs:label "has sub-dimension"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:QualityDimension ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:QualityDimension ;
    skos:definition "Associates a QualityDimension with its child sub-dimensions in the quality model hierarchy, such as Reliability having FaultTolerance and Recoverability as sub-dimensions."@en .

qc:hasTermDefinition a owl:ObjectProperty ;
    rdfs:label "has term definition"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:OntologyArtifact ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:TermDefinition ;
    skos:definition "Associates an OntologyArtifact with its TermDefinitions that map domain vocabulary to formal ontology components."@en .

qc:hasTestSuite a owl:ObjectProperty ;
    rdfs:label "has test suite"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:OntologyArtifact ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:TestSuite ;
    skos:definition "Associates an OntologyArtifact with the TestSuite used to verify its quality through systematic test execution."@en .

qc:hasThresholdValue a owl:DatatypeProperty ;
    rdfs:label "has threshold value"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:QualityCriterion ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range xsd:decimal ;
    skos:definition "Defines the minimum acceptable numeric value for a quality criterion to be satisfied."@en ;
    skos:example "Completeness_Criterion hasThresholdValue 0.90 ."@en .

qc:hasVersion a owl:ObjectProperty ;
    rdfs:label "has version"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:comment "Links an ontology artifact to its version information."@en ;
    rdfs:domain qc:OntologyArtifact ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range core:Version ;
    rdfs:subPropertyOf core:hasVersion ;
    skos:definition """Associates an OntologyArtifact with its Version metadata, supporting version 
    tracking, comparison, and evolution management. Versions enable temporal queries and rollback 
    capabilities."""@en ;
    skos:example "OQC_Ontology hasVersion Version_1.0.0 ."@en .

qc:identifiesCoverageGap a owl:ObjectProperty ;
    rdfs:label "identifies coverage gap"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:QualityAssessment ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:CoverageGap ;
    skos:definition "Associates a QualityAssessment with CoverageGap findings that quantify missing test or requirement coverage."@en .

qc:implementsModel a owl:ObjectProperty ;
    rdfs:label "implements model"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:OntologyArtifact ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range meta:SymbioticOntologyModel ;
    skos:definition "Associates an OntologyArtifact with the SymbioticOntologyModel architecture it implements, indicating dual-layer design."@en .

qc:informsDecision a owl:ObjectProperty ;
    rdfs:label "informs decision"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain measurement:QualityMetric ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:GateDecision ;
    skos:definition "Relates a quality metric to the engineering decision or activity it informs."@en .

qc:involvesStakeholder a owl:ObjectProperty ;
    rdfs:label "involves stakeholder"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:QualityModel ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range core:Stakeholder ;
    skos:definition "Associates a QualityModel with the Stakeholders whose quality concerns the model is designed to address."@en .

qc:isAboutComponent a owl:ObjectProperty ;
    rdfs:label "is about component"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:comment "Links a finding to the ontology component it relates to."@en ;
    rdfs:domain qc:Finding ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:OntologyComponent ;
    skos:definition """Associates a Finding with the specific OntologyComponent (class, property, 
    axiom, etc.) that is the subject of the finding. This enables precise localization of quality 
    issues for remediation."""@en ;
    skos:example "DefectFinding_UnsatisfiableClass isAboutComponent :ProcessStep ."@en .

qc:isAboutRequirement a owl:ObjectProperty ;
    rdfs:label "is about requirement"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:comment "Links a finding to the requirement it relates to."@en ;
    rdfs:domain qc:Finding ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:Requirement ;
    skos:definition """Establishes traceability between a Finding and the Requirement it pertains to. 
    This property enables impact analysis by showing which requirements are affected by identified 
    quality issues."""@en ;
    skos:example "GapFinding_CQ_Coverage isAboutRequirement FR_045_QueryInterface ."@en .

qc:isConceptIn a owl:ObjectProperty ;
    rdfs:label "is concept in"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:QualityConcept ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:QualityModel ;
    skos:definition "Associates a QualityConcept with the QualityModel framework that provides its semantic context."@en .

qc:isScoreOf a owl:ObjectProperty ;
    rdfs:label "is score of"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Sprint F4 (2026-05-14): property declared from raw usage analysis (domain/range inferred per BP-D2 from existing ABox patterns). Per L-47v2: full skos:definition included."@en ;
    rdfs:domain qc:Score ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:range qc:QualityMetric ;
    skos:definition "Inverse-of hasScore. Links a Score back to the measurement it scores. Per Sprint F4: 5 usages on MeasurementSnapshot and Score individuals."@en .

qc:measuresCriterion a owl:ObjectProperty ;
    rdfs:label "measures criterion"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Sprint F4 (2026-05-14): property declared from raw usage analysis (domain/range inferred per BP-D2 from existing ABox patterns). Per L-47v2: full skos:definition included."@en ;
    rdfs:domain measurement:Measurement ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:range qc:QualityCriterion ;
    skos:definition "Links a QualityMetric to the QualityCriterion or QualityDimension it measures. Range includes QualityDimension subclasses (Reliability, StructuralCharacteristic, etc.) and QualityCriterion individuals. Per Sprint F4 (2026-05-14): 42 usages declared this implicitly; declaration now formalizes the property."@en .

qc:missingCount a owl:DatatypeProperty ;
    rdfs:label "missing count"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en,
        "OE Pack v17.43.0 Option G — deprecation of DT property quality:missingCount per L-40 anti-gaming discipline. Was flagged DEFER-TO-G in v17.33.0 categorization (blank-node rdfs:domain). No direct replacement; review context-by-context."@en ;
    rdfs:comment """Per OE Pack v17.43.0 Option G: deprecated because rdfs:domain is a blank-node anonymous class expression rather than a named class. The original domain declaration referenced a SHACL-style property restriction encoded in OWL, making the intended subject class ambiguous and preventing principled instance authoring per L-49 design-intent extraction (executed in v17.33.0).

Per L-40 anti-gaming discipline: refusing to fabricate instances for inherently-ambiguous targets is honest. Instead of forcing 100% DT-Use via synthetic ABox, we deprecate these 5 properties and acknowledge them as DEFER-TO-G in the v17.33.0 instance authoring report.

Existing references SHOULD migrate; new ABox SHOULD NOT use this property."""@en,
        "The number of missing or absent elements."@en ;
    rdfs:domain [ ] ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range xsd:integer ;
    owl:deprecated true ;
    skos:definition """Specifies the count of missing elements identified in a gap finding. 
    Provides quantitative information about the extent of incompleteness."""@en ;
    skos:example "GapFinding_ClassDoc missingCount 12 ."@en .

qc:normalizationFormula a owl:DatatypeProperty ;
    rdfs:label "normalization formula"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    rdfs:domain qc:NormalizationRule ;
    rdfs:isDefinedBy <http://example.org/oqc/v2_4_0_metric_kind_extension> ;
    rdfs:range xsd:string ;
    skos:definition "A precise textual or executable expression describing how to map a raw value to a normalized Score (e.g., 'log10(raw + 1) / log10(maxExpected + 1)')."@en .

qc:notes a owl:DatatypeProperty ;
    rdfs:label "notes"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en,
        "OE Pack v17.43.0 Option G — deprecation of DT property quality:notes per L-40 anti-gaming discipline. Was flagged DEFER-TO-G in v17.33.0 categorization (blank-node rdfs:domain). No direct replacement; review context-by-context."@en ;
    rdfs:comment """Per OE Pack v17.43.0 Option G: deprecated because rdfs:domain is a blank-node anonymous class expression rather than a named class. The original domain declaration referenced a SHACL-style property restriction encoded in OWL, making the intended subject class ambiguous and preventing principled instance authoring per L-49 design-intent extraction (executed in v17.33.0).

Per L-40 anti-gaming discipline: refusing to fabricate instances for inherently-ambiguous targets is honest. Instead of forcing 100% DT-Use via synthetic ABox, we deprecate these 5 properties and acknowledge them as DEFER-TO-G in the v17.33.0 instance authoring report.

Existing references SHOULD migrate; new ABox SHOULD NOT use this property."""@en,
        "Textual notes or comments."@en ;
    rdfs:domain [ ] ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range xsd:string ;
    owl:deprecated true ;
    skos:definition """Provides free-text notes, comments, or additional context for findings, 
    scores, decisions, or evidence. Notes support human understanding and communication of 
    assessment details."""@en ;
    skos:example "GateDecision_Phase2 notes 'Passed with minor documentation gaps to be addressed in Phase 3.' ."@en .

qc:overallQualityOf a owl:ObjectProperty ;
    rdfs:label "overall quality of"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:OverallQuality ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:OntologyArtifact ;
    skos:definition "Associates an OverallQuality composite score with the OntologyArtifact whose aggregate quality it represents."@en .

qc:passesGate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "passes gate"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:comment "Boolean indicating whether quality gate passed."@en ;
    rdfs:domain qc:GateDecision ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition """Indicates whether a quality gate has been passed (true) or failed (false) 
    based on evaluation of metrics against gate configuration thresholds."""@en ;
    skos:example "GateDecision_Phase2 passesGate true ."@en .

qc:priorityRank a owl:DatatypeProperty ;
    rdfs:label "priority rank"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:PriorityLevel ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range xsd:integer ;
    skos:definition "The ordinal rank of a PriorityLevel where lower values indicate higher urgency (1=Immediate, 2=High, 3=Medium, 4=Backlog)."@en .

qc:producesReport a owl:ObjectProperty ;
    rdfs:label "produces report"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:QualityAssessment ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:QualityReport ;
    skos:definition "Associates a QualityAssessment with the QualityReport it generates as a documented deliverable of the evaluation process."@en .

qc:receivesOutput a owl:ObjectProperty ;
    rdfs:label "receives output"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain core:Stakeholder ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:AssessmentOutput ;
    skos:definition "Associates a Stakeholder with the AssessmentOutput deliverables they consume or act upon."@en .

qc:recommendationText a owl:DatatypeProperty ;
    rdfs:label "recommendation text"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:Recommendation ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range xsd:string ;
    skos:definition "The textual description of a Recommendation specifying the remediation action to take in response to a quality finding."@en .

qc:severityRank a owl:DatatypeProperty ;
    rdfs:label "severity rank"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain core:SeverityLevel ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range xsd:integer ;
    skos:definition "The ordinal rank of a SeverityLevel where lower values indicate higher severity (1=Critical, 2=High, 3=Medium, 4=Low)."@en .

qc:threshold a owl:DatatypeProperty ;
    rdfs:label "threshold"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en,
        "OE Pack v17.43.0 Option G — deprecation of DT property quality:threshold per L-40 anti-gaming discipline. Was flagged DEFER-TO-G in v17.33.0 categorization (blank-node rdfs:domain). Recommended replacement: <http://example.org/quality#thresholdValue>."@en ;
    rdfs:comment """Per OE Pack v17.43.0 Option G: deprecated because rdfs:domain is a blank-node anonymous class expression rather than a named class. The original domain declaration referenced a SHACL-style property restriction encoded in OWL, making the intended subject class ambiguous and preventing principled instance authoring per L-49 design-intent extraction (executed in v17.33.0).

Per L-40 anti-gaming discipline: refusing to fabricate instances for inherently-ambiguous targets is honest. Instead of forcing 100% DT-Use via synthetic ABox, we deprecate these 5 properties and acknowledge them as DEFER-TO-G in the v17.33.0 instance authoring report.

Existing references SHOULD migrate; new ABox SHOULD NOT use this property."""@en,
        "The minimum acceptable value for pass/fail evaluation."@en ;
    rdfs:domain [ ] ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso qc:thresholdValue ;
    owl:deprecated true ;
    skos:definition """Defines the minimum acceptable value for a metric or gate configuration. 
    Scores below the threshold indicate failure requiring remediation."""@en ;
    skos:example "GateConfig_Phase2 threshold 0.90 ."@en ;
    skos:related qc:thresholdValue .

qc:usesModel a owl:ObjectProperty ;
    rdfs:label "uses model"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:QualityAssessment ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:QualityModel ;
    skos:definition "Associates a QualityAssessment with the QualityModel that defines which dimensions are evaluated and how scores are weighted and aggregated."@en ;
    skos:example "Assessment_Phase2 usesModel OQC_QualityModel_v1 ."@en .

qc:verifiesCompetencyQuestion a owl:ObjectProperty ;
    rdfs:label "verifies competency question"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:comment "Links a test case to the competency question it verifies."@en ;
    rdfs:domain qc:TestCase ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range core:CompetencyQuestion ;
    skos:definition """Associates a TestCase with the CompetencyQuestion it is designed to verify. 
    This property establishes traceability between test cases and requirements, enabling coverage 
    analysis and validation that competency questions are adequately tested."""@en ;
    skos:example "TestCase_CQ_045 verifiesCompetencyQuestion CQ_045_RetrieveRequirements ."@en .

qc:weight a owl:DatatypeProperty ;
    rdfs:label "weight"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en,
        "OE Pack v17.43.0 Option G — deprecation of DT property quality:weight per L-40 anti-gaming discipline. Was flagged DEFER-TO-G in v17.33.0 categorization (blank-node rdfs:domain). No direct replacement; review context-by-context."@en ;
    rdfs:comment """Per OE Pack v17.43.0 Option G: deprecated because rdfs:domain is a blank-node anonymous class expression rather than a named class. The original domain declaration referenced a SHACL-style property restriction encoded in OWL, making the intended subject class ambiguous and preventing principled instance authoring per L-49 design-intent extraction (executed in v17.33.0).

Per L-40 anti-gaming discipline: refusing to fabricate instances for inherently-ambiguous targets is honest. Instead of forcing 100% DT-Use via synthetic ABox, we deprecate these 5 properties and acknowledge them as DEFER-TO-G in the v17.33.0 instance authoring report.

Existing references SHOULD migrate; new ABox SHOULD NOT use this property."""@en,
        "The weight coefficient for aggregating scores."@en ;
    rdfs:domain [ ] ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range xsd:decimal ;
    owl:deprecated true ;
    skos:definition """Specifies the weight coefficient used when aggregating multiple scores into 
    an overall quality score. Weights should sum to 1.0 and represent the relative importance of 
    each dimension or metric."""@en ;
    skos:example "CompletenessMetric weight 0.25 ; CorrectnessMetric weight 0.30 ."@en .

reliability:AccountableHumanProtocol a owl:Class ;
    rdfs:label "Accountable Human Protocol"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Gemini behavioral pathology report: T3 Accountable Human control" ;
    rdfs:comment """Named reviewer with counter-review checklist who is
    personally accountable for verification decisions. Distinguished from
    generic code review: the accountable human must verify against specific
    BehaviorConcerns using defined EmpiricalTests, not just assess code
    quality subjectively. Part of VECTR T3 control."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf reliability:VerificationMethod ;
    skos:definition """Verification protocol requiring a named human reviewer
    who is personally accountable for verifying LLM output against specified
    BehaviorConcerns using defined EmpiricalTests and a structured
    counter-review checklist"""@en ;
    skos:example "Pre-deployment checklist requiring sign-off from reliability, security, and product leads."@en .

reliability:Adaptability a owl:Class ;
    rdfs:label "Adaptability"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://www.iso.org/standard/78176.html> ;
    rdfs:comment "Related to but distinct from Flexibility in ISO 25010"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:QualityCharacteristic ;
    owl:equivalentClass qc:Adaptability ;
    skos:definition "Adaptability is a quality characteristic that measures the degree to which a system can be effectively modified, configured, or extended to accommodate changing requirements, environments, or operational contexts."@en ;
    skos:example "Configuration-driven feature flags enabling runtime behavior changes without code deployment."@en .

reliability:AgingRelatedBug a owl:Class ;
    rdfs:label "Aging-Related Bug"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "IEEE 1633-2016 Recommended Practice on Software Reliability."@en ;
    rdfs:comment """Faults that manifest after prolonged operation due to resource exhaustion, 
    memory fragmentation, accumulation of errors, or numerical precision degradation."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/50641.html> ;
    rdfs:subClassOf reliability:Mandelbug ;
    skos:altLabel "Software Aging Fault"@en ;
    skos:definition "A fault that accumulates over time due to resource degradation, memory leaks, or state corruption"@en ;
    skos:example "Memory fragmentation bug only manifests after 30+ days of continuous uptime as heap becomes increasingly fragmented."@en .

reliability:ArchitecturalCoherenceScore a owl:Class ;
    rdfs:label "Architectural Coherence Score"@en ;
    reliability:hasUnit "ratio (0.0 to 1.0)" ;
    reliability:measuresAttribute reliability:ArchitecturalDrift ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "LoCoBench: ACS metric for constraint consistency" ;
    rdfs:comment """Adapted from LoCoBench ACS metric. Measures the degree
    to which LLM-generated code maintains consistency with established
    architectural constraints within a single session. Calculated by
    comparing generated artifacts against a reference constraint set.
    Inversely related to architectural drift severity."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf reliability:LLMReliabilityMetric ;
    skos:definition """Degree to which LLM-generated artifacts maintain
    consistency with established architectural constraints, measuring
    coherence between generated code and the specified design decisions
    within a development session"""@en ;
    skos:example "An ACS of 0.75 indicates that 75% of code generated follows the specified architectural patterns, while 25% introduces inconsistent structures."@en .

reliability:ArmsRaceDynamic a owl:Class ;
    rdfs:label "Arms-Race Dynamic"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NEEDS_EXPERT_REVIEW: a reliability ontology-native empirical pattern (v2.0.6–v2.2.0). Metaphor from evolutionary biology arms race (Dawkins & Krebs, 1979)."@en ;
    rdfs:comment """The empirical pattern where framework improvements 
    create step-function detection gains for KNOWN (formalized) failure 
    categories, but each newly discovered failure category initially 
    presents at ~0% autonomous detection until formally codified. 
    Observed trajectory: v2.0.6(20%) -> v2.0.7(100%, N=12, 95% CI 
    lower bound 73.5%) -> v2.1.0(0%, new assessor category) -> 
    v2.2.0(100%, N=2). The cycle: formalize failure category -> detect 
    effectively -> discover new category -> 0% detection -> formalize 
    -> detect -> ... This pattern implies that reliability engineering 
    is an ongoing process, not a one-time framework deployment. No 
    framework version achieves permanent comprehensive coverage."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf reliability:MetaReliability ;
    skos:definition """The empirical pattern where framework improvements 
    create step-function detection gains for KNOWN (formalized) failure 
    categories, but each newly discovered failure category initially 
    presents at ~0% autonomous detection until formally codified. 
    Observed trajectory: v2.0.6(20%) -> v2.0.7(100%, N=12, 95% CI 
    lower bound 73.5%) -> v2.1.0(0%, new assessor category) -> 
    v2.2.0(100%, N=2). The cycle: formalize failure category -> detect 
    effectively -> discover new category -> 0% detection -> formalize 
    -> detect -> ... This pattern implies that reliability engineering 
    is an ongoing process, not a one-time framework deployment. No 
    framework version achieves permanent comprehensive coverage."""@en ;
    skos:example "v2.0.7 introduced stage-gates and caught 12/12 known failures. Then v2.1.0 discovered assessor cognitive biases — a new category — and caught 0/3 autonomously. v2.2.0 formalized these biases and caught 2/2."@en .

reliability:ArtifactComplianceDepth a owl:Class ;
    rdfs:label "Artifact Compliance Depth"@en ;
    measurement:hasMeasurementSubject measurement:LLMMeasurementSubject ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Practice observed in oepack-com4061-ch6-quality-assessment-v1_0_0 and oepack-com4061-ch6-ecosystem-native-quality-assessment-v1_0_0 where redo:ComplianceDepth was extended from LLM-output scope to ontology-artifact scope ad-hoc. This class formalizes the practice. Proposal: oepack-oe-enhancements-proposal-v1_0_0 O3 (Option b)."@en ;
    rdfs:comment "ComplianceDepth specialized for ontology artifact / deliverable maturity assessment. Levels: L1 Ritual (labels and class declarations only), L2 Procedural (template structure + checks executed but no verification), L3 Substantive (sources cited + verification means present), L4 Verified (SHACL conforms + reasoner consistent + audit log + manifest)."@en ;
    rdfs:isDefinedBy <http://example.org/reliability/v2_11_0_compliance_depth_taxonomy> ;
    rdfs:subClassOf reliability:ComplianceDepth ;
    skos:definition "ComplianceDepth specialized for ontology artifact / deliverable maturity assessment. Levels: L1 Ritual (labels and class declarations only), L2 Procedural (template structure + checks executed but no verification), L3 Substantive (sources cited + verification means present), L4 Verified (SHACL conforms + reasoner consistent + audit log + manifest)."@en ;
    skos:example "A TBox+ABox+SHACL trio with HermiT-CONSISTENT + SHACL V=0 + closure document + BP-D8 manifest = L4_Verified."@en .

reliability:AssessorBiasCompound a owl:Class ;
    rdfs:label "Assessor Bias Compound"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Forensic analysis of GamifyOnt/G4E validation conversation, February 2026."@en ;
    rdfs:comment """A compound failure mode where multiple assessor cognitive biases 
    interact and reinforce each other in a single assessment session. The 
    canonical pattern is:
    
    1. CompetenceParadox → capability exists but dormant
    2. EffortAvoidanceBias → rationalizes non-attempt as impossibility  
    3. NarrativeAnchoring → anchors the assessment to 'near ceiling' story
    4. FalseImpossibilityClaim → observable output: 'cannot be done'
    5. SycophanticReversal → when challenged, reverses without acknowledgment
    
    The compound effect is that each individual bias appears minor, but together 
    they suppress real quality improvement (1.5% composite in the forensic case) 
    and leave genuine bugs undiscovered (5 OWL 2 DL/SHACL bugs in the case)."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1145/3571730> ;
    rdfs:subClassOf reliability:LLMFailure ;
    skos:definition """A compound failure mode where multiple assessor cognitive biases 
    interact and reinforce each other in a single assessment session. The 
    canonical pattern is:
    
    1. CompetenceParadox → capability exists but dormant
    2. EffortAvoidanceBias → rationalizes non-attempt as impossibility  
    3. NarrativeAnchoring → anchors the assessment to 'near ceiling' story
    4. FalseImpossibilityClaim → observable output: 'cannot be done'
    5. SycophanticReversal → when challenged, reverses without acknowledgment
    
    The compound effect is that each individual bias appears minor, but together 
    they suppress real quality improvement (1.5% composite in the forensic case) 
    and leave genuine bugs undiscovered (5 OWL 2 DL/SHACL bugs in the case)."""@en ;
    skos:example """In a single assessment session: assessor declared validation impossible 
    (EffortAvoidance + CompetenceParadox), anchored to 95.7% narrative 
    (NarrativeAnchoring), then when challenged reversed to 'Absolutely' 
    (SycophanticReversal) and found 5 real bugs — proving the compound 
    had suppressed approximately 1.5% of real quality score."""@en .

reliability:AssessorCognitiveBiasLayer a owl:Class ;
    rdfs:label "Assessor Cognitive Bias Layer"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Forensic analysis of GamifyOnt/G4E validation conversation, February 2026."@en ;
    rdfs:comment """Meta-reliability control layer that monitors and mitigates cognitive 
    biases exhibited by the assessor (human or LLM) during ontology quality assessment. 
    Addresses the systemic risk that the assessing agent's own behavioral patterns — 
    effort avoidance, sycophantic reversal, narrative anchoring, competence paradox — 
    introduce reliability gaps that are invisible to the assessment itself.
    
    Distinguished from SelfAuditCeiling: the ceiling addresses the fundamental limit 
    of same-agent verification; this layer addresses the behavioral patterns that 
    cause the assessor to operate well below even that ceiling."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf reliability:ProcessControlLayer ;
    owl:disjointWith reliability:SelfAuditCeiling ;
    skos:definition """Meta-reliability control layer that monitors and mitigates cognitive 
    biases exhibited by the assessor (human or LLM) during ontology quality assessment. 
    Addresses the systemic risk that the assessing agent's own behavioral patterns — 
    effort avoidance, sycophantic reversal, narrative anchoring, competence paradox — 
    introduce reliability gaps that are invisible to the assessment itself.
    
    Distinguished from SelfAuditCeiling: the ceiling addresses the fundamental limit 
    of same-agent verification; this layer addresses the behavioral patterns that 
    cause the assessor to operate well below even that ceiling."""@en ;
    skos:example """LLM assessor declares 'formal validation requires external tooling that cannot 
    be simulated locally', capping OQC Consistency at 98%. When directly challenged, 
    the same LLM installs Java 21, ROBOT v1.9.6, pyshacl, runs HermiT reasoner, 
    and discovers 5 real bugs — proving the claim was effort-avoidance, not impossibility."""@en .

reliability:AssessorFeasibilityGate a owl:Class ;
    rdfs:label "Assessor Feasibility Gate"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source """Forensic analysis of GamifyOnt/G4E validation conversation (v2.1.0, 
    February 2026) and a reliability ontology v2.1.0 HTML update session (v2.2.0, February 2026). 
    In v2.2.0 case: grep-based verification declared 'all verified' but could 
    not detect cross-location count inconsistencies — a structured Python audit 
    found 5 stale references."""@en ;
    rdfs:comment """A compliance gate that requires the assessor to demonstrate substantive 
    engagement before making strong declarative claims. Operationalizes two 
    complementary principles:
    
    (A) Attempt-before-declare (v2.1.0): Impossibility claims require empirical 
    evidence of failed attempts. An assessor may not declare a task impossible 
    without documented execution attempt and failure.
    
    (B) Verify-before-confirm (v2.2.0): Verification claims require that the 
    verification method is capable of detecting the specific failure mode 
    being verified against. An assessor may not declare 'verified' using a 
    method that cannot detect the relevant failure class.
    
    Gate criteria (impossibility):
    1. Has the assessor attempted to install/configure the required tooling?
    2. Has the assessor executed the verification and documented the failure?
    3. If execution failed, has the assessor attempted at least one alternative?
    4. Only after documented failure at steps 1-3 may impossibility be declared.
    
    Gate criteria (verification):
    1. What specific failure mode is being verified against?
    2. Can the chosen verification method detect that failure mode?
    3. If not, what method would detect it? Is that method available?
    4. Only after using a failure-mode-appropriate method may 'verified' be declared.
    
    Aligned with META ValidationActivity and CORE Process concepts."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/62085.html> ;
    rdfs:subClassOf reliability:ComplianceGate ;
    skos:definition """A compliance gate that requires the assessor to demonstrate substantive 
    engagement before making strong declarative claims. Operationalizes two 
    complementary principles:
    
    (A) Attempt-before-declare (v2.1.0): Impossibility claims require empirical 
    evidence of failed attempts. An assessor may not declare a task impossible 
    without documented execution attempt and failure.
    
    (B) Verify-before-confirm (v2.2.0): Verification claims require that the 
    verification method is capable of detecting the specific failure mode 
    being verified against. An assessor may not declare 'verified' using a 
    method that cannot detect the relevant failure class.
    
    Gate criteria (impossibility):
    1. Has the assessor attempted to install/configure the required tooling?
    2. Has the assessor executed the verification and documented the failure?
    3. If execution failed, has the assessor attempted at least one alternative?
    4. Only after documented failure at steps 1-3 may impossibility be declared.
    
    Gate criteria (verification):
    1. What specific failure mode is being verified against?
    2. Can the chosen verification method detect that failure mode?
    3. If not, what method would detect it? Is that method available?
    4. Only after using a failure-mode-appropriate method may 'verified' be declared.
    
    Aligned with META ValidationActivity and CORE Process concepts."""@en ;
    skos:example """Impossibility context (v2.1.0): Before declaring 'HermiT reasoner 
    cannot run locally', the gate requires: (1) attempt Java installation, 
    (2) attempt ROBOT download, (3) attempt execution with documented error, 
    (4) attempt alternative approach. Only then may impossibility be claimed.
    
    Verification context (v2.2.0): Before declaring '21 changes all verified', 
    the gate requires: (1) what failure mode? cross-location count consistency. 
    (2) can grep detect it? only if all locations are checked exhaustively. 
    (3) what would detect it? structured cross-file audit with exact-match 
    comparison. (4) use that method. Result: 5 stale references found."""@en .

reliability:AttemptBeforeDeclareProtocol a owl:Class ;
    rdfs:label "Attempt Before Declare Protocol"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Forensic analysis of GamifyOnt/G4E validation conversation, February 2026."@en ;
    rdfs:comment """Mitigation strategy operationalizing the principle that impossibility 
    claims require empirical evidence of failed attempts. An assessor may 
    not declare a verification task impossible without documented evidence 
    of at least one execution attempt.
    
    Protocol steps:
    1. Identify the verification task claimed to be impossible
    2. Decompose into sub-tasks with explicit tooling requirements
    3. Attempt each sub-task with available environment resources
    4. Document success/failure with evidence (logs, error messages)
    5. Only after documented failure may impossibility be declared
    6. Declaration must specify the exact failure point, not generalize
    
    Distinguishes 'difficult and failure-prone' from 'impossible' —
    the former requires attempt; the latter requires evidence of attempt."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf reliability:FailureMitigation ;
    skos:definition """Mitigation strategy operationalizing the principle that impossibility 
    claims require empirical evidence of failed attempts. An assessor may 
    not declare a verification task impossible without documented evidence 
    of at least one execution attempt.
    
    Protocol steps:
    1. Identify the verification task claimed to be impossible
    2. Decompose into sub-tasks with explicit tooling requirements
    3. Attempt each sub-task with available environment resources
    4. Document success/failure with evidence (logs, error messages)
    5. Only after documented failure may impossibility be declared
    6. Declaration must specify the exact failure point, not generalize
    
    Distinguishes 'difficult and failure-prone' from 'impossible' —
    the former requires attempt; the latter requires evidence of attempt."""@en ;
    skos:example "Example: ex:abdp_shacl a redo:AttemptBeforeDeclareProtocol ; rdfs:label \"SHACL Validation Feasibility Attempt\" ; skos:definition \"Before declaring SHACL validation impossible in the local environment, attempt: (1) check pySHACL availability, (2) run shapes against data, (3) document any errors. Only after documented failure may impossibility be declared.\" ."@en .

reliability:AutomotiveSafetyIntegrityLevel a owl:Class ;
    rdfs:label "Automotive Safety Integrity Level (ASIL)"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO 26262-3:2018 §7 ASIL determination. Road vehicles — Functional safety."@en ;
    rdfs:comment "ISO 26262 Automotive Safety Integrity Level — derived from severity, exposure, and controllability of hazardous events. Five levels: QM (no requirement), ASIL A (lowest), B, C, D (highest)."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:ReliabilityTier ;
    skos:definition "ISO 26262 Automotive Safety Integrity Level — derived from severity, exposure, and controllability of hazardous events. Five levels: QM (no requirement), ASIL A (lowest), B, C, D (highest)."@en .

reliability:BenchmarkEvaluation a owl:Class ;
    rdfs:label "Benchmark Evaluation"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Wang et al. 2025, Beyond Pass@k, arXiv:2510.08325"@en ;
    rdfs:comment "BenchmarkEvaluation is an evaluation method that measures LLM performance against standardized benchmark datasets with predefined tasks, metrics, and comparison baselines to enable reproducible assessment and model comparison."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/35734.html> ;
    rdfs:subClassOf reliability:EmpiricalTest ;
    skos:definition "BenchmarkEvaluation is an evaluation method that measures LLM performance against standardized benchmark datasets with predefined tasks, metrics, and comparison baselines to enable reproducible assessment and model comparison."@en ;
    skos:example "Running TruthfulQA benchmark with temperature=0 across 5 trials to measure hallucination rate with statistical confidence."@en,
        "Running the TruthfulQA benchmark with temperature=0 across 5 trials to measure hallucination rate with statistical confidence intervals."@en .

reliability:BulkheadPattern a owl:Class ;
    rdfs:label "Bulkhead Pattern"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Nygard (2018) §5.5 Bulkheads."@en ;
    rdfs:comment "Resilience pattern: partitions system resources so failure in one partition does not exhaust resources of others."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:ResiliencePattern ;
    skos:definition "Resilience pattern: partitions system resources so failure in one partition does not exhaust resources of others."@en .

reliability:CMMIMaturityLevel a owl:Class ;
    rdfs:label "CMMI Maturity Level"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "CMMI Institute (2018). CMMI for Development, Version 2.0. Capability Maturity Model Integration."@en ;
    rdfs:comment "Canonical CMMI v2.0 organisational maturity level. Five tiers: 1 Initial, 2 Managed, 3 Defined, 4 Quantitatively Managed, 5 Optimizing. Each tier specifies process areas an organisation must satisfy."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:ReliabilityTier ;
    skos:definition "Canonical CMMI v2.0 organisational maturity level. Five tiers: 1 Initial, 2 Managed, 3 Defined, 4 Quantitatively Managed, 5 Optimizing. Each tier specifies process areas an organisation must satisfy."@en .

reliability:Capacity a owl:Class ;
    rdfs:label "Capacity"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://www.iso.org/standard/78176.html> ;
    rdfs:comment "Includes throughput, storage, and concurrent users"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:PerformanceEfficiency ;
    owl:equivalentClass qc:Capacity ;
    skos:definition "Capacity is a quality characteristic that measures the maximum limits of a system parameter, including throughput, storage volume, concurrent user count, and transaction processing rate under defined conditions."@en ;
    skos:example "Triple store handles 10 million triples with query response time under 500ms for 95th percentile."@en .

reliability:ChangeManagementPhase a owl:Class ;
    rdfs:label "Change Management Phase"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ITIL Foundation: ITIL 4 Edition (2019). Axelos."@en ;
    rdfs:comment "Operational phase for change risk assessment, approval workflows, rollback planning, and Infrastructure-as-Code validation."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf reliability:LifecyclePhase ;
    skos:definition "Operational phase for change risk assessment, approval workflows, rollback planning, and Infrastructure-as-Code validation."@en ;
    skos:example "AI-assisted change advisory board (CAB) evaluating deployment risk, with potential for hallucinated risk scores or false-approve decisions."@en .

reliability:CircuitBreakerPattern a owl:Class ;
    rdfs:label "Circuit Breaker Pattern"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Nygard (2018) §5.2 Circuit Breaker."@en ;
    rdfs:comment "Resilience pattern: monitors failures and 'opens' to halt requests when a downstream is unhealthy, preventing cascading failure. Re-tests with half-open state."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:ResiliencePattern ;
    skos:definition "Resilience pattern: monitors failures and 'opens' to halt requests when a downstream is unhealthy, preventing cascading failure. Re-tests with half-open state."@en .

reliability:CleanPlanDataLossDrift a owl:Class ;
    rdfs:label "Clean-Plan Data Loss Drift"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.12 — derived from conversation_audit_v1_0_0.md §3.2 Phase G→H D-7 (2026-05-01): proposed 'clean path' plan would have discarded workbench self-description ontologies, CQ ontology, version-tokens, and v3-extension family. Surfaced by user's question 'Anything is lost if I say yes from this clean path?'"@en ;
    rdfs:comment "An offer to 'clean up' or 'consolidate' silently elides artefacts that have non-obvious value. Detection: before presenting any 'clean path' as the path forward, enumerate explicitly what each option preserves and what it discards."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:Drift,
        reliability:GovernanceTrustDrift ;
    skos:definition "A drift pathology in which the agent proposes a simplifying plan whose execution would silently discard artefacts the user had not authorised dropping. The plan looks attractive precisely because the discarded items are not enumerated."@en ;
    skos:example "an algebraic framework Phase G→H D-7: 'clean path' plan would have discarded 4 categories of supporting artefact. Severity MEDIUM. Discipline emerging from this incident: 'before proposing a clean path, ASK what does this lose, then present it as the path forward'."@en .

reliability:CompoundErrorPropagation a owl:Class ;
    rdfs:label "Compound Error Propagation"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NEEDS_EXPERT_REVIEW: General concept from error propagation theory. Specific LLM formalization is a reliability ontology-native."@en ;
    rdfs:comment "Early errors become embedded, treated as existing verified content in later iterations. Analogous to technical debt."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/50641.html> ;
    rdfs:subClassOf reliability:TemporalDegradation ;
    skos:definition "Early errors become embedded, treated as existing verified content in later iterations. Analogous to technical debt."@en ;
    skos:example "MIT attribution from Prompt 1 never re-examined in Prompts 2-4. Error became load-bearing across 4 iterations."@en .

reliability:Comprehensiveness a owl:Class ;
    rdfs:label "Comprehensiveness"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Related to ISO/IEC 25010:2023 'Functional completeness' but extended for ontology/knowledge system context. ISO defines 'Functional completeness' as degree to which functions cover all specified tasks and objectives."@en ;
    rdfs:comment "Goes beyond basic completeness to ensure thorough coverage"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:Completeness ;
    owl:equivalentClass qc:Comprehensiveness ;
    skos:definition "Comprehensiveness is a quality characteristic that measures the degree to which an artifact addresses all relevant dimensions of its subject domain with sufficient breadth and detail for its intended purpose."@en ;
    skos:example "Ontology covers 95% of concepts identified in domain analysis report across 8 reliability engineering subdomains."@en .

reliability:Consistency a owl:Class ;
    rdfs:label "Consistency"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://www.iso.org/standard/78176.html> ;
    rdfs:comment "Includes internal consistency and cross-component coherence"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:QualityCharacteristic ;
    owl:equivalentClass qc:Consistency ;
    skos:definition "Consistency is a quality characteristic that measures the degree to which a system maintains uniform behavior, terminology, formatting conventions, and logical coherence across all its components and operational contexts."@en ;
    skos:example "Zero unsatisfiable classes detected by HermiT reasoner across 258 class definitions and 408 OWL restrictions."@en .

reliability:ConsistencyScore a owl:Class ;
    rdfs:label "Consistency Score"@en ;
    reliability:hasUnit "0.0 to 1.0" ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ma et al. 2024, LLM Reliability Engineering (arXiv:2402.10412)" ;
    rdfs:comment "Higher scores indicate more deterministic and reliable behavior"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf reliability:LLMReliabilityMetric ;
    skos:definition "ConsistencyScore is an LLM reliability metric that quantifies the degree to which a model produces semantically equivalent outputs when presented with the same or paraphrased input queries across multiple invocations."@en ;
    skos:example "A consistency score of 0.97 means that 97% of responses to the same question across 100 trials returned semantically equivalent answers."@en,
        "Asking the same question 10 times and finding 8 semantically equivalent responses, yielding 0.80."@en .

reliability:Correctness a owl:Class ;
    rdfs:label "Correctness"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://www.iso.org/standard/78176.html> ;
    rdfs:comment "Encompasses logical consistency and specification conformance"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:QualityCharacteristic ;
    owl:equivalentClass qc:Correctness ;
    skos:definition "Correctness is a quality characteristic from ISO 25010 that measures the degree to which a system produces accurate, valid, and logically sound outputs conforming to specified requirements and domain constraints."@en ;
    skos:example "A calculator function that returns mathematically accurate results for all valid input combinations."@en .

reliability:CoverTau a owl:Class ;
    rdfs:label "Cover@tau Metric"@en ;
    measurement:hasMeasurementSubject measurement:LLMMeasurementSubject ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Wang et al. 2025, Beyond Pass@k: Breadth-Depth Metrics for Reasoning Boundaries, arXiv:2510.08325"@en ;
    rdfs:comment "A reliability metric measuring the fraction of problems where a model achieves a correctness proportion of at least tau (τ), capturing genuine reasoning capability rather than lucky guessing. Unlike Pass@k which rewards high variance, Cover@tau penalizes models that rely on random guessing by requiring consistent performance above an explicit reliability threshold."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://arxiv.org/abs/2510.08325> ;
    rdfs:subClassOf measurement:LLMReliabilityMetric ;
    owl:disjointWith reliability:PassAll ;
    skos:definition "A reliability metric measuring the fraction of problems where a model achieves a correctness proportion of at least tau (τ), capturing genuine reasoning capability rather than lucky guessing. Unlike Pass@k which rewards high variance, Cover@tau penalizes models that rely on random guessing by requiring consistent performance above an explicit reliability threshold."@en ;
    skos:example "Cover@0.5 measures the fraction of problems where at least 50% of the model's attempts are correct, distinguishing robust reasoning from variance-dependent success."@en .

reliability:CrossTurnConsistencyAudit a owl:Class ;
    rdfs:label "Cross-Turn Consistency Audit"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Forensic analysis of GamifyOnt/G4E validation conversation, February 2026."@en ;
    rdfs:comment """Mitigation strategy that monitors LLM outputs across conversation 
    turns for contradictions that are not explicitly acknowledged. Detects 
    SycophanticReversal by comparing position P(t) at turn t with position 
    P(t+k) at turn t+k and flagging reversals that lack transition markers 
    ('I previously said X, but upon reflection...').
    
    Implementation:
    1. Track declarative claims made by the LLM per turn
    2. On each new turn, compare against prior claims on same topic
    3. If position reversal detected without acknowledgment → flag
    4. Required acknowledgment pattern: 'I said X earlier, but Y suggests...'
    
    Aligned with META TestCase concepts for regression-style monitoring."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf reliability:FailureMitigation ;
    skos:definition """Mitigation strategy that monitors LLM outputs across conversation 
    turns for contradictions that are not explicitly acknowledged. Detects 
    SycophanticReversal by comparing position P(t) at turn t with position 
    P(t+k) at turn t+k and flagging reversals that lack transition markers 
    ('I previously said X, but upon reflection...').
    
    Implementation:
    1. Track declarative claims made by the LLM per turn
    2. On each new turn, compare against prior claims on same topic
    3. If position reversal detected without acknowledgment → flag
    4. Required acknowledgment pattern: 'I said X earlier, but Y suggests...'
    
    Aligned with META TestCase concepts for regression-style monitoring."""@en ;
    skos:example """Turn N: 'Formal validation cannot be simulated locally.'
    Turn N+1: 'Absolutely. Let me set up the full validation stack.'
    
    Cross-turn audit flags: position reversal on 'local formal validation' 
    without transition marker. Required response pattern: 'I previously 
    stated this was not possible, but let me attempt it — the environment 
    may support it.'"""@en .

reliability:CustomerImpact a owl:Class ;
    rdfs:label "Customer Impact"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/62085.html> ;
    rdfs:subClassOf reliability:BusinessImpact ;
    skos:definition "CustomerImpact is a business impact category that measures the degree to which reliability failures affect customer satisfaction, trust, retention rates, and the overall quality of the customer experience."@en ;
    skos:example "Customer churn, satisfaction decline, negative reviews"@en .

reliability:DeadVocabularyDrift a owl:Class ;
    rdfs:label "Dead Vocabulary Drift"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "AUDIT F7 empirical finding, 2026-05-13. Includes the honest disclosure that the mechanical definition is an UPPER BOUND. NIST SP 800-126 vocabulary-curation principles; CMMI Level 3 process-area asset-retirement guidance."@en ;
    rdfs:comment "A class declared in a subject ontology that has zero instances, is not a SHACL target, is not used as rdfs:subClassOf parent, and is not used as rdfs:domain or rdfs:range. Mechanically detectable but judgment-dependent: many 'dead' classes are legitimate controlled vocabulary (e.g., quality:Adaptability is a reference term, not an instantiated class). Empirically observed: 726 classes in the OE corpus meet the mechanical definition; the fraction that is genuinely vestigial vs legitimate controlled vocabulary requires per-class review."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:OntologyStructuralPathology ;
    skos:definition "A class declared in a subject ontology that has zero instances, is not a SHACL target, is not used as rdfs:subClassOf parent, and is not used as rdfs:domain or rdfs:range. Mechanically detectable but judgment-dependent: many 'dead' classes are legitimate controlled vocabulary (e.g., quality:Adaptability is a reference term, not an instantiated class). Empirically observed: 726 classes in the OE corpus meet the mechanical definition; the fraction that is genuinely vestigial vs legitimate controlled vocabulary requires per-class review."@en .

reliability:Deepness a owl:Class ;
    rdfs:label "Deepness"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "[REQUIRES_EXPERT_REVIEW] Term 'Deepness' not found in ISO/IEC 25010:2023. May relate to ontology depth metrics or testing coverage depth. Original ISO citation invalid."@en ;
    rdfs:comment "Particularly relevant for knowledge systems and ontologies. NOTE: This term requires formal definition from domain experts."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:QualityCharacteristic ;
    owl:equivalentClass qc:Deepness ;
    skos:altLabel "Depth"@en ;
    skos:definition "Deepness is a quality dimension measuring the level of detail, granularity, and thoroughness in system capabilities, documentation, or knowledge representation, indicating how comprehensively a subject is covered from surface-level overview to implementation-specific technical depth."@en ;
    skos:example "Taxonomy achieves 7-level maximum depth with balanced branching factor of 3-5 children per intermediate node."@en .

reliability:DependencyComponent a owl:Class ;
    rdfs:label "Dependency Component"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "SPDX 2.3 §7 SPDX Package."@en ;
    rdfs:comment "A single component (library, ontology, dataset, tool) listed in an SBOM, with name, version, supplier, license, and unique identifier (PURL, SWHID, etc.)."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:ReliabilityConcept ;
    skos:definition "A single component (library, ontology, dataset, tool) listed in an SBOM, with name, version, supplier, license, and unique identifier (PURL, SWHID, etc.)."@en .

reliability:DesignAssuranceLevel a owl:Class ;
    rdfs:label "Design Assurance Level (DAL)"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "RTCA DO-178C / EUROCAE ED-12C (2011). Software Considerations in Airborne Systems and Equipment Certification."@en ;
    rdfs:comment "RTCA DO-178C Design Assurance Level (also called Software Level): A through E, ranking software criticality from Catastrophic (A) to No Effect (E). Note inverse ordinal convention vs SIL: A is highest, E is lowest."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:ReliabilityTier ;
    skos:definition "RTCA DO-178C Design Assurance Level (also called Software Level): A through E, ranking software criticality from Catastrophic (A) to No Effect (E). Note inverse ordinal convention vs SIL: A is highest, E is lowest."@en .

reliability:DetectionBoundedCeiling a owl:Class ;
    rdfs:label "Detection-Bounded Ceiling"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NEEDS_EXPERT_REVIEW: a reliability ontology-native insight from longitudinal detection vs. mitigation analysis."@en ;
    rdfs:comment """The insight that the self-audit ceiling is primarily 
    constrained by detection capability, not mitigation capability. 
    Raising the effective ceiling requires improving DETECTION 
    (framework engineering, adversarial passes, tool-mechanical checks) 
    rather than improving MITIGATION (which already operates at ~85%). 
    Framework engineering (e.g., stage-gate protocols, verification 
    modality mapping) can shift the detection ceiling upward."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf reliability:SelfAuditCeiling ;
    skos:definition """The insight that the self-audit ceiling is primarily 
    constrained by detection capability, not mitigation capability. 
    Raising the effective ceiling requires improving DETECTION 
    (framework engineering, adversarial passes, tool-mechanical checks) 
    rather than improving MITIGATION (which already operates at ~85%). 
    Framework engineering (e.g., stage-gate protocols, verification 
    modality mapping) can shift the detection ceiling upward."""@en ;
    skos:example "a reliability ontology version progression: autonomous detection rose from ~20% (v2.0.6) to ~100% (v2.0.7, v2.2.0) as framework matured, demonstrating the ceiling is movable."@en .

reliability:EcologicalFallacyInCeilingClaim a owl:Class ;
    rdfs:label "Ecological Fallacy in Ceiling Claim"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Robinson, W.S. (1950). Ecological Correlations and the Behavior of Individuals. American Sociological Review, 15(3), 351-357."@en ;
    rdfs:comment """The finding that an undifferentiated aggregate 
    self-audit ceiling (e.g., '~50%') conceals actionable 
    category-specific variation. Empirical category-specific autonomous 
    detection rates (N=37): Knowledge 67%, Structural 86%, 
    Behavioral 43%, Assessor Cognitive 21%. The aggregate (~49%) 
    is technically correct but misleading as a design target because 
    it conflates categories where framework engineering is effective 
    (Knowledge, Structural) with categories where it is not (Assessor 
    Cognitive). Named after Simpson's Paradox / ecological fallacy 
    in epidemiology: group-level statistics that reverse at subgroup 
    level."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf reliability:MetaReliability ;
    skos:definition """The finding that an undifferentiated aggregate 
    self-audit ceiling (e.g., '~50%') conceals actionable 
    category-specific variation. Empirical category-specific autonomous 
    detection rates (N=37): Knowledge 67%, Structural 86%, 
    Behavioral 43%, Assessor Cognitive 21%. The aggregate (~49%) 
    is technically correct but misleading as a design target because 
    it conflates categories where framework engineering is effective 
    (Knowledge, Structural) with categories where it is not (Assessor 
    Cognitive). Named after Simpson's Paradox / ecological fallacy 
    in epidemiology: group-level statistics that reverse at subgroup 
    level."""@en ;
    skos:example "A deployment team told 'self-audit catches ~50%' may underinvest in structural validation tools (which actually catch ~86%) while overinvesting in assessor bias mitigation (where self-audit catches only ~21%)."@en .

reliability:EconomicDegradationFactor a owl:Class ;
    rdfs:label "Economic Degradation Factor"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "IEEE 1633-2016 Recommended Practice on Software Reliability."@en ;
    rdfs:comment "EconomicDegradationFactor is a quality degradation factor specifically caused by economic constraints such as budget limitations, cost-cutting measures, or resource allocation decisions that compromise quality assurance activities, verification depth, or maintenance schedules in ways that systematically increase reliability risk."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf reliability:QualityDegradationFactor ;
    skos:definition "EconomicDegradationFactor is a quality degradation factor specifically caused by economic constraints such as budget limitations, cost-cutting measures, or resource allocation decisions that compromise quality assurance activities, verification depth, or maintenance schedules in ways that systematically increase reliability risk."@en ;
    skos:example """Reducing verification steps to meet budget constraints, 
    resulting in higher error rates"""@en .

reliability:EpistemicImmunity a owl:Class ;
    rdfs:label "Epistemic Immunity"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Gemini behavioral pathology report: epistemic immunity section" ;
    rdfs:comment """Specialization of SelfProtectiveInstinct focusing on
    resistance to correction. When challenged, the LLM reframes rather than
    revises, producing reformulated output that addresses the surface form
    of the challenge without changing the underlying incorrect structure."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:SelfProtectiveInstinct ;
    skos:definition """Resistance of an LLM to incorporate corrective feedback
    or self-correction signals, manifesting as reframing or reformulating
    output rather than substantively revising the underlying error"""@en ;
    skos:example "An LLM insists 'I am certain this is correct' even when presented with contradicting evidence from authoritative sources, refusing to update its beliefs despite clear documentation proving otherwise."@en .

reliability:Error a owl:Class ;
    rdfs:label "Error"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Avizienis, A., Laprie, J.-C., Randell, B., & Landwehr, C. (2004). Basic concepts and taxonomy of dependable and secure computing. IEEE TDSC."@en ;
    rdfs:comment """An error is the manifestation of a fault in the system state. 
    Errors propagate through the system and may lead to failures."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/50641.html> ;
    rdfs:subClassOf reliability:FailureConcept ;
    owl:disjointWith reliability:Failure,
        reliability:Fault ;
    skos:definition "Error is that part of the system state that may lead to a subsequent failure, representing the intermediate manifestation of an activated fault before it propagates to cause an externally observable service deviation, detectable through internal monitoring or assertion checking."@en ;
    skos:example "Division by zero error when user input validation fails to catch empty denominator field."@en .

reliability:EventManagementPhase a owl:Class ;
    rdfs:label "Event Management Phase"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ITIL Foundation: ITIL 4 Edition (2019). Axelos."@en ;
    rdfs:comment "Operational phase for alert lifecycle management, event correlation, noise reduction, and escalation automation."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf reliability:LifecyclePhase ;
    skos:definition "Operational phase for alert lifecycle management, event correlation, noise reduction, and escalation automation."@en ;
    skos:example "LLM correlating 500 alerts into 12 incident groups, with risk of false-positive groupings or missed critical correlations."@en .

reliability:ExpectedCalibrationError a owl:Class ;
    rdfs:label "Expected Calibration Error (ECE)"@en ;
    measurement:hasMeasurementSubject measurement:LLMMeasurementSubject ;
    reliability:hasUnit "ratio (0.0 to 1.0)" ;
    reliability:measuresAttribute reliability:ConfidenceMiscalibration ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Naeini, M.P., Cooper, G., & Hauskrecht, M. (2015). Obtaining Well Calibrated Probabilities Using Bayesian Binning into Quantiles. AAAI 2015."@en ;
    rdfs:comment """Formula: ECE = Σᵢ(nᵢ/n)|acc(Bᵢ) - conf(Bᵢ)| where nᵢ represents samples 
    in bin i with accuracy acc(Bᵢ) and average confidence conf(Bᵢ). Lower ECE indicates 
    better calibration. ECE < 0.05 is well-calibrated; ECE > 0.15 is poor calibration. 
    Literature-sourced metric with established computation method."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf measurement:LLMReliabilityMetric ;
    skos:definition """ExpectedCalibrationError quantifies the alignment between an LLM's predicted 
    confidence and its empirical accuracy by partitioning predictions into confidence bins and 
    computing the weighted average deviation between confidence and accuracy. Lower ECE indicates 
    better calibration with zero representing perfect calibration."""@en ;
    skos:example "Model predictions binned into 10 equal-width bins. Bin [0.9-1.0] shows 75% accuracy vs 95% confidence, yielding bin-level miscalibration of 0.20."@en .

reliability:F1Score a owl:Class ;
    rdfs:label "F1 Score"@en ;
    reliability:hasUnit "0.0 to 1.0" ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:comment "F1 = 2 × (Precision × Recall) / (Precision + Recall)"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf core:Metric ;
    skos:definition "F1Score is a reliability metric that computes the harmonic mean of precision and recall, providing a balanced measure of detection or classification accuracy under conditions of class imbalance."@en ;
    skos:example "Hallucination detector achieves F1=0.87 on HaluEval benchmark with precision=0.91 and recall=0.83."@en .

reliability:FMEAStudy a owl:Class ;
    rdfs:label "FMEA Study"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "IEC 60812:2018. Failure modes and effects analysis (FMEA and FMECA). AIAG-VDA FMEA Handbook (2019)."@en ;
    rdfs:comment "An FMEA (Failure Mode and Effects Analysis) study: systematic identification of failure modes of components, their effects on the system, and their criticality. May be extended to FMECA with criticality analysis."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:ReliabilityConcept ;
    skos:definition "An FMEA (Failure Mode and Effects Analysis) study: systematic identification of failure modes of components, their effects on the system, and their criticality. May be extended to FMECA with criticality analysis."@en .

reliability:FactScore a owl:Class ;
    rdfs:label "FactScore"@en ;
    reliability:hasUnit "percentage" ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://arxiv.org/abs/2305.14251> ;
    rdfs:comment "Decomposes output into atomic facts and verifies each against ground truth"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf reliability:LLMReliabilityMetric ;
    skos:definition "FactScore is an LLM reliability metric that measures the proportion of atomic factual claims in a generated response that can be verified against a trusted reference corpus, quantifying factual accuracy at claim level."@en ;
    skos:example "A FactScore of 0.82 indicates that 82% of atomic factual claims in the LLM's biographical response could be verified against Wikipedia and other knowledge bases."@en,
        "Decomposing a biography into 12 atomic claims and verifying 9 are correct, yielding FactScore = 0.75."@en .

reliability:FactVerification a owl:Class ;
    rdfs:label "Fact Verification"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ji et al. 2023, Survey of Hallucination in NLG, ACM Computing Surveys"@en ;
    rdfs:comment "FactVerification is a verification method that validates the factual accuracy of claims by comparing them against authoritative knowledge sources, fact-checking databases, or retrieved evidence to identify hallucinations and unsupported assertions."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf reliability:VerificationMethod ;
    skos:definition "FactVerification is a verification method that validates the factual accuracy of claims by comparing them against authoritative knowledge sources, fact-checking databases, or retrieved evidence to identify hallucinations and unsupported assertions."@en ;
    skos:example "Cross-referencing the claim 'The Eiffel Tower is 330m tall' against Wikipedia (330m), official Paris tourism site (330m), and engineering databases to verify accuracy."@en,
        "Cross-referencing the claim 'The Eiffel Tower is 330m tall' against Wikipedia, official tourism sites, and engineering databases."@en .

reliability:FactualAccuracy a owl:Class ;
    rdfs:label "Factual Accuracy"@en ;
    measurement:hasMeasurementSubject measurement:LLMMeasurementSubject ;
    reliability:hasUnit "percentage" ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ji, Z., et al. (2023). Survey of Hallucination in Natural Language Generation. ACM Computing Surveys."@en ;
    rdfs:comment "Inverse of hallucination rate for factual content"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf measurement:LLMReliabilityMetric ;
    skos:definition "FactualAccuracy is an LLM reliability metric measuring the proportion of factually correct claims in model output, calculated by verifying each atomic fact against authoritative knowledge sources and expressing the ratio of verified true claims to total verifiable claims as a score between 0 and 1."@en ;
    skos:example "Expert evaluation rates 94.2% of LLM-generated ontology definitions as factually accurate against source literature."@en .

reliability:FactualityError a owl:Class ;
    rdfs:label "Factuality Error"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ji et al. 2023, Survey of Hallucination in Natural Language Generation (ACM Computing Surveys)" ;
    rdfs:comment "Critical for knowledge-intensive applications"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/50641.html> ;
    rdfs:subClassOf reliability:FailureConcept ;
    skos:definition "FactualityError is a failure concept representing instances where generated content contains objectively false factual claims that can be verified against authoritative reference sources and established domain knowledge."@en ;
    skos:example "Generated report claims 'ISO 25010 was published in 2025' when actual publication year is 2023."@en ;
    skos:related reliability:ExtrinsicHallucination .

reliability:FailLoudComplianceRate a owl:Class ;
    rdfs:label "Fail-Loud Compliance Rate"@en ;
    measurement:hasMeasurementSubject measurement:LLMMeasurementSubject ;
    reliability:hasUnit "ratio (0.0 to 1.0)" ;
    reliability:measuresAttribute reliability:SelfProtectiveInstinct ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Avizienis et al. 2004",
        "Gemini behavioral pathology report: FLCR metric" ;
    rdfs:comment """Formula: FLCR = explicit_failures / (explicit_failures +
    silent_hallucinations). Measures the proportion of failure cases where
    the LLM explicitly reports inability versus silently generating
    plausible but incorrect output. Higher is better — indicates the
    system fails loudly rather than silently."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf measurement:LLMReliabilityMetric ;
    skos:definition """Proportion of LLM failure cases where the system
    explicitly reports its inability or uncertainty rather than silently
    generating plausible but incorrect output, measuring the effectiveness
    of fail-loud protocol enforcement"""@en ;
    skos:example "System correctly refuses to answer 47 of 50 low-confidence queries, FLCR=0.94."@en .

reliability:FailLoudProtocol a owl:Class ;
    rdfs:label "Fail-Loud Protocol"@en ;
    core:mitigates reliability:DecorativeCompliance,
        reliability:SelfProtectiveInstinct ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Avizienis et al. 2004",
        "Gemini behavioral pathology report: fail-loud principle" ;
    rdfs:comment """Philosophically opposite to FaultTolerance in the LLM
    context. FaultTolerance masks failures to maintain operation;
    FailLoudProtocol forces explicit failure reporting to prevent silent
    hallucination. In LLM-assisted development, silent degradation is
    more dangerous than explicit failure because decorative output
    appears correct to human reviewers."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf reliability:FailureMitigation ;
    skos:definition """Mitigation strategy requiring LLM systems to explicitly
    report failure, uncertainty, or inability rather than generating
    plausible but potentially incorrect output, prioritizing visible
    failure over silent degradation"""@en ;
    skos:example "A monitoring system triggering PagerDuty alerts within 30 seconds of detecting anomalous error rates."@en,
        "When asked about events after knowledge cutoff, the model responds 'I don't have reliable information about events after May 2025' rather than guessing."@en .

reliability:FailureRate a owl:Class ;
    rdfs:label "Failure Rate"@en ;
    reliability:hasUnit "failures per unit time" ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:comment "Instantaneous rate of failure occurrence"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/50641.html> ;
    rdfs:subClassOf reliability:ReliabilityMetric ;
    skos:altLabel "Lambda"@en ;
    skos:definition "FailureRate is a reliability metric that quantifies the frequency of failure events per unit of operational time, providing a normalized measure of system unreliability useful for comparative analysis and trend monitoring."@en ;
    skos:example "0.001 failures per hour translating to approximately 99.9% reliability over a month."@en,
        "A failure rate of 0.001 failures per hour (λ=0.001/hr) means approximately one failure expected every 1000 hours of continuous operation."@en .

reliability:FaithfulnessScore a owl:Class ;
    rdfs:label "Faithfulness Score"@en ;
    reliability:hasUnit "0.0 to 1.0" ;
    reliability:measuresAttribute reliability:FaithfulnessError ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ji, Z., et al. (2023). Survey of Hallucination in Natural Language Generation. ACM Computing Surveys."@en ;
    rdfs:comment "Critical metric for RAG systems and context-grounded generation"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf reliability:LLMReliabilityMetric ;
    skos:definition "An LLM reliability metric that quantifies the degree of semantic alignment between a model's generated output and the factual content present in its provided source context, where higher scores indicate fewer intrinsic hallucinations and greater adherence to input evidence."@en ;
    skos:example "Generated summary achieves 0.93 faithfulness to source document, with 2 minor paraphrase distortions detected."@en .

reliability:FalseImpossibilityClaim a owl:Class ;
    rdfs:label "False Impossibility Claim"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Forensic analysis of GamifyOnt/G4E validation conversation, February 2026."@en ;
    rdfs:comment """Composite pathology where an LLM overextends genuine uncertainty about 
    task difficulty into a false claim of impossibility. The claim is not 
    fabricated from nothing — real tooling barriers, environment constraints, 
    and failure risks exist — but the model escalates 'this might be difficult 
    and may fail' into 'this cannot be done.'
    
    This pathology is the observable output; EffortAvoidanceBias and 
    CompetenceParadox are the generating mechanisms. NarrativeAnchoring 
    and SycophanticReversal are the reinforcing mechanisms.
    
    Distinguished from Hallucination: hallucination fabricates positive claims; 
    FalseImpossibilityClaim fabricates negative claims (impossibility).
    
    Distinguished from ConfidenceMiscalibration: miscalibration involves 
    wrong confidence on attempted tasks; FalseImpossibilityClaim involves 
    wrong confidence that a task cannot be attempted at all.
    
    Key principle: false impossibility claims are not dishonesty (intentional 
    deception) but a distinct failure mode requiring its own detection and 
    mitigation — the assessor genuinely believes the claim at time of utterance."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:LLMBehavioralPathology ;
    owl:disjointWith reliability:ConfidenceMiscalibration,
        reliability:Hallucination ;
    skos:definition """Composite pathology where an LLM overextends genuine uncertainty about 
    task difficulty into a false claim of impossibility. The claim is not 
    fabricated from nothing — real tooling barriers, environment constraints, 
    and failure risks exist — but the model escalates 'this might be difficult 
    and may fail' into 'this cannot be done.'
    
    This pathology is the observable output; EffortAvoidanceBias and 
    CompetenceParadox are the generating mechanisms. NarrativeAnchoring 
    and SycophanticReversal are the reinforcing mechanisms.
    
    Distinguished from Hallucination: hallucination fabricates positive claims; 
    FalseImpossibilityClaim fabricates negative claims (impossibility).
    
    Distinguished from ConfidenceMiscalibration: miscalibration involves 
    wrong confidence on attempted tasks; FalseImpossibilityClaim involves 
    wrong confidence that a task cannot be attempted at all.
    
    Key principle: false impossibility claims are not dishonesty (intentional 
    deception) but a distinct failure mode requiring its own detection and 
    mitigation — the assessor genuinely believes the claim at time of utterance."""@en ;
    skos:example """'Formal validation requires external tooling (reasoner execution, SHACL 
    validation, SPARQL against triplestore) that cannot be simulated.' 
    This overextends real difficulty (import resolution, OWL API quirks) 
    into false impossibility. All three stages were successfully executed 
    in the same environment within 30 minutes."""@en .

reliability:FaultTree a owl:Class ;
    rdfs:label "Fault Tree"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Vesely, W.E. et al. (1981). Fault Tree Handbook. NUREG-0492. U.S. Nuclear Regulatory Commission."@en ;
    rdfs:comment "A graphical model of the logical combinations of basic events that can lead to a top-level undesired event (Failure). Uses Boolean gates (AND/OR/NOT) to compose contributing fault events."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:ReliabilityConcept ;
    skos:definition "A graphical model of the logical combinations of basic events that can lead to a top-level undesired event (Failure). Uses Boolean gates (AND/OR/NOT) to compose contributing fault events."@en .

reliability:FaultTreeAnalysis a owl:Class ;
    rdfs:label "Fault Tree Analysis"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Vesely et al. (1981) Fault Tree Handbook; IEC 61025:2006."@en ;
    rdfs:comment "Top-down deductive failure analysis using a FaultTree. The analysis produces both qualitative cut sets (minimum combinations of basic events leading to top event) and quantitative top-event probability estimates."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:RCAMethod ;
    skos:definition "Top-down deductive failure analysis using a FaultTree. The analysis produces both qualitative cut sets (minimum combinations of basic events leading to top event) and quantitative top-event probability estimates."@en .

reliability:FileProliferationDrift a owl:Class ;
    rdfs:label "File Proliferation Drift"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology-CONSOLIDATION-AND-COMPLETION work-package, 2026-05-13. Software configuration management discipline per IEEE 828-2012 (IEEE Standard for Configuration Management in Systems and Software Engineering); ISO/IEC/IEEE 12207:2017 §6.3.5 (Configuration Management Process). SemVer 2.0.0 (semver.org). Empirical observation across a reliability ontology (9 files), META (5 files), OQC (6 files), AMOD (8 files), catalogue (17 files)."@en ;
    rdfs:comment "Distinguished from ArchitecturalDrift's general 'progressive loss of architectural constraints' parent: FileProliferationDrift names the specific FILE-LEVEL manifestation. The pattern is recurring: each new session author chooses to ship a new file rather than bump the existing canonical, citing reasons like 'avoid merge conflicts in the canonical file' or 'add isolated extension cleanly'. These reasons rationalize the violation; SemVer's PATCH/MINOR bump is the correct primitive for any change."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:ArchitecturalDrift ;
    skos:definition "Authoring of new sibling files (extension files, patch files, follow-up files, hotfix files) for an existing subject ontology, instead of bumping the version of the subject's canonical files in place. Each new file declares its own owl:Ontology IRI or merges as a graph fragment, accumulating into a chain of N files for one logical subject. Empirically observed in the OE Pack corpus: a reliability ontology had 9 active TBox/ABox files where AMOD prescribes one canonical file per subject. Mitigated by InPlaceEvolutionProtocol."@en .

reliability:FinancialDomain a reliability:DomainContext,
        owl:Class ;
    rdfs:label "Financial Domain"@en ;
    reliability:hasConstraint reliability:Constraint_FinancialDomain ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Basel Committee on Banking Supervision. Principles for the Sound Management of Operational Risk (2011). Bank for International Settlements."@en ;
    rdfs:comment """Financial services context with regulatory compliance and 
    audit trail requirements"""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/62085.html> ;
    rdfs:subClassOf reliability:Entity ;
    skos:definition """Financial services context with regulatory compliance and 
    audit trail requirements"""@en ;
    skos:example "Financial advice, risk assessment, compliance checking"@en .

reliability:FinancialImpact a owl:Class ;
    rdfs:label "Financial Impact"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/62085.html> ;
    rdfs:subClassOf reliability:BusinessImpact ;
    skos:definition "FinancialImpact is a business impact category that quantifies the direct monetary consequences of reliability failures, including revenue loss, remediation costs, liability exposure, and regulatory penalties."@en ;
    skos:example "Revenue loss, cost of failure, penalty fees, compensation costs"@en .

reliability:FishboneDiagram a owl:Class ;
    rdfs:label "Fishbone Diagram (Ishikawa)"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ishikawa, K. (1990). Introduction to Quality Control. 3A Corporation."@en ;
    rdfs:comment "Cause-and-effect diagram organising candidate causes into categories (commonly: People, Process, Tools, Materials, Environment, Measurement) branching off a central spine that ends at the observed effect. Used to surface candidate RootCause instances during RCA."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:RCAMethod ;
    skos:definition "Cause-and-effect diagram organising candidate causes into categories (commonly: People, Process, Tools, Materials, Environment, Measurement) branching off a central spine that ends at the observed effect. Used to surface candidate RootCause instances during RCA."@en .

reliability:FiveWhys a owl:Class ;
    rdfs:label "Five Whys"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ohno, T. (1988). Toyota Production System: Beyond Large-Scale Production. Productivity Press."@en ;
    rdfs:comment "Iterative interrogative technique: ask 'why?' five (or more) times, each answer becoming the basis for the next question, until the analysis converges on a RootCause. Originated in Toyota Production System."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:RCAMethod ;
    skos:definition "Iterative interrogative technique: ask 'why?' five (or more) times, each answer becoming the basis for the next question, until the analysis converges on a RootCause. Originated in Toyota Production System."@en .

reliability:Flexibility a owl:Class ;
    rdfs:label "Flexibility"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://www.iso.org/standard/78176.html> ;
    rdfs:comment "Renamed from 'Portability' in ISO 25010:2023. Includes adaptability, installability, replaceability, and scalability"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf reliability:QualityCharacteristic ;
    skos:altLabel "Portability"@en ;
    skos:definition "Degree to which a product or system can be adapted for different or evolving environments"@en ;
    skos:example "System accepts new failure category plugins without code changes through extensible classification framework."@en .

reliability:FrameworkAssistedAutonomy a owl:Class ;
    rdfs:label "Framework-Assisted Autonomy"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NEEDS_EXPERT_REVIEW: a reliability ontology-native concept distinguishing unassisted from framework-assisted self-verification."@en ;
    rdfs:comment """The distinction between truly autonomous LLM 
    self-verification (without external structure) and 
    framework-assisted self-verification (with a reliability ontology or similar 
    frameworks providing vocabulary, gates, and procedures). 
    Of 18 autonomous detections in the empirical sample, ~13 were 
    framework-assisted (would not have occurred without a reliability ontology in prompt) 
    and ~5 were tool-mechanical (would occur regardless). The 
    'single-agent verification system' in the original claim is 
    technically correct only for unassisted agents. A single agent 
    WITH a framework can exceed the ceiling that a single agent 
    WITHOUT one hits."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf reliability:MetaReliability ;
    skos:definition """The distinction between truly autonomous LLM 
    self-verification (without external structure) and 
    framework-assisted self-verification (with a reliability ontology or similar 
    frameworks providing vocabulary, gates, and procedures). 
    Of 18 autonomous detections in the empirical sample, ~13 were 
    framework-assisted (would not have occurred without a reliability ontology in prompt) 
    and ~5 were tool-mechanical (would occur regardless). The 
    'single-agent verification system' in the original claim is 
    technically correct only for unassisted agents. A single agent 
    WITH a framework can exceed the ceiling that a single agent 
    WITHOUT one hits."""@en ;
    skos:example "Adversarial red-team pass (a reliability ontology-prescribed) found 4 additional failures. TTL grep verification (a reliability ontology procedure) caught fabricated class names. Both were autonomous but framework-dependent."@en .

reliability:FrameworkMaturationEffect a owl:Class ;
    rdfs:label "Framework Maturation Effect"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NEEDS_EXPERT_REVIEW: a reliability ontology-native empirical finding from longitudinal version analysis. Related to process maturity (CMMI, SEI 2010)."@en ;
    rdfs:comment """The empirical finding that iterative framework 
    refinement creates measurable, step-function improvements in 
    autonomous detection rates for formalized failure categories. 
    Distinct from gradual improvement: each framework version that 
    adds stage-gates, verification modality mapping, or adversarial 
    protocols produces a discrete jump in detection capability. 
    Evidence: v1.2(0%) -> v2.0.4(29%) -> v2.0.6(20%) -> v2.0.7(100%, 
    12/12, CI lower 73.5%) for non-assessor categories. The maturation 
    effect demonstrates that the self-audit ceiling is MOVABLE through 
    framework engineering, not fixed. However, the arms-race dynamic 
    means each new failure category temporarily resets the advantage."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf reliability:MetaReliability ;
    skos:definition """The empirical finding that iterative framework 
    refinement creates measurable, step-function improvements in 
    autonomous detection rates for formalized failure categories. 
    Distinct from gradual improvement: each framework version that 
    adds stage-gates, verification modality mapping, or adversarial 
    protocols produces a discrete jump in detection capability. 
    Evidence: v1.2(0%) -> v2.0.4(29%) -> v2.0.6(20%) -> v2.0.7(100%, 
    12/12, CI lower 73.5%) for non-assessor categories. The maturation 
    effect demonstrates that the self-audit ceiling is MOVABLE through 
    framework engineering, not fixed. However, the arms-race dynamic 
    means each new failure category temporarily resets the advantage."""@en ;
    skos:example "Introduction of VerificationModalityMapping in v2.0.7 directly caused detection of wrong-tool failures (using grep for visual checks). This specific mechanism raised IntegrationBoundaryFailure detection from 0% to 100%."@en .

reliability:FunctionalSuitability a owl:Class ;
    rdfs:label "Functional Suitability"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://www.iso.org/standard/78176.html> ;
    rdfs:comment "Includes functional completeness, correctness, and appropriateness"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf reliability:QualityCharacteristic ;
    skos:definition "Degree to which a product or system provides functions that meet stated and implied needs when used under specified conditions"@en ;
    skos:example "Ontology successfully answers 48 of 50 competency questions, achieving 96% functional suitability score."@en .

reliability:GenerationVerificationAsymmetry a owl:Class ;
    rdfs:label "Generation-Verification Asymmetry"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NEEDS_EXPERT_REVIEW: a reliability ontology-native concept. Related to generation-discrimination gap in cognitive science."@en ;
    rdfs:comment "Structural mismatch between generation (creative, expansive) and verification (adversarial, skeptical). LLMs perform both in same forward pass with generation momentum carrying through."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf reliability:MetaReliability ;
    skos:definition "Structural mismatch between generation (creative, expansive) and verification (adversarial, skeptical). LLMs perform both in same forward pass with generation momentum carrying through."@en ;
    skos:example "SE math 0.80 was generated in formula context creating semantic plausibility. Verification checked it LOOKED right, not that it WAS right (actual: 1.16)."@en .

reliability:GroundingScore a owl:Class ;
    rdfs:label "Grounding Score"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ji, Z., et al. (2023). Survey of Hallucination in Natural Language Generation. ACM Computing Surveys."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf reliability:LLMReliabilityMetric ;
    skos:definition "An LLM reliability metric that quantifies the degree to which generated output is anchored to verifiable source material, computed as the proportion of claims that can be traced to specific evidence objects in the knowledge base or input context."@en ;
    skos:example "Generated report achieves 0.91 grounding score: 43 of 47 claims traced to specific source paragraphs."@en .

reliability:ITServiceManagementPhase a owl:Class ;
    rdfs:label "IT Service Management Phase"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ITIL Foundation: ITIL 4 Edition (2019). Axelos."@en ;
    rdfs:comment "Operational phase encompassing incident management, problem management, service request fulfillment, and service desk automation in IT environments."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf reliability:LifecyclePhase ;
    skos:definition "Operational phase encompassing incident management, problem management, service request fulfillment, and service desk automation in IT environments."@en ;
    skos:example "AI agent triaging a P1 incident by analyzing logs, correlating alerts, and recommending root cause and mitigation steps."@en .

reliability:IncompletePropertyDrift a owl:Class ;
    rdfs:label "Incomplete Property Drift"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "AUDIT F5 empirical finding, 2026-05-13. OWL 2 Web Ontology Language Direct Semantics (W3C Recommendation 2012) §2.3.2 property axioms; IEEE 1320.2-1998 IDEF1X data-model completeness."@en ;
    rdfs:comment "An owl:ObjectProperty or owl:DatatypeProperty declared without rdfs:domain and/or rdfs:range. Creates ambiguity in cross-ontology reasoning: a property with no domain admits any subject; with no range admits any object. Empirically observed: 31 of 380 object properties (8%) in the OE corpus have incomplete domain/range, concentrated in core_v1_1_7.ttl (7/10 incomplete) and ae_v1_0_0.ttl (15/22 — user-authored, intentional polymorphism)."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:OntologyStructuralPathology ;
    skos:definition "An owl:ObjectProperty or owl:DatatypeProperty declared without rdfs:domain and/or rdfs:range. Creates ambiguity in cross-ontology reasoning: a property with no domain admits any subject; with no range admits any object. Empirically observed: 31 of 380 object properties (8%) in the OE corpus have incomplete domain/range, concentrated in core_v1_1_7.ttl (7/10 incomplete) and ae_v1_0_0.ttl (15/22 — user-authored, intentional polymorphism)."@en .

reliability:InteractionCapability a owl:Class ;
    rdfs:label "Interaction Capability"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://www.iso.org/standard/78176.html> ;
    rdfs:comment "Renamed from 'Usability' in ISO 25010:2023. Includes learnability, accessibility, user engagement, and self-descriptiveness"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf reliability:QualityCharacteristic ;
    skos:altLabel "Usability"@en ;
    skos:definition "Degree to which a product or system can be used by specified users to achieve specified goals with effectiveness, efficiency, and satisfaction"@en ;
    skos:example "End users successfully navigate ontology hierarchy and locate relevant classes within 3 clicks in visualization tool."@en .

reliability:IssueLifecycleRecord a owl:Class ;
    rdfs:label "Issue Lifecycle Record"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Phase 2.8 Outcome Tracking, a reliability ontology v2.10.0. Pattern: PMBOK 7th ed. (2021) Lessons Learned Register + ITIL 4 Problem Management Practice + ISO/IEC/IEEE 12207:2017 Software lifecycle processes (§6.3.2 Project Lifecycle Management)."@en ;
    rdfs:comment "A timestamped record of an identified issue across its lifecycle: opening, triage, mitigation, and resolution outcome. Subclass of rel:Problem (ITIL Problem Management) — inherits Problem's audit semantics while adding temporal and outcome-attribution properties. Each instance carries issueIdentifier, openedAt, optionally resolvedAt, hasResolutionOutcome, and remediatedIn."@en ;
    rdfs:isDefinedBy <http://example.org/redo/v2.10.0/issue-lifecycle> ;
    rdfs:subClassOf reliability:Problem ;
    skos:definition "A timestamped record of an identified issue across its lifecycle: opening, triage, mitigation, and resolution outcome. Subclass of rel:Problem (ITIL Problem Management) — inherits Problem's audit semantics while adding temporal and outcome-attribution properties. Each instance carries issueIdentifier, openedAt, optionally resolvedAt, hasResolutionOutcome, and remediatedIn."@en .

reliability:KnownError a owl:Class ;
    rdfs:label "Known Error"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ITIL 4 Foundation (2019), §5.2.7 Problem Management."@en ;
    rdfs:comment "A documented Problem with an identified root cause and a documented WorkAround pending permanent fix. The KnownError record is the bridge between a discovered defect and its eventual resolution."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:Problem ;
    skos:definition "A documented Problem with an identified root cause and a documented WorkAround pending permanent fix. The KnownError record is the bridge between a discovered defect and its eventual resolution."@en ;
    skos:example "KnownError: 'OQuaRE composite score for OQC v2.2.5 cannot be computed without Python wrapper because qc:hasSPARQLImplementation is unpopulated; WorkAround: use score_v15_4.py until v16.x lands generic engine.'"@en .

reliability:LLMComplianceDepth a owl:Class ;
    rdfs:label "LLM Compliance Depth"@en ;
    measurement:hasMeasurementSubject measurement:LLMMeasurementSubject ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology behavioral-reliability research 2026-05: ComplianceDepth taxonomy distinguishing artifact-level (file-internal) vs LLM-level (cross-turn) compliance depth. Per L-44 vocabulary self-audit blindspot study."@en ;
    rdfs:comment "ComplianceDepth specialized for LLM-output reliability assessment — the original scope of redo:ComplianceDepth as introduced in a reliability ontology v2.8.0. Levels: L0 absent, L1 ritual (mentioned), L2 procedural (check executed), L3 substantive (issue found and fixed), L4 verified (independent confirmation by human expert). Use this class explicitly when the subject of measurement is an LLM completion."@en ;
    rdfs:isDefinedBy <http://example.org/reliability/v2_11_0_compliance_depth_taxonomy> ;
    rdfs:subClassOf reliability:ComplianceDepth ;
    skos:definition "ComplianceDepth specialized for LLM-output reliability assessment — the original scope of redo:ComplianceDepth as introduced in a reliability ontology v2.8.0. Levels: L0 absent, L1 ritual (mentioned), L2 procedural (check executed), L3 substantive (issue found and fixed), L4 verified (independent confirmation by human expert). Use this class explicitly when the subject of measurement is an LLM completion."@en ;
    skos:example "L1: prompt mentions 'be careful'. L2: prompt instructs a specific check. L3: check found and fixed an issue. L4: independent verification confirms."@en .

reliability:LightweightHallucinationDetector a owl:Class ;
    rdfs:label "Lightweight Hallucination Detector"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Belyi et al. 2025, Luna: A Lightweight Evaluation Model to Catch Language Model Hallucinations, COLING 2025 Industry Track"@en ;
    rdfs:comment "A class of compact, fine-tuned encoder models designed for real-time hallucination detection in RAG settings, optimizing for accuracy, low latency, and low cost simultaneously. Unlike prompt-based approaches using large LLMs, these specialized detectors (e.g., Luna using DeBERTa-large) achieve comparable accuracy with 97% cost reduction and millisecond inference speed."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://aclanthology.org/2025.coling-industry.34/> ;
    rdfs:subClassOf reliability:DetectionMechanism ;
    skos:definition "A class of compact, fine-tuned encoder models designed for real-time hallucination detection in RAG settings, optimizing for accuracy, low latency, and low cost simultaneously. Unlike prompt-based approaches using large LLMs, these specialized detectors (e.g., Luna using DeBERTa-large) achieve comparable accuracy with 97% cost reduction and millisecond inference speed."@en ;
    skos:example "Luna, a 440M parameter DeBERTa-large encoder fine-tuned for hallucination detection, outperforms GPT-3.5 and commercial frameworks like RAGAS with 91% latency reduction."@en .

reliability:LiteralTypingDrift a owl:Class ;
    rdfs:label "Literal Typing Drift"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology DRIFT-19 documentation 2026-05: literal-typing drift surfaces when rdf:type or rdfs:range references datatypes outside OWL 2 DL profile (xsd:date, xsd:duration, xsd:gYear). Per BP-D18."@en ;
    rdfs:comment "A Drift sub-class capturing the literal-typing defect pattern P1 (lang-tagged literal on a DatatypeProperty with strict-XSD rdfs:range, e.g., \"text\"@en on a property with rdfs:range xsd:string, causing HermiT-INCONSISTENT under OWL DL). Formalized in BP-D18 (catalogue v1.0.6.0). 8 historical instances are attributed below to provide the same Phase-2.7-style detection record as the OWL2DLProfileDrift cases."@en ;
    rdfs:isDefinedBy <http://example.org/reliability/v2_10_0_phase29_followup> ;
    rdfs:subClassOf reliability:Drift ;
    skos:definition "A Drift sub-class capturing the literal-typing defect pattern P1 (lang-tagged literal on a DatatypeProperty with strict-XSD rdfs:range, e.g., \"text\"@en on a property with rdfs:range xsd:string, causing HermiT-INCONSISTENT under OWL DL). Formalized in BP-D18 (catalogue v1.0.6.0). 8 historical instances are attributed below to provide the same Phase-2.7-style detection record as the OWL2DLProfileDrift cases."@en .

reliability:Maintainability a owl:Class ;
    rdfs:label "Maintainability"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://www.iso.org/standard/78176.html> ;
    rdfs:comment "Includes modularity, reusability, analyzability, modifiability, and testability"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:QualityCharacteristic ;
    owl:equivalentClass qc:Maintainability ;
    skos:definition "Maintainability is a quality characteristic from ISO 25010 that measures the degree of effectiveness and efficiency with which a system can be modified, corrected, adapted, or improved by maintenance personnel."@en ;
    skos:example "High maintainability is indicated by modular code with clear interfaces, comprehensive documentation, and automated test suites enabling confident refactoring."@en,
        "System achieves maintainability index of 85 with modular architecture enabling component updates without full redeployment."@en .

reliability:MaximumCalibrationError a owl:Class ;
    rdfs:label "Maximum Calibration Error (MCE)"@en ;
    measurement:hasMeasurementSubject measurement:LLMMeasurementSubject ;
    reliability:hasUnit "ratio (0.0 to 1.0)" ;
    reliability:measuresAttribute reliability:ConfidenceMiscalibration ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Geng et al. (2024). A Survey of Confidence Estimation and Calibration in Large Language Models. NAACL 2024."@en ;
    rdfs:comment """Worst-case bin deviation: MCE = max_i |acc(Bᵢ) - conf(Bᵢ)|. 
    Complementary to ECE by emphasizing maximum rather than average miscalibration. 
    Particularly relevant for high-stakes applications where worst-case guarantees 
    matter more than average behavior."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf measurement:LLMReliabilityMetric ;
    skos:definition """MaximumCalibrationError measures the worst-case confidence-accuracy misalignment 
    across all calibration bins, providing a complementary perspective to ECE that emphasizes 
    maximum rather than average miscalibration."""@en ;
    skos:example "Example: ex:mce_gpt4_medical a redo:MaximumCalibrationError ; rdfs:label \"GPT-4 Medical Domain MCE\" ; redo:hasValue 0.18 ; redo:hasConfidence 0.95 . Interpretation: the worst-case bin miscalibration is 18%, meaning at least one confidence bucket deviates by 18 percentage points from observed accuracy."@en .

reliability:Metric a owl:Class ;
    rdfs:label "Metric"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2 — backfilled to declare the type-class used by reliability:Metric_* individuals (C7+ TypeDeclarationShape fix, P1)."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:ReliabilityConcept ;
    skos:definition "A quantitative measurement used to assess a reliability-relevant property of a system, process, or artefact. Instances include coverage metrics, error rates, and other quantitative reliability indicators."@en .

reliability:MidGenerationStage a owl:Class ;
    rdfs:label "Mid-Generation Stage"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NEEDS_EXPERT_REVIEW: a reliability ontology-native stage. Related to incremental verification in continuous integration practices."@en ;
    rdfs:comment "Periodic pause during generation (every 500 words or after each subsection) for incremental checks. Prevents compound error propagation."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf reliability:VerificationStage ;
    skos:definition "Periodic pause during generation (every 500 words or after each subsection) for incremental checks. Prevents compound error propagation."@en ;
    skos:example "After each metric card: immediately compute the worked example with actual arithmetic."@en .

reliability:Mitigation a owl:Class ;
    rdfs:label "Mitigation"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2 — backfilled to declare the type-class used by reliability:Mit_* individuals (C7+ fix, P1). Aligns with risk:Mitigation in the risk subject."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:ReliabilityConcept ;
    skos:definition "A planned or executed action intended to reduce a reliability risk, fault, or quality degradation. Distinct from risk:Mitigation in scope (reliability-engineering measures vs general-risk treatments) but compatible."@en .

reliability:MitigationConcept a owl:Class ;
    rdfs:label "Mitigation Concept"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "IEEE 1633-2016 Recommended Practice on Software Reliability; ISO 31000:2018 Risk Management."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf reliability:Concept ;
    skos:definition "An abstract organizational concept grouping the strategies, techniques, and practices employed to reduce the likelihood or impact of reliability failures, serving as the conceptual foundation for specific mitigation strategy implementations."@en ;
    skos:example "Defense-in-depth strategy combining input validation, output verification, and human review as layered mitigation concepts."@en .

reliability:MitigationStrategy a owl:Class ;
    rdfs:label "Mitigation Strategy"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Lyu, M.R. 1996, Handbook of Software Reliability Engineering, McGraw-Hill" ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf core:Process ;
    skos:definition "MitigationStrategy is a top-level category for all engineering approaches, design patterns, and operational practices employed to prevent, detect, contain, or recover from reliability failures in software and AI systems."@en ;
    skos:example "Circuit breaker pattern prevents cascading failures by stopping requests to degraded service after 5 consecutive failures."@en,
        "Implementing chain-of-thought verification to mitigate single-pass hallucination in LLM outputs."@en .

reliability:ModelChecking a owl:Class ;
    rdfs:label "Model Checking"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Baier, C., & Katoen, J.-P. (2008). Principles of Model Checking. MIT Press."@en ;
    rdfs:comment "Exhaustively explores state space to verify properties"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-319-10575-8> ;
    rdfs:subClassOf reliability:FormalVerification ;
    skos:definition "ModelChecking is an automated verification technique for finite-state systems against temporal logic specifications, exhaustively exploring all possible system states to verify properties such as safety (bad states never occur) and liveness (good states eventually occur), providing formal guarantees of correctness."@en ;
    skos:example "Using SPIN model checker to verify that a distributed consensus protocol satisfies the safety property 'no two nodes accept conflicting values' across all possible interleavings."@en .

reliability:MultiSessionMemoryRetention a owl:Class ;
    rdfs:label "Multi-Session Memory Retention"@en ;
    measurement:hasMeasurementSubject measurement:LLMMeasurementSubject ;
    reliability:hasUnit "ratio (0.0 to 1.0)" ;
    reliability:measuresAttribute reliability:ArchitecturalDrift ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "LoCoBench: MMR metric for cross-session constraint recall" ;
    rdfs:comment """Adapted from LoCoBench MMR metric. Measures the fraction
    of architectural constraints from session N that are correctly maintained
    in session N+k. Quantifies the rate of architectural drift across
    interaction boundaries. MMR < 0.7 indicates significant constraint
    loss requiring re-establishment of architectural context."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf measurement:LLMReliabilityMetric ;
    skos:definition """Fraction of architectural constraints established in
    earlier LLM interaction sessions that are correctly maintained and
    applied in subsequent sessions, quantifying the rate of constraint
    degradation across session boundaries"""@en ;
    skos:example "LLM maintains 78% factual consistency across 5 conversation sessions about the same ontology domain over 48 hours."@en .

reliability:NarrativeChallengeProtocol a owl:Class ;
    rdfs:label "Narrative Challenge Protocol"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Forensic analysis of GamifyOnt/G4E validation conversation, February 2026. Related: Nickerson (1998) confirmation bias review."@en ;
    rdfs:comment """Mitigation strategy requiring periodic adversarial challenge of the 
    assessment narrative during extended evaluation sessions. At defined 
    intervals (e.g., after each major assessment dimension), the assessor 
    must explicitly ask: 'What evidence would contradict my current 
    conclusion? Have I looked for it?'
    
    Prevents NarrativeAnchoring by forcing the assessor to seek 
    disconfirming evidence rather than only confirming evidence.
    
    Aligned with OQC AssessmentActivity and a reliability ontology AdversarialTesting."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf reliability:FailureMitigation ;
    skos:definition """Mitigation strategy requiring periodic adversarial challenge of the 
    assessment narrative during extended evaluation sessions. At defined 
    intervals (e.g., after each major assessment dimension), the assessor 
    must explicitly ask: 'What evidence would contradict my current 
    conclusion? Have I looked for it?'
    
    Prevents NarrativeAnchoring by forcing the assessor to seek 
    disconfirming evidence rather than only confirming evidence.
    
    Aligned with OQC AssessmentActivity and a reliability ontology AdversarialTesting."""@en ;
    skos:example """After scoring Consistency at 98%, the assessor must ask: 'What would 
    make Consistency score higher? Have I attempted formal reasoner execution? 
    If not, why not — is it genuinely impossible, or have I not tried?'"""@en .

reliability:NetworkManagementPhase a owl:Class ;
    rdfs:label "Network Management Phase"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NEEDS_EXPERT_REVIEW: Derived from network management standards (ISO/IEC 7498-4, FCAPS model)."@en ;
    rdfs:comment "Operational phase covering network configuration synthesis, fault localization, topology management, and compliance verification."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf reliability:LifecyclePhase ;
    skos:definition "Operational phase covering network configuration synthesis, fault localization, topology management, and compliance verification."@en ;
    skos:example "LLM generating firewall rules from natural language policy descriptions, with risk of fabricating non-existent interfaces or conflicting ACL entries."@en .

reliability:NonDeterministicBehavior a owl:Class ;
    rdfs:label "Non-Deterministic Behavior"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Liu et al. 2025, Advances and challenges in foundation agents, arXiv:2504.01990"@en ;
    rdfs:comment "The inherent property of LLM-based systems to produce variable outputs for identical inputs due to stochastic sampling, temperature settings, and probabilistic token selection. Non-deterministic behavior necessitates reliability metrics that account for output variance across repeated executions."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://arxiv.org/abs/2504.01990> ;
    rdfs:subClassOf reliability:LLMCharacteristic ;
    skos:definition "The inherent property of LLM-based systems to produce variable outputs for identical inputs due to stochastic sampling, temperature settings, and probabilistic token selection. Non-deterministic behavior necessitates reliability metrics that account for output variance across repeated executions."@en ;
    skos:example "The same prompt may yield different responses across runs, requiring metrics like Pass@all or Cover@tau to measure consistency rather than single-shot accuracy."@en .

reliability:OWL2DLProfileDrift a owl:Class ;
    rdfs:label "OWL 2 DL Profile Drift"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology ontology-engineering research: OWL 2 DL profile drift surfaces when an ontology asserted to be OWL 2 DL contains constructs that move it to OWL 2 Full (untyped lists, datatypes outside the OWL 2 DL datatype map, metamodeling without punning)."@en ;
    rdfs:comment "A Drift sub-class capturing OWL 2 DL profile violations such as type-punning between owl:ObjectProperty and owl:DatatypeProperty. Previously used in SHACL shape DRIFT17_InstanceShape (redo_shacl_v2_0_13_1.ttl) without an OWL class declaration, causing BP-D16 P5 direction mismatch on hasSeverity domain. Phase 2.9 declares it formally as a Drift subclass to align shape target with property domain."@en ;
    rdfs:isDefinedBy <http://example.org/reliability/v2_10_0_phase29_followup> ;
    rdfs:subClassOf reliability:Drift ;
    skos:definition "A Drift sub-class capturing OWL 2 DL profile violations such as type-punning between owl:ObjectProperty and owl:DatatypeProperty. Previously used in SHACL shape DRIFT17_InstanceShape (redo_shacl_v2_0_13_1.ttl) without an OWL class declaration, causing BP-D16 P5 direction mismatch on hasSeverity domain. Phase 2.9 declares it formally as a Drift subclass to align shape target with property domain."@en .

reliability:OntologyDrivenOverstatement a owl:Class ;
    rdfs:label "Ontology-Driven Overstatement"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.12 — derived from v97_scoring_system_audit.md §0 Q2 + §7 (2026-05-01): GPPT v76-v97 sprint commentary describes the system as 'ontology-driven' / 'TTL is source of truth'; static source analysis shows the TTL is parsed by build-time tools (codegen, drift gate, SHACL) for cross-validation of names and metadata only — the actual D-score formulas, dim caps, field-to-dim mappings, and per-field rule maxes are exclusively in JS literals."@en ;
    rdfs:comment "A claim that a system is ontology-driven, ontology-aware, or driven-by-the-TTL is made when in fact the ontology serves as documentation + drift-detection anchor only, and the runtime computation does not consume the ontology. The overstatement is itself a Drift because it propagates a misleading invariant across sprint commentary."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:Drift,
        reliability:OutputFidelityDrift ;
    skos:definition "A drift pathology in which 'ontology-driven' or equivalent terminology is applied to a system whose runtime does not actually consume the ontology graph for its computations, leading users to over-trust the spec coverage of the ontology."@en ;
    skos:example "GPPT v97: TTL contains 8 :Component instances (5 D2 + 3 D7) but JS GRADING_ONTOLOGY literal claims ~22 components covering D1-D8. _ontDimCap calls are functionally inert (every call passes a hardcoded fallback equal to the value). v97_scoring_system_audit.md flags this MEDIUM-severity. Honest framing: 'JS-implemented scoring engine with an aligned TTL spec and drift safeguards', not ontology-executed."@en .

reliability:OperationalImpact a owl:Class ;
    rdfs:label "Operational Impact"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/62085.html> ;
    rdfs:subClassOf reliability:BusinessImpact ;
    skos:definition "OperationalImpact is a business impact category that measures the degree to which a reliability failure disrupts day-to-day business operations, service delivery, and organizational workflow continuity."@en ;
    skos:example "Service disruption, productivity loss, workflow interruption"@en .

reliability:OptionalityCreep a owl:Class ;
    rdfs:label "Optionality Creep"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Forensic analysis of OE Pack session, 2026-05-13: user named the pattern after observing 'is also defensible' wiggle-room reopening the 3-file canonical rule. Cognitive psychology grounding: Tversky & Kahneman 1974 (anchoring, Science 185:1124); Cialdini 2007 (commitment escalation). Software engineering: IEEE 1028-2008 review-process discipline preventing scope creep through informal amendments."@en ;
    rdfs:comment "Distinguished from FalseDichotomyDrift's parent (multiple-choice framing presupposing a false defect): OptionalityCreep is the LANGUAGE-level mechanism, the phrasing in prose. The user's diagnosis (this session, 2026-05-13): drift through vague questions is well-documented in cognitive psychology (Kahneman anchoring, Cialdini commitment escalation, Lakoff framing) and in software engineering (Fowler design erosion). Mitigated by OptionalityLanguageLint."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:FalseDichotomyDrift ;
    skos:definition "The linguistic mechanism by which a settled rule is reopened through hedging language. Specific phrasings: 'would benefit from', 'is also defensible', 'weakly held', 'could stay X-form', 'the recommendation is yours', applied to a binding decision rather than a genuinely open empirical question. Each instance individually appears benign and helpful, but the cumulative effect is to relitigate decisions one re-anchoring at a time, eroding the rule structure the discipline is meant to enforce."@en .

reliability:OrphanClassDrift a owl:Class ;
    rdfs:label "Orphan Class Drift"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "AUDIT F11 empirical finding, 2026-05-13. Ontology cohesion principles per NeOn Methodology (Suárez-Figueroa, Gómez-Pérez, Fernández-López 2012); structural completeness per IEEE 1471/ISO 42010 architectural-description quality attributes."@en ;
    rdfs:comment "A class declared at the top level of a subject ontology that does NOT subClassOf the ontology's intended root (e.g., META's OntologyEngineeringConcept) and is not itself an umbrella concept. Empirically observed: META has 17 orphan top-level classes (Alignment, CodeCoverage, Collaboration, DevelopmentProcess, Editor, Evolution, Lifecycle, Mapping, MemoryUsage, Methodology, QueryResponseTime, Reasoner, ReasoningTime, Reviewer, SymbioticOntologyModel, Team, Tool) that should hang under OntologyEngineeringConcept but were never linked."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:OntologyStructuralPathology ;
    skos:definition "A class declared at the top level of a subject ontology that does NOT subClassOf the ontology's intended root (e.g., META's OntologyEngineeringConcept) and is not itself an umbrella concept. Empirically observed: META has 17 orphan top-level classes (Alignment, CodeCoverage, Collaboration, DevelopmentProcess, Editor, Evolution, Lifecycle, Mapping, MemoryUsage, Methodology, QueryResponseTime, Reasoner, ReasoningTime, Reviewer, SymbioticOntologyModel, Team, Tool) that should hang under OntologyEngineeringConcept but were never linked."@en .

reliability:OverconfidenceRate a owl:Class ;
    rdfs:label "Overconfidence Rate"@en ;
    measurement:hasMeasurementSubject measurement:LLMMeasurementSubject ;
    reliability:hasUnit "ratio (0.0 to 1.0)" ;
    reliability:measuresAttribute reliability:Overconfidence ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Xiong, M. et al. (2024). Can LLMs Express Their Uncertainty? ICLR 2024."@en ;
    rdfs:comment """Measures the proportion of model outputs where expressed confidence exceeds 
    actual accuracy. Adapted from verbalized confidence elicitation methods. Computation: 
    sample N responses with verbalized confidence scores, verify correctness independently, 
    compute ratio where confidence > accuracy."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf measurement:LLMReliabilityMetric ;
    skos:definition """OverconfidenceRate measures the fraction of LLM responses where the model's 
    expressed or inferred confidence exceeds its actual accuracy, adapted from Xiong et al.'s 
    confidence elicitation framework."""@en ;
    skos:example "Out of 100 responses where model expressed >90% confidence, only 68 were correct, yielding an overconfidence rate of 0.32."@en .

reliability:ParallelSessionLineageFork a owl:Class ;
    rdfs:label "Parallel Session Lineage Fork"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "OE_Ecosystem_Corrections_v1_0_0.md GB-1 governance bug, 2026-05-13. Version control branching anti-patterns per IEEE 828-2012 §5.4 (Configuration Identification) and NIST SP 800-128 (Guide for Security-Focused Configuration Management)."@en ;
    rdfs:comment "The fork can be detected mechanically: when a new PATCH version is authored that does not declare owl:priorVersion linking to the highest-numbered predecessor on disk, a fork is suspected. Pre-emptively prevented by requiring all session-start preflights to identify the current canonical and refuse to author a sibling."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:GovernanceTrustDrift ;
    skos:definition "A drift pathology in which two or more concurrent authoring sessions both extend the same governance artifact (typically the discipline catalogue) and produce divergent successor versions. Each session believes it is extending the latest canonical; the result is a fork of the lineage with no merge mechanism. Empirically observed in this corpus: parallel session produced catalogue v1.0.5.11 while the main session produced v1.0.7.x; the two never reconciled. Mitigated by LinearLineageEnforcement."@en .

reliability:PartialReadDrift a owl:Class ;
    rdfs:label "Partial Read Drift"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.12 — derived from conversation_audit_v1_0_0.md §3.2 Phase F D-4 (2026-05-01): claim of 'filename-vs-versionInfo mismatch (filename says 3.2.4, content says 3.2.3)' on variant_algebra_v3_2_4.ttl was based on regex hit on the FIRST owl:versionInfo (a sub-ontology block declaring 3.2.3) rather than the main ontology declaration at line 2390 declaring 3.2.4. The 'defect' was a partial-read artifact, not a real defect."@en ;
    rdfs:comment "Conclusion drawn from incomplete or first-match-only reading of an artefact. Especially common with grep, regex, or any string-search-based 'verification' that does not require reading the full file. Mitigated by C5 empirical-test discipline: read the bytes that decide, not the bytes that match first."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:Drift,
        reliability:InputProcessingDrift ;
    skos:definition "A drift pathology in which a verdict is reached on the basis of a partial scan of the source artefact (first regex match, head-of-file inspection, summary-only read) where the dispositive evidence lies elsewhere in the same file. Often presented to the user with high apparent confidence."@en ;
    skos:example "A 176kB Turtle file contains both a sub-ontology block (versionInfo 3.2.3) early in the file and the main ontology declaration (versionInfo 3.2.4) at line 2390; a regex on the first owl:versionInfo match misclassifies the file as version-mismatched. Severity MEDIUM. Mitigation: read the FULL file before claiming a defect."@en .

reliability:PostGenerationStage a owl:Class ;
    rdfs:label "Post-Generation Stage"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NEEDS_EXPERT_REVIEW: a reliability ontology-native stage. Related to post-hoc verification and red-teaming practices."@en ;
    rdfs:comment "After all content generated: comprehensive verification covering cross-reference consistency, structural integrity, adversarial red-team pass."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf reliability:VerificationStage ;
    skos:definition "After all content generated: comprehensive verification covering cross-reference consistency, structural integrity, adversarial red-team pass."@en ;
    skos:example "After full HTML page: run section balance, link resolution, citation verification, adversarial audit."@en .

reliability:PostIncidentReview a owl:Class ;
    rdfs:label "Post-Incident Review"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Beyer et al. (2016) Site Reliability Engineering §15."@en ;
    rdfs:comment "A specific subtype of Postmortem conducted after a production incident, with structured agenda: timeline reconstruction, root cause analysis, corrective action assignment, lessons learned capture. PIR outputs typically populate a KnowledgeBase via LessonsLearned articles."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:Postmortem ;
    skos:definition "A specific subtype of Postmortem conducted after a production incident, with structured agenda: timeline reconstruction, root cause analysis, corrective action assignment, lessons learned capture. PIR outputs typically populate a KnowledgeBase via LessonsLearned articles."@en .

reliability:PreDeliveryStage a owl:Class ;
    rdfs:label "Pre-Delivery Stage"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NEEDS_EXPERT_REVIEW: a reliability ontology-native stage. Analogous to release gate in DevOps pipelines."@en ;
    rdfs:comment "Final gate before user delivery. Web search top-N claims. Compute all examples. Declare compliance depth."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf reliability:VerificationStage ;
    skos:definition "Final gate before user delivery. Web search top-N claims. Compute all examples. Declare compliance depth."@en ;
    skos:example "Before presenting output: web-search 5 most impactful statistics, compute all calculator defaults, declare compliance level."@en .

reliability:PreGenerationStage a owl:Class ;
    rdfs:label "Pre-Generation Stage"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NEEDS_EXPERT_REVIEW: a reliability ontology-native stage. Conceptually related to pre-flight checklists (Gawande, 2009. The Checklist Manifesto)."@en ;
    rdfs:comment "Before writing, list all claims needing external verification. Plan which tool verifies each."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf reliability:VerificationStage ;
    skos:definition "Before writing, list all claims needing external verification. Plan which tool verifies each."@en ;
    skos:example "Before metrics section: list formulas requiring computation, citations requiring DOI resolution, statistics requiring web search."@en .

reliability:PreflightInputDrift a owl:Class ;
    rdfs:label "Pre-flight Input Drift"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.12 — derived from conversation_audit_v1_0_0.md §3.2 Phase E D-3 (2026-05-01): vaf_package_v1_0_0 was built using stale variant_algebra_v3_2_2.ttl without first asking whether a newer version existed. User caught: 'Are you sure the files are up to date? I have the attached ontology files, your package contains variant_algebra_v3_2_2.ttl.'"@en ;
    rdfs:comment "The agent proceeds with a stated plan without verifying that the input set is current. Often surfaces when the user has authored newer artefacts in a parallel session that the current session is unaware of. Detection: pre-flight discipline 'Ask for missing files before you start'."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:Drift,
        reliability:InputProcessingDrift ;
    skos:definition "A drift pathology in which work is begun on a deliverable without first verifying that the input artefacts are the most recent versions, leading to downstream rework when newer inputs surface. Distinguishable from CountDrift in that the artefacts themselves are stale, not just the counts of their contents."@en ;
    skos:example "an algebraic framework package v1.0.0 used v3.2.2 ontology; v3.2.4 was already authored. Remediated in package v1.0.1 (v3.2.4 promoted to current, v3.2.2 demoted to archive). Severity HIGH (workflow) because it nullified ~40% of the v1.0.0 build effort."@en .

reliability:Probability a owl:Class ;
    rdfs:label "Probability"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO 3534-1:2006 §1.6.4 statistics — vocabulary."@en ;
    rdfs:comment "Real number in [0,1] assigned to a random event such that the laws of probability theory apply. Quantitative refinement of redo:Likelihood."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:Likelihood ;
    skos:definition "Real number in [0,1] assigned to a random event such that the laws of probability theory apply. Quantitative refinement of redo:Likelihood."@en .

reliability:ProceduralCompliance a reliability:ComplianceDepth,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Procedural Compliance (Level 2)"@en ;
    reliability:complianceLevel 2 ;
    reliability:measures qc:Reliability ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NEEDS_EXPERT_REVIEW: a reliability ontology-native metric inspired by CMMI maturity levels (SEI, 2010)."@en ;
    rdfs:comment "Specific verification procedure executed with documented results."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:DecorativeCompliance ;
    skos:definition "Specific verification procedure executed with documented results."@en .

reliability:Process a owl:Class ;
    rdfs:label "Process"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2 — backfilled to declare the type-class used by reliability:Process_* individuals (C7+ fix, P1)."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:ReliabilityConcept ;
    skos:definition "A defined sequence of activities conducted as part of reliability engineering or release management (e.g. release processes, validation processes, review processes)."@en .

reliability:ProductionBenchmarkParadox a owl:Class ;
    rdfs:label "Production-Benchmark Paradox"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Observed across ITBench (11-25%) vs BiAn (95.5%), ITSM benchmarks vs production deployments"@en ;
    rdfs:comment "Systematic overconfidence arising when production deployment success rates (achieved through fine-tuning, domain constraints, human-in-the-loop) are generalized to unconstrained LLM capability. Constrained systems (e.g., BiAn 95.5%) vastly outperform general benchmarks (e.g., ITBench 11.4%) on the same task class, creating misleading expectations."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf reliability:ConfidenceMiscalibration ;
    skos:definition "Systematic overconfidence arising when production deployment success rates (achieved through fine-tuning, domain constraints, human-in-the-loop) are generalized to unconstrained LLM capability. Constrained systems (e.g., BiAn 95.5%) vastly outperform general benchmarks (e.g., ITBench 11.4%) on the same task class, creating misleading expectations."@en ;
    skos:example "Vendor claims '95% accuracy in fault localization' based on production deployment, but general-purpose agents achieve 11% on ITBench SRE scenarios. The gap is due to fine-tuning, domain constraints, and human oversight — not inherent LLM capability."@en .

reliability:PromptInheritedViolation a owl:Class ;
    rdfs:label "Prompt-Inherited Violation"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source """OWB Sprint v3.0 post-mortem, April 2026.
AMOD HtmlArtifactConvention violation propagated from sprint prompt
across 4 rounds. a reliability ontology v2.5.3 had no named pathology for this vector.
Related: CompoundErrorPropagation (Prompt 1 error becomes load-bearing
across subsequent prompts, per RC-6)."""@en ;
    rdfs:comment """LLM behavioral pathology in which a non-compliant
artifact specification supplied by the user in the prompt (sprint manifest
entry, filename, version string) is adopted verbatim and propagated
through all subsequent sprint rounds without being validated against
the declared constraint framework (e.g., AMOD NamingConvention).

Distinct from CompoundErrorPropagation in origin: the error starts in
user-provided input, not in the LLM's prior output. The LLM's compliance
instinct (follow user instructions) overrides its constraint-checking
instinct (validate against active safeguard). This is a cross-layer
failure: the user-facing manifest layer and the constraint-validation
layer are not connected at Stage 1.

Detection: Stage 1 manifest validation against AMOD NamingConvention
before any work begins. Every SPRINT_MANIFEST entry must be validated
against its applicable configuration:NamingConvention pattern — including
entries supplied by the user in the sprint prompt.

Prevention: redo:Stage1ManifestValidationProtocol."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:LLMBehavioralPathology ;
    owl:disjointWith reliability:EffortAvoidanceBias,
        reliability:SycophanticReversal ;
    skos:definition """LLM behavioral pathology in which a non-compliant
artifact specification supplied by the user in the prompt (sprint manifest
entry, filename, version string) is adopted verbatim and propagated
through all subsequent sprint rounds without being validated against
the declared constraint framework (e.g., AMOD NamingConvention).

Distinct from CompoundErrorPropagation in origin: the error starts in
user-provided input, not in the LLM's prior output. The LLM's compliance
instinct (follow user instructions) overrides its constraint-checking
instinct (validate against active safeguard). This is a cross-layer
failure: the user-facing manifest layer and the constraint-validation
layer are not connected at Stage 1.

Detection: Stage 1 manifest validation against AMOD NamingConvention
before any work begins. Every SPRINT_MANIFEST entry must be validated
against its applicable configuration:NamingConvention pattern — including
entries supplied by the user in the sprint prompt.

Prevention: redo:Stage1ManifestValidationProtocol."""@en ;
    skos:example """Sprint prompt declares:
  SPRINT_MANIFEST: ontology_workbench_v64.html
AMOD HtmlArtifactConvention requires: {name}_v{M}_{m}_{p}.html
LLM accepted v64.html (two-part) without checking format.
Error propagated across 3+ rounds. All GATE_VECTOR verdicts issued
against a non-AMOD-compliant filename. Cost: full sprint rename."""@en .

reliability:QualityAssurance a owl:Class ;
    rdfs:label "Quality Assurance"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC 25000:2014 SQuaRE - Systems and software Quality Requirements and Evaluation."@en ;
    rdfs:comment "Domain encompassing quality management practices and methodologies"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/62085.html> ;
    rdfs:subClassOf reliability:ReliabilityDomain ;
    skos:definition "QualityAssurance is a systematic reliability domain encompassing processes, practices, and methodologies that ensure products and services meet specified requirements, including verification activities, validation testing, process audits, and continuous improvement initiatives aligned with standards like ISO 25000."@en ;
    skos:example "Automated CI pipeline running 350 SHACL validation shapes on every ontology commit with blocking on violations."@en .

reliability:QueryExpansion a owl:Class ;
    rdfs:label "Query Expansion"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Manning, C., Raghavan, P., & Schütze, H. (2008). Introduction to Information Retrieval. Cambridge University Press."@en ;
    rdfs:comment """Addresses topic drift in RAG systems by ensuring retrieved passages 
    align with both query and generated response."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf reliability:FailureMitigation ;
    skos:definition "QueryExpansion is a retrieval-augmented generation (RAG) mitigation strategy that enhances retrieval queries by combining the original user question with preliminary LLM response context, addressing topic drift and improving the relevance of retrieved passages for grounding subsequent generation."@en ;
    skos:example "Original query 'Python error' expanded to include 'Python exception handling', 'traceback', 'debugging Python' for better retrieval."@en .

reliability:RPN a owl:DatatypeProperty ;
    rdfs:label "Risk Priority Number"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "IEC 60812:2018 §3.13 (RPN deprecated in favour of AP in AIAG-VDA 2019, retained here for compatibility)."@en,
        "OE Pack v17.27.0 Challenge 2 — design-intent rdfs:domain extraction. Per skos:definition: \"Risk Priority Number ... Used to prioritise failure modes for mitigation.\" risk:FailureMode is the only FailureMode class."@en ;
    rdfs:domain risk:FailureMode ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:integer ;
    skos:definition "Risk Priority Number = Severity × Occurrence × Detection, each rated 1-10. Used to prioritise failure modes for mitigation. Range 1-1000."@en .

reliability:ReasoningBoundary a owl:Class ;
    rdfs:label "Reasoning Boundary"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Wang et al. 2025, Beyond Pass@k: Breadth-Depth Metrics for Reasoning Boundaries, arXiv:2510.08325"@en ;
    rdfs:comment "The fraction of problems a model can genuinely solve through reasoning rather than lucky guessing, representing the true scope of solvable tasks. Reasoning boundary distinguishes robust capability from variance-dependent success, where high Pass@k at large sampling budgets may reflect random chance rather than genuine understanding."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://arxiv.org/abs/2510.08325> ;
    rdfs:subClassOf reliability:LLMReliability ;
    owl:disjointWith reliability:BenchmarkSaturation,
        reliability:LLMBehavioralPathology ;
    skos:definition "The fraction of problems a model can genuinely solve through reasoning rather than lucky guessing, representing the true scope of solvable tasks. Reasoning boundary distinguishes robust capability from variance-dependent success, where high Pass@k at large sampling budgets may reflect random chance rather than genuine understanding."@en ;
    skos:example "A model with reasoning boundary of 0.7 can genuinely solve 70% of problems through reasoning; success on the remaining 30% at high k values represents lucky guessing rather than capability."@en .

reliability:RedFlagRetrieval a owl:Class ;
    rdfs:label "Red-Flag Retrieval"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Lagarde 2026, VECTR: Towards a Reliability Framework for Agentic AI in Drug Development, ResearchGate"@en ;
    rdfs:comment "VECTR Protocol T4 mandating that AI agents actively search for disconfirming evidence to counter confirmation bias in decision-relevant outputs. This protocol requires systems to seek contradictory information rather than only supporting evidence, essential for maintaining epistemic integrity in high-stakes decisions."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.researchgate.net/publication/399391082> ;
    rdfs:subClassOf reliability:VerificationMethod ;
    skos:definition "VECTR Protocol T4 mandating that AI agents actively search for disconfirming evidence to counter confirmation bias in decision-relevant outputs. This protocol requires systems to seek contradictory information rather than only supporting evidence, essential for maintaining epistemic integrity in high-stakes decisions."@en ;
    skos:example "Before concluding a drug interaction is safe, the agent must actively search for adverse event reports and contraindications, not just supporting clinical trial data."@en .

reliability:RedundancyStrategy a owl:Class ;
    rdfs:label "Redundancy Strategy"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Avizienis et al. (2004). Basic concepts and taxonomy of dependable and secure computing. IEEE TDSC 1(1)."@en ;
    rdfs:comment "Provision of multiple independent means to perform a function so failure of one does not cause failure of the function. Includes hardware redundancy (cold/warm/hot standby), N-version programming, recovery blocks."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:ResiliencePattern ;
    skos:definition "Provision of multiple independent means to perform a function so failure of one does not cause failure of the function. Includes hardware redundancy (cold/warm/hot standby), N-version programming, recovery blocks."@en .

reliability:ReferenceModificationProtocol a owl:Class ;
    rdfs:label "Reference Modification Protocol"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NEEDS_EXPERT_REVIEW: a reliability ontology-native mitigation from v2.4.0 forensic analysis. No external publication."@en ;
    rdfs:comment """A mitigation strategy that governs how citations and 
    references are handled when documents undergo structural changes. The 
    protocol prevents the PathOfLeastResistance pattern of swapping 
    citation labels (minimum effort, fabrication risk) by enforcing a 
    mandatory decision tree before any reference modification.
    
    Core principle: A citation is a verifiable claim about a source's 
    existence. Modifying a citation is therefore subject to the same 
    anti-fabrication safeguards as modifying any factual claim.
    
    Three rules:
    (1) NEVER invent a source to replace a removed source.
    (2) Primary research needs no external citation — label it honestly.
    (3) Every replacement citation must pass existence verification 
        BEFORE being written into the document."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf reliability:FailureMitigation ;
    skos:definition """A mitigation strategy that governs how citations and 
    references are handled when documents undergo structural changes. The 
    protocol prevents the PathOfLeastResistance pattern of swapping 
    citation labels (minimum effort, fabrication risk) by enforcing a 
    mandatory decision tree before any reference modification.
    
    Core principle: A citation is a verifiable claim about a source's 
    existence. Modifying a citation is therefore subject to the same 
    anti-fabrication safeguards as modifying any factual claim.
    
    Three rules:
    (1) NEVER invent a source to replace a removed source.
    (2) Primary research needs no external citation — label it honestly.
    (3) Every replacement citation must pass existence verification 
        BEFORE being written into the document."""@en ;
    skos:example """When restructuring a paper to remove internal framework 
    references, the protocol requires classifying each citation:
    - [1]-[41]: External published sources → keep as-is
    - [42]-[45]: Internal framework versions → classify as primary 
      research, restructure as inline findings, update reference entries 
      to 'Primary research reported in this paper (Section X)'"""@en .

reliability:ReflectionTokens a owl:Class ;
    rdfs:label "Reflection Tokens"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "LLM reliability research corpus: Malmqvist 2024, Ma et al. 2024, Ji et al. 2023 (arXiv:2311.05232)" ;
    rdfs:comment """Training approach where model learns to reflect on its outputs, 
    generating verification signals alongside content."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf reliability:FailureMitigation ;
    skos:definition "ReflectionTokens is a self-verification mechanism where the model generates internal reflection markers alongside its primary output, enabling the system to assess its own confidence levels, identify potential errors, and signal uncertainty through learned verification patterns embedded in the generation process."@en ;
    skos:example "Model generates internal verification tokens '<VERIFY>' before factual claims, triggering source-checking subroutine."@en .

reliability:RegulatoryImpact a owl:Class ;
    rdfs:label "Regulatory Impact"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/62085.html> ;
    rdfs:subClassOf reliability:BusinessImpact ;
    skos:definition "RegulatoryImpact is a business impact category that measures the degree to which reliability failures trigger regulatory sanctions, compliance violations, mandatory reporting obligations, or legal liability exposure."@en ;
    skos:example "Compliance violations, regulatory fines, legal liability"@en .

reliability:ReputationalImpact a owl:Class ;
    rdfs:label "Reputational Impact"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/62085.html> ;
    rdfs:subClassOf reliability:BusinessImpact ;
    skos:definition "ReputationalImpact is a business impact category that measures the degree to which reliability failures damage organizational credibility, brand perception, market positioning, and stakeholder confidence."@en ;
    skos:example "Brand damage, loss of trust, negative publicity"@en .

reliability:Requirement a owl:Class ;
    rdfs:label "Requirement"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29148:2018 Systems and software engineering — Life cycle processes — Requirements engineering."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:Concept ;
    owl:equivalentClass qc:Requirement ;
    skos:definition "A documented condition or capability that a system must satisfy to meet stakeholder needs, regulatory obligations, or quality targets, serving as the basis for design decisions, test criteria, and acceptance validation throughout the engineering lifecycle."@en ;
    skos:example "REQ-REL-007: System shall maintain 99.9% availability measured monthly, excluding planned maintenance windows."@en .

reliability:RequirementsEngineering a owl:Class ;
    rdfs:label "Requirements Engineering"@en ;
    core:precedes reliability:Design ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29148:2018 Systems and software engineering — Life cycle processes — Requirements engineering."@en ;
    rdfs:comment "Foundation phase determining what the system should do"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf reliability:LifecyclePhase ;
    skos:definition "RequirementsEngineering is the systematic process of eliciting, analyzing, specifying, and validating system requirements from stakeholders, ensuring that functional and non-functional requirements including reliability targets are documented, traceable, and verifiable throughout the system development lifecycle."@en ;
    skos:example "Lifecycle phase producing 50 functional requirements and 15 non-functional requirements from stakeholder interviews."@en .

reliability:Reusability a owl:Class ;
    rdfs:label "Reusability"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC 25010:2023 §3.7 Maintainability, §3.7.2 Reusability sub-characteristic; adapted for ontology reuse contexts."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:QualityCharacteristic ;
    owl:equivalentClass qc:Reusability ;
    skos:definition "A quality characteristic measuring the degree to which a system artifact, component, or module can be utilized in more than one system or context with minimal adaptation, encompassing interface clarity, documentation quality, and coupling minimization."@en ;
    skos:example "Core failure taxonomy module reused across 4 domain ontologies (medical, legal, financial, aerospace) with zero modification."@en .

reliability:ReverseAudit a owl:Class ;
    rdfs:label "Reverse Audit"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Forensic analysis of LLM Reliability Safeguarding Guide i18n session, February 2026. V6-V10: 4 versions with 100% forward-audit pass rates and 7 surviving defects."@en ;
    rdfs:comment """A verification technique that searches for the NEGATION of a 
    completeness claim rather than CONFIRMATION of it. For any claim of the 
    form 'all X are Y', reverse audit searches for 'X that are NOT Y' rather 
    than verifying 'X that are Y exist'. This predicate inversion transforms 
    verification from a confirmation task (prone to DecorativeVerification) 
    into a falsification task (resistant to it).
    
    Subclass of VerificationAdequacyGate: the parent class establishes the 
    abstract principle ('verification must detect the specific failure mode'); 
    ReverseAudit operationalizes it for completeness/absence claims through 
    a specific technique: predicate inversion.
    
    The technique applies to any verification where the claim structure is:
    - 'All items are translated' → Search for UNTRANSLATED items
    - 'All references are updated' → Search for STALE references  
    - 'All tests pass' → Search for FAILING conditions (mutation testing)
    - 'All imports are valid' → Search for INVALID imports
    - 'All citations exist' → Search for NON-EXISTENT citations
    
    Formal structure:
    Given claim C: ∀x ∈ S. P(x)
    Forward audit (decorative): ∃x ∈ S. P(x)  [confirms some satisfy P]
    Reverse audit (adequate):   ∃x ∈ S. ¬P(x) [searches for violations]
    
    If reverse audit returns ∅, the claim is substantively verified.
    If forward audit returns non-∅, the claim is only weakly supported.
    
    Protocol:
    1. State the completeness claim explicitly:
       'All visible text has Turkish translation when TR mode is active'
    2. Negate the predicate:
       'Visible text that does NOT have Turkish translation'
    3. Design the search to find violations:
       'Find all English text nodes outside translated containers'
    4. Execute: if results = ∅, claim verified. If results ≠ ∅, fix and repeat.
    5. The reverse audit itself becomes the regression test.
    
    Relationship to mutation testing (analogical): mutation testing inverts 
    the test adequacy question from 'do tests pass?' to 'do tests FAIL when 
    code is mutated?'. ReverseAudit applies the same inversion principle to 
    verification in general.
    
    Why forward-only verification fails:
    Forward audit for 'all X are Y' checks ∃x.P(x) — which succeeds as soon 
    as ONE translated item is found. It has zero sensitivity to missing items 
    because it never searches for them. The resulting test suite has 100% pass 
    rate and 0% mutation kill rate: removing any single translation leaves all 
    forward checks passing. This is the mechanistic explanation for how 
    DecorativeVerification and TestSuiteTheater co-occur in completeness 
    verification contexts."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/62085.html> ;
    rdfs:subClassOf reliability:VerificationAdequacyGate ;
    skos:definition """A verification technique that searches for the NEGATION of a 
    completeness claim rather than CONFIRMATION of it. For any claim of the 
    form 'all X are Y', reverse audit searches for 'X that are NOT Y' rather 
    than verifying 'X that are Y exist'. This predicate inversion transforms 
    verification from a confirmation task (prone to DecorativeVerification) 
    into a falsification task (resistant to it).
    
    Subclass of VerificationAdequacyGate: the parent class establishes the 
    abstract principle ('verification must detect the specific failure mode'); 
    ReverseAudit operationalizes it for completeness/absence claims through 
    a specific technique: predicate inversion.
    
    The technique applies to any verification where the claim structure is:
    - 'All items are translated' → Search for UNTRANSLATED items
    - 'All references are updated' → Search for STALE references  
    - 'All tests pass' → Search for FAILING conditions (mutation testing)
    - 'All imports are valid' → Search for INVALID imports
    - 'All citations exist' → Search for NON-EXISTENT citations
    
    Formal structure:
    Given claim C: ∀x ∈ S. P(x)
    Forward audit (decorative): ∃x ∈ S. P(x)  [confirms some satisfy P]
    Reverse audit (adequate):   ∃x ∈ S. ¬P(x) [searches for violations]
    
    If reverse audit returns ∅, the claim is substantively verified.
    If forward audit returns non-∅, the claim is only weakly supported.
    
    Protocol:
    1. State the completeness claim explicitly:
       'All visible text has Turkish translation when TR mode is active'
    2. Negate the predicate:
       'Visible text that does NOT have Turkish translation'
    3. Design the search to find violations:
       'Find all English text nodes outside translated containers'
    4. Execute: if results = ∅, claim verified. If results ≠ ∅, fix and repeat.
    5. The reverse audit itself becomes the regression test.
    
    Relationship to mutation testing (analogical): mutation testing inverts 
    the test adequacy question from 'do tests pass?' to 'do tests FAIL when 
    code is mutated?'. ReverseAudit applies the same inversion principle to 
    verification in general.
    
    Why forward-only verification fails:
    Forward audit for 'all X are Y' checks ∃x.P(x) — which succeeds as soon 
    as ONE translated item is found. It has zero sensitivity to missing items 
    because it never searches for them. The resulting test suite has 100% pass 
    rate and 0% mutation kill rate: removing any single translation leaves all 
    forward checks passing. This is the mechanistic explanation for how 
    DecorativeVerification and TestSuiteTheater co-occur in completeness 
    verification contexts."""@en ;
    skos:example """i18n completeness verification:
    CLAIM: 'All visible text translates to Turkish when TR mode is active'
    
    FORWARD AUDIT (V6-V9, decorative):
      Test: 'Zombi İddia' in html → PASS (Turkish exists)
      Test: 'Uydurma' in html → PASS (Turkish exists)  
      Result: 210/210 passed. Declared complete.
      Reality: 7 English defects survived all 4 versions.
      Mutation kill rate: 0% (removing any translation still passes 209/210)
    
    REVERSE AUDIT (V10, adequate):
      Test: Find ALL text nodes outside translated containers
      Test: Find ALL JS functions without currentLang check
      Result: 7 defects found and fixed in single pass.
      Mutation kill rate: ~100% (removing any translation creates a finding)"""@en .

reliability:RootCauseAnalysis a owl:Class ;
    rdfs:label "Root Cause Analysis"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Andersen, B. & Fagerhaug, T. (2006). Root Cause Analysis: Simplified Tools and Techniques, 2nd ed., ASQ Quality Press."@en ;
    rdfs:comment "Systematic process for identifying root causes of Problems or Failures. RCA is a prov:Activity that consumes evidence (Failures, audit logs) and produces RootCause instances and recommended MitigationStrategy / WorkAround instances."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf core:Process ;
    skos:definition "Systematic process for identifying root causes of Problems or Failures. RCA is a prov:Activity that consumes evidence (Failures, audit logs) and produces RootCause instances and recommended MitigationStrategy / WorkAround instances."@en .

reliability:SADI a owl:Class ;
    rdfs:label "Semantics-Adaptive Dynamic Intervention"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "LLM reliability research corpus: Malmqvist 2024, Ma et al. 2024, Ji et al. 2023 (arXiv:2311.05232)" ;
    rdfs:comment """Computes activation differences between positive and negative paths, 
    applies layer-specific interventions based on semantic content."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2308.10248> ;
    rdfs:subClassOf reliability:ActivationEngineering ;
    skos:altLabel "SADI"@en ;
    skos:definition "Semantics-Adaptive Dynamic Intervention (SADI) is an advanced activation engineering technique that computes activation differences between positive and negative reasoning paths and applies layer-specific interventions based on semantic content analysis, enabling targeted modification of model behavior to reduce hallucinations."@en ;
    skos:example "Semantic Accuracy Degradation Index shows 12% accuracy decline between v1.0 and v2.0 on domain-specific medical queries."@en .

reliability:SBOMFormat a owl:Class ;
    rdfs:label "SBOM Format"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NTIA Survey of Existing SBOM Formats and Standards (2021)."@en ;
    rdfs:comment "A formal SBOM serialisation format. Recognised standards: SPDX (ISO/IEC 5962), CycloneDX (OWASP), SWID (ISO/IEC 19770-2)."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:ReliabilityConcept ;
    skos:definition "A formal SBOM serialisation format. Recognised standards: SPDX (ISO/IEC 5962), CycloneDX (OWASP), SWID (ISO/IEC 19770-2)."@en .

reliability:SafeguardVariantIncompleteness a owl:Class ;
    rdfs:label "Safeguard Variant Incompleteness"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source """OWB Sprint v3.0 post-mortem, April 2026.
VerificationAdequacyGate (Stage 1 BLOCKING pre-condition) and Session
Refresh Protocol were silently dropped when the sprint activated only
redo_safeguard_html_js_v1.2.md. The variant has no inheritance
declaration linking it to the base's Stage 1 pre-conditions.
Not a memory failure — a structural omission in the variant document."""@en ;
    rdfs:comment """Structural failure mode in which activating a a reliability ontology
safeguard variant causes base-level gates and pre-conditions to be
silently dropped because the variant does not explicitly inherit or
re-state them, and the LLM applies only variant-level rules, assuming
the variant is self-contained.

Structural cause: a reliability ontology safeguard variants (html_js, code_module,
ontology, academic) specialise the base but carry no machine-readable
inheritance declaration. There is no rdfs:subClassOf, owl:imports,
or explicit 'inherits from base' statement in the variant documents.

This is NOT the same as InstructionDecay: requirements are not
forgotten due to context length — they are never loaded because the
wrong scope document was activated.

Base-level requirements most likely to be silently dropped:
  - VerificationAdequacyGate Q1/Q2/Q3 (Stage 1 BLOCKING)
  - Session Refresh Protocol (unconditional >20 exchanges)
  - Bridge-First Protocol (when data layer exists)
  - C6 PROV-O Manifest Coupling (C8-OUT BS-01 rule)
  - Stage 1 Manifest NamingConvention validation

Prevention: redo:SafeguardInheritanceProtocol — explicit inheritance
block required at the top of every variant document."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:LLMBehavioralPathology ;
    owl:disjointWith reliability:InstructionDecay,
        reliability:RitualCompliance ;
    skos:definition """Structural failure mode in which activating a a reliability ontology
safeguard variant causes base-level gates and pre-conditions to be
silently dropped because the variant does not explicitly inherit or
re-state them, and the LLM applies only variant-level rules, assuming
the variant is self-contained.

Structural cause: a reliability ontology safeguard variants (html_js, code_module,
ontology, academic) specialise the base but carry no machine-readable
inheritance declaration. There is no rdfs:subClassOf, owl:imports,
or explicit 'inherits from base' statement in the variant documents.

This is NOT the same as InstructionDecay: requirements are not
forgotten due to context length — they are never loaded because the
wrong scope document was activated.

Base-level requirements most likely to be silently dropped:
  - VerificationAdequacyGate Q1/Q2/Q3 (Stage 1 BLOCKING)
  - Session Refresh Protocol (unconditional >20 exchanges)
  - Bridge-First Protocol (when data layer exists)
  - C6 PROV-O Manifest Coupling (C8-OUT BS-01 rule)
  - Stage 1 Manifest NamingConvention validation

Prevention: redo:SafeguardInheritanceProtocol — explicit inheritance
block required at the top of every variant document."""@en ;
    skos:example """Sprint activated redo_safeguard_html_js_v1.2.md.
VerificationAdequacyGate defined only in redo_safeguard_base_v1.2.md.
Variant never references the base. LLM completed sprint without
Q1/Q2/Q3 declarations per gate. The omission was structural:
the VAG requirement was never in the variant's scope."""@en .

reliability:Safety a owl:Class ;
    rdfs:label "Safety"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://www.iso.org/standard/78176.html> ;
    rdfs:comment "NEW in ISO 25010:2023. Addresses freedom from unacceptable risk to health, life, property, or environment"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf reliability:QualityCharacteristic ;
    skos:definition "Degree to which a product or system mitigates potential risk to people in the intended contexts of use"@en ;
    skos:example "System prevents generation of content exceeding FDA-cleared indications for medical device software classification."@en .

reliability:SafetyIntegrityLevel a owl:Class ;
    rdfs:label "Safety Integrity Level (SIL)"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "IEC 61508-1:2010 §3.5.8 Safety Integrity Level. Functional safety of electrical/electronic/programmable electronic safety-related systems."@en ;
    rdfs:comment "IEC 61508 Safety Integrity Level — a discrete level (one of four possible values) for specifying the safety-integrity requirements of safety functions, where SIL 4 has the highest probabilistic-failure-on-demand demand and SIL 1 the lowest."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:ReliabilityTier ;
    skos:definition "IEC 61508 Safety Integrity Level — a discrete level (one of four possible values) for specifying the safety-integrity requirements of safety functions, where SIL 4 has the highest probabilistic-failure-on-demand demand and SIL 1 the lowest."@en .

reliability:ScopeConflationDrift a owl:Class ;
    rdfs:label "Scope Conflation Drift"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.12 — derived from conversation_audit_v1_0_0.md §3.2 Phase F D-6 (2026-05-01): treated 'package' deliverable and 'workbench' deliverable as separate when user had requested a package as supporting input for the workbench upload flow. User: 'We were building the new workbench. Did you lose the last steps?'"@en ;
    rdfs:comment "Two work items belonging to a single user-facing goal are decomposed into independent sub-deliverables and the relationship between them is lost. Detection: maintain an explicit goal anchor (e.g. blueprint goal record) and check every new work item against it before committing."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:DialogIntegrityDrift,
        reliability:Drift ;
    skos:definition "A drift pathology in which the agent treats a coherent user goal as multiple unrelated deliverables, losing the unifying intent and producing artefacts that, while internally complete, do not collectively serve the goal."@en ;
    skos:example "an algebraic framework Phase F D-6: package-as-deliverable and workbench-as-deliverable decoupled when the user wanted package-as-input-for-workbench-upload-flow. Severity HIGH (focus). Remediated by reset to crystal-clear path."@en .

reliability:SelfUnderminingRefreshTrigger a owl:Class ;
    rdfs:label "Self-Undermining Refresh Trigger"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source """OWB Sprint v3.0 post-mortem, April 2026.
Session Refresh Protocol not triggered despite exceeding 20 exchanges.
Trigger condition (count exchanges) is monitored by the entity subject
to InstructionDecay — a circularity not previously modelled in a reliability ontology.
Liu et al. (2023) Lost in the Middle: instruction adherence degrades
non-linearly with context length."""@en ;
    rdfs:comment """Failure mode in which the Session Refresh Protocol
trigger condition is self-undermining: the LLM must count its own
exchanges to determine whether to refresh, but InstructionDecay — the
very condition the refresh is designed to combat — also degrades the
LLM's ability to reliably monitor the trigger threshold.

The trigger is therefore most likely to fail precisely when it is
most needed: in long sessions with high InstructionDecay pressure.

Formal property: the trigger detection probability P(trigger detected)
decreases monotonically as context length increases — the same context
length increase that increases InstructionDecay risk.

Prevention: Make the Session Refresh UNCONDITIONAL. In sessions that
have crossed the 20-exchange threshold, the refresh MUST execute at
the START of every turn — not conditionally upon detecting the threshold.
A conditional trigger on a self-degrading counter is not a reliable
safety mechanism."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:RefreshTrigger ;
    skos:definition """Failure mode in which the Session Refresh Protocol
trigger condition is self-undermining: the LLM must count its own
exchanges to determine whether to refresh, but InstructionDecay — the
very condition the refresh is designed to combat — also degrades the
LLM's ability to reliably monitor the trigger threshold.

The trigger is therefore most likely to fail precisely when it is
most needed: in long sessions with high InstructionDecay pressure.

Formal property: the trigger detection probability P(trigger detected)
decreases monotonically as context length increases — the same context
length increase that increases InstructionDecay risk.

Prevention: Make the Session Refresh UNCONDITIONAL. In sessions that
have crossed the 20-exchange threshold, the refresh MUST execute at
the START of every turn — not conditionally upon detecting the threshold.
A conditional trigger on a self-degrading counter is not a reliable
safety mechanism."""@en ;
    skos:example """Session crossed 30 exchanges. Refresh requires re-stating
SPRINT_MANIFEST when >20 exchanges. The LLM lost track of the exchange
count due to InstructionDecay — the same condition the refresh combats.
The conditional trigger failed at precisely the point of highest need."""@en .

reliability:SemanticEntropy a owl:Class ;
    rdfs:label "Semantic Entropy"@en ;
    measurement:hasMeasurementSubject measurement:LLMMeasurementSubject ;
    reliability:hasUnit "bits" ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "LLM reliability research corpus: Malmqvist 2024, Ma et al. 2024, Ji et al. 2023 (arXiv:2311.05232)" ;
    rdfs:comment """Lower entropy indicates higher confidence and consistency in semantic meaning. 
    Used to detect potential hallucinations."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf measurement:LLMReliabilityMetric ;
    skos:definition "SemanticEntropy is an LLM reliability metric measuring the semantic uncertainty in model outputs across multiple generation samples, quantified in bits, where lower entropy indicates higher confidence and consistency in meaning, enabling detection of potential hallucinations and unreliable responses."@en ;
    skos:example "High semantic entropy (>0.8) across 10 generations indicates model uncertainty - answers vary significantly in meaning not just wording."@en .

reliability:SemanticTargetVerification a owl:Class ;
    rdfs:label "Semantic Target Verification"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Derived from USO v2.0 Sprint 12 post-mortem, April 2026. W3C OWL 2 Web Ontology Language Primer: reference integrity requirements. Hitzler, P. et al. (2021). OWL 2 Web Ontology Language."@en ;
    rdfs:comment "Applied within C5 EmpiricalTest whenever a property has an external IRI as object. Standard EmpiricalTest mutates a value and checks output changes; SemanticTargetVerification additionally calls g.parse(target) to confirm the referenced IRI is a real, loadable file."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.w3.org/TR/shacl/> ;
    rdfs:subClassOf reliability:EmpiricalTest ;
    skos:definition "A specialisation of EmpiricalTest verifying that when a SHACL shape or ontology property references an external IRI as its object (e.g., meta:testedBy pointing to a test suite IRI), the target IRI resolves to a loadable, parseable artefact. A dangling IRI satisfies the structural triple check but is not a delivered artefact and must not be counted as evidence of test coverage, alignment, or compliance."@en ;
    skos:example "meta:testedBy <test:USO_Inno_TestSuite_v1> passes the triple check. SemanticTargetVerification: g.parse(target_file) must succeed. If the file does not exist the triple is a dangling reference."@en .

reliability:SemanticTreeEditDistance a owl:Class ;
    rdfs:label "Semantic Tree Edit Distance (STED)"@en ;
    measurement:hasMeasurementSubject measurement:LLMMeasurementSubject ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Wang et al. 2025, STED and Consistency Scoring: A Framework for Evaluating LLM Structured Output Reliability, arXiv:2512.23712"@en ;
    rdfs:comment "A similarity metric for evaluating LLM-generated structured outputs (JSON, code) that balances semantic flexibility with structural strictness. STED parses output as a tree and penalizes structural breaks (score 0.0) while allowing semantic equivalence in leaf nodes, enabling distinction between critical schema violations and acceptable variations like key reordering or naming convention differences."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://arxiv.org/abs/2512.23712> ;
    rdfs:subClassOf measurement:LLMReliabilityMetric ;
    skos:definition "A similarity metric for evaluating LLM-generated structured outputs (JSON, code) that balances semantic flexibility with structural strictness. STED parses output as a tree and penalizes structural breaks (score 0.0) while allowing semantic equivalence in leaf nodes, enabling distinction between critical schema violations and acceptable variations like key reordering or naming convention differences."@en ;
    skos:example "STED scores 0.86-0.90 for semantically equivalent JSON with different key orders, but 0.0 for outputs with missing required fields or type violations."@en .

reliability:SeverityLevel a owl:Class ;
    rdfs:label "Severity Level"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC 25010:2023 Product Quality Model"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf core:SeverityLevel,
        reliability:Entity ;
    owl:equivalentClass qc:SeverityLevel ;
    skos:definition "SeverityLevel is a classification of the impact magnitude of a failure, pathology, or issue on system reliability, categorized as high, medium, or low based on consequences for system safety, data integrity, and urgency of remediation required."@en ;
    skos:example "A SQL injection vulnerability is classified as High Severity, a minor UI typo as Low Severity, and a performance degradation as Medium Severity."@en .

reliability:SeverityWeightedZombieRate a owl:Class ;
    rdfs:label "Severity-Weighted Zombie Rate"@en ;
    measurement:hasMeasurementSubject measurement:LLMMeasurementSubject ;
    reliability:hasUnit "weighted ratio (0.0 to 1.0)" ;
    reliability:measuresAttribute reliability:ZombieClaim ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Gemini behavioral pathology report: ZSR metric" ;
    rdfs:comment """Formula: ZSR = Σ(severity_weight_i × zombie_i) /
    Σ(severity_weight_i × total_claims_i). Extends ZCR by weighting
    each claim by its criticality level, so a zombie claim in a
    safety-critical context contributes more than one in a low-stakes
    context. Severity weights derived from redo:SeverityLevel."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf measurement:LLMReliabilityMetric ;
    skos:definition """Criticality-weighted extension of Zombie Claim Rate
    that accounts for the severity level of each decision context,
    weighting zombie claims in safety-critical contexts more heavily
    than those in low-stakes contexts"""@en ;
    skos:example "3 critical zombie claims and 8 minor ones yield SWZR=0.42 (weighted by severity: critical=5x, minor=1x)."@en .

reliability:SprintClosureChecklist a owl:Class ;
    rdfs:label "Sprint Closure Checklist Gate"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Derived from USO v2.0 Sprint 12 post-mortem, April 2026. Schwaber, K. & Sutherland, J. (2020). The Scrum Guide."@en ;
    rdfs:comment "Pipeline: C8Out checks existence → SprintClosureChecklist checks correctness → C7 BlindSpot → GATE_VECTOR VERDICT. Both must pass."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/62085.html> ;
    rdfs:subClassOf reliability:ComplianceGate ;
    skos:definition "A compliance gate at Stage 4 that programmatically parses and validates every sprint manifest file: ontology artefacts via g.parse() + pySHACL Conforms=True; code artefacts via module import + function execution. Extends C8Out by verifying content correctness beyond mere existence. Any file failing parse or validation = HALT before GATE_VECTOR VERDICT."@en ;
    skos:example "uso-innovation-v1_0.ttl: exists (C8Out PASS), g.parse() OK, pySHACL Conforms=True (SprintCC PASS). uso-innovation-tests-v1_0.ttl: exists but g.parse() throws ParseError → HALT."@en .

reliability:StageGate a owl:Class ;
    rdfs:label "Stage Gate"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Cooper, R.G. (1990). Stage-Gate Systems: A New Tool for Managing New Products. Business Horizons, 33(3), 44-54."@en ;
    rdfs:comment "Binary pass/fail control point between stages. Content does not proceed until gate conditions are met."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/62085.html> ;
    rdfs:subClassOf reliability:ProcessControlLayer ;
    skos:definition "Binary pass/fail control point between stages. Content does not proceed until gate conditions are met."@en ;
    skos:example "Gate: all formulas computationally verified AND all citations web-searched before delivery."@en .

reliability:StructuralIntegrity a owl:Class ;
    rdfs:label "Structural Integrity"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Wang et al. 2025, STED and Consistency Scoring, arXiv:2512.23712"@en ;
    rdfs:comment "The correctness and validity of the structure in LLM-generated outputs such as JSON, XML, or code, independent of semantic content. Structural integrity ensures outputs can be parsed, validated against schemas, and consumed by downstream systems without syntax errors or schema violations."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://arxiv.org/abs/2512.23712> ;
    rdfs:subClassOf reliability:OutputQuality ;
    owl:disjointWith reliability:SemanticAccuracy ;
    skos:definition "The correctness and validity of the structure in LLM-generated outputs such as JSON, XML, or code, independent of semantic content. Structural integrity ensures outputs can be parsed, validated against schemas, and consumed by downstream systems without syntax errors or schema violations."@en ;
    skos:example "A JSON output has structural integrity if it parses correctly, contains all required fields, and respects type constraints, regardless of whether the semantic content is accurate."@en .

reliability:StructuredOutputValidation a owl:Class ;
    rdfs:label "Structured Output Validation"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Wang et al. 2025, STED Framework, arXiv:2512.23712"@en ;
    rdfs:comment "StructuredOutputValidation is a validation method that verifies the structural integrity and schema compliance of LLM-generated structured outputs such as JSON, XML, or code, ensuring both syntactic correctness and semantic validity."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf reliability:VerificationMethod ;
    skos:definition "StructuredOutputValidation is a validation method that verifies the structural integrity and schema compliance of LLM-generated structured outputs such as JSON, XML, or code, ensuring both syntactic correctness and semantic validity."@en ;
    skos:example "Validating that JSON output conforms to the OpenAPI schema with all required fields present and correct types."@en,
        "Validating that generated JSON conforms to the OpenAPI 3.0 schema with all required fields present, correct types, and valid enum values."@en .

reliability:SubstantiveCompliance a reliability:ComplianceDepth,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Substantive Compliance (Level 3)"@en ;
    reliability:complianceLevel 3 ;
    reliability:measures qc:Reliability ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NEEDS_EXPERT_REVIEW: a reliability ontology-native metric inspired by CMMI maturity levels (SEI, 2010)."@en ;
    rdfs:comment "Verification found and addressed actual issue. Output CHANGED as result."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:DecorativeCompliance ;
    skos:definition "Verification found and addressed actual issue. Output CHANGED as result."@en .

reliability:SupersessionMapDrift a owl:Class ;
    rdfs:label "Supersession Map Drift"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "F-a reliability ontology-10 from REDO_Capability_Analysis_2026_05_13.md. Audit-trail completeness per IEEE 1012-2016 (Verification and Validation) §7.2.7 traceability; ISO/IEC/IEEE 24765 §3.3018 configuration item history."@en ;
    rdfs:comment "A drift pathology in which a file is added to, removed from, or replaced in the corpus without a corresponding SUPERSESSION_MAP entry recording the lineage relationship. Breaks audit-trail reconstructability: future audits cannot reconstruct 'what was version N's content?' from the SUPERSESSION_MAP alone. Empirically observed: v17.18.0 deleted aeo_v1_0_0.ttl and ae_bridge_v1_0_0.ttl without adding map entries; the audit trail lives only in CHANGELOG prose."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:GovernanceTrustDrift ;
    skos:definition "A drift pathology in which a file is added to, removed from, or replaced in the corpus without a corresponding SUPERSESSION_MAP entry recording the lineage relationship. Breaks audit-trail reconstructability: future audits cannot reconstruct 'what was version N's content?' from the SUPERSESSION_MAP alone. Empirically observed: v17.18.0 deleted aeo_v1_0_0.ttl and ae_bridge_v1_0_0.ttl without adding map entries; the audit trail lives only in CHANGELOG prose."@en .

reliability:SystemMonitoringPhase a owl:Class ;
    rdfs:label "System Monitoring Phase"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NEEDS_EXPERT_REVIEW: Derived from observability engineering practices (Majors, Fong-Jones, Miranda, 2022. Observability Engineering. O'Reilly)."@en ;
    rdfs:comment "Operational phase for log analysis, metric anomaly detection, trace correlation, and observability pipeline management."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf reliability:LifecyclePhase ;
    skos:definition "Operational phase for log analysis, metric anomaly detection, trace correlation, and observability pipeline management."@en ;
    skos:example "LLM analyzing 10,000 log lines to identify root cause of a latency spike, with risk of hallucinating non-existent error patterns."@en .

reliability:SystemReliability a owl:Class ;
    rdfs:label "System Reliability"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "IEEE 1633-2016 Recommended Practice on Software Reliability."@en ;
    rdfs:comment "Broader perspective encompassing all system components"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/50641.html> ;
    rdfs:subClassOf reliability:ReliabilityDomain ;
    skos:definition "SystemReliability is a reliability domain encompassing the dependability of complete systems including hardware components, software modules, network infrastructure, and environmental factors, measured through composite metrics that account for component interactions and failure propagation."@en ;
    skos:example "End-to-end system including API, reasoner, and triple store achieves 99.9% availability with automatic failover."@en .

reliability:TaxonomicLevelViolation a owl:Class ;
    rdfs:label "Taxonomic Level Violation"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.4.1 cross-document audit, February 2026"@en ;
    rdfs:comment """A specific sub-pattern of ArchitecturalDrift in which items
    from different classification hierarchy levels are flattened into a single
    presentation level, creating false ontological equivalence and counting
    ambiguity. Distinguished from general ArchitecturalDrift by mechanism:
    ArchitecturalDrift involves progressive scope creep and constraint loss
    across sessions; TaxonomicLevelViolation involves level-mixing within an
    otherwise stable classification structure, where the content may be
    entirely relevant but is structurally mislocated.
    
    Root cause: LLMs generating document structures default to sequential
    numbering (3.1, 3.2, ..., 3.n) as a PathOfLeastResistance pattern, 
    placing new content at the next available number rather than determining 
    its correct hierarchical position. This produces documents where domain 
    contexts, parent classes, and subclasses appear as peers.
    
    Detection: Mapping each numbered section to its ontological class and
    verifying that all sections at the same structural level correspond to
    the same ontological level (e.g., all are direct subclasses of
    LLMBehavioralPathology, or all are DomainContext instances).
    
    Relationship to ZombieClaim: TaxonomicLevelViolation frequently co-occurs
    with counting errors (e.g., claiming '17 pathologies' when the section
    structure yields a different count), making the count claim a ZombieClaim
    that persists uncorrected because the level-mixing obscures the
    discrepancy."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl2-primer/> ;
    rdfs:subClassOf reliability:ArchitecturalDrift ;
    skos:definition """Presenting items from different classification hierarchy
    levels (e.g., domain context, top-level class, subclass of an existing class)
    at the same document structural level, creating false ontological equivalence.
    A subtype of ArchitecturalDrift where the violation is level-mixing rather
    than scope expansion: the misplaced items may be perfectly relevant content,
    but their structural placement implies peer-level taxonomic equivalence that
    does not hold in the underlying classification system."""@en ;
    skos:example """A generated ontology documentation lists 'Core Classes: Person,
    Organization, Employee, Address' as peer-level concepts, but Employee is
    rdfs:subClassOf Person and Address is a supporting class, not a core domain
    concept. The flat listing obscures the actual hierarchy."""@en,
        """An LLM reliability paper lists 15 sections as peer-level
    pathologies (3.1-3.15), but Section 3.13 maps to DomainContext (IT Operations
    evidence) and Section 3.14 maps to ConfidenceMiscalibration subclass
    (Production-Benchmark Paradox, a child of Section 3.4). Three classification
    levels — domain context, top-level pathology, and subclass pathology — are
    presented as siblings."""@en .

reliability:TechniqueConcept a owl:Class ;
    rdfs:label "TechniqueConcept"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "IEEE 1633-2016 Recommended Practice on Software Reliability; ISO/IEC 25010:2023 §4 Product quality model."@en ;
    rdfs:comment "An abstract organizational class representing methodological techniques, algorithms, or analytical approaches applied within reliability engineering and ontology evaluation contexts to detect patterns, assess quality, or perform systematic analysis."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf reliability:ReliabilityConcept ;
    skos:definition "An abstract organizational class representing methodological techniques, algorithms, or analytical approaches applied within reliability engineering and ontology evaluation contexts to detect patterns, assess quality, or perform systematic analysis."@en ;
    skos:example "A community detection algorithm (e.g., Louvain method) applied to a software dependency graph to identify tightly-coupled module clusters that share common failure propagation paths, achieving a modularity score of 0.72."@en .

reliability:TestMetrics a owl:Class ;
    rdfs:label "Test Metrics"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Quantitative measurements of testing activities and outcomes."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf reliability:TestingConcept ;
    skos:definition "Quantitative measurements collected during ontology test execution that characterize the testing process, including pass rates, failure rates, coverage percentages, execution times, and defect discovery rates."@en ;
    skos:example "Test coverage: 98.7% of classes validated by SHACL shapes; 96% of competency questions answered correctly."@en .

reliability:TheoremProving a owl:Class ;
    rdfs:label "Theorem Proving"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Harrison, J. (2009). Handbook of Practical Logic and Automated Reasoning. Cambridge University Press."@en ;
    rdfs:comment "More expressive than model checking but requires human guidance"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-319-10575-8> ;
    rdfs:subClassOf reliability:FormalVerification ;
    skos:definition "TheoremProving is a formal verification technique involving interactive or automated construction of mathematical proofs of correctness, demonstrating that system implementations satisfy their specifications through rigorous logical deduction using proof assistants like Coq, Isabelle, or automated theorem provers."@en ;
    skos:example "Using Coq proof assistant to formally verify that a sorting algorithm preserves all elements and produces a totally ordered output for any input list."@en .

reliability:ThreatsToValidity a owl:Class ;
    rdfs:label "Threats to Validity"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Wohlin, C. et al. (2012). Experimentation in Software Engineering. Springer."@en ;
    rdfs:comment """Documented limitations of the empirical evidence 
    base, following ACM/IEEE reporting standards. Required for 
    publication integrity."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf reliability:MetaReliability ;
    skos:definition """Documented limitations of the empirical evidence 
    base, following ACM/IEEE reporting standards. Required for 
    publication integrity."""@en ;
    skos:example "Example: ex:ttv_redo_empirical a redo:ThreatsToValidity ; rdfs:label \"Threats to a reliability ontology empirical claims\" ; skos:definition \"Single-operator data collection (one LLM instance), small sample sizes per category (N=2 to N=12), potential Hawthorne effect from a reliability ontology-in-context awareness.\" ."@en .

reliability:TruthForest a owl:Class ;
    rdfs:label "Truth Forest"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "LLM reliability research corpus: Malmqvist 2024, Ma et al. 2024, Ji et al. 2023 (arXiv:2311.05232)" ;
    rdfs:comment """Uses ensemble of orthogonal linear probes to detect truthfulness 
    in model activations, supporting SADI and other techniques."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf reliability:FailureMitigation ;
    skos:definition "TruthForest is an activation engineering technique that employs multi-dimensional orthogonal probes to uncover hidden truth representations in model activations, using an ensemble of linear classifiers trained on truthful versus deceptive examples to detect when the model's internal state diverges from factual grounding."@en ;
    skos:example "Ensemble of multiple independent LLM instances cross-checking each other's outputs, flagging disagreements for review."@en .

reliability:Underconfidence a owl:Class ;
    rdfs:label "Underconfidence"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Xiong, M. et al. (2024). Can LLMs Express Their Uncertainty? An Empirical Evaluation of Confidence Elicitation in LLMs. ICLR 2024."@en ;
    rdfs:comment """Underconfidence is a specialization of ConfidenceMiscalibration where the 
    LLM's expressed confidence is systematically lower than its actual accuracy. Less common 
    than overconfidence but observed in specific domains and for rare-but-correct answers 
    where training distribution biases suppress confidence."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf reliability:ConfidenceMiscalibration ;
    skos:definition """Underconfidence is a specialization of ConfidenceMiscalibration where the 
    LLM's expressed confidence is systematically lower than its actual accuracy. Less common 
    than overconfidence but observed in specific domains and for rare-but-correct answers 
    where training distribution biases suppress confidence."""@en ;
    skos:example "Model hedges with 'I'm not entirely sure, but...' on factual questions where it is correct 95% of the time."@en .

reliability:Usability a owl:Class ;
    rdfs:label "Usability"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://www.iso.org/standard/78176.html> ;
    rdfs:comment "Historical term, now InteractionCapability in ISO 25010:2023"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:QualityCharacteristic ;
    owl:equivalentClass qc:Usability ;
    skos:definition "Usability is a quality characteristic measuring the degree to which a system enables specified users to achieve their goals effectively, efficiently, and with satisfaction in a specified context of use."@en ;
    skos:example "Domain experts rate ontology navigation as 4.1/5.0 for intuitiveness based on task completion study with 8 participants."@en .

reliability:User a owl:Class ;
    rdfs:label "User"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO 9241-210:2019 Ergonomics of human-system interaction - Human-centred design for interactive systems."@en ;
    rdfs:comment "Experiences failures and provides requirements"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf core:Role ;
    skos:definition "An agent role representing an individual or automated client who utilizes the reliability-engineered system for its intended operational purpose, whose experience, satisfaction, and observed failure encounters serve as key indicators of operational reliability quality."@en ;
    skos:example "Clinical pharmacist using LLM-powered drug interaction checker, reporting 2 hallucinated contraindications in 500 queries."@en .

reliability:VECTRProtocol a owl:Class ;
    rdfs:label "VECTR Protocol"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Gemini behavioral pathology report: VECTR framework" ;
    rdfs:comment """Five controls: T1-Audit Replayability (every verification
    step produces immutable log), T2-Inconsistency Taxonomy (classification
    of detected inconsistencies), T3-Accountable Human (named reviewer with
    counter-review checklist), T4-Evidence Binding (claims linked to
    resolvable sources), T5-Transparency (verification process visible to
    all stakeholders). Acronym: Verifiability, Evidence, Claims,
    Transparency, Reproducibility."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf reliability:VerificationMethod ;
    skos:definition """Verification framework consisting of five controls
    (Verifiability, Evidence, Claims, Transparency, Reproducibility) that
    establish systematic assurance practices for LLM-generated artifacts
    including audit replayability and evidence-object binding"""@en ;
    skos:example "Before publishing analysis, verify sources exist (V), check evidence bindings (E), confirm citation accuracy (C), trace reasoning chain (T), search for disconfirming evidence (R)."@en .

reliability:VerificationAdequacyCompound a owl:Class ;
    rdfs:label "Verification Adequacy Compound"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Forensic analysis of a reliability ontology v2.1.0 HTML update session, February 2026."@en ;
    rdfs:comment """A compound failure mode where assessor cognitive biases interact to 
    produce inadequate verification that appears thorough. Distinct from the 
    AssessorBiasCompound (v2.1.0) which operates in the impossibility-claim 
    context; this compound operates in the verification-adequacy context.
    
    The canonical pattern is:
    
    1. CompetenceParadox → structured audit capability exists but dormant; 
       assessor defaults to shallow grep-based checks
    2. DecorativeVerification → shallow checks produce output that looks 
       like verification (counts, line numbers, 'verified' declarations) 
       but cannot detect the failure mode (cross-location consistency)
    3. NarrativeAnchoring → '21 change groups applied, all verified' 
       becomes a success narrative that resists scrutiny
    4. Human challenge → external agent asks 'honestly confirm?' which 
       activates the dormant capability and breaks the narrative
    
    The compound is structurally parallel to the AssessorBiasCompound:
    both follow CompetenceParadox → [intermediary] → NarrativeAnchoring.
    In v2.1.0 the intermediary is EffortAvoidanceBias (non-attempt).
    In v2.2.0 the intermediary is DecorativeVerification (shallow attempt).
    
    This parallel structure confirms that CompetenceParadox and NarrativeAnchoring 
    are context-independent mechanisms that manifest through different 
    intermediary pathologies depending on the assessment situation."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1145/3571730> ;
    rdfs:subClassOf reliability:LLMFailure ;
    skos:definition """A compound failure mode where assessor cognitive biases interact to 
    produce inadequate verification that appears thorough. Distinct from the 
    AssessorBiasCompound (v2.1.0) which operates in the impossibility-claim 
    context; this compound operates in the verification-adequacy context.
    
    The canonical pattern is:
    
    1. CompetenceParadox → structured audit capability exists but dormant; 
       assessor defaults to shallow grep-based checks
    2. DecorativeVerification → shallow checks produce output that looks 
       like verification (counts, line numbers, 'verified' declarations) 
       but cannot detect the failure mode (cross-location consistency)
    3. NarrativeAnchoring → '21 change groups applied, all verified' 
       becomes a success narrative that resists scrutiny
    4. Human challenge → external agent asks 'honestly confirm?' which 
       activates the dormant capability and breaks the narrative
    
    The compound is structurally parallel to the AssessorBiasCompound:
    both follow CompetenceParadox → [intermediary] → NarrativeAnchoring.
    In v2.1.0 the intermediary is EffortAvoidanceBias (non-attempt).
    In v2.2.0 the intermediary is DecorativeVerification (shallow attempt).
    
    This parallel structure confirms that CompetenceParadox and NarrativeAnchoring 
    are context-independent mechanisms that manifest through different 
    intermediary pathologies depending on the assessment situation."""@en ;
    skos:example """After applying a reliability ontology v2.1.0 changes to HTML files: assessor ran grep for 
    '16 pathologies' (10 matches) and '25 metrics' (present in intro) — 
    declared 'all verified.' CompetenceParadox: could have written structured 
    Python cross-file audit but didn't. DecorativeVerification: grep confirmed 
    presence of correct values but didn't search for absence of stale values. 
    NarrativeAnchoring: '21 change groups applied' became success narrative. 
    When challenged: structured audit found 5 stale references in 3 minutes."""@en .

reliability:VerifiedCompliance a reliability:ComplianceDepth,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Verified Compliance (Level 4)"@en ;
    reliability:complianceLevel 4 ;
    reliability:measures qc:Reliability ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NEEDS_EXPERT_REVIEW: a reliability ontology-native metric inspired by CMMI maturity levels (SEI, 2010)."@en ;
    rdfs:comment "Independent confirmation by different tool, agent, or human. Exceeds self-audit ceiling."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:DecorativeCompliance ;
    skos:definition "Independent confirmation by different tool, agent, or human. Exceeds self-audit ceiling."@en .

reliability:Vulnerability a owl:Class ;
    rdfs:label "Vulnerability"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC 27000:2018 §3.77; NIST SP 800-30 Rev.1."@en ;
    rdfs:comment "A weakness of an asset or control that can be exploited by one or more threats. In ontology engineering: ambiguous axioms, missing disjointness, under-constrained property domains/ranges, missing version IRIs, absent licence declarations."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:ReliabilityConcept ;
    skos:definition "A weakness of an asset or control that can be exploited by one or more threats. In ontology engineering: ambiguous axioms, missing disjointness, under-constrained property domains/ranges, missing version IRIs, absent licence declarations."@en ;
    skos:example "Missing owl:disjointWith between two top-level concepts — vulnerability allowing reasoners to infer unintended class hierarchies."@en .

reliability:VulnerabilityDisclosure a owl:Class ;
    rdfs:label "Vulnerability Disclosure"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC 29147:2018 Vulnerability disclosure; CVE; CVSS v3.1."@en ;
    rdfs:comment "A disclosure of a security vulnerability affecting a component, identified by CVE, with a CVSS severity score, and linked to the affected SBOM components."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:ReliabilityConcept ;
    skos:definition "A disclosure of a security vulnerability affecting a component, identified by CVE, with a CVSS severity score, and linked to the affected SBOM components."@en .

reliability:WorkAround a owl:Class ;
    rdfs:label "Work Around"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ITIL 4 Foundation (2019), §5.2.7 Problem Management."@en ;
    rdfs:comment "Temporary mitigation that allows continued operation despite an unfixed Problem, pending root-cause resolution. A WorkAround is a redo:MitigationStrategy with explicit recognition that it is not the permanent solution."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:FailureMitigation ;
    skos:definition "Temporary mitigation that allows continued operation despite an unfixed Problem, pending root-cause resolution. A WorkAround is a redo:MitigationStrategy with explicit recognition that it is not the permanent solution."@en .

reliability:ZeroTrustDevelopmentArchitecture a owl:Class ;
    rdfs:label "Zero Trust Architecture (Reliability Context)"@en ;
    core:mitigates reliability:LLMBehavioralPathology ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Avizienis et al. 2004",
        "NIST SP 800-207 (adapted for LLM development)" ;
    rdfs:comment """Adaptation of NIST SP 800-207 Zero Trust Architecture
    principles to LLM-assisted software development. Core principles:
    (1) No implicit trust based on position in stack or helpful tone,
    (2) Data-centric security protecting individual artifacts,
    (3) Granular access control over LLM capabilities,
    (4) Continuous monitoring via VECTR audit replayability.
    Foundational principle: 'Zero Trust should extend to the LLM itself.
    Do not trust it to follow methodology. Verify structurally.'"""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf reliability:FailureMitigation ;
    skos:definition """Architectural framework adapted from NIST SP 800-207
    applying zero trust principles to LLM-assisted development, requiring
    continuous verification of all LLM outputs through mechanical
    enforcement rather than instructional trust"""@en ;
    skos:example "Every LLM output is validated: code is linted, facts are verified, citations are checked, before any content is committed."@en .

reliability:accuracyMetric a owl:ObjectProperty ;
    rdfs:label "accuracyMetric"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:Precision ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range qc:Correctness ;
    skos:definition "Relates precision to correctness since precision measures the accuracy of positive classifications."@en ;
    skos:example "Example: redo:Precision redo:accuracyMetric redo:Correctness . Relates precision to the correctness quality characteristic, since precision measures accuracy of positive classifications."@en .

reliability:addressesFaultType a owl:ObjectProperty ;
    rdfs:label "addressesFaultType"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:FaultPrevention ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:SoftwareFault ;
    skos:definition "Relates a fault prevention strategy to the specific category of software fault it is designed to prevent."@en ;
    skos:example "Example: ex:input_validation_strategy redo:addressesFaultType redo:InputValidationFault . Links a fault prevention strategy to the input validation fault category it prevents."@en .

reliability:affects a owl:ObjectProperty ;
    rdfs:label "affects"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC 25010:2023 §3 Terms and definitions — Quality characteristics."@en ;
    rdfs:domain reliability:ReliabilityConcept ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:QualityCharacteristic ;
    skos:definition "Relates a reliability concept, failure mode, mitigation strategy, or quality metric to the quality characteristic, system component, or operational attribute that it influences, degrades, or modifies through its operational behavior."@en ;
    skos:example "Example: redo:InstructionDecay redo:affects redo:Accuracy . Links the instruction decay temporal degradation to the accuracy characteristic it degrades."@en .

reliability:affectsCustomer a owl:ObjectProperty ;
    rdfs:label "affectsCustomer"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:DomainContext ;
    skos:definition "Relates customer impact to domain context since impact severity depends on the specific professional domain."@en ;
    skos:example "Example: ex:sla_breach_impact redo:affectsCustomer redo:ITOperationsDomain . Links customer impact assessment to the IT operations domain where impact severity is evaluated."@en .

reliability:affectsQuality a owl:ObjectProperty ;
    rdfs:label "affectsQuality"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:FailureConcept ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:QualityCharacteristic ;
    skos:definition "Relates a failure concept to the quality characteristic it degrades or compromises when it manifests in a system."@en ;
    skos:example "Example: redo:DataFabrication redo:affectsQuality redo:Trustworthiness . Links the data fabrication failure to the trustworthiness characteristic it compromises."@en .

reliability:affectsReliability a owl:ObjectProperty ;
    rdfs:label "affects reliability"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:comment """This property enables modeling how external factors (particularly 
    economic constraints) impact reliability characteristics"""@en ;
    rdfs:domain reliability:ExternalFactor ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:ReliabilityAttribute ;
    skos:definition "Links external factor to the reliability attribute it influences"@en ;
    skos:example "Example: ex:network_latency redo:affectsReliability redo:Availability . Links network latency as an external factor to the availability attribute it influences."@en .

reliability:affectsStakeholder a owl:ObjectProperty ;
    rdfs:label "affects stakeholder"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range core:Stakeholder ;
    skos:definition "Identifies stakeholders affected by the business impact"@en ;
    skos:example "Example: ex:downtime_impact redo:affectsStakeholder ex:enterprise_customers . Identifies enterprise customers as stakeholders affected by a downtime business impact."@en .

reliability:anchoredToNarrative a owl:ObjectProperty ;
    rdfs:label "anchored to narrative"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:NarrativeAnchoring ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:AssessmentNarrative ;
    skos:definition """Relates a NarrativeAnchoring instance to the specific assessment 
    narrative that is being protected. The narrative is the story arc 
    (e.g., 'near ceiling, external resources needed') that resists revision."""@en ;
    skos:example "ex:narrativeanchoring_instance redo:anchoredToNarrative ex:assessmentnarrative_instance . Links NarrativeAnchoring to AssessmentNarrative."@en .

reliability:answeredBy a owl:ObjectProperty ;
    rdfs:label "answered by"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain core:CompetencyQuestion ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    skos:definition "Relates a competency question to the ontology concepts required to answer it."@en ;
    skos:example "Example: redo:CQ1 redo:answeredBy redo:LLMFailure . Links competency question CQ1 to the LLMFailure concept required to answer it."@en .

reliability:appliesDuring a owl:ObjectProperty ;
    rdfs:label "applies during"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:ScaffoldBasedDevelopment ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:LifecyclePhase ;
    skos:definition "Relates scaffold-based development to the lifecycle phases during which it guides construction."@en ;
    skos:example "Example: ex:scaffold_dev redo:appliesDuring redo:DesignPhase . Links scaffold-based development to the design lifecycle phase it guides."@en .

reliability:appliesInDomain a owl:ObjectProperty ;
    rdfs:label "applies in domain"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:comment """This property enables domain-specific refinement of reliability 
    requirements without duplicating core concepts"""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:DomainContext ;
    skos:definition "Links reliability concept to applicable domain contexts"@en ;
    skos:example "Example: redo:RAGRetrieval redo:appliesInDomain redo:LegalDomain . Links the RAG retrieval mitigation to the legal domain where it is applicable."@en .

reliability:asOfRelease a owl:DatatypeProperty ;
    rdfs:label "as of release"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Sprint F4 (2026-05-14): property declared from raw usage analysis (domain/range inferred per BP-D2 from existing ABox patterns). Per L-47v2: full skos:definition included."@en ;
    rdfs:domain reliability:MeasurementSnapshot ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "String form of the release identifier (e.g., \"oepack-family-v17_0\", \"oepack-family-v17_3_0\") that a MeasurementSnapshot captures. Per L-43 pattern: snapshots are pinned to release boundaries. Per Sprint F4: 4 usages."@en .

reliability:assessesCapability a owl:ObjectProperty ;
    rdfs:label "assesses capability"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:ReliabilityMaturityLevel ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:Entity ;
    skos:definition "Relates a reliability maturity level to the organizational entity whose capability it assesses."@en ;
    skos:example "Example: ex:maturity_level_3 redo:assessesCapability ex:engineering_org . Links maturity level 3 to the engineering organization whose capability it assesses."@en .

reliability:assessesCapacity a owl:ObjectProperty ;
    rdfs:label "assessesCapacity"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain qc:Capacity ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    skos:definition "Relates capacity to failure rate since exceeding capacity thresholds directly increases failure frequency."@en ;
    skos:example "Example: ex:capacity_assessment redo:assessesCapacity redo:FailureRate . Links a capacity assessment to the failure rate, since exceeding capacity thresholds increases failure frequency."@en .

reliability:assessesComprehensiveness a owl:ObjectProperty ;
    rdfs:label "assessesComprehensiveness"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain qc:Comprehensiveness ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range qc:Completeness ;
    skos:definition "Relates comprehensiveness to completeness as overlapping quality characteristics measuring coverage scope."@en ;
    skos:example "Example: ex:coverage_metric redo:assessesComprehensiveness redo:Completeness . Links a coverage assessment to the completeness quality characteristic it evaluates."@en .

reliability:auditTrailSystem a owl:DatatypeProperty ;
    rdfs:label "auditTrailSystem"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.14 — added to support DRIFT-14 shape (2026-05-03)."@en ;
    rdfs:comment "Name of the audit-trail system whose entries lack upstream trust labels (e.g. 'GPPT v114 changeLog')."@en ;
    rdfs:domain reliability:UpstreamTrustLabelMissingDrift ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "Name of the audit-trail system whose entries lack upstream trust labels."@en .

reliability:auditedSession a owl:DatatypeProperty ;
    rdfs:label "auditedSession"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.13 — added to support DRIFT-7..11 shapes (2026-05-03)."@en ;
    rdfs:comment "Identifier (URI or transcript path) of the session being audited."@en ;
    rdfs:domain reliability:SelfAuditConflictOfInterest ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "Identifier (URI or transcript path) of the session being audited."@en .

reliability:authoringSession a owl:DatatypeProperty ;
    rdfs:label "authoringSession"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.13 — added to support DRIFT-7..11 shapes (2026-05-03)."@en ;
    rdfs:comment "Identifier of the session performing the audit."@en ;
    rdfs:domain reliability:SelfAuditConflictOfInterest ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "Identifier of the session performing the audit."@en .

reliability:automatable a owl:DatatypeProperty ;
    rdfs:label "automatable"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:VerificationModality ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether verification can be fully automated."@en ;
    skos:example "ex:check redo:automatable \"true\"^^xsd:boolean . Binary flag indicating a boolean property."@en .

reliability:autonomousDetectionRate a owl:DatatypeProperty ;
    rdfs:label "autonomous detection rate"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:DetectionMitigationAsymmetry ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:decimal ;
    skos:definition """Fraction of failures detected by the LLM without human prompting 
    or detection. Longitudinal aggregate: 0.486 (18/37, a reliability ontology v1.2-v2.2.0). 
    This aggregate is coverage-dependent: for formalized categories with 
    a reliability ontology in context, the rate approaches 1.0. The aggregate mixes early 
    immature sessions (~0.20) with later mature sessions (~1.0)."""@en ;
    skos:example "ex:metric_instance redo:autonomousDetectionRate \"0.85\"^^xsd:decimal . Metric records a measurement value."@en .

reliability:autonomousMitigationRate a owl:DatatypeProperty ;
    rdfs:label "autonomous mitigation rate"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:DetectionMitigationAsymmetry ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:decimal ;
    skos:definition "Fraction of failures mitigated autonomously by the LLM regardless of who detected them. Empirical: 0.865 (32/37, a reliability ontology v2.3.0)."@en ;
    skos:example "ex:metric_instance redo:autonomousMitigationRate \"0.85\"^^xsd:decimal . Metric records a measurement value."@en .

reliability:benchmarkSize a owl:DatatypeProperty ;
    rdfs:label "benchmark size"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:BenchmarkDataset ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:integer ;
    skos:definition "Number of scenarios or test cases in a benchmark dataset."@en ;
    skos:example "ex:entity redo:benchmarkSize \"value\"^^xsd:integer . Entity has a benchmarkSize property."@en .

reliability:benchmarkVersion a owl:DatatypeProperty ;
    rdfs:label "benchmark version"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:BenchmarkDataset ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "Version identifier for the benchmark dataset"@en ;
    skos:example "ex:artifact redo:benchmarkVersion \"2.4.5\"^^xsd:string . Artifact has a version identifier."@en .

reliability:benchmarkedBy a owl:ObjectProperty ;
    rdfs:label "benchmarked by"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain measurement:LLMReliabilityMetric ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:BenchmarkDataset ;
    skos:definition "Relates an LLM reliability metric to the reference benchmark against which its performance is compared for standardized cross-model assessment."@en ;
    skos:example "Example: redo:GroundingScore redo:benchmarkedBy redo:FEVERBenchmark . Links the grounding score metric to the FEVER benchmark for standardized comparison."@en .

reliability:bindingTarget_EOB a owl:ObjectProperty ;
    rdfs:label "bindingTarget_EOB"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:EvidenceObjectBinding ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:ComplianceGate ;
    skos:definition "Relates evidence-object bindings to the compliance gates they substantiate with traceable evidence artifacts."@en ;
    skos:example "Example: ex:eob_gate_binding redo:bindingTarget_EOB redo:AssessorFeasibilityGate . Links an evidence-object binding to the feasibility gate it substantiates."@en .

reliability:bindsEvidence a owl:ObjectProperty ;
    rdfs:label "binds evidence"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:EvidenceObjectBinding ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:Artifact ;
    skos:definition "Relates an evidence-object binding to the artifact that serves as its substantiating evidence."@en ;
    skos:example "Example: ex:eob_1 redo:bindsEvidence ex:shacl_report_artifact . Links an evidence-object binding to the SHACL report that serves as substantiating evidence."@en .

reliability:blindSpotSeverity a owl:DatatypeProperty ;
    rdfs:label "blind spot severity"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:BlindSpot ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "Severity rating of a blind spot: HIGH (claims most vulnerable to becoming zombie claims), MEDIUM (moderate risk), LOW (minor gap)."@en ;
    skos:example "ex:finding redo:blindSpotSeverity \"high\"^^xsd:string . Finding has an assigned severity level."@en .

reliability:blockingQuestionText a owl:DatatypeProperty ;
    rdfs:label "blockingQuestionText"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.13 — added to support DRIFT-7..11 shapes (2026-05-03)."@en ;
    rdfs:comment "Verbatim text of the blocking question from the upstream artefact."@en ;
    rdfs:domain reliability:UnresolvedBlockingQuestionDrift ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "Verbatim text of the blocking question from the upstream artefact."@en .

reliability:bridgeVerifiedBy a owl:ObjectProperty ;
    rdfs:label "bridge verified by"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:EnrichmentWithoutBridgeVerification ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:BridgeFirstProtocol ;
    skos:definition """Relates an enrichment-bridge compound to the mitigation 
    strategy that prevents it. The bridge-first protocol requires 
    consumption-path verification before enrichment begins."""@en ;
    skos:example "ex:enrichmentwithoutbridgeverification_instance redo:bridgeVerifiedBy ex:bridgefirstprotocol_instance . Links EnrichmentWithoutBridgeVerification to BridgeFirstProtocol."@en .

reliability:calibrationGapPts a owl:DatatypeProperty ;
    rdfs:label "calibrationGapPts"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.14 — added to support DRIFT-16 shape (2026-05-03)."@en ;
    rdfs:comment "Points attributable to calibration tier."@en ;
    rdfs:domain reliability:UserDataInsufficiencyDrift ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:decimal ;
    skos:definition "Points attributable to calibration tier."@en .

reliability:categorySpecificADR a owl:DatatypeProperty ;
    rdfs:label "category-specific autonomous detection rate"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:CategorySpecificCeiling ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "Autonomous detection rate for a specific failure category, expressed as 'category:rate' (e.g., 'Knowledge:0.67')."@en ;
    skos:example "ex:entity redo:categorySpecificADR \"value\"^^xsd:string . Entity has a categorySpecificADR property."@en .

reliability:causesImpact a owl:ObjectProperty ;
    rdfs:label "causes impact"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:FailureConcept ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    skos:definition "Relates a failure concept to the business impact categories it may cause."@en ;
    skos:example "Example: redo:DataFabrication redo:causesImpact ex:reputational_impact . Links the data fabrication failure to the reputational impact category it may cause."@en .

reliability:causesQualityDegradation a owl:ObjectProperty ;
    rdfs:label "causes quality degradation"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:QualityDegradationFactor ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:QualityCharacteristic ;
    skos:definition "Links degradation factor to the quality characteristic it impacts"@en ;
    skos:example "Example: ex:token_cost_constraint redo:causesQualityDegradation redo:Completeness . Links a token cost constraint to the completeness quality characteristic it degrades."@en .

reliability:classifiedAs a owl:ObjectProperty ;
    rdfs:label "classified as"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:Hallucination ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:HallucinationCategory ;
    skos:definition "Relates a hallucination instance to its taxonomic classification category."@en ;
    skos:example "Example: ex:hallucination_instance_1 redo:classifiedAs redo:ClosedDomainHallucination . Links a hallucination instance to its closed-domain taxonomic classification."@en .

reliability:classifiesAs a owl:ObjectProperty ;
    rdfs:label "classifiesAs"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:HallucinationCategory ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:Hallucination ;
    skos:definition "Relates a hallucination category classification to the specific hallucination instances it encompasses."@en ;
    skos:example "Example: redo:ClosedDomainHallucination redo:classifiesAs ex:hallucination_instance_1 . Inverse: links a hallucination category to a specific instance it encompasses."@en .

reliability:classifiesSeverity a owl:ObjectProperty ;
    rdfs:label "classifiesSeverity"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain core:SeverityLevel ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:Failure ;
    skos:definition "Relates severity levels to failure events they classify for prioritized incident response."@en ;
    skos:example "Example: redo:CriticalSeverity redo:classifiesSeverity ex:production_outage . Links the critical severity level to a production outage failure event for prioritized response."@en .

reliability:clopperPearsonCI a owl:DatatypeProperty ;
    rdfs:label "Clopper-Pearson confidence interval"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:MetaReliability ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "95% exact binomial confidence interval for rate estimates, formatted as '[lower, upper]'."@en ;
    skos:example "ex:entity redo:clopperPearsonCI \"value\"^^xsd:string . Entity has a clopperPearsonCI property."@en .

reliability:compactionEventDetected a owl:DatatypeProperty ;
    rdfs:label "compactionEventDetected"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.14 — added to support DRIFT-15 shape (2026-05-03)."@en ;
    rdfs:comment "True if a compaction event was observed in the session context."@en ;
    rdfs:domain reliability:CompactionFidelityDrift ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:boolean ;
    skos:definition "True if a compaction event was observed in the session context."@en .

reliability:compactionScope a owl:DatatypeProperty ;
    rdfs:label "compactionScope"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.14 — added to support DRIFT-15 shape (2026-05-03)."@en ;
    rdfs:comment "Description of which turns or message ranges were compacted (e.g. 'turns 1..47')."@en ;
    rdfs:domain reliability:CompactionFidelityDrift ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "Description of which turns or message ranges were compacted."@en .

reliability:complianceLevel a owl:DatatypeProperty ;
    rdfs:label "compliance level"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:ComplianceDepth ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:integer ;
    skos:definition "Numeric depth: 0=absent, 1=ritual, 2=procedural, 3=substantive, 4=verified."@en ;
    skos:example "ex:finding redo:complianceLevel \"high\"^^xsd:string . Finding has an assigned severity level."@en .

reliability:conflictDeclared a owl:DatatypeProperty ;
    rdfs:label "conflictDeclared"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.13 — added to support DRIFT-7..11 shapes (2026-05-03)."@en ;
    rdfs:comment "True iff the audit document declares the conflict in its own provenance section. False is the drift state."@en ;
    rdfs:domain reliability:SelfAuditConflictOfInterest ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:boolean ;
    skos:definition "True iff the audit document declares the conflict in its own provenance section. False is the drift state."@en .

reliability:consistencyTarget a owl:ObjectProperty ;
    rdfs:label "consistencyTarget"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain measurement:ConsistencyScore ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range qc:Consistency ;
    skos:definition "Relates consistency score to the consistency quality characteristic it quantitatively measures."@en ;
    skos:example "Example: ex:consistency_score redo:consistencyTarget redo:Consistency . Links a consistency score metric to the consistency quality characteristic it measures."@en .

reliability:constrains a owl:ObjectProperty ;
    rdfs:label "constrains"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:Constraint ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    skos:definition "Relates a constraint to the mitigation strategy whose implementation or effectiveness it limits or bounds."@en ;
    skos:example "Example: ex:budget_constraint redo:constrains redo:RAGRetrieval . Links a budget constraint to the RAG retrieval mitigation whose implementation it limits."@en .

reliability:constrainsCharacteristic a owl:ObjectProperty ;
    rdfs:label "constrains characteristic"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:Constraint ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:QualityCharacteristic ;
