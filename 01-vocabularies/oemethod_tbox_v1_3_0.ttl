    in LLM assessment conversations."""@en ;
    skos:example "ex:sycophanticreversal_instance redo:contradictsOwnPriorClaim ex:llmbehavioralpathology_instance . Links SycophanticReversal to LLMBehavioralPathology."@en .

reliability:costEffectivenessRatio a owl:DatatypeProperty ;
    rdfs:label "cost-effectiveness ratio"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "OE Pack v17.27.0 Challenge 2 — design-intent rdfs:domain extraction. Per skos:definition: \"Ratio of benefit to cost for the mitigation approach.\" Generalized to core:Mitigation since MitigationStrategy class does not exist."@en,
        "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
