    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf testing:TestArtifact ;
    skos:definition "A mechanism that determines the expected correct outcome for an ontology test case, providing the reference against which actual test results are compared to produce pass or fail judgments."@en ;
    prov:wasDerivedFrom reliability:TestOracle .

testing:TestReport a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Test Report"@en ;
    testing:migrationDate "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:TestReport ;
    rdfs:comment "Document summarizing test execution results and findings."@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf testing:TestArtifact ;
    skos:definition "A structured document summarizing the outcomes of ontology test execution, including pass and fail counts, coverage statistics, defect descriptions, and recommendations organized by test category and severity."@en ;
    prov:wasDerivedFrom reliability:TestReport .

testing:TestingPattern a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Testing Pattern"@en ;
    testing:migrationDate "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:TestingPattern ;
    rdfs:comment "A reusable solution template that establishes systematic testing approaches for recurring quality assurance challenges in ontology engineering."@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf testing:TestingMethodology ;
    skos:definition "A reusable solution template that establishes systematic testing approaches for recurring quality assurance challenges in ontology engineering."@en ;
    prov:wasDerivedFrom reliability:TestingPattern .

testing:UnitTest a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Unit Test"@en ;
    testing:migrationDate "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:UnitTest ;
    rdfs:comment "Test cases that verify individual ontology components in isolation."@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf testing:Test ;
    skos:definition "A test category that verifies individual ontology components in isolation, checking that single classes, properties, or axioms behave correctly without dependencies on the broader ontological context."@en ;
    prov:wasDerivedFrom reliability:UnitTest .

testing:UsabilityTest a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Usability Test"@en ;
    testing:migrationDate "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:UsabilityTest ;
    rdfs:comment "Tests that assess how easily users can understand and work with the ontology."@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf testing:NonFunctionalTest ;
    skos:definition "A non-functional test that evaluates how effectively domain experts can navigate, understand, and apply the ontology for their intended tasks, typically conducted through user studies or expert walkthroughs."@en ;
    prov:wasDerivedFrom reliability:UsabilityTest .

testing:UseCaseTesting a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Use Case Testing"@en ;
    testing:migrationDate "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:UseCaseTesting ;
    rdfs:comment "Verifying ontology supports defined usage scenarios."@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf testing:OntologyTesting ;
    skos:definition "A requirement validation technique that simulates end-to-end user scenarios against the deployed ontology, verifying that the system supports each documented use case from initial query through final result."@en ;
    prov:wasDerivedFrom reliability:UseCaseTesting .

testing:UserAcceptanceTest a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "User Acceptance Test"@en ;
    testing:migrationDate "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:UserAcceptanceTest ;
    rdfs:comment "User Acceptance Test - determines readiness for deployment."@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf testing:AcceptanceTest ;
    skos:definition "An acceptance test where domain experts and end users evaluate the ontology against their practical needs, verifying that concepts are recognizable, navigation is intuitive, and query results are meaningful."@en ;
    prov:wasDerivedFrom reliability:UserAcceptanceTest .

testing:VolumeTest a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Volume Test"@en ;
    testing:migrationDate "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:VolumeTest ;
    rdfs:comment "Volume Test - pushes ontology beyond normal operational limits."@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf testing:LoadTest ;
    skos:definition "A load test variant that populates the ontology with progressively larger datasets to determine how data volume affects query response times, reasoning performance, and storage requirements."@en ;
    prov:wasDerivedFrom reliability:VolumeTest .

testing:detectsHallucination a owl:ObjectProperty ;
