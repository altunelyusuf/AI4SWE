    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf testing:Test ;
    skos:definition "An organized collection of regression test cases maintained as a baseline that is re-executed after every ontology change to detect unintended side effects on previously working functionality."@en ;
    prov:wasDerivedFrom reliability:RegressionTestSuite .

testing:ScalabilityTest a owl:Class,
