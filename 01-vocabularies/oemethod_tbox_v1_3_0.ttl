    skos:example "Example: ex:latency_constraint redo:constrainsCharacteristic redo:Performance . Links a latency operational constraint to the performance quality characteristic it affects."@en .

reliability:consumes a owl:ObjectProperty ;
    rdfs:label "consumes"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain core:Process ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:Artifact ;
    skos:definition "Relates a process to its input artifact"@en ;
    skos:example "Example: ex:validation_process redo:consumes ex:ontology_file . Links a validation process to the ontology file it consumes as input."@en .

reliability:consumesArtifact a owl:ObjectProperty ;
    rdfs:label "consumes artifact"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain core:Process ;
