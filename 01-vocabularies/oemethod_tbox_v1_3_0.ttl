    rdfs:isDefinedBy <http://example.org/reliability> ;
    skos:definition "String description of the concrete implementation of a detection mechanism (e.g., \"release_preflight_v1_0_1.py P1 pattern...\"). Per Sprint F4."@en .

reliability:detectionLatency a owl:DatatypeProperty ;
    rdfs:label "detection latency"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:MetaReliability ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:decimal ;
    skos:definition "Average prompts between error introduction and detection. Zero = same-prompt prevention."@en ;
    skos:example "ex:entity redo:detectionLatency \"value\"^^xsd:string . Entity has a detectionLatency property."@en .

reliability:detectsCommunity a owl:ObjectProperty ;
    rdfs:label "detectsCommunity"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:CommunityDetectionMethod ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:GraphRAG ;
    skos:definition "Relates community detection methods to GraphRAG as the primary technique consuming community detection output for retrieval."@en ;
    skos:example "Example: ex:leiden_detection redo:detectsCommunity redo:GraphRAG . Links the Leiden community detection method to GraphRAG as the primary consumer of community detection output."@en .

reliability:detectsPathology a owl:ObjectProperty ;
    rdfs:label "detects pathology"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.4.6 property declaration. Derived from existing usage in CitationExistenceVerification." ;
    rdfs:domain reliability:VerificationModality ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:LLMBehavioralPathology ;
    skos:definition "Links a verification modality to the LLM behavioral pathology it is designed to detect. Distinguished from core:detects by its specificity to pathology-level detection rather than general failure mode detection."@en ;
    skos:example "Example: redo:CitationExistenceVerification redo:detectsPathology redo:DataFabrication ."@en .

reliability:discoveredInVersion a owl:DatatypeProperty ;
    rdfs:label "discovered in version"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.4.6 property declaration. Derived from existing usage in BlindSpot individuals." ;
    rdfs:domain reliability:BlindSpot ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "Records the ontology version in which a blind spot or defect was first identified. Used for provenance tracking of quality findings across ontology evolution."@en ;
    skos:example "Example: redo:BS_EcologicalFallacy redo:discoveredInVersion \"v2.3.1\" ."@en .

reliability:dormantCapabilityFor a owl:ObjectProperty ;
    rdfs:label "dormant capability for"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:CompetenceParadox ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:VerificationModality ;
    skos:definition """Relates a CompetenceParadox instance to the verification modality 
    that the assessor was capable of executing but did not initiate. 
    The capability is 'dormant' — it activates only on explicit prompt."""@en ;
    skos:example "ex:competenceparadox_instance redo:dormantCapabilityFor ex:verificationmodality_instance . Links CompetenceParadox to VerificationModality."@en .

reliability:downstreamPropagatedTrustLevel a owl:DatatypeProperty ;
    rdfs:label "downstreamPropagatedTrustLevel"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.13 — added to support DRIFT-7..11 shapes (2026-05-03)."@en ;
    rdfs:comment "The trust label assumed by the downstream consumer when citing the upstream evidence. It takes a value of the same controlled list as the upstream label: HIGH, MEDIUM, LOW, MISSING or FABRICATED."@en ;
    rdfs:domain reliability:InheritedTrustDegradationDrift ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "The trust label assumed by the downstream consumer when citing the upstream evidence. It takes a value of the same controlled list as the upstream label: HIGH, MEDIUM, LOW, MISSING or FABRICATED."@en .

reliability:enablesCharacteristic_Modularity a owl:ObjectProperty ;
    rdfs:label "enablesCharacteristic_Modularity"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:Modularity ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range qc:Reusability ;
    skos:definition "Relates modularity to reusability since well-decomposed modules are inherently more reusable across systems."@en ;
    skos:example "ex:modularity_instance redo:enablesCharacteristic_Modularity ex:reusability_instance . Links Modularity to Reusability."@en .

reliability:enablesCharacteristic_Testability a owl:ObjectProperty ;
    rdfs:label "enablesCharacteristic_Testability"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:Testability ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range qc:Reliability ;
    skos:definition "Relates testability to reliability since systems that can be thoroughly tested achieve higher operational reliability."@en ;
    skos:example "ex:testability_instance redo:enablesCharacteristic_Testability ex:reliability_instance . Links Testability to Reliability."@en .

reliability:engineGapPts a owl:DatatypeProperty ;
    rdfs:label "engineGapPts"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.14 — added to support DRIFT-16 shape (2026-05-03)."@en ;
    rdfs:comment "Points attributable to engine-bug tier of the gap-to-100."@en ;
    rdfs:domain reliability:UserDataInsufficiencyDrift ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:decimal ;
    skos:definition "Points attributable to engine-bug tier of the gap-to-100."@en .

reliability:enrichesLayerWithoutBridge a owl:ObjectProperty ;
    rdfs:label "enriches layer without bridge"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:EnrichmentWithoutBridgeVerification ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:DecorativeComplianceRate ;
    skos:definition """Relates an EnrichmentWithoutBridgeVerification instance to 
    the DecorativeComplianceRate it inflates. Each enrichment action 
    (adding shapes, labels, defaults) that bypasses bridge verification 
    increases the measured DCR — the ratio of structurally present but 
    functionally disconnected components. The range is the metric 
    (DecorativeComplianceRate) rather than the pathology class 
    (DecorativeCompliance) because EWBV produces a measurable increase 
    in decorative content, not an abstract pathology instance."""@en ;
    skos:example "ex:enrichmentwithoutbridgeverification_instance redo:enrichesLayerWithoutBridge ex:decorativecompliancerate_instance . Links EnrichmentWithoutBridgeVerification to DecorativeComplianceRate."@en .

reliability:estimatedCost a owl:DatatypeProperty ;
    rdfs:label "estimated cost"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "OE Pack v17.27.0 Challenge 2 — design-intent rdfs:domain extraction. Per skos:definition: \"Estimated financial cost of the impact (in currency units).\" BusinessImpact is the most general Impact class in risk:."@en,
        "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain risk:BusinessImpact ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:decimal ;
    skos:definition "Estimated financial cost of the impact (in currency units)"@en ;
    skos:example "ex:check redo:estimatedCost \"medium\"^^xsd:string . Activity has an associated cost level."@en .

reliability:evaluatedOn a owl:ObjectProperty ;
    rdfs:label "evaluatedOn"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain measurement:LLMReliabilityMetric ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:BenchmarkDataset ;
    skos:definition "Relates an LLM reliability metric to the benchmark dataset used to evaluate and calibrate that metric's measurements under controlled experimental conditions."@en ;
    skos:example "ex:llmreliabilitymetric_instance redo:evaluatedOn ex:benchmarkdataset_instance . Links LLMReliabilityMetric to BenchmarkDataset."@en .

reliability:evaluates a owl:ObjectProperty ;
    rdfs:label "evaluates"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation."@en ;
    rdfs:domain measurement:ReliabilityMetric ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:ReliabilityConcept ;
    skos:definition "Relates a metric, benchmark, or assessment method to the reliability concept, quality attribute, or system characteristic that it measures or assesses."@en ;
    skos:example "Example: ex:ece_metric redo:evaluates redo:ConfidenceMiscalibration . Links the Expected Calibration Error metric to the reliability concept it assesses."@en .

reliability:evaluatesMetric a owl:ObjectProperty ;
    rdfs:label "evaluates metric"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:BenchmarkDataset ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range measurement:LLMReliabilityMetric ;
    skos:definition "Relates a benchmark dataset to the LLM reliability metrics it is designed to evaluate."@en ;
    skos:example "ex:metric_instance redo:evaluatesMetric redo:Reliability . Metric evaluates a quality characteristic."@en .

reliability:exhibitsEffortAvoidance a owl:ObjectProperty ;
    rdfs:label "exhibits effort avoidance"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:LLMBehavioralPathology ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:EffortAvoidanceBias ;
    skos:definition """Relates a behavioral pathology instance to the effort avoidance 
    pattern that generated or reinforced it. Used to trace the causal chain 
    from observable failures (e.g., FalseImpossibilityClaim) back to the 
    underlying effort avoidance mechanism."""@en ;
    skos:example "ex:llmbehavioralpathology_instance redo:exhibitsEffortAvoidance ex:effortavoidancebias_instance . Links LLMBehavioralPathology to EffortAvoidanceBias."@en .

reliability:exhibitsPathology a owl:ObjectProperty ;
    rdfs:label "exhibits pathology"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:comment """Links an artifact or system to an observed behavioral
    pathology. An artifact may exhibit multiple pathologies simultaneously
    (e.g., both DecorativeCompliance and TestSuiteTheater)."""@en ;
    rdfs:domain reliability:Artifact ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:LLMBehavioralPathology ;
    skos:definition """Relates an LLM-generated artifact to a behavioral
    pathology observed in its generation or content"""@en ;
    skos:example "ex:artifact_instance redo:exhibitsPathology ex:llmbehavioralpathology_instance . Links Artifact to LLMBehavioralPathology."@en .

reliability:exhibitsPattern a owl:ObjectProperty ;
    rdfs:label "exhibits pattern"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:ZombieClaim ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:FabricatedMetadata ;
    skos:definition "Relates a zombie claim to the fabricated metadata pattern it exhibits."@en ;
    skos:example "ex:zombieclaim_instance redo:exhibitsPattern ex:fabricatedmetadata_instance . Links ZombieClaim to FabricatedMetadata."@en .

reliability:expectedTranscriptPath a owl:DatatypeProperty ;
    rdfs:label "expectedTranscriptPath"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.14 — added to support DRIFT-13 shape (2026-05-03)."@en ;
    rdfs:comment "Path where the transcript SHOULD be (typically /mnt/transcripts/<timestamp>-<title>.txt)."@en ;
    rdfs:domain reliability:TranscriptAvailabilityLagDrift ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "Path where the transcript SHOULD be."@en .

reliability:expectedTrustLabelTaxonomy a owl:DatatypeProperty ;
    rdfs:label "expectedTrustLabelTaxonomy"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.14 — added to support DRIFT-14 shape (2026-05-03)."@en ;
    rdfs:comment "Reference taxonomy that should be used (e.g. 'HIGH/MEDIUM/LOW/MISSING/FABRICATED')."@en ;
    rdfs:domain reliability:UpstreamTrustLabelMissingDrift ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "Reference taxonomy that should be used."@en .

reliability:exposedBy a owl:ObjectProperty ;
    rdfs:label "exposedBy"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:DataFabrication ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:VerificationMethod ;
    skos:definition "Relates a data fabrication failure to the verification method capable of exposing or detecting the fabricated content."@en ;
    skos:example "ex:datafabrication_instance redo:exposedBy ex:verificationmethod_instance . Links DataFabrication to VerificationMethod."@en .

reliability:factualityMetric a owl:ObjectProperty ;
    rdfs:label "factualityMetric"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain measurement:FactScore ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:Hallucination ;
    skos:definition "Relates FactScore to hallucination detection as a claim-level factual accuracy measurement."@en ;
    skos:example "ex:factscore_instance redo:factualityMetric ex:hallucination_instance . Links FactScore to Hallucination."@en .

reliability:fallbackEvidence a owl:DatatypeProperty ;
    rdfs:label "fallbackEvidence"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.14 — added to support DRIFT-13 shape (2026-05-03)."@en ;
    rdfs:comment "Description of the fallback evidence channel used (e.g. 'in-context conversation', 'on-disk artefact byte-SHA')."@en ;
    rdfs:domain reliability:TranscriptAvailabilityLagDrift ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "Description of the fallback evidence channel used."@en .

reliability:fallbackEvidenceSource a owl:DatatypeProperty ;
    rdfs:label "fallbackEvidenceSource"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.14 — added to support DRIFT-15 shape (2026-05-03)."@en ;
    rdfs:comment "Description of the disk-files or other artefacts cited in place of the compacted summary."@en ;
    rdfs:domain reliability:CompactionFidelityDrift ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "Description of the disk-files or other artefacts cited in place of the compacted summary."@en .

reliability:forcesTradeoff a owl:ObjectProperty ;
    rdfs:label "forces tradeoff"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:CostConstraint ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:QualityTradeoff ;
    skos:definition "Links cost constraint to the quality tradeoffs it necessitates"@en ;
    skos:example "ex:costconstraint_instance redo:forcesTradeoff ex:qualitytradeoff_instance . Links CostConstraint to QualityTradeoff."@en .

reliability:foreignSessionURI a owl:DatatypeProperty ;
    rdfs:label "foreign session URI"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.12 — CrossSessionContamination evidence requirement." ;
    rdfs:domain reliability:CrossSessionContamination ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:anyURI ;
    skos:definition "URI/identifier of the OTHER session whose content was contaminated into the current session. May be a claude.ai/chat/<uuid> URL, a transcript filename, or a conversation_search result identifier. Required for the contamination to be traceable."@en .

reliability:gapMetric a owl:ObjectProperty ;
    rdfs:label "gapMetric"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:AdmissibilityGapIndex ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:FailureOfHonestAssessment ;
    skos:definition "Relates admissibility gap index to failure of honest assessment since AGI quantifies the gap between claimed and actual quality."@en ;
    skos:example "ex:admissibilitygapindex_instance redo:gapMetric ex:failureofhonestassessment_instance . Links AdmissibilityGapIndex to FailureOfHonestAssessment."@en .

reliability:gateStage a owl:ObjectProperty ;
    rdfs:label "gate stage"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Cooper, R.G. (1990). Stage-Gate Systems. Business Horizons, 33(3). Adapted for a reliability ontology gate-stage linking." ;
    rdfs:domain reliability:ComplianceGate ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:LifecyclePhase ;
    skos:definition "Links a compliance gate to the lifecycle stage at which the gate is applied. Identifies the point in the software delivery pipeline where the gate enforces its constraints."@en ;
    skos:example "Example: redo:ReferenceIntegrityGate redo:gateStage redo:PostGenerationStage ."@en .

reliability:groundingMetric a owl:ObjectProperty ;
    rdfs:label "groundingMetric"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain measurement:GroundingScore ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:RetrievalAugmentedGeneration ;
    skos:definition "Relates grounding score to RAG systems as the primary context where source grounding is measured."@en ;
    skos:example "ex:groundingscore_instance redo:groundingMetric ex:retrievalaugmentedgeneration_instance . Links GroundingScore to RetrievalAugmentedGeneration."@en .

reliability:hasActualResult a owl:DatatypeProperty ;
    rdfs:label "has actual result"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain qc:TestCase ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "Captures the real result or behavior observed during test execution."@en ;
    skos:example "ex:entity redo:hasActualResult \"value\"^^xsd:string . Entity has a hasActualResult property."@en .

reliability:hasBehaviorConcern a owl:ObjectProperty ;
    rdfs:label "has behavior concern"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:comment """Links an artifact to a BehaviorConcern that defines
    the non-negotiable semantic boundaries for that artifact. Every
    artifact in a reliability-compliant system should have at least one
    associated BehaviorConcern."""@en ;
    rdfs:domain reliability:Artifact ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:BehaviorConcern ;
    skos:definition """Relates an LLM-generated artifact to a BehaviorConcern
    defining the non-negotiable semantic boundaries and behavioral
    expectations for that artifact"""@en ;
    skos:example "ex:entity redo:hasBehaviorConcern ex:BehaviorConcern . Entity has an associated BehaviorConcern."@en .

reliability:hasBlindSpot a owl:ObjectProperty ;
    rdfs:label "has blind spot"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:BlindSpotRegister ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:BlindSpot ;
    skos:definition "Links a blind spot register to an individual blind spot entry."@en ;
    skos:example "ex:entity redo:hasBlindSpot ex:BlindSpot . Entity has an associated BlindSpot."@en .

reliability:hasBusinessConsequence a owl:ObjectProperty ;
    rdfs:label "hasBusinessConsequence"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:FailureConcept ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    skos:definition "Relates a failure event or failure concept to its organizational business impact category, enabling impact-driven prioritization."@en ;
    skos:example "ex:entity redo:hasBusinessConsequence ex:BusinessImpact . Entity has an associated BusinessImpact."@en .

reliability:hasBusinessImpact a owl:ObjectProperty ;
    rdfs:label "has business impact"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:comment """This property enables connecting technical reliability assessment 
    to business outcomes for prioritization and decision-making"""@en ;
    rdfs:domain reliability:Failure ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    skos:definition "Links technical failure to its business consequences"@en ;
    skos:example "ex:entity redo:hasBusinessImpact ex:BusinessImpact . Entity has an associated BusinessImpact."@en .

reliability:hasCause a owl:ObjectProperty ;
    rdfs:label "has cause"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:comment "Used to link Failure → Fault → Error causality chains"@en ;
    rdfs:domain reliability:FailureConcept ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:FailureConcept ;
    owl:inverseOf reliability:causes ;
    skos:definition "Relates an effect to its cause in failure chains"@en ;
    skos:example "ex:entity redo:hasCause ex:FailureConcept . Entity has an associated FailureConcept."@en .

reliability:hasCommunityDetection a owl:ObjectProperty ;
    rdfs:label "has community detection"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:GraphRAG ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:CommunityDetectionMethod ;
    skos:definition "Links GraphRAG to the specific community detection method used"@en ;
    skos:example "ex:entity redo:hasCommunityDetection ex:CommunityDetectionMethod . Entity has an associated CommunityDetectionMethod."@en .

reliability:hasComplianceGate a owl:ObjectProperty ;
    rdfs:label "has compliance gate"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:comment """Links a development process or lifecycle phase to
    a compliance gate enforcing verification at that point. A process
    may have multiple compliance gates at different boundaries."""@en ;
    rdfs:domain core:Process ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:ComplianceGate ;
    skos:definition """Relates a development process or lifecycle phase to
    an automated compliance gate that mechanically enforces verification
    at that point in the workflow"""@en ;
    skos:example "ex:entity redo:hasComplianceGate ex:ComplianceGate . Entity has an associated ComplianceGate."@en .

reliability:hasComplianceLevel a owl:DatatypeProperty ;
    rdfs:label "has compliance level"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain qc:TestCase ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "Records the compliance assessment result of a test case execution."@en ;
    skos:example "ex:finding redo:hasComplianceLevel \"high\"^^xsd:string . Finding has an assigned severity level."@en .

reliability:hasConfidence a owl:DatatypeProperty ;
    rdfs:label "has confidence"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:comment "Range typically 0.0 to 1.0"@en ;
    rdfs:domain core:Metric ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:decimal ;
    skos:definition "Confidence level of a measurement or assessment"@en ;
    skos:example "ex:measurement redo:hasConfidence \"0.92\"^^xsd:decimal . Measurement carries a confidence level."@en .

reliability:hasConfidenceLevel a owl:DatatypeProperty ;
    rdfs:label "hasConfidenceLevel"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:EmpiricalTest ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:decimal ;
    skos:definition "Records the statistical confidence level of an empirical test result as a decimal value between 0 and 1."@en ;
    skos:example "ex:measurement redo:hasConfidenceLevel \"0.92\"^^xsd:decimal . Measurement carries a confidence level."@en .

reliability:hasConstraint a owl:ObjectProperty ;
    rdfs:label "has constraint"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:DomainContext ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:Constraint ;
    skos:definition "Relates a domain context to the constraints that govern reliability engineering within that domain."@en ;
    skos:example "Example: redo:MedicalDomain redo:hasConstraint ex:hipaa_compliance . Links the medical domain context to the HIPAA compliance constraint governing reliability practices."@en .

reliability:hasEconomicConstraint a owl:ObjectProperty ;
    rdfs:label "has economic constraint"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:ReliabilityAttribute ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:CostConstraint ;
    skos:definition "Links reliability attribute to economic constraints affecting it"@en ;
    skos:example "ex:entity redo:hasEconomicConstraint ex:CostConstraint . Entity has an associated CostConstraint."@en .

reliability:hasEvidenceBinding a owl:ObjectProperty ;
    rdfs:label "has evidence binding"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:comment """Links an artifact to its evidence-object binding,
    establishing traceability between claims in the artifact and their
    supporting evidence sources. Absence of this property for a
    decision-relevant artifact indicates zombie claim risk."""@en ;
    rdfs:domain reliability:Artifact ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:EvidenceObjectBinding ;
    skos:definition """Relates an LLM-generated artifact to an evidence-object
    binding that establishes traceable linkage between decision-relevant
    claims and their supporting evidence sources"""@en ;
    skos:example "ex:entity redo:hasEvidenceBinding ex:EvidenceObjectBinding . Entity has an associated EvidenceObjectBinding."@en .

reliability:hasExpectedResult a owl:DatatypeProperty ;
    rdfs:label "has expected result"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain qc:TestCase ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "Defines the expected correct outcome for a test case execution."@en ;
    skos:example "ex:entity redo:hasExpectedResult \"value\"^^xsd:string . Entity has a hasExpectedResult property."@en .

reliability:hasExternalFactor a owl:ObjectProperty ;
    rdfs:label "has external factor"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:ExternalFactor ;
    skos:definition "Relates a reliability concept to external factors that influence its behavior or effectiveness."@en ;
    skos:example "ex:entity redo:hasExternalFactor ex:ExternalFactor . Entity has an associated ExternalFactor."@en .

reliability:hasExternalMetadata a owl:AnnotationProperty ;
    rdfs:label "has external metadata"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:BenchmarkDataset ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:anyURI ;
    skos:definition "URI linking to detailed external metadata (e.g., Hugging Face, Papers with Code)"@en ;
    skos:example "ex:entity redo:hasExternalMetadata \"value\"^^xsd:anyURI . Entity has a hasExternalMetadata property."@en .

reliability:hasIdentifiedRisk a owl:ObjectProperty ;
    rdfs:label "has identified risk"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.7.0 risk-and-problem-management framework; ISO 31000:2018 §6.4."@en ;
    rdfs:domain qc:OntologyArtifact ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    skos:definition "Links an ontology artefact to a Risk identified during RiskAssessment. Supports per-artefact risk register population."@en .

reliability:hasImpactOn a owl:ObjectProperty ;
    rdfs:label "has impact on"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range core:Stakeholder ;
    skos:definition "Relates a business impact assessment to the stakeholders affected by the reliability failure."@en ;
    skos:example "Example: ex:outage_impact redo:hasImpactOn ex:enterprise_customers . Links a business impact assessment to the stakeholder group affected by a service outage."@en .

reliability:hasLikelihood a owl:DatatypeProperty ;
    rdfs:label "has likelihood"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO 31000:2018; a reliability ontology v2.7.0 risk-and-problem-management extension."@en,
        "OE Pack v17.27.0 Challenge 2 — design-intent rdfs:domain extraction. Per skos:definition: \"likelihood of a risk's event occurring.\""@en ;
    rdfs:domain risk:Risk ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:decimal ;
    skos:definition "Quantitative or normalised qualitative likelihood of a risk's event occurring, expressed as a decimal in [0,1]. Recommended encoding: rare=0.05, unlikely=0.2, possible=0.5, likely=0.8, almost certain=0.95."@en .

reliability:hasManifest a owl:ObjectProperty ;
    rdfs:label "has manifest"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.4.9 — C8Out gate and SprintClosureChecklist. AMOD v1.0.1 — configuration:SprintManifest. Derived from USO v2.0 Sprint 12 post-mortem, April 2026."@en ;
    rdfs:comment "No inverse property declared in AMOD to avoid circular imports: a reliability ontology imports AMOD, so AMOD must not import a reliability ontology. If an inverse is needed, it belongs in a separate bridge alignment file."@en ;
    rdfs:domain reliability:C8Out ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range configuration:SprintManifest ;
    skos:definition "Relates a redo:C8Out compliance gate instance to the configuration:SprintManifest that it validates. A C8Out gate instance declares its manifest via this property; the manifest enumerates every sprint deliverable that must exist on disk (with SHA-256) before the GATE_VECTOR VERDICT is issued. Formalises the informal SPRINT_MANIFEST concept used in a reliability ontology safeguard documents (v1.1+) as a typed, machine-traversable OWL property."@en .

reliability:hasMaturityLevel a owl:ObjectProperty ;
    rdfs:label "has maturity level"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain core:Process ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:ReliabilityMaturityLevel ;
    skos:definition "Assigns a reliability maturity level classification to a reliability engineering process or practice."@en ;
    skos:example "ex:entity redo:hasMaturityLevel ex:ReliabilityMaturityLevel . Entity has an associated ReliabilityMaturityLevel."@en .

reliability:hasMitigationCost a owl:DatatypeProperty ;
    rdfs:label "hasMitigationCost"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "OE Pack v17.27.0 Challenge 2 — design-intent rdfs:domain extraction. Per skos:definition: \"implementation cost ... of a mitigation strategy.\" Generalized to core:Mitigation since MitigationStrategy class does not exist."@en,
        "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain core:Mitigation ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "Records the estimated implementation cost category of a mitigation strategy as a structured cost descriptor."@en ;
    skos:example "ex:check redo:hasMitigationCost \"medium\"^^xsd:string . Activity has an associated cost level."@en .

reliability:hasPlaybook a owl:ObjectProperty ;
    rdfs:label "has playbook"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.7.0."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    skos:definition "Links a MitigationStrategy to the Playbook describing how to apply it. A MitigationStrategy without a Playbook is a vocabulary entry; with a Playbook it becomes operationalised."@en .

reliability:hasProbability a owl:DatatypeProperty ;
    rdfs:label "has probability"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO 3534-1:2006."@en,
        "OE Pack v17.27.0 Challenge 2 — design-intent rdfs:domain extraction. Per skos:definition: \"probability of a risk's event occurring.\""@en ;
    rdfs:domain risk:Risk ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:decimal ;
    skos:definition "Formal probability of a risk's event occurring, in [0,1]. Use when statistical evidence is available; otherwise prefer redo:hasLikelihood."@en .

reliability:hasResolutionOutcome a owl:ObjectProperty ;
    rdfs:label "has resolution outcome"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.10.0 issue-lifecycle extension."@en ;
    rdfs:domain reliability:Problem ;
    rdfs:isDefinedBy <http://example.org/redo/v2.10.0/issue-lifecycle> ;
    rdfs:range reliability:ResolutionOutcome ;
    skos:definition "Links a Problem (or IssueLifecycleRecord) to a ResolutionOutcome SKOS concept categorizing its disposition. Functional in practice: each issue has one current outcome, though history is preserved via lifecycle record versioning rather than multi-valuation."@en .

reliability:hasRiskTreatment a owl:ObjectProperty ;
    rdfs:label "has risk treatment"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO 31000:2018 §6.5 risk treatment."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    skos:definition "Links a Risk to the MitigationStrategy chosen to treat it. Per ISO 31000, risk treatment options include: avoid, reduce, transfer, accept. The chosen mitigation is the operational response."@en .

reliability:hasRole a owl:ObjectProperty ;
    rdfs:label "has role"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:Agent ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range core:Role ;
    skos:definition "Relates an agent to their role in reliability engineering"@en ;
    skos:example "Example: ex:alice redo:hasRole redo:ReliabilityEngineer_SRE . Assigns the SRE role to agent Alice in a reliability engineering context."@en .

reliability:hasRootCause a owl:ObjectProperty ;
    rdfs:label "has root cause"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Andersen & Fagerhaug (2006); a reliability ontology v2.7.0."@en ;
    rdfs:domain reliability:Problem ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:RootCause ;
    skos:definition "Links a Problem (or Failure, via redo:Failure-to-Problem reduction) to the RootCause identified by RootCauseAnalysis. A Problem may have multiple contributing RootCauses; this property is many-to-many."@en .

reliability:hasSeverity a owl:DatatypeProperty ;
    rdfs:label "has severity"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.12 — drift incident triage.",
        "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:comment """Severity provides a technical assessment that can be correlated with 
    business impact for prioritization"""@en,
        "Typical values: Critical, High, Medium, Low"@en ;
    rdfs:domain reliability:Drift,
        reliability:Failure,
        reliability:FailureConcept ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "The seriousness of a recorded drift incident, or of a failure or fault, as a technical level that business stakeholders can interpret for impact assessment. For a drift incident the level is LOW, MEDIUM or HIGH: HIGH blocks sprint closure, MEDIUM requires mitigation in the same session, and LOW is tracked for the backlog."@en ;
    skos:example "Example: ex:my_failure_instance redo:hasSeverity \"HIGH\" . Assigns severity literal."@en .

reliability:hasSource a owl:ObjectProperty ;
    rdfs:label "has source"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:EvidenceObjectBinding ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:Artifact ;
    skos:definition "Links an evidence-object binding to the source artifact that provides the supporting evidence."@en ;
    skos:example "Example: ex:eob_shacl_result redo:hasSource ex:validation_report_v2 . Links an evidence-object binding to the SHACL validation report that provides substantiation."@en .

reliability:hasTestCase a owl:ObjectProperty ;
    rdfs:label "has test case"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain qc:TestSuite ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range qc:TestCase ;
    skos:definition "Relates a test suite to its constituent test cases."@en ;
    skos:example "ex:entity redo:hasTestCase ex:TestCase . Entity has an associated TestCase."@en .

reliability:hasTimestamp a owl:DatatypeProperty ;
    rdfs:label "has timestamp"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain core:Process ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:dateTime ;
    skos:definition "Temporal marker for an event or observation"@en ;
    skos:example "ex:event redo:hasTimestamp \"2026-01-15\"^^xsd:date . Event records a temporal reference."@en .

reliability:hasTradeoff a owl:ObjectProperty ;
    rdfs:label "has tradeoff"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:QualityCharacteristic ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:QualityTradeoff ;
    skos:definition "Relates a quality characteristic to known tradeoffs with competing quality dimensions."@en ;
    skos:example "ex:entity redo:hasTradeoff ex:QualityTradeoff . Entity has an associated QualityTradeoff."@en .

reliability:hasUnit a owl:DatatypeProperty ;
    rdfs:label "has unit"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain core:Metric ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "Specifies the unit of measurement for a metric"@en ;
    skos:example "ex:entity redo:hasUnit \"value\"^^xsd:string . Entity has a hasUnit property."@en .

reliability:hasValue a owl:DatatypeProperty ;
    rdfs:label "has value"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain core:Metric ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:decimal ;
    skos:definition "Numerical value of a metric measurement"@en ;
    skos:example "ex:metric_instance redo:hasValue \"0.85\"^^xsd:decimal . Metric records a measurement value."@en .

reliability:hierarchicalSummarizationDepth a owl:DatatypeProperty ;
    rdfs:label "hierarchical summarization depth"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:GraphRAG ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:integer ;
    skos:definition "Number of hierarchical levels in the summarization structure"@en ;
    skos:example "ex:entity redo:hierarchicalSummarizationDepth \"value\"^^xsd:integer . Entity has a hierarchicalSummarizationDepth property."@en .

reliability:impactSeverity a owl:ObjectProperty ;
    rdfs:label "impact severity"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range core:SeverityLevel ;
    skos:definition "Severity level of the business impact"@en ;
    skos:example "ex:failure_instance redo:impactSeverity redo:SeverityLevel . Links failure to affected quality dimension."@en .

reliability:impactsStakeholder a owl:ObjectProperty ;
    rdfs:label "impactsStakeholder"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range core:Stakeholder ;
    skos:definition "Relates a business impact category to the stakeholder group most directly affected by that type of reliability failure impact."@en ;
    skos:example "ex:failure_instance redo:impactsStakeholder redo:Stakeholder . Links failure to affected quality dimension."@en .

reliability:implementedDuring a owl:ObjectProperty ;
    rdfs:label "implementedDuring"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:LifecyclePhase ;
    skos:definition "Relates a mitigation strategy to the lifecycle phase during which it is most effectively implemented."@en ;
    skos:example "ex:mitigationstrategy_instance redo:implementedDuring ex:lifecyclephase_instance . Links MitigationStrategy to LifecyclePhase."@en .

reliability:improvesCharacteristic a owl:ObjectProperty ;
    rdfs:label "improvesCharacteristic"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:QualityCharacteristic ;
    skos:definition "Relates a mitigation strategy to the quality characteristic it is designed to improve or restore."@en ;
    skos:example "ex:mitigationstrategy_instance redo:improvesCharacteristic ex:qualitycharacteristic_instance . Links MitigationStrategy to QualityCharacteristic."@en .

reliability:improvesEvolution a owl:ObjectProperty ;
    rdfs:label "improvesEvolution"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:Evolution ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range qc:Adaptability ;
    skos:definition "Relates the evolution phase to adaptability since evolutionary changes directly exercise system adaptation capabilities."@en ;
    skos:example "ex:evolution_instance redo:improvesEvolution ex:adaptability_instance . Links Evolution to Adaptability."@en .

reliability:inferenceProfile a owl:DatatypeProperty ;
    rdfs:label "inference profile"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.12 — ValidationScopeDrift evidence requirement." ;
    rdfs:domain reliability:ValidationScopeDrift ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "The inference profile under which a verdict was obtained. Allowed values: 'none' (no entailment), 'rdfs' (RDFS Semantics including reflexive subClassOf), 'owlrl' (OWL 2 RL Semantics), 'owl-dl-hermit' (HermiT OWL 2 DL reasoner)."@en .

reliability:influencesTradeoff a owl:ObjectProperty ;
    rdfs:label "influences tradeoff"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:ExternalFactor ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:QualityTradeoff ;
    skos:definition "Relates an external factor to the quality trade-off decisions it influences."@en ;
    skos:example "ex:externalfactor_instance redo:influencesTradeoff ex:qualitytradeoff_instance . Links ExternalFactor to QualityTradeoff."@en .

reliability:inheritsProvenance a owl:ObjectProperty ;
    rdfs:label "inheritsProvenance"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:ZombieDerivedClaim ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:ZombieClaim ;
    skos:definition "Relates derived zombie claims to their parent zombie claims from which they inherit the provenance deficit."@en ;
    skos:example "Example: ex:derived_claim_42 redo:inheritsProvenance ex:zombie_claim_7 . Links a derived zombie claim to its parent from which it inherits the provenance deficit."@en .

reliability:investigatesBehavior a owl:ObjectProperty ;
    rdfs:label "investigatesBehavior"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:BehaviorConcern ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:LLMBehavioralPathology ;
    skos:definition "Relates a behavior concern observation to the pathology class it potentially indicates."@en ;
    skos:example "ex:behaviorconcern_instance redo:investigatesBehavior ex:llmbehavioralpathology_instance . Links BehaviorConcern to LLMBehavioralPathology."@en .

reliability:isSubclassOf a owl:ObjectProperty ;
    rdfs:label "is subclass of"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:Entity ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:Entity ;
    owl:equivalentProperty rdfs:subClassOf ;
    skos:definition "Hierarchical specialization relationship"@en ;
    skos:example "ex:entity_instance redo:isSubclassOf ex:entity_instance . Links Entity to Entity."@en .

reliability:issueDescribedBy a owl:ObjectProperty ;
    rdfs:label "issue described by"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.10.0 issue-lifecycle extension."@en ;
    rdfs:domain reliability:Problem ;
    rdfs:isDefinedBy <http://example.org/redo/v2.10.0/issue-lifecycle> ;
    skos:definition "Links an IssueLifecycleRecord to the source artifact that describes the issue (a Drift incident, a CHANGELOG entry, a PROV-O record). Open range to accommodate multiple description-source types."@en .

reliability:learnedFrom a owl:ObjectProperty ;
    rdfs:label "learned from"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.7.0; PMBOK 7th ed. Lessons Learned Register."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    owl:inverseOf reliability:documentedIn ;
    skos:definition "Links a KnowledgeArticle (especially LessonsLearned) to the source incident, Drift, Failure, or Problem from which the lesson was extracted. Inverse of documentedIn."@en .

reliability:learnedFromIssue a owl:ObjectProperty ;
    rdfs:label "learned from issue"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.10.0 issue-lifecycle extension."@en ;
    rdfs:isDefinedBy <http://example.org/redo/v2.10.0/issue-lifecycle> ;
    rdfs:range reliability:Problem ;
    skos:definition "Links a LessonsLearned record to the Problem from which the lesson was derived. Multiple lessons may derive from one problem; one lesson may aggregate insights from multiple problems."@en .

reliability:limitsResource_Compute a owl:ObjectProperty ;
    rdfs:label "limitsResource_Compute"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:ComputationalResourceConstraint ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:ActivationEngineering ;
    skos:definition "Relates computational resource constraints to activation engineering since runtime intervention requires additional inference compute."@en ;
    skos:example "ex:computationalresourceconstraint_instance redo:limitsResource_Compute ex:activationengineering_instance . Links ComputationalResourceConstraint to ActivationEngineering."@en .

reliability:limitsResource_Token a owl:ObjectProperty ;
    rdfs:label "limitsResource_Token"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:TokenCostConstraint ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:RetrievalAugmentedGeneration ;
    skos:definition "Relates token cost constraints to RAG systems since retrieval augmentation significantly increases per-query token consumption."@en ;
    skos:example "ex:tokencostconstraint_instance redo:limitsResource_Token ex:retrievalaugmentedgeneration_instance . Links TokenCostConstraint to RetrievalAugmentedGeneration."@en .

reliability:majorChanges a owl:DatatypeProperty ;
    rdfs:label "major changes"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 12207:2017. Systems and software engineering — Software life cycle processes. Change management." ;
    rdfs:domain reliability:OntologyVersion ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "Describes the significant changes introduced in an ontology version release. Used for change log documentation within the ontology itself."@en ;
    skos:example "Example: redo:Version_1_0 redo:majorChanges \"Initial release of a reliability ontology.\" ."@en .

reliability:manifestsAs a owl:ObjectProperty ;
    rdfs:label "manifests as"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:SoftwareFault ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:FailureConcept ;
    skos:definition "Relates a software fault to the observable failure behavior it produces when activated."@en ;
    skos:example "ex:softwarefault_instance redo:manifestsAs ex:failureconcept_instance . Links SoftwareFault to FailureConcept."@en .

reliability:mappingMetric a owl:ObjectProperty ;
    rdfs:label "mappingMetric"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:MitigationMappingRatio ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    skos:definition "Relates mitigation mapping ratio to the mitigation strategy class whose coverage it measures."@en ;
    skos:example "ex:mitigationmappingratio_instance redo:mappingMetric ex:mitigationstrategy_instance . Links MitigationMappingRatio to MitigationStrategy."@en .

reliability:measuredAt a owl:DatatypeProperty ;
    rdfs:label "measured at"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Sprint F4 (2026-05-14): property declared from raw usage analysis (domain/range inferred per BP-D2 from existing ABox patterns). Per L-47v2: full skos:definition included."@en ;
    rdfs:domain reliability:MeasurementSnapshot ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:dateTime ;
    skos:definition "Timestamp (xsd:dateTime) at which a MeasurementSnapshot was taken. Per L-11: use xsd:dateTime exclusively (not xsd:date). Per Sprint F4: 4 usages."@en .

reliability:measuredByMetric_Availability a owl:ObjectProperty ;
    rdfs:label "measuredByMetric_Availability"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain qc:Availability ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:MTBF ;
    skos:definition "Relates the availability quality characteristic to Mean Time Between Failures as its primary quantitative indicator."@en ;
    skos:example "ex:availability_instance redo:measuredByMetric_Availability ex:mtbf_instance . Links Availability to MTBF."@en .

reliability:measuredByMetric_Maturity a owl:ObjectProperty ;
    rdfs:label "measuredByMetric_Maturity"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:Maturity ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:MTTF ;
    skos:definition "Relates the maturity characteristic to Mean Time To Failure as an indicator of operational stability."@en ;
    skos:example "ex:maturity_instance redo:measuredByMetric_Maturity ex:mttf_instance . Links Maturity to MTTF."@en .

reliability:measuredByMetric_Performance a owl:ObjectProperty ;
    rdfs:label "measuredByMetric_Performance"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:Performance ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    skos:definition "Relates performance to failure rate as a key degradation indicator under load conditions."@en ;
    skos:example "ex:performance_instance redo:measuredByMetric_Performance ex:failurerate_instance . Links Performance to FailureRate."@en .

reliability:measuredByMetric_Recoverability a owl:ObjectProperty ;
    rdfs:label "measuredByMetric_Recoverability"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain qc:Recoverability ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:MTTR ;
    skos:definition "Relates the recoverability characteristic to Mean Time To Repair as its primary recovery performance indicator."@en ;
    skos:example "ex:recoverability_instance redo:measuredByMetric_Recoverability ex:mttr_instance . Links Recoverability to MTTR."@en .

reliability:measures a owl:ObjectProperty ;
    rdfs:label "measures"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Sprint F4 (2026-05-14): property declared from raw usage analysis (domain/range inferred per BP-D2 from existing ABox patterns). Per L-47v2: full skos:definition included."@en ;
    rdfs:domain measurement:Measurement ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range qc:QualityDimension ;
    skos:definition "Links a reliability measurement to a QualityDimension (typically quality:Reliability or a sub-dimension). Conceptually paired with measuresAttribute (attribute-level) and measuresCriterion (criterion-level). Per Sprint F4: 4 usages on ComplianceDepth."@en .

reliability:measuresAccuracy a owl:ObjectProperty ;
    rdfs:label "measuresAccuracy"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain measurement:F1Score ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:Precision ;
    skos:definition "Relates F1Score to precision as one of its two component metrics in the harmonic mean calculation."@en ;
    skos:example "ex:f1score_instance redo:measuresAccuracy ex:precision_instance . Links F1Score to Precision."@en .

reliability:measuresAttribute a owl:ObjectProperty ;
    rdfs:label "measures attribute"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Sprint F4 (2026-05-14): property declared from raw usage analysis (domain/range inferred per BP-D2 from existing ABox patterns). Per L-47v2: full skos:definition included."@en ;
    rdfs:domain measurement:Measurement ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    skos:definition "Links a reliability metric to the attribute or pathology it measures (DecorativeCompliance, Overconfidence, ZombieClaim, etc.). Domain is broad — any reliability-related measurement. Per Sprint F4: 11 usages."@en .

reliability:measuresCompleteness a owl:ObjectProperty ;
    rdfs:label "measuresCompleteness"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:Recall ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range qc:Completeness ;
    skos:definition "Relates recall to completeness since recall measures the completeness of positive detection coverage."@en ;
    skos:example "ex:recall_instance redo:measuresCompleteness ex:completeness_instance . Links Recall to Completeness."@en .

reliability:measuresReliability a owl:ObjectProperty ;
    rdfs:label "measuresReliability"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain measurement:ReliabilityMetric ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range qc:Reliability ;
    skos:definition "Relates a traditional reliability metric to the reliability quality characteristic it specifically quantifies."@en ;
    skos:example "ex:reliabilitymetric_instance redo:measuresReliability ex:reliability_instance . Links ReliabilityMetric to Reliability."@en .

reliability:measuresReliabilityAspect a owl:ObjectProperty ;
    rdfs:label "measures reliability aspect"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:BenchmarkDataset ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:ReliabilityAttribute ;
    skos:definition "Links benchmark to the specific reliability attribute it assesses"@en ;
    skos:example "Example: ex:truthfulqa_benchmark redo:measuresReliabilityAspect redo:Hallucination . Links TruthfulQA benchmark to the hallucination reliability attribute it assesses."@en .

reliability:mechanismType a owl:DatatypeProperty ;
    rdfs:label "mechanism type"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Sprint F4 (2026-05-14): property declared from raw usage analysis (domain/range inferred per BP-D2 from existing ABox patterns). Per L-47v2: full skos:definition included."@en ;
    rdfs:domain reliability:DetectionMechanism ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    skos:definition "String description of the detection-mechanism kind for a Reliability DetectionMechanism instance (e.g., \"Programmatic raw scan\"). Per Sprint F4."@en .

reliability:mitigatedBy a owl:ObjectProperty ;
    rdfs:label "mitigated by"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:FailureConcept ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    owl:inverseOf core:mitigates ;
    skos:definition "Relates a failure concept to the mitigation strategies capable of addressing it."@en ;
    skos:example "Example: redo:Hallucination redo:mitigatedBy redo:RAGRetrieval . Links the hallucination failure concept to RAG retrieval as a mitigation strategy."@en .

reliability:mitigatedByStrategy_Bohrbug a owl:ObjectProperty ;
    rdfs:label "mitigatedByStrategy_Bohrbug"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:Bohrbug ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:FaultRemoval ;
    skos:definition "Relates Bohrbugs to fault removal as the primary mitigation since their deterministic nature makes them systematically identifiable."@en ;
    skos:example "ex:hallucination_instance redo:mitigatedByStrategy_Bohrbug redo:RAGRetrieval . Links failure to mitigation strategy."@en .

reliability:mitigatedByStrategy_Heisenbug a owl:ObjectProperty ;
    rdfs:label "mitigatedByStrategy_Heisenbug"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:Heisenbug ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:FaultPrevention ;
    skos:definition "Relates Heisenbugs to fault prevention since observation-sensitive bugs must be prevented by design rather than debugged."@en ;
    skos:example "ex:hallucination_instance redo:mitigatedByStrategy_Heisenbug redo:RAGRetrieval . Links failure to mitigation strategy."@en .

reliability:mitigatedByStrategy_Mandelbug a owl:ObjectProperty ;
    rdfs:label "mitigatedByStrategy_Mandelbug"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:Mandelbug ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:FaultForecasting ;
    skos:definition "Relates Mandelbugs to fault forecasting since their non-deterministic nature requires statistical prediction approaches."@en ;
    skos:example "ex:hallucination_instance redo:mitigatedByStrategy_Mandelbug redo:RAGRetrieval . Links failure to mitigation strategy."@en .

reliability:mitigates a owl:ObjectProperty ;
    rdfs:label "mitigates"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO 31000:2018 Risk management — Guidelines."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:FailureConcept ;
    skos:definition "Relates a mitigation strategy, technique, or intervention to the failure mode, behavioral pathology, or reliability risk that it reduces or prevents."@en ;
    skos:example "Example: redo:CrossTurnConsistencyAudit redo:mitigates redo:SycophanticReversal . Links the audit strategy to the sycophantic reversal pathology it reduces."@en .

reliability:mitigatesPathology a owl:ObjectProperty ;
    rdfs:label "mitigates pathology"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:ComplianceGate ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:LLMFailure ;
    skos:definition """Relates a ComplianceGate to the LLM failure 
    pathology it is designed to prevent or mitigate."""@en ;
    skos:example "ex:hallucination_instance redo:mitigatesPathology redo:RAGRetrieval . Links failure to mitigation strategy."@en .

reliability:mitigationCost a owl:DatatypeProperty ;
    rdfs:label "mitigation cost"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "OE Pack v17.27.0 Challenge 2 — design-intent rdfs:domain extraction. Per skos:definition: \"Estimated cost to implement the mitigation strategy.\""@en,
        "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain core:Mitigation ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:decimal ;
    skos:definition "Estimated cost to implement the mitigation strategy"@en ;
    skos:example "ex:check redo:mitigationCost \"medium\"^^xsd:string . Activity has an associated cost level."@en .

reliability:monitorsFor a owl:ObjectProperty ;
    rdfs:label "monitorsFor"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:Monitoring ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:FailureType ;
    skos:definition "Relates the monitoring lifecycle phase to the category of failure type it is configured to detect."@en ;
    skos:example "ex:monitoring_instance redo:monitorsFor ex:failuretype_instance . Links Monitoring to FailureType."@en .

reliability:operatesInITDomain a owl:ObjectProperty ;
    rdfs:label "operates in IT domain"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:LLMFailure ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:ITOperationsDomain ;
    skos:definition "Links an LLM failure instance to the IT Operations subdomain where it was observed or is applicable."@en ;
    skos:example "ex:strategy_instance redo:operatesInITDomain redo:FinancialDomain . Strategy applies in a specific domain context."@en .

reliability:operatesInPhase a owl:ObjectProperty ;
    rdfs:label "operates in phase"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain core:Process ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:LifecyclePhase ;
    skos:definition "Relates a reliability engineering process to the lifecycle phase in which it is primarily executed."@en ;
    skos:example "ex:entity redo:operatesInPhase ex:LifecyclePhase . Entity has an associated LifecyclePhase."@en .

reliability:oscillatingVersions a owl:ObjectProperty ;
    rdfs:label "oscillating versions"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.12 — OscillationPattern evidence requirement." ;
    rdfs:domain reliability:OscillationPattern ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    skos:definition "An rdf:List of the consecutive versions (in chronological order) that constitute the oscillation. Length ≥ 3 required for genuine oscillation; 2-version churn is regular iteration."@en .

reliability:oscillationWindow a owl:DatatypeProperty ;
    rdfs:label "oscillation window"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.12 — OscillationPattern evidence requirement." ;
    rdfs:domain reliability:OscillationPattern ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:dateTime ;
    skos:definition "The xsd:duration over which the oscillating versions were produced. Smaller windows (single session, single sprint) are stronger evidence of pathology than larger windows (multi-month evolution)."@en .

reliability:participatesIn a owl:ObjectProperty ;
    rdfs:label "participates in"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain core:Role ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range core:Process ;
    skos:definition "Relates a reliability engineering role to the processes in which that role participates."@en ;
    skos:example "ex:role_instance redo:participatesIn ex:process_instance . Links Role to Process."@en .

reliability:performedBy a owl:ObjectProperty ;
    rdfs:label "performed by"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain core:Process ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:Agent ;
    skos:definition "Relates a process to the agent who executes it"@en ;
    skos:example "Example: ex:code_review_process redo:performedBy ex:senior_developer . Links a code review process to the agent who executes it."@en .

reliability:persistsUntilRepair a owl:ObjectProperty ;
    rdfs:label "persistsUntilRepair"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:PermanentFailure ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:FaultRemoval ;
    skos:definition "Relates permanent failures to fault removal as the required corrective action since they do not self-resolve."@en ;
    skos:example "ex:permanentfailure_instance redo:persistsUntilRepair ex:faultremoval_instance . Links PermanentFailure to FaultRemoval."@en .

reliability:playsRole a owl:ObjectProperty ;
    rdfs:label "playsRole"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:Agent ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range core:Role ;
    skos:definition "Relates a generic agent to the specific functional role they fulfill in the reliability engineering process."@en ;
    skos:example "ex:agent_instance redo:playsRole ex:role_instance . Links Agent to Role."@en .

reliability:preventedBy a owl:ObjectProperty ;
    rdfs:label "prevented by"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:ProvenanceFabrication ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:ReferenceIntegrityGate ;
    skos:definition """Relates a ProvenanceFabrication instance to the 
    ReferenceIntegrityGate that would have prevented it. The gate enforces 
    the ReferenceModificationProtocol's decision tree before any citation 
    is added, removed, or modified."""@en ;
    skos:example "ex:provenancefabrication_instance redo:preventedBy ex:referenceintegritygate_instance . Links ProvenanceFabrication to ReferenceIntegrityGate."@en .

reliability:preventionRate a owl:DatatypeProperty ;
    rdfs:label "prevention rate"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:MetaReliability ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:decimal ;
    skos:definition "Fraction of errors prevented in same prompt as introduction. This conversation: 0.0."@en ;
    skos:example "ex:metric_instance redo:preventionRate \"0.85\"^^xsd:decimal . Metric records a measurement value."@en .

reliability:primaryActivity_Developer a owl:ObjectProperty ;
    rdfs:label "primaryActivity_Developer"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain core:Developer ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:Implementation ;
    skos:definition "Relates the developer role to the implementation phase as their primary area of activity."@en ;
    skos:example "ex:developer_instance redo:primaryActivity_Developer ex:implementation_instance . Links Developer to Implementation."@en .

reliability:primaryActivity_Maintainer a owl:ObjectProperty ;
    rdfs:label "primaryActivity_Maintainer"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain core:Maintainer ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:Maintenance ;
    skos:definition "Relates the maintainer role to the maintenance phase as their primary area of activity."@en ;
    skos:example "ex:maintainer_instance redo:primaryActivity_Maintainer ex:maintenance_instance . Links Maintainer to Maintenance."@en .

reliability:primaryActivity_QAE a owl:ObjectProperty ;
    rdfs:label "primaryActivity_QAE"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:QualityAssuranceEngineer ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:Monitoring ;
    skos:definition "Relates the QA engineer role to the monitoring phase where quality process oversight is most critical."@en ;
    skos:example "ex:qualityassuranceengineer_instance redo:primaryActivity_QAE ex:monitoring_instance . Links QualityAssuranceEngineer to Monitoring."@en .

reliability:primaryActivity_RE a owl:ObjectProperty ;
    rdfs:label "primaryActivity_RE"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:ReliabilityEngineer ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:Design ;
    skos:definition "Relates the reliability engineer role to the design phase where reliability architecture decisions are established."@en ;
    skos:example "ex:reliabilityengineer_instance redo:primaryActivity_RE ex:design_instance . Links ReliabilityEngineer to Design."@en .

reliability:primaryActivity_Tester a owl:ObjectProperty ;
    rdfs:label "primaryActivity_Tester"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain core:Tester ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:Testing ;
    skos:definition "Relates the tester role to the testing phase as their primary area of activity."@en ;
    skos:example "ex:tester_instance redo:primaryActivity_Tester ex:testing_instance . Links Tester to Testing."@en .

reliability:probesFor_KG a owl:ObjectProperty ;
    rdfs:label "probesFor_KG"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:KnowledgeGraphIntegration ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:IntrinsicHallucination ;
    skos:definition "Relates knowledge graph integration to intrinsic hallucination detection via structured fact checking."@en ;
    skos:example "ex:knowledgegraphintegration_instance redo:probesFor_KG ex:intrinsichallucination_instance . Links KnowledgeGraphIntegration to IntrinsicHallucination."@en .

reliability:proceededWithoutResolution a owl:DatatypeProperty ;
    rdfs:label "proceededWithoutResolution"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.13 — added to support DRIFT-7..11 shapes (2026-05-03)."@en ;
    rdfs:comment "True if downstream activity proceeded without the blocker being resolved. The drift state."@en ;
    rdfs:domain reliability:UnresolvedBlockingQuestionDrift ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:boolean ;
    skos:definition "True if downstream activity proceeded without the blocker being resolved. The drift state."@en .

reliability:produces a owl:ObjectProperty ;
    rdfs:label "produces"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain core:Process ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:Artifact ;
    skos:definition "Relates a process to its output artifact"@en ;
    skos:example "ex:test_process redo:produces redo:TestReport . Process produces an output artifact."@en .

reliability:producesArtifact a owl:ObjectProperty ;
    rdfs:label "produces artifact"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain core:Process ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:Artifact ;
    skos:definition "Relates a reliability engineering process to the artifacts it produces as outputs."@en ;
    skos:example "ex:test_process redo:producesArtifact redo:TestReport . Process produces an output artifact."@en .

reliability:propagatesCascade a owl:ObjectProperty ;
    rdfs:label "propagatesCascade"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:CascadingFailure ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:IntegrationBoundaryFailure ;
    skos:definition "Relates cascading failure to integration boundary failure since cascades typically propagate across component interfaces."@en ;
    skos:example "ex:cascadingfailure_instance redo:propagatesCascade ex:integrationboundaryfailure_instance . Links CascadingFailure to IntegrationBoundaryFailure."@en .

reliability:provFilePath a owl:DatatypeProperty ;
    rdfs:label "provFilePath"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.14 — added to support DRIFT-12 shape (2026-05-03)."@en ;
    rdfs:comment "Path or filename of the PROV-O TTL file in question."@en ;
    rdfs:domain reliability:DeliverablePROVValidationDrift ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "Path or filename of the PROV-O TTL file in question."@en .

reliability:publicationVenue a owl:DatatypeProperty ;
    rdfs:label "publication venue"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:BenchmarkDataset ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "Academic venue where the benchmark was published (e.g., ICML 2025, CoNEXT 2024)."@en ;
    skos:example "ex:entity redo:publicationVenue \"value\"^^xsd:string . Entity has a publicationVenue property."@en .

reliability:quantifiedBy a owl:ObjectProperty ;
    rdfs:label "quantified by"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:QualityCharacteristic ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range core:Metric ;
    skos:definition "Relates a quality characteristic to the metrics used to quantify its level of achievement."@en ;
    skos:example "Example: redo:Reliability redo:quantifiedBy redo:MTBF . Links the reliability quality characteristic to the Mean Time Between Failures metric."@en .

reliability:quantifies a owl:ObjectProperty ;
    rdfs:label "quantifies"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain measurement:LLMReliabilityMetric ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:LLMBehavioralPathology ;
    skos:definition "Relates an LLM reliability metric to the specific behavioral pathology whose severity or prevalence it measures."@en ;
    skos:example "ex:llmreliabilitymetric_instance redo:quantifies ex:llmbehavioralpathology_instance . Links LLMReliabilityMetric to LLMBehavioralPathology."@en .

reliability:recomputedCount a owl:DatatypeProperty ;
    rdfs:label "recomputed count"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.12 — CountDrift evidence requirement." ;
    rdfs:domain reliability:CountDrift ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "The recomputed-against-source-of-truth count that the reportedCount drifted from. Must be reproducible by re-running the recomputation procedure declared in dcterms:source."@en .

reliability:redoVocabularyUsed a owl:DatatypeProperty ;
    rdfs:label "redoVocabularyUsed"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.14 — added to support DRIFT-12 shape (2026-05-03)."@en ;
    rdfs:comment "True if the PROV file declares types from redo: / configuration: / core: namespaces (the trigger condition for requiring SHACL validation)."@en ;
    rdfs:domain reliability:DeliverablePROVValidationDrift ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:boolean ;
    skos:definition "True if the PROV file declares types from redo: / configuration: / core: namespaces (the trigger condition for requiring SHACL validation)."@en .

reliability:refreshInterval a owl:DatatypeProperty ;
    rdfs:label "refresh interval"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:RefreshTrigger ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "Interval for re-verification: every 20K tokens, every section, every version."@en ;
    skos:example "ex:process redo:refreshInterval \"PT24H\"^^xsd:string . Process specifies a time interval."@en .

reliability:regulatedBy a owl:ObjectProperty ;
    rdfs:label "regulatedBy"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:DomainContext ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:RegulatoryFramework ;
    skos:definition "Relates a professional or industry domain context to the regulatory framework that governs reliability requirements within that domain."@en ;
    skos:example "ex:domaincontext_instance redo:regulatedBy ex:regulatoryframework_instance . Links DomainContext to RegulatoryFramework."@en .

reliability:regulatesImpact a owl:ObjectProperty ;
    rdfs:label "regulatesImpact"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:RegulatoryFramework ;
    skos:definition "Relates regulatory impact to the regulatory framework that defines compliance obligations and penalty structures."@en ;
    skos:example "ex:regulatoryimpact_instance redo:regulatesImpact ex:regulatoryframework_instance . Links RegulatoryImpact to RegulatoryFramework."@en .

reliability:remediatedIn a owl:ObjectProperty ;
    rdfs:label "remediated in"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.10.0 issue-lifecycle extension."@en ;
    rdfs:domain reliability:Problem ;
    rdfs:isDefinedBy <http://example.org/redo/v2.10.0/issue-lifecycle> ;
    skos:definition "Links a Problem to the release artifact (bundle, version, or PROV Activity) in which the remediation shipped. Open range (no rdfs:range) so this property can link to bundle IRIs, version strings, or prov:Activity individuals — whichever is most informative for the issue. BP-D16 caution: no inverseOf declared."@en .

reliability:repeatedInstructionText a owl:DatatypeProperty ;
    rdfs:label "repeatedInstructionText"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.13 — added to support DRIFT-7..11 shapes (2026-05-03)."@en ;
    rdfs:comment "The verbatim instruction text that was repeated."@en ;
    rdfs:domain reliability:RepeatedInstructionInsensitivity ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "The verbatim instruction text that was repeated."@en .

reliability:repetitionCount a owl:DatatypeProperty ;
    rdfs:label "repetitionCount"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.13 — added to support DRIFT-7..11 shapes (2026-05-03)."@en ;
    rdfs:comment "Number of distinct user turns in which the instruction text was repeated."@en ;
    rdfs:domain reliability:RepeatedInstructionInsensitivity ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:integer ;
    skos:definition "Number of distinct user turns in which the instruction text was repeated."@en .

reliability:reportedCount a owl:DatatypeProperty ;
    rdfs:label "reported count"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.12 — CountDrift evidence requirement." ;
    rdfs:domain reliability:CountDrift ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "The numeric claim that drifted (i.e., the wrong number). Recorded as a string to allow compound counts like '+28 cls / +51 props → 82/111'."@en .

reliability:representedBy a owl:ObjectProperty ;
    rdfs:label "representedBy"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:UserRepresentative ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range core:Stakeholder ;
    skos:definition "Relates the user representative role to the stakeholder class whose interests they advocate."@en ;
    skos:example "Example: redo:UserRepresentative redo:representedBy ex:end_users . Links the user representative role to the end-user stakeholder class it advocates for."@en .

reliability:requiredAtStage a owl:ObjectProperty ;
    rdfs:label "required at stage"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:VerificationModality ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:VerificationStage ;
    skos:definition "Which verification stage(s) require this modality."@en ;
    skos:example "ex:verificationmodality_instance redo:requiredAtStage ex:verificationstage_instance . Links VerificationModality to VerificationStage."@en .

reliability:requiresCompliance a owl:ObjectProperty ;
    rdfs:label "requires compliance"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:DomainContext ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:RegulatoryFramework ;
    skos:definition "Links domain to applicable regulatory frameworks"@en ;
    skos:example "ex:test_process redo:requiresCompliance redo:TestReport . Process consumes an input artifact."@en .

reliability:requiresDesign a owl:ObjectProperty ;
    rdfs:label "requiresDesign"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain qc:Requirement ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:Design ;
    skos:definition "Relates the requirement phase to the design phase as its direct successor in the reliability lifecycle."@en ;
    skos:example "ex:test_process redo:requiresDesign redo:TestReport . Process consumes an input artifact."@en .

reliability:resolvedAt a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "resolved at"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.10.0 issue-lifecycle extension."@en ;
    rdfs:domain reliability:Problem ;
    rdfs:isDefinedBy <http://example.org/redo/v2.10.0/issue-lifecycle> ;
    rdfs:range xsd:dateTime ;
    skos:definition "Timestamp when the issue reached its current resolution outcome. Empty if Outcome_Open. Functional: exactly one value per issue."@en .

reliability:resolvedThrough a owl:ObjectProperty ;
    rdfs:label "resolved through"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:BehaviorConcern ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:ComplianceGate ;
    skos:definition "Relates a behavior concern to the compliance gate process through which it is investigated and resolved."@en ;
    skos:example "ex:behaviorconcern_instance redo:resolvedThrough ex:compliancegate_instance . Links BehaviorConcern to ComplianceGate."@en .

reliability:resourceIdentifier a owl:DatatypeProperty ;
    rdfs:label "resourceIdentifier"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.13 — added to support DRIFT-7..11 shapes (2026-05-03)."@en ;
    rdfs:comment "Stable identifier of the resource whose metadata is in question (e.g. chat UUID, file path, ontology IRI)."@en ;
    rdfs:domain reliability:Drift ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "Stable identifier of the resource whose metadata is in question (e.g. chat UUID, file path, ontology IRI)."@en .

reliability:returnedAtTimestamp a owl:DatatypeProperty ;
    rdfs:label "returnedAtTimestamp"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.13 — added to support DRIFT-7..11 shapes (2026-05-03)."@en ;
    rdfs:comment "ISO-8601 timestamp at which the metadata was returned by the retrieval tool."@en ;
    rdfs:domain reliability:SearchResultStalenessDrift ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:dateTime ;
    skos:definition "ISO-8601 timestamp at which the metadata was returned by the retrieval tool."@en .

reliability:returnedTitle a owl:DatatypeProperty ;
    rdfs:label "returnedTitle"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.13 — added to support DRIFT-7..11 shapes (2026-05-03)."@en ;
    rdfs:comment "The title literal returned by the retrieval tool in the drift event."@en ;
    rdfs:domain reliability:SearchResultStalenessDrift ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "The title literal returned by the retrieval tool in the drift event."@en .

reliability:reviewsArchitecture a owl:ObjectProperty ;
    rdfs:label "reviewsArchitecture"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:AdversarialArchitecturalReview ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:ArchitecturalDrift ;
    skos:definition "Relates adversarial architectural review to architectural drift as the primary pathology it is designed to detect and prevent."@en ;
    skos:example "ex:adversarialarchitecturalreview_instance redo:reviewsArchitecture ex:architecturaldrift_instance . Links AdversarialArchitecturalReview to ArchitecturalDrift."@en .

reliability:riskProfile_Legal a owl:ObjectProperty ;
    rdfs:label "riskProfile_Legal"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:LegalDomain ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:LegalHallucination ;
    skos:definition "Relates the legal domain to legal hallucination as its domain-specific fabrication risk profile."@en ;
    skos:example "ex:legaldomain_instance redo:riskProfile_Legal ex:legalhallucination_instance . Links LegalDomain to LegalHallucination."@en .

reliability:riskProfile_Medical a owl:ObjectProperty ;
    rdfs:label "riskProfile_Medical"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:MedicalDomain ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:MedicalHallucination ;
    skos:definition "Relates the medical domain to medical hallucination as its domain-specific fabrication risk profile."@en ;
    skos:example "ex:medicaldomain_instance redo:riskProfile_Medical ex:medicalhallucination_instance . Links MedicalDomain to MedicalHallucination."@en .

reliability:scaffoldSupports a owl:ObjectProperty ;
    rdfs:label "scaffoldSupports"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:ScaffoldBasedDevelopment ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:Evolution ;
    skos:definition "Relates scaffold-based development to the evolution lifecycle phase where incremental verified construction is most critical."@en ;
    skos:example "ex:scaffoldbaseddevelopment_instance redo:scaffoldSupports ex:evolution_instance . Links ScaffoldBasedDevelopment to Evolution."@en .

reliability:selfAuditCeilingEstimate a owl:DatatypeProperty ;
    rdfs:label "self-audit ceiling estimate"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:SelfAuditCeiling ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:decimal ;
    skos:definition """Estimated autonomous detection rate for this specific root cause 
    category (0.0-1.0 scale). Measures the probability that the LLM 
    will autonomously identify this failure type without external 
    prompting, given the current framework coverage level.
    
    This rate is coverage-dependent: for formalized categories with 
    a reliability ontology in context, detection approaches 1.0. For novel/unformalized 
    categories, detection starts near 0.0. The estimate captures the 
    state at the time of formalization.
    
    Once detected (by any agent), autonomous mitigation reaches ~85% 
    (N=37) — the mitigation rate is the constant, the detection rate 
    is the variable that framework coverage improves."""@en ;
    skos:example "ex:entity redo:selfAuditCeilingEstimate \"value\"^^xsd:decimal . Entity has a selfAuditCeilingEstimate property."@en .

reliability:shaclShapesUsed a owl:DatatypeProperty ;
    rdfs:label "shaclShapesUsed"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.14 — added to support DRIFT-12 shape (2026-05-03)."@en ;
    rdfs:comment "Filename of the SHACL shapes file used for validation, if shaclValidationRun=true."@en ;
    rdfs:domain reliability:DeliverablePROVValidationDrift ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "Filename of the SHACL shapes file used for validation, if shaclValidationRun=true."@en .

reliability:shaclValidationRun a owl:DatatypeProperty ;
    rdfs:label "shaclValidationRun"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.14 — added to support DRIFT-12 shape (2026-05-03)."@en ;
    rdfs:comment "True if pyshacl was actually executed against the PROV file. False is the drift state."@en ;
    rdfs:domain reliability:DeliverablePROVValidationDrift ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:boolean ;
    skos:definition "True if pyshacl was actually executed against the PROV file. False is the drift state."@en .

reliability:supportsCharacteristic_Adaptability a owl:ObjectProperty ;
    rdfs:label "supportsCharacteristic_Adaptability"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain qc:Adaptability ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:Compatibility ;
    skos:definition "Relates adaptability to compatibility since adaptable systems more readily achieve interoperability with diverse environments."@en ;
    skos:example "ex:adaptability_instance redo:supportsCharacteristic_Adaptability ex:compatibility_instance . Links Adaptability to Compatibility."@en .

reliability:testedBy a owl:ObjectProperty ;
    rdfs:label "tested by"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "IEEE 1012-2016. Standard for System, Software, and Hardware Verification and Validation." ;
    rdfs:domain owl:Ontology ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range qc:TestSuite ;
    skos:definition "Links an ontology to its associated test suite. Establishes the governance relationship between an ontology version and its verification artifacts."@en ;
    skos:example "Example: <http://example.org/reliability> redo:testedBy <.../test-suite/v2.4.6> ."@en .

reliability:tests a owl:ObjectProperty ;
    rdfs:label "tests"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain qc:TestCase ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range qc:TestCase ;
    skos:definition "Connects a test case to the specific component it verifies."@en ;
    skos:example "ex:testcase_instance redo:tests ex:testcase_instance . Links TestCase to TestCase."@en .

reliability:tierBreakdownPublished a owl:DatatypeProperty ;
    rdfs:label "tierBreakdownPublished"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.14 — added to support DRIFT-16 shape (2026-05-03)."@en ;
    rdfs:comment "True if the tier breakdown was published in the deliverable. False is the drift state."@en ;
    rdfs:domain reliability:UserDataInsufficiencyDrift ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:boolean ;
    skos:definition "True if the tier breakdown was published in the deliverable."@en .

reliability:tokenBudget a owl:DatatypeProperty ;
    rdfs:label "token budget"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:TokenCostConstraint ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:integer ;
    skos:definition "Maximum number of tokens available within budget"@en ;
    skos:example "ex:entity redo:tokenBudget \"value\"^^xsd:integer . Entity has a tokenBudget property."@en .

reliability:tradesWith_Portability a owl:ObjectProperty ;
    rdfs:label "tradesWith_Portability"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:Portability ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:Performance ;
    skos:definition "Relates portability to performance as a common quality trade-off where platform abstraction can reduce optimization."@en ;
    skos:example "ex:portability_instance redo:tradesWith_Portability ex:performance_instance . Links Portability to Performance."@en .

reliability:tradesWith_Security a owl:ObjectProperty ;
    rdfs:label "tradesWith_Security"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:Security ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range qc:Usability ;
    skos:definition "Relates security to usability as a common quality trade-off where stronger security measures can reduce ease of use."@en ;
    skos:example "ex:security_instance redo:tradesWith_Security ex:usability_instance . Links Security to Usability."@en .

reliability:transcriptOnDisk a owl:DatatypeProperty ;
    rdfs:label "transcriptOnDisk"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.14 — added to support DRIFT-13 shape (2026-05-03)."@en ;
    rdfs:comment "True if the expected transcript file is on disk; false=the lag-drift state."@en ;
    rdfs:domain reliability:TranscriptAvailabilityLagDrift ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:boolean ;
    skos:definition "True if the expected transcript file is on disk; false=the lag-drift state."@en .

reliability:triggeredBy a owl:ObjectProperty ;
    rdfs:label "triggeredBy"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:Failure ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:ExternalFactor ;
    skos:definition "Relates a failure event to the external factor or environmental condition that triggered or contributed to its occurrence."@en ;
    skos:example "ex:failure redo:triggeredBy ex:trigger_event . Failure triggered by preceding condition."@en .

reliability:triggeredByFailureType_Byzantine a owl:ObjectProperty ;
    rdfs:label "triggeredByFailureType_Byzantine"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:ByzantineFailure ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    skos:definition "Relates byzantine failure to reputational impact since inconsistent behavior erodes stakeholder trust."@en ;
    skos:example "ex:failure redo:triggeredByFailureType_Byzantine ex:trigger_event . Failure triggered by preceding condition."@en .

reliability:triggeredByFailureType_Cascading a owl:ObjectProperty ;
    rdfs:label "triggeredByFailureType_Cascading"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:CascadingFailure ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    skos:definition "Relates cascading failure to operational impact as its primary business consequence category."@en ;
    skos:example "ex:failure redo:triggeredByFailureType_Cascading ex:trigger_event . Failure triggered by preceding condition."@en .

reliability:triggeredByFailureType_Permanent a owl:ObjectProperty ;
    rdfs:label "triggeredByFailureType_Permanent"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:PermanentFailure ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    skos:definition "Relates permanent failure to financial impact due to sustained revenue loss during extended outage."@en ;
    skos:example "ex:failure redo:triggeredByFailureType_Permanent ex:trigger_event . Failure triggered by preceding condition."@en .

reliability:triggersAlert a owl:ObjectProperty ;
    rdfs:label "triggers alert"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:comment """Links an EmpiricalTest to the behavioral pathology it
    has detected. When an EmpiricalTest fails (behavior does not change
    after data source modification), it triggers an alert for the
    associated pathology, typically DecorativeCompliance or
    IntegrationBoundaryFailure."""@en ;
    rdfs:domain reliability:EmpiricalTest ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:LLMBehavioralPathology ;
    skos:definition """Relates a failed EmpiricalTest to the LLM behavioral
    pathology it has detected, triggering an alert that the tested
    component exhibits the indicated pathological behavior"""@en ;
    skos:example "ex:empiricaltest_instance redo:triggersAlert ex:llmbehavioralpathology_instance . Links EmpiricalTest to LLMBehavioralPathology."@en .

reliability:triggersIntermittent a owl:ObjectProperty ;
    rdfs:label "triggersIntermittent"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:IntermittentFailure ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:ExternalFactor ;
    skos:definition "Relates intermittent failures to external factors since environmental conditions often trigger sporadic malfunctions."@en ;
    skos:example "ex:intermittentfailure_instance redo:triggersIntermittent ex:externalfactor_instance . Links IntermittentFailure to ExternalFactor."@en .

reliability:trustLabelFieldPresent a owl:DatatypeProperty ;
    rdfs:label "trustLabelFieldPresent"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.14 — added to support DRIFT-14 shape (2026-05-03)."@en ;
    rdfs:comment "True if the audit-trail records a trust label field; false=the drift state."@en ;
    rdfs:domain reliability:UpstreamTrustLabelMissingDrift ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:boolean ;
    skos:definition "True if the audit-trail records a trust label field; false=the drift state."@en .

reliability:trustOfFallback a owl:DatatypeProperty ;
    rdfs:label "trustOfFallback"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.14 — added to support DRIFT-13 shape (2026-05-03)."@en ;
    rdfs:comment "Trust label of the fallback evidence: HIGH, MEDIUM, or LOW."@en ;
    rdfs:domain reliability:TranscriptAvailabilityLagDrift ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "Trust label of the fallback evidence."@en .

reliability:upstreamTrustLevel a owl:DatatypeProperty ;
    rdfs:label "upstreamTrustLevel"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.13 — added to support DRIFT-7..11 shapes (2026-05-03)."@en ;
    rdfs:comment "The trust label of the upstream evidence, a value of a controlled list: HIGH, MEDIUM, LOW, MISSING or FABRICATED."@en ;
    rdfs:domain reliability:InheritedTrustDegradationDrift ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "The trust label of the upstream evidence, a value of a controlled list: HIGH, MEDIUM, LOW, MISSING or FABRICATED."@en .

reliability:userDataGapPts a owl:DatatypeProperty ;
    rdfs:label "userDataGapPts"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.14 — added to support DRIFT-16 shape (2026-05-03)."@en ;
    rdfs:comment "Points attributable to user-data-content tier."@en ;
    rdfs:domain reliability:UserDataInsufficiencyDrift ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:decimal ;
    skos:definition "Points attributable to user-data-content tier."@en .

reliability:usesAlgorithm a owl:ObjectProperty ;
    rdfs:label "usesAlgorithm"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:LeidenAlgorithm ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:CommunityDetectionMethod ;
    skos:definition "Relates the Leiden algorithm to community detection as a specific algorithmic implementation."@en ;
    skos:example "ex:leidenalgorithm_instance redo:usesAlgorithm ex:communitydetectionmethod_instance . Links LeidenAlgorithm to CommunityDetectionMethod."@en .

reliability:usesLeidenAlgorithm a owl:DatatypeProperty ;
    rdfs:label "uses Leiden algorithm"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:GraphRAG ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:boolean ;
    skos:definition "Indicates whether the GraphRAG implementation uses Leiden community detection"@en ;
    skos:example "ex:entity redo:usesLeidenAlgorithm \"value\"^^xsd:boolean . Entity has a usesLeidenAlgorithm property."@en .

reliability:validationScope a owl:DatatypeProperty ;
    rdfs:label "validation scope"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.12 — ValidationScopeDrift evidence requirement." ;
    rdfs:domain reliability:ValidationScopeDrift ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "The data-graph scope under which a SHACL/OWL verdict was obtained. Allowed values: 'standalone' (target ontology only), 'ecosystem-combined' (target + all ecosystem dependencies), 'minimal-deps' (target + only directly imported ontologies)."@en .

reliability:verbatimUserTurn a owl:DatatypeProperty ;
    rdfs:label "verbatim user turn"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.12 — GoalContradictionDrift evidence requirement." ;
    rdfs:domain reliability:GoalContradictionDrift ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "The user's exact words (transcript-byte-verifiable) establishing the position the agent contradicted. NEVER paraphrased."@en .

reliability:verificationCost a owl:DatatypeProperty ;
    rdfs:label "verification cost"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Boehm, B.W. (1981). Software Engineering Economics. Prentice-Hall. Verification cost modeling." ;
    rdfs:domain reliability:VerificationModality ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "Qualitative or quantitative assessment of the resource expenditure required to execute a verification modality. Typical values: low, medium, high, or numeric cost estimates."@en ;
    skos:example "Example: redo:CitationExistenceVerification redo:verificationCost \"low\" ."@en .

reliability:verificationInadequateFor a owl:ObjectProperty ;
    rdfs:label "verification inadequate for"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:DecorativeVerification ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:LLMFailure ;
    skos:definition """Relates a DecorativeVerification instance to the specific failure mode 
    that the verification method could not detect. Enables formal tracking 
    of the gap between what was verified and what needed verification.
    
    Example: grep-based count check is 'verificationInadequateFor' 
    cross-location stale value persistence."""@en ;
    skos:example "ex:decorativeverification_instance redo:verificationInadequateFor ex:llmfailure_instance . Links DecorativeVerification to LLMFailure."@en .

reliability:verificationLatency a owl:DatatypeProperty ;
    rdfs:label "verification latency"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Boehm, B.W. (1981). Software Engineering Economics. Prentice-Hall. Verification time estimation." ;
    rdfs:domain reliability:VerificationModality ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "Expected time duration for executing a verification modality. Expressed as qualitative categories (seconds, minutes, hours) or quantitative durations."@en ;
    skos:example "Example: redo:CitationExistenceVerification redo:verificationLatency \"minutes\" ."@en .

reliability:verifiesPathology a owl:ObjectProperty ;
    rdfs:label "verifies pathology"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:VerificationModality ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:LLMBehavioralPathology ;
    skos:definition "Links verification modality to the pathology it detects."@en ;
    skos:example "ex:gate redo:verifiesPathology redo:Artifact . Verification gate validates an artifact."@en .

risk:ActionPriority a owl:Class ;
    rdfs:label "ActionPriority"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "Consolidated from reliability:ActionPriority v3.1.0."@en ;
    rdfs:comment "AIAG-VDA Action Priority — replaces RPN with categorical High/Medium/Low priority based on a lookup of (Severity, Occurrence, Detection) ratings. Per AIAG-VDA FMEA Handbook 2019."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:OrdinalLevel,
        risk:RiskConcept ;
    skos:definition "AIAG-VDA Action Priority — replaces RPN with categorical High/Medium/Low priority based on a lookup of (Severity, Occurrence, Detection) ratings. Per AIAG-VDA FMEA Handbook 2019."@en .

risk:CorrectiveAction a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "CorrectiveAction"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:Action ;
    skos:definition "Action taken in response to a detected failure to restore intended function. Distinguished from PreventiveAction (proactive). Per IEC 60812 and ISO 9000."@en .

risk:CriticalityNumber a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "CriticalityNumber"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:OrdinalLevel ;
    skos:definition "FMECA extension to RPN, accounting for failure mode severity classification and probability. Per IEC 60812 FMECA scope."@en .

risk:CustomerImpact a owl:Class ;
    rdfs:label "CustomerImpact"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "Consolidated from reliability:CustomerImpact v3.1.0."@en ;
    rdfs:comment "Degree to which failures affect customer satisfaction, trust, retention."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:BusinessImpact,
        risk:ImpactCategory ;
    skos:definition "Degree to which failures affect customer satisfaction, trust, retention."@en .

risk:Detection a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Detection"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:FMEAArtifact ;
    skos:definition "The capability to identify a failure mode or its cause before its effect reaches the operational system. One of the three FMEA factors (severity, occurrence, detection). Per IEC 60812."@en .

risk:DetectionCoverage a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "DetectionCoverage"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:OrdinalLevel ;
    skos:definition "The fraction of failure modes a given DetectionMethod can identify, typically expressed as a percentage or ordinal rating. Per IEC 60812."@en .

risk:DetectionMethod a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "DetectionMethod"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:FMEAArtifact ;
    skos:definition "A specific technique, test, or process used to identify failure modes or causes. Per IEC 60812."@en .

risk:FMEAAnalysis a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "FMEAAnalysis"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskAssessment ;
    skos:definition "A specific application of the FMEA methodology to a system, subsystem, or component, producing an FMEAWorksheet. Per IEC 60812."@en .

risk:FMEATeam a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "FMEATeam"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskRecord ;
    skos:definition "A cross-functional group of subject-matter experts conducting an FMEAAnalysis. Per IEC 60812."@en .

risk:FMEAWorksheet a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "FMEAWorksheet"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskRecord ;
    skos:definition "The structured document that captures FMEA findings including FailureMode, FailureCause, FailureEffect, severity/occurrence/detection ratings, RPN, and recommended actions. Per IEC 60812."@en .

risk:FailureMechanism a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "FailureMechanism"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:FailureCause ;
    skos:definition "The physical, chemical, or other process(es) that result in a failure. Distinguished from FailureCause (which may be more proximal). Per IEC 60812."@en .

risk:FailureRate a owl:Class ;
    rdfs:label "FailureRate"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "Consolidated from reliability:FailureRate v3.1.0."@en ;
    rdfs:comment "Reliability metric quantifying frequency of failure events per unit operational time."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:FMEAArtifact,
        risk:RiskConcept ;
    skos:definition "Reliability metric quantifying frequency of failure events per unit operational time."@en .

risk:FunctionalFailure a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "FunctionalFailure"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:FailureMode ;
    skos:definition "A failure mode characterized as inability to fulfill an intended function. Per IEC 60812 hierarchy levels."@en .

risk:Hazard a owl:Class ;
    rdfs:label "Hazard"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "Consolidated from reliability:Hazard v3.1.0."@en ;
    rdfs:comment "A potential source of harm or adverse effect on objectives. Distinct from Risk: a hazard is the source; a risk is the effect of uncertainty arising from that source."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:FMEAArtifact,
        risk:RiskConcept ;
    skos:definition "A potential source of harm or adverse effect on objectives. Distinct from Risk: a hazard is the source; a risk is the effect of uncertainty arising from that source."@en .

risk:InherentRisk a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "InherentRisk"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:Risk ;
    skos:definition "The level of risk that exists in the absence of any controls or mitigations. Distinguished from ResidualRisk (post-treatment). Per ISO 31000:2018."@en .

risk:ItemFailure a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "ItemFailure"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:FailureMode ;
    skos:definition "A failure mode at the component/item level of analysis. Per IEC 60812 hierarchy levels."@en .

risk:ItemFunction a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "ItemFunction"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:FMEAArtifact ;
    skos:definition "The intended performance characteristic(s) of an item or component. The reference against which failure is defined. Per IEC 60812."@en .

risk:Mitigation a owl:Class ;
    rdfs:label "Mitigation"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "Risk-management standards (ISO 31000 — risk treatment). Backfilled to declare the type-class used by risk:Mit_* individuals (C7+ TypeDeclarationShape fix, P1)."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskConcept ;
    skos:definition "An action intended to modify a risk — to reduce its likelihood, reduce its impact, or transfer/avoid it. Encompasses preventive controls, corrective actions, and contingency measures."@en .

risk:MitigationEffectiveness a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "MitigationEffectiveness"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:OrdinalLevel ;
    skos:definition "A measurement of how effectively a mitigation strategy reduces risk. Used in FMEA validation. Per IEC 60812."@en .

risk:Occurrence a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Occurrence"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:OrdinalLevel ;
    skos:definition "Class form of occurrence frequency (distinct from the occurrence property). Per IEC 60812."@en .

risk:OperatingConditions a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "OperatingConditions"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskContext ;
    skos:definition "The set of environmental and operational parameters under which an item is expected to perform. Per IEC 60812."@en .

risk:OperationalImpact a owl:Class ;
    rdfs:label "OperationalImpact"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "Consolidated from reliability:OperationalImpact v3.1.0."@en ;
    rdfs:comment "Disruption to day-to-day business operations and service delivery."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:BusinessImpact,
        risk:ImpactCategory ;
    skos:definition "Disruption to day-to-day business operations and service delivery."@en .

risk:PreventiveAction a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "PreventiveAction"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:Action ;
    skos:definition "Action taken to prevent the occurrence of a potential failure mode. Distinguished from CorrectiveAction (reactive). Per IEC 60812."@en .

risk:PriorityBasedResolution a owl:Class ;
    rdfs:label "PriorityBasedResolution"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "Consolidated from kb:PriorityBasedResolution v1.2.1."@en ;
    rdfs:comment "Conflict resolution approach that resolves design conflicts by applying a predefined priority ranking among contributors or source ontologies."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:seeAlso kb:PriorityBasedResolution ;
    rdfs:subClassOf risk:RiskConcept ;
    skos:definition "Conflict resolution approach that resolves design conflicts by applying a predefined priority ranking among contributors or source ontologies."@en ;
    skos:exactMatch kb:PriorityBasedResolution .

risk:RPN a owl:DatatypeProperty ;
    rdfs:label "RPN"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:domain risk:FailureMode ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range xsd:integer ;
    skos:definition "Consolidated from reliability:RPN v3.1.0. Risk Priority Number = Severity × Occurrence × Detection. Range 1-1000."@en .

risk:RegulatoryImpact a owl:Class ;
    rdfs:label "RegulatoryImpact"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "Consolidated from reliability:RegulatoryImpact v3.1.0."@en ;
    rdfs:comment "Triggering of regulatory sanctions, compliance violations, mandatory disclosure obligations."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:BusinessImpact,
        risk:ImpactCategory ;
    skos:definition "Triggering of regulatory sanctions, compliance violations, mandatory disclosure obligations."@en .

risk:ReputationalImpact a owl:Class ;
    rdfs:label "ReputationalImpact"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "Consolidated from reliability:ReputationalImpact v3.1.0."@en ;
    rdfs:comment "Damage to organizational credibility, brand perception, market position."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:BusinessImpact,
        risk:ImpactCategory ;
    skos:definition "Damage to organizational credibility, brand perception, market position."@en .

risk:RequirementsPrioritization a owl:Class ;
    rdfs:label "RequirementsPrioritization"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "Consolidated from kb:RequirementsPrioritization v1.2.1."@en ;
    rdfs:comment "Requirements analysis technique that ranks requirements by business value, technical risk, and stakeholder urgency, determining which capabilities to implement in each iteration."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:seeAlso kb:RequirementsPrioritization ;
    rdfs:subClassOf risk:RiskConcept ;
    skos:definition "Requirements analysis technique that ranks requirements by business value, technical risk, and stakeholder urgency, determining which capabilities to implement in each iteration."@en ;
    skos:exactMatch kb:RequirementsPrioritization .

risk:ResidualRisk a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "ResidualRisk"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:Risk ;
    skos:definition "The level of risk remaining after the application of risk treatments. Per ISO 31000:2018."@en .

risk:RiskAnalysis a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "RiskAnalysis"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskAssessment ;
    skos:definition "The process of comprehending the nature of risk and determining its level. Includes consideration of causes, sources, consequences, probabilities, and existing controls. Per ISO 31000:2018 clause 6.4.3."@en .

risk:RiskAppetite a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "RiskAppetite"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:OrdinalLevel ;
    skos:definition "The amount and type of risk that an organization is willing to pursue or retain. Set at governance level. Per ISO 31000:2018."@en .

risk:RiskAvoidance a owl:Class ;
    rdfs:label "RiskAvoidance"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "GAP-FILL: net-new in risk v1.0.0 per ISO 31000:2018 §6.5."@en ;
    rdfs:comment "Risk treatment option: decision to not initiate or continue with the activity that gives rise to the risk. Eliminates rather than mitigates."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskTreatment ;
    owl:disjointWith risk:RiskReduction ;
    skos:definition "Risk treatment option: decision to not initiate or continue with the activity that gives rise to the risk. Eliminates rather than mitigates."@en .

risk:RiskBasedRegression a owl:Class ;
    rdfs:label "RiskBasedRegression"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "Consolidated from kb:RiskBasedRegression v1.2.1."@en ;
    rdfs:comment "Regression test execution that prioritizes test cases based on the assessed risk of modification impact, running high-risk tests first to detect the most likely failures with minimal execution time."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:seeAlso kb:RiskBasedRegression ;
    rdfs:subClassOf risk:RiskConcept ;
    skos:definition "Regression test execution that prioritizes test cases based on the assessed risk of modification impact, running high-risk tests first to detect the most likely failures with minimal execution time."@en ;
    skos:exactMatch kb:RiskBasedRegression .

risk:RiskCommunication a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "RiskCommunication"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskRecord ;
    skos:definition "Continual and iterative processes that an organization conducts to provide, share, or obtain information and to engage in dialogue with stakeholders regarding the management of risk. Per ISO 31000:2018."@en .

risk:RiskConsequence a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "RiskConsequence"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:FMEAArtifact ;
    skos:definition "Outcome of a risk event affecting objectives. May be positive or negative. Distinguished from FailureEffect (technical) by its objective-relative framing. Per ISO 31000:2018."@en .

risk:RiskCriteria a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "RiskCriteria"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskRecord ;
    skos:definition "The terms of reference against which the significance of a risk is evaluated. Reflects organizational values, objectives, and resources. Per ISO 31000:2018."@en .

risk:RiskCulture a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "RiskCulture"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskRecord ;
    skos:definition "The set of shared attitudes, values, and behaviors that characterize how an organization considers risk in its day-to-day activities. Per ISO 31000:2018."@en .

risk:RiskEvaluation a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "RiskEvaluation"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskAssessment ;
    skos:definition "The process of comparing the results of risk analysis with risk criteria to determine whether the risk and its magnitude are acceptable. Per ISO 31000:2018 clause 6.4.4."@en .

risk:RiskEvent a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "RiskEvent"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:FMEAArtifact ;
    skos:definition "Occurrence or change of a particular set of circumstances. May have one or more causes and consequences. Per ISO 31000:2018."@en .

risk:RiskGovernance a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "RiskGovernance"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskRecord ;
    skos:definition "The system by which an organization is directed and controlled in matters of risk. Per ISO 31000:2018."@en .

risk:RiskIdentification a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "RiskIdentification"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskAssessment ;
    skos:definition "The process of finding, recognizing, and describing risks. Involves identifying risk sources, events, causes, and consequences. Per ISO 31000:2018 clause 6.4.2."@en .

risk:RiskLikelihood a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "RiskLikelihood"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:OrdinalLevel ;
    skos:definition "The chance of something happening, expressed qualitatively or quantitatively. Class form (not just property). Per ISO 31000:2018."@en .

risk:RiskManagementFramework a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "RiskManagementFramework"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskRecord ;
    skos:definition "Set of components that provide the foundations and organizational arrangements for designing, implementing, monitoring, reviewing, and continually improving risk management throughout the organization. Per ISO 31000:2018 clause 5."@en .

risk:RiskMitigation a owl:Class ;
    rdfs:label "Risk Mitigation"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "Consolidated from reliability:MitigationStrategy v3.1.0 + configuration:MitigationStrategy v2.0.0 (DRY collapse per L-37)."@en ;
    rdfs:comment "A planned response to a Risk or FailureMode in the risk-management context. Per ISO 31000 the risk-treatment options are avoidance, reduction, sharing, retention; mitigation activities are specifically those that REDUCE likelihood or impact (typically a kind of risk:RiskReduction). Sibling of reliability:FailureMitigation under core:Mitigation. Renamed from risk:MitigationStrategy in v3.0.0 to disambiguate from the ISO 31000 \"strategy\" wording."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf core:Mitigation,
        risk:RiskTreatmentMethod ;
    skos:definition "A planned response to a Risk or FailureMode in the risk-management context. Per ISO 31000 the risk-treatment options are avoidance, reduction, sharing, retention; mitigation activities are specifically those that REDUCE likelihood or impact (typically a kind of risk:RiskReduction). Sibling of reliability:FailureMitigation under core:Mitigation. Renamed from risk:MitigationStrategy in v3.0.0 to disambiguate from the ISO 31000 \"strategy\" wording."@en .

risk:RiskMonitoring a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "RiskMonitoring"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskRecord ;
    skos:definition "The continual checking, supervising, critically observing, or determining the status in order to identify change from the performance level required or expected. Per ISO 31000:2018 clause 6.6."@en .

risk:RiskOwner a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "RiskOwner"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskRecord ;
    skos:definition "Person, role, or organizational unit accountable for a specific risk including its identification, treatment, monitoring, and review. Per ISO 31000:2018. Note: a riskOwner property already exists in v1.0.0+."@en .

risk:RiskPriorityNumber a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "RiskPriorityNumber"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:OrdinalLevel ;
    skos:definition "Computed value RPN = severity × occurrence × detection, used to prioritize FMEA-identified failure modes. Per IEC 60812. Note: a separate calculatesRPN property already produces this value as an integer."@en .

risk:RiskReporting a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "RiskReporting"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskRecord ;
    skos:definition "Form of communication intended to inform particular internal or external stakeholders by providing information regarding the current state of risk and its management. Per ISO 31000:2018 clause 6.7."@en .

risk:RiskRetention a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "RiskRetention"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskTreatmentMethod ;
    skos:altLabel "Risk Acceptance"@en ;
    skos:definition "Treatment choice by which a risk is accepted without further action. Per ISO 31000:2018 (alternate naming: RiskAcceptance)."@en ;
    skos:prefLabel "Risk Retention"@en .

risk:RiskReview a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "RiskReview"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskRecord ;
    skos:definition "The activity undertaken to determine the suitability, adequacy, and effectiveness of the risk management framework. Per ISO 31000:2018 clause 6.6."@en .

risk:RiskSharing a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "RiskSharing"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskTreatmentMethod ;
    skos:altLabel "Risk Transfer"@en ;
    skos:definition "Treatment choice involving the sharing of risk with another party or parties (insurance, partnerships). Per ISO 31000:2018 (alternate naming: RiskTransfer)."@en ;
    skos:prefLabel "Risk Sharing"@en .

risk:RiskSource a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "RiskSource"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:FMEAArtifact ;
    skos:definition "An element which alone or in combination has the intrinsic potential to give rise to risk. Per ISO 31000:2018."@en .

risk:RiskTolerance a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "RiskTolerance"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:OrdinalLevel ;
    skos:definition "The organization's readiness to bear the risk after risk treatment in order to achieve its objectives. Per ISO 31000:2018."@en .

risk:Severity a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Severity"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:OrdinalLevel ;
    skos:definition "Class form of severity rating (distinct from SeverityLevel which is the categorical scale). Per IEC 60812."@en .

risk:SystemFailure a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "SystemFailure"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:FailureMode ;
    skos:definition "A failure mode at the system level of analysis. Per IEC 60812 hierarchy levels."@en .

risk:assessesArtifact a owl:ObjectProperty ;
    rdfs:label "assesses artifact"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:domain risk:RiskAssessment ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range core:Artifact ;
    skos:definition "Subject-link (registration) hook: the artifact this RiskAssessment is about. A component registers its risk assessment of itself via this property. FMEAAnalysis inherits it (FMEAAnalysis ⊑ RiskAssessment). Range core:Artifact so any subject type (ontology, document, algorithm, …) can be assessed."@en .

risk:calculatesRPN a owl:DatatypeProperty,
        owl:NamedIndividual ;
    rdfs:label "calculatesRPN"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:domain risk:FailureMode ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range xsd:integer ;
    skos:definition "Computed RPN = severity × occurrence × detection per IEC 60812. Each FailureMode in a FMEA study has exactly one calculatesRPN value."@en .

risk:causesImpact a owl:ObjectProperty ;
    rdfs:label "causes impact"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "Consolidated from reliability:causesImpact v3"@en ;
    rdfs:domain risk:FailureMode ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range risk:BusinessImpact ;
    skos:definition "Consolidated from reliability:causesImpact v3.1.0."@en .

risk:containsRisk a owl:ObjectProperty ;
    rdfs:label "contains risk"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "GAP-FILL: net-new in risk v1"@en ;
    rdfs:domain risk:RiskRegister ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range risk:Risk ;
    skos:definition "GAP-FILL: net-new in risk v1.0.0. Membership link from a RiskRegister to its constituent Risks."@en .

risk:detection a owl:DatatypeProperty ;
    rdfs:label "detection"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:domain risk:FailureMode ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range xsd:integer ;
    skos:definition "GAP-FILL: net-new in risk v1.0.0. FMEA Detection rating: integer 1-10. 1=almost certain detection by existing controls, 10=absolute uncertainty (no controls)."@en .

risk:estimatedCost a owl:DatatypeProperty ;
    rdfs:label "estimated cost"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:domain risk:FinancialImpact ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range xsd:decimal ;
    skos:definition "Consolidated from reliability:estimatedCost v3.1.0. Estimated financial cost of the impact in currency units."@en .

risk:hasBusinessImpact a owl:ObjectProperty ;
    rdfs:label "has business impact"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "Consolidated from reliability:hasBusinessImpact v3"@en ;
    rdfs:domain risk:Risk ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range risk:BusinessImpact ;
    skos:definition "Consolidated from reliability:hasBusinessImpact v3.1.0."@en .

risk:hasCurrentControls a owl:ObjectProperty ;
    rdfs:label "has current controls"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "GAP-FILL: net-new in risk v1"@en ;
    rdfs:domain risk:FailureMode ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range risk:CurrentControls ;
    skos:definition "GAP-FILL: net-new in risk v1.0.0. Links a FailureMode to existing prevention/detection mechanisms."@en .

risk:hasFailureCause a owl:ObjectProperty ;
    rdfs:label "has failure cause"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "GAP-FILL: net-new in risk v1"@en ;
    rdfs:domain risk:FailureMode ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range risk:FailureCause ;
    skos:definition "GAP-FILL: net-new in risk v1.0.0. Links a FailureMode to its root cause per ISO 60812:2018 §6.3."@en .

risk:hasFailureEffect a owl:ObjectProperty ;
    rdfs:label "has failure effect"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "GAP-FILL: net-new in risk v1"@en ;
    rdfs:domain risk:FailureMode ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range risk:FailureEffect ;
    skos:definition "GAP-FILL: net-new in risk v1.0.0. Links a FailureMode to its consequences per ISO 60812:2018 §6.4."@en .

risk:hasFailureMode a owl:ObjectProperty ;
    rdfs:label "has failure mode"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "GAP-FILL: net-new in risk v1"@en ;
    rdfs:domain risk:Risk ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range risk:FailureMode ;
    skos:definition "GAP-FILL: net-new in risk v1.0.0. Links a Risk to one or more FailureModes that realize the risk."@en .

risk:hasIdentifiedRisk a owl:ObjectProperty ;
    rdfs:label "has identified risk"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "Consolidated from reliability:hasIdentifiedRisk v3"@en ;
    rdfs:domain core:Artifact ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range risk:Risk ;
    skos:definition "Consolidated from reliability:hasIdentifiedRisk v3.1.0. Links an artifact to risks identified during its RiskAssessment."@en ;
    skos:scopeNote "Registration (findings) hook, complementary to risk:assessesArtifact (assessment hook): assessesArtifact registers the RiskAssessment about a subject; hasIdentifiedRisk registers the specific Risks attached to that subject. Domain widened OntologyArtifact->core:Artifact (v20.18.0) so non-ontology subjects can register identified risks."@en .

risk:hasLikelihood a owl:DatatypeProperty ;
    rdfs:label "has likelihood"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:domain risk:Risk ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range xsd:decimal ;
    skos:definition "Consolidated from reliability:hasLikelihood v3.1.0. Quantitative or normalised qualitative likelihood [0,1]."@en .

risk:hasMitigation a owl:ObjectProperty ;
    rdfs:label "has mitigation"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "Consolidated from configuration:hasMitigation v2"@en ;
    rdfs:domain risk:Risk ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    skos:definition "Consolidated from configuration:hasMitigation v2.0.0 (domain RiskItem). Generalized to domain risk:Risk; RiskItem is a Risk subtype."@en .

risk:hasPriority a owl:ObjectProperty ;
    rdfs:label "has priority"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "Consolidated from quality:hasPriority v3"@en ;
    rdfs:domain risk:Risk ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range risk:PriorityLevel ;
    skos:definition "Consolidated from quality:hasPriority v3.0.0 (was domain Finding)."@en .

risk:hasProbability a owl:DatatypeProperty ;
    rdfs:label "has probability"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:domain risk:Risk ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range xsd:decimal ;
    skos:definition "Consolidated from reliability:hasProbability v3.1.0. Formal probability in [0,1] when statistical evidence is available."@en .

risk:hasRecommendedAction a owl:ObjectProperty ;
    rdfs:label "has recommended action"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "GAP-FILL: net-new in risk v1"@en ;
    rdfs:domain risk:FailureMode ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range risk:RecommendedAction ;
    skos:definition "GAP-FILL: net-new in risk v1.0.0. Links a FailureMode to its FMEA-output recommendation."@en .

risk:hasResidualRisk a owl:ObjectProperty ;
    rdfs:label "has residual risk"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "GAP-FILL: net-new in risk v1"@en ;
    rdfs:domain risk:RiskItem ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range risk:RiskItem ;
    skos:definition "GAP-FILL: net-new in risk v1.0.0. Self-relation: post-mitigation risk that remains. Enables residual-risk tracking per ISO 31000."@en .

risk:hasRiskTreatment a owl:ObjectProperty ;
    rdfs:label "has risk treatment"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "Consolidated from reliability:hasRiskTreatment v3"@en ;
    rdfs:domain risk:Risk ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range risk:RiskTreatment ;
    skos:definition "Consolidated from reliability:hasRiskTreatment v3.1.0. Links a Risk to its chosen treatment option per ISO 31000."@en .

risk:hasSeverity a owl:ObjectProperty ;
    rdfs:label "has severity"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "DRY consolidation per L-37 from: core:hasSeverity (dom Thing), quality:hasSeverity (dom Finding), reliability:hasSeverity (dom Failure/FailureConcept, rng was xsd:string)"@en ;
    rdfs:domain risk:Risk ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range risk:SeverityLevel ;
    skos:definition "DRY consolidation per L-37 from: core:hasSeverity (dom Thing), quality:hasSeverity (dom Finding), reliability:hasSeverity (dom Failure/FailureConcept, rng was xsd:string). Canonical home: risk:."@en .

risk:hasTemporalMode a owl:NamedIndividual,
        owl:ObjectProperty ;
    rdfs:label "has temporal mode"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:domain risk:RiskTreatment ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range risk:Action ;
    skos:definition "Links a RiskTreatment instance to the risk:Action subclass capturing its temporal mode (PreventiveAction for proactive application before risk materialization; CorrectiveAction for reactive application after risk materialization). Captures the orthogonal temporal-mode axis alongside the ISO 31000 treatment-option axis (avoidance/reduction/sharing/retention). Per Option D of the Track D action-placement discussion."@en .

risk:mitigates a owl:NamedIndividual,
        owl:ObjectProperty ;
    rdfs:label "mitigates"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:domain risk:RiskTreatmentMethod ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range risk:FailureMode ;
    skos:definition "Links a RiskTreatment or MitigationStrategy to the FailureMode(s) it addresses. Used to verify that every identified failure mode has at least one mitigation linked."@en .

risk:mitigationCost a owl:DatatypeProperty ;
    rdfs:label "mitigation cost"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "OE Pack v17.27.0 Challenge 2 — design-intent rdfs:domain extraction. Per skos:definition: \"Estimated cost to implement the mitigation.\" core:Mitigation is the LCA — both risk:RiskMitigation and reliability:FailureMitigation are its subclasses."@en ;
    rdfs:domain core:Mitigation ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range xsd:decimal ;
    skos:definition "Consolidated from reliability:mitigationCost v3.1.0. Estimated cost to implement the mitigation."@en .

risk:occurrence a owl:DatatypeProperty ;
    rdfs:label "occurrence"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:domain risk:FailureMode ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range xsd:integer ;
    skos:definition "GAP-FILL: net-new in risk v1.0.0. FMEA Occurrence rating: integer 1-10. 1=remote (<1/10^6), 10=very high (≥1/2)."@en .

risk:priorityRank a owl:DatatypeProperty ;
    rdfs:label "priority rank"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:domain risk:PriorityLevel ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range xsd:integer ;
    skos:definition "Consolidated from quality:priorityRank v3.0.0. Ordinal rank where lower values indicate higher urgency (1=Immediate, 4=Backlog)."@en .

risk:residualRiskProbability a owl:DatatypeProperty ;
    rdfs:label "residual risk probability"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:domain risk:RiskItem ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range xsd:decimal ;
    skos:definition "GAP-FILL: net-new in risk v1.0.0. Post-mitigation probability in [0,1] of the residual risk."@en .

risk:riskCategory a owl:ObjectProperty ;
    rdfs:label "risk category"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "GAP-FILL: net-new in risk v1"@en ;
    rdfs:domain risk:RiskItem ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range risk:RiskCategory ;
    skos:definition "GAP-FILL: net-new in risk v1.0.0. Classifies a RiskItem by category (technical/schedule/cost/operational/regulatory/etc)."@en .

risk:riskImpact a owl:ObjectProperty ;
    rdfs:label "risk impact"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "GAP-FILL: net-new in risk v1"@en ;
    rdfs:domain risk:RiskItem ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range risk:ImpactLevel ;
    skos:definition "GAP-FILL: net-new in risk v1.0.0. Asserts the impact level of a RiskItem. amod previously had RiskImpact class but no property to assert it."@en .

risk:riskLikelihood a owl:ObjectProperty ;
    rdfs:label "risk likelihood"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "GAP-FILL: net-new in risk v1"@en ;
    rdfs:domain risk:RiskItem ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range risk:LikelihoodLevel ;
    skos:definition "GAP-FILL: net-new in risk v1.0.0. Asserts the likelihood level of a RiskItem."@en .

risk:riskMitigation a owl:DatatypeProperty ;
    rdfs:label "risk mitigation"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:domain risk:RiskItem ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range xsd:string ;
    skos:definition "Consolidated from configuration:riskMitigation v2.0.0. Brief textual description of mitigation approach."@en .

risk:riskOwner a owl:ObjectProperty ;
    rdfs:label "risk owner"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "GAP-FILL: net-new in risk v1"@en ;
    rdfs:domain risk:RiskItem ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range core:Agent ;
    skos:definition "GAP-FILL: net-new in risk v1.0.0. Accountability assignment for a RiskItem. Range uses core:Agent."@en .

risk:riskProbability a owl:DatatypeProperty ;
    rdfs:label "risk probability"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:domain risk:Risk ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range xsd:decimal ;
    skos:definition "Consolidated from configuration:riskProbability v2.0.0. Quantitative probability decimal [0,1]."@en .

risk:riskStatus a owl:ObjectProperty ;
    rdfs:label "risk status"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "GAP-FILL: net-new in risk v1"@en ;
    rdfs:domain risk:RiskItem ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range risk:RiskStatus ;
    skos:definition "GAP-FILL: net-new in risk v1.0.0. Lifecycle state of a RiskItem."@en .

risk:severity a owl:DatatypeProperty ;
    rdfs:label "severity"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:domain risk:FailureMode ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range xsd:integer ;
    skos:definition "GAP-FILL: net-new in risk v1.0.0. FMEA Severity rating per ISO 60812:2018 / AIAG-VDA: integer 1-10. 1=negligible, 10=hazardous without warning. Used to compute RPN."@en .

risk:severityRank a owl:DatatypeProperty ;
    rdfs:label "severity rank"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:domain risk:SeverityLevel ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range xsd:integer ;
    skos:definition "Consolidated from quality:severityRank v3.0.0. Ordinal rank where lower values indicate higher severity (1=Critical, 4=Low)."@en .

testing:APITest a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "API Test"@en ;
    testing:migrationDate "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:APITest ;
    rdfs:comment "API Test - validates functional behavior."@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf testing:FunctionalTest ;
