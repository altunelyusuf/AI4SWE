testing:ConsistencyTesting a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Consistency Testing"@en ;
    testing:migrationDate "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:ConsistencyTesting ;
    rdfs:comment "ConsistencyTesting is a testing method that evaluates the consistency of LLM outputs across multiple generations of the same prompt, measuring variance, reproducibility, and self-agreement under identical conditions to assess reliability."@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf testing:LLMTestingMethod ;
    skos:definition "ConsistencyTesting is a testing method that evaluates the consistency of LLM outputs across multiple generations of the same prompt, measuring variance, reproducibility, and self-agreement under identical conditions to assess reliability."@en ;
    prov:wasDerivedFrom reliability:ConsistencyTesting .

testing:DecorativeComplianceDetection a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Decorative Compliance Detection"@en ;
    testing:migrationDate "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:DecorativeComplianceDetection ;
    rdfs:comment """Applies EmpiricalTest methodology specifically to detect
    decorative compliance. Core technique: modify data source values, reload
    application without code changes, verify behavior reflects new values.
    Components that do not respond to data source changes are decorative
    regardless of their structural validity."""@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf testing:AdversarialTesting ;
    skos:definition """Adversarial testing method that detects decorative
    compliance by mutating data source values and verifying that
    application behavior changes correspondingly, identifying components
    that are structurally present but functionally disconnected"""@en ;
    prov:wasDerivedFrom reliability:DecorativeComplianceDetection .

testing:HallucinationDetectionMethod a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Hallucination Detection Method"@en ;
    testing:migrationDate "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:HallucinationDetectionMethod ;
    rdfs:comment "A verification method specifically designed to identify hallucinations in LLM-generated content, encompassing both reference-based approaches that compare outputs against source documents and reference-free approaches that assess internal consistency or use specialized detection models."@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf testing:LLMTestingMethod ;
    skos:definition "A verification method specifically designed to identify hallucinations in LLM-generated content, encompassing both reference-based approaches that compare outputs against source documents and reference-free approaches that assess internal consistency or use specialized detection models."@en ;
    prov:wasDerivedFrom reliability:HallucinationDetectionMethod .

