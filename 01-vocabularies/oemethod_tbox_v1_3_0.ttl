    skos:definition "Relates a lifecycle phase to the type of testing activity typically performed during that phase."@en ;
    prov:wasDerivedFrom reliability:involvesTesting .

testing:limitsResource_Budget a owl:ObjectProperty ;
    rdfs:label "limitsResource_Budget"@en ;
    dcterms:isPartOf <http://example.org/testing> ;
