    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:decimal ;
    skos:definition "Ratio of benefit to cost for the mitigation approach"@en ;
    skos:example "ex:check redo:costEffectivenessRatio \"medium\"^^xsd:string . Activity has an associated cost level."@en .

