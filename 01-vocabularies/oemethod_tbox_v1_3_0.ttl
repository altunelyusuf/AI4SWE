    prov:wasDerivedFrom reliability:TestExecution .

testing:TestOracle a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Test Oracle"@en ;
    testing:migrationDate "2026-05-14T00:00:00"^^xsd:dateTime ;
