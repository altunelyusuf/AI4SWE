testing:RedTeaming a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Red-Teaming"@en ;
    testing:migrationDate "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:RedTeaming ;
    rdfs:comment "Structured adversarial evaluation method in which evaluators systematically attempt to elicit harmful, deceptive, biased, or otherwise undesired behavior from an LLM-based system. Distinct from AdversarialTesting in scope: RedTeaming uses scenario-based attack campaigns with documented findings, while AdversarialTesting is the broader methodology of probing LLM behavioral pathologies. Used to surface failure modes prior to deployment."@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf testing:LLMTestingMethod ;
    skos:definition "Structured adversarial evaluation method in which evaluators systematically attempt to elicit harmful, deceptive, biased, or otherwise undesired behavior from an LLM-based system. Distinct from AdversarialTesting in scope: RedTeaming uses scenario-based attack campaigns with documented findings, while AdversarialTesting is the broader methodology of probing LLM behavioral pathologies. Used to surface failure modes prior to deployment."@en ;
    prov:wasDerivedFrom reliability:RedTeaming .

testing:RegressionTest a owl:Class,
        owl:NamedIndividual ;
