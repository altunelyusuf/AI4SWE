    rdfs:seeAlso kb:RegressionTest ;
    rdfs:subClassOf testing:Test ;
    skos:definition "A test category that re-executes previously passing test cases after ontology modifications to detect unintended side effects, ensuring that changes do not break existing functionality or semantics."@en ;
    skos:related kb:RegressionTest ;
    prov:wasDerivedFrom reliability:RegressionTest .

testing:RegressionTestSuite a owl:Class,
