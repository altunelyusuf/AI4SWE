reliability:detectedByMetric_NSVR a owl:ObjectProperty ;
    rdfs:label "detected by metric (negative space verification)"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:DecorativeVerification ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:NegativeSpaceVerificationRate ;
    skos:definition """Relates a DecorativeVerification instance to the 
    NegativeSpaceVerificationRate metric that detects it. When NSVR = 0.0 
    for a completeness claim, the verification is structurally decorative 
    regardless of how many forward checks it contains."""@en ;
    skos:example "ex:nsvr_instance redo:detectedByMetric_NSVR redo:NSVRRate . Links pathology instance to its detection mechanism."@en .

reliability:detectedByMetric_NarrAnch a owl:ObjectProperty ;
