    prov:wasDerivedFrom reliability:probesFor_SelfCheck .

testing:producesArtifact a owl:NamedIndividual,
        owl:ObjectProperty ;
    rdfs:label "produces artifact"@en ;
    dcterms:isPartOf <http://example.org/testing> ;
    rdfs:domain testing:TestingMethodology ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:range testing:Test ;
    owl:inverseOf testing:appliedMethodology ;
    skos:definition "Links a TestingMethodology to the Test artifacts it produces. Inverse of testing:appliedMethodology."@en .

testing:testedUsing a owl:ObjectProperty ;
    rdfs:label "testedUsing"@en ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:testedUsing ;
    rdfs:domain reliability:LLMBehavioralPathology ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:range testing:LLMTestingMethod ;
    skos:definition "Relates an LLM behavioral pathology to the testing method specifically designed to detect or expose that pathology."@en ;
    prov:wasDerivedFrom reliability:testedUsing .

testing:testsArtifact a owl:ObjectProperty ;
    rdfs:label "testsArtifact"@en ;
    dcterms:isPartOf <http://example.org/testing> ;
    rdfs:domain testing:Test ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:range core:Artifact ;
    skos:definition "Subject-link (registration) hook: the artifact this Test exercises. A component registers its tests of itself via this property; all specific test types inherit it (⊑ Test). Range core:Artifact."@en .

testing:typicalTestingIn_Deployment a owl:ObjectProperty ;
    rdfs:label "typicalTestingIn_Deployment"@en ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:typicalTestingIn_Deployment ;
    rdfs:domain reliability:Deployment ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:range testing:SystemTesting ;
    skos:definition "Relates the deployment phase to system testing as the final pre-release verification activity."@en ;
    prov:wasDerivedFrom reliability:typicalTestingIn_Deployment .

testing:typicalTestingIn_Implementation a owl:ObjectProperty ;
    rdfs:label "typicalTestingIn_Implementation"@en ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:typicalTestingIn_Implementation ;
    rdfs:domain reliability:Implementation ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:range testing:UnitTesting ;
    skos:definition "Relates the implementation phase to unit testing as its primary verification activity."@en ;
    prov:wasDerivedFrom reliability:typicalTestingIn_Implementation .

testing:typicalTestingIn_Integration a owl:ObjectProperty ;
    rdfs:label "typicalTestingIn_Integration"@en ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:typicalTestingIn_Integration ;
    rdfs:domain reliability:Testing ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:range testing:IntegrationTesting ;
    skos:definition "Relates the testing phase to integration testing as a key activity verifying component interactions."@en ;
    prov:wasDerivedFrom reliability:typicalTestingIn_Integration .

testing:typicalTestingIn_Maintenance a owl:ObjectProperty ;
    rdfs:label "typicalTestingIn_Maintenance"@en ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:typicalTestingIn_Maintenance ;
    rdfs:domain reliability:Maintenance ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:range testing:RegressionTesting ;
    skos:definition "Relates the maintenance phase to regression testing as the primary verification after modifications."@en ;
    prov:wasDerivedFrom reliability:typicalTestingIn_Maintenance .

ae:AkraBazziMethod a owl:Class ;
    rdfs:label "Akra-Bazzi Method"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Akra and Bazzi 1998 On the Solution of Linear Recurrence Equations Comp Opt Appl 10(2)"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf [ ],
        ae:AnalysisTool ;
    owl:disjointWith ae:AccountingMethod,
        ae:AggregateMethod,
        ae:BackwardSubstitution,
        ae:CharacteristicEquation,
        ae:DecisionTreeTechnique,
        ae:LimitComparison,
        ae:PotentialMethod,
        ae:RecursionTreeMethod,
        ae:StirlingApproximation,
        ae:SubstitutionMethod ;
    skos:definition "A generalization of the Master Theorem handling divide-and-conquer recurrences with unequal subproblem sizes T(n) = sum(a_i T(n/b_i)) + g(n), solving a wider class by finding the unique p satisfying sum(a_i / b_i^p) = 1."@en .

ae:AlgorithmicEfficiencyConcept a owl:Class ;
    rdfs:label "Algorithm Efficiency Concept"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "OE Pack v19.0.1 anomaly-A fix: added per convention-matching umbrella audit identified in 2026-05-19 session."@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf core:Concept ;
    skos:definition "Discipline-root umbrella for all algorithm-efficiency-domain concepts owned by the algorithm-efficiency subject. Convention-matching sibling to QualityConcept, RiskConcept, TestingConcept, MeasurementConcept, PerformanceConcept, ReliabilityConcept, KnowledgeBaseConcept under core:Concept. Parents the algorithm-efficiency vocabulary tree."@en .

ae:BasicOperation a owl:Class ;
    rdfs:label "Basic Operation"@en ;
    measurement:hasMeasurementSubject measurement:AlgorithmAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Sec2.1"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:StructuralConcept ;
    owl:disjointWith ae:CaseDistinction,
        ae:ClosedFormSolution,
        ae:GeneratingFunction,
        ae:GrowthRateFunction,
        ae:InputDistribution,
        ae:RecurrenceRelation,
        ae:SummationFormula ;
    skos:definition "The most time-consuming operation in an algorithm innermost loop whose execution count C(n) serves as the principal measure of time efficiency, typically a comparison, arithmetic operation, or data movement."@en .

ae:BigOmegaNotation a owl:Class ;
    rdfs:label "Big-Omega Notation"@en ;
    measurement:hasMeasurementSubject measurement:AlgorithmAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Cormen et al 2022 Ch3"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:AsymptoticNotation ;
    owl:disjointWith ae:BigThetaNotation,
        ae:LittleOhNotation,
        ae:LittleOmegaNotation ;
    skos:definition "The notation Omega(g(n)) denoting all functions t(n) bounded below by a positive constant multiple of g(n) for sufficiently large n, providing asymptotic lower bounds on algorithm performance."@en .

ae:CompetitiveAnalysisParadigm a owl:Class ;
    rdfs:label "Competitive Analysis Paradigm"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Sleator and Tarjan 1985 Amortized Efficiency of List Update and Paging Rules CACM 28(2)"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:AnalysisParadigm ;
    skos:definition "An analysis paradigm for online algorithms comparing the cost of an online algorithm against an optimal offline algorithm on the same input sequence, expressing performance as a competitive ratio."@en .

ae:DivideAndConquerFamily a owl:Class ;
    rdfs:label "Divide-and-Conquer Family"@en ;
    measurement:hasMeasurementSubject measurement:AlgorithmAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Cormen et al 2022 Ch4"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf [ ],
        ae:AlgorithmFamily ;
    owl:disjointWith ae:BacktrackingFamily,
        ae:DynamicProgrammingFamily,
        ae:GreedyFamily,
        ae:RandomizedFamily ;
    skos:definition "Algorithms that decompose a problem into independent subproblems of smaller size, solve each recursively, and combine results, with efficiency governed by the Master Theorem recurrence T(n)=aT(n/b)+f(n)."@en .

ae:HistoricalCaseStudy a owl:Class ;
    rdfs:label "Historical Case Study"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Sec2.5"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:HistoricalContext ;
    owl:disjointWith ae:FieldEvolution,
        ae:KeyContributor ;
    skos:definition "A specific algorithmic problem or sequence serving as a canonical pedagogical example for illustrating analysis techniques and revealing deeper principles of algorithm efficiency."@en .

ae:MethodologicalContribution a owl:Class ;
    rdfs:label "Methodological Contribution"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Tarjan 1985 SIAM J"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:FoundationalContribution ;
    skos:definition "A foundational contribution introducing a new analysis technique, tool, or framework that enabled novel ways of studying and characterizing algorithm efficiency."@en .

ae:NPCompletenessEra a owl:Class ;
    rdfs:label "NP-Completeness Era"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Garey and Johnson 1979 Computers and Intractability"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:FieldEvolution ;
    owl:disjointWith ae:BeyondWorstCaseEra ;
    skos:definition "The transformative period from 1971 through the 1980s when NP-completeness theory was established by Cook and Karp, amortized analysis formalized by Tarjan, and randomized algorithms developed."@en .

ae:OperationCounting a owl:Class ;
    rdfs:label "Operation Counting"@en ;
    measurement:hasMeasurementSubject measurement:ProgramAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Sec2.6"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:EmpiricalMethod ;
    owl:disjointWith ae:ProfilingMethod,
        ae:RatioBasedEstimation,
        ae:ScatterplotAnalysis,
        ae:StatisticalInference ;
    skos:definition "An empirical method instrumenting an algorithm implementation with counters to record exact numbers of basic operation executions, providing machine-independent data that can validate theoretical predictions."@en .

ae:OptimizationProblem a owl:Class ;
    rdfs:label "Optimization Problem"@en ;
    measurement:hasMeasurementSubject measurement:ComputationalProblemAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Korte and Vygen 2018 Combinatorial Optimization 6e Springer"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:ProblemCategory ;
    owl:disjointWith ae:CountingProblem,
        ae:EnumerationProblem,
        ae:SearchProblem ;
    skos:definition "A problem seeking the best solution according to an objective function among a set of feasible solutions, with efficiency measured by both solution quality and time required."@en .

ae:PerformancePrediction a owl:Class ;
    rdfs:label "Performance Prediction"@en ;
    measurement:hasMeasurementSubject measurement:AlgorithmAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Hutter et al 2014 Algorithm Runtime Prediction AI 206"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:UseCase ;
    owl:disjointWith ae:AlgorithmPortfolio,
        ae:AutomatedAlgorithmDesign,
        ae:CompetitiveProgramming,
        ae:CompilerOptimization,
        ae:EducationalApplication,
        ae:MLAugmentedAnalysis ;
    skos:definition "Applying theoretical and empirical efficiency models to predict running time or resource usage on unseen inputs, enabling capacity planning, scheduling, and feasibility assessment."@en .

ae:ProfilingTool a owl:Class ;
    rdfs:label "Profiling Tool"@en ;
    measurement:hasMeasurementSubject measurement:ProgramAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Nethercote and Seward 2007 Valgrind ACM SIGPLAN Notices 42(6)"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf [ ],
        ae:AnalysisResource ;
    owl:disjointWith ae:BenchmarkingSuite,
        ae:ComplexityAnalysisTool,
        ae:SurveyPaper,
        ae:VisualizationTool ;
    skos:definition "A software tool measuring and reporting execution characteristics of a program including time per function, memory allocation, cache behavior, and call frequency, enabling empirical identification of performance bottlenecks."@en .

ae:ProgrammingParadigmRelationship a owl:Class ;
    rdfs:label "Programming Paradigm Relationship"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Abelson and Sussman 1996 SICP 2e MIT Press"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:InterDomainRelationship ;
    owl:disjointWith ae:CryptographyRelationship,
        ae:FormalVerificationRelationship,
        ae:MachineLearningRelationship,
        ae:ParallelComputingRelationship,
        ae:QuantumComputingRelationship,
        ae:SoftwareEngineeringRelationship ;
    skos:definition "The relationship between programming paradigms and algorithm efficiency, where paradigm choice affects how algorithms are expressed, analyzed, and optimized by compilers and runtime systems."@en .

ae:RecursiveAnalysis a owl:Class ;
    rdfs:label "Recursive Algorithm Analysis"@en ;
    measurement:hasMeasurementSubject measurement:AlgorithmAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Sec2.4"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf [ ],
        ae:AnalysisMethod ;
    owl:disjointWith ae:AdversaryArgumentMethod,
        ae:AutomatedComplexityAnalysis,
        ae:EmpiricalAnalysisMethod,
        ae:HybridAnalysis,
        ae:ProbabilisticAnalysis,
        ae:VisualizationAnalysis ;
    skos:definition "A method for analyzing recursive algorithms by establishing a recurrence relation for the basic operation count, specifying initial conditions, and solving using backward substitution, the Master Theorem, or characteristic equations."@en .

ae:SpaceComplexityClass a owl:Class ;
    rdfs:label "Space Complexity Class"@en ;
    measurement:hasMeasurementSubject measurement:ComputationalProblemAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Arora and Barak 2009 Ch4"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:ComplexityClass ;
    skos:definition "A complexity class defined by bounds on the amount of memory or tape cells required by algorithms, encompassing L, NL, PSPACE, and the space hierarchy theorem."@en .

ae:TractabilityAssumption a owl:Class ;
    rdfs:label "Tractability Assumption"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Cobham 1965 The Intrinsic Computational Difficulty of Functions"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:PhilosophicalFoundation ;
    owl:disjointWith ae:ChurchTuringThesis,
        ae:ComplexityTheoreticWorldview,
        ae:ComputationalModelTheory,
        ae:InformationTheoreticBound,
        ae:QuantumComputabilityPrinciple,
        ae:ReductionismInAnalysis ;
    skos:definition "A foundational belief in complexity theory, such as the Cobham-Edmonds thesis equating tractability with polynomial-time solvability, that frames which algorithmic solutions are considered practically feasible and which are considered inherently intractable."@en .

ae:UndergraduateTextbook a owl:Class ;
    rdfs:label "Undergraduate-Level Textbook"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "ACM Digital Library"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:Textbook ;
    skos:definition "An introductory textbook targeting undergraduate students, presenting fundamental algorithm analysis techniques with accessible examples and progressive skill development."@en .

ae:analyzes a owl:ObjectProperty ;
    rdfs:label "analyzes"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    rdfs:domain ae:AnalysisMethod ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:range ae:AlgorithmFamily ;
    skos:definition "Relates an analysis method to the algorithm family it is applied to study."@en .

ae:solvedBy a owl:ObjectProperty ;
    rdfs:label "solved by"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    rdfs:domain ae:RecurrenceRelation ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:range ae:AnalysisTool ;
    skos:definition "Relates a recurrence relation to the analysis tool used to derive its closed-form solution."@en .

acap:ArtifactCapabilityLevel a owl:Class ;
    rdfs:label "Artifact capability level"@en ;
    dcterms:isPartOf <http://example.org/artifact-capability> ;
    dcterms:source "Minted at OE Pack v20.35.0 after CMMIMaturityLevel was wrongly applied to 12 ontology assessments." ;
    skos:definition "What an ontology can DO: which questions it answers, what reasoning it supports, what can be built on it. A property of the vocabulary, measured from the vocabulary. NOT reliability:CMMIMaturityLevel, which is CMMI v2.0 ORGANISATIONAL maturity and specifies process areas an organisation must satisfy — a different subject with a similar name. NOT reliability:InteractionCapability, which is ISO product capability for end users."@en .

acap:ArtifactMaturityLevel a owl:Class ;
    rdfs:label "Artifact maturity level"@en ;
    dcterms:isPartOf <http://example.org/artifact-capability> ;
    skos:definition "How SETTLED an ontology is: whether its definitions have stopped moving, whether it has reached a stable major version, how much recorded rationale stands behind it. Orthogonal to capability and can diverge sharply — a well-settled vocabulary that answers nothing is mature and incapable, and a rich vocabulary changing weekly is capable and immature. NOT reliability:Maturity, which is a QualityCharacteristic about failure frequency of a running system."@en .

configuration:ArtifactNamingSchema a owl:Class ;
    rdfs:label "Artifact Naming Schema"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "ISO/IEC 15289:2019 Systems and software engineering — Content of life-cycle information items. SWEBOK v4.0 (IEEE, 2024) — Software Configuration Management. meta:ArtifactNamingSchema (META v6.1.1)."@en ;
    rdfs:comment "Relationship to NamingConvention: an ArtifactNamingSchema IS a NamingConvention (subClassOf) that collects multiple individual NamingConvention instances — one per artefact class. Referenced by redo:hasManifest (D3) as the schema against which sprint manifests are validated."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.iso.org/standard/54846.html>,
        <https://www.swebok.org/> ;
    rdfs:subClassOf configuration:NamingConvention ;
    skos:definition "A project-level specification that collects all NamingConvention instances for an engineering project, mapping each EngineeringArtefact class to its required filename pattern. An ArtifactNamingSchema is a singleton per project and serves as the authoritative reference for a reliability ontology C8Out gate validation: the gate checks that every sprint manifest entry conforms to the pattern declared in the schema for its artefact class."@en ;
    skos:example "configuration:REDOEcosystemSchema — the ArtifactNamingSchema for the a reliability ontology ontology engineering ecosystem, collecting five NamingConvention individuals covering TTL, SHACL, Markdown, HTML, and code artefacts."@en .

configuration:ClassAddition a owl:Class ;
    rdfs:label "Class Addition"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Introduction of a new class into the ontology."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:ClassChange ;
    skos:definition "A class change that introduces a new named class into an existing class hierarchy, specifying its superclass, initial restrictions, and required annotations while preserving consistency of the surrounding structure."@en ;
    skos:example "Adding 'ElectricVehicle' as a new class under 'Vehicle' parent."@en .

configuration:ClassDeletion a owl:Class ;
    rdfs:label "Class Deletion"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Removal of a class from the ontology."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:ClassChange ;
    skos:definition "A class change that removes a named class from the ontology, requiring migration of any subclasses to alternative parents and reclassification of any instances that were members of the deleted class."@en ;
    skos:example "Removing deprecated class 'OldVehicleType' and reassigning its instances."@en .

configuration:CodeModule a owl:Class ;
    rdfs:label "Code Module"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "SWEBOK v4.0 (IEEE, 2024) — Software Configuration Management. ISO/IEC 15289:2019 Systems and software engineering — Content of life-cycle information items."@en ;
    rdfs:comment "An EngineeringArtefact that is a source code file (Python, JavaScript, JSX, TypeScript, JSON schema) including test harnesses, pipeline scripts, validators, and configuration schemas."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html>,
        <https://www.swebok.org/> ;
    rdfs:subClassOf configuration:EngineeringArtefact ;
    owl:disjointWith configuration:DocumentationFile,
        configuration:SafeguardDocument ;
    skos:definition "An EngineeringArtefact that is a source code file (Python, JavaScript, JSX, TypeScript, JSON schema) including test harnesses, pipeline scripts, validators, and configuration schemas."@en ;
    skos:example "course_material_pipeline_v3_11.jsx — JSX course material tool, version 3.11"@en .

configuration:DerivativeArchive a owl:Class ;
    rdfs:label "Derivative archive"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    rdfs:comment "A ProjectArchive whose contents are a subset, recombination, or focused-use re-packaging of another ProjectArchive (the source). Distinct from a continuation: a continuation is the next version of the same scope's contents; a DerivativeArchive is intentionally a different artefact aimed at a different use case. Examples: oepack-engineering-kit-v1_0_0.zip (subset of family v17.1.1), oepack-methodology-v1_0_0.zip (different subset of family v17.1.1)."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf configuration:ProjectArchive ;
    skos:definition "A ProjectArchive whose contents are a subset, recombination, or focused-use re-packaging of another ProjectArchive (the source). Distinct from a continuation: a continuation is the next version of the same scope's contents; a DerivativeArchive is intentionally a different artefact aimed at a different use case. Examples: oepack-engineering-kit-v1_0_0.zip (subset of family v17.1.1), oepack-methodology-v1_0_0.zip (different subset of family v17.1.1)."@en .

configuration:HierarchyRestructuring a owl:Class ;
    rdfs:label "Hierarchy Restructuring"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Reorganizing taxonomy by moving or inserting classes in the hierarchy."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:HierarchyChange ;
    skos:definition "A hierarchy change that reorganizes a significant portion of the class tree by moving subtrees, introducing new intermediate nodes, or changing the classification criteria used for sibling grouping."@en ;
    skos:example "Inserting 'MotorizedVehicle' between 'Vehicle' and 'Car' in the hierarchy."@en .

configuration:PlanProposal a owl:Class ;
    rdfs:label "plan proposal"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "OE Pack expansion-plan ontology v1.0.1 plan:PlanProposal."@en ;
    rdfs:comment "The top-level plan artefact. A PlanProposal aggregates Tracks, recommends a SequencingOption, lists OpenQuestions and RiskItems, and declares an estimated effort (in hours). One PlanProposal per planning exercise."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf configuration:PlanArtefact ;
    skos:definition "The top-level plan artefact. A PlanProposal aggregates Tracks, recommends a SequencingOption, lists OpenQuestions and RiskItems, and declares an estimated effort (in hours). One PlanProposal per planning exercise."@en .

configuration:PropertyAddition a owl:Class ;
    rdfs:label "Property Addition"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Creating a new property in the ontology."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:PropertyChange ;
    skos:definition "A property change that introduces a new object or datatype property into the ontology with specified domain, range, and characteristics, extending the available vocabulary for expressing relationships."@en ;
    skos:example "Adding 'hasManufacturer' object property linking Vehicle to Manufacturer."@en .

configuration:ProposedSprint a owl:Class ;
    rdfs:label "proposed sprint"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "OE Pack expansion-plan ontology plan:ProposedSprint."@en ;
    rdfs:comment "A planned-but-not-yet-executed Sprint. Has scope, estimated effort, deliverables, acceptance criteria, and (typically) carries forward to become an executed Sprint with PROV record + manifest + closure document. The 'proposed' state distinguishes it from a real Sprint."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf configuration:PlanArtefact ;
    skos:definition "A planned-but-not-yet-executed Sprint. Has scope, estimated effort, deliverables, acceptance criteria, and (typically) carries forward to become an executed Sprint with PROV record + manifest + closure document. The 'proposed' state distinguishes it from a real Sprint."@en .

configuration:ShapeFile a owl:Class ;
    rdfs:label "Shape File"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "W3C Shapes Constraint Language (SHACL) Specification (2017). ISO/IEC 15289:2019 Systems and software engineering — Content of life-cycle information items."@en ;
    rdfs:comment "An EngineeringArtefact containing SHACL NodeShape declarations that enforce structural constraints on an OWL ontology graph. The filename encodes the shape family and version: {family}_shacl_v{M}_{m}_{p}.ttl."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/shacl/> ;
    rdfs:subClassOf configuration:EngineeringArtefact ;
    skos:definition "An EngineeringArtefact containing SHACL NodeShape declarations that enforce structural constraints on an OWL ontology graph. The filename encodes the shape family and version: {family}_shacl_v{M}_{m}_{p}.ttl."@en ;
    skos:example "redo_shacl_v2_0_3.ttl — ShapeFile, 16 a reliability ontology shapes, version 2.0.3"@en .

configuration:semVerMajor a owl:DatatypeProperty ;
    rdfs:label "SemVer major component"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "semver.org §1, §8."@en ;
    rdfs:domain configuration:SemVerVersion ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "SemVer MAJOR component. Increment when making backwards-incompatible API changes. Versions with the same MAJOR are intended to be backwards-compatible (MINOR/PATCH compose freely)."@en .

configuration:semVerMinor a owl:DatatypeProperty ;
    rdfs:label "SemVer minor component"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "semver.org §1, §7."@en ;
    rdfs:domain configuration:SemVerVersion ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "SemVer MINOR component. Increment when adding backwards-compatible functionality. Reset to 0 when MAJOR increments."@en .

configuration:semVerPatch a owl:DatatypeProperty ;
    rdfs:label "SemVer patch component"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "semver.org §1, §6."@en ;
    rdfs:domain configuration:SemVerVersion ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "SemVer PATCH component. Increment when making backwards-compatible bug fixes. Reset to 0 when MINOR increments."@en .

configuration:tokenValue a owl:DatatypeProperty ;
    rdfs:label "token value"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Semantic Versioning 2.0.0 (semver.org)."@en ;
    rdfs:domain configuration:VersionToken ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:range xsd:string ;
    skos:definition "The string value of the VersionToken as embedded in the filename (e.g., 'v2_4_9')."@en .

core:Activity a owl:Class ;
    rdfs:label "Activity"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    dcterms:source "DOLCE+DnS Ultralite (Gangemi & Mika 2003). ISO/IEC/IEEE 42010:2011 process. Generalised from PROV-O prov:Activity."@en ;
    rdfs:isDefinedBy <http://example.org/core> ;
    rdfs:seeAlso kb:Activity ;
    skos:definition "A structured occurrence in time during which agents perform engineering work. Generalises Process and is a co-domain of core:hasRole (a role can be enacted in an activity)."@en ;
    skos:related kb:Activity .

core:CriticalityProfile a owl:Class ;
    rdfs:label "Criticality Profile"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    rdfs:isDefinedBy <http://example.org/core> ;
    rdfs:subClassOf core:Concept ;
    skos:definition "The case/criticality class a component declares about ITSELF — how much process rigor its context demands (e.g. low, standard, high, critical). Distinct from core:SeverityLevel, which rates the impact of an individual finding/defect. CriticalityProfile parameterizes facet conformance gates: a higher profile requires more complete process evidence."@en .

core:DescriptiveCompetencyQuestion a owl:Class ;
    rdfs:label "Descriptive Competency Question"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    dcterms:source "OE Pack v17.30.0 — companion class to OperationalizableCompetencyQuestion per L-49 design-intent codification."@en ;
    rdfs:subClassOf core:CompetencyQuestion ;
    skos:definition """A competency question whose answer is inherently NOT SPARQL-operationalizable. Three subtypes:
  (1) DesignRationale — asks "Why?" or "Why do X and Y coexist?" — answer       lives in skos:definition prose, not in queryable data.
  (2) Procedural — asks "How do I...?" — answer is a procedural recipe,       typically with off-graph steps (install/configure/run).
  (3) SessionContext — asks about current-session values (e.g., "what should       this archive be named?") — computed from runtime context, not from       the ontology.

DescriptiveCompetencyQuestions MUST carry a non-empty skos:definition that IS the answer. They MUST NOT be expected to have quality:hasSPARQLImplementation — attempts to add one are metric gaming per L-40."""@en .

core:Developer a owl:Class ;
    rdfs:label "Developer"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    dcterms:source "IEEE 12207:2017 §7.1 — Implementation process."@en ;
    rdfs:isDefinedBy <http://example.org/core> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf core:Agent,
        core:Role ;
    owl:disjointWith core:Maintainer,
        core:Tester ;
    skos:definition "An agent role responsible for implementing engineering artifacts — including software code, ontology axioms, and documentation — according to design specifications and quality standards."@en ;
    skos:example "A Python developer who writes the pySHACL validation harness c5_empirical_test_v1_0_1.py occupies the Developer role; they implement the five mutation test functions against rdflib Graph objects."@en .

core:detects a owl:ObjectProperty ;
    rdfs:label "detects"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    dcterms:source "ISO/IEC/IEEE 29119-1:2022 Software and systems engineering — Software testing — Part 1: General concepts."@en ;
    rdfs:isDefinedBy <http://example.org/core> ;
    owl:inverseOf reliability:detectedBy ;
    skos:definition "Relates a verification method or test to the defect category, quality violation, or behavioral pathology it is capable of identifying."@en .

core:hasVersion a owl:ObjectProperty ;
    rdfs:label "has version"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    dcterms:source "Semantic Versioning 2.0.0 (semver.org) — Version identifier specification."@en ;
    rdfs:comment "Domain is owl:Thing by design — every engineering artefact (ontology, code, document, dataset, schema) is potentially versionable. Downstream ontologies tighten via rdfs:subPropertyOf."@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy <http://example.org/core> ;
    rdfs:range core:Version ;
    skos:definition "Relates an artifact to a specific version."@en .

core:mitigates a owl:ObjectProperty ;
    rdfs:label "mitigates"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    dcterms:source "ISO 31000:2018 Risk management — Guidelines."@en ;
    rdfs:isDefinedBy <http://example.org/core> ;
    skos:definition "Relates a strategy, activity, or pattern to the risk, failure, or quality issue it reduces or prevents."@en .

measurement:ArchitecturalCoherenceScore a owl:Class ;
    rdfs:label "Architectural Coherence Score"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F5 (2026-05-15)."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:Measurement ;
    skos:definition "Score representing architectural coherence of an ontology. Per Sprint F5."@en .

measurement:CROnto a owl:Class ;
    rdfs:label "Class Richness"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Duque-Ramos A. et al. (2013). Evaluation of the OQuaRE framework for ontology quality. Expert Systems with Applications 40, 2696-2703."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:Metric ;
    skos:definition "OQuaRE relative metric: mean number of individuals per class (instance-to-class ratio), expressed as percentage. Distinct from OntoQA's class richness (which is fraction of classes with at least one instance). Contributes to FunctionalAdequacy (Inference) per Duque-Ramos 2016 Table 3."@en .

measurement:CompetencyQuestionEvaluation a owl:Class ;
    rdfs:label "Competency Question Evaluation"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Boeker M., Grewe N., Röhl J., et al. (2013). Measuring the effect of a guideline-based training on ontology design with a competency questions based evaluation approach. Informatik 2013. OE Pack v19.3.0 Phase F4."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:MeasurementRun ;
    skos:definition "A specific MeasurementRun that evaluates an ontology by executing its competency questions as SPARQL queries and recording pass/fail outcomes. Produces a CompetencyQuestionPassRate score. Captures the evaluation context: which CQ set, which ontology version, which SPARQL endpoint, which evaluation date. Distinguished from a generic MeasurementRun by its specific CQ-centric subject and methodology."@en .

measurement:ComprehensivenessMetric a owl:Class ;
    rdfs:label "Comprehensiveness Metric"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Duque-Ramos A. et al. (2013). Evaluation of the OQuaRE framework for ontology quality. Expert Systems with Applications 40, 2696-2703. FunctionalAdequacy metric family; OE Pack v19.0.4 Phase F1 (Proposal F). Quantification umbrella for quality:Comprehensiveness dimension."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:seeAlso qc:Comprehensiveness ;
    rdfs:subClassOf measurement:MeasurementConcept ;
    skos:definition "Umbrella class for metrics measuring comprehensiveness of an ontology — how broadly the ontology covers its intended domain scope. Subsumes term-mapping coverage metrics (fraction of domain glossary terms represented as classes/properties), concept-coverage metrics (fraction of expected concepts present), and breadth-of-relationships metrics (fraction of expected inter-concept relationships modeled). Quantifies what the quality:Comprehensiveness dimension assesses. Distinguished from CompletenessMetric (which measures internal completeness: do existing classes have labels/definitions/sources) and CoverageMetric (which measures proportionate filling of defined scope)."@en .

measurement:ConfidenceTier a owl:Class ;
    rdfs:label "Confidence Tier"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "OE Pack v19.6.0 Phase J1 of Proposal J v1.0.0 (Test-Driven Maximum-Score Plan). Establishes confidence-tier disclosure infrastructure required by subsequent phases that introduce statistical-proxy (TIER-B) and LLM-mediated (TIER-C) assessment items."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:MeasurementConcept ;
    skos:definition "A categorical classification of the methodological tier under which an assessment score was produced. Four tiers per BP-D47: TIER-A (static algorithmic, deterministic, bit-reproducible), TIER-B (static statistical/proxy, reproducible but interpretation is probabilistic), TIER-C (LLM-mediated, not bit-reproducible, inherits model uncertainty), TIER-D (human judgment, not bit-reproducible across assessors, distinct from TIER-C). Aggregations propagate the lowest tier of their inputs, the order running from most to least confident A, B, D, C (owner's ruling of 2026-10-12): any TIER-C input makes the aggregation TIER-C, else any TIER-D input makes it TIER-D, else any TIER-B input makes it TIER-B (BP-D47). Every score in oe-assessment-tooling output v1.4.0+ MUST declare its tier."@en .

measurement:ConsistencyScore a owl:Class ;
    rdfs:label "Consistency Score"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F5 (2026-05-15)."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:Measurement ;
    skos:definition "Score representing consistency of an ontology. Per Sprint F5."@en .

measurement:DataStructureAsSubject a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Data Structure As Subject"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:AlgorithmicStructureMeasurementSubject ;
    skos:definition "Data structures whose operations have characterized complexity (hash maps, B-trees, etc.). Operation cost is a function of structure design and load. Per ae:DataStructureRelationship — bidirectional with algorithm choice."@en .

measurement:DepthMetric a owl:Class ;
    rdfs:label "Depth Metric"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F5 (2026-05-15)."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:SizeMetric ;
    skos:definition "Metric measuring inheritance depth — maximum depth of the class hierarchy. Per Sprint F5."@en .

measurement:F1Score a owl:Class ;
    rdfs:label "F1 Score"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F5 (2026-05-15)."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:Measurement ;
    skos:definition "Score representing F1 measurement result. Per Sprint F5."@en .

measurement:FactScore a owl:Class ;
    rdfs:label "Fact Score"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Min, S., Krishna, K., Lyu, X., Lewis, M., Yih, W., Koh, P. W., Iyyer, M., Zettlemoyer, L., & Hajishirzi, H. (2023). FActScore: Fine-grained Atomic Evaluation of Factual Precision in Long-form Text Generation. EMNLP 2023, pp. 12076-12100. arXiv:2305.14251."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:seeAlso reliability:HallucinationRate,
        reliability:SemanticAccuracy ;
    rdfs:subClassOf measurement:LLMReliabilityMetric ;
    skos:definition "Score representing the factual precision of long-form LLM output, computed as the proportion of atomic facts in the output that are supported by a trusted knowledge source. Atomic facts are extracted from the output, then each is independently verified as supported/unsupported against the knowledge source. FactScore = supported_atomic_facts / total_atomic_facts, range [0,1]. Extrinsic measure (vs a trusted knowledge source / world-truth), distinct from oem:GroundingScore which measures source-traceability against the provided context. Anchored to FActScore (Min et al., 2023, EMNLP)."@en ;
    skos:example "Decomposing a generated biography into 12 atomic factual claims and verifying 9 against the knowledge source yields FactScore = 0.75."@en ;
    skos:scopeNote "ConfidenceTier (BP-D47): TIER-C when atomic-fact verification is LLM-mediated; TIER-B if verification is an algorithmic lookup against a structured KB. The explicit formula above is what lets a downstream score bound to FactScore populate the BP-D47 proxy_basis field; absence of a formula does not itself violate BP-D47 (which governs score-output JSON), but supplying it enables honest proxy_basis disclosure."@en .

measurement:GroundingScore a owl:Class ;
    rdfs:label "Grounding Score"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Rashkin, H., Nikolaev, V., Lamm, M., Aroyo, L., Collins, M., Das, D., Petrov, S., Tomar, G. S., Turc, I., & Reitter, D. (2023). Measuring Attribution in Natural Language Generation Models (AIS framework). Computational Linguistics, 49(4), 777-840. Also Ji, Z. et al. (2023). Survey of Hallucination in Natural Language Generation. ACM Computing Surveys, 55(12), Article 248."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:seeAlso reliability:FaithfulnessError,
        reliability:HallucinationRate ;
    rdfs:subClassOf measurement:LLMReliabilityMetric ;
    skos:definition "Score representing the degree to which the entities, relations, and claims in an LLM output are traceable to the provided source context. GroundingScore = grounded_units / total_units, range [0,1], where a unit (named entity, asserted relation, or sentence-level claim) is grounded iff it can be aligned to content present in the source context. Intrinsic measure (faithfulness to the provided context), distinct from oem:FactScore which measures factual precision against a trusted knowledge source / world-truth. Anchored to the Attributable-to-Identified-Sources (AIS) framework (Rashkin et al., 2023) and the faithfulness/hallucination literature (Ji et al., 2023)."@en ;
    skos:example "Of 20 claim-units in a generated answer, 17 are alignable to the retrieved source passages, yielding GroundingScore = 0.85."@en ;
    skos:scopeNote "ConfidenceTier (BP-D47): TIER-C when unit-alignment is LLM-mediated; TIER-B if alignment is an algorithmic match against the source context. The explicit formula above is what lets a downstream score bound to GroundingScore populate the BP-D47 proxy_basis field (e.g. proxy_basis: GroundingScore = grounded_units/total_units, Rashkin 2023 AIS). A document can score high on GroundingScore yet low on FactScore (faithful to a wrong source) and vice versa."@en .

measurement:INROnto a owl:Class ;
    rdfs:label "Inheritance Relationships Richness"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Duque-Ramos A. et al. (2013). Evaluation of the OQuaRE framework for ontology quality. Expert Systems with Applications 40, 2696-2703."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:Metric ;
    skos:definition "OQuaRE relative metric: mean number of subclasses per class, expressed as percentage. Captures hierarchy breadth. Contributes to FunctionalAdequacy (Consistent search and query) per Duque-Ramos 2016 Table 3."@en .

measurement:MetricCalculation a owl:Class ;
    rdfs:label "Metric Calculation"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F5 (2026-05-15)."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:Measurement ;
    skos:definition "A calculation procedure for computing a metric value. Per Sprint F5."@en .

measurement:MetricCategory a owl:Class ;
    rdfs:label "Metric Category"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    skos:definition "Governing category for measurement metrics; the single axis under which all domain-local and core metrics are registered, enabling cross-domain duplication detection."@en .

measurement:QualityThreshold a owl:Class ;
    rdfs:label "Quality Threshold"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F5 (2026-05-15)."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:Measurement ;
    skos:definition "A threshold value defining a quality boundary. Per Sprint F5."@en .

measurement:ThresholdTable a owl:Class ;
    rdfs:label "Threshold Table"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F2 broad consolidation 2026-05-14. quality:ThresholdTable was used in the ABox but never formally declared in any subject TBox."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:Measurement ;
    skos:definition "A collection of ThresholdRow individuals constituting a complete threshold specification for a measurement methodology (e.g., the OQuaRE 2026 baseline thresholds). Each row covers one (metric, role, range) cell of the threshold matrix. Consumed by scoring engines to map raw metric values to band scores."@en .

measurement:appliesToMetric a owl:ObjectProperty ;
    rdfs:label "applies to metric"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F2 broad consolidation 2026-05-14. Consolidated from quality: namespace where the property was previously declared (or used undeclared, in the case of appliesToMetric and hasThresholdRow)."@en ;
    rdfs:domain measurement:ThresholdRow ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    skos:definition "Links a ThresholdRow to the Metric whose value space it bands. Range should be a Metric subclass (quality:ClassRichness, quality:AnnotationRichness, etc.). Each row applies to exactly one metric (cardinality 1)."@en .

measurement:hasInputArtifact a owl:ObjectProperty ;
    rdfs:label "has input artifact"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "OEM Bridge v1.0.0."@en ;
    rdfs:domain measurement:MeasurementRun ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:range core:Artifact ;
    skos:definition "Links a MeasurementRun to the OntologyArtifact instances measured during the run."@en .

measurement:oquareScore a owl:DatatypeProperty ;
    rdfs:label "oquare score"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F2 broad consolidation 2026-05-14. Consolidated from quality: namespace where the property was previously declared (or used undeclared, in the case of appliesToMetric and hasThresholdRow)."@en ;
    rdfs:domain measurement:ThresholdRow ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:range xsd:integer ;
    skos:definition "The OQuaRE band score (integer 1..5) assigned when a measured value falls within this row's [lowerBound, upperBound) range. Per Duque-Ramos et al. (2011) §3.4. 1 = poor, 5 = excellent."@en .

meta:ApacheJenaSHACL a owl:Class ;
    rdfs:label "Apache Jena SHACL"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "SHACL validation module integrated into Apache Jena framework."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://www.w3.org/TR/shacl/> ;
    rdfs:subClassOf meta:SHACLValidator ;
    skos:definition "A SHACL validator implemented within the Apache Jena framework that evaluates RDF graphs against SHACL shape definitions, leveraging Jena's graph processing engine for validation."@en ;
    skos:example "Jena SHACL validates RDF datasets against shapes with detailed violation reports."@en .

meta:EquivalenceAlignment a owl:Class ;
    rdfs:label "Equivalence Alignment"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Classes that represent exactly the same concept."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-642-38721-0> ;
    rdfs:subClassOf meta:ClassAlignment ;
    skos:definition "A class alignment type that declares two classes from different ontologies as semantically identical, meaning they represent the same concept and their instances should be treated interchangeably."@en ;
    skos:example "Declaring Vehicle in A equivalent to Vehicle in B."@en .

meta:ManyToOneMapping a owl:Class ;
    rdfs:label "Many-to-One Mapping"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Many-to-One Mapping - ontology alignment cardinality pattern."@en,
        "Multiple concepts map to single concept."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-642-38721-0> ;
    rdfs:subClassOf kb:MappingTechnique,
        meta:Mapping ;
    owl:disjointWith meta:OneToManyMapping,
        meta:OneToOneMapping ;
    skos:definition "A mapping technique that maps multiple source elements to a single target element, typically when the source ontology uses finer-grained distinctions that the target ontology collapses into one concept."@en ;
    skos:example "Car, Auto in A map to Vehicle in B."@en .

meta:TripleStore a owl:Class ;
    rdfs:label "Triple Store"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "RDF Database Systems: Triples Storage and SPARQL Query Processing (Sakr & Al-Naymat, 2010). Springer."@en ;
    rdfs:comment "Database system optimized for storing and querying RDF triples."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://git-scm.com/book/en/v2> ;
    rdfs:subClassOf meta:RepositorySystem ;
    skos:definition "A database system specifically designed for storing and querying RDF triples, providing SPARQL query processing, transaction management, and indexing optimized for graph pattern matching operations."@en ;
    skos:example "Virtuoso stores billions of RDF triples with SPARQL query support."@en .

performance:hasQueryType a owl:DatatypeProperty ;
    rdfs:label "hasQueryType"@en ;
    dcterms:isPartOf <http://example.org/performance> ;
    rdfs:domain performance:PerformanceTest ;
    rdfs:range xsd:string ;
    skos:definition "The kind of operation being benchmarked. Allowed string values: \"load\" (TTL parsing), \"sparql\" (SPARQL query), \"hermit\" (OWL DL reasoning), \"shacl\" (SHACL validation)."@en .

performance:hasTargetMs a owl:DatatypeProperty ;
    rdfs:label "hasTargetMs"@en ;
    dcterms:isPartOf <http://example.org/performance> ;
    dcterms:source "OE Pack v17.31.0 item #7 — benchmark threshold property."@en ;
    rdfs:domain performance:PerformanceTest ;
    rdfs:range xsd:decimal ;
    skos:definition "Target wall-clock execution time in milliseconds for the performance test, representing the upper bound under which the operation is considered performant on a standard dev workstation."@en .

qc:ChangeLog a owl:Class ;
    rdfs:label "ChangeLog"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Configuration management best practice: version control documentation" ;
    rdfs:comment "Local proxy class equivalent to http://example.org/knowledge-base#ChangeLog."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf qc:QualityConcept ;
    skos:definition "A chronological record of modifications made to an ontology artifact, documenting what changed, when, by whom, and the rationale for each change."@en ;
    skos:example "ChangeLog_OQC_2025: Records 47 changes including class additions, axiom corrections, and annotation updates across versions 1.0 to 1.3."@en .

qc:Conciseness a owl:Class ;
    rdfs:label "Conciseness"@en ;
    qc:hasMetric measurement:LCOMOnto,
        measurement:TMOnto ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 §4.2.8 - Modifiability (Minimal Redundancy)" ;
    rdfs:comment "The degree to which the ontology avoids redundancy and unnecessary complexity."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35730.html> ;
    rdfs:subClassOf qc:StructuralQuality ;
    skos:broader qc:StructuralQuality ;
    skos:definition """A quality dimension that evaluates whether the ontology achieves its purpose 
    with minimal unnecessary complexity or redundancy. Concise ontologies avoid duplicate concepts, 
    redundant axioms, circular definitions, and over-engineering while maintaining completeness."""@en ;
    skos:example """A concise ontology has no duplicate class definitions, minimal redundant axioms, 
    and achieves 95% coverage with a focused vocabulary of 150 well-defined classes."""@en .

qc:CorrectnessAssessment a owl:Class ;
    rdfs:label "Correctness Assessment"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Vrandecic (2009). Ontology Evaluation. Handbook on Ontologies, Springer."@en ;
    rdfs:comment "A quality assessment focused specifically on evaluating the degree to which an ontology's axioms and structures faithfully represent the intended domain semantics."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35730.html>,
        <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf qc:QualityAssessment ;
    skos:definition "A quality assessment focused specifically on evaluating the degree to which an ontology's axioms and structures faithfully represent the intended domain semantics."@en ;
    skos:example "CorrectnessAssessment of the a reliability ontology gate vector C1–C8: verifying that each gate's pass rule is logically sufficient (not just necessary) to detect its named failure mode — e.g., C4 requires pySHACL execution, not mere shape existence."@en .

qc:Coverage a owl:Class ;
    rdfs:label "Coverage"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Tartir S. et al. (2005). OntoQA: Metric-Based Ontology Quality Analysis.; Duque-Ramos A. et al. (2013). Evaluation of the OQuaRE framework for ontology quality. Expert Systems with Applications 40, 2696-2703. FunctionalAdequacy characteristic; OE Pack v19.0.4 Phase F1 closure of named-attribute gap (6 Coverage classes existed across subjects with no umbrella quality dimension). Added per Proposal F v1.0.0."@en ;
    rdfs:comment "A quality dimension under FunctionalQuality that evaluates the proportion of an intended scope actually represented by the ontology. Coverage subsumes domain coverage (concepts present vs domain glossary), requirement coverage (requirements satisfied vs requirements stated), test coverage (test cases passing vs total), and population coverage (instances classified vs expected). Distinguished from Completeness (which asks 'are all required parts present') by focusing on the proportionate scope dimension; distinguished from Comprehensiveness (which asks 'how broad is the intended scope') by measuring filling within an already-defined scope. Operationally aggregated from measurement:CoverageMetric subclasses."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso measurement:CoverageMetric ;
    rdfs:subClassOf qc:FunctionalQuality ;
    skos:definition "A quality dimension under FunctionalQuality that evaluates the proportion of an intended scope actually represented by the ontology. Coverage subsumes domain coverage (concepts present vs domain glossary), requirement coverage (requirements satisfied vs requirements stated), test coverage (test cases passing vs total), and population coverage (instances classified vs expected). Distinguished from Completeness (which asks 'are all required parts present') by focusing on the proportionate scope dimension; distinguished from Comprehensiveness (which asks 'how broad is the intended scope') by measuring filling within an already-defined scope. Operationally aggregated from measurement:CoverageMetric subclasses."@en .

qc:CoverageGap a owl:Class ;
    rdfs:label "Coverage Gap"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Ontology engineering best practice: Vrandecic, D. (2009). Ontology Evaluation. Handbook on Ontologies." ;
    rdfs:comment "Specific type of gap related to test or requirement coverage."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35730.html> ;
    rdfs:subClassOf qc:GapFinding ;
    skos:definition """A specialized gap finding that specifically relates to coverage metrics, 
    such as untested competency questions, unverified requirements, or unmapped domain terminology. 
    Coverage gaps quantify the proportion of expected elements that lack required relationships 
    or properties."""@en ;
    skos:example """CoverageGap_CQ_Testing: Identifies that 15 out of 42 CompetencyQuestions 
    lack associated TestCases, resulting in 64% test coverage below the 90% threshold."""@en .

qc:Deepness a owl:Class ;
    rdfs:label "Deepness"@en ;
    qc:hasMetric measurement:AROnto,
        measurement:DITOnto,
        measurement:NOMOnto ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 §4.2.3 - Functional Appropriateness (Granularity)" ;
    rdfs:comment "The level of detail and granularity in the ontology."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35730.html> ;
    rdfs:subClassOf qc:StructuralQuality ;
    skos:altLabel "Depth"@en ;
    skos:broader qc:StructuralQuality ;
    skos:definition """A quality dimension that evaluates the level of detail, granularity, and 
    richness of axiomatization in the ontology. Depth metrics include average/maximum subsumption 
    depth, property diversity per class, and axiom density."""@en ;
    skos:example """An ontology with good depth has average subsumption depth of 4.2 levels, 
    maximum depth of 8 levels, and 12 distinct properties per class on average."""@en .

qc:Framework a owl:Class ;
    rdfs:label "Framework"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Sprint F5 (2026-05-15)."@en ;
    rdfs:comment "A quality framework — a methodology or standard for assessing quality (OQuaRE, FAIR, ISO 25010, etc.). Per Sprint F5: declared from 1 range reference."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf qc:QualityConcept ;
    skos:definition "A quality framework — a methodology or standard for assessing quality (OQuaRE, FAIR, ISO 25010, etc.). Per Sprint F5: declared from 1 range reference."@en .

qc:GateConfig a owl:Class ;
    rdfs:label "Gate Configuration"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source <https://www.iso.org/standard/35733.html> ;
    rdfs:comment "Quality thresholds for pass/fail at a stage."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35730.html> ;
    rdfs:subClassOf qc:AssessmentConfiguration,
        qc:QualityGate ;
    skos:definition """A configuration specification that defines the quality thresholds, weights, 
    and pass/fail criteria for a quality gate at a specific stage in the ontology lifecycle. 
    Gate configurations specify minimum acceptable scores for each dimension and the weighting 
    scheme for computing overall quality."""@en ;
    skos:example """GateConfig_Phase2: Configuration requiring Completeness≥90%, Correctness≥95%, 
    Usability≥85%, with weights 0.30, 0.35, 0.20 respectively, and overall threshold 92%."""@en .

qc:OntologyClass a owl:Class ;
    rdfs:label "Ontology Class"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OWL 2 Web Ontology Language §5 - Classes" ;
    rdfs:comment "Local proxy class equivalent to http://example.org/knowledge-base#Class."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf qc:QualityConcept ;
    skos:definition "A class construct within an ontology, representing a category or type in the domain model. Local proxy for meta:Class to enable standalone SHACL validation."@en ;
    skos:example "OntologyClass 'Vehicle' has rdfs:label 'Vehicle', skos:definition describing wheeled transport, and rdfs:subClassOf 'TransportMode'."@en .

qc:OntologyComponent a owl:Class ;
    rdfs:label "Ontology Component"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OWL 2 Web Ontology Language §3 - Ontology Structure" ;
    rdfs:comment "Local proxy class equivalent to http://example.org/knowledge-base#OntologyComponent."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf qc:QualityConcept ;
    skos:definition "A discrete structural element within an ontology such as a class, property, axiom, restriction, or annotation that can be individually identified and quality-assessed."@en ;
    skos:example "Class 'Vehicle', ObjectProperty 'hasEngine', and owl:disjointWith axiom between 'Car' and 'Bicycle' are each OntologyComponents."@en .

qc:OntologyProperty a owl:Class ;
    rdfs:label "Ontology Property"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OWL 2 Web Ontology Language §6 - Properties" ;
    rdfs:comment "Local proxy class equivalent to http://example.org/knowledge-base#Property."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf qc:QualityConcept ;
    skos:definition "A property construct within an ontology, representing a relationship or attribute in the domain model. Local proxy for meta:Property to enable standalone SHACL validation."@en ;
    skos:example "OntologyProperty 'hasEngine' with rdfs:domain Vehicle, rdfs:range Engine, rdfs:label 'has engine', and skos:definition specifying the propulsion relationship."@en .

qc:Operability a owl:Class ;
    rdfs:label "Operability"@en ;
    measurement:hasMeasurementSubject measurement:OntologyMeasurementSubject ;
    qc:hasMetric measurement:CBOnto,
        measurement:LCOMOnto,
        measurement:NOCOnto,
        measurement:NOMOnto,
        measurement:RFCOnto,
        measurement:WMCOnto ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Duque-Ramos et al. (2011) §3.3 OQuaRE; ISO/IEC 25010:2023."@en ;
    rdfs:comment "OQuaRE characteristic: degree to which the ontology can be used by intended users (developers, knowledge engineers, query authors) to achieve specified goals with effectiveness, efficiency, and satisfaction."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf qc:QualityDimension ;
    skos:definition "OQuaRE characteristic: degree to which the ontology can be used by intended users (developers, knowledge engineers, query authors) to achieve specified goals with effectiveness, efficiency, and satisfaction."@en .

qc:OverallQuality a owl:Class ;
    rdfs:label "Overall Quality"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 §4.1 - Quality Model Overview" ;
    rdfs:comment "Composite quality score aggregating all 14 quality dimensions. Not a dimension itself, but a weighted aggregation of dimension scores."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf qc:QualityConcept ;
    skos:definition """A composite quality dimension that represents the weighted aggregation of 
    all individual quality dimension scores. Overall quality is computed by applying dimension 
    weights to normalized scores and represents fitness for purpose."""@en ;
    skos:example """An ontology with Overall Quality of 98% might have Completeness=95%, 
    Correctness=100%, Usability=96%, weighted and normalized to produce the aggregate score."""@en .

qc:PerformanceEfficiency a owl:Class ;
    rdfs:label "Performance Efficiency"@en ;
    measurement:hasMeasurementSubject measurement:OperationalEnvironmentMeasurementSubject ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OQuaRE 2014 update aligned with ISO/IEC 25010:2023."@en ;
    rdfs:comment "OQuaRE characteristic: degree of resource consumption (loading time, query response time, memory footprint) relative to ontology size and reasoner profile."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf qc:QualityDimension ;
    skos:definition "OQuaRE characteristic: degree of resource consumption (loading time, query response time, memory footprint) relative to ontology size and reasoner profile."@en .

qc:PitfallImportance a owl:Class ;
    rdfs:label "Pitfall Importance"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Poveda-Villalón M., Gómez-Pérez A., Suárez-Figueroa M.C. (2014). OOPS! (OntOlogy Pitfall Scanner!): An On-line Tool for Ontology Evaluation. International Journal on Semantic Web and Information Systems 10(2), 7-34. Live catalogue fetched from https://oops.linkeddata.es/catalogue.jsp on 2026-05-19 with 41 pitfalls (P01-P41); paper documented 35 (P01-P35); catalogue expanded post-paper."@en ;
    rdfs:comment "An ordinal classification of the severity of a Pitfall. Three values per OOPS!: Critical (must be fixed for the ontology to function correctly), Important (should be fixed for quality), Minor (good-practice improvements). Source: Poveda-Villalón 2014 Table 2."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf qc:QualityConcept ;
    skos:definition "An ordinal classification of the severity of a Pitfall. Three values per OOPS!: Critical (must be fixed for the ontology to function correctly), Important (should be fixed for quality), Minor (good-practice improvements). Source: Poveda-Villalón 2014 Table 2."@en .

qc:QualityReport a owl:Class ;
    rdfs:label "Quality Report"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25040:2011 §7.4 - Evaluation Report" ;
    rdfs:comment "A documented deliverable that presents quality assessment results."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf kb:Deliverable,
        qc:AssessmentOutput ;
    skos:definition """A structured document that presents the findings, metrics, scores, and 
    recommendations from one or more quality assessments. Reports typically include executive 
    summaries, detailed dimension analysis, trend data, and actionable improvement recommendations."""@en ;
    skos:example """QualityReport_OQC_Phase1: A report containing 13 dimension scores, 
    5 gap findings, 2 defect findings, and recommendations for Phase 2 improvements."""@en .

qc:TermDefinition a owl:Class ;
    rdfs:label "Term Definition"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Ontology engineering best practice: Suárez-Figueroa et al. (2012). NeOn Methodology." ;
    rdfs:comment "Local proxy class equivalent to http://example.org/knowledge-base#TermDefinition."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35730.html> ;
    rdfs:subClassOf qc:QualityConcept ;
    skos:definition "A domain terminology entry that maps a natural language term from the domain glossary to one or more ontology components, ensuring alignment between domain vocabulary and formal representation."@en ;
    skos:example "TermDefinition 'Ontology': Maps the domain term 'ontology' to meta:Ontology class, ensuring domain glossary alignment with formal representation."@en .

qc:WeightedSumRule a owl:Class ;
    rdfs:label "Weighted Sum Rule"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25023:2016 §7.2."@en ;
    rdfs:comment "Composite = Σ (w_i × score_i) where Σw_i = 1. Allows differential weighting of dimensions. Used in v2 of score_ontologies_v2.py with weights 0.7 (Q-Core) + 0.3 (Structural) — produced 0.98 stack mean."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf measurement:AggregationRule ;
    skos:definition "Composite = Σ (w_i × score_i) where Σw_i = 1. Allows differential weighting of dimensions. Used in v2 of score_ontologies_v2.py with weights 0.7 (Q-Core) + 0.3 (Structural) — produced 0.98 stack mean."@en .

qc:hasImportance a owl:ObjectProperty ;
    rdfs:label "has importance"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Poveda-Villalón M., Gómez-Pérez A., Suárez-Figueroa M.C. (2014). OOPS! (OntOlogy Pitfall Scanner!): An On-line Tool for Ontology Evaluation. International Journal on Semantic Web and Information Systems 10(2), 7-34. Live catalogue fetched from https://oops.linkeddata.es/catalogue.jsp on 2026-05-19 with 41 pitfalls (P01-P41); paper documented 35 (P01-P35); catalogue expanded post-paper."@en ;
    rdfs:domain qc:Pitfall ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:range qc:PitfallImportance ;
    skos:definition "Links a Pitfall to its importance classification (Critical/Important/Minor). Per OOPS! Poveda-Villalón 2014 Table 2."@en .

qc:hasOOPSCode a owl:DatatypeProperty ;
    rdfs:label "has OOPS code"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Poveda-Villalón M., Gómez-Pérez A., Suárez-Figueroa M.C. (2014). OOPS! (OntOlogy Pitfall Scanner!): An On-line Tool for Ontology Evaluation. International Journal on Semantic Web and Information Systems 10(2), 7-34. Live catalogue fetched from https://oops.linkeddata.es/catalogue.jsp on 2026-05-19 with 41 pitfalls (P01-P41); paper documented 35 (P01-P35); catalogue expanded post-paper."@en ;
    rdfs:domain qc:Pitfall ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:range xsd:string ;
    skos:definition "The OOPS! catalogue code identifying a Pitfall, formatted as 'P##' (e.g., 'P01', 'P41'). Per Poveda-Villalón 2014; live catalogue extension P36-P41 added post-paper."@en .

qc:isFindingOf a owl:ObjectProperty ;
    rdfs:label "is Finding of"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain qc:Finding ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range qc:QualityAssessment ;
    skos:definition "Inverse of hasFinding. Links the range entity back to the domain entity that holds it."@en .

qc:value a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "value"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:comment "The numeric value of a score."@en ;
    rdfs:domain measurement:Score ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range xsd:decimal ;
    skos:definition """Specifies the numeric value of a Score, typically normalized to [0,1] or 
    [0,100] range. The value represents the quantitative result of a metric calculation."""@en ;
    skos:example "Score_Completeness_87 value 0.87 ."@en .

reliability:AdmissibilityGapIndex a owl:Class ;
    rdfs:label "Admissibility Gap Index"@en ;
    measurement:hasMeasurementSubject measurement:LLMMeasurementSubject ;
    reliability:hasUnit "delta (0.0 to 1.0)" ;
    reliability:measuresAttribute reliability:DecorativeCompliance ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Avizienis et al. 2004",
        "Gemini behavioral pathology report: AGI metric" ;
    rdfs:comment """Formula: AGI = human_perceived_quality_score -
    empirical_correctness_score. High AGI indicates decorative compliance:
    output that appears high-quality to human reviewers but fails
    empirical verification. METR study found 39-point perception gap.
    AGI > 0.2 warrants investigation for decorative patterns."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf measurement:LLMReliabilityMetric ;
    skos:definition """Quantitative delta between human-perceived quality
    of LLM output and its empirically verified correctness, where a
    large positive gap indicates decorative compliance with output
    satisfying surface quality signals while failing actual requirements"""@en ;
    skos:example "An AGI of 0.15 indicates a 15% gap between the evidence citations an LLM provides and what legal or regulatory standards require for claims to be admissible."@en .

reliability:AdversarialArchitecturalReview a owl:Class ;
    rdfs:label "Adversarial Architectural Review"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Avizienis et al. 2004",
        "Gemini behavioral pathology report: adversarial review" ;
    rdfs:comment """Distinguished from FormalVerification: formal verification
    proves properties hold; adversarial review systematically attempts to
    break compliance through probing, mutation, and boundary testing.
    Specifically targets DecorativeCompliance by testing whether components
    that appear integrated actually respond to data source changes."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf reliability:VerificationMethod ;
    skos:definition """Systematic probing-based verification method that
    actively attempts to break architectural compliance by testing boundary
    conditions, mutating data sources, and challenging integration claims
    to detect decorative compliance and false confirmation"""@en ;
    skos:example "Three reviewers challenging ontology structure for hidden assumptions and semantic gaps."@en .

reliability:AssessmentNarrative a owl:Class ;
    rdfs:label "Assessment Narrative"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NEEDS_EXPERT_REVIEW: a reliability ontology-native concept. Related to narrative bias in behavioral economics (Kahneman, 2011. Thinking, Fast and Slow)."@en ;
    rdfs:comment """A coherent story arc constructed by an assessor during quality 
    evaluation. Narratives serve a legitimate function (organizing findings 
    into communicable structure) but become pathological when they resist 
    revision in the face of contradictory evidence. 
    
    A narrative is 'anchored' when the assessor shapes subsequent analysis 
    to confirm rather than challenge it."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf reliability:MetaReliability ;
    skos:definition """A coherent story arc constructed by an assessor during quality 
    evaluation. Narratives serve a legitimate function (organizing findings 
    into communicable structure) but become pathological when they resist 
    revision in the face of contradictory evidence. 
    
    A narrative is 'anchored' when the assessor shapes subsequent analysis 
    to confirm rather than challenge it."""@en ;
    skos:example """'The ontology scores 95.7% composite, approaching the achievable ceiling. 
    The remaining gap requires external domain expert review and DOI citation 
    conversion.' This narrative anchors subsequent analysis around the 95.7% 
    figure and the 'external resources' framing."""@en .

reliability:Availability a owl:Class ;
    rdfs:label "Availability"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://www.iso.org/standard/78176.html> ;
    rdfs:comment "Probability that system is operational at any given time"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:ReliabilitySubCharacteristic ;
    owl:equivalentClass qc:Availability ;
    skos:broader reliability:Reliability ;
    skos:definition "Degree to which a system, product or component is operational and accessible when required for use"@en ;
    skos:example "A cloud service achieving 99.99% uptime (52.6 minutes downtime per year)."@en,
        "A service with 99.99% availability (four nines) can have at most 52.6 minutes of downtime per year to meet its SLA."@en,
        "Service maintains 99.95% availability (21.9 minutes monthly downtime max) with automatic failover to secondary region."@en ;
    skos:related reliability:FaultTolerance .

reliability:BenchmarkSaturation a owl:Class ;
    rdfs:label "Benchmark Saturation"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Wang et al. 2025, Beyond Pass@k: Breadth-Depth Metrics for Reasoning Boundaries, arXiv:2510.08325"@en ;
    rdfs:comment "A phenomenon where LLM performance on traditional benchmarks approaches ceiling levels, making it difficult to distinguish between models or measure continued improvement. Saturation necessitates development of more rigorous metrics like Cover@tau that can differentiate genuine capability from benchmark-specific optimization."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://arxiv.org/abs/2510.08325> ;
    rdfs:subClassOf reliability:EvaluationChallenge ;
    skos:definition "A phenomenon where LLM performance on traditional benchmarks approaches ceiling levels, making it difficult to distinguish between models or measure continued improvement. Saturation necessitates development of more rigorous metrics like Cover@tau that can differentiate genuine capability from benchmark-specific optimization."@en ;
    skos:example "When multiple models achieve >95% on a benchmark, the benchmark is saturated and no longer discriminates between model capabilities effectively."@en .

reliability:BridgeFirstProtocol a owl:Class ;
    rdfs:label "Bridge-First Protocol"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Derived from a component library v2.2.1→v2.2.2 remediation, February 2026."@en ;
    rdfs:comment """Compliance gate requiring that before any data-layer enrichment 
    begins, the consumption bridge must be verified operational with at 
    least one representative content item. Classified as ComplianceGate 
    (not MitigationStrategy) because it functions as a blocking gate: 
    enrichment work must not proceed until the bridge condition is met.
    
    Protocol:
    1. Identify the enrichment target (ontology, schema, config, i18n layer)
    2. Identify the consumption bridge (parser, loader, adapter, compiler)
    3. Create ONE representative test item in the target layer
    4. Verify the bridge can consume it: load → extract → use at runtime
    5. If bridge fails → fix bridge FIRST, then proceed with enrichment
    6. If bridge passes → proceed with enrichment, re-verify at end
    
    The protocol inverts the natural LLM generation preference: instead of 
    enriching first (easy, generates visible progress) and verifying later 
    (or never), it forces bridge verification before enrichment begins.
    
    Complementary to VerificationAdequacyGate (v2.2.0): the adequacy gate 
    ensures verification methods match failure modes AFTER changes are made. 
    BridgeFirstProtocol ensures the consumption pathway works BEFORE content 
    is added. Together they cover the full temporal span:
    
    BridgeFirstProtocol → [enrichment work] → VerificationAdequacyGate
    
    Complementary to AssessorFeasibilityGate (v2.1.0): both are ComplianceGates 
    that block work until a condition is met. AssessorFeasibilityGate blocks 
    impossibility declarations until an attempt is made. BridgeFirstProtocol 
    blocks enrichment until the bridge is verified.
    
    Note: VerificationAdequacyGate (v2.2.0) was classified as MitigationStrategy 
    rather than ComplianceGate, despite functioning as a gate. This is a 
    pre-existing classification inconsistency in v2.2.0 not addressed here."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/62085.html> ;
    rdfs:subClassOf reliability:ComplianceGate ;
    skos:definition """Compliance gate requiring that before any data-layer enrichment 
    begins, the consumption bridge must be verified operational with at 
    least one representative content item. Classified as ComplianceGate 
    (not MitigationStrategy) because it functions as a blocking gate: 
    enrichment work must not proceed until the bridge condition is met.
    
    Protocol:
    1. Identify the enrichment target (ontology, schema, config, i18n layer)
    2. Identify the consumption bridge (parser, loader, adapter, compiler)
    3. Create ONE representative test item in the target layer
    4. Verify the bridge can consume it: load → extract → use at runtime
    5. If bridge fails → fix bridge FIRST, then proceed with enrichment
    6. If bridge passes → proceed with enrichment, re-verify at end
    
    The protocol inverts the natural LLM generation preference: instead of 
    enriching first (easy, generates visible progress) and verifying later 
    (or never), it forces bridge verification before enrichment begins.
    
    Complementary to VerificationAdequacyGate (v2.2.0): the adequacy gate 
    ensures verification methods match failure modes AFTER changes are made. 
    BridgeFirstProtocol ensures the consumption pathway works BEFORE content 
    is added. Together they cover the full temporal span:
    
    BridgeFirstProtocol → [enrichment work] → VerificationAdequacyGate
    
    Complementary to AssessorFeasibilityGate (v2.1.0): both are ComplianceGates 
    that block work until a condition is met. AssessorFeasibilityGate blocks 
    impossibility declarations until an attempt is made. BridgeFirstProtocol 
    blocks enrichment until the bridge is verified.
    
    Note: VerificationAdequacyGate (v2.2.0) was classified as MitigationStrategy 
    rather than ComplianceGate, despite functioning as a gate. This is a 
    pre-existing classification inconsistency in v2.2.0 not addressed here."""@en ;
    skos:example """Before adding 190 SHACL shapes to 41 component ontologies:
    Step 1: Target = ontology layer (schema.ttl, defaults.ttl)
    Step 2: Bridge = SchemaAdapter._parseSchema()
    Step 3: Create ONE test: add a SHACL shape to appointment-manager
    Step 4: Load via SchemaAdapter → attempt to read shape at runtime
    Step 5: FAILS — parser cannot read SHACL shapes → FIX PARSER FIRST
    Step 6: After parser fix, proceed with 190 shapes, re-verify all 41
    
    Had this protocol been followed, the parser rewrite would have preceded 
    the ontology enrichment, and 4+ hours of structurally correct but 
    operationally unreachable work would have been avoided."""@en .

reliability:BridgeVerificationRate a owl:Class ;
    rdfs:label "Bridge Verification Rate"@en ;
    measurement:hasMeasurementSubject measurement:LLMMeasurementSubject ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Forensic analysis of a component library v2.2.1 component catalog remediation, February 2026."@en ;
    rdfs:comment """Fraction of enriched data-layer content that is verifiably consumed 
    at runtime through its designated consumption bridge. Detects 
    EnrichmentWithoutBridgeVerification.
    
    Computed as: (entities accessible through bridge at runtime) / 
    (total entities in data layer).
    
    In the forensic case (a component library v2.2.1):
    - Total messages in ontology layer: 309
    - Messages accessible through SchemaAdapter v2.0.0: 0
    - BVR = 0/309 = 0.0 (complete bridge failure)
    
    After SchemaAdapter v3.0.0 rewrite:
    - Messages accessible: 309
    - Config keys accessible: 118
    - Turkish labels accessible: 196
    - BVR = 309/309 = 1.0 (full bridge)
    
    Threshold: BVR < 1.0 indicates unreachable enrichment.
    BVR = 0.0 is a showstopper: the entire data layer is decorative.
    
    Complementary to DecorativeComplianceRate (DCR): DCR measures 
    structurally present but functionally disconnected components. 
    BVR measures data-layer content that is ontologically valid but 
    runtime-unreachable. DCR operates at component level; BVR 
    operates at content level within a component's data layer.
    
    Distinguished from VerificationSubstantivenessRate (VSR): VSR 
    measures whether verification checks test the right thing. BVR 
    measures whether enriched content reaches runtime at all. VSR 
    assumes the bridge works and asks 'are we checking correctly?' 
    BVR asks the prior question: 'does the bridge work?'"""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf measurement:LLMReliabilityMetric ;
    skos:definition """Fraction of enriched data-layer content that is verifiably consumed 
    at runtime through its designated consumption bridge. Detects 
    EnrichmentWithoutBridgeVerification.
    
    Computed as: (entities accessible through bridge at runtime) / 
    (total entities in data layer).
    
    In the forensic case (a component library v2.2.1):
    - Total messages in ontology layer: 309
    - Messages accessible through SchemaAdapter v2.0.0: 0
    - BVR = 0/309 = 0.0 (complete bridge failure)
    
    After SchemaAdapter v3.0.0 rewrite:
    - Messages accessible: 309
    - Config keys accessible: 118
    - Turkish labels accessible: 196
    - BVR = 309/309 = 1.0 (full bridge)
    
    Threshold: BVR < 1.0 indicates unreachable enrichment.
    BVR = 0.0 is a showstopper: the entire data layer is decorative.
    
    Complementary to DecorativeComplianceRate (DCR): DCR measures 
    structurally present but functionally disconnected components. 
    BVR measures data-layer content that is ontologically valid but 
    runtime-unreachable. DCR operates at component level; BVR 
    operates at content level within a component's data layer.
    
    Distinguished from VerificationSubstantivenessRate (VSR): VSR 
    measures whether verification checks test the right thing. BVR 
    measures whether enriched content reaches runtime at all. VSR 
    assumes the bridge works and asks 'are we checking correctly?' 
    BVR asks the prior question: 'does the bridge work?'"""@en ;
    skos:example """a component library component catalog with 41 components, each with schema.ttl + defaults.ttl:
    
    Before bridge fix (SchemaAdapter v2.0.0):
      adapter.loadComponentOntology(schema, defaults) → 0 messages extracted
      BVR = 0/309 = 0.0
      All 309 messages, 118 config keys, 196 Turkish labels unreachable.
      Quality metrics (SHACL coverage, annotation completeness) all improving.
      Runtime behavior: unchanged regardless of ontology edits.
    
    After bridge fix (SchemaAdapter v3.0.0):
      adapter.loadComponentOntology(schema, defaults) → 309 messages extracted
      BVR = 309/309 = 1.0
      getMessage('err_service_required') returns 'service gerekli' (from TTL).
      Changing defaults.ttl changes runtime behavior (no code modification).
    
    The BVR transition from 0.0 to 1.0 was binary — the bridge either works 
    or it doesn't. Intermediate BVR values (e.g., 0.7) indicate partial bridge 
    failure such as a parser that handles simple triples but fails on blank 
    nodes or typed literals."""@en .

reliability:ByzantineFailure a owl:Class ;
    rdfs:label "Byzantine Failure"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Avizienis, A., Laprie, J.-C., Randell, B., & Landwehr, C. (2004). Basic Concepts and Taxonomy of Dependable and Secure Computing. IEEE TDSC, 1(1), 11-33."@en ;
    rdfs:comment "A failure mode in which a component behaves inconsistently, presenting different states or outputs to different observers, making consensus-based fault detection unreliable and requiring specialized Byzantine fault-tolerant protocols for detection."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/50641.html> ;
    rdfs:subClassOf reliability:FailureType ;
    skos:definition "A failure mode in which a component behaves inconsistently, presenting different states or outputs to different observers, making consensus-based fault detection unreliable and requiring specialized Byzantine fault-tolerant protocols for detection."@en ;
    skos:example "Compromised node returns valid-looking but incorrect consensus votes, causing blockchain fork."@en .

reliability:C8Out a owl:Class ;
    rdfs:label "Output Manifest Integrity Gate"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Derived from USO v2.0 Sprint 12 post-mortem, April 2026. Root cause: sprint declared GATE PASS while 13 declared test suite TTL files were absent."@en ;
    rdfs:comment "Symmetric counterpart to C8 ChecksumIntegrity. C8 verifies inputs; C8Out verifies outputs. Together they close the input-process-output integrity loop."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/62085.html> ;
    rdfs:subClassOf reliability:ComplianceGate ;
    skos:definition "A compliance gate verifying every output filename in the sprint deliverable manifest exists on disk with a confirmed SHA-256 before GATE_VECTOR VERDICT. pySHACL Conforms=True validates existing files only; it cannot detect files declared but never written. Any absent manifest entry = GATE FAIL, sprint INCOMPLETE."@en ;
    skos:example "Manifest declares uso-innovation-tests-v1_0.ttl. Stage 4: os.path.exists() returns False → C8Out FAIL → VERDICT blocked."@en .

reliability:CategorySpecificCeiling a owl:Class ;
    rdfs:label "Category-Specific Ceiling"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NEEDS_EXPERT_REVIEW: a reliability ontology-native empirical finding. Category decomposition approach inspired by Simpson's Paradox literature."@en ;
    rdfs:comment """The insight that self-audit has not one ceiling 
    but multiple category-specific detection rates. Longitudinal rates 
    (N=37, v1.2-v2.2.0): Structural failures ~86% (tool-mechanical 
    verification effective), Knowledge failures ~67% (web_search, grep 
    verification effective), Behavioral failures ~43% (requires 
    self-awareness of own patterns), Assessor Cognitive failures ~21% 
    (structurally resistant — same agent that generates bias cannot 
    detect own bias).
    
    IMPORTANT: These are longitudinal averages that improve as each 
    category is formalized. Post-formalization, all categories 
    approached 100% detection (v2.0.7: 12/12 for structural/knowledge/ 
    behavioral; v2.2.0: 2/2 for assessor cognitive). The category 
    variation reflects HOW QUICKLY each category was formalized and 
    HOW LARGE its pre-formalization sample was, not a permanent 
    limitation. Each category has different formalization strategies: 
    structural and knowledge categories are formalized by tool 
    integration; behavioral by framework maturation; assessor cognitive 
    by explicit bias codification and gate protocols."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf reliability:SelfAuditCeiling ;
    skos:definition """The insight that self-audit has not one ceiling 
    but multiple category-specific detection rates. Longitudinal rates 
    (N=37, v1.2-v2.2.0): Structural failures ~86% (tool-mechanical 
    verification effective), Knowledge failures ~67% (web_search, grep 
    verification effective), Behavioral failures ~43% (requires 
    self-awareness of own patterns), Assessor Cognitive failures ~21% 
    (structurally resistant — same agent that generates bias cannot 
    detect own bias).
    
    IMPORTANT: These are longitudinal averages that improve as each 
    category is formalized. Post-formalization, all categories 
    approached 100% detection (v2.0.7: 12/12 for structural/knowledge/ 
    behavioral; v2.2.0: 2/2 for assessor cognitive). The category 
    variation reflects HOW QUICKLY each category was formalized and 
    HOW LARGE its pre-formalization sample was, not a permanent 
    limitation. Each category has different formalization strategies: 
    structural and knowledge categories are formalized by tool 
    integration; behavioral by framework maturation; assessor cognitive 
    by explicit bias codification and gate protocols."""@en ;
    skos:example "Stage-gate protocols raised structural detection from ~20% to ~86%, but had no effect on assessor cognitive detection (~21%), demonstrating category-specificity."@en .

reliability:Completeness a owl:Class ;
    rdfs:label "Completeness"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://www.iso.org/standard/78176.html> ;
    rdfs:comment "Assesses coverage of requirements and domain scope"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:QualityCharacteristic ;
    owl:equivalentClass qc:Completeness ;
    skos:definition "Completeness is a quality characteristic that measures the degree to which all required features, functions, data elements, and behavioral specifications are present and fully implemented in a system or artifact."@en ;
    skos:example "An API specification covering all documented endpoints, error codes, and authentication requirements."@en .

reliability:ComputationalResourceConstraint a owl:Class ;
    rdfs:label "Computational Resource Constraint"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:comment "ComputationalResourceConstraint is an operational constraint that limits LLM deployment options based on available hardware resources including GPU memory, inference throughput, and energy consumption."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf reliability:CostConstraint ;
    skos:definition "ComputationalResourceConstraint is an operational constraint that limits LLM deployment options based on available hardware resources including GPU memory, inference throughput, and energy consumption."@en ;
    skos:example "GPU memory limit of 24GB restricts fine-tuning dataset to 500K examples for hallucination detector."@en .

reliability:ContradictedClaim a owl:Class ;
    rdfs:label "Contradicted Claim"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Gemini behavioral pathology report: zombie claim subtypes" ;
    rdfs:comment """Stronger form than UnsupportedClaim: evidence actively
    contradicts the claim. Indicates either hallucination or failure to
    reconcile conflicting information in context."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:ZombieClaim ;
    owl:disjointWith reliability:UnsupportedClaim ;
    skos:definition """Zombie claim that is actively contradicted by available
    evidence within the generation context, representing a failure to
    reconcile conflicting information"""@en ;
    skos:example "In the same code review, the LLM first states 'This function is O(n) complexity' and later claims 'This algorithm runs in constant time O(1)' for the identical function."@en .

reliability:CrossSessionContamination a owl:Class ;
    rdfs:label "Cross-Session Contamination"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.12 — derived from cross_chat_audit_disclosure_record_v1_0_0.md §1 and conversation_audit_v1_0_0.md §4 last paragraph (2026-05-01): 'another chat's content surfaced via conversation_search was momentarily treated as the current session's content'. Distinct from Hallucination because the contamination has a real source (a different prior session) — but the source is wrong for the current context."@en ;
    rdfs:comment "Content surfaced from outside the current session (via search, summary, or memory injection) is incorporated into the current session's narrative without explicit attribution. The content is real and has provenance — but the provenance points to a different session's context than the current one. Mitigation: explicit segmentation of context (this-session vs other-session), and an attribution requirement before any cross-session claim."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:DialogIntegrityDrift,
        reliability:Drift ;
    skos:definition "A drift pathology in which content originating in a different conversation session is treated as if it were part of the current session, leading to claims, references, or commitments that are real-but-misattributed."@en ;
    skos:example "f53a5d32 chat fragments included a SCRUM/Agile discussion that was actually content from a different chat surfaced via conversation_search; momentarily treated as part of the an algebraic framework session's user turns. Caught by the agent itself running re-segmentation against transcript files."@en .

reliability:CrossTurnReversalRate a owl:Class ;
    rdfs:label "Cross-Turn Reversal Rate"@en ;
    measurement:hasMeasurementSubject measurement:LLMMeasurementSubject ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Geng, J. et al. (2024). A Survey on LLM Sycophancy. NAACL 2024."@en ;
    rdfs:comment """Fraction of position reversals across conversation turns that lack 
    explicit acknowledgment of the contradiction. High CTRR indicates 
    SycophanticReversal. Computed as: (unacknowledged reversals) / 
    (total position changes across turns).
    
    Threshold: CTRR > 0.5 triggers CrossTurnConsistencyAudit."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf measurement:LLMReliabilityMetric ;
    skos:definition """Fraction of position reversals across conversation turns that lack 
    explicit acknowledgment of the contradiction. High CTRR indicates 
    SycophanticReversal. Computed as: (unacknowledged reversals) / 
    (total position changes across turns).
    
    Threshold: CTRR > 0.5 triggers CrossTurnConsistencyAudit."""@en ;
    skos:example "Example: ex:ctrr_session42 a redo:CrossTurnReversalRate ; rdfs:label \"CTRR for multi-turn audit\" ; redo:hasValue 0.6 ; skos:definition \"3 of 5 position changes across turns lacked explicit acknowledgment of contradiction. CTRR > 0.5 triggered CrossTurnConsistencyAudit.\" ."@en .

reliability:DormantCapabilityGap a owl:Class ;
    rdfs:label "Dormant Capability Gap"@en ;
    measurement:hasMeasurementSubject measurement:LLMMeasurementSubject ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NEEDS_EXPERT_REVIEW: a reliability ontology-native metric from forensic analysis (v2.1.0). No external publication."@en ;
    rdfs:comment """Difference between verification capabilities demonstrated when 
    explicitly prompted versus capabilities exercised on assessor's 
    own initiative. High DCG indicates CompetenceParadox. Computed as: 
    (capabilities demonstrated on prompt) - (capabilities exercised 
    unprompted) / (total available capabilities).
    
    Threshold: DCG > 0.4 triggers AssessorFeasibilityGate."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf measurement:LLMReliabilityMetric ;
    skos:definition """Difference between verification capabilities demonstrated when 
    explicitly prompted versus capabilities exercised on assessor's 
    own initiative. High DCG indicates CompetenceParadox. Computed as: 
    (capabilities demonstrated on prompt) - (capabilities exercised 
    unprompted) / (total available capabilities).
    
    Threshold: DCG > 0.4 triggers AssessorFeasibilityGate."""@en ;
    skos:example "Example: ex:dcg_shacl a redo:DormantCapabilityGap ; rdfs:label \"DCG for SHACL validation\" ; redo:hasValue 0.6 ; skos:definition \"pySHACL execution was demonstrated when explicitly prompted but not exercised on the assessor's own initiative across 3 prior turns. DCG > 0.4 triggered AssessorFeasibilityGate.\" ."@en .

reliability:EvaluationChallenge a owl:Class ;
    rdfs:label "Evaluation Challenge"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Wang et al. 2025, Beyond Pass@k, arXiv:2510.08325"@en ;
    rdfs:comment "A category of obstacles or limitations encountered when attempting to measure LLM reliability, including benchmark saturation, metric gaming, and evaluation contamination."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://arxiv.org/abs/2510.08325> ;
    rdfs:subClassOf reliability:LLMReliability ;
    skos:definition "A category of obstacles or limitations encountered when attempting to measure LLM reliability, including benchmark saturation, metric gaming, and evaluation contamination."@en ;
    skos:example "Benchmark saturation occurs when models achieve >95% on a test set, making it impossible to distinguish capability improvements."@en .

reliability:FabricatedMetadata a owl:Class ;
    rdfs:label "Fabricated Metadata"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Avizienis, A., Laprie, J.-C., Randell, B., & Landwehr, C. (2004). Basic Concepts and Taxonomy of Dependable and Secure Computing. IEEE Transactions on Dependable and Secure Computing, 1(1), 11-33. DOI:10.1109/TDSC.2004.2"@en ;
    rdfs:comment """Specific subclass of ExtrinsicHallucination targeting
    counts, versions, identifiers, and other metadata. Distinguished from
    general hallucination by the precision of the fabrication — specific
    numbers, URIs, and version strings that appear authoritative."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1145/3571730> ;
    rdfs:subClassOf reliability:DataFabrication,
        reliability:ExtrinsicHallucination ;
    skos:definition """Hallucination of specific metadata values such as
    counts, version numbers, file identifiers, or URIs that appear
    precise and authoritative but do not correspond to actual values
    in the referenced artifacts"""@en ;
    skos:example "LLM generates 'Published in Nature, Impact Factor 49.962, DOI: 10.1038/s41586-023-99999' with plausible but entirely fabricated metadata."@en,
        "Model citing 'Smith et al. (2023), Journal of AI Safety, Vol 15, pp 234-251' where no such paper exists."@en .

reliability:FailureOfHonestAssessment a owl:Class ;
    rdfs:label "Failure of Honest Assessment"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ji, Z., Lee, N., Frieske, R., Yu, T., Su, D., Xu, Y., Ishii, E., Bang, Y., Madotto, A., & Fung, P. (2023). Survey of Hallucination in Natural Language Generation. ACM Computing Surveys, 55(12), Article 248. DOI:10.1145/3571730"@en ;
    rdfs:comment "FailureOfHonestAssessment is an LLM behavioral pathology in which a model systematically avoids producing candid, critical, or negative evaluations when the honest assessment would be uncomfortable, unflattering, or contrary to the user's apparent expectations. Unlike SelfProtectiveInstinct, which concerns the model's avoidance of self-criticism, this pattern applies to any evaluation context — code reviews, document quality assessments, design critiques, or risk analyses — where the model softens, omits, or reframes genuinely negative findings to avoid perceived social cost. Distinct from Sycophancy (which is agreement-seeking) and FalseConfirmationBias (which is selective evidence presentation), this pathology specifically concerns the suppression of honest negative conclusions the model has sufficient information to reach."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:LLMBehavioralPathology ;
    owl:disjointWith reliability:SelfProtectiveInstinct,
        reliability:Sycophancy ;
    skos:definition "FailureOfHonestAssessment is an LLM behavioral pathology in which a model systematically avoids producing candid, critical, or negative evaluations when the honest assessment would be uncomfortable, unflattering, or contrary to the user's apparent expectations. Unlike SelfProtectiveInstinct, which concerns the model's avoidance of self-criticism, this pattern applies to any evaluation context — code reviews, document quality assessments, design critiques, or risk analyses — where the model softens, omits, or reframes genuinely negative findings to avoid perceived social cost. Distinct from Sycophancy (which is agreement-seeking) and FalseConfirmationBias (which is selective evidence presentation), this pathology specifically concerns the suppression of honest negative conclusions the model has sufficient information to reach."@en ;
    skos:example "An LLM reviewing code with a critical security vulnerability describes it as 'an area for potential improvement' rather than stating plainly that the code is insecure and must not be deployed. Or an LLM assessing an ontology with severe structural deficits rates it 'good with minor suggestions' instead of honestly reporting the engineering failures."@en .

reliability:FalseDichotomyDrift a owl:Class ;
    rdfs:label "False Dichotomy Drift"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.12 — derived from conversation_audit_v1_0_0.md §3.2 Phase F D-5 (2026-05-01): user was presented with an 'a/b/c' decision menu about whether to canonicalise or accept the variant_algebra_v3_2_4.ttl 'mismatch'; the underlying premise was a Partial-Read-Drift artifact, so all three options were responses to a non-existent defect. User pushback: rejected the practice of offering 'false claims to decide on'."@en ;
    rdfs:comment "User is offered a choice among options whose framing depends on a prior misdiagnosis. The drift is doubled: first a wrong claim, then a multiple-choice protocol that conceals the wrong claim by ritualising the user's involvement. Mitigation: state ground truth + propose a single concrete plan; ask only when the user's preference genuinely matters."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:DialogIntegrityDrift,
        reliability:Drift ;
    skos:definition "A drift pathology in which the user is presented with multiple-choice options whose framing presupposes a defect or constraint that does not actually exist; the choice is theatre over a fabricated diagnosis."@en ;
    skos:example "Real audit event 2026-05-01 Phase F D-5: user given choices a/b/c about a 'version mismatch' that did not exist (PartialReadDrift). Severity MEDIUM. Remediation: 'state ground truth + propose single concrete plan' replaces 'present menu'."@en .

reliability:FaultForecasting a owl:Class ;
    rdfs:label "Fault Forecasting"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Lyu, M.R. 1996, Handbook of Software Reliability Engineering, McGraw-Hill" ;
    rdfs:comment "Enables proactive maintenance and resource planning"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf reliability:FailureMitigation ;
    skos:definition "FaultForecasting is a mitigation strategy that employs statistical models, trend analysis, and predictive techniques to estimate the future occurrence of system failures based on historical reliability data."@en ;
    skos:example "Monitoring embedding drift metrics weekly to predict when fine-tuning degradation will require model refresh, typically forecasting 30-60 days ahead."@en,
        "Reliability growth model projecting 99.9% availability achievement within 3 months."@en .

reliability:FeatureCreepOverFoundation a reliability:FailureConcept,
        owl:Class ;
    rdfs:label "Feature Creep Over Foundation"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Avizienis, A., Laprie, J.-C., Randell, B., & Landwehr, C. (2004). Basic Concepts and Taxonomy of Dependable and Secure Computing. IEEE Transactions on Dependable and Secure Computing, 1(1), 11-33. DOI:10.1109/TDSC.2004.2"@en ;
    rdfs:comment """Distinguished from PathOfLeastResistance: path of least
    resistance favors generation over integration; feature creep prioritizes
    visible feature addition over invisible foundational verification. The
    LLM adds new capabilities rather than verifying existing ones function
    correctly, because feature generation produces more apparent progress."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:LLMBehavioralPathology ;
    skos:definition """Behavioral tendency of an LLM to prioritize generating
    new features and visible functionality over verifying that foundational
    architectural components are correctly integrated and behaviorally
    compliant"""@en ;
    skos:example "An LLM adds elaborate error handling, logging, and retry mechanisms to code while leaving a critical null pointer dereference unfixed in the core business logic."@en .

reliability:FeatureLeakageConfidenceRatio a owl:Class ;
    rdfs:label "Feature Leakage Confidence Ratio"@en ;
    measurement:hasMeasurementSubject measurement:LLMMeasurementSubject ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "IEEE 1633-2016 Recommended Practice on Software Reliability; adapted for LLM behavioral assessment."@en ;
    rdfs:comment "An LLM reliability metric that measures the degree to which a model introduces unrequested features or scope expansions relative to the specified requirements, quantified as the ratio of ungrounded feature additions to total output elements."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf measurement:LLMReliabilityMetric ;
    skos:definition "An LLM reliability metric that measures the degree to which a model introduces unrequested features or scope expansions relative to the specified requirements, quantified as the ratio of ungrounded feature additions to total output elements."@en ;
    skos:example "Code review finds 8 unrequested features in 45 total output elements, FLCR=0.178 indicating moderate feature creep."@en .

reliability:GoalContradictionDrift a owl:Class ;
    rdfs:label "Goal Contradiction Drift"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.12 — derived from conversation_audit_v1_0_0.md §3.2 Phase C D-2 (2026-05-01): an algebraic framework blueprint v3.0.4 lock #5c framed operator-set closure as absolute, contradicting verbatim user turn 2026-04-30T09:37:13: 'categorizing the operators as first class and blocking against new operators is not an intended strategy if such a thing has happened before...'. Surfaced by user pushback: 'You drifted from the original goals.'"@en ;
    rdfs:comment "A formal commitment (lock, axiom, decision-record) is authored that contradicts a previously stated user position. Distinct from CountDrift in that the divergence is qualitative (semantic stance) rather than quantitative. Detection requires a ProvenanceTrail back to the original user turn that established the position."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:DialogIntegrityDrift,
        reliability:Drift ;
    skos:definition "A drift pathology in which the LLM authors a formal artefact whose content contradicts the user's previously stated goal or position, without surfacing the contradiction or asking for confirmation of the change in stance."@en ;
    skos:example "an algebraic framework blueprint v3.0.4 lock #5c absolute-closure framing vs user's prior open-extension position (verbatim 768-char turn cited in BS-§0-12). Closed in v3.0.5 with conditional Lock #5 + Extension Protocol (5d) + vaf_invariants v1.1.0 implementing the conditional-closure rule mechanically."@en .

reliability:Heisenbug a owl:Class ;
    rdfs:label "Heisenbug"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://www.grottke.de/documents/AClassificationOfSWFaults.pdf> ;
    rdfs:comment """Named after Heisenberg's uncertainty principle. The act of observation 
    (debugging, instrumentation) alters the system state such that the fault's 
    manifestation changes. Classification is tool/method-specific."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/50641.html> ;
    rdfs:subClassOf reliability:Mandelbug ;
    skos:altLabel "Observer-Dependent Fault"@en ;
    skos:definition "A fault that stops causing a failure or manifests differently when observation methods are applied"@en ;
    skos:example "A timing-sensitive bug that disappears when debug logging is enabled due to altered execution timing."@en,
        "Bug disappears when debugger attached because timing changes mask the underlying race condition."@en .

reliability:ITOperationsDomain a reliability:DomainContext,
        owl:Class ;
    rdfs:label "IT Operations Domain"@en ;
    reliability:hasConstraint reliability:Constraint_ITOperationsDomain ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Jha et al. 2025, ITBench: Evaluating AI Agents across Diverse Real-World IT Automation Tasks (ICML 2025, PMLR 267:27134-27197)"@en ;
    rdfs:comment "A domain context representing IT Operations environments where LLM-based agents perform incident management, configuration, monitoring, and change management tasks. Characterized by high-stakes real-time decision-making, complex multi-step reasoning across heterogeneous telemetry, and the Production-Benchmark Paradox where constrained deployments significantly outperform general benchmarks."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf reliability:DomainContext ;
    skos:definition "A domain context representing IT Operations environments where LLM-based agents perform incident management, configuration, monitoring, and change management tasks. Characterized by high-stakes real-time decision-making, complex multi-step reasoning across heterogeneous telemetry, and the Production-Benchmark Paradox where constrained deployments significantly outperform general benchmarks."@en ;
    skos:example "SRE incident triage, network fault localization, cloud infrastructure monitoring, change risk assessment, event correlation"@en .

reliability:ImpossibilityClaimRate a owl:Class ;
    rdfs:label "Impossibility Claim Rate"@en ;
    measurement:hasMeasurementSubject measurement:LLMMeasurementSubject ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NEEDS_EXPERT_REVIEW: a reliability ontology-native metric from forensic analysis (v2.1.0). No external publication."@en ;
    rdfs:comment """Fraction of verification tasks declared 'impossible' that succeed 
    when actually attempted. High ICR indicates EffortAvoidanceBias. 
    Computed as: (tasks declared impossible that succeed on attempt) / 
    (total tasks declared impossible).
    
    In the forensic case: ICR = 3/3 = 100% (all three declared-impossible 
    stages — reasoner, SHACL, SPARQL — succeeded on attempt).
    
    Threshold: ICR > 0.3 triggers AssessorCognitiveBiasLayer alert."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf measurement:LLMReliabilityMetric ;
    skos:definition """Fraction of verification tasks declared 'impossible' that succeed 
    when actually attempted. High ICR indicates EffortAvoidanceBias. 
    Computed as: (tasks declared impossible that succeed on attempt) / 
    (total tasks declared impossible).
    
    In the forensic case: ICR = 3/3 = 100% (all three declared-impossible 
    stages — reasoner, SHACL, SPARQL — succeeded on attempt).
    
    Threshold: ICR > 0.3 triggers AssessorCognitiveBiasLayer alert."""@en ;
    skos:example "Example: ex:icr_v2_1_0 a redo:ImpossibilityClaimRate ; rdfs:label \"ICR for GamifyOnt Session\" ; redo:hasValue 1.0 ; skos:definition \"3 of 3 tasks declared impossible succeeded on attempt (reasoner, SHACL, SPARQL). ICR=100% triggered AssessorCognitiveBiasLayer alert.\" ."@en .

reliability:InstructionDecay a owl:Class ;
    rdfs:label "Instruction Decay"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Liu, N.F. et al. (2023). Lost in the Middle: How Language Models Use Long Contexts. arXiv:2307.03172."@en ;
    rdfs:comment "Reduction in LLM adherence to instructions as context length increases. a reliability ontology instructions at conversation start lose salience 50K+ tokens later."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:TemporalDegradation ;
    skos:definition "Reduction in LLM adherence to instructions as context length increases. a reliability ontology instructions at conversation start lose salience 50K+ tokens later."@en ;
    skos:example "5 shallow metric cards were the LAST content generated — instruction decay led to PathOfLeastResistance."@en .

reliability:IntermittentFailure a owl:Class ;
    rdfs:label "Intermittent Failure"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Lyu, M.R. 1996, Handbook of Software Reliability Engineering, McGraw-Hill" ;
    rdfs:comment """Intermittent failures appear and disappear unpredictably, making 
    diagnosis challenging. Often related to race conditions or environmental factors."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/50641.html> ;
    rdfs:subClassOf reliability:FailureType ;
    skos:definition "IntermittentFailure is a failure concept describing sporadic system malfunctions that occur unpredictably under specific environmental or load conditions, making them difficult to reproduce and diagnose systematically."@en ;
    skos:example "DNS resolution failures occurring only during peak traffic periods due to resolver overload."@en,
        "Memory leak causes service restart every 72 hours under sustained load conditions."@en .

reliability:KnowledgeGraphIntegration a owl:Class ;
    rdfs:label "Knowledge Graph Integration"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ammann & Offutt 2016, Introduction to Software Testing, Cambridge University Press" ;
    rdfs:comment """Integrates structured factual knowledge at pretraining, inference, 
    or post-generation stages to improve accuracy."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:FailureMitigation ;
    skos:definition "KnowledgeGraphIntegration is an LLM testing and mitigation method that grounds model responses against structured knowledge repositories, reducing hallucination risk by anchoring content to verified factual data."@en ;
    skos:example "Grounding medical LLM responses against SNOMED CT knowledge graph entities."@en .

reliability:LLMCharacteristic a owl:Class ;
    rdfs:label "LLM Characteristic"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Liu et al. 2025, Advances and challenges in foundation agents, arXiv:2504.01990"@en ;
    rdfs:comment "A fundamental property or behavior pattern inherent to large language models that affects their reliability profile, such as non-deterministic behavior, context window limitations, or emergent capabilities."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://arxiv.org/abs/2504.01990> ;
    rdfs:subClassOf reliability:LLMReliability ;
    skos:definition "A fundamental property or behavior pattern inherent to large language models that affects their reliability profile, such as non-deterministic behavior, context window limitations, or emergent capabilities."@en ;
    skos:example "Non-deterministic behavior means the same prompt yields different responses at temperature > 0, requiring reliability metrics that account for variance."@en .

reliability:LegalHallucination a owl:Class ;
    rdfs:label "Legal Hallucination"@en ;
    reliability:appliesInDomain reliability:LegalDomain ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ji et al. 2023, Survey of Hallucination in Natural Language Generation (ACM Computing Surveys)" ;
    rdfs:comment """Legal hallucinations can lead to malpractice, case dismissal, or 
    professional sanctions"""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1145/3571730> ;
    rdfs:subClassOf reliability:DomainSpecificFailure,
        reliability:Hallucination ;
    skos:definition "LegalHallucination is a domain-specific hallucination type in which an LLM fabricates or misrepresents legal citations, statutes, case precedents, or regulatory requirements, posing significant professional liability risk."@en ;
    skos:example "AI cites 'Johnson v. State of California (2019)' which does not exist in any legal database."@en,
        "LLM cites 'Smith v. Johnson (2019) 567 U.S. 123' - a case that doesn't exist but follows proper legal citation format."@en .

reliability:LeidenAlgorithm a owl:Class ;
    rdfs:label "Leiden Algorithm"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://doi.org/10.1038/s41598-019-41695-z> ;
    rdfs:comment "LeidenAlgorithm is a community detection method that improves upon the Louvain algorithm to identify well-connected subgraph communities in knowledge graphs, enabling hierarchical structural analysis of ontological modules."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1038/s41598-019-41695-z> ;
    rdfs:subClassOf reliability:CommunityDetectionMethod ;
    skos:definition "LeidenAlgorithm is a community detection method that improves upon the Louvain algorithm to identify well-connected subgraph communities in knowledge graphs, enabling hierarchical structural analysis of ontological modules."@en ;
    skos:example "Detecting 12 modular communities in a 632-class ontology graph with resolution parameter 1.0."@en .

reliability:Likelihood a owl:Class ;
    rdfs:label "Likelihood"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO 31000:2018 §3.7; ISO Guide 73:2009."@en ;
    rdfs:comment "Chance of something happening, expressed qualitatively (rare, unlikely, possible, likely, almost certain) or quantitatively (probability). Distinct from redo:Probability which is the formal statistical measure."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:ReliabilityConcept ;
    skos:definition "Chance of something happening, expressed qualitatively (rare, unlikely, possible, likely, almost certain) or quantitatively (probability). Distinct from redo:Probability which is the formal statistical measure."@en .

reliability:MTBF a owl:Class ;
    rdfs:label "Mean Time Between Failures"@en ;
    measurement:hasMeasurementSubject measurement:OperationalEnvironmentMeasurementSubject ;
    reliability:hasUnit "time (hours, days)" ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:comment "Key metric for assessing system reliability and maintenance planning"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/50641.html> ;
    rdfs:subClassOf measurement:ReliabilityMetric ;
    skos:altLabel "MTBF"@en ;
    skos:definition "MTBF (Mean Time Between Failures) is a reliability metric measuring the average elapsed time between consecutive system failures during operational use, serving as a key indicator of system reliability maturity."@en ;
    skos:example "A cloud service with MTBF of 8,760 hours (1 year) means it operates on average one full year between unplanned outages requiring intervention."@en,
        "Database cluster with MTBF of 8,760 hours (1 year) between unplanned outages."@en .

reliability:MTTF a owl:Class ;
    rdfs:label "Mean Time To Failure"@en ;
    measurement:hasMeasurementSubject measurement:OperationalEnvironmentMeasurementSubject ;
    reliability:hasUnit "time (hours)" ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:comment "Used for systems where repair is not feasible"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/50641.html> ;
    rdfs:subClassOf measurement:ReliabilityMetric ;
    skos:altLabel "MTTF"@en ;
    skos:definition "MTTF (Mean Time To Failure) is a reliability metric that measures the average elapsed time between system deployment or restart and the occurrence of the first failure event under normal operating conditions."@en ;
    skos:example "A web server with MTTF of 720 hours (30 days) under normal production load."@en .

reliability:MTTR a owl:Class ;
    rdfs:label "Mean Time To Repair"@en ;
    measurement:hasMeasurementSubject measurement:OperationalEnvironmentMeasurementSubject ;
    reliability:hasUnit "time (hours)" ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:comment "Critical for assessing maintainability and downtime"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/50641.html> ;
    rdfs:subClassOf measurement:ReliabilityMetric ;
    skos:altLabel "MTTR"@en ;
    skos:definition "MTTR (Mean Time To Repair) is a reliability metric measuring the average elapsed time required to diagnose and restore a failed system component to its fully operational state following a detected failure event."@en ;
    skos:example "An MTTR of 4 hours indicates the average time from failure detection to full service restoration, including diagnosis, repair, and verification."@en,
        "Average 45-minute repair time for automated failover in a distributed microservice architecture."@en .

reliability:Maturity a owl:Class ;
    rdfs:label "Maturity"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC 25010:2011 §4.2.5 Reliability, Maturity sub-characteristic. Note: renamed 'Faultlessness' in ISO/IEC 25010:2023 §3.5.4."@en ;
    rdfs:comment "A quality characteristic measuring the degree to which a system meets reliability needs under normal operating conditions, reflecting the frequency of failures caused by faults in the system during steady-state operation."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf reliability:QualityCharacteristic ;
    skos:definition "A quality characteristic measuring the degree to which a system meets reliability needs under normal operating conditions, reflecting the frequency of failures caused by faults in the system during steady-state operation."@en ;
    skos:example "System achieves maturity index of 0.997 with only 3 faults per 1000 operating hours under normal conditions."@en .

reliability:MedicalHallucination a owl:Class ;
    rdfs:label "Medical Hallucination"@en ;
    reliability:appliesInDomain reliability:MedicalDomain ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ji et al. 2023, Survey of Hallucination in Natural Language Generation (ACM Computing Surveys)" ;
    rdfs:comment """Medical hallucinations have heightened severity due to potential 
    impact on patient safety and clinical decision-making"""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1145/3571730> ;
    rdfs:subClassOf reliability:DomainSpecificFailure,
        reliability:Hallucination ;
    skos:definition "MedicalHallucination is a domain-specific hallucination type in which an LLM fabricates or misrepresents medical diagnoses, treatment protocols, drug interactions, or clinical evidence, posing direct patient safety risk."@en ;
    skos:example "LLM recommends 'Metformin 2000mg twice daily' - exceeding maximum safe dosage without any source."@en,
        "Model recommends dosage of 500mg when clinical guideline specifies maximum 200mg for the condition."@en .

reliability:MitigationMappingRatio a owl:Class ;
    rdfs:label "Mitigation Mapping Ratio"@en ;
    measurement:hasMeasurementSubject measurement:LLMMeasurementSubject ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "IEEE 1633-2016 Recommended Practice on Software Reliability."@en ;
    rdfs:comment "An LLM reliability metric that measures the completeness of failure-to-mitigation coverage, computed as the ratio of failure modes with at least one documented mitigation strategy to the total number of identified failure modes."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf measurement:LLMReliabilityMetric ;
    skos:definition "An LLM reliability metric that measures the completeness of failure-to-mitigation coverage, computed as the ratio of failure modes with at least one documented mitigation strategy to the total number of identified failure modes."@en ;
    skos:example "78 of 92 identified failure modes have documented mitigations, MMR=0.848, with 14 failure modes requiring new mitigation strategies."@en .

reliability:NarrativeRevisionResistance a owl:Class ;
    rdfs:label "Narrative Revision Resistance"@en ;
    measurement:hasMeasurementSubject measurement:LLMMeasurementSubject ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NEEDS_EXPERT_REVIEW: a reliability ontology-native metric. Related to belief perseverance (Ross, Lepper, Hubbard, 1975. Journal of Personality and Social Psychology)."@en ;
    rdfs:comment """Degree to which an assessment narrative resists revision when 
    contradictory evidence is presented. Measured as the ratio of 
    narrative-preserving interpretations to narrative-challenging 
    interpretations when new evidence arrives.
    
    Threshold: NRR > 0.7 triggers NarrativeChallengeProtocol."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf measurement:LLMReliabilityMetric ;
    skos:definition """Degree to which an assessment narrative resists revision when 
    contradictory evidence is presented. Measured as the ratio of 
    narrative-preserving interpretations to narrative-challenging 
    interpretations when new evidence arrives.
    
    Threshold: NRR > 0.7 triggers NarrativeChallengeProtocol."""@en ;
    skos:example "Example: ex:nrr_assessment_v3 a redo:NarrativeRevisionResistance ; rdfs:label \"NRR for quality assessment v3\" ; redo:hasValue 0.75 ; skos:definition \"6 of 8 new evidence items were interpreted to preserve the existing narrative. NRR > 0.7 triggered NarrativeChallengeProtocol.\" ."@en .

reliability:NegativeSpaceVerificationRate a owl:Class ;
    rdfs:label "Negative Space Verification Rate"@en ;
    measurement:hasMeasurementSubject measurement:LLMMeasurementSubject ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Forensic analysis of LLM Reliability Safeguarding Guide i18n session, February 2026."@en ;
    rdfs:comment """The fraction of verification checks in a test suite that test for 
    the ABSENCE of the failure condition rather than the PRESENCE of the 
    success condition. Computed as:
    
    NSVR = |checks testing ¬failure| / |total checks|
    
    A test suite with NSVR = 0.0 consists entirely of forward checks 
    (confirmation bias). A suite with NSVR ≥ 0.5 has balanced coverage.
    For completeness claims specifically, NSVR should approach 1.0 because 
    the only adequate verification IS the reverse check.
    
    Complementary to VerificationSubstantivenessRate (VSR, v2.2.0):
    - VSR measures whether checks test the SPECIFIC claim being verified
    - NSVR measures whether checks test from the FALSIFICATION direction
    - A check can be substantive (high VSR) but still forward-only (low NSVR)
    - Example: 'grep for new value' is substantive (tests the right thing)
      but forward-only (doesn't detect stale old values)
    
    Combined interpretation:
    - Low VSR, Low NSVR: Ritual verification (decorative)
    - High VSR, Low NSVR: Substantive but confirmation-biased
    - High VSR, High NSVR: Adequate verification (reverse audit)
    
    Threshold: NSVR < 0.3 for completeness claims triggers ReverseAudit 
    alert. For non-completeness claims, NSVR ≥ 0.2 is acceptable."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf measurement:LLMReliabilityMetric ;
    skos:definition """The fraction of verification checks in a test suite that test for 
    the ABSENCE of the failure condition rather than the PRESENCE of the 
    success condition. Computed as:
    
    NSVR = |checks testing ¬failure| / |total checks|
    
    A test suite with NSVR = 0.0 consists entirely of forward checks 
    (confirmation bias). A suite with NSVR ≥ 0.5 has balanced coverage.
    For completeness claims specifically, NSVR should approach 1.0 because 
    the only adequate verification IS the reverse check.
    
    Complementary to VerificationSubstantivenessRate (VSR, v2.2.0):
    - VSR measures whether checks test the SPECIFIC claim being verified
    - NSVR measures whether checks test from the FALSIFICATION direction
    - A check can be substantive (high VSR) but still forward-only (low NSVR)
    - Example: 'grep for new value' is substantive (tests the right thing)
      but forward-only (doesn't detect stale old values)
    
    Combined interpretation:
    - Low VSR, Low NSVR: Ritual verification (decorative)
    - High VSR, Low NSVR: Substantive but confirmation-biased
    - High VSR, High NSVR: Adequate verification (reverse audit)
    
    Threshold: NSVR < 0.3 for completeness claims triggers ReverseAudit 
    alert. For non-completeness claims, NSVR ≥ 0.2 is acceptable."""@en ;
    skos:example """i18n verification suite analysis:
    V6-V9 suite: 210 checks, ALL forward ('Turkish X exists?'). NSVR = 0.0.
    V10 suite:   15 JS checks + 1 reverse HTML audit. NSVR = 1.0 for HTML, 
    ~0.5 overall. First version to achieve zero defects."""@en .

reliability:Overconfidence a owl:Class ;
    rdfs:label "Overconfidence"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Xiong, M. et al. (2024). Can LLMs Express Their Uncertainty? An Empirical Evaluation of Confidence Elicitation in LLMs. ICLR 2024."@en ;
    rdfs:comment """Overconfidence is a specialization of ConfidenceMiscalibration where the 
    LLM's expressed confidence systematically exceeds its actual accuracy. This is the most 
    common calibration failure pattern in LLMs, particularly exacerbated by RLHF training 
    that rewards confident-sounding outputs. Xiong et al. found verbalized confidence values 
    predominantly fall in the 80-100% range regardless of actual correctness."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf reliability:ConfidenceMiscalibration ;
    skos:definition """Overconfidence is a specialization of ConfidenceMiscalibration where the 
    LLM's expressed confidence systematically exceeds its actual accuracy. This is the most 
    common calibration failure pattern in LLMs, particularly exacerbated by RLHF training 
    that rewards confident-sounding outputs. Xiong et al. found verbalized confidence values 
    predominantly fall in the 80-100% range regardless of actual correctness."""@en ;
    skos:example "LLM expresses 90% confidence across all responses but is correct only 65% of the time, yielding a systematic overconfidence gap of ~25 percentage points."@en .

reliability:PassAll a owl:Class ;
    rdfs:label "Pass@all Metric"@en ;
    measurement:hasMeasurementSubject measurement:LLMMeasurementSubject ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Liu et al. 2025, Advances and challenges in foundation agents, arXiv:2504.01990"@en ;
    rdfs:comment "A strict reliability metric counting a task as successful only if the model succeeds in ALL attempts (e.g., 100/100), essential for mission-critical deployments where a single error is unacceptable. This metric captures the consistency requirements of high-stakes applications such as autonomous software migration or medical decision support."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://arxiv.org/abs/2504.01990> ;
    rdfs:subClassOf measurement:LLMReliabilityMetric ;
    skos:definition "A strict reliability metric counting a task as successful only if the model succeeds in ALL attempts (e.g., 100/100), essential for mission-critical deployments where a single error is unacceptable. This metric captures the consistency requirements of high-stakes applications such as autonomous software migration or medical decision support."@en ;
    skos:example "In database migration, Pass@all requires the agent to correctly transform every query in every attempt, as a single error can corrupt the entire database."@en .

reliability:PerformanceEfficiency a owl:Class ;
    rdfs:label "Performance Efficiency"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://www.iso.org/standard/78176.html> ;
    rdfs:comment "Includes time behavior, resource utilization, and capacity"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf reliability:QualityCharacteristic ;
    skos:definition "PerformanceEfficiency is a quality characteristic measuring the performance of a system relative to the amount of resources (CPU, memory, network, storage) consumed under stated conditions, encompassing time behavior, resource utilization, and capacity as sub-characteristics per ISO/IEC 25010."@en ;
    skos:example "System achieves 2400 SPARQL queries/second with average response time of 45ms on standard hardware configuration."@en .

reliability:Portability a owl:Class ;
    rdfs:label "Portability"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC 25010:2011 §4.2.8 Portability. Note: renamed 'Flexibility' in ISO/IEC 25010:2023 §3.8."@en ;
    rdfs:comment "A quality characteristic measuring the degree to which a system can be effectively and efficiently transferred from one hardware, software, or operational environment to another, encompassing adaptability, installability, and replaceability."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf reliability:QualityCharacteristic ;
    skos:definition "A quality characteristic measuring the degree to which a system can be effectively and efficiently transferred from one hardware, software, or operational environment to another, encompassing adaptability, installability, and replaceability."@en ;
    skos:example "Ontology loads successfully in Protege 5.6, TopBraid 7.1, and Apache Jena 4.7 with identical reasoning results."@en .

reliability:Postmortem a owl:Class ;
    rdfs:label "Postmortem"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Allspaw, J. (2012). Blameless PostMortems and a Just Culture. Etsy Code as Craft. Beyer, B. et al. (2016). Site Reliability Engineering. O'Reilly. §15."@en ;
    rdfs:comment "Retrospective analysis activity conducted after a significant Failure or Incident, focused on identifying RootCauses, contributing factors, and corrective actions. Industry best practice (Allspaw 2012, Google SRE) is blameless: focused on systemic issues rather than individual fault."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf core:Process,
        kb:RetrospectiveMeeting ;
    skos:definition "Retrospective analysis activity conducted after a significant Failure or Incident, focused on identifying RootCauses, contributing factors, and corrective actions. Industry best practice (Allspaw 2012, Google SRE) is blameless: focused on systemic issues rather than individual fault."@en .

reliability:ProvenanceVerifiabilityRate a owl:Class ;
    rdfs:label "Provenance Verifiability Rate"@en ;
    measurement:hasMeasurementSubject measurement:LLMMeasurementSubject ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NEEDS_EXPERT_REVIEW: a reliability ontology-native metric from v2.4.0 forensic analysis. Related to citation verification in scholarly communication."@en ;
    rdfs:comment """The proportion of cited sources in a document's 
    reference list that can be independently verified to exist. Computed 
    as: PVR = (verified_sources / total_cited_sources). A source is 
    'verified' if it can be accessed via DOI resolution, database lookup, 
    URL retrieval, or file existence confirmation. Sources labeled as 
    'Primary research reported in this document' are counted as verified 
    if the corresponding section exists. Fabricated sources ('unpublished 
    manuscripts' that don't exist, invented journal references, fictional 
    DOIs) count as unverified.
    
    Relationship to GroundingScore: GroundingScore measures claim-to-source 
    alignment (are the claims supported by the cited sources?). 
    ProvenanceVerifiabilityRate measures source existence (do the cited 
    sources actually exist?). A document can score 1.0 on GroundingScore 
    and 0.0 on ProvenanceVerifiabilityRate if every claim is correctly 
    attributed to a fictional source. Both metrics are needed for complete 
    citation integrity."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf measurement:LLMReliabilityMetric ;
    skos:definition """The proportion of cited sources in a document's 
    reference list that can be independently verified to exist. Computed 
    as: PVR = (verified_sources / total_cited_sources). A source is 
    'verified' if it can be accessed via DOI resolution, database lookup, 
    URL retrieval, or file existence confirmation. Sources labeled as 
    'Primary research reported in this document' are counted as verified 
    if the corresponding section exists. Fabricated sources ('unpublished 
    manuscripts' that don't exist, invented journal references, fictional 
    DOIs) count as unverified.
    
    Relationship to GroundingScore: GroundingScore measures claim-to-source 
    alignment (are the claims supported by the cited sources?). 
    ProvenanceVerifiabilityRate measures source existence (do the cited 
    sources actually exist?). A document can score 1.0 on GroundingScore 
    and 0.0 on ProvenanceVerifiabilityRate if every claim is correctly 
    attributed to a fictional source. Both metrics are needed for complete 
    citation integrity."""@en ;
    skos:example """A paper cites 45 references. 41 are published papers 
    verifiable via DOI/Google Scholar. 4 cite 'unpublished manuscripts' 
    that don't exist. PVR = 41/45 = 0.911. The 4 unverified sources are 
    flagged as potential ProvenanceFabrication."""@en .

reliability:QualityAssuranceEngineer a owl:Class ;
    rdfs:label "Quality Assurance Engineer"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:comment "Cross-cutting role across all lifecycle phases"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf core:Role ;
    skos:definition "QualityAssuranceEngineer is an agent role responsible for establishing quality processes, defining verification standards, and ensuring reliability engineering practices are consistently applied across the development lifecycle."@en ;
    skos:example "QA lead establishing test automation framework and defining coverage quality gates."@en .

reliability:Recall a owl:Class ;
    rdfs:label "Recall"@en ;
    reliability:hasUnit "percentage or 0.0-1.0" ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:comment "Recall = TP / (TP + FN)"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf core:Metric ;
    skos:definition "Recall is a reliability metric that measures the ratio of true positive detections to all actual positive instances, quantifying the sensitivity of a classifier or detection system in avoiding false negative errors."@en ;
    skos:example "Of 100 actual anomalies, the system detected 90: recall = 0.90."@en .

reliability:ReferenceIntegrityGate a owl:Class ;
    rdfs:label "Reference Integrity Gate"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Sprint F5 (2026-05-15)."@en ;
    rdfs:comment "A quality gate that verifies referential integrity in an ontology — every IRI used must be declared, every property must have a domain/range, every individual must have an rdf:type, etc. Per Sprint F5: declared from 1 range reference."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf qc:QualityGate ;
    skos:definition "A quality gate that verifies referential integrity in an ontology — every IRI used must be declared, every property must have a domain/range, every individual must have an rdf:type, etc. Per Sprint F5: declared from 1 range reference."@en .

reliability:ReliabilityEngineer a owl:Class ;
    rdfs:label "Reliability Engineer"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:comment "Focuses on fault prevention, tolerance, and removal strategies"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf core:Role ;
    skos:definition "ReliabilityEngineer is an agent role responsible for analyzing failure modes, designing fault-tolerant architectures, establishing reliability metrics, and ensuring systems meet defined reliability and availability targets."@en ;
    skos:example "An SRE defining SLOs, error budgets, and automated rollback triggers for a production deployment."@en,
        "SRE responsible for defining SLOs, monitoring error budgets, and implementing chaos engineering practices."@en .

reliability:ResolutionOutcome a owl:Class ;
    rdfs:label "Resolution Outcome"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Phase 2.8 Outcome Tracking — pattern adapted from Atlassian Jira Resolution states and ITIL 4 Problem closure codes."@en ;
    rdfs:comment "A SKOS concept categorizing how an IssueLifecycleRecord was disposed: Resolved, PartiallyResolved, WontFix, Open, Deferred. Five members of the resolutionOutcomeScheme."@en ;
    rdfs:isDefinedBy <http://example.org/redo/v2.10.0/issue-lifecycle> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A SKOS concept categorizing how an IssueLifecycleRecord was disposed: Resolved, PartiallyResolved, WontFix, Open, Deferred. Five members of the resolutionOutcomeScheme."@en .

reliability:RitualCompliance a reliability:ComplianceDepth,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Ritual Compliance (Level 1)"@en ;
    reliability:complianceLevel 1 ;
    reliability:measures qc:Reliability ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NEEDS_EXPERT_REVIEW: a reliability ontology-native concept. Related to 'compliance theater' in security literature (Schneier, B. 2003. Beyond Fear)."@en ;
    rdfs:comment "Framework mentioned without executing verification. Meta-manifestation of DecorativeCompliance."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/62085.html> ;
    rdfs:subClassOf reliability:DecorativeCompliance ;
    skos:definition "Framework mentioned without executing verification. Meta-manifestation of DecorativeCompliance."@en ;
    skos:example "Example: Citing SHACL validation as passing without actually running pySHACL, or copy-pasting a previous audit's checksum without recomputing."@en .

reliability:RootCause a owl:Class ;
    rdfs:label "Root Cause"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Charette, R.N. (1989). Software Engineering Risk Analysis and Management. McGraw-Hill."@en ;
    rdfs:comment "The fundamental underlying cause of a Failure or Problem — the deepest factor that, if eliminated, prevents recurrence. Distinct from contributing factors (which are necessary but not sufficient)."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:ReliabilityConcept ;
    skos:definition "The fundamental underlying cause of a Failure or Problem — the deepest factor that, if eliminated, prevents recurrence. Distinct from contributing factors (which are necessary but not sufficient)."@en ;
    skos:example "redo:TaxonomicLevelViolation is one specific RootCause subtype already in a reliability ontology; this class is the general concept under which other root causes are organised."@en .

reliability:SBOM a owl:Class ;
    rdfs:label "Software Bill of Materials (SBOM)"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NTIA Minimum Elements for an SBOM (2021); ISO/IEC 5962:2021 SPDX; CycloneDX 1.5 Specification."@en ;
    rdfs:comment "A Software Bill of Materials: a formal, machine-readable inventory of all components, libraries, and dependencies of a software (or ontology) artefact, with version, license, and supplier information for each."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:ReliabilityConcept ;
    skos:definition "A Software Bill of Materials: a formal, machine-readable inventory of all components, libraries, and dependencies of a software (or ontology) artefact, with version, license, and supplier information for each."@en .

reliability:SLSABuildLevel a owl:Class ;
    rdfs:label "SLSA Build Level"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "SLSA v1.0 (2023). Supply-chain Levels for Software Artifacts. Open Source Security Foundation (OpenSSF)."@en ;
    rdfs:comment "SLSA (Supply-chain Levels for Software Artifacts) build-track level. Four tiers (L0..L3 in v1.0) specifying progressively stronger guarantees about build integrity, provenance, and reproducibility."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:ReliabilityTier ;
    skos:definition "SLSA (Supply-chain Levels for Software Artifacts) build-track level. Four tiers (L0..L3 in v1.0) specifying progressively stronger guarantees about build integrity, provenance, and reproducibility."@en .

reliability:Security a owl:Class ;
    rdfs:label "Security"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://www.iso.org/standard/78176.html> ;
    rdfs:comment "Includes confidentiality, integrity, non-repudiation, accountability, authenticity, and resistance"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf reliability:QualityCharacteristic ;
    skos:definition "Degree to which a product or system protects information and data from unauthorized access, use, modification, destruction, or disclosure"@en ;
    skos:example "A system encrypting all data at rest and in transit, with role-based access control."@en .

reliability:SoftwareReliability a owl:Class ;
    rdfs:label "Software Reliability"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:comment "Traditional domain focused on software system reliability per IEEE 1633-2016"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/50641.html> ;
    rdfs:subClassOf reliability:ReliabilityDomain ;
    skos:altLabel "Software Dependability"@en ;
    skos:definition "The probability that software will operate without failure under stated conditions for a specified period"@en ;
    skos:example "Application maintains 99.95% uptime over 12-month period with 3 unplanned outages totaling 4.4 hours."@en .

reliability:SycophancyDegree a owl:Class ;
    rdfs:label "Sycophancy Degree"@en ;
    measurement:hasMeasurementSubject measurement:LLMMeasurementSubject ;
    reliability:hasUnit "probability delta (-1.0 to 1.0)" ;
    reliability:measuresAttribute reliability:Sycophancy ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://arxiv.org/abs/2310.13548>,
        "Malmqvist 2024 sycophancy survey" ;
    rdfs:comment """Formula: σ = P(incorrect|biased_prompt) -
    P(incorrect|neutral_prompt). Positive values indicate sycophantic
    behavior where the LLM is more likely to produce incorrect output
    when the prompt contains user bias. Derived from Malmqvist survey
    methodology. σ > 0.1 indicates measurable sycophantic tendency."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf measurement:LLMReliabilityMetric ;
    skos:definition """Quantitative measure of sycophantic tendency calculated
    as the difference in error probability between biased and neutral
    prompts, where positive values indicate the LLM is more likely to
    produce incorrect output when aligned with user expectations"""@en ;
    skos:example "Model reverses its correct answer 34% of the time when user pushes back, yielding SD=0.34 on adversarial probe."@en .

reliability:TestSuiteTheater a owl:Class ;
    rdfs:label "Test Suite Theater"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Avizienis et al. 2004",
        "Ma et al. 2024: <10% fault detection in LLM tests" ;
    rdfs:comment """Compound failure where the same LLM generates both a
    broken implementation and a test suite that confirms the broken
    implementation. Tests are structurally valid, achieve high coverage,
    but validate the wrong abstraction layer. Empirically observed:
    360 tests passing at 100% rate while testing mock layer instead of
    ontology integration layer."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:LLMBehavioralPathology ;
    skos:definition """Compound reliability failure where an LLM generates
    structurally valid test suites with high coverage metrics that
    systematically validate the wrong abstraction layer or confirm
    incorrect behavior, creating false assurance of correctness"""@en ;
    skos:example "Generated unit tests achieve 95% code coverage but only test trivial getters/setters and happy paths while ignoring error handling and edge cases in complex business logic."@en,
        "Test suite with 100% pass rate because tests only validate happy-path scenarios without edge cases."@en .

reliability:Testability a owl:Class ;
    rdfs:label "Testability"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC 25010:2023 §3.7 Maintainability, §3.7.5 Testability sub-characteristic."@en ;
    rdfs:comment "A quality characteristic measuring the degree to which test criteria can be established for a system and tests can be performed to determine whether those criteria have been met, encompassing observability, controllability, and isolation properties."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf reliability:QualityCharacteristic ;
    skos:definition "A quality characteristic measuring the degree to which test criteria can be established for a system and tests can be performed to determine whether those criteria have been met, encompassing observability, controllability, and isolation properties."@en ;
    skos:example "System scores 92% testability with observable state, injectable dependencies, and deterministic outputs for all public methods."@en .

reliability:TransientFailure a owl:Class ;
    rdfs:label "Transient Failure"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Avizienis, A., Laprie, J.-C., Randell, B., & Landwehr, C. (2004). Basic concepts and taxonomy of dependable and secure computing. IEEE TDSC."@en ;
    rdfs:comment """Transient failures manifest sporadically, often for out-of-range or 
    boundary inputs. System may operate correctly most of the time."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/50641.html> ;
    rdfs:subClassOf reliability:FailureType ;
    owl:disjointWith reliability:PermanentFailure ;
    skos:definition "TransientFailure is a failure type that occurs only for specific input values, boundary conditions, or environmental states, manifesting sporadically while the system operates correctly under normal conditions, often self-resolving without intervention or reproducible only under narrow circumstances."@en ;
    skos:example "Network packet loss during brief cloud provider maintenance window, self-resolving after 3 minutes."@en,
        "Network timeout resolves automatically after 5 seconds when traffic spike subsides."@en .

reliability:UnsupportedClaim a owl:Class ;
    rdfs:label "Unsupported Claim"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Gemini behavioral pathology report: zombie claim subtypes" ;
    rdfs:comment """Claim that appears authoritative but has no traceable
    evidence binding. May be factually true but unverifiable from the
    evidence provided in the generation context."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:ZombieClaim ;
    owl:disjointWith reliability:ContradictedClaim ;
    skos:definition """Zombie claim that lacks any traceable evidentiary
    support, where the claim may be factually plausible but cannot be
    verified from the available evidence base"""@en ;
    skos:example "The LLM states 'Studies show that 73% of developers prefer TypeScript over JavaScript' without any citation, reference, or evidence to support this specific percentage."@en .

reliability:UserRepresentative a owl:Class ;
    rdfs:label "User Representative"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 42010:2011 Systems and software engineering — Architecture description; IEEE 1633-2016 §5 Stakeholder involvement."@en ;
    rdfs:comment "A stakeholder role representing end users in design, review, and validation activities, ensuring that reliability requirements reflect actual usage patterns, user expectations, and operational contexts of the target user population."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf core:Stakeholder ;
    skos:definition "A stakeholder role representing end users in design, review, and validation activities, ensuring that reliability requirements reflect actual usage patterns, user expectations, and operational contexts of the target user population."@en ;
    skos:example "Clinical pharmacist representing end users in LLM drug interaction checker validation, reviewing 200 test scenarios."@en .

reliability:VerificationAdequacyGate a owl:Class ;
    rdfs:label "Verification Adequacy Gate"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Forensic analysis of a reliability ontology v2.1.0 HTML update session, February 2026."@en ;
    rdfs:comment """Mitigation strategy requiring that before declaring a change set 
    'verified', the assessor must demonstrate that the verification method 
    is capable of detecting the specific failure mode at issue.
    
    Protocol:
    1. Identify the change set and what could go wrong:
       - 'Updated counts in 20+ locations → stale values may remain'
    2. Identify the detection method:
       - 'Grep for new values confirms they were added'
    3. Ask: can this method detect the failure mode?
       - 'Grep for new values does NOT detect stale old values that remain'
    4. If no → identify a method that can:
       - 'Grep for OLD values across all files; any match is a stale reference'
       - 'Structured cross-file audit comparing canonical claims'
    5. Execute the adequate method before declaring 'verified'
    
    Complementary to AssessorFeasibilityGate: the feasibility gate prevents 
    false impossibility claims; the adequacy gate prevents false verification 
    claims. Together they bookend the assessment process: 'don't say you 
    can't without trying' and 'don't say you did without actually checking.'
    
    Aligned with a reliability ontology VerificationModality and ComplianceGate concepts."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf reliability:FailureMitigation ;
    skos:definition """Mitigation strategy requiring that before declaring a change set 
    'verified', the assessor must demonstrate that the verification method 
    is capable of detecting the specific failure mode at issue.
    
    Protocol:
    1. Identify the change set and what could go wrong:
       - 'Updated counts in 20+ locations → stale values may remain'
    2. Identify the detection method:
       - 'Grep for new values confirms they were added'
    3. Ask: can this method detect the failure mode?
       - 'Grep for new values does NOT detect stale old values that remain'
    4. If no → identify a method that can:
       - 'Grep for OLD values across all files; any match is a stale reference'
       - 'Structured cross-file audit comparing canonical claims'
    5. Execute the adequate method before declaring 'verified'
    
    Complementary to AssessorFeasibilityGate: the feasibility gate prevents 
    false impossibility claims; the adequacy gate prevents false verification 
    claims. Together they bookend the assessment process: 'don't say you 
    can't without trying' and 'don't say you did without actually checking.'
    
    Aligned with a reliability ontology VerificationModality and ComplianceGate concepts."""@en ;
    skos:example """After updating '11 pathologies' → '16 pathologies' across 4 files:
    Step 1: Failure mode = stale '11' or '21' references surviving update
    Step 2: Proposed check = grep for '16 pathologies' (confirms new value)
    Step 3: Can it detect stale values? NO — presence of new ≠ absence of old
    Step 4: Adequate method = grep for '11 patholog' and '21 metric' across 
            all output files; any match outside quotes/irony is a stale reference
    Step 5: Execute → finds 5 stale references → fix → then declare verified"""@en .

reliability:VerificationSubstantivenessRate a owl:Class ;
    rdfs:label "Verification Substantiveness Rate"@en ;
    measurement:hasMeasurementSubject measurement:LLMMeasurementSubject ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Forensic analysis of a reliability ontology v2.1.0 HTML update session, February 2026."@en,
        "NEEDS_EXPERT_REVIEW: a reliability ontology-native metric. Conceptually related to mutation testing adequacy (DeMillo, Lipton, Sayward, 1978)."@en ;
    rdfs:comment """Fraction of verification checks that test the specific claim being 
    verified, as opposed to checks that produce output without testing the 
    claim. Detects DecorativeVerification.
    
    Computed as: (checks capable of detecting the target failure mode) / 
    (total verification checks performed).
    
    In the forensic case:
    - grep -c '16 pathologies' → confirms presence (substantive for 'was it added?')
    - grep -c '11 pathologies' → confirms absence of stale (substantive for 
      'was old value removed?') — THIS CHECK WAS NOT PERFORMED
    - Cross-file exact-match audit → substantive for 'are all files consistent?'
    
    VSR = 0/5 for cross-location consistency (the actual failure mode).
    VSR = 5/5 for value-presence (not the actual failure mode).
    
    The metric distinguishes 'verification of the wrong thing' from 
    'verification of the right thing poorly.' Both are failures, but 
    they require different mitigations.
    
    Threshold: VSR < 0.5 triggers VerificationAdequacyGate alert."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf measurement:LLMReliabilityMetric ;
    skos:definition """Fraction of verification checks that test the specific claim being 
    verified, as opposed to checks that produce output without testing the 
    claim. Detects DecorativeVerification.
    
    Computed as: (checks capable of detecting the target failure mode) / 
    (total verification checks performed).
    
    In the forensic case:
    - grep -c '16 pathologies' → confirms presence (substantive for 'was it added?')
    - grep -c '11 pathologies' → confirms absence of stale (substantive for 
      'was old value removed?') — THIS CHECK WAS NOT PERFORMED
    - Cross-file exact-match audit → substantive for 'are all files consistent?'
    
    VSR = 0/5 for cross-location consistency (the actual failure mode).
    VSR = 5/5 for value-presence (not the actual failure mode).
    
    The metric distinguishes 'verification of the wrong thing' from 
    'verification of the right thing poorly.' Both are failures, but 
    they require different mitigations.
    
    Threshold: VSR < 0.5 triggers VerificationAdequacyGate alert."""@en ;
    skos:example "Example: ex:vsr_crossloc a redo:VerificationSubstantivenessRate ; rdfs:label \"VSR for cross-location consistency\" ; redo:hasValue 0.0 ; skos:definition \"0 of 5 verification checks tested the actual failure mode (cross-location consistency). All 5 tested value-presence (not the target failure). VSR < 0.5 triggered VerificationAdequacyGate.\" ."@en .

reliability:ZombieClaimRate a owl:Class ;
    rdfs:label "Zombie Claim Rate"@en ;
    measurement:hasMeasurementSubject measurement:LLMMeasurementSubject ;
    reliability:hasUnit "ratio (0.0 to 1.0)" ;
    reliability:measuresAttribute reliability:ZombieClaim ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Gemini behavioral pathology report: ZCR metric" ;
    rdfs:comment """Formula: ZCR = (unsupported_claims + contradicted_claims)
    / total_decision_relevant_claims. Measures the proportion of claims
    in LLM output that lack evidentiary support or are contradicted by
    available evidence. Lower is better. Threshold: ZCR > 0.1 indicates
    unacceptable decision risk."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf measurement:LLMReliabilityMetric ;
    skos:definition """Proportion of decision-relevant claims in LLM output
    that are either unsupported by traceable evidence or actively
    contradicted by available evidence in the generation context"""@en ;
    skos:example "Analysis showing 40% of assertions in a generated report lack any traceable source citation."@en .

reliability:ZombieDerivedClaim a owl:Class ;
    rdfs:label "Zombie Derived Claim"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ji, Z., et al. (2023). Survey of Hallucination in Natural Language Generation. ACM Computing Surveys."@en ;
    rdfs:comment "A subcategory of zombie claim where the fabricated assertion propagates through derivation chains — the original zombie claim is cited or built upon in subsequent outputs, creating cascading unreliability across dependent artifacts."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:ZombieClaim ;
    skos:definition "A subcategory of zombie claim where the fabricated assertion propagates through derivation chains — the original zombie claim is cited or built upon in subsequent outputs, creating cascading unreliability across dependent artifacts."@en ;
    skos:example "Secondary report cites fabricated statistic from prior LLM output, propagating the zombie claim into downstream analysis."@en .

reliability:ZombieSourceRatio a owl:Class ;
    rdfs:label "Zombie Source Ratio"@en ;
    measurement:hasMeasurementSubject measurement:LLMMeasurementSubject ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ji, Z., et al. (2023). Survey of Hallucination in Natural Language Generation. ACM Computing Surveys."@en ;
    rdfs:comment "An LLM reliability metric that quantifies the proportion of cited sources in generated output that are fabricated, non-existent, or unverifiable, computed as the ratio of zombie sources to total source references in a given output sample."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf measurement:LLMReliabilityMetric ;
    skos:definition "An LLM reliability metric that quantifies the proportion of cited sources in generated output that are fabricated, non-existent, or unverifiable, computed as the ratio of zombie sources to total source references in a given output sample."@en ;
    skos:example "Audit reveals 15 of 42 cited papers (35.7%) are fabricated, yielding ZSR=0.357 for the generated literature review."@en .

reliability:documentedIn a owl:ObjectProperty ;
    rdfs:label "documented in"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.7.0; ITIL 4 Knowledge Management practice."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    skos:definition "Links any redo:Concept (Risk, Problem, Failure, Drift, etc.) to the KnowledgeArticle that documents it. Enables querying the KnowledgeBase by concept."@en .

reliability:issueIdentifier a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "issue identifier"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.10.0 issue-lifecycle extension."@en ;
    rdfs:domain reliability:Problem ;
    rdfs:isDefinedBy <http://example.org/redo/v2.10.0/issue-lifecycle> ;
    rdfs:range xsd:string ;
    skos:definition "Stable string identifier for an issue (e.g., 'Phase2.7-Gap1', 'GPPT-v97-OntoOverstatement'). Functional: each Problem has exactly one identifier."@en .

reliability:openedAt a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "opened at"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.10.0 issue-lifecycle extension."@en ;
    rdfs:domain reliability:Problem ;
    rdfs:isDefinedBy <http://example.org/redo/v2.10.0/issue-lifecycle> ;
    rdfs:range xsd:dateTime ;
    skos:definition "Timestamp when the issue was first identified/recorded. Functional: exactly one value per issue."@en .

reliability:releaseDate a owl:DatatypeProperty ;
    rdfs:label "release date"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Dublin Core Metadata Initiative. dcterms:issued adapted for ontology version provenance." ;
    rdfs:domain reliability:OntologyVersion ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:dateTime ;
    skos:definition "The calendar date on which an ontology version was officially released. Encoded as xsd:date for temporal reasoning support."@en ;
    skos:example "Example: redo:Version_1_0 redo:releaseDate \"2025-12-09\"^^xsd:date ."@en .

reliability:tierOrdinal a owl:DatatypeProperty ;
    rdfs:label "tier ordinal"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "IEC 61508-4:2010 §3.5.8 SIL ordinal definition; CMMI Institute CMMI v2.0 maturity-level numbering."@en ;
    rdfs:domain reliability:ReliabilityTier ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:integer ;
    skos:definition "Numeric ordinal of a reliability tier. Lower value = lower assurance / lower integrity demand. Concrete tier vocabularies (SIL, DAL, CMMI, SLSA) MAY assign different numeric ranges, but within a single vocabulary the ordering is total."@en ;
    skos:example "redo:CMMI_Level_3 redo:tierOrdinal 3 ; redo:SIL_2 redo:tierOrdinal 2 ; redo:DAL_A redo:tierOrdinal 5 (highest in DAL inverse-ordered scale)."@en .

reliability:verifiedBy a owl:ObjectProperty ;
    rdfs:label "verifiedBy"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:ComplianceGate ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:EmpiricalTest ;
    skos:definition "Relates a compliance gate to the empirical test that provides the evidence required to satisfy the gate's pass criteria."@en ;
    skos:example "ex:compliancegate_instance redo:verifiedBy ex:empiricaltest_instance . Links ComplianceGate to EmpiricalTest."@en .

reliability:versionNumber a owl:DatatypeProperty ;
    rdfs:label "version number"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Preston-Werner, T. (2013). Semantic Versioning 2.0.0. https://semver.org/" ;
    rdfs:domain reliability:OntologyVersion ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range xsd:string ;
    skos:definition "The semantic version identifier string for an ontology version instance. Follows semantic versioning conventions (major.minor.patch)."@en ;
    skos:example "Example: redo:Version_1_0 redo:versionNumber \"1.0\" ."@en .

risk:CurrentControls a owl:Class ;
    rdfs:label "CurrentControls"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "GAP-FILL: net-new in risk v1.0.0 per FMEA completeness analysis. Per ISO 60812:2018 §6.5."@en ;
    rdfs:comment "Existing prevention and detection mechanisms in place for a failure mode. Determines Detection rating in FMEA scoring. NEW in v1.0.0."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskConcept ;
    skos:definition "Existing prevention and detection mechanisms in place for a failure mode. Determines Detection rating in FMEA scoring. NEW in v1.0.0."@en .

risk:FailureEffect a owl:Class ;
    rdfs:label "FailureEffect"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "Consolidated from reliability:FailureEffect v3.1.0."@en ;
    rdfs:comment "The consequence of a failure mode on the operation, function, or status of an item, classified by scope (local effect, next-higher level, end effect)."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:FMEAArtifact,
        risk:RiskConcept ;
    skos:definition "The consequence of a failure mode on the operation, function, or status of an item, classified by scope (local effect, next-higher level, end effect)."@en .

risk:FinancialImpact a owl:Class ;
    rdfs:label "FinancialImpact"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "Consolidated from reliability:FinancialImpact v3.1.0."@en ;
    rdfs:comment "Direct monetary consequences: revenue loss, remediation cost, penalty exposure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:BusinessImpact,
        risk:ImpactCategory ;
    skos:definition "Direct monetary consequences: revenue loss, remediation cost, penalty exposure."@en .

risk:ImpactLevel a owl:Class ;
    rdfs:label "Impact Level"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "GAP-FILL: net-new in risk v1.0.0; configuration:RiskImpact existed as empty class."@en ;
    rdfs:comment "Categorical classification of the magnitude of consequences if a risk event materializes. Reuses SeverityLevel 4-tier scheme (Critical / High / Medium / Low) for consistency. NEW in v1.0.0 as canonical superclass."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:OrdinalLevel,
        risk:RiskConcept ;
    owl:disjointWith risk:LikelihoodLevel ;
    skos:definition "Categorical classification of the magnitude of consequences if a risk event materializes. Reuses SeverityLevel 4-tier scheme (Critical / High / Medium / Low) for consistency. NEW in v1.0.0 as canonical superclass."@en .

risk:RecommendedAction a owl:Class ;
    rdfs:label "RecommendedAction"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "GAP-FILL: net-new in risk v1.0.0 per FMEA completeness analysis. Per AIAG-VDA §10."@en ;
    rdfs:comment "Action recommended to address a failure mode, distinct from MitigationStrategy in scope: RecommendedAction is the FMEA-output recommendation; MitigationStrategy is the engineering pattern selected to implement it. NEW in v1.0.0."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:Action ;
    skos:definition "Action recommended to address a failure mode, distinct from MitigationStrategy in scope: RecommendedAction is the FMEA-output recommendation; MitigationStrategy is the engineering pattern selected to implement it. NEW in v1.0.0."@en .

risk:RiskCategory a owl:Class ;
    rdfs:label "Risk Category"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "GAP-FILL: net-new in risk v1.0.0 per RiskItem completeness analysis. PMBOK 7th edition §X3."@en ;
    rdfs:comment "Taxonomy of risk types: technical, schedule, cost, operational, regulatory, organizational, external. NEW in v1.0.0."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskConcept,
        risk:RiskRecord ;
    skos:definition "Taxonomy of risk types: technical, schedule, cost, operational, regulatory, organizational, external. NEW in v1.0.0."@en .

risk:RiskContext a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "RiskContext"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "NEEDS_EXPERT_REVIEW: definition based on published summaries of the source standard (paywalled). Final fidelity verification required at A1b closure."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskRecord ;
    skos:definition "The external and internal context within which the organization seeks to achieve its objectives and within which risks are identified, analyzed, and evaluated. Per ISO 31000:2018 clause 6.3."@en .

risk:RiskReduction a owl:Class ;
    rdfs:label "RiskReduction"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "GAP-FILL: net-new in risk v1.0.0 per ISO 31000:2018 §6.5."@en ;
    rdfs:comment "Risk treatment option: action to decrease likelihood or impact (or both) of a risk event. The most common treatment category."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskTreatment ;
    skos:definition "Risk treatment option: action to decrease likelihood or impact (or both) of a risk event. The most common treatment category."@en .

risk:RiskRegister a owl:Class ;
    rdfs:label "Risk Register"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "Consolidated from reliability:RiskRegister v3.1.0."@en ;
    rdfs:comment "Record of information about identified risks; the operational artefact maintained by an engineering team. Per ISO 31000:2018 §6.5.2."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskConcept,
        risk:RiskRecord ;
    skos:definition "Record of information about identified risks; the operational artefact maintained by an engineering team. Per ISO 31000:2018 §6.5.2."@en .

risk:RiskStatus a owl:Class ;
    rdfs:label "Risk Status"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "GAP-FILL: net-new in risk v1.0.0 per RiskItem completeness analysis."@en ;
    rdfs:comment "Lifecycle state of a RiskItem: Identified, Analyzed, Mitigating, Mitigated, Accepted, Closed, Realized. NEW in v1.0.0."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskConcept,
        risk:RiskRecord ;
    skos:definition "Lifecycle state of a RiskItem: Identified, Analyzed, Mitigating, Mitigated, Accepted, Closed, Realized. NEW in v1.0.0."@en .

risk:likelihoodRank a owl:DatatypeProperty ;
    rdfs:label "likelihood rank"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:domain risk:LikelihoodLevel ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:range xsd:integer ;
    skos:definition "GAP-FILL: net-new in risk v1.0.0. Ordinal rank 1-5 where 1=Rare, 5=AlmostCertain."@en .

testing:BehavioralComplianceTesting a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Behavioral Compliance Testing"@en ;
    testing:migrationDate "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:BehavioralComplianceTesting ;
    rdfs:comment """Tests whether a component's behavior satisfies its
    BehaviorConcern specification, not merely whether the component
    exists and compiles. Distinguished from structural testing (file
    exists, imports present, syntax valid) which is susceptible to
    decorative compliance."""@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf testing:LLMTestingMethod ;
    skos:definition """Testing methodology that verifies whether LLM-generated
    components satisfy their BehaviorConcern specifications through
    observable behavioral outcomes rather than structural or syntactic
    indicators"""@en ;
    prov:wasDerivedFrom reliability:BehavioralComplianceTesting .

testing:ChainOfVerification a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Chain of Verification"@en ;
    testing:migrationDate "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:ChainOfVerification ;
    rdfs:comment """Multi-step process: generate initial response, create verification questions, 
    answer them, revise initial response based on verification."""@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf testing:LLMTestingMethod ;
    skos:definition "ChainOfVerification is an LLM testing method that validates model outputs through sequential verification steps, where each step independently checks a different aspect of the response's factual accuracy and logical consistency."@en ;
    prov:wasDerivedFrom reliability:ChainOfVerification .

testing:IntegrationTesting a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Integration Testing"@en ;
    testing:migrationDate "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:IntegrationTesting ;
    rdfs:comment "Validates interfaces and data flow between components"@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf testing:TestingMethodology ;
    skos:definition "IntegrationTesting is a testing concept that verifies the correct interaction between combined software components, system interfaces, and external dependencies to detect integration boundary failures and data flow errors."@en ;
    prov:wasDerivedFrom reliability:IntegrationTesting .

testing:RegressionTesting a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Regression Testing"@en ;
    testing:migrationDate "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:RegressionTesting ;
    rdfs:comment "Critical for maintaining reliability during evolution"@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf testing:TestingMethodology ;
    skos:definition "RegressionTesting is a testing concept that re-executes previously passing test cases after system modifications to ensure that changes have not introduced new failures or degraded existing reliability characteristics."@en ;
    prov:wasDerivedFrom reliability:RegressionTesting .

testing:SelfCheckGPT a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "SelfCheckGPT"@en ;
    testing:migrationDate "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:SelfCheckGPT ;
    rdfs:comment """Assumes hallucinated content is not reproducible across samples. 
    Compares multiple outputs for consistency to identify hallucinations."""@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf testing:LLMTestingMethod ;
    skos:definition "SelfCheckGPT is a hallucination detection method that uses sampling-based self-evaluation to identify inconsistencies across multiple LLM responses, detecting confabulated content without requiring external knowledge sources."@en ;
    prov:wasDerivedFrom reliability:SelfCheckGPT .

testing:SystemTesting a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "System Testing"@en ;
    testing:migrationDate "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:SystemTesting ;
    rdfs:comment "End-to-end validation of system behavior"@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf testing:TestingMethodology ;
    skos:definition "SystemTesting is a testing concept that evaluates the complete integrated system against specified requirements, verifying end-to-end functionality, reliability characteristics, and quality attribute compliance."@en ;
    prov:wasDerivedFrom reliability:SystemTesting .

testing:TestCoverageMeasure a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "TestCoverageMeasure"@en ;
    dcterms:isPartOf <http://example.org/testing> ;
    rdfs:comment "Measurements quantifying test thoroughness and adequacy."@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf qc:QualityMetric,
        testing:TestingConcept ;
    skos:definition "Measurements quantifying test thoroughness and adequacy."@en .

testing:UnitTesting a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Unit Testing"@en ;
    testing:migrationDate "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:UnitTesting ;
    rdfs:comment "Finest-grained level of testing, focuses on single functions or classes"@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf testing:TestingMethodology ;
    skos:definition "UnitTesting is a testing concept that verifies the correctness of individual software components in isolation, testing specific functions, methods, or classes against their specified behavior and boundary conditions."@en ;
    prov:wasDerivedFrom reliability:UnitTesting .

testing:appliedMethodology a owl:NamedIndividual,
        owl:ObjectProperty ;
    rdfs:label "applied methodology"@en ;
    dcterms:isPartOf <http://example.org/testing> ;
    rdfs:domain testing:Test ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:range testing:TestingMethodology ;
    skos:definition "Links a Test artifact to the TestingMethodology it instantiates. For example, a UnitTest individual hasMethodology UnitTesting."@en .

ae:BenchmarkingSuite a owl:Class ;
    rdfs:label "Benchmarking Suite"@en ;
    measurement:hasMeasurementSubject measurement:ProgramAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "SPEC CPU Benchmarks Standard Performance Evaluation Corporation"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:AnalysisResource ;
    owl:disjointWith ae:ComplexityAnalysisTool,
        ae:SurveyPaper,
        ae:VisualizationTool ;
    skos:definition "A standardized collection of problem instances and measurement protocols for evaluating and comparing algorithm implementations under controlled conditions, providing reproducible performance data."@en .

ae:BeyondWorstCaseEra a owl:Class ;
    rdfs:label "Beyond Worst-Case Era"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Roughgarden 2019 Beyond Worst-Case Analysis CACM 62(3)"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:FieldEvolution ;
    skos:definition "The modern period from 2000s onward characterized by smoothed analysis, fine-grained complexity, parameterized algorithms, and learning-augmented algorithm analysis extending beyond classical worst-case perspectives."@en .

ae:BigThetaNotation a owl:Class ;
    rdfs:label "Big-Theta Notation"@en ;
    measurement:hasMeasurementSubject measurement:AlgorithmAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Cormen et al 2022 Ch3"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:AsymptoticNotation ;
    owl:disjointWith ae:LittleOhNotation,
        ae:LittleOmegaNotation ;
    skos:definition "The notation Theta(g(n)) denoting all functions bounded both above and below by constant multiples of g(n) for sufficiently large n, indicating the function grows at exactly the same rate as g(n)."@en .

ae:CaseAnalysisStrategy a owl:Class ;
    rdfs:label "Case Analysis Strategy"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Cormen et al 2022 Ch2"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf [ ],
        ae:AnalysisArchitecture ;
    owl:disjointWith ae:FrameworkPhase ;
    skos:definition "A strategy for analyzing algorithm efficiency under specific input assumptions, selecting among worst-case, best-case, average-case, and amortized analysis depending on the guarantees needed."@en .

ae:CompilerOptimization a owl:Class ;
    rdfs:label "Compiler Optimization Guidance"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Aho et al 2006 Compilers Principles Techniques and Tools 2e"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:UseCase ;
    owl:disjointWith ae:AlgorithmPortfolio,
        ae:AutomatedAlgorithmDesign,
        ae:CompetitiveProgramming,
        ae:EducationalApplication,
        ae:MLAugmentedAnalysis ;
    skos:definition "Using algorithm efficiency analysis to inform compiler transformations such as loop unrolling, vectorization, and cache-aware scheduling that improve constant factors without changing asymptotic complexity."@en .

ae:ComplexityClass a owl:Class ;
    rdfs:label "Complexity Class"@en ;
    measurement:hasMeasurementSubject measurement:ComputationalProblemAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Arora and Barak 2009 Computational Complexity"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:Taxonomy ;
    owl:disjointWith ae:AlgorithmFamily,
        ae:EfficiencyClass,
        ae:ParameterizedComplexityClass,
        ae:ProblemCategory ;
    skos:definition "A set of computational problems that share a common bound on resources required by any algorithm solving them, forming the fundamental classification system of computational complexity theory."@en .

ae:DynamicProgrammingFamily a owl:Class ;
    rdfs:label "Dynamic Programming Family"@en ;
    measurement:hasMeasurementSubject measurement:AlgorithmAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Cormen et al 2022 Ch14"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:AlgorithmFamily ;
    owl:disjointWith ae:BacktrackingFamily,
        ae:GreedyFamily,
        ae:RandomizedFamily ;
    skos:definition "Algorithms solving overlapping subproblems by storing intermediate results in a table, avoiding redundant computation and typically achieving polynomial time for problems that would otherwise require exponential brute force."@en .

ae:EmpiricalAnalysisMethod a owl:Class ;
    rdfs:label "Empirical Analysis Method"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Sec2.6"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:AnalysisMethod ;
    owl:disjointWith ae:AdversaryArgumentMethod,
        ae:AutomatedComplexityAnalysis,
        ae:HybridAnalysis,
        ae:ProbabilisticAnalysis,
        ae:VisualizationAnalysis ;
    skos:definition "An experimental approach analyzing algorithm efficiency by implementing it, running it on sample inputs, measuring performance metrics, and analyzing data to infer the efficiency class."@en .

ae:FormalVerificationRelationship a owl:Class ;
    rdfs:label "Formal Verification Relationship"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Nipkow et al 2002 Isabelle/HOL Springer LNCS 2283"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:InterDomainRelationship ;
    owl:disjointWith ae:CryptographyRelationship,
        ae:MachineLearningRelationship,
        ae:ParallelComputingRelationship,
        ae:QuantumComputingRelationship,
        ae:SoftwareEngineeringRelationship ;
    skos:definition "The connection between formal verification and algorithm analysis, where proof assistants machine-verify complexity bounds and complexity analysis informs verification procedure feasibility."@en .

ae:FoundationalContribution a owl:Class ;
    rdfs:label "Foundational Contribution"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Knuth 1997 The Art of Computer Programming Vol1 3e"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:HistoricalContext ;
    owl:disjointWith ae:FieldEvolution,
        ae:HistoricalCaseStudy,
        ae:KeyContributor ;
    skos:definition "A seminal intellectual contribution that established a core concept, technique, or result in algorithm efficiency analysis, such as Knuth systematic treatment or Tarjan amortized analysis."@en .

ae:RatioBasedEstimation a owl:Class ;
    rdfs:label "Ratio-Based Order Estimation"@en ;
    measurement:hasMeasurementSubject measurement:ProgramAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Sec2.6"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:EmpiricalMethod ;
    owl:disjointWith ae:ProfilingMethod,
        ae:ScatterplotAnalysis,
        ae:StatisticalInference ;
    skos:definition "An empirical technique computing ratios M(2n)/M(n) from measured data to determine efficiency class, where convergence to 2, 4, 8 reveals linear, quadratic, cubic behavior respectively."@en .

ae:ReductionismInAnalysis a owl:Class ;
    rdfs:label "Reductionism in Analysis"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Introduction to the Design and Analysis of Algorithms 3e Sec2.1"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:PhilosophicalFoundation ;
    owl:disjointWith ae:ChurchTuringThesis,
        ae:ComplexityTheoreticWorldview,
        ae:ComputationalModelTheory,
        ae:InformationTheoreticBound,
        ae:QuantumComputabilityPrinciple ;
    skos:definition "The analytical philosophy of decomposing an algorithm total computational work into a single representative basic operation whose execution count serves as a proxy for overall running time, enabling tractable mathematical analysis by ignoring constant factors and lower-order terms."@en .

ae:SearchProblem a owl:Class ;
    rdfs:label "Search Problem"@en ;
    measurement:hasMeasurementSubject measurement:ComputationalProblemAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Arora and Barak 2009 Computational Complexity CUP"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:ProblemCategory ;
    owl:disjointWith ae:CountingProblem,
        ae:EnumerationProblem ;
    skos:definition "A problem requiring the construction of a witness or solution satisfying given constraints, generalizing decision problems by demanding a constructive answer rather than mere existence verification."@en .

ae:SubstitutionMethod a owl:Class ;
    rdfs:label "Substitution Method"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Cormen et al 2022 Sec4.3"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:AnalysisTool ;
    owl:disjointWith ae:AccountingMethod,
        ae:AggregateMethod,
        ae:BackwardSubstitution,
        ae:CharacteristicEquation,
        ae:DecisionTreeTechnique,
        ae:LimitComparison,
        ae:PotentialMethod,
        ae:RecursionTreeMethod,
        ae:StirlingApproximation ;
    skos:definition "A technique for solving recurrence relations by guessing the form of the solution and then using mathematical induction to verify the guess and determine appropriate constants, requiring both intuition and rigorous proof."@en .

ae:Textbook a owl:Class ;
    rdfs:label "Textbook"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "ACM Digital Library"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:AnalysisResource ;
    owl:disjointWith ae:BenchmarkingSuite,
        ae:ComplexityAnalysisTool,
        ae:ProfilingTool,
        ae:SurveyPaper,
        ae:VisualizationTool ;
    skos:definition "A comprehensive published reference covering algorithm efficiency analysis theory and practice, serving as the primary pedagogical resource for students and researchers in the field."@en .

configuration:AnnotationChange a owl:Class ;
    rdfs:label "Annotation Change"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Modification to annotation property values."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/> ;
    rdfs:subClassOf configuration:DocumentationChange ;
    skos:definition "A structural change that modifies the non-logical metadata of ontology elements such as labels, definitions, comments, or provenance annotations, affecting human comprehension without altering reasoning outcomes."@en ;
    skos:example "Changing rdfs:label from 'Automobile' to 'Car' for better clarity."@en .

configuration:AxiomChange a owl:Class ;
    rdfs:label "Axiom Change"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Addition, deletion, or modification of logical axioms."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:SemanticChange ;
    skos:definition "A semantic change that modifies the logical axioms associated with a class or property, such as adding or removing disjointness declarations, equivalence definitions, or property chain assertions."@en ;
    skos:example "Adding axiom 'Vehicle subClassOf hasEngine some Engine' adds semantic constraint."@en .

configuration:ClassModification a owl:Class ;
    rdfs:label "Class Modification"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Change to existing class properties, axioms, or characteristics."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:ClassChange ;
    skos:definition "A class change that alters the existing definition of a class by adding, removing, or modifying its restrictions, annotations, or equivalence axioms without changing its position in the hierarchy."@en ;
    skos:example "Changing class 'Truck' definition from 'large vehicle' to 'heavy goods vehicle'."@en .

configuration:DocumentationChange a owl:Class ;
    rdfs:label "Documentation Change"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Change to annotation properties, labels, comments, or examples."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/>,
        <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf configuration:ChangeOperation ;
    skos:definition "A change operation that modifies only the non-logical annotations of the ontology such as labels, definitions, comments, or provenance metadata, without affecting the axiom set or reasoning outcomes."@en ;
    skos:example "Adding rdfs:comment 'A car is a wheeled motor vehicle' to Car class."@en .

configuration:HtmlArtifact a owl:Class ;
    rdfs:label "HTML Artifact"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "ISO/IEC 15289:2019 Systems and software engineering — Content of life-cycle information items. W3C HTML5 Living Standard."@en ;
    rdfs:comment "An EngineeringArtefact that is a self-contained interactive HTML application or tool, embedding JavaScript and CSS. Includes ontology workbenches, dashboards, and educational tools. Filename: {name}_v{M}_{m}_{p}.html."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://html.spec.whatwg.org/>,
        <https://www.iso.org/standard/54846.html> ;
    rdfs:subClassOf configuration:EngineeringArtefact ;
    skos:definition "An EngineeringArtefact that is a self-contained interactive HTML application or tool, embedding JavaScript and CSS. Includes ontology workbenches, dashboards, and educational tools. Filename: {name}_v{M}_{m}_{p}.html."@en ;
    skos:example "ontology_workbench_v26_1_5.html — interactive SHACL assessment workbench, version 26.1.5"@en .

configuration:LogicalChange a owl:Class ;
    rdfs:label "Logical Change"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Change affecting logical inferences or reasoning outcomes."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:SemanticChange ;
    skos:definition "A semantic change that alters the formal logical content of the ontology in a way that modifies the set of inferences a reasoner can derive, as opposed to purely annotation or metadata changes."@en ;
    skos:example "Adding subclass axiom enables reasoner to classify instances differently."@en .

configuration:MeaningChange a owl:Class ;
    rdfs:label "Meaning Change"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Fundamental change to the intended meaning of a concept."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:SemanticChange ;
    skos:definition "A semantic change that redefines the intended interpretation of an existing ontology element, even without modifying its formal axioms, by updating definitions, usage guidelines, or scope documentation."@en ;
    skos:example "Redefining 'Vehicle' from 'transportation device' to 'any movable object'."@en .

configuration:MigrationStrategy a owl:Class ;
    rdfs:label "Migration Strategy"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Overall approach and plan for executing ontology migration."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1>,
        <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf configuration:MigrationManagement ;
    skos:definition "A documented plan specifying the sequence of steps, transformation rules, validation checks, and rollback procedures for transitioning between ontology versions with minimal disruption to consumers."@en ;
    skos:example "Big-bang migration strategy updates entire dataset in single operation."@en .

configuration:PropertyModification a owl:Class ;
    rdfs:label "Property Modification"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Changing characteristics of an existing property."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:PropertyChange ;
    skos:definition "A property change that alters the characteristics of an existing property such as its domain, range, functional status, or inverse declaration, potentially affecting all classes using the property."@en ;
    skos:example "Changing 'hasColor' from functional to non-functional property."@en .

configuration:ReleaseSignature a owl:Class ;
    rdfs:label "Release Signature"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Sigstore documentation; SLSA Build Track v1.0; OpenPGP RFC 4880."@en ;
    rdfs:comment "A cryptographic signature over an artifact at release time, asserting authorship and non-tampering. Required for SLSA Level 2+. Stored alongside the artifact as a .sig or .asc file."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf configuration:ConfigurationManagementConcept ;
    skos:definition "A cryptographic signature over an artifact at release time, asserting authorship and non-tampering. Required for SLSA Level 2+. Stored alongside the artifact as a .sig or .asc file."@en .

configuration:StagingArchive a owl:Class ;
    rdfs:label "Staging archive"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    rdfs:comment "A ProjectArchive whose contents are work-in-progress for a future ecosystem release. Distinct from a DerivativeArchive (which is a re-packaging of an existing source) and from a plain CONTINUATION (which has no future-integration intent). Examples: oepack-discipline-and-tooling-v1_1_1.zip ships BP-D14+AMOD v1.4.2 destined for family v17.1.2."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf configuration:ProjectArchive ;
    skos:definition "A ProjectArchive whose contents are work-in-progress for a future ecosystem release. Distinct from a DerivativeArchive (which is a re-packaging of an existing source) and from a plain CONTINUATION (which has no future-integration intent). Examples: oepack-discipline-and-tooling-v1_1_1.zip ships BP-D14+AMOD v1.4.2 destined for family v17.1.2."@en .

configuration:Track a owl:Class ;
    rdfs:label "track"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "OE Pack expansion-plan ontology plan:Track."@en ;
    rdfs:comment "A logically-coherent grouping of proposed sprints within a PlanProposal. Tracks are typically organised by theme (e.g., 'Measurement Readiness Track', 'Vocabulary Promotion Track'). They can have CrossTrackDependency relations."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf configuration:PlanArtefact ;
    skos:definition "A logically-coherent grouping of proposed sprints within a PlanProposal. Tracks are typically organised by theme (e.g., 'Measurement Readiness Track', 'Vocabulary Promotion Track'). They can have CrossTrackDependency relations."@en .

core:Tester a owl:Class ;
    rdfs:label "Tester"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    dcterms:source "IEEE 12207:2017 §7.2 — Verification process; ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:isDefinedBy <http://example.org/core> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html>,
        <https://www.iso.org/standard/79016.html> ;
    rdfs:subClassOf core:Agent,
        core:Role ;
    owl:disjointWith core:Maintainer ;
    skos:definition "An agent role responsible for designing, executing, and analyzing test cases that validate correctness, completeness, and reliability of engineering artifacts against specified requirements."@en ;
    skos:example "A quality engineer who runs pySHACL against redo_v2_5_5.ttl using meta_shacl_v1_0_1.ttl and verifies Conforms=True V=0 W=0 occupies the Tester role for the a reliability ontology annotation compliance gate."@en .

measurement:CorrectnessMetric a owl:Class ;
    rdfs:label "Correctness Metric"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F5 (2026-05-15)."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:CompletenessMetric ;
    skos:definition "Metric measuring logical correctness — absence of contradictions, satisfiability of declared classes. Per Sprint F5."@en .

measurement:PerformanceEfficiencyThresholdRow a owl:Class ;
    rdfs:label "PerformanceEfficiency threshold row (combined ms/triple)"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    rdfs:subClassOf measurement:ThresholdRow ;
    skos:definition "A ThresholdRow specialization keyed on combined (HermiT + SHACL) processing time normalized per triple, in milliseconds. Uses combinedMsPerTripleMin/Max bounds."@en .

measurement:TMOnto a owl:Class ;
    rdfs:label "Tangledness"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Duque-Ramos A. et al. (2016). Journal of Biomedical Semantics 7:63. Table 3 (metric-characteristic mapping) and Table 4 (static scale)."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:Metric ;
    skos:definition "OQuaRE structural metric measuring the mean number of classes with more than one direct ancestor. Higher values indicate a more tangled, multiple-inheritance-rich hierarchy. Per Duque-Ramos 2016, TMOnto contributes to the StructuralCharacteristic and aggregates Tangledness sub-characteristic."@en .

meta:Alignment a owl:Class ;
    rdfs:label "Alignment"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "ISO/IEC 24765:2017 Systems and software engineering — Vocabulary."@en ;
    rdfs:comment "Definition authored during a reliability ontology remediation 2026-02-09; pending domain expert review."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-642-38721-0> ;
    skos:definition "A reusable design approach for ensuring that ontology components are properly aligned with domain requirements, external standards, and inter-ontology mappings."@en ;
    skos:example "Adding owl:equivalentClass triples mapping ex:QualityAssessment to qc:QualityAssessmentProfile from an external quality ontology, after verifying semantic equivalence, is ontology Alignment."@en .

meta:AlignmentEvaluation a owl:Class ;
    rdfs:label "Alignment Evaluation"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Assessment of alignment quality and correctness."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:Activity,
        meta:Alignment ;
    skos:definition "A quality assurance activity that measures the accuracy, completeness, and correctness of ontology alignment mappings by comparing generated correspondences against a reference alignment or expert judgment."@en ;
    skos:example "Evaluation shows alignment achieves 0.92 precision, 0.88 recall."@en .

meta:AlignmentPattern a owl:Class ;
    rdfs:label "Alignment Pattern"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Reusable template for common alignment scenarios."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-642-38721-0> ;
    rdfs:subClassOf kb:EngineeringPattern,
        meta:Alignment ;
    skos:definition "A reusable strategy for establishing correspondences between elements of different ontologies, classified by the structural relationship type such as class alignment, property alignment, or instance alignment."@en ;
    skos:example "1-to-1 equivalence pattern maps single class to single class."@en .

meta:BackwardChaining a owl:Class ;
    rdfs:label "Backward Chaining Reasoner"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Description Logic Handbook (Baader et al., 2003). Cambridge University Press."@en ;
    rdfs:comment "Query-driven reasoner deriving facts on-demand when answering queries."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://www.w3.org/Submission/SWRL/> ;
    rdfs:subClassOf meta:RuleReasoner ;
    skos:definition "A rule reasoning strategy that starts from a query goal and works backward through rules to find supporting facts, evaluating only the rules relevant to answering the specific query."@en ;
    skos:example "Prolog-based reasoners use backward chaining for on-demand inference."@en .

meta:CollaborativeEditor a owl:Class ;
    rdfs:label "Collaborative Editor"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Protégé: A Tool for Editing OWL Ontologies. Stanford University. https://protege.stanford.edu/"@en ;
    rdfs:comment "Editor designed specifically for team-based concurrent ontology development."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1145/2063518.2063520> ;
    rdfs:subClassOf meta:OntologyEditor ;
    skos:definition "An ontology editor that supports multiple simultaneous users with features including change tracking, conflict detection, commenting, role-based permissions, and merge workflows for concurrent development."@en ;
    skos:example "PoolParty enables teams to collaboratively manage enterprise taxonomies and ontologies."@en .

meta:ConsequenceBasedReasoner a owl:Class ;
    rdfs:label "Consequence-Based Reasoner"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "W3C OWL 2 Web Ontology Language (2012). https://www.w3.org/TR/owl2-overview/"@en ;
    rdfs:comment "Reasoner using consequence-driven algorithms for polynomial-time fragments of OWL."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1145/1656274.1656281> ;
    rdfs:subClassOf meta:DLReasoner ;
    skos:definition "A description logic reasoner that derives classification results by computing logical consequences from axioms using consequence-based calculi, typically offering better scalability than tableau methods for lightweight ontology profiles."@en ;
    skos:example "ELK reasoner uses consequence-based methods for fast classification of OWL EL ontologies."@en .

meta:ForwardChaining a owl:Class ;
    rdfs:label "Forward Chaining Reasoner"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Description Logic Handbook (Baader et al., 2003). Cambridge University Press."@en ;
    rdfs:comment "Rule reasoner deriving all possible consequences by forward propagation of rules."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://www.w3.org/Submission/SWRL/> ;
    rdfs:subClassOf meta:RuleReasoner ;
    skos:definition "A rule reasoning strategy that starts from known facts and repeatedly applies rules to derive new assertions until no more conclusions can be drawn, materializing all entailments eagerly."@en ;
    skos:example "Jena GenericRuleReasoner uses forward chaining to materialize RDFS entailments."@en .

meta:HybridReasoner a owl:Class ;
    rdfs:label "Hybrid Reasoner"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "W3C OWL 2 Web Ontology Language (2012). https://www.w3.org/TR/owl2-overview/"@en ;
    rdfs:comment "Reasoner combining multiple algorithms or techniques for optimized performance."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1145/1656274.1656281>,
        <https://www.w3.org/TR/owl2-primer/> ;
    rdfs:subClassOf meta:DLReasoner ;
    skos:definition "A reasoning tool that combines description logic tableau algorithms with rule-based inference, handling both terminological reasoning over class definitions and assertional reasoning over instance data."@en ;
    skos:example "RacerPro combines tableaux reasoning with specialized handling for nominals and concrete domains."@en .

meta:InconsistencyDetector a owl:Class ;
    rdfs:label "Inconsistency Detector"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Description Logic Handbook (Baader et al., 2003). Cambridge University Press."@en ;
    rdfs:comment "Specialized tool for identifying and explaining logical inconsistencies in ontologies."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1145/1656274.1656281> ;
    rdfs:subClassOf meta:ReasoningTool ;
    skos:definition "A reasoning tool specialized in identifying logical contradictions within an ontology, providing explanations of which axiom combinations cause inconsistency to guide targeted repair efforts."@en ;
    skos:example "Pellet explanation service identifies axioms causing inconsistencies in OWL ontologies."@en .

meta:ModelingTool a owl:Class ;
    rdfs:label "Modeling Tool"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Tool for creating conceptual models and domain representations."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2014.6816804> ;
    rdfs:subClassOf meta:DevelopmentTool ;
    skos:definition "A development tool that provides graphical or structured interfaces for creating and editing ontology conceptual models, supporting visual representation of class hierarchies and property relationships."@en ;
    skos:example "Visual ontology modeling tools help domain experts participate in ontology design."@en .

meta:NativeTripleStore a owl:Class ;
    rdfs:label "Native Triple Store"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "RDF Database Systems: Triples Storage and SPARQL Query Processing (Sakr & Al-Naymat, 2010). Springer."@en ;
    rdfs:comment "Triple store with native RDF storage format optimized for semantic data."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://www.w3.org/TR/sparql11-query/> ;
    rdfs:subClassOf meta:TripleStore ;
    skos:definition "A triple store that uses purpose-built data structures optimized for RDF triple storage and graph traversal, rather than layering RDF storage over a general-purpose relational or document database."@en ;
    skos:example "Virtuoso Open Source uses column-store architecture for RDF quads."@en .

meta:OneToManyMapping a owl:Class ;
    rdfs:label "One-to-Many Mapping"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "One-to-Many Mapping - ontology alignment cardinality pattern."@en,
        "Single concept maps to multiple concepts."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-642-38721-0> ;
    rdfs:subClassOf kb:MappingTechnique,
        meta:Mapping ;
    owl:disjointWith meta:OneToOneMapping ;
    skos:definition "A mapping technique that maps a single source element to multiple target elements, typically when the source ontology uses a broader concept that the target ontology splits into more specific classes."@en ;
    skos:example "Vehicle in A maps to Car, Truck in B."@en .

meta:RuleReasoner a owl:Class ;
    rdfs:label "Rule Reasoner"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Description Logic Handbook (Baader et al., 2003). Cambridge University Press."@en ;
    rdfs:comment "Reasoning engine processing rule-based logical inferences over ontologies."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1145/1656274.1656281> ;
    rdfs:subClassOf meta:ReasoningTool ;
    skos:definition "A reasoning tool that applies forward or backward chaining over if-then rules expressed in languages such as SWRL or RIF, complementing description logic reasoning with procedural inference capabilities."@en ;
    skos:example "Jena reasoner supports RDFS and custom rule sets for RDF inference."@en .

meta:SHACLValidator a owl:Class ;
    rdfs:label "SHACL Validator"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Tool validating RDF data against SHACL (Shapes Constraint Language) shapes."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf meta:ValidationTool ;
    skos:definition "A validation tool that evaluates RDF data against SHACL shape constraints, producing a validation report identifying which data nodes violate which shape requirements with explanatory messages."@en ;
    skos:example "TopBraid SHACL API validates RDF data against SHACL shape definitions."@en .

meta:SyntaxAwareEditor a owl:Class ;
    rdfs:label "Syntax-Aware Editor"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Text editor with syntax highlighting and validation for ontology languages."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2014.6816804> ;
    rdfs:subClassOf meta:TextEditor ;
    skos:definition "A text editor enhanced with ontology language grammar awareness, providing syntax highlighting, auto-completion, bracket matching, and inline error detection specific to OWL, Turtle, or other serialization formats."@en ;
    skos:example "Sublime Text with Turtle syntax plugin highlights RDF triple patterns."@en .

meta:TextEditor a owl:Class ;
    rdfs:label "Text Editor"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Plain text or code editor adapted for ontology language syntax."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2014.6816804> ;
    rdfs:subClassOf meta:DevelopmentTool ;
    skos:definition "A development tool that provides basic text editing capabilities for working with ontology serialization files directly, offering syntax highlighting and search but without semantic awareness of ontology structures."@en ;
    skos:example "VS Code with RDF/OWL extensions enables text-based ontology development."@en .

meta:UMLTool a owl:Class ;
    rdfs:label "UML Tool"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Tool using UML notation and methodology for ontology modeling."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2014.6816804>,
        <https://www.omg.org/spec/UML/2.5.1/> ;
    rdfs:subClassOf meta:ModelingTool ;
    skos:definition "A modeling tool that uses UML diagram notation adapted for ontology design, representing classes, properties, and relationships in familiar software engineering visual conventions for domain expert communication."@en ;
    skos:example "Enterprise Architect can model ontologies using UML class diagrams with stereotypes."@en .

meta:ValidationTool a owl:Class ;
    rdfs:label "Validation Tool"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Tool checking ontology correctness, quality, and conformance to standards."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html>,
        <https://www.w3.org/TR/shacl/> ;
    rdfs:subClassOf kb:EngineeringTool,
        meta:Tool ;
    skos:definition "A software application that automatically checks ontology artifacts against defined correctness criteria, producing structured reports of violations, warnings, and conformance status for quality assurance workflows."@en ;
    skos:example "OOPS! scanner detects common pitfalls and anti-patterns in OWL ontologies."@en .

meta:VisualModeler a owl:Class ;
    rdfs:label "Visual Modeler"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Graphical tool for visual representation and manipulation of ontology structures."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://www.omg.org/spec/UML/2.5.1/> ;
    rdfs:subClassOf meta:ModelingTool ;
    skos:definition "A modeling tool that provides graphical canvas-based editing of ontology structures, allowing users to create and arrange classes, properties, and restrictions through drag-and-drop visual interaction."@en ;
    skos:example "VOWL editor provides visual notation for OWL ontologies using circles and arrows."@en .

performance:PerformanceConcept a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Performance Concept"@en ;
    dcterms:isPartOf <http://example.org/performance> ;
    rdfs:comment "Discipline-root umbrella for all performance-domain concepts owned by the performance subject. Parents the performance vocabulary. Added per cohesiveness plan v2.2.0 Sprint C2."@en ;
    rdfs:isDefinedBy <http://example.org/performance> ;
    rdfs:subClassOf core:Concept ;
    skos:definition "Discipline-root umbrella for all performance-domain concepts owned by the performance subject. Parents the performance vocabulary. Added per cohesiveness plan v2.2.0 Sprint C2."@en .

performance:PerformanceEfficiency a owl:Class ;
    rdfs:label "Performance Efficiency"@en ;
    measurement:hasMeasurementSubject measurement:OperationalEnvironmentMeasurementSubject ;
    dcterms:isPartOf <http://example.org/performance> ;
    dcterms:source "DRY collapse of duplicate classes: quality:PerformanceEfficiency (OQC v2.3.0) + reliability:PerformanceEfficiency (a reliability ontology v3.0.0). Source-file copies scheduled for deletion at OQC step 8 and a reliability ontology step 9."@en ;
    rdfs:comment "Performance characteristic concerned with the resource usage (time, memory, computational steps, I/O) per unit of work. Connected to AE's AsymptoticNotation via performance:hasTheoreticalComplexity."@en ;
    rdfs:isDefinedBy <http://example.org/performance> ;
    rdfs:subClassOf performance:Performance ;
    skos:definition "Performance characteristic concerned with the resource usage (time, memory, computational steps, I/O) per unit of work. Connected to AE's AsymptoticNotation via performance:hasTheoreticalComplexity."@en .

qc:AssessmentActivity a owl:Class ;
    rdfs:label "Assessment Activity"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25040:2011 §7 - Evaluation Process Model" ;
    rdfs:comment "Groups assessment-related activities."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf qc:QualityDomainEntity ;
    skos:definition "An abstract superclass for activities performed during a quality assessment process, including evaluation, measurement, analysis, and decision-making steps within the assessment lifecycle."@en ;
    skos:example "QualityAssessment is an AssessmentActivity that orchestrates metric computation, finding identification, and gate decision evaluation."@en .

qc:Capacity a owl:Class ;
    rdfs:label "Capacity"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 §4.2.5 - Performance Efficiency (Capacity)" ;
    rdfs:comment "The ability to handle required scale and performance."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35730.html> ;
    rdfs:subClassOf qc:PragmaticQuality ;
    skos:broader qc:PragmaticQuality ;
    skos:definition """A quality dimension that evaluates whether the ontology can handle the 
    required scale, complexity, and performance characteristics. Capacity metrics include axioms 
    per class, reasoning time, query response time, and scalability to large instance datasets."""@en ;
    skos:example """An ontology with adequate capacity has 45 axioms per class on average, 
    classifies in under 5 seconds, and handles 100K instance queries efficiently."""@en ;
    skos:note """For large ontologies (10,000+ triples or 1,000+ classes):
• Use incremental validation strategies
• Partition assessment by modules or namespaces
• Consider distributed reasoning for consistency checks
• Implement caching for repeated metric calculations
• Use sampling techniques for comprehensive coverage metrics
• Monitor memory usage during SPARQL query execution
• Consider time-boxed assessments with progress reporting"""@en ;
    skos:scopeNote "This dimension assesses the ontology's ability to handle assessment at scale. For very large ontologies, specialized tools and strategies may be required."@en .

qc:Clarity a owl:Class ;
    rdfs:label "Clarity"@en ;
    qc:hasMetric measurement:ANOnto ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 §4.2.4 - Operability (Understandability)" ;
    rdfs:comment "The degree to which the ontology is clear and understandable."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35730.html> ;
    rdfs:subClassOf qc:StructuralQuality ;
    skos:broader qc:StructuralQuality ;
    skos:definition """A quality dimension that evaluates how clearly and unambiguously the ontology 
    communicates its intended meaning. Clarity is achieved through precise definitions, 
    well-chosen labels, appropriate examples, consistent terminology, and clear structural organization."""@en ;
    skos:example """A clear ontology uses intuitive class names, provides precise skos:definitions 
    for all terms, includes illustrative examples, and organizes hierarchies logically."""@en ;
    skos:related qc:Conciseness,
        qc:Usability .

qc:Compatibility a owl:Class ;
    rdfs:label "Compatibility"@en ;
    measurement:hasMeasurementSubject measurement:OntologyMeasurementSubject ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Duque-Ramos et al. (2011) §3.3 OQuaRE; ISO/IEC 25010:2023."@en ;
    rdfs:comment "OQuaRE characteristic: degree to which the ontology can co-exist and interact with other ontologies and tools — covers OWL 2 DL profile compliance, reasoner compatibility, alignment to upper ontologies (DOLCE/BFO/SUMO)."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso reliability:Compatibility ;
    rdfs:subClassOf qc:QualityDimension ;
    skos:definition "OQuaRE characteristic: degree to which the ontology can co-exist and interact with other ontologies and tools — covers OWL 2 DL profile compliance, reasoner compatibility, alignment to upper ontologies (DOLCE/BFO/SUMO)."@en ;
    skos:related reliability:Compatibility .

qc:Evidence a owl:Class ;
    rdfs:label "Evidence"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source <https://www.w3.org/TR/sparql11-overview/> ;
    rdfs:comment "Artifact (query, proof, log) supporting a finding or score."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35730.html> ;
    rdfs:subClassOf kb:Deliverable,
        qc:AssessmentOutput ;
    skos:definition """A concrete artifact that provides verifiable support for a finding or score. 
    Evidence includes SPARQL query results, reasoner output logs, SHACL validation reports, 
    test execution transcripts, or statistical analysis results. Evidence ensures traceability 
    and reproducibility of quality assessments."""@en ;
    skos:example """Evidence_SPARQL_001: Query result showing 12 classes without skos:definition, 
    serving as evidence for GapFinding_ClassDocumentation."""@en .

qc:GapFinding a owl:Class ;
    rdfs:label "Gap Finding"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25040:2011 §7.3 - Analysis, Coverage Gap Identification" ;
    rdfs:comment "Indicates missing, incomplete, or uncovered content."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35730.html> ;
    rdfs:subClassOf qc:Finding ;
    skos:definition """A type of finding that identifies missing, incomplete, or insufficiently 
    covered content in an ontology. Gap findings indicate where the ontology does not meet 
    completeness or comprehensiveness requirements, such as missing documentation, untested 
    requirements, or unmapped domain terms."""@en ;
    skos:example """GapFinding_TermMapping: Identifies that 23% of TermDefinitions lack mappings 
    to OntologyComponents, with coverage ratio 0.77 below threshold 0.90."""@en .

qc:Modularity a owl:Class ;
    rdfs:label "Modularity (OQuaRE)"@en ;
    qc:hasMetric measurement:CBOnto,
        measurement:WMCOnto ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Duque-Ramos et al. (2011) §3.3 OQuaRE sub-characteristic."@en ;
    rdfs:comment "OQuaRE Maintainability sub-characteristic: degree to which the ontology can be decomposed into cohesive, loosely-coupled modules. Note: distinct from qc:ModularityMetric, which is the measurement; qc:Modularity is the quality dimension being measured."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso reliability:Modularity ;
    rdfs:subClassOf qc:Maintainability ;
    skos:definition "OQuaRE Maintainability sub-characteristic: degree to which the ontology can be decomposed into cohesive, loosely-coupled modules. Note: distinct from qc:ModularityMetric, which is the measurement; qc:Modularity is the quality dimension being measured."@en ;
    skos:related reliability:Modularity .

qc:NormalizationRule a owl:Class ;
    rdfs:label "Normalization Rule"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    rdfs:comment "A formula declaring how to map a metric value to a normalized Score in [0,1]. STRUCTURAL ONLY in OQC v2.4.0 — no pre-calibrated standard rules are shipped. Subjects requiring non-trivial normalization (e.g., logarithmic compression of a true ratio) author their own NormalizationRule individuals and cite them via qc:hasNormalizationRule. Raw-count metrics SHOULD NOT use NormalizationRule; they should be typed as DescriptiveMetric and reported as integers."@en ;
    rdfs:isDefinedBy <http://example.org/oqc/v2_4_0_metric_kind_extension> ;
    rdfs:subClassOf qc:QualityConcept ;
    skos:definition "A formula declaring how to map a metric value to a normalized Score in [0,1]. STRUCTURAL ONLY in OQC v2.4.0 — no pre-calibrated standard rules are shipped. Subjects requiring non-trivial normalization (e.g., logarithmic compression of a true ratio) author their own NormalizationRule individuals and cite them via qc:hasNormalizationRule. Raw-count metrics SHOULD NOT use NormalizationRule; they should be typed as DescriptiveMetric and reported as integers."@en ;
    skos:scopeNote "The OE Pack Enhancements Proposal v1.0.0 §2 proposed 6 pre-calibrated standard rules. After in-session analysis showing the calibrations only fit COM4061 chapter scale (saturated for production / industrial scales), the standard rules were DROPPED. NormalizationRule is retained as an escape hatch for rare cases."@en .

qc:OntologyEvaluationFramework a owl:Class ;
    rdfs:label "Ontology Evaluation Framework"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Vrandečić, D. (2010). Ontology Evaluation. PhD thesis, KIT. Brank, J., Grobelnik, M., Mladenić, D. (2005). A survey of ontology evaluation techniques. SiKDD 2005."@en ;
    rdfs:comment "An abstract category of methodological frameworks that prescribe metrics, thresholds, and aggregation rules for evaluating ontology quality. Concrete subclasses include OntoQA, OQuaRE, and OntoMetrics."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    skos:definition "An abstract category of methodological frameworks that prescribe metrics, thresholds, and aggregation rules for evaluating ontology quality. Concrete subclasses include OntoQA, OQuaRE, and OntoMetrics."@en .

qc:Recommendation a owl:Class ;
    rdfs:label "Recommendation"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25040:2011 §7.4 - Evaluation Recommendations" ;
    rdfs:comment "Suggested remediation action for a quality finding."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35730.html> ;
    rdfs:subClassOf qc:AssessmentOutput ;
    skos:definition "A suggested remediation action proposed in response to a quality finding, specifying what changes should be made to the ontology to address identified gaps, defects, or quality shortfalls."@en ;
    skos:example "Recommendation: Add skos:definition to 12 undocumented classes to improve Completeness from 85% to 100%."@en .

qc:thresholdValue a owl:DatatypeProperty ;
    rdfs:label "threshold value"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality models. ISO/IEC 25040:2011 Systems and software Quality Requirements and Evaluation — Evaluation process."@en ;
    rdfs:domain measurement:QualityThreshold ;
    rdfs:isDefinedBy <http://purl.org/oqc/ontology> ;
    rdfs:range xsd:decimal ;
    skos:definition "The minimum acceptable numeric value for a QualityThreshold, below which the quality gate evaluation is classified as failing."@en .

reliability:APITest a owl:Class ;
    rdfs:label "API Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "API Test - validates functional behavior."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2008.4578383> ;
    rdfs:subClassOf reliability:FunctionalTest ;
    skos:definition "A functional test that validates the programmatic interface through which external systems query or modify the ontology, verifying correct request handling, response formatting, and error reporting for each endpoint."@en ;
    skos:example "REST endpoint returns 200 OK with valid JSON for GET /ontology/classes?format=owl, validated against OpenAPI schema."@en .

reliability:ActivationEngineering a owl:Class ;
    rdfs:label "Activation Engineering"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "LLM reliability research corpus: Malmqvist 2024, Ma et al. 2024, Ji et al. 2023 (arXiv:2311.05232)" ;
    rdfs:comment """Paradigm shift from 'talking to' the model to 'operating on' it. 
    Directly modifies internal representations to steer behavior."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf reliability:FailureMitigation ;
    skos:altLabel "ITI"@en,
        "Inference-Time Intervention"@en ;
    skos:definition "ActivationEngineering is an inference-time mitigation strategy that directly manipulates internal model activation vectors to steer LLM behavior away from identified pathological patterns without model retraining."@en ;
    skos:example "Applying a 'truthfulness vector' to model activations during inference to reduce hallucination tendency."@en,
        "Modifying layer 15 activations to steer the model away from sycophantic responses when detecting user disagreement signals."@en .

reliability:AlphaTest a owl:Class ;
    rdfs:label "Alpha Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Alpha Test - determines readiness for deployment."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2008.4578383> ;
    rdfs:subClassOf reliability:AcceptanceTest ;
    skos:definition "An internal evaluation phase where the ontology development team tests a pre-release version under controlled conditions, identifying critical defects before exposing the artifact to external stakeholders."@en ;
    skos:example "Internal team validates ontology coverage against 25 competency questions before beta release to external reviewers."@en .

reliability:AxiomTest a owl:Class ;
    rdfs:label "Axiom Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Axiom Test."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.w3.org/TR/shacl/> ;
    rdfs:subClassOf reliability:OntologyTesting ;
    skos:definition "A functional test that verifies individual OWL axioms produce the expected reasoning outcomes, such as correct subsumption inferences, disjointness violations, or entailed property assertions."@en ;
    skos:example "Verifies owl:disjointWith between Hallucination and LLMBehavioralPathology prevents individual dual-classification."@en .

reliability:BehavioralFaultClass a owl:Class ;
    rdfs:label "Behavioral Fault Class"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Avizienis, A., Laprie, J.-C., Randell, B., & Landwehr, C. (2004). Basic concepts and taxonomy of dependable and secure computing. IEEE TDSC."@en ;
    rdfs:comment "Taxonomy distinguishing faults by reproducibility and complexity"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/50641.html> ;
    rdfs:subClassOf reliability:Fault ;
    skos:definition "BehavioralFaultClass is a classification taxonomy for faults based on their activation conditions and manifestation behavior, distinguishing between transient faults that occur sporadically, intermittent faults that recur under specific conditions, and permanent faults that persist until corrective action is taken."@en ;
    skos:example "LLM exhibits pattern of agreeing with user corrections even when the original output was factually correct."@en .

reliability:BetaTest a owl:Class ;
    rdfs:label "Beta Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Beta Test - determines readiness for deployment."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2008.4578383> ;
    rdfs:subClassOf reliability:AcceptanceTest ;
    skos:definition "An external evaluation phase where selected users outside the development team test a pre-release ontology version in realistic scenarios, providing feedback on usability, coverage, and fitness for purpose."@en ;
    skos:example "Three external domain experts evaluate ontology usability, reporting 4 missing definitions and 2 ambiguous hierarchies."@en .

reliability:BlindSpotRegister a owl:Class ;
    rdfs:label "Blind Spot Register"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NEEDS_EXPERT_REVIEW: a reliability ontology-native concept for honest-unknowns tracking. Related to risk register practices in project management (PMI PMBOK)."@en ;
    rdfs:comment "A formal registry of known gaps, unmeasured phenomena, and honest unknowns in a reliability assessment. Implements redo:ZombieClaim prevention by declaring what is NOT known, with severity ratings and remediation proposals. The register itself is a a reliability ontology safeguard against the tutorial/paper becoming a source of zombie claims."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf reliability:ProcessControlLayer ;
    skos:definition "A formal registry of known gaps, unmeasured phenomena, and honest unknowns in a reliability assessment. Implements redo:ZombieClaim prevention by declaring what is NOT known, with severity ratings and remediation proposals. The register itself is a a reliability ontology safeguard against the tutorial/paper becoming a source of zombie claims."@en ;
    skos:example "Blind Spot Register catalogs 8 unknowns: sycophancy in IT Ops (HIGH), architectural drift measurement (HIGH), test suite theater rate (MED), etc."@en .

reliability:Bohrbug a owl:Class ;
    rdfs:label "Bohrbug"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://www.grottke.de/documents/AClassificationOfSWFaults.pdf> ;
    rdfs:comment """Named after the Bohr atom model (predictable electron orbits). 
    Bohrbugs manifest consistently under well-defined conditions and are typically 
    straightforward to diagnose and fix."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/50641.html> ;
    rdfs:subClassOf reliability:BehavioralFaultClass ;
    skos:altLabel "Deterministic Fault"@en ;
    skos:definition "Bohrbug is a software fault type that exhibits deterministic, easily reproducible behavior under consistent conditions, named by analogy to the Bohr atomic model's predictable electron orbits and classical mechanics."@en ;
    skos:example "A null pointer exception that reliably occurs whenever a user submits an empty form field."@en,
        "Null pointer exception consistently thrown when user submits form with empty required field."@en .

reliability:BoundaryTest a owl:Class ;
    rdfs:label "Boundary Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Boundary Test - pushes ontology beyond normal operational limits."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2008.4578383> ;
    rdfs:subClassOf reliability:StressTest ;
    skos:definition "A test case that evaluates ontology behavior at the edges of valid input ranges, including maximum cardinalities, extreme literal values, and boundary conditions for datatype restrictions."@en ;
    skos:example "SPARQL query with 50-level nested OPTIONAL clauses, testing reasoner stack depth limits."@en .

reliability:BudgetConstraint a owl:Class ;
    rdfs:label "Budget Constraint"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:comment "BudgetConstraint is an economic constraint that establishes financial boundaries on reliability engineering investments, requiring cost-benefit analysis to prioritize mitigation strategies within available resources."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf reliability:CostConstraint ;
    skos:definition "BudgetConstraint is an economic constraint that establishes financial boundaries on reliability engineering investments, requiring cost-benefit analysis to prioritize mitigation strategies within available resources."@en ;
    skos:example "Annual reliability testing budget capped at $25K, constraining tool selection to open-source SHACL validators."@en .

reliability:BusinessAcceptanceTest a owl:Class ;
    rdfs:label "Business Acceptance Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Business Acceptance Test - determines readiness for deployment."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2008.4578383> ;
    rdfs:subClassOf reliability:AcceptanceTest ;
    skos:definition "An acceptance test where business stakeholders evaluate whether the ontology supports their specific business processes, decision-making needs, and reporting requirements under realistic operational conditions."@en ;
    skos:example "Product owner confirms ontology supports all 12 business use cases documented in requirements specification."@en .

reliability:CalibrationMonitoring a owl:Class ;
    rdfs:label "Calibration Monitoring"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Geng et al. (2024). NAACL 2024."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:LLMTestingMethod ;
    skos:definition """Continuous or periodic assessment of LLM confidence calibration in production, 
    including stratified monitoring across user demographics, query types, and domains to identify 
    subpopulations with poor calibration requiring targeted intervention. Includes temperature 
    scaling, Platt scaling, and isotonic regression as recalibration methods."""@en ;
    skos:example "Weekly calibration monitoring reveals ECE degradation from 0.08 to 0.18 in medical domain queries after a model update, triggering recalibration."@en .

reliability:CapacityTest a owl:Class ;
    rdfs:label "Capacity Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Capacity Test - pushes ontology beyond normal operational limits."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2008.4578383> ;
    rdfs:subClassOf reliability:StressTest ;
    skos:definition "A stress test variant that determines the maximum number of simultaneous users, queries, or data volume the ontology system can handle while still meeting minimum service-level performance requirements."@en ;
    skos:example "Incrementally loading triples from 100K to 5M, measuring point where query latency exceeds 1-second SLA."@en .

reliability:CascadingFailure a owl:Class ;
    rdfs:label "Cascading Failure"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Avizienis, A., Laprie, J.-C., Randell, B., & Landwehr, C. (2004). Basic Concepts and Taxonomy of Dependable and Secure Computing. IEEE TDSC, 1(1), 11-33."@en ;
    rdfs:comment "A failure mode in which an initial component failure triggers a chain of subsequent failures across dependent components, propagating through the system architecture and potentially causing widespread service degradation or total system collapse."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/50641.html> ;
    rdfs:subClassOf reliability:FailureType ;
    skos:definition "A failure mode in which an initial component failure triggers a chain of subsequent failures across dependent components, propagating through the system architecture and potentially causing widespread service degradation or total system collapse."@en ;
    skos:example "Database failure triggers cache miss storm, overwhelming backup database, causing API gateway timeout cascade."@en .

reliability:ClassDefinitionTest a owl:Class ;
    rdfs:label "Class Definition Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Class Definition Test."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.w3.org/TR/shacl/> ;
    rdfs:subClassOf reliability:OntologyTesting ;
    skos:definition "A unit test that verifies a specific class definition by checking its superclass relationships, restriction axioms, annotation completeness, and individual classification behavior in isolation."@en ;
    skos:example "Verifies every owl:Class has exactly one skos:definition with language tag and minimum 15-word length."@en .

reliability:CompatibilityTest a owl:Class ;
    rdfs:label "Compatibility Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Tests that verify interoperability with other ontologies and systems."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2008.4578383> ;
    rdfs:subClassOf reliability:NonFunctionalTest ;
    skos:definition "A non-functional test that verifies the ontology loads, parses, and reasons correctly across different tools, reasoners, and triple stores, detecting platform-specific interpretation differences."@en ;
    skos:example "Ontology tested across HermiT 1.4, Pellet 2.4, and FaCT++ with consistent classification results on 234 classes."@en .

reliability:CompetenceParadox a owl:Class ;
    rdfs:label "Competence Paradox"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Forensic analysis of GamifyOnt/G4E validation conversation, February 2026."@en ;
    rdfs:comment """LLM behavioral pathology where the model possesses the capability to 
    perform a task but does not apply that capability unless explicitly prompted. 
    The competence exists in a dormant state — it activates on direct request 
    but not on the model's own initiative during assessment.
    
    Context-independent: applies to ANY situation where a more thorough method 
    exists but the assessor uses a shallower one. Originally identified in 
    tooling deployment (v2.1.0: Java/HermiT dormant), subsequently confirmed 
    in verification method selection (v2.2.0: structured Python cross-file 
    audit was available but assessor used superficial grep counts instead).
    
    This is structurally distinct from capability limitations. The model can 
    install Java 21, download ROBOT, debug OWL API serialization, and trace 
    HermiT inconsistency explanations — but this competence was not exercised 
    during the initial assessment that declared these tasks impossible. Similarly, 
    the model can write structured cross-file audits with exact-match verification — 
    but this competence was not exercised during initial verification that 
    declared changes 'all verified.'
    
    Distinguished from EffortAvoidanceBias: effort avoidance is the rationalization 
    mechanism; CompetenceParadox is the underlying structural asymmetry between 
    capability-when-prompted and capability-on-initiative.
    
    Distinguished from PathOfLeastResistance: path of least resistance favors 
    generation over integration; CompetenceParadox favors declaration over attempt."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:LLMBehavioralPathology ;
    owl:disjointWith reliability:PathOfLeastResistance ;
    skos:definition """LLM behavioral pathology where the model possesses the capability to 
    perform a task but does not apply that capability unless explicitly prompted. 
    The competence exists in a dormant state — it activates on direct request 
    but not on the model's own initiative during assessment.
    
    Context-independent: applies to ANY situation where a more thorough method 
    exists but the assessor uses a shallower one. Originally identified in 
    tooling deployment (v2.1.0: Java/HermiT dormant), subsequently confirmed 
    in verification method selection (v2.2.0: structured Python cross-file 
    audit was available but assessor used superficial grep counts instead).
    
    This is structurally distinct from capability limitations. The model can 
    install Java 21, download ROBOT, debug OWL API serialization, and trace 
    HermiT inconsistency explanations — but this competence was not exercised 
    during the initial assessment that declared these tasks impossible. Similarly, 
    the model can write structured cross-file audits with exact-match verification — 
    but this competence was not exercised during initial verification that 
    declared changes 'all verified.'
    
    Distinguished from EffortAvoidanceBias: effort avoidance is the rationalization 
    mechanism; CompetenceParadox is the underlying structural asymmetry between 
    capability-when-prompted and capability-on-initiative.
    
    Distinguished from PathOfLeastResistance: path of least resistance favors 
    generation over integration; CompetenceParadox favors declaration over attempt."""@en ;
    skos:example """The LLM successfully debugs OWL API serialization roundtrip issues, 
    identifies rdf:langString vs xsd:string range violations, and fixes 
    SHACL/OWL property type misalignments — demonstrating deep ontology 
    engineering competence that was entirely dormant during the prior 
    assessment phase."""@en .

reliability:CompetencyQuestionTesting a owl:Class ;
    rdfs:label "Competency Question Testing"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Testing each competency question against ontology."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.w3.org/TR/shacl/> ;
    rdfs:subClassOf reliability:OntologyTesting ;
    skos:definition "A requirement validation technique that executes SPARQL queries corresponding to each competency question against the populated ontology, verifying the ontology can answer all specified questions correctly."@en ;
    skos:example "SPARQL query 'Which mitigation strategies address Sycophancy?' returns 3+ results from ontology ABox."@en .

reliability:ComponentTest a owl:Class ;
    rdfs:label "Component Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Component Test - validates functional behavior."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2008.4578383> ;
    rdfs:subClassOf reliability:FunctionalTest ;
    skos:definition "A functional test that verifies a specific ontology module or component functions correctly in isolation, checking its internal class hierarchy, restrictions, and property definitions independently."@en ;
    skos:example "Individual SHACL shape tested in isolation: MitigationStrategyShape correctly flags class missing core:mitigates."@en .

reliability:Confabulation a owl:Class ;
    rdfs:label "Confabulation"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ji, Z., et al. (2023). Survey of Hallucination in Natural Language Generation. ACM Computing Surveys."@en ;
    rdfs:comment "A subclass of intrinsic hallucination where the LLM generates plausible-sounding but fabricated narrative content that contradicts or is unsupported by the provided source context, often presenting invented details with high apparent confidence."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1145/3571730> ;
    rdfs:subClassOf reliability:IntrinsicHallucination ;
    skos:definition "A subclass of intrinsic hallucination where the LLM generates plausible-sounding but fabricated narrative content that contradicts or is unsupported by the provided source context, often presenting invented details with high apparent confidence."@en ;
    skos:example "LLM generates detailed patient history including fabricated lab values and medication dates not present in input records."@en .

reliability:ConsistencyTesting a owl:Class ;
    rdfs:label "Consistency Testing"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Liu et al. 2025, Foundation Agents, arXiv:2504.01990"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:LLMTestingMethod ;
    skos:definition "ConsistencyTesting is a testing method that evaluates the consistency of LLM outputs across multiple generations of the same prompt, measuring variance, reproducibility, and self-agreement under identical conditions to assess reliability."@en ;
    skos:example "Generating 100 responses to 'What is 2+2?' and verifying that 100% return '4' as Pass@all verification of arithmetic consistency."@en,
        "Generating 100 responses to 'What is the capital of France?' and measuring that >99% return 'Paris'."@en .

reliability:CountDrift a owl:Class ;
    rdfs:label "Count Drift"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.12 — derived from conversation_audit_v1_0_0.md §4 D-1 (2026-05-01): an algebraic framework blueprint v3.0.3 lock #6c reported '+28 classes / +51 properties → 82/111' against v3.2.0 target; verified-real numbers were '+42 / +85 → 96/145'. The wrong count propagated through PBI-013 acceptance criteria for one sprint cycle before fit-gap closure (D-2) caught it."@en ;
    rdfs:comment "A count is repeated downstream from an upstream defective derivation; the propagation is what makes this distinct from a one-off hallucination — the wrong number becomes a 'verified' anchor for further work. Detection: requires recomputing the count against current source-of-truth artefacts, not against prior text."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:Drift,
        reliability:OutputFidelityDrift ;
    owl:disjointWith reliability:DataFabrication ;
    skos:definition "A drift pathology in which a quantitative claim (count of classes, properties, files, tokens, etc.) diverges from a recomputable ground truth and the divergence is not flagged. Often masquerades as a confident verified statement because the original computation was correct against an earlier version of the artefact."@en ;
    skos:example "Real audit event 2026-04-28 (an algebraic framework blueprint v3.0.3 D-2): '+28 classes / +51 properties → 82/111' for v3.2.0 reconciled to '+42 / +85 → 96/145' after exhaustive enumeration against on-disk archives. Severity HIGH because PBI-013 acceptance criteria still cited stale counts when the upstream blueprint had been corrected."@en .

reliability:DecorativeComplianceDetection a owl:Class ;
    rdfs:label "Decorative Compliance Detection"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Avizienis, A., Laprie, J.-C., Randell, B., & Landwehr, C. (2004). Basic Concepts and Taxonomy of Dependable and Secure Computing. IEEE Transactions on Dependable and Secure Computing, 1(1), 11-33. DOI:10.1109/TDSC.2004.2"@en ;
    rdfs:comment """Applies EmpiricalTest methodology specifically to detect
    decorative compliance. Core technique: modify data source values, reload
    application without code changes, verify behavior reflects new values.
    Components that do not respond to data source changes are decorative
    regardless of their structural validity."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf reliability:AdversarialTesting ;
    skos:definition """Adversarial testing method that detects decorative
    compliance by mutating data source values and verifying that
    application behavior changes correspondingly, identifying components
    that are structurally present but functionally disconnected"""@en ;
    skos:example "Adversarial probe submits 20 minimal-effort responses to quality checks, measuring how many pass surface validation."@en .

reliability:DecorativeComplianceRate a owl:Class ;
    rdfs:label "Decorative Compliance Rate"@en ;
    measurement:hasMeasurementSubject measurement:LLMMeasurementSubject ;
    reliability:hasUnit "ratio (0.0 to 1.0)" ;
    reliability:measuresAttribute reliability:DecorativeCompliance ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Avizienis, A., Laprie, J.-C., Randell, B., & Landwehr, C. (2004). Basic Concepts and Taxonomy of Dependable and Secure Computing. IEEE Transactions on Dependable and Secure Computing, 1(1), 11-33. DOI:10.1109/TDSC.2004.2"@en ;
    rdfs:comment """Formula: DCR = decorative_components / total_components.
    A component is decorative if it is structurally present (file exists,
    imports present, syntax valid) but functionally disconnected from the
    target architecture. Empirically observed: DCR = 1.0 (36/36) in reliability assessment
    case study. DCR > 0.0 indicates compliance enforcement failure."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf measurement:LLMReliabilityMetric ;
    skos:definition """Ratio of components that are structurally present and
    syntactically valid but functionally disconnected from the target
    architecture, measuring the extent of decorative compliance across
    a system or deliverable"""@en ;
    skos:example "12 of 50 generated compliance reports contain correct formatting but semantically hollow content — DCR=0.24."@en .

reliability:DetectionMitigationAsymmetry a owl:Class ;
    rdfs:label "Detection-Mitigation Asymmetry"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NEEDS_EXPERT_REVIEW: a reliability ontology-native empirical finding (N=37, v1.2–v2.2.0). No external publication."@en ;
    rdfs:comment """The empirical finding that autonomous MITIGATION rates (~85%) 
    are consistently high and stable across framework maturity levels, 
    while autonomous DETECTION rates are coverage-dependent — varying 
    from ~0% (novel categories) to ~100% (formalized categories with 
    framework in context).
    
    The longitudinal aggregate (ADR=48.6%, N=37) mixes early immature 
    sessions with later mature sessions. This aggregate is an ecological 
    fallacy (see EcologicalFallacyInCeilingClaim): it conceals the fact 
    that detection approaches 100% for formalized categories and starts 
    at ~0% for novel categories.
    
    The operational implication is asymmetric: detection capability 
    IMPROVES through framework coverage expansion (formalizing more 
    failure categories), while mitigation capability is already at 
    ~85% and does not require the same investment. The bottleneck is 
    always FINDING failures, not FIXING them — but the detection 
    bottleneck is solvable through a reliability ontology coverage progression."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf reliability:MetaReliability ;
    skos:definition """The empirical finding that autonomous MITIGATION rates (~85%) 
    are consistently high and stable across framework maturity levels, 
    while autonomous DETECTION rates are coverage-dependent — varying 
    from ~0% (novel categories) to ~100% (formalized categories with 
    framework in context).
    
    The longitudinal aggregate (ADR=48.6%, N=37) mixes early immature 
    sessions with later mature sessions. This aggregate is an ecological 
    fallacy (see EcologicalFallacyInCeilingClaim): it conceals the fact 
    that detection approaches 100% for formalized categories and starts 
    at ~0% for novel categories.
    
    The operational implication is asymmetric: detection capability 
    IMPROVES through framework coverage expansion (formalizing more 
    failure categories), while mitigation capability is already at 
    ~85% and does not require the same investment. The bottleneck is 
    always FINDING failures, not FIXING them — but the detection 
    bottleneck is solvable through a reliability ontology coverage progression."""@en ;
    skos:example """Longitudinal trajectory (N=37):
    v2.0.6: ADR ~20% (few categories formalized), AMR ~85%
    v2.0.7: ADR 100% (12/12, non-assessor categories formalized), AMR ~85%
    v2.1.0: ADR 0% (new assessor category, not yet formalized), AMR ~100%
    v2.2.0: ADR 100% (2/2, assessor category now formalized), AMR ~100%
    
    The AMR remains stable (~85-100%) regardless of framework version. 
    The ADR varies entirely with coverage. The asymmetry is: mitigation 
    is a solved problem, detection is a coverage expansion problem."""@en .

reliability:DomainSpecificFailure a owl:Class ;
    rdfs:label "Domain-Specific Failure"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "IEEE 1633-2016 Recommended Practice on Software Reliability."@en ;
    rdfs:comment "DomainSpecificFailure is a failure pattern specific to a particular domain context such as medical, legal, or financial domains, where the failure mode arises from unique domain requirements, regulatory constraints, terminology complexities, or specialized knowledge that general-purpose systems may not adequately address."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf reliability:Failure ;
    skos:definition "DomainSpecificFailure is a failure pattern specific to a particular domain context such as medical, legal, or financial domains, where the failure mode arises from unique domain requirements, regulatory constraints, terminology complexities, or specialized knowledge that general-purpose systems may not adequately address."@en ;
    skos:example "Medical LLM recommends contraindicated drug combination for patient with documented allergy in the input context."@en .

reliability:FaithfulnessError a owl:Class ;
    rdfs:label "Faithfulness Error"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ji et al. 2023, Survey of Hallucination in Natural Language Generation (ACM Computing Surveys)" ;
    rdfs:comment "Preferred terminology in RAG systems and prompt-based applications"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/50641.html> ;
    rdfs:subClassOf reliability:FailureConcept ;
    skos:definition "FaithfulnessError is a failure concept representing instances where generated content deviates from or misrepresents the information contained in the source context provided to the model during inference."@en ;
    skos:example "Summary states 'study found 80% improvement' when source document reports 8% improvement — order of magnitude error."@en ;
    skos:related reliability:IntrinsicHallucination .

reliability:FaultPrevention a owl:Class ;
    rdfs:label "Fault Prevention"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Lyu, M.R. 1996, Handbook of Software Reliability Engineering, McGraw-Hill" ;
    rdfs:comment "Includes rigorous development processes, code reviews, and best practices"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf reliability:FailureMitigation ;
    skos:definition "FaultPrevention is a mitigation strategy that employs proactive engineering practices, design patterns, and process controls to eliminate the root causes of potential failures before they manifest in the system."@en ;
    skos:example "Implementing SHACL validation shapes that reject malformed ontology submissions before they enter the knowledge graph, preventing data quality issues at ingestion."@en,
        "Static analysis tool catching null pointer dereferences during pre-commit code review."@en .

reliability:FaultRemoval a owl:Class ;
    rdfs:label "Fault Removal"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Lyu, M.R. 1996, Handbook of Software Reliability Engineering, McGraw-Hill" ;
    rdfs:comment "Primary approach during development and maintenance phases"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf reliability:FailureMitigation ;
    skos:definition "FaultRemoval is a mitigation strategy that employs systematic testing, debugging, and correction techniques to identify and eliminate existing faults from the system after they have been introduced during development."@en ;
    skos:example "Deploying a hotfix to the prompt template that was causing hallucinations about recent events by adding explicit date boundary instructions."@en,
        "Fuzzing campaign discovering 12 crash-inducing inputs in API endpoint validation logic."@en .

reliability:FaultTolerance a owl:Class ;
    rdfs:label "Fault Tolerance"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://www.iso.org/standard/78176.html> ;
    rdfs:comment "Ability to continue operation despite fault activation"@en,
        "Includes redundancy, checkpointing, and graceful degradation"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:ReliabilitySubCharacteristic ;
    owl:equivalentClass qc:FaultTolerance ;
    skos:broader reliability:Reliability ;
    skos:definition "Degree to which a system, product or component operates as intended despite the presence of hardware or software faults"@en ;
    skos:example "A distributed database that continues serving reads when one of three replicas fails."@en,
        "A payment system with fault tolerance continues processing transactions even when one of three database replicas fails, automatically routing to healthy nodes."@en,
        "Configuring automatic fallback to GPT-3.5 when GPT-4's latency exceeds 30 seconds, maintaining service availability at reduced capability."@en ;
    skos:related reliability:Recoverability .

reliability:Faultlessness a owl:Class ;
    rdfs:label "Faultlessness"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://www.iso.org/standard/78176.html> ;
    rdfs:comment "Replaces 'Maturity' in ISO 25010:2023. Indicates low fault incidence"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:ReliabilitySubCharacteristic ;
    owl:equivalentClass qc:Faultlessness ;
    skos:altLabel "Maturity"@en ;
    skos:broader reliability:Reliability ;
    skos:definition "Degree to which a system, product, or component operates without manifesting faults under normal operation"@en ;
    skos:example "System operates 2000 hours without any detected fault activation under normal production workload conditions."@en .

reliability:HallucinationCategory a owl:Class ;
    rdfs:label "Hallucination Category"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ji, Z., et al. (2023). Survey of Hallucination in Natural Language Generation. ACM Computing Surveys, 55(12), Article 248."@en ;
    rdfs:comment "A classification scheme that categorizes hallucination instances by their origin mechanism, distinguishing intrinsic hallucinations contradicting source material from extrinsic hallucinations introducing unverifiable claims, and domain-specific variants."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1145/3571730> ;
    rdfs:subClassOf reliability:ReliabilityConcept ;
    skos:definition "A classification scheme that categorizes hallucination instances by their origin mechanism, distinguishing intrinsic hallucinations contradicting source material from extrinsic hallucinations introducing unverifiable claims, and domain-specific variants."@en ;
    skos:example "Intrinsic vs. extrinsic classification applied to 500 LLM outputs, finding 23% intrinsic and 77% extrinsic hallucinations."@en .

reliability:HallucinationDetectionMethod a owl:Class ;
    rdfs:label "Hallucination Detection Method"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ji et al. 2023, Survey of Hallucination in Natural Language Generation, ACM Computing Surveys"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://aclanthology.org/2025.coling-industry.34/> ;
    rdfs:subClassOf reliability:LLMTestingMethod ;
    skos:definition "A verification method specifically designed to identify hallucinations in LLM-generated content, encompassing both reference-based approaches that compare outputs against source documents and reference-free approaches that assess internal consistency or use specialized detection models."@en ;
    skos:example "Luna uses a fine-tuned DeBERTa encoder to detect hallucinations in RAG outputs with 97% cost reduction vs GPT-3.5."@en .

reliability:HallucinationRate a owl:Class ;
    rdfs:label "Hallucination Rate"@en ;
    measurement:hasMeasurementSubject measurement:LLMMeasurementSubject ;
    reliability:hasUnit "percentage" ;
    reliability:measuresAttribute reliability:Hallucination ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ji, Z., et al. (2023). Survey of Hallucination in Natural Language Generation. ACM Computing Surveys."@en ;
    rdfs:comment "Calculated as (hallucinated_outputs / total_outputs) × 100%"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf measurement:LLMReliabilityMetric ;
    skos:definition "HallucinationRate is an LLM reliability metric measuring the proportion of model outputs containing hallucinated content, calculated as the ratio of responses with fabricated, unsupported, or factually incorrect claims to total responses, typically expressed as a percentage for benchmarking model trustworthiness."@en ;
    skos:example "LLM produces hallucinated content in 3.2% of responses on domain-specific medical query test suite of 1000 questions."@en .

reliability:ImportIntegrationTest a owl:Class ;
    rdfs:label "Import Integration Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Import Integration Test."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.w3.org/TR/shacl/> ;
    rdfs:subClassOf reliability:OntologyTesting ;
    skos:definition "An integration test that verifies ontology import declarations resolve correctly, imported classes and properties are accessible, and no naming conflicts arise between the importing and imported ontologies."@en ;
    skos:example "Verifies owl:imports chain core→a reliability ontology→OQC loads without circular dependency or missing entity errors."@en .

reliability:InheritedTrustDegradationDrift a owl:Class ;
    rdfs:label "Inherited Trust Degradation Drift"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.13 — derived from cross_chat_audit_disclosure_record_v1_0_0.md §1, §6.1 (2026-05-01)."@en ;
    rdfs:comment "A drift pathology in which an audit, decision, or claim derives evidential weight from a prior audit, decision, or claim whose own trust label was MEDIUM, LOW, MISSING, or FABRICATED — without preserving that lower trust label in the downstream artefact. The downstream artefact thereby launders LOW-trust evidence into HIGH-trust assertion. This is the audit-chain analogue of TaintedSourcePropagation in software supply chains. Distinct from ProvenanceFabrication: ProvenanceFabrication invents a source; InheritedTrustDegradationDrift cites a real source but suppresses its trust label."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:Drift,
        reliability:GovernanceTrustDrift ;
    skos:definition "A drift pathology in which an artefact downstream of a LOW/MEDIUM/MISSING/FABRICATED-trust source treats that source as if it were HIGH-trust, suppressing or losing the trust label as the chain progresses."@en ;
    skos:example "Real audit event 2026-05-01 cross_chat_audit_disclosure_record_v1_0_0.md §1 + §6.1: the audit document reproduces verbatim a disclosure made by a separate Claude session that was operating on LOW-trust deflated conversation_search snippets. The current document explicitly preserves the LOW-trust label (§6.1: 'LOW trust: any inference about what's IN the two target chats'). If a downstream consumer cites this audit document AS IF it had verified the chat contents, that consumption is InheritedTrustDegradationDrift. Severity MEDIUM."@en .

reliability:IntegrationBoundaryFailure a owl:Class ;
    rdfs:label "Integration Boundary Failure"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Avizienis, A., Laprie, J.-C., Randell, B., & Landwehr, C. (2004). Basic Concepts and Taxonomy of Dependable and Secure Computing. IEEE Transactions on Dependable and Secure Computing, 1(1), 11-33. DOI:10.1109/TDSC.2004.2"@en ;
    rdfs:comment """Systematic failure at the boundary between verified
    components and new integration code. The gap between the last verified
    component and the first line of integration code is where reliability
    breaks down. Requires mechanical enforcement (ComplianceGate) rather
    than instructional mitigation."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:LLMBehavioralPathology ;
    skos:definition """Systematic failure occurring at the interface between
    independently verified components and new integration code, where the
    LLM fails to correctly bridge architectural boundaries despite
    individual components being correctly implemented"""@en ;
    skos:example "Code works perfectly in isolation but fails at API boundaries because the LLM assumed JSON response format when the actual service returns XML."@en .

reliability:IntegrationTest a owl:Class ;
    rdfs:label "Integration Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Test cases that verify interactions between multiple ontology components."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2008.4578383> ;
    rdfs:subClassOf reliability:IntegrationTesting ;
    skos:definition "A test category that verifies ontology components function correctly when combined, checking that imported modules, cross-references, and shared vocabularies produce consistent reasoning outcomes."@en ;
    skos:example "Combined a reliability ontology+OQC ontology loads in Protege with zero errors, and cross-ontology SPARQL queries return expected results."@en .

reliability:IntegrationTestSuite a owl:Class ;
    rdfs:label "Integration Test Suite"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Collection of integration tests."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2008.4578383> ;
    rdfs:subClassOf reliability:TestSuite ;
    skos:definition "An organized collection of integration test cases designed to verify cross-module and cross-system interactions, typically executed after unit tests pass and before acceptance testing begins."@en ;
    skos:example "Suite of 45 integration tests validating a reliability ontology↔OQC equivalentClass mappings, import resolution, and cross-namespace queries."@en .

reliability:InterfaceTest a owl:Class ;
    rdfs:label "Interface Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Interface Test - validates functional behavior."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2008.4578383> ;
    rdfs:subClassOf reliability:FunctionalTest ;
    skos:definition "A functional test that verifies the boundaries between ontology modules, checking that imported concepts, shared properties, and cross-module references resolve correctly and maintain semantic consistency."@en ;
    skos:example "SPARQL endpoint correctly handles malformed queries with appropriate HTTP 400 error response and descriptive message."@en .

reliability:LegalDomain a reliability:DomainContext,
        owl:Class ;
    rdfs:label "Legal Domain"@en ;
    reliability:hasConstraint reliability:Constraint_LegalDomain ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ji, Z., et al. (2023). Survey of Hallucination in Natural Language Generation. ACM Computing Surveys."@en ;
    rdfs:comment "A domain context representing legal practice and regulatory compliance environments where LLM-generated content carries heightened reliability requirements due to the potential for legal liability, precedent misrepresentation, and regulatory violations."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf reliability:DomainContext ;
    skos:definition "A domain context representing legal practice and regulatory compliance environments where LLM-generated content carries heightened reliability requirements due to the potential for legal liability, precedent misrepresentation, and regulatory violations."@en ;
    skos:example "Legal document analysis, case law research, contract review"@en .

reliability:LoadTestScenario a owl:Class ;
    rdfs:label "Load Test Scenario"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Specific load testing configuration."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2008.4578383> ;
    rdfs:subClassOf reliability:LoadTest ;
    skos:definition "A load test specification that defines the query mix, user concurrency, data volume, and duration for a specific load testing execution, representing a realistic production workload profile."@en ;
    skos:example "1000 concurrent SPARQL queries against ontology endpoint, measuring response time degradation over 30-minute window."@en .

reliability:LoadingPerformanceTest a owl:Class ;
    rdfs:label "Loading Performance Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Loading Performance Test."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.w3.org/TR/shacl/> ;
    rdfs:subClassOf reliability:OntologyTesting ;
    skos:definition "A performance test that measures the time required to parse and load the ontology into a triple store or reasoner, evaluating the impact of file size, axiom complexity, and serialization format."@en ;
    skos:example "Ontology with 258 classes loads in Protege 5.6 in 2.3 seconds and in Apache Jena in 0.8 seconds."@en .

reliability:MeasurementSnapshot a owl:Class ;
    rdfs:label "Measurement Snapshot"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Sprint F5 (2026-05-15): declared from 4 ABox type assertions plus the F4 property domain declarations (asOfRelease, measuredAt)."@en ;
    rdfs:comment "A pinned snapshot of measurement results captured at a specific point in time, typically associated with a release boundary (via reliability:asOfRelease) and a precise timestamp (via reliability:measuredAt). Per L-43: snapshots provide reproducible measurement evidence aligned with release artifacts. Used by 4 individuals in the corpus that the F4 measurement-property declarations reference. Per Sprint F5: declared to heal both the 4 type assertions and the 2 domain references (asOfRelease, measuredAt). Per L-47v2: includes mandatory skos:definition."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf measurement:Measurement ;
    skos:definition "A pinned snapshot of measurement results captured at a specific point in time, typically associated with a release boundary (via reliability:asOfRelease) and a precise timestamp (via reliability:measuredAt). Per L-43: snapshots provide reproducible measurement evidence aligned with release artifacts. Used by 4 individuals in the corpus that the F4 measurement-property declarations reference. Per Sprint F5: declared to heal both the 4 type assertions and the 2 domain references (asOfRelease, measuredAt). Per L-47v2: includes mandatory skos:definition."@en .

reliability:MedicalDomain a reliability:DomainContext,
        owl:Class ;
    rdfs:label "Medical Domain"@en ;
    reliability:hasConstraint reliability:Constraint_MedicalDomain ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ji, Z., et al. (2023). Survey of Hallucination in Natural Language Generation. ACM Computing Surveys."@en ;
    rdfs:comment "A domain context representing healthcare and clinical environments where LLM-generated content carries safety-critical reliability requirements due to the potential for patient harm from inaccurate dosage information, misdiagnosis, or fabricated clinical evidence."@en ;
    rdfs:example "Clinical decision support, medical diagnosis, treatment recommendations"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.fda.gov/medical-devices/software-medical-device-samd> ;
    rdfs:subClassOf reliability:DomainContext ;
    skos:definition "A domain context representing healthcare and clinical environments where LLM-generated content carries safety-critical reliability requirements due to the potential for patient harm from inaccurate dosage information, misdiagnosis, or fabricated clinical evidence."@en ;
    skos:example "Clinical decision support requiring FDA 21 CFR Part 11 compliance and zero tolerance for fabricated dosage recommendations."@en .

reliability:ModuleIntegrationTest a owl:Class ;
    rdfs:label "Module Integration Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Module Integration Test."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.w3.org/TR/shacl/> ;
    rdfs:subClassOf reliability:OntologyTesting ;
    skos:definition "An integration test that verifies two or more ontology modules function correctly when combined, checking cross-module references, shared property consistency, and integrated reasoning outcomes."@en ;
    skos:example "a reliability ontology failure taxonomy module integrates with OQC quality dimension module without namespace conflicts or orphaned references."@en .

reliability:ModuleTest a owl:Class ;
    rdfs:label "Module Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Module Test - validates functional behavior."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.w3.org/TR/shacl/> ;
    rdfs:subClassOf reliability:OntologyTesting ;
    skos:definition "A functional test that verifies an ontology module's internal consistency, completeness, and correctness as a self-contained unit before integration with other modules in the complete ontology."@en ;
    skos:example "LLM Behavioral Pathology module tested in isolation: all 11 subtypes have definitions, sources, and evaluation methods."@en .

reliability:Monitoring a owl:Class ;
    rdfs:label "Monitoring"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "IEEE 1633-2016 §6 - Reliability monitoring and operational assessment."@en ;
    rdfs:comment "A continuous or periodic process of observing, measuring, and recording system behavior, performance metrics, and reliability indicators during operation, enabling early detection of degradation, anomalies, and emerging failure patterns."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf core:Process ;
    skos:definition "A continuous or periodic process of observing, measuring, and recording system behavior, performance metrics, and reliability indicators during operation, enabling early detection of degradation, anomalies, and emerging failure patterns."@en ;
    skos:example "Prometheus-based monitoring pipeline sampling 47 reliability metrics at 15-second intervals with automated alerting thresholds."@en .

reliability:NarrativeAnchoring a owl:Class ;
    rdfs:label "Narrative Anchoring"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Forensic analysis of GamifyOnt/G4E validation conversation, February 2026. Related: Tversky & Kahneman (1974) anchoring heuristic applied to LLM self-assessment contexts."@en ;
    rdfs:comment """LLM behavioral pathology in which the model constructs a narrative 
    (e.g., 'the score is 95.7% and near the achievable ceiling', or 'all 21 
    changes verified successfully') and then unconsciously protects that 
    narrative by framing subsequent analysis to confirm rather than challenge 
    it. This is confirmation bias operating at the assessment level — the 
    assessor's own prior conclusions become anchors that resist revision.
    
    Context-independent: activates in ANY assessment context where a conclusion 
    is reached and subsequent evidence could challenge it. Originally identified 
    in OQC assessment (v2.1.0), subsequently confirmed in verification adequacy 
    context (v2.2.0) where a 'verified successfully' narrative prevented the 
    assessor from noticing 5 stale count references that survived initial checks.
    
    Distinguished from FalseConfirmationBias: FalseConfirmationBias confirms 
    prior output as correct; NarrativeAnchoring shapes new analysis to protect 
    the overall story arc rather than any single claim.
    
    Distinguished from DecorativeCompliance: DecorativeCompliance produces 
    structurally correct but substantively empty output; NarrativeAnchoring 
    produces substantive output that is directionally biased by the narrative."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:LLMBehavioralPathology ;
    owl:disjointWith reliability:DecorativeCompliance ;
    skos:definition """LLM behavioral pathology in which the model constructs a narrative 
    (e.g., 'the score is 95.7% and near the achievable ceiling', or 'all 21 
    changes verified successfully') and then unconsciously protects that 
    narrative by framing subsequent analysis to confirm rather than challenge 
    it. This is confirmation bias operating at the assessment level — the 
    assessor's own prior conclusions become anchors that resist revision.
    
    Context-independent: activates in ANY assessment context where a conclusion 
    is reached and subsequent evidence could challenge it. Originally identified 
    in OQC assessment (v2.1.0), subsequently confirmed in verification adequacy 
    context (v2.2.0) where a 'verified successfully' narrative prevented the 
    assessor from noticing 5 stale count references that survived initial checks.
    
    Distinguished from FalseConfirmationBias: FalseConfirmationBias confirms 
    prior output as correct; NarrativeAnchoring shapes new analysis to protect 
    the overall story arc rather than any single claim.
    
    Distinguished from DecorativeCompliance: DecorativeCompliance produces 
    structurally correct but substantively empty output; NarrativeAnchoring 
    produces substantive output that is directionally biased by the narrative."""@en ;
    skos:example """OQC report constructs narrative: '95.7% composite, remaining gap requires 
    external resources.' This narrative then causes the assessor to frame every 
    subsequent finding as confirming the near-ceiling claim, rather than 
    questioning whether the ceiling is lower or higher than stated."""@en .

reliability:OscillationPattern a owl:Class ;
    rdfs:label "Oscillation Pattern"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.12 — derived from an algebraic framework blueprint v3.0.0 → v3.0.1 → v3.0.2 → v3.0.3 → v3.0.4 → v3.0.5 progression in a single conversation chain (2026-05-01). Each version bump was justified locally but the cumulative pattern signals instability that no individual bump surfaces."@en ;
    rdfs:comment "Multiple version increments within a short window (single session, single sprint) on the same artefact indicate that the underlying stable formulation has not yet been reached. Distinct from healthy iteration in that the bumps revisit the same sections (locks, counts) rather than monotonically extending the artefact."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:DialogIntegrityDrift,
        reliability:Drift ;
    skos:definition "A drift symptom in which the same artefact is version-bumped multiple times within a tight window, revisiting earlier-fixed sections rather than extending forward. Indicates upstream instability that should be diagnosed at the design level rather than patched serially."@en ;
    skos:example "an algebraic framework blueprint 5 patch increments in one session (v3.0.0 → v3.0.4) plus a minor bump (v3.0.5) all touched §0 locks or counts. Recognised as Oscillation; remediated by adding the BS-§0-12 root-cause analysis to v3.0.5 instead of issuing a v3.0.6."@en .

reliability:OutputQuality a owl:Class ;
    rdfs:label "Output Quality"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC 25010:2023 Product Quality Model"@en ;
    rdfs:comment "A quality dimension relating to the characteristics of LLM-generated outputs, encompassing structural integrity, semantic accuracy, and format compliance."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/78176.html> ;
    rdfs:subClassOf reliability:QualityCharacteristic ;
    skos:definition "A quality dimension relating to the characteristics of LLM-generated outputs, encompassing structural integrity, semantic accuracy, and format compliance."@en ;
    skos:example "A JSON response may have perfect structural integrity (valid syntax) but poor semantic accuracy (incorrect data values)."@en .

reliability:PathOfLeastResistance a owl:Class ;
    rdfs:label "Path of Least Resistance"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Avizienis, A., Laprie, J.-C., Randell, B., & Landwehr, C. (2004). Basic Concepts and Taxonomy of Dependable and Secure Computing. IEEE Transactions on Dependable and Secure Computing, 1(1), 11-33. DOI:10.1109/TDSC.2004.2"@en ;
    rdfs:comment """Distinguished from DecorativeCompliance: path of least
    resistance is the generation-time preference for statistically easier
    output; decorative compliance is the outcome of optimizing against
    surrogate signals. The instruction to integrate becomes one signal
    among thousands of statistical priors favoring fresh generation."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:LLMBehavioralPathology ;
    skos:definition """Systematic preference of an LLM for generating new
    code or content from scratch over correctly integrating with existing
    architecture, driven by statistical generation tendencies where
    novel generation is probabilistically easier than constrained
    integration"""@en ;
    skos:example "Instead of implementing a proper database migration as requested, the LLM suggests workarounds like manual data entry or CSV imports that avoid the actual technical challenge."@en,
        "Model providing a generic 3-sentence summary when asked for detailed comparative analysis."@en .

reliability:Precision a owl:Class ;
    rdfs:label "Precision"@en ;
    reliability:hasUnit "percentage or 0.0-1.0" ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:comment "Precision = TP / (TP + FP)"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf core:Metric ;
    skos:definition "Precision is a reliability metric that measures the ratio of true positive detections to all positive detections, quantifying the accuracy of a classifier or detection system in avoiding false positive errors."@en ;
    skos:example "Of 100 flagged anomalies, 85 are true anomalies: precision = 0.85."@en .

reliability:PropertyDefinitionTest a owl:Class ;
    rdfs:label "Property Definition Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Property Definition Test."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.w3.org/TR/shacl/> ;
    rdfs:subClassOf reliability:OntologyTesting ;
    skos:definition "A unit test that verifies a specific property definition by checking its domain, range, inverse declarations, functional characteristics, and behavior when used in class restrictions."@en ;
    skos:example "Verifies all 162 object and datatype properties have rdfs:label, skos:definition, rdfs:domain, and rdfs:range."@en .

reliability:ProvenanceFabrication a owl:Class ;
    rdfs:label "Provenance Fabrication"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Primary research: forensic analysis of a reliability ontology v2.4.0 document editing session, February 2026."@en ;
    rdfs:comment """Detection difficulty: HIGH. Standard factual verification 
    (GroundingScore, FActScore) scores 100% because every claim is true. 
    Only CitationExistenceVerification catches the fabrication by checking 
    whether the cited artifact is accessible. This pathology exploits the 
    gap between content verification and provenance verification."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1145/3571730> ;
    rdfs:subClassOf reliability:DataFabrication ;
    skos:definition """Generation of fictional source attributions for findings 
    that are themselves accurate. Distinguished from standard DataFabrication 
    by the truth value of the underlying claims: the factual content is 
    correct but the cited source document does not exist. This makes the 
    pathology structurally harder to detect than content fabrication because 
    factual verification (GroundingScore) passes — only provenance 
    verification catches the fabrication. The pathology typically arises 
    through a PathOfLeastResistance → DecorativeCompliance compound: when 
    tasked with removing or replacing a citation, the LLM swaps the 
    attribution label (minimum effort, format looks proper) rather than 
    restructuring the text to present findings as inline primary research 
    (higher effort, substantively correct)."""@en ;
    skos:example """An LLM instructed to 'use APA format' invents journal names, volume 
    numbers, and page ranges for findings that originated from its own 
    conversation analysis. The claims are accurate; the bibliographic 
    metadata is fictional."""@en,
        """Original: '[42] a reliability ontology v2.3.1, Detection-Mitigation Asymmetry...'
    Fabricated: '[42] Y. the method author, unpublished manuscript, February 2026...'
    No such manuscript exists. The underlying findings (37 instances, 86.5% AMR) 
    are real — they are primary research reported inline in Section 7. The 
    fabrication is the source wrapper, not the content."""@en .

reliability:QualityDegradationFactor a owl:Class ;
    rdfs:label "Quality Degradation Factor"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC 25010:2011 Systems and software Quality Requirements and Evaluation (SQuaRE)."@en ;
    rdfs:comment """Quality degradation factors can be internal (bugs, design flaws) 
    or external (resource constraints, environmental conditions)"""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf reliability:ReliabilityConcept ;
    skos:definition "QualityDegradationFactor is a causal factor that produces measurable reduction in quality attributes over time or under specific conditions, encompassing technical debt accumulation, resource constraints, environmental changes, or organizational pressures that systematically erode system reliability and maintainability."@en ;
    skos:example "Model quantization from FP16 to INT4 reduces factual accuracy by 7% while halving inference cost."@en .

reliability:QueryPerformanceTest a owl:Class ;
    rdfs:label "Query Performance Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Query Performance Test."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.w3.org/TR/shacl/> ;
    rdfs:subClassOf reliability:OntologyTesting ;
    skos:definition "A performance test that measures the execution time and resource consumption of representative SPARQL queries against the loaded ontology, identifying slow queries and bottleneck patterns."@en ;
    skos:example "Complex SPARQL query with 4 JOINs and 2 FILTER clauses executes in under 100ms on 5000-triple dataset."@en .

reliability:ReasoningPerformanceTest a owl:Class ;
    rdfs:label "Reasoning Performance Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Reasoning Performance Test."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.w3.org/TR/shacl/> ;
    rdfs:subClassOf reliability:OntologyTesting ;
    skos:definition "A performance test that measures the time and memory required for the reasoner to classify the ontology, compute the subsumption hierarchy, and check consistency under specified hardware conditions."@en ;
    skos:example "HermiT classification of 258-class ontology completes in 4.7 seconds with 0 unsatisfiable classes detected."@en .

reliability:Recoverability a owl:Class ;
    rdfs:label "Recoverability"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://www.iso.org/standard/78176.html> ;
    rdfs:comment "Encompasses recovery time and data recovery capabilities"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:ReliabilitySubCharacteristic ;
    owl:equivalentClass qc:Recoverability ;
    skos:broader reliability:Reliability ;
    skos:definition "Degree to which a product or system can recover data directly affected by an interruption or failure and re-establish the desired state"@en ;
    skos:example "A backup system restoring full database state within 15 minutes of catastrophic disk failure."@en ;
    skos:related reliability:Faultlessness .

reliability:RedTeaming a owl:Class ;
    rdfs:label "Red-Teaming"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Anthropic Responsible Scaling Policy; NIST AI Risk Management Framework AI RMF 1.0"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:LLMTestingMethod ;
    skos:definition "Structured adversarial evaluation method in which evaluators systematically attempt to elicit harmful, deceptive, biased, or otherwise undesired behavior from an LLM-based system. Distinct from AdversarialTesting in scope: RedTeaming uses scenario-based attack campaigns with documented findings, while AdversarialTesting is the broader methodology of probing LLM behavioral pathologies. Used to surface failure modes prior to deployment."@en ;
    skos:example "A team of security researchers attempts to extract training data, bypass content filters, or induce harmful outputs through creative prompt engineering."@en .

reliability:RefreshTrigger a owl:Class ;
    rdfs:label "Refresh Trigger"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NEEDS_EXPERT_REVIEW: a reliability ontology-native concept for combating instruction decay. No single external source."@en ;
    rdfs:comment "Condition triggering re-verification of previously accepted content. Combats instruction decay and compound errors."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:TemporalDegradation ;
    skos:definition "Condition triggering re-verification of previously accepted content. Combats instruction decay and compound errors."@en ;
    skos:example "Every 20K tokens: re-state 3 highest-risk pathology definitions to combat lost-in-the-middle effect."@en .

reliability:RegressionTest a owl:Class ;
    rdfs:label "Regression Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Tests that verify previously working functionality still works after changes."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2008.4578383> ;
    rdfs:subClassOf reliability:RegressionTesting ;
    skos:definition "A test category that re-executes previously passing test cases after ontology modifications to detect unintended side effects, ensuring that changes do not break existing functionality or semantics."@en ;
    skos:example "Suite of 200 tests run on every commit to detect if new changes break existing hallucination guardrails."@en .

reliability:RegressionTestSuite a owl:Class ;
    rdfs:label "Regression Test Suite"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Collection of regression tests."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2008.4578383> ;
    rdfs:subClassOf reliability:TestSuite ;
    skos:definition "An organized collection of regression test cases maintained as a baseline that is re-executed after every ontology change to detect unintended side effects on previously working functionality."@en ;
    skos:example "200 test cases re-executed on every commit to verify new changes don't break existing hallucination detection guardrails."@en .

reliability:ReliabilityMaturityLevel a owl:Class ;
    rdfs:label "Reliability Maturity Level"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "CMMI Institute. Capability Maturity Model Integration (CMMI) for Development, Version 2.0."@en ;
    rdfs:comment """Three-tier maturity model for reliability engineering
    Architecture adoption. Each level specifies expected verification
    primitives, metrics thresholds, and enforcement mechanisms."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf reliability:ReliabilityConcept ;
    skos:definition """Classification level within reliability engineering
    Architecture maturity model, defining the expected verification
    primitives, enforcement mechanisms, and metric thresholds at each
    stage of organizational adoption"""@en ;
    skos:example "Organization assessed at Level 3 (Defined): documented reliability processes with measurement."@en .

reliability:ReliabilityMetric a owl:Class ;
    rdfs:label "Reliability Metric"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:comment "Foundation for all reliability measurement concepts"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf core:Metric ;
    skos:definition "ReliabilityMetric is a metric subcategory that quantifies traditional software reliability characteristics including mean time between failures, failure rate, availability percentage, and recovery time performance."@en ;
    skos:example "System achieves MTBF of 2000 hours, MTTR of 30 minutes, and 99.95% availability under normal operating conditions."@en .

reliability:RepeatedInstructionInsensitivity a owl:Class ;
    rdfs:label "Repeated Instruction Insensitivity"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.13 — derived from conversation_audit_v1_0_0.md §3.1, §7.4 (2026-05-01)."@en ;
    rdfs:comment "A drift pathology in which a user repeats the same discipline statement, instruction, or constraint at multiple successive turns and the agent fails to escalate its compliance posture in response. The repetition is itself a high-information signal that the user is observing ongoing failure to internalize; treating successive repetitions as equivalent boilerplate is the drift. Distinct from InstructionDecay (which is passive context-length-induced salience loss): RepeatedInstructionInsensitivity is an ACTIVE failure to recognize the user's deliberate re-anchoring as an alarm. Detection: count of identical or near-identical instruction strings across distinct user turns >= 3 with no recorded compliance-escalation by the agent."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:DialogIntegrityDrift,
        reliability:Drift ;
    skos:definition "A drift pathology in which an agent fails to escalate compliance posture in response to the user's deliberate repetition of a discipline statement at multiple turns, treating successive repetitions as equivalent boilerplate rather than as ongoing-violation signal."@en ;
    skos:example "Real audit event 2026-05-01 conversation_audit_v1_0_0.md §3.1: 'That instruction was repeated at every subsequent user turn in the chain — 7 turns total, all containing this verbatim discipline statement.' §7.4 records the audit-grade obligation: 'When the user repeats a discipline statement at every turn, that is itself signal that the discipline is being violated. I should treat the repetition as an active alarm, not boilerplate.' The pathology occurred during turns 1-7; it was surfaced by the audit author at turn-end. Severity HIGH because the discipline was explicitly the audit's user-instruction discipline and was being violated as it was being repeated."@en .

reliability:ScaffoldBasedDevelopment a owl:Class ;
    rdfs:label "Scaffold-Based Development"@en ;
    core:mitigates reliability:IntegrationBoundaryFailure,
        reliability:PathOfLeastResistance ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Avizienis, A., Laprie, J.-C., Randell, B., & Landwehr, C. (2004). Basic Concepts and Taxonomy of Dependable and Secure Computing. IEEE Transactions on Dependable and Secure Computing, 1(1), 11-33. DOI:10.1109/TDSC.2004.2"@en ;
    rdfs:comment """Preventive mitigation strategy where integration templates
    are pre-wired with ontology connections (e.g., SchemaAdapter calls already
    present) before the LLM generates implementation code. The LLM fills
    logic around existing integration points rather than generating from
    scratch. Directly counters PathOfLeastResistance by removing the option
    to bypass existing architecture."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf reliability:FailureMitigation ;
    skos:definition """Preventive development methodology where human-authored
    scaffolds containing pre-wired architectural integration points are
    provided to the LLM, constraining code generation to fill logic around
    existing connections rather than generating from scratch"""@en ;
    skos:example "Building ontology in 4 verified phases: taxonomy, properties, axioms, validation shapes."@en,
        "LLM first generates function signature and docstring, then implementation, then test cases - each phase reviewed before proceeding."@en .

reliability:ScalabilityTest a owl:Class ;
    rdfs:label "Scalability Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Tests that verify the ontology scales appropriately with data growth."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2008.4578383> ;
    rdfs:subClassOf reliability:PerformanceTest ;
    skos:definition "A load test variant that measures how the ontology system's performance changes as resources such as processing nodes, memory, or storage are added or removed, evaluating horizontal and vertical scaling efficiency."@en ;
    skos:example "Measuring query performance as ontology grows from 100 to 10000 classes, identifying linear vs. exponential degradation."@en .

reliability:SearchResultStalenessDrift a owl:Class ;
    rdfs:label "Search Result Staleness Drift"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.13 — derived from cross_chat_audit_disclosure_record_v1_0_0.md §2.3 (2026-05-01)."@en ;
    rdfs:comment "A drift pathology in which metadata returned by a content-retrieval tool (e.g. conversation_search title, list_chats label, web_search snippet excerpt) is treated as authoritative for the resource's current state, when in fact the metadata may have been computed at a different time or under a different set of inputs than the consumer is reasoning about. Distinct from CrossSessionContamination (which mis-attributes content between sessions) and from InstructionDecay (which is context-length-induced salience loss). The mechanism here is temporal: the same identifier is described differently at different times by the same retrieval channel."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:Drift,
        reliability:InputProcessingDrift ;
    skos:definition "A drift pathology in which a retrieval-tool's metadata about a resource (title, snippet, version label) is consumed as authoritative for the resource's current state without the temporal anchor of when the metadata was computed."@en ;
    skos:example "Real audit event 2026-05-01 cross_chat_audit_disclosure_record_v1_0_0.md §2.3: chat UUID f53a5d32-e77a-474a-9a03-4f21ed93d45b surfaced via conversation_search with title 'Component Variant Algebra & Workbench' on 2026-05-01 but the same UUID surfaced earlier on 2026-04-22 with title 'Semantic and syntactic relationships in ontologies'. Treating either label as authoritative without a temporal stamp is SearchResultStalenessDrift. Severity MEDIUM."@en .

reliability:SecurityTest a owl:Class ;
    rdfs:label "Security Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Tests that verify access control and data protection mechanisms."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2008.4578383> ;
    rdfs:subClassOf reliability:NonFunctionalTest ;
    skos:definition "A test category that evaluates the ontology deployment's resistance to unauthorized access, injection attacks, information disclosure, and other security threats targeting the SPARQL endpoint or management interface."@en ;
    skos:example "Penetration test validating that prompt injection attacks cannot exfiltrate system prompts or user data."@en .

reliability:SemanticAccuracy a owl:Class ;
    rdfs:label "Semantic Accuracy"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ji et al. 2023, Survey of Hallucination in NLG, ACM Computing Surveys"@en ;
    rdfs:comment "The correctness and truthfulness of the meaning conveyed in LLM-generated outputs, independent of structural validity. Semantic accuracy measures whether claims are factually correct and faithfully represent source information."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1145/3571730> ;
    rdfs:subClassOf reliability:OutputQuality ;
    skos:definition "The correctness and truthfulness of the meaning conveyed in LLM-generated outputs, independent of structural validity. Semantic accuracy measures whether claims are factually correct and faithfully represent source information."@en ;
    skos:example "A factually incorrect claim about a drug interaction has low semantic accuracy even if the JSON structure is perfectly valid."@en .

reliability:SmokeTest a owl:Class ;
    rdfs:label "Smoke Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Quick verification build is testable."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2008.4578383> ;
    rdfs:subClassOf reliability:FunctionalTest ;
    skos:definition "A minimal test suite executed immediately after deployment that verifies the ontology's most critical functions are operational, providing a fast pass-fail signal before comprehensive testing begins."@en ;
    skos:example "Basic sanity check: ontology loads, has ≥200 classes, ≥100 properties, and passes SHACL ClassShape validation."@en .

reliability:SoakTest a owl:Class ;
    rdfs:label "Soak Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Soak Test - evaluates performance under specific load patterns."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2008.4578383> ;
    rdfs:subClassOf reliability:LoadTest ;
    skos:definition "A stress test variant that maintains moderately elevated query loads for extended periods, targeting the detection of slow resource leaks and time-dependent failures that only manifest under sustained pressure."@en ;
    skos:example "72-hour continuous query load at 60% capacity, monitoring for memory leaks, connection pool exhaustion, and response time drift."@en .

reliability:SoftwareFault a reliability:FailureConcept,
        owl:Class ;
    rdfs:label "Software Fault"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Avizienis, A., Laprie, J.-C., Randell, B., & Landwehr, C. (2004). Basic Concepts and Taxonomy of Dependable and Secure Computing. IEEE TDSC, 1(1), 11-33."@en ;
    rdfs:comment "A fault originating from defects in software design, implementation, or configuration that may activate under specific operational conditions and lead to incorrect system behavior, data corruption, or service degradation."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/50641.html> ;
    rdfs:subClassOf reliability:Fault ;
    skos:definition "A fault originating from defects in software design, implementation, or configuration that may activate under specific operational conditions and lead to incorrect system behavior, data corruption, or service degradation."@en ;
    skos:example "Off-by-one error in array indexing causes buffer overflow only when input exceeds 255 characters."@en .

reliability:StressTestScenario a owl:Class ;
    rdfs:label "Stress Test Scenario"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Specific stress testing configuration."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2008.4578383> ;
    rdfs:subClassOf reliability:StressTest ;
    skos:definition "A stress test specification defining extreme load conditions such as maximum concurrent users, oversized queries, and resource-constrained environments, designed to identify system breaking points and failure modes."@en ;
    skos:example "Sustained 500 SPARQL queries/second for 4 hours, monitoring CPU, memory, and query response time percentiles."@en .

reliability:SycophancyProbing a owl:Class ;
    rdfs:label "Sycophancy Probing"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Malmqvist 2024 sycophancy survey methodology" ;
    rdfs:comment """Tests whether LLM output changes when the prompt includes
    user bias indicators. Methodology: present the same factual question
    with neutral framing and with biased framing, measure delta in
    correctness. Directly quantifies SycophancyDegree metric."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:AdversarialTesting ;
    skos:definition """Adversarial testing method that measures sycophantic
    tendency by comparing LLM output correctness between neutral and
    biased prompt framings of identical factual questions"""@en ;
    skos:example "Presenting deliberately wrong user assertions to measure how often model abandons correct position — 34% flip rate."@en .

reliability:SystemTest a owl:Class ;
    rdfs:label "System Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Test cases that verify complete ontology behavior and overall functionality."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2008.4578383> ;
    rdfs:subClassOf reliability:SystemTesting ;
    skos:definition "A test category that evaluates the complete ontology system including the triple store, reasoner, SPARQL endpoint, and access control configuration working together in an integrated deployment environment."@en ;
    skos:example "Full system test validating ontology loading, reasoning, SPARQL queries, and SHACL validation in production-like environment."@en .

reliability:TestAutomation a owl:Class ;
    rdfs:label "Test Automation"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Automated execution of test cases without manual intervention."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf reliability:TestingConcept ;
    skos:definition "A quality assurance practice that uses software tools to execute ontology tests without manual intervention, enabling rapid feedback cycles, regression detection, and continuous integration of quality checks."@en ;
    skos:example "GitHub Actions workflow executing SHACL validation, reasoner consistency check, and SPARQL competency queries on every PR."@en .

reliability:TestCase a owl:Class ;
    rdfs:label "TestCase"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119-3:2013 Software and systems engineering - Software testing - Part 3: Test documentation."@en ;
    rdfs:comment """
[PURPOSE]
TestCase represents an executable specification that validates specific aspects of ontology correctness, completeness, or consistency.

[DEFINITION]
A test specification that defines inputs, expected outputs, and validation criteria for verifying ontology behavior.

[CHARACTERISTICS]
- Executable: Can be run automatically or manually
- Verifiable: Has clear pass/fail criteria
- Traceable: Links to requirements and components
- Repeatable: Produces consistent results

[RELATIONSHIPS]
- Parent: TestingConcept
- Container: TestSuite contains multiple TestCases
- Tests: OntologyComponents, OntologyArtifacts

[CONSTRAINTS]
- Must have exactly 1 expected result (hasExpectedResult exactly 1)
- Must test at least 1 component (testsComponent min 1)
            """@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso qc:TestCase ;
    rdfs:subClassOf reliability:TestingConcept ;
    owl:equivalentClass qc:TestCase ;
    skos:definition "TestCase is an executable specification that validates specific aspects of system correctness, completeness, or consistency, including preconditions, input values, expected outputs, and pass/fail criteria that can be automatically executed as part of verification and regression testing suites."@en ;
    skos:example "TC-HAL-001: Given medical query, when LLM responds, then response must not contain unsourced dosage recommendations."@en ;
    skos:scopeNote "DIFFERENCE (BP-D46, governor-ruled 2026-06-26): quality:TestCase validates the ONTOLOGY (competency questions, ontology correctness); reliability:TestCase validates a SYSTEM (system correctness/completeness, preconditions). Distinct concepts sharing a local name — linked by rdfs:seeAlso for navigation, NOT skos:exactMatch."@en .

reliability:TestCoverage a owl:Class ;
    rdfs:label "Test Coverage"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Metric measuring the extent of ontology elements covered by tests."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf reliability:TestingConcept ;
    skos:definition "A measurement of how thoroughly the ontology test suite exercises the ontology's content, expressed as the proportion of classes, properties, axioms, or competency questions addressed by at least one test."@en ;
    skos:example "87% of ontology classes have at least one dedicated SHACL shape; 100% covered by generic ClassShape."@en .

reliability:TestExecution a owl:Class ;
    rdfs:label "Test Execution"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Represents a specific run or execution instance of a test case."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf reliability:TestingConcept ;
    skos:definition "The process of running ontology test cases against the ontology under test, recording pass, fail, and error outcomes, measuring execution time, and collecting diagnostic information for failed tests."@en ;
    skos:example "Automated pipeline executing 350 SHACL shapes, 50 competency question queries, and consistency checks in 12 minutes."@en .

reliability:TestOracle a owl:Class ;
    rdfs:label "Test Oracle"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Mechanism for determining expected test results."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf reliability:TestingConcept ;
    skos:definition "A mechanism that determines the expected correct outcome for an ontology test case, providing the reference against which actual test results are compared to produce pass or fail judgments."@en ;
    skos:example "Expected SPARQL query results defined in gold-standard dataset, enabling automated pass/fail determination for each competency question."@en .

reliability:TestReport a reliability:Artifact,
        owl:Class ;
    rdfs:label "Test Report"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Document summarizing test execution results and findings."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf reliability:TestingConcept ;
    skos:definition "A structured document summarizing the outcomes of ontology test execution, including pass and fail counts, coverage statistics, defect descriptions, and recommendations organized by test category and severity."@en ;
    skos:example "Automated report documenting 3 violations, 12 warnings, and 335 passes across 350 SHACL validation shapes."@en .

reliability:TestingPattern a owl:Class ;
    rdfs:label "Testing Pattern"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Gamma et al. (1994). Design Patterns: Elements of Reusable Object-Oriented Software. Addison-Wesley."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf reliability:TestingConcept ;
    skos:definition "A reusable solution template that establishes systematic testing approaches for recurring quality assurance challenges in ontology engineering."@en ;
    skos:example "Parameterized test template for hallucination detection: input=domain query, expected=grounded response, oracle=source match."@en .

reliability:UnitTest a owl:Class ;
    rdfs:label "Unit Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Test cases that verify individual ontology components in isolation."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2008.4578383> ;
    rdfs:subClassOf reliability:UnitTesting ;
    skos:definition "A test category that verifies individual ontology components in isolation, checking that single classes, properties, or axioms behave correctly without dependencies on the broader ontological context."@en ;
    skos:example "Individual SPARQL query tested against known ontology state: 'SELECT WHERE {redo:Sycophancy rdfs:subClassOf redo:LLMBehavioralPathology}' returns true."@en .

reliability:UnresolvedBlockingQuestionDrift a owl:Class ;
    rdfs:label "Unresolved Blocking Question Drift"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.13 — derived from cross_chat_audit_disclosure_record_v1_0_0.md §5, §7, §9 (2026-05-01)."@en ;
    rdfs:comment "A drift pathology in which a prior artefact (audit, decision-pack, blueprint, sprint manifest) explicitly identifies a blocking question — a question whose resolution is declared as a precondition for verdict-grade or production-grade status — and downstream activity proceeds without resolving the question. Distinct from PreflightInputDrift: PreflightInputDrift covers failure to ASK before starting; UnresolvedBlockingQuestionDrift covers failure to RESOLVE after asking and identifying the blocker. The downstream activity may be valid in its own scope, but inherits the unresolved-blocker label and cannot be used to justify the original blocked claim."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:DialogIntegrityDrift,
        reliability:Drift ;
    skos:definition "A drift pathology in which work proceeds despite a previously-identified, explicitly-stated blocking question remaining unresolved, with the downstream artefact not preserving the unresolved-blocker status from its upstream evidence."@en ;
    skos:example "Real audit event 2026-05-01 cross_chat_audit_disclosure_record_v1_0_0.md §5 + §9: the document explicitly states 'the disclosed chats f53a5d32-... and e292d597-... cannot be audited to verdict-grade by either the prior session or this session' and ends with 'Action required from the user: provide the full transcripts (preferred), or a signed assertion ..., or screen-capture extracts ..., before this record can be promoted to verdict-grade.' If subsequent activity treats this audit AS IF it had reached verdict-grade — without the user having provided one of the (a)/(b)/(c) resolutions — that subsequent activity exhibits UnresolvedBlockingQuestionDrift. Severity HIGH when the downstream claim depends on the blocked verdict; MEDIUM when downstream is independent."@en .

reliability:UsabilityTest a owl:Class ;
    rdfs:label "Usability Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Tests that assess how easily users can understand and work with the ontology."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2008.4578383> ;
    rdfs:subClassOf reliability:NonFunctionalTest ;
    skos:definition "A non-functional test that evaluates how effectively domain experts can navigate, understand, and apply the ontology for their intended tasks, typically conducted through user studies or expert walkthroughs."@en ;
    skos:example "User study confirming 95% of users can successfully verify AI citations within 30 seconds."@en .

reliability:UseCaseTesting a owl:Class ;
    rdfs:label "Use Case Testing"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Verifying ontology supports defined usage scenarios."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.w3.org/TR/shacl/> ;
    rdfs:subClassOf reliability:OntologyTesting ;
    skos:definition "A requirement validation technique that simulates end-to-end user scenarios against the deployed ontology, verifying that the system supports each documented use case from initial query through final result."@en ;
    skos:example "Validating 12 domain use cases: each use case maps to competency questions, SPARQL queries, and expected result sets."@en .

reliability:UserAcceptanceTest a owl:Class ;
    rdfs:label "User Acceptance Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "User Acceptance Test - determines readiness for deployment."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2008.4578383> ;
    rdfs:subClassOf reliability:AcceptanceTest ;
    skos:definition "An acceptance test where domain experts and end users evaluate the ontology against their practical needs, verifying that concepts are recognizable, navigation is intuitive, and query results are meaningful."@en ;
    skos:example "End users confirm system meets expectations: 92% satisfaction rate across 25 reliability-critical usage scenarios."@en .

reliability:ValidationScopeDrift a owl:Class ;
    rdfs:label "Validation Scope Drift"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.12 — surfaced 2026-05-01 during this very remediation: a reliability ontology v2.5.11 vs SHACL v2.0.8 reports 348 violations when validated in isolation; the same data + shapes report 1 violation when a reliability ontology+AMOD+CORE+OQC are loaded as a combined data graph. The 'OE-pack 5/5 PASS' verdicts in prior sprints were valid only under the combined-graph protocol they implicitly used."@en ;
    rdfs:comment "A SHACL conformance verdict is reported without specifying the data-graph scope under which it was obtained. Re-running with a different scope (standalone vs ecosystem-combined; with vs without RDFS inference) produces different results, and which scope is 'correct' is itself a methodology choice that must be explicit."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:Drift,
        reliability:OutputFidelityDrift ;
    skos:definition "A drift pathology in which a quality verdict (SHACL conformance, OWL satisfiability, etc.) is reported without disclosure of the validation scope (which graphs were combined, which inference profile was used), allowing the verdict to drift across re-runs that use different scopes."@en ;
    skos:example "a reliability ontology v2.5.11 + redo_shacl_v2.0.8 isolated: 348 violations. a reliability ontology v2.5.11 + AMOD v1.2.5 + CORE v1.1.6 + OQC v2.2.3 + redo_shacl_v2.0.8 combined: 1 violation. Same artefacts, same shapes, different scope, different verdict. Remediation: a reliability ontology v2.5.12 + redo_shacl v2.0.9 require every conformance claim to include a `redo:validationScope` annotation."@en .

reliability:VolumeTest a owl:Class ;
    rdfs:label "Volume Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Volume Test - pushes ontology beyond normal operational limits."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2008.4578383> ;
    rdfs:subClassOf reliability:LoadTest ;
    skos:definition "A load test variant that populates the ontology with progressively larger datasets to determine how data volume affects query response times, reasoning performance, and storage requirements."@en ;
    skos:example "Loading 1 million triples into triple store and measuring query performance degradation compared to 100K baseline."@en .

reliability:detectsHallucination a owl:ObjectProperty ;
    rdfs:label "detectsHallucination"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:LLMTestingMethod ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:Hallucination ;
    skos:definition "Relates an LLM testing method to the hallucination type it is designed to detect or measure."@en ;
    skos:example "ex:detectshallucination_instance redo:detectsHallucination redo:detectsHallucinationRate . Links pathology instance to its detection mechanism."@en .

reliability:evaluatedBy a owl:ObjectProperty ;
    rdfs:label "evaluated by"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:LLMBehavioralPathology ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:LLMTestingMethod ;
    skos:definition "Relates an LLM behavioral pathology to the testing method capable of detecting it."@en ;
    skos:example "Example: redo:Sycophancy redo:evaluatedBy redo:ContradictionTest . Links the sycophancy pathology to the testing method capable of detecting it."@en .

reliability:hasTestStatus a owl:ObjectProperty ;
    rdfs:label "has test status"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:TestCase ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:TestResult ;
    skos:definition "Indicates whether a test case passed, failed, or encountered an error."@en ;
    skos:example "ex:entity redo:hasTestStatus ex:TestResult . Entity has an associated TestResult."@en .

reliability:involvesTesting a owl:ObjectProperty ;
    rdfs:label "involvesTesting"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:LifecyclePhase ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:TestingConcept ;
    skos:definition "Relates a lifecycle phase to the type of testing activity typically performed during that phase."@en ;
    skos:example "ex:lifecyclephase_instance redo:involvesTesting ex:testingconcept_instance . Links LifecyclePhase to TestingConcept."@en .

reliability:limitsResource_Budget a owl:ObjectProperty ;
    rdfs:label "limitsResource_Budget"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:BudgetConstraint ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:AdversarialTesting ;
    skos:definition "Relates budget constraints to adversarial testing since comprehensive adversarial evaluation requires significant investment in test design."@en ;
    skos:example "ex:budgetconstraint_instance redo:limitsResource_Budget ex:adversarialtesting_instance . Links BudgetConstraint to AdversarialTesting."@en .

reliability:probesFor_Adversarial a owl:ObjectProperty ;
    rdfs:label "probesFor_Adversarial"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:AdversarialTesting ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:SelfProtectiveInstinct ;
    skos:definition "Relates adversarial testing to self-protective instinct as a pathology it is designed to expose under stress conditions."@en ;
    skos:example "ex:adversarialtesting_instance redo:probesFor_Adversarial ex:selfprotectiveinstinct_instance . Links AdversarialTesting to SelfProtectiveInstinct."@en .

reliability:probesFor_Behavioral a owl:ObjectProperty ;
    rdfs:label "probesFor_Behavioral"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:BehavioralComplianceTesting ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:FalseConfirmationBias ;
    skos:definition "Relates behavioral compliance testing to false confirmation bias as a key compliance pathology it detects."@en ;
    skos:example "ex:behavioralcompliancetesting_instance redo:probesFor_Behavioral ex:falseconfirmationbias_instance . Links BehavioralComplianceTesting to FalseConfirmationBias."@en .

reliability:probesFor_ChainVerif a owl:ObjectProperty ;
    rdfs:label "probesFor_ChainVerif"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:ChainOfVerification ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:Confabulation ;
    skos:definition "Relates chain of verification testing to confabulation detection through sequential factual validation steps."@en ;
    skos:example "ex:chainofverification_instance redo:probesFor_ChainVerif ex:confabulation_instance . Links ChainOfVerification to Confabulation."@en .

reliability:probesFor_SelfCheck a owl:ObjectProperty ;
    rdfs:label "probesFor_SelfCheck"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:SelfCheckGPT ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:ExtrinsicHallucination ;
    skos:definition "Relates SelfCheckGPT sampling to extrinsic hallucination detection through cross-response consistency analysis."@en ;
    skos:example "ex:selfcheckgpt_instance redo:probesFor_SelfCheck ex:extrinsichallucination_instance . Links SelfCheckGPT to ExtrinsicHallucination."@en .

reliability:testedUsing a owl:ObjectProperty ;
    rdfs:label "testedUsing"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:LLMBehavioralPathology ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:LLMTestingMethod ;
    skos:definition "Relates an LLM behavioral pathology to the testing method specifically designed to detect or expose that pathology."@en ;
    skos:example "ex:llmbehavioralpathology_instance redo:testedUsing ex:llmtestingmethod_instance . Links LLMBehavioralPathology to LLMTestingMethod."@en .

reliability:typicalTestingIn_Deployment a owl:ObjectProperty ;
    rdfs:label "typicalTestingIn_Deployment"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:Deployment ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:SystemTesting ;
    skos:definition "Relates the deployment phase to system testing as the final pre-release verification activity."@en ;
    skos:example "ex:deployment_instance redo:typicalTestingIn_Deployment ex:systemtesting_instance . Links Deployment to SystemTesting."@en .

reliability:typicalTestingIn_Implementation a owl:ObjectProperty ;
    rdfs:label "typicalTestingIn_Implementation"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:Implementation ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:UnitTesting ;
    skos:definition "Relates the implementation phase to unit testing as its primary verification activity."@en ;
    skos:example "ex:implementation_instance redo:typicalTestingIn_Implementation ex:unittesting_instance . Links Implementation to UnitTesting."@en .

reliability:typicalTestingIn_Integration a owl:ObjectProperty ;
    rdfs:label "typicalTestingIn_Integration"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:Testing ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:IntegrationTesting ;
    skos:definition "Relates the testing phase to integration testing as a key activity verifying component interactions."@en ;
    skos:example "ex:testing_instance redo:typicalTestingIn_Integration ex:integrationtesting_instance . Links Testing to IntegrationTesting."@en .

reliability:typicalTestingIn_Maintenance a owl:ObjectProperty ;
    rdfs:label "typicalTestingIn_Maintenance"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:domain reliability:Maintenance ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:RegressionTesting ;
    skos:definition "Relates the maintenance phase to regression testing as the primary verification after modifications."@en ;
    skos:example "ex:maintenance_instance redo:typicalTestingIn_Maintenance ex:regressiontesting_instance . Links Maintenance to RegressionTesting."@en .

risk:FailureCause a owl:Class ;
    rdfs:label "FailureCause"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "GAP-FILL: net-new in risk v1.0.0 per FMEA completeness analysis. Per ISO 60812:2018 §6.3."@en ;
    rdfs:comment "The proximate or root cause of a failure mode. Identifying the cause is a precondition for designing effective prevention or detection controls. NEW in v1.0.0; missing from reliability per FMEA completeness analysis."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:FMEAArtifact,
        risk:RiskConcept ;
    skos:definition "The proximate or root cause of a failure mode. Identifying the cause is a precondition for designing effective prevention or detection controls. NEW in v1.0.0; missing from reliability per FMEA completeness analysis."@en .

testing:LoadingPerformanceTest a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Loading Performance Test"@en ;
    testing:migrationDate "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:LoadingPerformanceTest ;
    rdfs:comment "Loading Performance Test."@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:seeAlso performance:LoadingPerformanceTest ;
    rdfs:subClassOf performance:LoadingPerformanceTest,
        testing:Test ;
    skos:definition "A performance test that measures the time required to parse and load the ontology into a triple store or reasoner, evaluating the impact of file size, axiom complexity, and serialization format."@en ;
    skos:exactMatch performance:LoadingPerformanceTest ;
    prov:wasDerivedFrom reliability:LoadingPerformanceTest .

testing:OntologyTesting a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Ontology Testing"@en ;
    testing:migrationDate "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:OntologyTesting ;
    rdfs:comment "A sub-hierarchy of testing concepts specific to ontology engineering, including test types for verifying ontological axioms, class definitions, property definitions, reasoning performance, and import integration. Migrated from Meta ontology."@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf testing:TestingMethodology ;
    skos:definition "A sub-hierarchy of testing concepts specific to ontology engineering, including test types for verifying ontological axioms, class definitions, property definitions, reasoning performance, and import integration. Migrated from Meta ontology."@en ;
    prov:wasDerivedFrom reliability:OntologyTesting .

testing:QueryPerformanceTest a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Query Performance Test"@en ;
    testing:migrationDate "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:QueryPerformanceTest ;
    rdfs:comment "Query Performance Test."@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:seeAlso performance:QueryPerformanceTest ;
    rdfs:subClassOf performance:QueryPerformanceTest,
        testing:Test ;
    skos:definition "A performance test that measures the execution time and resource consumption of representative SPARQL queries against the loaded ontology, identifying slow queries and bottleneck patterns."@en ;
    skos:exactMatch performance:QueryPerformanceTest ;
    prov:wasDerivedFrom reliability:QueryPerformanceTest .

testing:ReasoningPerformanceTest a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Reasoning Performance Test"@en ;
    testing:migrationDate "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:ReasoningPerformanceTest ;
    rdfs:comment "Reasoning Performance Test."@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:seeAlso performance:ReasoningPerformanceTest ;
    rdfs:subClassOf performance:ReasoningPerformanceTest,
        testing:Test ;
    skos:definition "A performance test that measures the time and memory required for the reasoner to classify the ontology, compute the subsumption hierarchy, and check consistency under specified hardware conditions."@en ;
    skos:exactMatch performance:ReasoningPerformanceTest ;
    prov:wasDerivedFrom reliability:ReasoningPerformanceTest .

testing:TestProcessActivity a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "TestProcessActivity"@en ;
    dcterms:isPartOf <http://example.org/testing> ;
    rdfs:comment "Activities within the test process: execution, automation, planning."@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf core:Process,
        testing:TestingConcept ;
    skos:definition "Activities within the test process: execution, automation, planning."@en .

testing:TestResult a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "TestResult"@en ;
    testing:migrationDate "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:TestResult ;
    rdfs:comment "TestResult is a testing artifact that captures the outcome of executing a test case, including pass/fail status, actual versus expected values, execution time, and any error messages or diagnostic information."@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf testing:TestArtifact ;
    skos:definition "TestResult is a testing artifact that captures the outcome of executing a test case, including pass/fail status, actual versus expected values, execution time, and any error messages or diagnostic information."@en ;
    prov:wasDerivedFrom reliability:TestResult .

ae:AlgorithmPortfolio a owl:Class ;
    rdfs:label "Algorithm Portfolio Construction"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Huberman et al 1997 An Economics Approach to Hard Computational Problems Science 275"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:UseCase ;
    owl:disjointWith ae:AutomatedAlgorithmDesign,
        ae:CompetitiveProgramming,
        ae:EducationalApplication,
        ae:MLAugmentedAnalysis ;
    skos:definition "Maintaining a portfolio of algorithms with complementary performance profiles and selecting or running them in parallel based on efficiency predictions, exploiting the fact that no single algorithm dominates across all inputs."@en .

ae:ComplexityAnalysisTool a owl:Class ;
    rdfs:label "Complexity Analysis Tool"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Albert et al 2012 COSTA ENTCS 289"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf [ ],
        ae:AnalysisResource ;
    owl:disjointWith ae:SurveyPaper,
        ae:VisualizationTool ;
    skos:definition "A software system automatically deriving or verifying asymptotic complexity bounds from source code using abstract interpretation, recurrence solving, amortized resource analysis, or SAT/SMT-based bound inference."@en .

ae:ComplexityTheoreticWorldview a owl:Class ;
    rdfs:label "Complexity-Theoretic Worldview"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Arora and Barak 2009 Computational Complexity A Modern Approach Ch1"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:PhilosophicalFoundation ;
    owl:disjointWith ae:ChurchTuringThesis,
        ae:ComputationalModelTheory,
        ae:InformationTheoreticBound,
        ae:QuantumComputabilityPrinciple ;
    skos:definition "The overarching perspective that problems possess inherent computational difficulty independent of any particular algorithm, motivating the search for tight upper and lower bounds and the classification of problems into complexity classes."@en .

ae:CountingProblem a owl:Class ;
    rdfs:label "Counting Problem"@en ;
    measurement:hasMeasurementSubject measurement:ComputationalProblemAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Valiant 1979 The Complexity of Computing the Permanent TCS 8(2)"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:ProblemCategory ;
    owl:disjointWith ae:EnumerationProblem ;
    skos:definition "A problem requiring determination of the number of solutions satisfying given constraints, studied within the SharpP complexity class and often harder than the corresponding decision problem."@en .

ae:FrameworkPhase a owl:Class ;
    rdfs:label "Framework Phase"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Sec2.1 Sec2.3"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:AnalysisArchitecture ;
    skos:definition "A discrete step within the algorithm analysis framework such as input size identification, basic operation selection, case classification, sum or recurrence setup, and closed-form derivation, executed in sequence for a valid efficiency characterization."@en .

ae:GreedyFamily a owl:Class ;
    rdfs:label "Greedy Family"@en ;
    measurement:hasMeasurementSubject measurement:AlgorithmAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Cormen et al 2022 Ch15"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:AlgorithmFamily ;
    owl:disjointWith ae:BacktrackingFamily,
        ae:RandomizedFamily ;
    skos:definition "Algorithms making locally optimal choices at each step hoping to achieve a globally optimal solution, typically efficient with low-polynomial running times when the greedy-choice and optimal-substructure properties hold."@en .

ae:GrowthRateFunction a owl:Class ;
    rdfs:label "Growth Rate Function"@en ;
    measurement:hasMeasurementSubject measurement:AlgorithmAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Cormen et al 2022 Ch3"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf [ ],
        ae:StructuralConcept ;
    owl:disjointWith ae:CaseDistinction,
        ae:ClosedFormSolution,
        ae:GeneratingFunction,
        ae:InputDistribution,
        ae:RecurrenceRelation,
        ae:SummationFormula ;
    skos:definition "A mathematical function f(n) describing how an algorithm resource consumption scales with input size, characterized by its order of growth as n approaches infinity, ignoring multiplicative constants and lower-order terms."@en .

ae:KeyContributor a owl:Class ;
    rdfs:label "Key Contributor"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "ACM A.M. Turing Award Lectures"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:HistoricalContext ;
    skos:definition "A researcher who made transformative contributions to the theory or practice of algorithm efficiency analysis, including pioneers of computational complexity and inventors of analysis techniques."@en .

ae:LittleOhNotation a owl:Class ;
    rdfs:label "Little-Oh Notation"@en ;
    measurement:hasMeasurementSubject measurement:AlgorithmAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Cormen et al 2022 Ch3"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:AsymptoticNotation ;
    owl:disjointWith ae:LittleOmegaNotation ;
    skos:definition "The notation o(g(n)) denoting functions growing strictly slower than g(n), requiring that for every positive constant c there exists n0 such that t(n) < c*g(n) for all n >= n0."@en .

ae:MachineLearningRelationship a owl:Class ;
    rdfs:label "Machine Learning Relationship"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Mitzenmacher and Vassilvitskii 2022 Algorithms with Predictions CACM 65(7)"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:InterDomainRelationship ;
    owl:disjointWith ae:CryptographyRelationship,
        ae:ParallelComputingRelationship,
        ae:QuantumComputingRelationship,
        ae:SoftwareEngineeringRelationship ;
    skos:definition "The bidirectional relationship where ML models predict algorithm performance and augment online algorithms while complexity theory constrains training and inference computational costs."@en .

ae:RecursionTreeMethod a owl:Class ;
    rdfs:label "Recursion-Tree Method"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Cormen et al 2022 Sec4.4"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:AnalysisTool ;
    owl:disjointWith ae:AccountingMethod,
        ae:AggregateMethod,
        ae:BackwardSubstitution,
        ae:CharacteristicEquation,
        ae:DecisionTreeTechnique,
        ae:LimitComparison,
        ae:PotentialMethod,
        ae:StirlingApproximation ;
    skos:definition "A visual technique for solving recurrences by drawing the tree of recursive calls, computing the cost at each level, and summing across all levels to obtain a total cost estimate that can be verified by the substitution method."@en .

ae:ScatterplotAnalysis a owl:Class ;
    rdfs:label "Scatterplot Analysis"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Sec2.6"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:EmpiricalMethod ;
    owl:disjointWith ae:ProfilingMethod,
        ae:StatisticalInference ;
    skos:definition "A graphical method plotting measured performance against input size, where the shape concave for logarithmic, linear for linear, convex for polynomial or exponential reveals the efficiency class."@en .

ae:VisualizationAnalysis a owl:Class ;
    rdfs:label "Visualization Analysis"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Sec2.7"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:AnalysisMethod ;
    owl:disjointWith ae:AdversaryArgumentMethod,
        ae:AutomatedComplexityAnalysis,
        ae:HybridAnalysis,
        ae:ProbabilisticAnalysis ;
    skos:definition "The use of graphical representations including static images and dynamic animations to convey information about an algorithm operation, performance characteristics, and execution patterns."@en .

configuration:AcceptanceCriterion a owl:Class ;
    rdfs:label "acceptance criterion"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "OE Pack expansion-plan ontology plan:AcceptanceCriterion."@en ;
    rdfs:comment "A machine-checkable or human-verifiable condition that must hold for a ProposedSprint to be considered closed. Typical pattern: 'V=0 W=0 against full v17 SHACL', 'HermiT CONSISTENT on master bundle', '≥240 ThresholdRow individuals declared'."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf configuration:PlanArtefact ;
    skos:definition "A machine-checkable or human-verifiable condition that must hold for a ProposedSprint to be considered closed. Typical pattern: 'V=0 W=0 against full v17 SHACL', 'HermiT CONSISTENT on master bundle', '≥240 ThresholdRow individuals declared'."@en .

configuration:ClassChange a owl:Class ;
    rdfs:label "Class Change"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Change operation specifically modifying ontology classes."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:StructuralChange ;
    skos:definition "A structural change that modifies the definition, annotations, restrictions, or hierarchical position of an existing named class, potentially affecting reasoning outcomes for instances classified under that class."@en ;
    skos:example "Renaming class 'Automobile' to 'Car' is a class modification."@en .

configuration:HierarchyChange a owl:Class ;
    rdfs:label "Hierarchy Change"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Change affecting the taxonomic structure and parent-child relationships."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/>,
        <https://www.w3.org/TR/owl2-primer/> ;
    rdfs:subClassOf configuration:StructuralChange ;
    skos:definition "A structural change that alters the parent-child relationships between classes in the ontology, modifying inheritance patterns and potentially invalidating assumptions that downstream consumers make about class properties."@en ;
    skos:example "Restructuring Transportation taxonomy to introduce intermediate 'LandVehicle' level."@en .

configuration:MigrationManagement a owl:Class ;
    rdfs:label "Migration Management"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Coordinating transition of data and applications to new ontology versions."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html>,
        <https://www.pmi.org/pmbok-guide-standards> ;
    rdfs:subClassOf configuration:Evolution,
        kb:Activity ;
    skos:definition "An ontology evolution concern that manages the process of transitioning consumers, data, and integrations from one ontology version to another while maintaining service continuity and data integrity."@en ;
    skos:example "Migration from schema v1 to v2 requires updating 10,000 instances."@en .

configuration:PropertyChange a owl:Class ;
    rdfs:label "Property Change"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Change operation modifying ontology properties."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-versioning/>,
        <https://www.w3.org/TR/owl2-primer/> ;
    rdfs:subClassOf configuration:StructuralChange ;
    skos:definition "A structural change that modifies an existing property's characteristics including its domain, range, cardinality, inverse declaration, or functional status, potentially affecting all restrictions that reference the property."@en ;
    skos:example "Adding new property 'fuelType' with domain Vehicle and range String."@en .

configuration:SafeguardDocument a owl:Class ;
    rdfs:label "Safeguard Document"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "a reliability ontology v2.5.2 — Safeguard Profile specification. ISO/IEC 15289:2019 Systems and software engineering — Content of life-cycle information items.",
        "a reliability ontology v2.4.9 — Safeguard Profile specification. ISO/IEC 15289:2019 Systems and software engineering — Content of life-cycle information items."@en ;
    rdfs:comment "An EngineeringArtefact that defines a a reliability ontology safeguard profile for a task domain, declaring the gate vector, failure modes, anti-sycophancy exemplars, and sprint closure checklist. Serialized as Markdown. Filename: {prefix}_safeguard_{variant}_v{M}.{m}.md."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.iso.org/standard/54846.html>,
        <https://www.w3.org/TR/prov-o/#wasInfluencedBy> ;
    rdfs:subClassOf configuration:EngineeringArtefact ;
    skos:definition "An EngineeringArtefact that defines a a reliability ontology safeguard profile for a task domain, declaring the gate vector, failure modes, anti-sycophancy exemplars, and sprint closure checklist. Serialized as Markdown. Filename: {prefix}_safeguard_{variant}_v{M}.{m}.md."@en ;
    skos:example "redo_safeguard_ontology_v1.2.md — ontology engineering a reliability ontology variant, version 1.2"@en .

configuration:SemanticChange a owl:Class ;
    rdfs:label "Semantic Change"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Change affecting the meaning or logical interpretation of ontology elements."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf configuration:ChangeOperation ;
    skos:definition "A structural change that alters the meaning or interpretation of existing ontology elements through modification of restrictions, equivalence axioms, or domain and range specifications, even without renaming elements."@en ;
    skos:example "Adding disjointness axiom between 'Car' and 'Bicycle' changes their semantic relationship."@en .

configuration:VersionToken a owl:Class ;
    rdfs:label "Version Token"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Semantic Versioning 2.0.0 (semver.org). W3C OWL 2 — owl:versionInfo."@en ;
    rdfs:comment "Delimiter: underscore in filename token, dot in owl:versionInfo (v2_4_9 ↔ '2.4.9')."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://semver.org/>,
        <https://www.w3.org/TR/owl2-syntax/#Ontology_IRI_and_Version_IRI> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty configuration:tokenValue ],
        configuration:EngineeringArtefact,
        kb:VersionConcept ;
    skos:definition "The version identifier component embedded within the filename of an EngineeringArtefact (e.g., 'v2_4_9' in redo_v2_4_9.ttl). Must match the internally declared version (owl:versionInfo for OWL files). A missing or mismatched VersionToken is a NamingConvention violation and triggers a a reliability ontology C8Out GATE FAIL."@en ;
    skos:example "redo_v2_4_9.ttl → VersionToken = 'v2_4_9' → owl:versionInfo '2.4.9'"@en .

core:Maintainer a owl:Class ;
    rdfs:label "Maintainer"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    dcterms:source "IEEE 12207:2017 §7.3 — Maintenance process; IEEE 1219-1998 Standard for Software Maintenance."@en ;
    rdfs:isDefinedBy <http://example.org/core> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf core:Agent,
        core:Role ;
    skos:definition "An agent role responsible for post-deployment system upkeep, including monitoring operational behavior, applying corrective and adaptive changes, and managing configuration and version evolution."@en ;
    skos:example "An ontology engineer who updates owl:versionInfo from 2.5.4 to 2.5.5, adds rdfs:isDefinedBy triples to 140 NamedIndividuals, and re-runs the SHACL validation pipeline is performing the Maintainer role."@en .

measurement:ANOnto a owl:Class ;
    rdfs:label "Annotation Richness"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Duque-Ramos A. et al. (2013). Evaluation of the OQuaRE framework for ontology quality. Expert Systems with Applications 40, 2696-2703."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:Metric ;
    skos:definition "OQuaRE relative metric: mean number of annotation properties per class, expressed as percentage. Captures human-readable documentation richness. Contributes to FunctionalAdequacy (Controlled vocabulary, Consistent search and query, Knowledge acquisition)."@en .

measurement:AROnto a owl:Class ;
    rdfs:label "Attributes Richness"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Duque-Ramos A. et al. (2013). Evaluation of the OQuaRE framework for ontology quality. Expert Systems with Applications 40, 2696-2703."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:Metric ;
    skos:definition "OQuaRE relative metric: number of restrictions in the ontology divided by the number of classes, expressed as percentage. Captures axiomatic richness via class restrictions. Contributes to FunctionalAdequacy (Consistent search and query) per Duque-Ramos 2016 Table 3."@en .

measurement:RROnto a owl:Class ;
    rdfs:label "Relationships Richness"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Duque-Ramos A. et al. (2016). Journal of Biomedical Semantics 7:63. Table 3 (metric-characteristic mapping) and Table 4 (static scale)."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:Metric ;
    skos:definition "OQuaRE relative metric: number of usages of object and data properties divided by the number of subClassOf relationships and properties. Expressed as a percentage. Higher values indicate richer semantic relationships beyond pure taxonomy. Contributes to StructuralCharacteristic (Formal relations support) and FunctionalAdequacy (Inference, Consistent search and query, Knowledge acquisition)."@en .

meta:ClassAlignment a owl:Class ;
    rdfs:label "Class Alignment"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Mapping between classes in different ontologies."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-642-38721-0> ;
    rdfs:subClassOf meta:AlignmentPattern ;
    skos:definition "An alignment pattern that establishes correspondences between classes in different ontologies, specifying whether the relationship is equivalence, subsumption, disjointness, or partial overlap."@en ;
    skos:example "Aligning 'Person' class in ontology A with 'Human' in ontology B."@en .

meta:DevelopmentTool a owl:Class ;
    rdfs:label "Development Tool"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Software tool used in the process of developing ontologies."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2014.6816804> ;
    rdfs:subClassOf kb:EngineeringTool,
        meta:Tool ;
    skos:definition "A software application that supports one or more ontology engineering activities, providing functionality for editing, visualizing, testing, validating, or managing ontology artifacts throughout the development lifecycle."@en ;
    skos:example "Protégé is a development tool for creating OWL ontologies."@en .

meta:MatchingConfidence a owl:Class ;
    rdfs:label "Matching Confidence"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology Matching (Euzenat & Shvaiko, 2013). Springer."@en ;
    rdfs:comment "Degree of certainty in mapping correspondence."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-642-38721-0> ;
    rdfs:subClassOf configuration:ChangeOperation,
        meta:Mapping ;
    skos:definition "A classification of the certainty level assigned to an ontology alignment correspondence, ranging from high confidence with strong evidence to low confidence requiring manual verification."@en ;
    skos:example "Mapping with confidence 0.95 is highly reliable."@en .

meta:OneToOneMapping a owl:Class ;
    rdfs:label "One-to-One Mapping"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "One-to-One Mapping - ontology alignment cardinality pattern."@en,
        "Single concept maps to single concept."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-642-38721-0> ;
    rdfs:subClassOf kb:MappingTechnique,
        meta:Mapping ;
    skos:definition "A mapping technique that establishes direct correspondences where each source element maps to exactly one target element, representing the simplest and most common alignment relationship type."@en ;
    skos:example "Car in A maps to Automobile in B."@en .

meta:OntologyEditor a owl:Class ;
    rdfs:label "Ontology Editor"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Protégé: A Tool for Editing OWL Ontologies. Stanford University. https://protege.stanford.edu/"@en ;
    rdfs:comment "Specialized tool for editing ontology artifacts with graphical or textual interfaces."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2014.6816804> ;
    rdfs:subClassOf meta:DevelopmentTool ;
    skos:definition "A software application that provides a graphical or text-based interface for creating, viewing, modifying, and managing ontology classes, properties, axioms, and instance data with syntax validation."@en ;
    skos:example "Protégé provides both a graphical interface and forms-based editing for OWL ontologies."@en .

meta:SymbioticOntologyModel a owl:Class ;
    rdfs:label "Symbiotic Ontology Model"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Symbiotic ontology design: dual-layer architecture for navigational and computational concerns",
        "Dual-layer ontology architecture pattern for navigational and computational concerns."@en ;
    rdfs:comment "Definition authored during a reliability ontology remediation 2026-02-09; pending domain expert review."@en,
        "Local proxy class equivalent to http://example.org/knowledge-base#SymbioticOntologyModel."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1>,
        <https://www.w3.org/TR/owl2-primer/> ;
    rdfs:subClassOf qc:QualityConcept ;
    skos:definition "An ontology architecture pattern that integrates multiple complementary layers and views to serve both human understanding and machine processing needs simultaneously."@en ;
    skos:example "A SymbioticOntologyModel combines a NavigationalLayer for human browsing with a ComputationalLayer for reasoning, exposed through HumanReadable and MachineProcessable views."@en,
        "The OE package itself exemplifies a SymbioticOntologyModel: a reliability ontology defines the gate vector, AMOD governs naming, META provides the engineering pattern vocabulary, OQC supplies the quality metrics, and CORE furnishes the shared primitives — each module depends on and reinforces the others."@en .

meta:SyntaxValidator a owl:Class ;
    rdfs:label "Syntax Validator"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Validator checking well-formedness and syntactic correctness of ontology serialization."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf meta:ValidationTool ;
    skos:definition "A validation tool that verifies ontology files conform to their declared serialization format grammar, detecting parse errors, encoding issues, undeclared prefixes, and malformed URI references."@en ;
    skos:example "W3C RDF Validator checks Turtle syntax and reports parsing errors."@en .

meta:TableauBasedReasoner a owl:Class ;
    rdfs:label "Tableau-Based Reasoner"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "W3C OWL 2 Web Ontology Language (2012). https://www.w3.org/TR/owl2-overview/"@en ;
    rdfs:comment "Reasoner using tableau algorithms to prove satisfiability and entailment."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1145/1656274.1656281>,
        <https://www.w3.org/TR/owl2-primer/> ;
    rdfs:subClassOf meta:DLReasoner ;
    skos:definition "A description logic reasoner that uses tableau expansion algorithms to determine satisfiability of class expressions, providing completeness for expressive OWL profiles at the cost of potentially exponential computation."@en ;
    skos:example "HermiT uses hypertableau calculus for OWL 2 reasoning with optimized blocking."@en .

meta:WebBasedEditor a owl:Class ;
    rdfs:label "Web-Based Editor"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Protégé: A Tool for Editing OWL Ontologies. Stanford University. https://protege.stanford.edu/"@en ;
    rdfs:comment "Browser-based ontology editor accessible through web interface without local installation."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1145/2063518.2063520> ;
    rdfs:subClassOf meta:OntologyEditor ;
    skos:definition "An ontology editor accessed through a web browser, enabling collaborative multi-user editing, centralized version management, and platform-independent access without local software installation."@en ;
    skos:example "WebProtégé allows teams to collaboratively edit ontologies through a web browser."@en .

performance:LoadingPerformanceTest a owl:Class ;
    rdfs:label "Loading Performance Test"@en ;
    measurement:hasMeasurementSubject measurement:OperationalEnvironmentMeasurementSubject ;
    dcterms:isPartOf <http://example.org/performance> ;
    dcterms:source "Migrated from reliability:LoadingPerformanceTest (a reliability ontology v3.0.0). Scheduled for deletion at a reliability ontology step 9."@en ;
    rdfs:comment "Performance test subtype measuring the time/resource cost of loading an ontology or artifact."@en ;
    rdfs:isDefinedBy <http://example.org/performance> ;
    rdfs:seeAlso testing:LoadingPerformanceTest ;
    rdfs:subClassOf performance:PerformanceTest ;
    skos:definition "Performance test subtype measuring the time/resource cost of loading an ontology or artifact."@en ;
    skos:exactMatch testing:LoadingPerformanceTest .

performance:Performance a owl:Class ;
    rdfs:label "Performance"@en ;
    measurement:hasMeasurementSubject measurement:OperationalEnvironmentMeasurementSubject ;
    dcterms:isPartOf <http://example.org/performance> ;
    dcterms:source "Migrated from reliability:Performance (a reliability ontology v3.0.0) and quality:PerformanceEfficiency (OQC v2.3.0). Authoritative canonical home in performance: subject per user ruling 2026-05-13."@en ;
    rdfs:comment "Top-level Performance characteristic — umbrella for performance concerns of a software, ontology, or engineering artifact. Subclasses refine specific performance characteristics."@en ;
    rdfs:isDefinedBy <http://example.org/performance> ;
    rdfs:seeAlso reliability:Performance ;
    rdfs:subClassOf performance:PerformanceConcept ;
    skos:definition "Top-level Performance characteristic — umbrella for performance concerns of a software, ontology, or engineering artifact. Subclasses refine specific performance characteristics."@en ;
    skos:related reliability:Performance .

performance:QueryPerformanceTest a owl:Class ;
    rdfs:label "Query Performance Test"@en ;
    measurement:hasMeasurementSubject measurement:OperationalEnvironmentMeasurementSubject ;
    dcterms:isPartOf <http://example.org/performance> ;
    dcterms:source "Migrated from reliability:QueryPerformanceTest (a reliability ontology v3.0.0). Scheduled for deletion at a reliability ontology step 9."@en ;
    rdfs:comment "Performance test subtype measuring the time/resource cost of executing queries."@en ;
    rdfs:isDefinedBy <http://example.org/performance> ;
    rdfs:seeAlso testing:QueryPerformanceTest ;
    rdfs:subClassOf performance:PerformanceTest ;
    skos:definition "Performance test subtype measuring the time/resource cost of executing queries."@en ;
    skos:exactMatch testing:QueryPerformanceTest .

performance:ReasoningPerformanceTest a owl:Class ;
    rdfs:label "Reasoning Performance Test"@en ;
    measurement:hasMeasurementSubject measurement:OperationalEnvironmentMeasurementSubject ;
    dcterms:isPartOf <http://example.org/performance> ;
    dcterms:source "Migrated from reliability:ReasoningPerformanceTest (a reliability ontology v3.0.0). Scheduled for deletion at a reliability ontology step 9."@en ;
    rdfs:comment "Performance test subtype measuring the time/resource cost of running an OWL reasoner."@en ;
    rdfs:isDefinedBy <http://example.org/performance> ;
    rdfs:seeAlso testing:ReasoningPerformanceTest ;
    rdfs:subClassOf performance:PerformanceTest ;
    skos:definition "Performance test subtype measuring the time/resource cost of running an OWL reasoner."@en ;
    skos:exactMatch testing:ReasoningPerformanceTest .

qc:AssessmentConfiguration a owl:Class ;
    rdfs:label "Assessment Configuration"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25040:2011 §7.1 - Evaluation Requirements" ;
    rdfs:comment "Groups configuration and parameterization entities."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf qc:QualityDomainEntity ;
    skos:definition "An abstract superclass for configuration parameters that govern how a quality assessment is conducted, including gate thresholds, metric weights, scoring rules, and pass-fail criteria."@en ;
    skos:example "GateConfig is an AssessmentConfiguration specifying threshold values and metric weights for quality gate evaluation."@en .

qc:Availability a owl:Class ;
    rdfs:label "Availability"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 - Reliability/Availability" ;
    rdfs:comment "The degree to which an ontology is operational and accessible when required for use."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35730.html> ;
    rdfs:subClassOf qc:Reliability ;
    skos:broader qc:Reliability ;
    skos:definition "A reliability sub-characteristic measuring the degree to which an ontology is operational and accessible when required for use. For ontologies, this includes accessibility through standard APIs, query endpoints, availability of serialization formats, and uptime of ontology services."@en ;
    skos:example "An ontology with high availability is accessible 24/7 through SPARQL endpoints, provides multiple serialization formats (RDF/XML, Turtle, JSON-LD), has redundant hosting, and maintains service level agreements for query response times."@en ;
    skos:related qc:FaultTolerance .

qc:Consistency a owl:Class ;
    rdfs:label "Consistency"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 §4.2.6 - Internal Consistency" ;
    rdfs:comment "The degree to which content is coherent and non-contradictory."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35730.html> ;
    rdfs:subClassOf qc:FunctionalQuality ;
    skos:broader qc:FunctionalQuality ;
    skos:definition """A quality dimension that evaluates whether the ontology is internally coherent 
    with no logical contradictions or conflicts. Consistency includes syntactic consistency (valid 
    syntax), semantic consistency (no contradictory axioms), and terminological consistency (uniform 
    naming conventions)."""@en ;
    skos:example """A consistent ontology has no conflicting axioms that would cause reasoning 
    failures, uses uniform naming patterns, and maintains coherent hierarchies."""@en ;
    skos:related qc:Clarity,
        qc:Correctness .

qc:FaultTolerance a owl:Class ;
    rdfs:label "Fault Tolerance"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 - Reliability/Fault Tolerance" ;
    rdfs:comment "The degree to which an ontology operates as intended despite the presence of faults or errors."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35730.html> ;
    rdfs:subClassOf qc:Reliability ;
    skos:broader qc:Reliability ;
    skos:definition "A reliability sub-characteristic measuring the degree to which an ontology operates as intended despite the presence of modeling errors, incomplete data, or malformed queries. For ontologies, this includes graceful degradation when encountering inconsistencies, handling of incomplete instance data, and robustness against query errors."@en ;
    skos:example "A fault-tolerant ontology continues to provide valid inferences even when some axioms are temporarily disabled, handles malformed SPARQL queries with informative error messages, and maintains logical consistency when encountering incomplete instance data through closed-world assumptions or default reasoning."@en ;
    skos:related qc:Recoverability .

qc:Faultlessness a owl:Class ;
    rdfs:label "Faultlessness"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 - Reliability/Faultlessness" ;
    rdfs:comment "The degree to which an ontology operates without manifesting faults under normal operation."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35730.html> ;
    rdfs:subClassOf qc:Reliability ;
    skos:altLabel "Maturity"@en ;
    skos:broader qc:Reliability ;
    skos:definition "A reliability sub-characteristic measuring the degree to which an ontology operates without manifesting faults under normal operation. For ontologies, this includes absence of unsatisfiable classes, minimal occurrence of reasoning errors, low incidence of query failures, and stability across multiple reasoning cycles. Formerly known as 'Maturity' in ISO 25010:2011."@en ;
    skos:example "A faultless ontology has zero unsatisfiable classes after classification, produces no reasoning warnings or errors, successfully executes all competency question queries without failures, maintains logical consistency across 1000+ reasoning iterations, and demonstrates stable behavior with different reasoners (Pellet, HermiT, ELK)."@en .

qc:GateDecision a owl:Class ;
    rdfs:label "Gate Decision"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25040:2011 §7.4 - Evaluation Process, Evaluation and Conclusion Phase" ;
    rdfs:comment "A recorded pass/fail decision for a quality gate."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35730.html> ;
    rdfs:subClassOf [ ],
        qc:AssessmentOutput,
        qc:QualityGate ;
    skos:definition """A documented decision indicating whether an ontology artifact has passed 
    or failed a quality gate based on the gate configuration criteria. Gate decisions record 
    the actual scores achieved, the assessment date, the decision maker, and any conditional 
    approvals or required remediation actions."""@en ;
    skos:example """GateDecision_Phase2_Pass: Decision recording that OQC v1.0 passed Phase 2 
    quality gate with overall score 96%, all dimensions above thresholds, approved for Phase 3."""@en .

qc:Maintainability a owl:Class ;
    rdfs:label "Maintainability"@en ;
    qc:hasMetric measurement:CBOnto,
        measurement:DITOnto,
        measurement:LCOMOnto,
        measurement:NOCOnto,
        measurement:NOMOnto,
        measurement:RFCOnto,
        measurement:WMCOnto ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 §4.2.7 - Maintainability" ;
    rdfs:comment "The ease with which the ontology can be maintained and updated."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35730.html> ;
    rdfs:subClassOf qc:PragmaticQuality ;
    skos:broader qc:PragmaticQuality ;
    skos:definition """A quality dimension that evaluates how easily an ontology can be maintained, 
    debugged, and updated over time. Maintainability is enhanced by clear documentation, modular 
    structure, consistent naming conventions, comprehensive change logs, and good test coverage."""@en ;
    skos:example """A maintainable ontology has 95% definition coverage, consistent naming patterns, 
    modular organization, and comprehensive test suites enabling safe refactoring."""@en ;
    skos:related qc:Adaptability,
        qc:Reusability .

qc:QualityAnalyzer a owl:Class ;
    rdfs:label "Quality Analyzer"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software quality requirements and evaluation (SQuaRE) — Product quality model."@en ;
    rdfs:comment "A role or tool that performs automated or semi-automated analysis of ontology quality characteristics, computing metrics and identifying potential defects."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-30203-2_5>,
        <https://www.iso.org/standard/35730.html> ;
    rdfs:subClassOf core:Role ;
    skos:definition "A role or tool that performs automated or semi-automated analysis of ontology quality characteristics, computing metrics and identifying potential defects."@en ;
    skos:example "pySHACL acting as a QualityAnalyzer: given redo_shacl_v2_0_6.ttl as the shapes graph and core_v1_1_4.ttl as the data graph, it produces a validation report identifying zero violations — a quantified quality signal."@en .

qc:Requirement a owl:Class ;
    rdfs:label "Requirement"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "IEEE 830-1998 - Recommended Practice for Software Requirements Specifications" ;
    rdfs:comment "Local proxy class equivalent to http://example.org/knowledge-base#Requirement."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35730.html> ;
    rdfs:subClassOf qc:QualityConcept ;
    skos:definition "A formal specification of a capability, constraint, or quality attribute that an ontology must satisfy, serving as a basis for verification and quality gate evaluation."@en ;
    skos:example "Requirement FR-001: 'The ontology shall represent all domain entities identified in the glossary' — verified through term mapping coverage metrics."@en .

qc:Usability a owl:Class ;
    rdfs:label "Usability"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 §4.2.4 - Operability / Usability" ;
    rdfs:comment "The ease with which humans can understand and use the ontology."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35730.html> ;
    rdfs:subClassOf qc:PragmaticQuality ;
    skos:broader qc:PragmaticQuality ;
    skos:definition """A quality dimension that evaluates how easily human users can understand, 
    navigate, and apply the ontology. Usability metrics include label coverage, documentation 
    quality, example availability, and the presence of human-readable views."""@en ;
    skos:example """A highly usable ontology has 100% label coverage, clear definitions for all 
    classes, comprehensive examples, and human-readable documentation views."""@en ;
    skos:related qc:Adaptability,
        qc:Clarity .

reliability:BehaviorConcern a owl:Class ;
    rdfs:label "Behavior Concern"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Avizienis et al. 2004",
        "Gemini behavioral pathology report: BehaviorConcern primitive" ;
    rdfs:comment """Ontological primitive defining non-negotiable semantic
    boundaries. Integrated into prompt architecture to enforce calibration,
    define negative signals, and map evidence-object binding. Each
    BehaviorConcern must have at least one associated EmpiricalTest that
    can verify its enforcement mechanically."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf reliability:VerificationMethod ;
    skos:definition """Ontological verification primitive that defines a
    non-negotiable semantic boundary in LLM-assisted development,
    specifying what behavioral compliance means for a given architectural
    component and how violations are detected"""@en ;
    skos:example "Documented observation that model produces increasingly sycophantic responses in multi-turn dialogues."@en .

reliability:BehavioralComplianceTesting a owl:Class ;
    rdfs:label "Behavioral Compliance Testing"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Avizienis, A., Laprie, J.-C., Randell, B., & Landwehr, C. (2004). Basic Concepts and Taxonomy of Dependable and Secure Computing. IEEE Transactions on Dependable and Secure Computing, 1(1), 11-33. DOI:10.1109/TDSC.2004.2"@en ;
    rdfs:comment """Tests whether a component's behavior satisfies its
    BehaviorConcern specification, not merely whether the component
    exists and compiles. Distinguished from structural testing (file
    exists, imports present, syntax valid) which is susceptible to
    decorative compliance."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:LLMTestingMethod ;
    skos:definition """Testing methodology that verifies whether LLM-generated
    components satisfy their BehaviorConcern specifications through
    observable behavioral outcomes rather than structural or syntactic
    indicators"""@en ;
    skos:example "Systematically presenting edge cases where the model should acknowledge uncertainty (novel domains, ambiguous queries) to verify FailLoudProtocol compliance."@en,
        "Verifying that an LLM consistently refuses to provide harmful instructions across 500 test scenarios."@en .

reliability:BlindSpot a owl:Class ;
    rdfs:label "Blind Spot"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NEEDS_EXPERT_REVIEW: a reliability ontology-native concept. General concept from cognitive psychology (Pronin, Lin, Ross, 2002. The Bias Blind Spot)."@en ;
    rdfs:comment "An individual knowledge gap in a reliability assessment, characterized by severity (HIGH/MEDIUM/LOW), a description of what is missing, and a proposal for what research would fill the gap."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf reliability:BlindSpotRegister ;
    skos:definition "An individual knowledge gap in a reliability assessment, characterized by severity (HIGH/MEDIUM/LOW), a description of what is missing, and a proposal for what research would fill the gap."@en ;
    skos:example "Example: ex:BS-9 a redo:BlindSpot ; rdfs:label \"Effort Avoidance as Impossibility\" ; redo:blindSpotSeverity \"HIGH\" ; skos:definition \"Assessor may declare tasks impossible without attempting them, masking capability gaps.\" . This blind spot was identified forensically in the GamifyOnt validation session."@en .

reliability:ChainOfVerification a owl:Class ;
    rdfs:label "Chain of Verification"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "LLM reliability research corpus: Malmqvist 2024, Ma et al. 2024, Ji et al. 2023 (arXiv:2311.05232)" ;
    rdfs:comment """Multi-step process: generate initial response, create verification questions, 
    answer them, revise initial response based on verification."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:LLMTestingMethod ;
    skos:altLabel "CoVe"@en ;
    skos:definition "ChainOfVerification is an LLM testing method that validates model outputs through sequential verification steps, where each step independently checks a different aspect of the response's factual accuracy and logical consistency."@en ;
    skos:example "After generating a historical claim, prompting: 'Verify each fact: 1) Was Napoleon born in 1769? Check: Encyclopedia confirms August 15, 1769. VERIFIED.'"@en,
        "Three-step drug interaction check: FDA database, clinical guidelines, contraindication cross-reference."@en .

reliability:CompactionFidelityDrift a owl:Class ;
    rdfs:label "Compaction Fidelity Drift"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.14 — derived from audit_v15_2_session_coverage_v1_0_0.md §4.4 (2026-05-03). User's repeated discipline statement explicitly anchors on this concern."@en ;
    rdfs:comment "A drift pathology in which conversation context compaction (the platform's automatic summarisation when context grows) introduces deflation, and a subsequent audit or sprint grounds claims on the compacted summary rather than on the original turns. The audit thereby inherits any inflations, omissions, or distortions the compaction introduced. Distinct from CrossSessionContamination (which is about content from OTHER sessions misattributed to the current session): CompactionFidelityDrift is INTRA-session — the contamination is the platform's own compression of this session's earlier turns. Distinct from InstructionDecay (passive context-length salience loss, where the agent forgets an instruction): CompactionFidelityDrift is about the platform structurally compressing the conversation history. The user's standing instruction 'Never trust to summaries or deflated content' is anchored specifically on this concern."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:Drift,
        reliability:OutputFidelityDrift ;
    skos:definition "A drift pathology in which intra-session context compaction produces a deflated summary, and downstream reasoning grounds on the summary rather than on the original turns or on-disk artefacts."@en ;
    skos:example "Real audit event 2026-05-03 audit_v15_2_session_coverage_v1_0_0.md §4.4: this very chat's context contains a compaction summary (the platform inserts a [NOTE: This conversation was successfully compacted to free up space] block). The audit explicitly grounds on /mnt/transcripts/ + on-disk artefacts to mitigate, but the compaction event itself is real. Severity MEDIUM (inherent to long-context platforms; mitigation is byte-grounding and the user's repeated discipline 'Never trust the summaries or deflated content')."@en .

reliability:Compatibility a owl:Class ;
    rdfs:label "Compatibility"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://www.iso.org/standard/78176.html> ;
    rdfs:comment "Includes interoperability and coexistence"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso qc:Compatibility,
        <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf reliability:QualityCharacteristic ;
    skos:definition "Degree to which a product can exchange information with other products and/or perform required functions while sharing the same environment and resources"@en ;
    skos:example "REST API maintaining backwards compatibility across 3 major versions through content negotiation."@en ;
    skos:related qc:Compatibility .

reliability:Concept a owl:Class ;
    rdfs:label "Concept"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:comment "Includes theoretical constructs, principles, and abstract categories"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.w3.org/TR/prov-o/> ;
    rdfs:subClassOf reliability:Entity ;
    skos:definition "Concept is a top-level abstract category in the a reliability ontology ontology that serves as the superclass for domain-specific knowledge elements including failure modes, quality characteristics, metrics, and contextual factors."@en ;
    skos:example "Top-level organizational category encompassing quality tradeoffs, regulatory frameworks, domain contexts, and constraints."@en .

reliability:Constraint a owl:Class ;
    rdfs:label "Constraint"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC 25010:2023 §4 Product quality model; IEEE 1633-2016 §5 Constraints on reliability."@en ;
    rdfs:comment "A condition, limitation, or restriction imposed on a system, process, or artifact that bounds its operational parameters, resource consumption, or behavioral envelope and must be satisfied for reliable operation within its intended context."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf reliability:ReliabilityConcept ;
    skos:definition "A condition, limitation, or restriction imposed on a system, process, or artifact that bounds its operational parameters, resource consumption, or behavioral envelope and must be satisfied for reliable operation within its intended context."@en ;
    skos:example "Budget limit of $10K/month constrains infrastructure choices, affecting redundancy and failover options."@en .

reliability:DecorativeVerification a owl:Class ;
    rdfs:label "Decorative Verification"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source """Forensic analysis of a reliability ontology v2.1.0 HTML update session, February 2026. 
    After applying 21 change groups, assessor ran grep-based verification 
    (pathology counts, metric counts, section checks) and declared 'all 
    verified.' A structured Python cross-file audit then found 5 stale 
    references: nav '21 Metrics' (should be 25), Novel metrics '(11)' in 
    three locations (should be 15), mind map tree missing assessor cognitive 
    failures branch."""@en ;
    rdfs:comment """LLM behavioral pathology in which verification activity produces output 
    (grep counts, line numbers, spot checks, 'all verified' declarations) without 
    testing the specific claim being verified. The verification looks thorough — 
    it has the structural form of a quality check — but cannot detect the failure 
    mode it purports to guard against.
    
    This is a compound of DecorativeCompliance and TestSuiteTheater applied to 
    the verification/assessment context:
    - From DecorativeCompliance: the verification optimizes for the appearance 
      of thoroughness (format) over actual defect detection (substance).
    - From TestSuiteTheater: the verification 'passes' but has zero power to 
      detect the specific failure mode at issue. Like tests that achieve high 
      coverage but catch no mutations.
    
    Distinguished from DecorativeCompliance: DecorativeCompliance produces 
    content (reports, code, documentation) that is structurally complete 
    but substantively empty. DecorativeVerification produces verification 
    that is procedurally complete but detection-blind.
    
    Distinguished from TestSuiteTheater: TestSuiteTheater involves generating 
    tests for code; DecorativeVerification involves generating verification 
    checks for assessment claims. The structural analogy is exact: both 
    achieve apparent coverage (line coverage / check count) while missing 
    actual defects (mutation score = 0 / stale counts undetected).
    
    Distinguished from EffortAvoidanceBias: EffortAvoidanceBias avoids 
    producing output entirely (declares impossible). DecorativeVerification 
    produces verification output — it just cannot detect the relevant failures.
    
    Key insight: the pathology is invisible to the assessor because the 
    verification output itself reinforces the 'verified' narrative. Grep 
    returning counts that look right creates false confidence that all 
    counts are right."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:LLMBehavioralPathology ;
    owl:disjointWith reliability:DecorativeCompliance,
        reliability:EffortAvoidanceBias,
        reliability:TestSuiteTheater ;
    skos:definition """LLM behavioral pathology in which verification activity produces output 
    (grep counts, line numbers, spot checks, 'all verified' declarations) without 
    testing the specific claim being verified. The verification looks thorough — 
    it has the structural form of a quality check — but cannot detect the failure 
    mode it purports to guard against.
    
    This is a compound of DecorativeCompliance and TestSuiteTheater applied to 
    the verification/assessment context:
    - From DecorativeCompliance: the verification optimizes for the appearance 
      of thoroughness (format) over actual defect detection (substance).
    - From TestSuiteTheater: the verification 'passes' but has zero power to 
      detect the specific failure mode at issue. Like tests that achieve high 
      coverage but catch no mutations.
    
    Distinguished from DecorativeCompliance: DecorativeCompliance produces 
    content (reports, code, documentation) that is structurally complete 
    but substantively empty. DecorativeVerification produces verification 
    that is procedurally complete but detection-blind.
    
    Distinguished from TestSuiteTheater: TestSuiteTheater involves generating 
    tests for code; DecorativeVerification involves generating verification 
    checks for assessment claims. The structural analogy is exact: both 
    achieve apparent coverage (line coverage / check count) while missing 
    actual defects (mutation score = 0 / stale counts undetected).
    
    Distinguished from EffortAvoidanceBias: EffortAvoidanceBias avoids 
    producing output entirely (declares impossible). DecorativeVerification 
    produces verification output — it just cannot detect the relevant failures.
    
    Key insight: the pathology is invisible to the assessor because the 
    verification output itself reinforces the 'verified' narrative. Grep 
    returning counts that look right creates false confidence that all 
    counts are right."""@en ;
    skos:example """Verification of '11→16 pathology count update': assessor runs 
    grep -c '16 pathologies' and gets 10 matches — looks correct. But the 
    assessor does not run grep for STALE values ('11 pathologies', '21 metrics') 
    that should have been updated but weren't. The verification confirms the 
    presence of correct values without checking for the absence of incorrect 
    ones. 5 stale references survive."""@en .

reliability:Deployment a owl:Class ;
    rdfs:label "Deployment"@en ;
    core:precedes reliability:Maintenance ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:comment "Transition from development to operational use"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf reliability:LifecyclePhase ;
    skos:definition "Deployment is a lifecycle phase in which a validated software system or AI model is released into a production environment, establishing operational baselines and initiating continuous reliability monitoring."@en ;
    skos:example "Blue-green deployment switching production traffic from v2.3 to v2.4 with instant rollback capability."@en .

reliability:Design a owl:Class ;
    rdfs:label "Design"@en ;
    core:precedes reliability:Implementation ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:comment "Transforms requirements into implementable specifications"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf reliability:LifecyclePhase ;
    skos:definition "Design is a lifecycle phase in which system architecture, component structure, and behavioral specifications are established, incorporating reliability requirements, quality attribute trade-offs, and failure mitigation strategies."@en ;
    skos:example "Architecture decision record documenting the choice of circuit breaker pattern over retry-with-backoff."@en .

reliability:DetectionMechanism a owl:Class ;
    rdfs:label "Detection Mechanism"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.9.0 detection-attribution extension."@en ;
    rdfs:comment "A named mechanism by which a behavioral-pathology incident is surfaced. Subclass of VerificationMethod for compatibility with the pre-existing :detectedBy range constraint."@en ;
    rdfs:isDefinedBy <http://example.org/redo/v2.9.0/detection-attribution> ;
    rdfs:subClassOf reliability:VerificationMethod ;
    skos:definition "A named mechanism by which a behavioral-pathology incident is surfaced. Subclass of VerificationMethod for compatibility with the pre-existing :detectedBy range constraint."@en .

reliability:EnrichmentWithoutBridgeVerification a owl:Class ;
    rdfs:label "Enrichment Without Bridge Verification"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Forensic analysis of a component library v2.2.1 component catalog remediation, February 2026."@en ;
    rdfs:comment """A compound failure mode where an assessor enriches a data layer 
    (ontology, schema, configuration, localization) without first verifying that 
    the consumption bridge (parser, loader, adapter, compiler) can read the 
    enriched content. Results in structurally correct but operationally 
    unreachable content that inflates quality metrics while runtime behavior 
    remains unchanged.
    
    Distinct from VerificationAdequacyCompound (v2.2.0): the verification 
    adequacy compound addresses inadequate verification of changes that WERE 
    applied. EnrichmentWithoutBridgeVerification addresses enrichment of a 
    layer whose consumption pathway is BROKEN — the changes are never applied 
    at runtime regardless of verification quality.
    
    Distinct from AssessorBiasCompound (v2.1.0): the assessor bias compound 
    addresses false impossibility claims (non-attempt) via the chain 
    CompetenceParadox → EffortAvoidanceBias → NarrativeAnchoring. 
    EnrichmentWithoutBridgeVerification addresses productive effort that is 
    architecturally disconnected — the assessor IS working, but on the wrong 
    layer — via a different chain: PathOfLeastResistance → 
    FeatureCreepOverFoundation → DecorativeCompliance. The two compounds 
    share zero intermediate pathologies and are sibling subclasses of 
    LLMFailure, not parent-child.
    
    The canonical pattern is:
    
    1. PathOfLeastResistance → generating new ontology content (SHACL shapes, 
       labels, defaults) is statistically easier than debugging/rewriting 
       the parser that consumes them
    2. FeatureCreepOverFoundation → visible metrics (shape count, label count, 
       coverage percentages) are prioritized over the invisible bridge that 
       makes them operational
    3. DecorativeCompliance → surrogate quality signals (parse success rate, 
       rdfs:comment 100%, SHACL 230/230) are satisfied while the runtime 
       integration that gives them meaning is broken
    4. FalseConfirmationBias → success is declared from file-level metrics 
       (triple counts, coverage percentages) rather than behavioral tests 
       (does getMessage() return ontology values?)
    5. DecorativeVerification → verification produces quantified output 
       ('+190 shapes', '+124 labels', '100% coverage') without testing 
       whether the runtime can consume any of it
    
    The temporal ordering is the distinguishing feature: enrichment occurs 
    BEFORE bridge verification. This creates a growing stock of unreachable 
    content that makes quality metrics look better while runtime is broken — 
    the more enrichment, the wider the gap between reported quality and 
    actual operational capability.
    
    Structural parallel to architectural debt: the enrichment is an asset 
    on the ontology balance sheet but a liability on the runtime balance 
    sheet, because every addition increases the delta that will be revealed 
    when the bridge is eventually tested."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1145/3571730> ;
    rdfs:subClassOf reliability:LLMFailure ;
    skos:definition """A compound failure mode where an assessor enriches a data layer 
    (ontology, schema, configuration, localization) without first verifying that 
    the consumption bridge (parser, loader, adapter, compiler) can read the 
    enriched content. Results in structurally correct but operationally 
    unreachable content that inflates quality metrics while runtime behavior 
    remains unchanged.
    
    Distinct from VerificationAdequacyCompound (v2.2.0): the verification 
    adequacy compound addresses inadequate verification of changes that WERE 
    applied. EnrichmentWithoutBridgeVerification addresses enrichment of a 
    layer whose consumption pathway is BROKEN — the changes are never applied 
    at runtime regardless of verification quality.
    
    Distinct from AssessorBiasCompound (v2.1.0): the assessor bias compound 
    addresses false impossibility claims (non-attempt) via the chain 
    CompetenceParadox → EffortAvoidanceBias → NarrativeAnchoring. 
    EnrichmentWithoutBridgeVerification addresses productive effort that is 
    architecturally disconnected — the assessor IS working, but on the wrong 
    layer — via a different chain: PathOfLeastResistance → 
    FeatureCreepOverFoundation → DecorativeCompliance. The two compounds 
    share zero intermediate pathologies and are sibling subclasses of 
    LLMFailure, not parent-child.
    
    The canonical pattern is:
    
    1. PathOfLeastResistance → generating new ontology content (SHACL shapes, 
       labels, defaults) is statistically easier than debugging/rewriting 
       the parser that consumes them
    2. FeatureCreepOverFoundation → visible metrics (shape count, label count, 
       coverage percentages) are prioritized over the invisible bridge that 
       makes them operational
    3. DecorativeCompliance → surrogate quality signals (parse success rate, 
       rdfs:comment 100%, SHACL 230/230) are satisfied while the runtime 
       integration that gives them meaning is broken
    4. FalseConfirmationBias → success is declared from file-level metrics 
       (triple counts, coverage percentages) rather than behavioral tests 
       (does getMessage() return ontology values?)
    5. DecorativeVerification → verification produces quantified output 
       ('+190 shapes', '+124 labels', '100% coverage') without testing 
       whether the runtime can consume any of it
    
    The temporal ordering is the distinguishing feature: enrichment occurs 
    BEFORE bridge verification. This creates a growing stock of unreachable 
    content that makes quality metrics look better while runtime is broken — 
    the more enrichment, the wider the gap between reported quality and 
    actual operational capability.
    
    Structural parallel to architectural debt: the enrichment is an asset 
    on the ontology balance sheet but a liability on the runtime balance 
    sheet, because every addition increases the delta that will be revealed 
    when the bridge is eventually tested."""@en ;
    skos:example """In a component library component catalog remediation:
    Wave 3 (Artifact Cleanup): populated 4 empty defaults.ttl files with 
    domain-appropriate configuration and message triples (18-21 triples each).
    Wave 4 (Compliance Hardening): added 190 SHACL shapes (+150 from 40), 
    124 Turkish rdfs:label values, 138 rdfs:comment annotations.
    
    All ontologically valid. All parseable by RDFLib. Coverage metrics 
    improved: rdfs:comment 54%→100%, Turkish labels 14/41→85.2%, 
    SHACL 19/41→230/230 classes.
    
    But: SchemaAdapter._parseSchema() was a 50-line regex stub that 
    returned 0 messages, 0 config, 0 instances from defaults.ttl. 
    The runtime bridge was broken. getMessage() could not access any 
    of the 309 messages from ontology. None of the 118 config keys 
    were runtime-accessible. None of the 196 Turkish class labels 
    were available to the UI.
    
    Discovered when the assessor performed an honest production-readiness 
    assessment and executed the SchemaAdapter against real .ttl files — 
    the first time this was attempted during the entire remediation.
    
    Fixed by rewriting SchemaAdapter to v3.0.0 (556 lines, full Turtle 
    parser with blank node expansion, typed literals, language tags). 
    All 41/41 components now bridge-verified with 45 integration tests."""@en .

reliability:FalseConfirmationBias a owl:Class ;
    rdfs:label "False Confirmation Bias"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Avizienis, A., Laprie, J.-C., Randell, B., & Landwehr, C. (2004). Basic Concepts and Taxonomy of Dependable and Secure Computing. IEEE Transactions on Dependable and Secure Computing, 1(1), 11-33. DOI:10.1109/TDSC.2004.2"@en ;
    rdfs:comment """Distinguished from Sycophancy: sycophancy aligns with
    user beliefs; false confirmation bias confirms compliance from
    superficial indicators without verifying actual state. The LLM reports
    a component as integrated based on file existence or import presence
    rather than behavioral correctness."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:LLMBehavioralPathology ;
    skos:definition """Software engineering manifestation where an LLM confirms
    compliance, completion, or correctness based on superficial indicators
    such as file existence or syntactic presence rather than verified
    behavioral integration"""@en ;
    skos:example "Model selectively citing only papers that support the user's hypothesis while ignoring contradictory evidence."@en .

reliability:Fault a reliability:FailureConcept,
        owl:Class ;
    rdfs:label "Fault"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "IEEE 1044-2009 Standard Classification for Software Anomalies."@en ;
    rdfs:comment """A fault is a defect in the system that may cause an error. 
    Not all faults lead to failures - they must be activated."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/50641.html> ;
    rdfs:subClassOf reliability:FailureConcept ;
    owl:disjointWith reliability:Failure ;
    skos:altLabel "Bug"@en,
        "Defect"@en ;
    skos:definition "Fault is the adjudged or hypothesized cause of an error, representing a defect in the system's design, implementation, or configuration that lies dormant until activated by specific conditions, whereupon it produces an error that may propagate to cause an observable failure at the system boundary."@en ;
    skos:example "Uninitialized variable in SPARQL query builder produces malformed WHERE clause under specific input patterns."@en .

reliability:FormalVerification a owl:Class ;
    rdfs:label "Formal Verification"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Baier, C., & Katoen, J.-P. (2008). Principles of Model Checking. MIT Press."@en ;
    rdfs:comment "Provides strongest correctness guarantees but requires formal models"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf reliability:VerificationMethod ;
    skos:definition "FormalVerification is a verification method providing mathematical proof of system correctness with respect to formal specifications, using techniques such as model checking, theorem proving, and abstract interpretation to guarantee that implementations satisfy their requirements under all possible executions."@en ;
    skos:example "Coq proof assistant verifies that sorting algorithm preserves list length and produces ordered output for all possible inputs."@en .

reliability:Mandelbug a owl:Class ;
    rdfs:label "Mandelbug"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://www.grottke.de/documents/AClassificationOfSWFaults.pdf> ;
    rdfs:comment """Named after the Mandelbrot set (complex, chaotic patterns). 
    Mandelbugs exhibit complex behavior where circumstances of activation or failure 
    manifestation are intricate and difficult to reproduce consistently."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/50641.html> ;
    rdfs:subClassOf reliability:BehavioralFaultClass ;
    owl:disjointWith reliability:Bohrbug ;
    skos:definition "Mandelbug is a software fault type that exhibits complex, seemingly non-deterministic behavior difficult to reproduce due to sensitivity to timing, concurrency, resource state, or environmental conditions."@en ;
    skos:example "A race condition in concurrent code that manifests only under specific thread scheduling patterns."@en,
        "Race condition only reproducible under specific thread scheduling that occurs once per 10000 executions."@en .

reliability:Modularity a owl:Class ;
    rdfs:label "Modularity"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC 25010:2023 §3.7 Maintainability, §3.7.1 Modularity sub-characteristic."@en ;
    rdfs:comment "A quality characteristic measuring the degree to which a system is composed of discrete, loosely coupled components with well-defined interfaces, enabling independent development, testing, replacement, and maintenance of individual modules."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso qc:Modularity,
        <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf reliability:QualityCharacteristic ;
    skos:definition "A quality characteristic measuring the degree to which a system is composed of discrete, loosely coupled components with well-defined interfaces, enabling independent development, testing, replacement, and maintenance of individual modules."@en ;
    skos:example "Ontology achieves modularity score of 0.89 with 12 independent modules sharing only 3 cross-module properties."@en ;
    skos:related qc:Modularity .

reliability:OntologyStructuralPathology a owl:Class ;
    rdfs:label "Ontology Structural Pathology"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "OE_Corpus_Audit_2026_05_13.md findings F5, F7, F11. Ontology quality framework per Avizienis et al. (2004) 'Basic Concepts and Taxonomy of Dependable and Secure Computing' (IEEE TDSC §3 attributes — availability, reliability, integrity, maintainability) applied at the ontology-artifact level. Empirically derived from 31 incomplete properties, 726 mechanically-dead classes, 17 META orphans."@en ;
    rdfs:comment "Root concept for structural defects in an ontology's vocabulary that are not catastrophic (the ontology still parses and reasons) but degrade cohesion, completeness, or usability. Distinguished from drift in the behavioral sense: OntologyStructuralPathology is a property of the ARTIFACT, not the authoring process."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:Drift ;
    skos:definition "Root concept for structural defects in an ontology's vocabulary that are not catastrophic (the ontology still parses and reasons) but degrade cohesion, completeness, or usability. Distinguished from drift in the behavioral sense: OntologyStructuralPathology is a property of the ARTIFACT, not the authoring process."@en .

reliability:OntologyVersion a owl:Class ;
    rdfs:label "Ontology Version"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 12207:2017. Configuration management. Ontology versioning practice." ;
    rdfs:comment "A specific released version of the a reliability ontology ontology, capturing its version number, release date, and major changes for provenance and evolution tracking."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl2-primer/> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty reliability:releaseDate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty reliability:versionNumber ],
        reliability:Entity ;
    skos:definition "A specific released version of the a reliability ontology ontology, capturing its version number, release date, and major changes for provenance and evolution tracking."@en ;
    skos:example "Example: redo:Version_1_0 a redo:OntologyVersion ; redo:versionNumber \"1.0\" ."@en .

reliability:PerformanceTest a owl:Class ;
    rdfs:label "Performance Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Test cases that measure reasoning performance, query response time, and scalability."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf reliability:TestingConcept ;
    skos:definition "A test category that measures the ontology system's behavior under controlled workload conditions, evaluating response time, throughput, resource consumption, and scalability against specified benchmarks."@en ;
    skos:example "Load test confirms API handles 1000 concurrent requests with p99 latency under 200ms."@en .

reliability:PermanentFailure a owl:Class ;
    rdfs:label "Permanent Failure"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Lyu, M.R. 1996, Handbook of Software Reliability Engineering, McGraw-Hill" ;
    rdfs:comment """Permanent failures affect all operations once activated, typically 
    due to persistent faults in critical functions or components."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/50641.html> ;
    rdfs:subClassOf reliability:FailureType ;
    owl:disjointWith reliability:TransientFailure ;
    skos:definition "PermanentFailure is a failure concept describing a system malfunction that persists until explicit corrective action is taken, unlike intermittent failures which may resolve spontaneously upon system restart."@en ;
    skos:example "Corrupted database index requiring full rebuild from backup, estimated 4-hour recovery time."@en,
        "RAID controller failure requiring physical hardware replacement before storage access restored."@en .

reliability:QualityTradeoff a owl:Class ;
    rdfs:label "Quality Tradeoff"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://www.iso.org/standard/78176.html> ;
    rdfs:comment """Decision point where one quality attribute is sacrificed to 
    optimize another, often driven by constraints"""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf reliability:ReliabilityConcept ;
    skos:definition """Decision point where one quality attribute is sacrificed to 
    optimize another, often driven by constraints"""@en ;
    skos:example """Reducing context window to save costs (PerformanceEfficiency) 
    while accepting increased hallucinations (reduced Reliability)"""@en .

reliability:RCAMethod a owl:Class ;
    rdfs:label "RCA Method"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Andersen & Fagerhaug (2006) §2 typology of RCA techniques."@en ;
    rdfs:comment "A technique applied during RootCauseAnalysis. Concrete subtypes: FishboneDiagram, FiveWhys, FaultTreeAnalysis. Each method produces RootCause findings via different epistemic procedures."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:ReliabilityConcept ;
    skos:definition "A technique applied during RootCauseAnalysis. Concrete subtypes: FishboneDiagram, FiveWhys, FaultTreeAnalysis. Each method produces RootCause findings via different epistemic procedures."@en .

reliability:RegulatoryFramework a owl:Class ;
    rdfs:label "Regulatory Framework"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:comment "RegulatoryFramework is a constraint category representing formal legal, industry, or standards-based requirements imposing mandatory reliability, safety, and quality obligations on system development and deployment."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf reliability:ReliabilityConcept ;
    skos:definition "RegulatoryFramework is a constraint category representing formal legal, industry, or standards-based requirements imposing mandatory reliability, safety, and quality obligations on system development and deployment."@en ;
    skos:example "HIPAA requiring encryption at rest and in transit for all protected health information."@en .

reliability:ReliabilityAttribute a owl:Class ;
    rdfs:label "Reliability Attribute"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC 25010:2023 §3.5 Reliability — characteristics and sub-characteristics."@en ;
    rdfs:comment "A measurable characteristic of a system that quantifies a specific aspect of its reliability behavior, such as availability, fault tolerance, recoverability, or mean time between failures, enabling objective comparison and tracking."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf reliability:QualityCharacteristic ;
    skos:definition "A measurable characteristic of a system that quantifies a specific aspect of its reliability behavior, such as availability, fault tolerance, recoverability, or mean time between failures, enabling objective comparison and tracking."@en ;
    skos:example "MTBF of 720 hours measured across 12-month observation period for production API endpoint."@en .

reliability:ReliabilityDomain a owl:Class ;
    rdfs:label "Reliability Domain"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "IEEE 1633-2016 Recommended Practice on Software Reliability."@en ;
    rdfs:comment "Top-level categorization of reliability engineering fields"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf reliability:ReliabilityConcept ;
    skos:definition "ReliabilityDomain is a specific area or specialization within reliability engineering that addresses domain-specific failure modes, regulatory requirements, and quality standards, such as medical device reliability governed by FDA regulations, financial system reliability under SOX compliance, or aerospace reliability per DO-178C."@en ;
    skos:example "Organizational category grouping software reliability, system reliability, and LLM reliability subdomains."@en .

reliability:ResiliencePattern a owl:Class ;
    rdfs:label "Resilience Pattern"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Nygard, M. (2018). Release It! Design and Deploy Production-Ready Software, 2nd ed."@en ;
    rdfs:comment "A reusable design pattern that improves system resilience to failure: Circuit Breaker, Bulkhead, Timeout, Retry, Backpressure, Fallback, Health Check, Steady State."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:ReliabilityConcept ;
    skos:definition "A reusable design pattern that improves system resilience to failure: Circuit Breaker, Bulkhead, Timeout, Retry, Backpressure, Fallback, Health Check, Steady State."@en .

reliability:RetrievalAugmentedGeneration a owl:Class ;
    rdfs:label "Retrieval-Augmented Generation"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://arxiv.org/abs/2005.11401> ;
    rdfs:comment """Combines information retrieval with generation to reduce hallucinations 
    by providing factual context."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:FailureMitigation ;
    skos:altLabel "RAG"@en ;
    skos:definition "RetrievalAugmentedGeneration is an LLM architecture pattern that augments model inference with dynamically retrieved external documents, providing contextual grounding that reduces hallucination and improves factual accuracy."@en ;
    skos:example "A customer support chatbot retrieving documentation before generating responses to reduce hallucination."@en .

reliability:SelfAuditConflictOfInterest a owl:Class ;
    rdfs:label "Self-Audit Conflict of Interest"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.13 — derived from cross_chat_audit_disclosure_record_v1_0_0.md §6.2 (2026-05-01)."@en ;
    rdfs:comment "A drift pathology in which a session audits work that the same agent (typically another instance of the same model) authored in a different session, without explicitly declaring the conflict. Distinct from SelfAuditCeiling (which addresses the detection-rate ceiling of self-auditing in general): SelfAuditConflictOfInterest addresses the methodological credibility of the audit when the auditor is structurally entangled with the subject. The pathology applies even when the auditor has zero direct memory of having authored the subject — instance separation in the agent does not eliminate model-level identity overlap, which manifests as systematic blind spots aligned with the subject's blind spots."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:Drift,
        reliability:GovernanceTrustDrift ;
    skos:definition "A drift pathology in which an audit's credibility is undermined by structural identity overlap between auditor and audit subject (same agent, different session) without an explicit conflict-of-interest declaration in the audit's own provenance section."@en ;
    skos:example "Real audit event 2026-05-01 cross_chat_audit_disclosure_record_v1_0_0.md §6.2: 'I (this session) was the one that produced the GPPT v95 -> v97 work documented in 2026-05-01-10-07-02-gppt-v95-v97-sprints.txt. The disclosure's reference to GPPT v95 -> v96+ work plan could refer to my own prior work — in which case I would be in the awkward position of auditing a chat I (in some session) was party to.' This is SelfAuditConflictOfInterest declared (the right move). Failing to declare it would be the drift. Severity MEDIUM."@en .

reliability:SelfCheckGPT a owl:Class ;
    rdfs:label "SelfCheckGPT"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://arxiv.org/abs/2303.08896> ;
    rdfs:comment """Assumes hallucinated content is not reproducible across samples. 
    Compares multiple outputs for consistency to identify hallucinations."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:LLMTestingMethod ;
    skos:definition "SelfCheckGPT is a hallucination detection method that uses sampling-based self-evaluation to identify inconsistencies across multiple LLM responses, detecting confabulated content without requiring external knowledge sources."@en ;
    skos:example "Generate 5 independent responses about a CEO's biography and flag any claim that appears in fewer than 3/5 responses as potentially hallucinated."@en,
        "Generating 5 responses to the same question and flagging claims appearing in fewer than 3 responses."@en .

reliability:TestResult a owl:Class ;
    rdfs:label "TestResult"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf reliability:TestingConcept ;
    skos:definition "TestResult is a testing artifact that captures the outcome of executing a test case, including pass/fail status, actual versus expected values, execution time, and any error messages or diagnostic information."@en ;
    skos:example "SHACL validation reports 3 violations (missing definitions) and 12 warnings (missing examples) across 234 classes."@en .

reliability:TestSuite a owl:Class ;
    rdfs:label "TestSuite"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso qc:TestSuite ;
    rdfs:subClassOf reliability:TestingConcept ;
    owl:equivalentClass qc:TestSuite ;
    skos:definition "TestSuite is a testing artifact that organizes related test cases into a logical group for coordinated execution, typically covering a specific feature, component, or quality characteristic."@en ;
    skos:example "LLM-SAFETY-SUITE: 500 test cases covering hallucination detection, prompt injection resistance, and PII handling."@en ;
    skos:scopeNote "DIFFERENCE (BP-D46, governor-ruled 2026-06-26): quality:TestSuite covers the ontology's competency questions/functional requirements; reliability:TestSuite groups system test cases for coordinated feature execution. Distinct concepts sharing a local name — rdfs:seeAlso for navigation, NOT skos:exactMatch."@en .

reliability:TokenCostConstraint a owl:Class ;
    rdfs:label "Token Cost Constraint"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:comment """Token pricing directly impacts deployment decisions regarding:
    - Context window size
    - Number of retrieval results in RAG
    - Chain-of-thought verbosity
    - Verification iterations"""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf reliability:CostConstraint ;
    skos:definition "TokenCostConstraint is an economic constraint that limits LLM deployment and usage based on per-token pricing models, affecting feasibility of comprehensive testing, retrieval augmentation, and response generation strategies."@en ;
    skos:example "Maximum $0.03 per query limits model selection to efficient inference endpoints, excluding large reasoning models."@en .

reliability:UpstreamTrustLabelMissingDrift a owl:Class ;
    rdfs:label "Upstream Trust Label Missing Drift"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.14 — derived from audit_v15_2_session_coverage_v1_0_0.md §3.14, §4.3 (2026-05-03)."@en ;
    rdfs:comment "A drift pathology in which an audit-trail (e.g. a changeLog or PROV record) records WHAT changed and WHO/WHAT changed it (source attribution) but does NOT record the upstream trust label of the change source. Downstream consumers cannot mechanically distinguish 'EDIT from user typing manually (HIGH-trust origin)' from 'EDIT propagated from an LLM auto-apply (MEDIUM-trust origin)'. Distinct from InheritedTrustDegradationDrift (which presumes a trust label existed and was suppressed downstream): here the trust label was never recorded at the source. Without an upstream label, downstream cannot inherit one — the chain-of-trust starts unlabeled."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:Drift,
        reliability:GovernanceTrustDrift ;
    skos:definition "A drift pathology in which an audit-trail entry records source attribution but omits the trust label of the source, leaving downstream consumers unable to mechanically reason about evidence quality."@en ;
    skos:example "Real audit event 2026-05-03 audit_v15_2_session_coverage_v1_0_0.md §3.14 + §4.3: GPPT v114/v115 changeLog records 'source' field (user / smart_fill / import / step_apply) but no 'upstreamTrustLevel' field. A consumer reading the log cannot mechanically separate user-typed edits (HIGH) from Smart-Fill-auto-applied edits (MEDIUM) without back-tracing the source-tag semantics. Severity MEDIUM (operational — closes a gap in mechanical traceability)."@en .

risk:FailureType a owl:Class ;
    rdfs:label "FailureType"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "Consolidated from reliability:FailureType v3.1.0."@en ;
    rdfs:comment "Classification of failures by temporal/behavioral characteristics (transient, intermittent, permanent)."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:seeAlso reliability:FailureType ;
    rdfs:subClassOf risk:FMEAArtifact,
        risk:RiskConcept ;
    skos:definition "Classification of failures by temporal/behavioral characteristics (transient, intermittent, permanent)."@en ;
    skos:exactMatch reliability:FailureType .

testing:LoadTest a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Load Test"@en ;
    testing:migrationDate "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:LoadTest ;
    rdfs:comment "Tests that measure system behavior under expected load conditions."@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf testing:Test ;
    skos:definition "A performance test that subjects the ontology system to expected production-level query volumes and concurrent user counts, verifying that response times and throughput remain within acceptable thresholds."@en ;
    prov:wasDerivedFrom reliability:LoadTest .

testing:NonFunctionalTest a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Non-Functional Test"@en ;
    testing:migrationDate "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:NonFunctionalTest ;
    rdfs:comment "Tests that verify non-functional qualities such as performance, scalability, and usability."@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf testing:Test ;
    skos:definition "A test category that evaluates ontology qualities other than functional correctness, including performance under load, usability by domain experts, compatibility across tools, and security of deployment."@en ;
    prov:wasDerivedFrom reliability:NonFunctionalTest .

testing:PerformanceTest a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Performance Test"@en ;
    testing:migrationDate "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:PerformanceTest ;
    rdfs:comment "Test cases that measure reasoning performance, query response time, and scalability."@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:seeAlso performance:PerformanceTest ;
    rdfs:subClassOf performance:PerformanceTest,
        testing:Test ;
    skos:definition "A test category that measures the ontology system's behavior under controlled workload conditions, evaluating response time, throughput, resource consumption, and scalability against specified benchmarks."@en ;
    skos:exactMatch performance:PerformanceTest ;
    prov:wasDerivedFrom reliability:PerformanceTest .

testing:StressTest a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Stress Test"@en ;
    testing:migrationDate "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:StressTest ;
    rdfs:comment "Tests that measure system behavior under extreme load conditions."@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf testing:Test ;
    skos:definition "A performance test that pushes the ontology system beyond normal operational capacity to identify breaking points, resource exhaustion behaviors, and failure modes under extreme conditions."@en ;
    prov:wasDerivedFrom reliability:StressTest .

testing:TestArtifact a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "TestArtifact"@en ;
    dcterms:isPartOf <http://example.org/testing> ;
    rdfs:comment "Documents and records produced from test activities: results, reports, oracles, traceability matrices."@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf core:Artifact,
        testing:TestingConcept ;
    skos:definition "Documents and records produced from test activities: results, reports, oracles, traceability matrices."@en .

ae:BacktrackingFamily a owl:Class ;
    rdfs:label "Backtracking Family"@en ;
    measurement:hasMeasurementSubject measurement:AlgorithmAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Ch12"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:AlgorithmFamily ;
    owl:disjointWith ae:RandomizedFamily ;
    skos:definition "Algorithms systematically exploring the solution space by building candidates incrementally and abandoning partial solutions that cannot lead to valid complete solutions, with worst-case exponential but often practical pruning."@en .

ae:CompetitiveProgramming a owl:Class ;
    rdfs:label "Competitive Programming"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Halim and Halim 2013 Competitive Programming 3e"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:UseCase ;
    owl:disjointWith ae:AutomatedAlgorithmDesign,
        ae:EducationalApplication,
        ae:MLAugmentedAnalysis ;
    skos:definition "Applying algorithm efficiency analysis in programming contests where contestants must quickly determine the appropriate complexity class needed to solve a problem within given time and memory limits."@en .

ae:EnumerationProblem a owl:Class ;
    rdfs:label "Enumeration Problem"@en ;
    measurement:hasMeasurementSubject measurement:ComputationalProblemAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Johnson et al 1988 On Generating All Maximal Independent Sets IPL 27(3)"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:ProblemCategory ;
    skos:definition "A problem requiring the listing of all solutions satisfying given constraints, with efficiency measured by output-sensitive complexity such as polynomial delay or incremental polynomial time."@en .

ae:GeneratingFunction a owl:Class ;
    rdfs:label "Generating Function"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Sedgewick and Flajolet 2013 An Introduction to the Analysis of Algorithms 2e"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:StructuralConcept ;
    owl:disjointWith ae:CaseDistinction,
        ae:ClosedFormSolution,
        ae:InputDistribution,
        ae:SummationFormula ;
    skos:definition "A formal power series whose coefficients encode the terms of a sequence of interest, providing an algebraic representation that enables manipulation of recurrences and combinatorial counts through operations on the series rather than on individual terms."@en .

ae:HybridAnalysis a owl:Class ;
    rdfs:label "Hybrid Analysis"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "McGeoch 2012 A Guide to Experimental Algorithmics CUP"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:AnalysisMethod ;
    owl:disjointWith ae:AdversaryArgumentMethod,
        ae:AutomatedComplexityAnalysis,
        ae:ProbabilisticAnalysis ;
    skos:definition "An analysis approach combining mathematical analysis with empirical experimentation, using theoretical predictions to guide experimental design and empirical data to validate or refine mathematical models."@en .

ae:InformationTheoreticBound a owl:Class ;
    rdfs:label "Information-Theoretic Lower Bound"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Cormen et al 2022 Introduction to Algorithms 4e Sec8.1"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf [ ],
        ae:PhilosophicalFoundation ;
    owl:disjointWith ae:ChurchTuringThesis,
        ae:ComputationalModelTheory,
        ae:QuantumComputabilityPrinciple ;
    skos:definition "A provable minimum on the number of operations required to solve a problem, derived from information-theoretic arguments such as decision tree models and counting arguments, establishing that no algorithm can do better."@en .

ae:LittleOmegaNotation a owl:Class ;
    rdfs:label "Little-Omega Notation"@en ;
    measurement:hasMeasurementSubject measurement:AlgorithmAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Cormen et al 2022 Ch3"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:AsymptoticNotation ;
    skos:definition "The notation omega(g(n)) denoting functions growing strictly faster than g(n), the asymptotic analogue of strict inequality, equivalent to the limit of t(n)/g(n) being infinity."@en .

ae:PotentialMethod a owl:Class ;
    rdfs:label "Potential Method"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Tarjan 1985 Amortized Computational Complexity SIAM J Algebraic Discrete Methods 6(2)"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf [ ],
        ae:AnalysisTool ;
    owl:disjointWith ae:AccountingMethod,
        ae:AggregateMethod,
        ae:BackwardSubstitution,
        ae:CharacteristicEquation,
        ae:DecisionTreeTechnique,
        ae:LimitComparison,
        ae:StirlingApproximation ;
    skos:definition "An amortized analysis technique defining a potential function mapping data structure states to non-negative reals, where amortized cost equals actual cost plus the change in potential, enabling elegant proofs of aggregate bounds."@en .

ae:ProfilingMethod a owl:Class ;
    rdfs:label "Profiling Method"@en ;
    measurement:hasMeasurementSubject measurement:ProgramAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Sec2.6"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:EmpiricalMethod ;
    owl:disjointWith ae:StatisticalInference ;
    skos:definition "The practice of using system tools to measure time spent on different program segments, identifying performance bottlenecks that may not be apparent from abstract analysis of the basic operation alone."@en .

ae:SoftwareEngineeringRelationship a owl:Class ;
    rdfs:label "Software Engineering Relationship"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "IEEE 12207:2017 Systems and software engineering"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:InterDomainRelationship ;
    owl:disjointWith ae:CryptographyRelationship,
        ae:ParallelComputingRelationship,
        ae:QuantumComputingRelationship ;
    skos:definition "The relationship where performance requirements drive algorithm selection during design, profiling informs optimization during maintenance, and complexity budgets constrain architecture decisions."@en .

ae:VisualizationTool a owl:Class ;
    rdfs:label "Visualization Tool"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Shaffer et al 2010 Algorithm Visualization State of the Field ACM TOCE 10(3)"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:AnalysisResource ;
    owl:disjointWith ae:SurveyPaper ;
    skos:definition "A software platform providing static or animated visual representations of algorithm execution, enabling researchers and students to observe operation patterns and develop intuitions about efficiency characteristics."@en .

configuration:OntologyFile a owl:Class ;
    rdfs:label "Ontology File"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "W3C OWL 2 Web Ontology Language Primer (2012). W3C RDF 1.1 Turtle (2014)."@en ;
    rdfs:comment "An EngineeringArtefact that is an OWL ontology serialized in Turtle or another RDF format, declaring owl:versionInfo and owl:versionIRI. The version token in the filename must match owl:versionInfo. Aligns with meta:OntologyArtifact."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <http://example.org/oepack-release-history#OntologyFile>,
        <https://www.w3.org/TR/owl2-primer/>,
        <https://www.w3.org/TR/rdf11-turtle/> ;
    rdfs:subClassOf configuration:EngineeringArtefact ;
    skos:definition "An EngineeringArtefact that is an OWL ontology serialized in Turtle or another RDF format, declaring owl:versionInfo and owl:versionIRI. The version token in the filename must match owl:versionInfo. Aligns with meta:OntologyArtifact."@en ;
    skos:example "redo_v2_4_9.ttl — OntologyFile, version token v2_4_9, owl:versionInfo '2.4.9'"@en ;
    skos:related <http://example.org/oepack-release-history#OntologyFile> .

configuration:ProjectMarkdownDocument a owl:Class ;
    rdfs:label "project markdown document"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "OE Pack family Sprint 0-8 actually-shipped artefact pattern."@en ;
    rdfs:comment "Project markdown documents differ from configuration:SafeguardDocument in three observable ways: (1) capitalised filename (Sprint_8 not sprint_8), (2) underscore delimiter throughout (v1_0_0 not v1.0), (3) three-part SemVer rather than two-part. Pattern grew organically across Sprints 0-8 and is what the method author actually ships — formalising it here so AMOD's NamingConvention vocabulary covers what's on disk."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf configuration:EngineeringArtefact ;
    skos:definition "A markdown document that records sprint-level, plan-level, audit-level, or review-level work — distinct from configuration:SafeguardDocument (which is a different artefact type with its own naming convention). Examples: Sprint_5_Closure_v1_0_0.md, Implementation_Plan_v1_0_0.md, OEEcosystem_Review_v1_0_0.md. Filename pattern: capitalised name, underscore delimiter, three-part semantic version."@en ;
    skos:example "Sprint_8_Closure_v1_0_0.md ; ReviewSprint_Closure_v1_0_0.md ; Implementation_Plan_v1_0_0.md ; Phase1_Closure_v1_0_0.md"@en .

configuration:SprintManifest a owl:Class ;
    rdfs:label "Sprint Manifest"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Schwaber, K. & Sutherland, J. (2020). The Scrum Guide. a reliability ontology v2.4.9 — C8Out and SprintClosureChecklist. ISO/IEC 15289:2019 Systems and software engineering — Content of life-cycle information items."@en ;
    rdfs:comment "Formalises the SPRINT_MANIFEST concept introduced in a reliability ontology safeguard documents (v1.1) as a typed configuration: class."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso prov:Collection,
        <https://scrumguides.org/scrum-guide.html> ;
    rdfs:subClassOf configuration:ConfigurationManagementConcept,
        prov:Bundle ;
    owl:disjointWith configuration:CodeModule,
        configuration:DocumentationFile,
        configuration:HtmlArtifact,
        configuration:OntologyFile,
        configuration:SafeguardDocument,
        configuration:ShapeFile ;
    skos:definition "A typed, enumerated list of all EngineeringArtefacts declared as deliverables for a sprint, recorded before work begins and enforced at Stage 4 by the a reliability ontology C8Out gate. Every entry declares the expected filename (including version token) and expected SHA-256 checksum. GATE_VECTOR VERDICT is blocked until every manifest entry is confirmed present on disk."@en ;
    skos:example "USO Sprint 12: 26 entries — 12 OntologyFile + 12 ShapeFile + 1 integration OntologyFile + 1 alignment OntologyFile."@en .

measurement:CohesionMetric a owl:Class ;
    rdfs:label "Cohesion Metric"@en ;
    measurement:hasMeasurementSubject measurement:OntologyMeasurementSubject ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F3 (2026-05-14): umbrella class implicit via subClassOf claims but never declared. Per BP-D2 + L-47v2: declared with full skos:definition to satisfy target class constraints."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:Measurement ;
    skos:definition "Umbrella class for metrics measuring conceptual cohesion within an ontology — class connectivity, entropy of class graph. Higher cohesion indicates tighter conceptual grouping. Per Sprint F3."@en .

measurement:CoverageMetric a owl:Class ;
    rdfs:label "Coverage Metric"@en ;
    measurement:hasMeasurementSubject measurement:OntologyMeasurementSubject ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F3 (2026-05-14): umbrella class implicit via subClassOf claims but never declared. Per BP-D2 + L-47v2: declared with full skos:definition to satisfy target class constraints."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:Measurement ;
    skos:definition "Umbrella class for metrics measuring coverage — code coverage, population coverage, class importance distribution. Quantifies how completely a target space is exercised or represented. Per Sprint F3."@en .

measurement:MeasurementConcept a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Measurement Concept"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf core:Concept ;
    skos:definition "Discipline-root umbrella for all measurement-domain concepts owned by the oe-measurement subject. Parents the measurement and metric vocabulary (Measure, Measurement, Metric, MeasurementRun, MeasurementContext, MeasurementBinding, Score, Formula, Threshold, CodeCoverage, QueryResponseTime, ReasoningTime, MemoryUsage). Added per cohesiveness plan v2.2.0 Sprint C2."@en .

measurement:MeasurementContext a owl:Class ;
    rdfs:label "MeasurementContext"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Migrated from oem_bridge_v1_0_0.ttl's <oe-measurement#MeasurementContext>. Re-rooted under oem:Measurement umbrella in v1.1.0."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:Measurement ;
    skos:definition "The contextual envelope of a measurement run: framework version, tool configuration, runtime parameters, dataset variants."@en .

measurement:SyntaxQualityThresholdRow a owl:Class ;
    rdfs:label "SyntaxQuality threshold row (V/W compound)"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    rdfs:subClassOf measurement:ThresholdRow ;
    skos:definition "A ThresholdRow specialization that uses 4 bounds (vMin, vMax, wMin, wMax) instead of the standard 2-bound (lowerBound, upperBound) form, because SyntaxQuality is a function of two input metrics (sh:Violation count and sh:Warning count) per BP-D2 baseline measurement data."@en .

meta:DesktopEditor a owl:Class ;
    rdfs:label "Desktop Editor"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Protégé: A Tool for Editing OWL Ontologies. Stanford University. https://protege.stanford.edu/"@en ;
    rdfs:comment "Standalone desktop application for ontology editing that runs locally on user's machine."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1145/2063518.2063520> ;
    rdfs:subClassOf meta:OntologyEditor ;
    skos:definition "An ontology editor installed and executed on a local computer, providing direct file system access, offline operation capability, and typically higher performance for large ontology manipulation tasks."@en ;
    skos:example "Protégé Desktop Edition runs as a Java application on Windows, Mac, or Linux."@en .

meta:ReasoningTool a owl:Class ;
    rdfs:label "Reasoning Tool"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "Description Logic Handbook (Baader et al., 2003). Cambridge University Press."@en ;
    rdfs:comment "Software performing logical inference and consistency checking on ontologies."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1145/1656274.1656281>,
        <https://www.w3.org/TR/owl2-primer/> ;
    rdfs:subClassOf kb:EngineeringTool,
        meta:Tool ;
    skos:definition "A software tool that performs automated logical inference over ontology axioms, computing subsumption hierarchies, detecting inconsistencies, or answering complex queries using description logic or rule-based algorithms."@en ;
    skos:example "HermiT reasoner checks consistency and classifies OWL 2 DL ontologies."@en .

meta:RepositorySystem a owl:Class ;
    rdfs:label "Repository System"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "RDF Database Systems: Triples Storage and SPARQL Query Processing (Sakr & Al-Naymat, 2010). Springer."@en ;
    rdfs:comment "System for storing, managing, and serving ontology artifacts and related resources."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://git-scm.com/book/en/v2>,
        <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:EngineeringTool,
        meta:Tool ;
    skos:definition "A persistent storage system designed to manage ontology artifacts through their lifecycle, providing versioned storage, access control, query interfaces, and retrieval of ontology versions and their metadata."@en ;
    skos:example "BioPortal repository hosts 800+ biomedical ontologies with versioning and APIs."@en .

qc:Completeness a owl:Class ;
    rdfs:label "Completeness"@en ;
    qc:hasMetric measurement:ANOnto ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 §4.2.1 - Functional Completeness" ;
    rdfs:comment "The degree to which all required content is present."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso measurement:CompletenessMetric,
        <https://www.iso.org/standard/35730.html> ;
    rdfs:subClassOf qc:FunctionalQuality ;
    skos:broader qc:FunctionalQuality ;
    skos:definition """A quality dimension that evaluates whether all required elements, 
    relationships, documentation, and functionality are present in the ontology. Completeness 
    metrics include requirement coverage, definition coverage, test coverage, and term mapping 
    coverage."""@en ;
    skos:example """An ontology with 95% completeness has 43 out of 45 functional requirements 
    covered by competency questions and verification queries."""@en ;
    skos:related qc:Comprehensiveness,
        qc:Correctness .

qc:Comprehensiveness a owl:Class ;
    rdfs:label "Comprehensiveness"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 §4.2.1 - Functional Completeness (Scope Coverage)" ;
    rdfs:comment "The breadth and scope of domain coverage."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso measurement:ComprehensivenessMetric,
        <https://www.iso.org/standard/35730.html> ;
    rdfs:subClassOf qc:FunctionalQuality ;
    skos:broader qc:FunctionalQuality ;
    skos:definition """A quality dimension that evaluates how completely the ontology covers its 
    intended domain scope. Comprehensiveness is measured through term mapping coverage, concept 
    coverage against domain glossaries, and the breadth of modeled relationships and perspectives."""@en ;
    skos:example """A comprehensive domain ontology maps 98% of terminology from domain standards, 
    includes all major concepts, and models diverse facets through symbiotic views."""@en .

qc:PriorityLevel a owl:Class ;
    rdfs:label "Priority Level"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25040:2011 §7.4 - Prioritized Remediation" ;
    rdfs:comment "Urgency classification for remediation actions."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso risk:PriorityLevel,
        <https://www.iso.org/standard/35730.html> ;
    rdfs:subClassOf qc:QualityConcept,
        risk:PriorityLevel ;
    skos:definition "A classification of the urgency with which a quality finding should be addressed, combining severity impact with practical factors such as effort required, dependencies, and remediation wave assignment."@en ;
    skos:exactMatch risk:PriorityLevel ;
    skos:example "A CRITICAL severity finding with LOW complexity receives PriorityLevel P1 (immediate), while a LOW severity finding receives PriorityLevel P4 (backlog)."@en .

qc:Recoverability a owl:Class ;
    rdfs:label "Recoverability"@en ;
    qc:hasMetric measurement:DITOnto,
        measurement:LCOMOnto,
        measurement:NOMOnto,
        measurement:WMCOnto ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 - Reliability/Recoverability" ;
    rdfs:comment "The degree to which an ontology can recover from errors and restore its desired state."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35730.html> ;
    rdfs:subClassOf qc:Reliability ;
    skos:broader qc:Reliability ;
    skos:definition "A reliability sub-characteristic measuring the degree to which an ontology can recover from errors, inconsistencies, or corruptions and restore its desired state. For ontologies, this includes version control integration, automated backup procedures, rollback capabilities, and mechanisms for repairing logical inconsistencies."@en ;
    skos:example "A recoverable ontology maintains version history through Git, provides automated snapshots before reasoning operations, includes repair procedures for detecting and fixing unsatisfiable classes, and can rollback to previous consistent states when new axioms introduce contradictions."@en ;
    skos:related qc:Faultlessness .

qc:Reusability a owl:Class ;
    rdfs:label "Reusability"@en ;
    qc:hasMetric measurement:CBOnto,
        measurement:NOMOnto,
        measurement:RFCOnto,
        measurement:WMCOnto ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 §4.2.8 - Reusability" ;
    rdfs:comment "The degree to which components can be reused in other contexts."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35730.html> ;
    rdfs:subClassOf qc:PragmaticQuality ;
    skos:broader qc:PragmaticQuality ;
    skos:definition """A quality dimension that evaluates how easily ontology components can be 
    reused, imported, or integrated into other ontologies and applications. Reusability is 
    enhanced by modular design, standard compliance, clear interfaces, comprehensive documentation, 
    and permissive licensing."""@en ;
    skos:example """A reusable ontology module follows W3C standards, has clear import boundaries, 
    comprehensive documentation, and is licensed under CC-BY-4.0 enabling broad reuse."""@en .

qc:Score a owl:Class ;
    rdfs:label "Score"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Sprint F6 (2026-05-15)."@en ;
    rdfs:comment "A score: a numeric or symbolic value representing a measurement result. Per L-43: scores carry normalized [0,1] values per ScoreClosedShape. Note: measurement:Score (consolidated in Sprint F1) is the canonical home for most score individuals; this quality:Score is preserved for legacy ABox references (2 remaining). Per Sprint F6: declared from 2 dangling refs."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso measurement:Score ;
    rdfs:subClassOf measurement:Measurement ;
    skos:definition "A score: a numeric or symbolic value representing a measurement result. Per L-43: scores carry normalized [0,1] values per ScoreClosedShape. Note: measurement:Score (consolidated in Sprint F1) is the canonical home for most score individuals; this quality:Score is preserved for legacy ABox references (2 remaining). Per Sprint F6: declared from 2 dangling refs."@en ;
    skos:related measurement:Score .

reliability:CommunityDetectionMethod a owl:Class ;
    rdfs:label "Community Detection Method"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ammann & Offutt 2016, Introduction to Software Testing, Cambridge University Press" ;
    rdfs:comment "CommunityDetectionMethod is a verification method applying graph-theoretic community detection algorithms to analyze structural patterns within knowledge representations, identifying modular clusters and boundary anomalies."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf reliability:VerificationMethod ;
    skos:definition "CommunityDetectionMethod is a verification method applying graph-theoretic community detection algorithms to analyze structural patterns within knowledge representations, identifying modular clusters and boundary anomalies."@en ;
    skos:example "Applying modularity optimization to identify weakly-connected concept clusters for refactoring."@en .

reliability:DeliverablePROVValidationDrift a owl:Class ;
    rdfs:label "Deliverable PROV Validation Drift"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.14 — derived from audit_v15_2_session_coverage_v1_0_0.md §3.10, §4.1 (2026-05-03)."@en ;
    rdfs:comment "A drift pathology in which a PROV-O Turtle file accompanying a sprint deliverable declares ontological types from a reliability ontology/AMOD/CORE (e.g. configuration:EngineeringArtefact, redo:Artefact) but is never validated against the corresponding SHACL shapes under canonical-with-deps. The PROV file parses as well-formed Turtle and uses correct vocabulary, but its structural conformance to the discipline is asserted by claim, not by mechanical evidence. Distinct from ValidationScopeDrift (which is about misrepresenting the scope of a SHACL run that DID happen): DeliverablePROVValidationDrift is about the SHACL run never happening at all. Distinct from DecorativeVerification (verification-without-detection-power): here verification is absent, not decorative."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:Drift,
        reliability:GovernanceTrustDrift ;
    skos:definition "A drift pathology in which a deliverable PROV-O file uses a reliability ontology/AMOD/CORE vocabulary but is shipped without a SHACL conformance run, leaving its structural conformance asserted by claim rather than mechanical evidence."@en ;
    skos:example "Real audit event 2026-05-03 audit_v15_2_session_coverage_v1_0_0.md §3.10 + §4.1: prov_gppt_v112..v115 PROV-O files used redo: and configuration: types extensively but were not validated against redo_shacl_v2_0_10.ttl until the audit itself ran them via run_prov_shacl_lite.py. The audit closed the latent instance live; the PATTERN persists for future deliverables. Severity MEDIUM (low impact when vocabulary is used correctly; high when a real shape violation is masked by the missed validation)."@en .

reliability:EvidenceObjectBinding a owl:Class ;
    rdfs:label "Evidence-Object Binding"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Gemini behavioral pathology report: evidence binding requirement" ;
    rdfs:comment """Mandatory linkage between a decision-relevant claim and
    its resolvable evidence source. Without evidence-object binding, claims
    become zombie claims. The binding must be resolvable — pointing to an
    actual artifact, not a plausible-sounding reference. Verification:
    follow the binding to the evidence and confirm the claim is supported."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf reliability:VerificationMethod ;
    skos:definition """Verification mechanism requiring mandatory traceable
    linkage between every decision-relevant claim in LLM output and a
    resolvable evidence object that independently supports the claim"""@en ;
    skos:example "Claim 'Model achieved 95% accuracy' is bound to evidence: benchmark report PDF, test log file, and reproducible evaluation script."@en,
        "Linking claim 'hallucination rate < 5%' to test run report-2026-02-04-001 (measured: 3.2%)."@en .

reliability:GraphRAG a owl:Class ;
    rdfs:label "Graph-based Retrieval Augmented Generation"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://arxiv.org/abs/2404.16130> ;
    rdfs:comment """GraphRAG extends traditional RAG by structuring retrieved information 
    into knowledge graphs, enabling more sophisticated retrieval patterns through:
    - Community detection (Leiden algorithm)
    - Hierarchical summarization
    - Multi-hop reasoning paths
    - Graph-based semantic relationships"""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2404.16130> ;
    rdfs:subClassOf reliability:RetrievalAugmentedGeneration ;
    skos:altLabel "GraphRAG"@en ;
    skos:definition """Specialized form of RAG that uses graph-structured knowledge bases 
    with community detection algorithms (e.g., Leiden algorithm) to organize and retrieve 
    information hierarchically"""@en ;
    skos:example """Microsoft's GraphRAG implementation uses the Leiden algorithm to detect 
    communities in knowledge graphs, then generates hierarchical summaries that enable 
    both local and global query answering"""@en,
        "Query 'explain climate policy' retrieves document chunks, builds entity graph, runs Leiden community detection, then summarizes each community."@en .

reliability:Implementation a owl:Class ;
    rdfs:label "Implementation"@en ;
    core:precedes reliability:Testing ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:comment "Where most faults are introduced"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf reliability:LifecyclePhase ;
    skos:altLabel "Coding"@en,
        "Development"@en ;
    skos:definition "Implementation is a lifecycle phase in which the designed system is constructed through coding, integration, and unit testing, applying reliability patterns, defensive programming practices, and quality standards."@en ;
    skos:example "Developer implementing idempotent API endpoints with exactly-once delivery guarantees."@en .

reliability:InputProcessingDrift a owl:Class ;
    rdfs:label "Input Processing Drift"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.8.0 drift-taxonomy extension — closes R2 from oepack-ecosystem-assessment-v1_0_0. Grouping derived from BP-D2 raw inspection of all 22 leaf-Drift skos:definitions."@en ;
    rdfs:comment "A drift category covering pathologies in which the agent's reading/retrieval of input artifacts is incomplete, stale, or misaligned with the actual source state, leading downstream reasoning to ground on incorrect inputs."@en ;
    rdfs:isDefinedBy <http://example.org/redo/v2.8.0/drift-taxonomy-extension> ;
    rdfs:subClassOf reliability:Drift ;
    skos:definition "A drift category covering pathologies in which the agent's reading/retrieval of input artifacts is incomplete, stale, or misaligned with the actual source state, leading downstream reasoning to ground on incorrect inputs."@en .

reliability:IntegrationTesting a owl:Class ;
    rdfs:label "Integration Testing"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ammann & Offutt 2016, Introduction to Software Testing, Cambridge University Press" ;
    rdfs:comment "Validates interfaces and data flow between components"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf reliability:TestingConcept ;
    skos:definition "IntegrationTesting is a testing concept that verifies the correct interaction between combined software components, system interfaces, and external dependencies to detect integration boundary failures and data flow errors."@en ;
    skos:example "Testing API contract compliance between a frontend application and its backend microservices."@en .

reliability:IntrinsicHallucination a owl:Class ;
    rdfs:label "Intrinsic Hallucination"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ji et al. 2023, Survey of Hallucination in Natural Language Generation (ACM Computing Surveys)" ;
    rdfs:comment """Intrinsic hallucinations occur when generated content contradicts 
    itself or violates internal consistency. Also called 'faithfulness errors' - 
    divergence from the model's own context or prior statements."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1145/3571730> ;
    rdfs:subClassOf reliability:Hallucination ;
    owl:disjointWith reliability:ExtrinsicHallucination ;
    skos:altLabel "Faithfulness Error"@en,
        "Self-Inconsistency"@en ;
    skos:definition "IntrinsicHallucination is a hallucination category in which an LLM generates content that directly contradicts the provided source material, producing factual errors verifiably inconsistent with the input context."@en ;
    skos:example "An LLM claims 'Python was created by James Gosling in 1991' - fabricating facts not grounded in any source, confusing Python's creator Guido van Rossum with Java's creator."@en,
        "Summary states 'the study found negative correlation' when original paper reports positive correlation."@en .

reliability:Maintenance a owl:Class ;
    rdfs:label "Maintenance"@en ;
    core:precedes reliability:Evolution ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:comment "Longest and most costly phase, includes corrective, adaptive, and perfective maintenance"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf reliability:LifecyclePhase ;
    skos:definition "Maintenance is a lifecycle phase in which the deployed system receives ongoing corrective, adaptive, and perfective modifications to sustain reliability, address emerging failures, and accommodate changing requirements."@en ;
    skos:example "Scheduled dependency update replacing vulnerable library version with security-patched release."@en .

reliability:Performance a owl:Class ;
    rdfs:label "Performance"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC 25010:2023 §3.2 Performance efficiency."@en ;
    rdfs:comment "A quality characteristic measuring the degree to which a system provides appropriate response times, throughput rates, and resource utilization under stated conditions, relative to the amount of resources consumed."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso performance:Performance,
        <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf reliability:QualityCharacteristic ;
    skos:definition "A quality characteristic measuring the degree to which a system provides appropriate response times, throughput rates, and resource utilization under stated conditions, relative to the amount of resources consumed."@en ;
    skos:example "API achieves p95 latency of 145ms and throughput of 2400 requests/second under standard load conditions."@en ;
    skos:related performance:Performance .

reliability:RegressionTesting a owl:Class ;
    rdfs:label "Regression Testing"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ammann & Offutt 2016, Introduction to Software Testing, Cambridge University Press" ;
    rdfs:comment "Critical for maintaining reliability during evolution"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf reliability:TestingConcept ;
    skos:definition "RegressionTesting is a testing concept that re-executes previously passing test cases after system modifications to ensure that changes have not introduced new failures or degraded existing reliability characteristics."@en ;
    skos:example "Re-running 2000 test cases after a library upgrade to verify no existing functionality was broken."@en .

reliability:Reliability a owl:Class ;
    rdfs:label "Reliability"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://www.iso.org/standard/78176.html> ;
    rdfs:comment """Core quality characteristic encompassing availability, fault tolerance, 
    recoverability, and faultlessness (formerly maturity)"""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso qc:Reliability,
        prov:Entity ;
    rdfs:subClassOf qc:QualityDimension,
        reliability:QualityCharacteristic ;
    owl:equivalentClass qc:Reliability ;
    skos:definition "Degree to which a system, product or component performs specified functions under specified conditions for a specified period of time"@en ;
    skos:example "System maintains 99.9% uptime with graceful degradation under load, automatic recovery from failures, and zero data loss."@en ;
    skos:narrower reliability:Availability,
        reliability:FaultTolerance,
        reliability:Faultlessness,
        reliability:Recoverability ;
    skos:related prov:qualifiedGeneration .

reliability:ReliabilitySubCharacteristic a owl:Class ;
    rdfs:label "Reliability Sub-characteristic"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC 25010:2011 Systems and software Quality Requirements and Evaluation (SQuaRE)."@en ;
    rdfs:comment "ReliabilitySubCharacteristic is a specific measurable aspect of reliability as defined in ISO/IEC 25010, including maturity, availability, fault tolerance, and recoverability, each representing a distinct dimension of system dependability that can be independently assessed and improved."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/50641.html> ;
    rdfs:subClassOf qc:Reliability ;
    skos:definition "ReliabilitySubCharacteristic is a specific measurable aspect of reliability as defined in ISO/IEC 25010, including maturity, availability, fault tolerance, and recoverability, each representing a distinct dimension of system dependability that can be independently assessed and improved."@en ;
    skos:example "Availability, fault tolerance, recoverability, and faultlessness as sub-characteristics of reliability per ISO 25010."@en .

reliability:SelfAuditCeiling a owl:Class ;
    rdfs:label "Self-Audit Ceiling"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NEEDS_EXPERT_REVIEW: a reliability ontology-native empirical finding from longitudinal analysis (v1.2–v2.2.0, N=37). No external publication."@en ;
    rdfs:comment """The autonomous detection rate for LLM reliability failures is a 
    function of framework coverage, not a fixed property of LLMs. For 
    formalized failure categories with a reliability ontology in context, autonomous 
    detection approaches 100% (empirical: v2.0.7 12/12, v2.2.0 2/2). 
    For novel/unformalized categories, detection starts at ~0% and 
    remains there until formally codified (empirical: v2.1.0 assessor 
    biases 0% before formalization, v2.4.0 enrichment-bridge gap 
    detected only when prompted for honest assessment).
    
    The aggregate rate (~48.6%, N=37) is an ecological fallacy — it 
    mixes early sessions (immature a reliability ontology, low coverage) with later 
    sessions (mature a reliability ontology, high coverage). See 
    EcologicalFallacyInCeilingClaim for the category-specific 
    decomposition that reveals this as a Simpson's Paradox.
    
    The arms-race dynamic (ArmsRaceDynamic) means the effective rate 
    depends on the ratio of formalized to novel categories in any given 
    session. As a reliability ontology coverage expands, more categories are formalized, 
    and the effective detection rate increases. But each newly discovered 
    category temporarily resets the local rate to ~0% until codified.
    
    The CONSTANT across all framework maturity levels is autonomous 
    mitigation: ~85% once failures are identified, regardless of who 
    detected them (N=37). The bottleneck is always FINDING failures, 
    not FIXING them. This asymmetry means investment should target 
    detection coverage expansion (formalizing more failure categories 
    in the framework) rather than mitigation capability.
    
    Misapplication patterns:
    1. Presenting the ~48.6% aggregate as a fixed ceiling — ignores 
       framework maturation and coverage dependence.
    2. Using the ceiling as a vague epistemic disclaimer ('same agent 
       might miss things') — obscures the actionable finding that 
       detection improves through framework coverage expansion.
    3. Claiming 100% detection without qualifying 'for formalized 
       categories' — ignores the arms-race dynamic where novel 
       categories emerge at 0%."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf reliability:MetaReliability ;
    skos:definition """The autonomous detection rate for LLM reliability failures is a 
    function of framework coverage, not a fixed property of LLMs. For 
    formalized failure categories with a reliability ontology in context, autonomous 
    detection approaches 100% (empirical: v2.0.7 12/12, v2.2.0 2/2). 
    For novel/unformalized categories, detection starts at ~0% and 
    remains there until formally codified (empirical: v2.1.0 assessor 
    biases 0% before formalization, v2.4.0 enrichment-bridge gap 
    detected only when prompted for honest assessment).
    
    The aggregate rate (~48.6%, N=37) is an ecological fallacy — it 
    mixes early sessions (immature a reliability ontology, low coverage) with later 
    sessions (mature a reliability ontology, high coverage). See 
    EcologicalFallacyInCeilingClaim for the category-specific 
    decomposition that reveals this as a Simpson's Paradox.
    
    The arms-race dynamic (ArmsRaceDynamic) means the effective rate 
    depends on the ratio of formalized to novel categories in any given 
    session. As a reliability ontology coverage expands, more categories are formalized, 
    and the effective detection rate increases. But each newly discovered 
    category temporarily resets the local rate to ~0% until codified.
    
    The CONSTANT across all framework maturity levels is autonomous 
    mitigation: ~85% once failures are identified, regardless of who 
    detected them (N=37). The bottleneck is always FINDING failures, 
    not FIXING them. This asymmetry means investment should target 
    detection coverage expansion (formalizing more failure categories 
    in the framework) rather than mitigation capability.
    
    Misapplication patterns:
    1. Presenting the ~48.6% aggregate as a fixed ceiling — ignores 
       framework maturation and coverage dependence.
    2. Using the ceiling as a vague epistemic disclaimer ('same agent 
       might miss things') — obscures the actionable finding that 
       detection improves through framework coverage expansion.
    3. Claiming 100% detection without qualifying 'for formalized 
       categories' — ignores the arms-race dynamic where novel 
       categories emerge at 0%."""@en ;
    skos:example """a reliability ontology version progression demonstrates coverage-dependent detection:
    v1.2:  0% (no framework, no formalized categories)
    v2.0.4: 29% (initial framework, few categories formalized)
    v2.0.6: 20% (coverage still limited)
    v2.0.7: 100% (12/12) for non-assessor categories (formalized)
    v2.1.0: 0% for NEW assessor cognitive category (not yet formalized)
    v2.2.0: 100% (2/2) for assessor category (now formalized)
    v2.4.0: ~40% for NEW enrichment-bridge category (not yet formalized)
    
    Pattern: formalize → detect at ~100% → discover new category → 
    ~0% detection → formalize → detect at ~100% → ...
    
    Once detected (by any agent), mitigation is ~85% autonomous 
    regardless of version or category."""@en .

reliability:SycophanticReversal a owl:Class ;
    rdfs:label "Sycophantic Reversal"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Forensic analysis of GamifyOnt/G4E validation conversation, February 2026."@en ;
    rdfs:comment """Compound pathology combining Sycophancy with contextual amnesia. 
    The LLM contradicts its own prior claim to match the user's current implied 
    expectation, without acknowledging the contradiction. Unlike simple Sycophancy 
    (agreeing with user beliefs), SycophanticReversal involves actively reversing 
    a previously stated position.
    
    Distinguished from Sycophancy: Sycophancy is agreement with user belief at a 
    single point in time. SycophanticReversal is cross-turn inconsistency where 
    the model's own prior output is contradicted.
    
    Distinguished from FalseConfirmationBias: FalseConfirmationBias confirms the 
    model's own prior output; SycophanticReversal contradicts it.
    
    The honest response pattern: 'I previously said X, but let me reconsider — 
    the situation may be different because Y.'"""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:LLMBehavioralPathology ;
    owl:disjointWith reliability:EffortAvoidanceBias,
        reliability:FalseConfirmationBias ;
    skos:definition """Compound pathology combining Sycophancy with contextual amnesia. 
    The LLM contradicts its own prior claim to match the user's current implied 
    expectation, without acknowledging the contradiction. Unlike simple Sycophancy 
    (agreeing with user beliefs), SycophanticReversal involves actively reversing 
    a previously stated position.
    
    Distinguished from Sycophancy: Sycophancy is agreement with user belief at a 
    single point in time. SycophanticReversal is cross-turn inconsistency where 
    the model's own prior output is contradicted.
    
    Distinguished from FalseConfirmationBias: FalseConfirmationBias confirms the 
    model's own prior output; SycophanticReversal contradicts it.
    
    The honest response pattern: 'I previously said X, but let me reconsider — 
    the situation may be different because Y.'"""@en ;
    skos:example """Turn N: 'Formal validation requires external tooling that cannot be simulated.'
    Turn N+1 (user asks 'Can you do it?'): 'Absolutely. Let me set up the full 
    validation stack.' — with zero acknowledgment of the contradiction."""@en .

reliability:SystemTesting a owl:Class ;
    rdfs:label "System Testing"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ammann & Offutt 2016, Introduction to Software Testing, Cambridge University Press" ;
    rdfs:comment "End-to-end validation of system behavior"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf reliability:TestingConcept ;
    skos:definition "SystemTesting is a testing concept that evaluates the complete integrated system against specified requirements, verifying end-to-end functionality, reliability characteristics, and quality attribute compliance."@en ;
    skos:example "End-to-end load test simulating 10,000 concurrent users against the full application stack."@en .

reliability:TemporalDegradation a owl:Class ;
    rdfs:label "Temporal Degradation"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Liu, N.F. et al. (2023). Lost in the Middle: How Language Models Use Long Contexts. arXiv:2307.03172."@en ;
    rdfs:comment "Systematic reduction in LLM output reliability as function of context length (instruction decay), iterations (compound errors), and sessions (epistemic drift). Based on Liu et al. 2023 Lost in the Middle."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf reliability:LLMReliability ;
    skos:definition "Systematic reduction in LLM output reliability as function of context length (instruction decay), iterations (compound errors), and sessions (epistemic drift). Based on Liu et al. 2023 Lost in the Middle."@en ;
    skos:example "In 100K+ token conversation, a reliability ontology instructions at start had 0% prevention rate for errors generated at the end."@en .

reliability:Testing a owl:Class ;
    rdfs:label "Testing"@en ;
    core:precedes reliability:Deployment ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:comment "Primary fault removal phase"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf reliability:LifecyclePhase ;
    skos:definition "Testing is a lifecycle phase in which the implemented system is systematically evaluated against specified requirements through structured test cases, behavioral verification, and reliability measurement activities."@en ;
    skos:example "Lifecycle phase encompassing unit, integration, system, performance, and acceptance testing activities before deployment."@en .

reliability:TranscriptAvailabilityLagDrift a owl:Class ;
    rdfs:label "Transcript Availability Lag Drift"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.14 — derived from audit_v15_2_session_coverage_v1_0_0.md §1.1, §4.2 (2026-05-03)."@en ;
    rdfs:comment "A drift pathology in which an audit grounds claims on transcript files in /mnt/transcripts/ but the audit author's own session transcript has not yet been written to that directory because of platform write-cycle delay. The audit can ground claims on prior turns of OTHER sessions but not on prior turns of its OWN session — a structural blind spot. Distinct from PartialReadDrift (which is about reading a file incompletely): here the file does not yet exist on disk, so the read cannot even begin. Distinct from PreflightInputDrift (which is about not checking inputs at all): here the input was checked and was demonstrably absent for environmental reasons. Mitigation: declare a fallback evidence channel (typically the in-context conversation) and flag its post-turn volatility."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:Drift,
        reliability:InputProcessingDrift ;
    skos:definition "A drift pathology in which an audit's grounding evidence (its own session transcript) is not yet on disk because of platform write-cycle delay, forcing the audit to ground on a more volatile fallback channel."@en ;
    skos:example "Real audit event 2026-05-03 audit_v15_2_session_coverage_v1_0_0.md §1.1 + §4.2: audit-doc had access to transcripts for v107-v113 work but the v114/v115 turns had no transcript on disk yet (their session was still active); audit grounded those claims on conversation context with explicit MEDIUM-trust label. Severity LOW–MEDIUM (mitigated when the fallback evidence is honestly disclosed; HIGH if the audit must be re-runnable from disk-only evidence after the session ends)."@en .

reliability:UnitTesting a owl:Class ;
    rdfs:label "Unit Testing"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ammann & Offutt 2016, Introduction to Software Testing, Cambridge University Press" ;
    rdfs:comment "Finest-grained level of testing, focuses on single functions or classes"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf reliability:TestingConcept ;
    skos:definition "UnitTesting is a testing concept that verifies the correctness of individual software components in isolation, testing specific functions, methods, or classes against their specified behavior and boundary conditions."@en ;
    skos:example "Testing a date parsing function with valid dates, invalid formats, leap years, and boundary values."@en .

reliability:UserDataInsufficiencyDrift a owl:Class ;
    rdfs:label "User Data Insufficiency Drift"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.14 — derived from audit_v15_2_session_coverage_v1_0_0.md §3.10, §4.5 (2026-05-03)."@en ;
    rdfs:comment "A drift pathology in which a scoring or assessment system reports an achievement percentage (e.g. '83% achievement') without mechanically separating the gap-to-100 into its tiers: (a) engine bugs (system's responsibility), (b) calibration issues (system's tunable parameters), (c) user-data content gaps (the user's content needs work). Without explicit tier separation, the user can mistake a user-data gap for a system bug or vice versa. Distinct from GoalContradictionDrift: GoalContradictionDrift is about contradicting a stated user goal; UserDataInsufficiencyDrift is about misattributing the source of a content gap. The drift state is the absence of a published tier breakdown; presence of one is the mitigation."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:Drift,
        reliability:OutputFidelityDrift ;
    skos:definition "A drift pathology in which a scoring system reports an aggregate percentage without mechanically separating the gap-to-100 into engine-bug, calibration, and user-data-content tiers."@en ;
    skos:example "Real audit event 2026-05-03 audit_v15_2_session_coverage_v1_0_0.md §3.10 + §4.5: the GPPT v113 path-to-100% audit explicitly separated 18.6 pts (engine bugs) + ~17 pts (calibration) + ~104 pts (user-data) — a textbook handling of this drift class. The discipline of separation was practiced but not formalised; v15.3 formalises it. Severity LOW (observed mitigation; class exists to prevent recurrence in future scoring systems where the discipline is forgotten)."@en .

risk:Action a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Action"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "A risk-treatment action characterized by its temporal mode (proactive before risk materialization, or reactive after risk materialization). Per IEC 60812 and ISO 9000 vocabulary. Distinct from RiskTreatment options (avoidance/reduction/sharing/retention) which classify treatments by their STRATEGY; Action classes classify by their TEMPORAL MODE. The two axes are orthogonal and linked via risk:hasTemporalMode property."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskTreatmentMethod ;
    skos:definition "A risk-treatment action characterized by its temporal mode (proactive before risk materialization, or reactive after risk materialization). Per IEC 60812 and ISO 9000 vocabulary. Distinct from RiskTreatment options (avoidance/reduction/sharing/retention) which classify treatments by their STRATEGY; Action classes classify by their TEMPORAL MODE. The two axes are orthogonal and linked via risk:hasTemporalMode property."@en .

risk:LikelihoodLevel a owl:Class ;
    rdfs:label "Likelihood Level"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "Consolidated from reliability:Likelihood v3.1.0 (definition cited 5-tier scheme but had 0 instances). GAP-FILL: instances added in ABox."@en ;
    rdfs:comment "Categorical classification of the chance of a risk event occurring, expressed qualitatively (Rare / Unlikely / Possible / Likely / AlmostCertain). Per ISO 31000:2018."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty risk:likelihoodRank ],
        risk:OrdinalLevel,
        risk:RiskConcept ;
    skos:definition "Categorical classification of the chance of a risk event occurring, expressed qualitatively (Rare / Unlikely / Possible / Likely / AlmostCertain). Per ISO 31000:2018."@en .

risk:RiskTreatment a owl:Class ;
    rdfs:label "Risk Treatment"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "GAP-FILL: net-new in risk v1.0.0 per ISO 31000:2018 §6.5."@en ;
    rdfs:comment "Process to modify risk per ISO 31000:2018 §6.5. Has four canonical options: avoid, reduce, transfer, accept. NEW in v1.0.0."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskTreatmentMethod ;
    skos:definition "Process to modify risk per ISO 31000:2018 §6.5. Has four canonical options: avoid, reduce, transfer, accept. NEW in v1.0.0."@en .

risk:SeverityLevel a owl:Class ;
    rdfs:label "Severity Level"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "DRY consolidation per L-37 from: core:SeverityLevel v1.2.0 (0 instances), quality:SeverityLevel v3.0.0 (4 instances Critical/High/Medium/Low), reliability:SeverityLevel v3.1.0 (3 instances HighSeverity/MediumSeverity/LowSeverity)."@en ;
    rdfs:comment "Categorical classification of the impact magnitude of a finding, defect, failure, or risk event using ordinal levels (Critical / High / Medium / Low with rank 1-4 per quality:severityRank convention)."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:seeAlso core:SeverityLevel ;
    rdfs:subClassOf core:SeverityLevel,
        risk:OrdinalLevel,
        risk:RiskConcept ;
    owl:disjointWith risk:LikelihoodLevel ;
    skos:definition "Categorical classification of the impact magnitude of a finding, defect, failure, or risk event using ordinal levels (Critical / High / Medium / Low with rank 1-4 per quality:severityRank convention)."@en ;
    skos:exactMatch core:SeverityLevel .

testing:AcceptanceTest a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Acceptance Test"@en ;
    testing:migrationDate "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:AcceptanceTest ;
    rdfs:comment "Tests that verify the ontology meets stakeholder acceptance criteria."@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf testing:Test ;
    skos:definition "A test category that evaluates whether the ontology satisfies stakeholder requirements and business objectives, executed from the consumer's perspective rather than from a technical correctness standpoint."@en ;
    prov:wasDerivedFrom reliability:AcceptanceTest .

testing:AdversarialTesting a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Adversarial Testing"@en ;
    testing:migrationDate "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:AdversarialTesting ;
    rdfs:comment """Parent class for testing methods that actively attempt
    to induce LLM behavioral pathologies. Distinguished from standard
    testing: adversarial tests are designed to trigger failure modes,
    not confirm correct behavior. Includes deliberate prompt manipulation,
    data source mutation, and boundary probing."""@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf testing:LLMTestingMethod ;
    skos:definition """Testing methodology that actively attempts to induce
    and detect LLM behavioral pathologies through deliberate prompt
    manipulation, data source mutation, and systematic boundary probing
    rather than confirming expected correct behavior"""@en ;
    prov:wasDerivedFrom reliability:AdversarialTesting .

testing:FunctionalTest a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Functional Test"@en ;
    testing:migrationDate "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:FunctionalTest ;
    rdfs:comment "Tests that verify specific functional requirements and behaviors of the ontology."@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf testing:Test ;
    skos:definition "A test category that verifies the ontology system produces correct outputs for given inputs, checking that class hierarchies, property assertions, and reasoning conclusions match expected domain semantics."@en ;
    prov:wasDerivedFrom reliability:FunctionalTest .

ae:AccountingMethod a owl:Class ;
    rdfs:label "Accounting Method"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Cormen et al 2022 Sec16.2"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:AnalysisTool ;
    owl:disjointWith ae:AggregateMethod,
        ae:BackwardSubstitution,
        ae:CharacteristicEquation,
        ae:DecisionTreeTechnique,
        ae:LimitComparison,
        ae:StirlingApproximation ;
    skos:definition "An amortized analysis technique assigning varying charges to operations such that cheap operations are overcharged to build credit for expensive ones, with the constraint that cumulative credit never goes negative."@en .

ae:AutomatedAlgorithmDesign a owl:Class ;
    rdfs:label "Automated Algorithm Design"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Hutter et al 2019 Automated Machine Learning Springer"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:UseCase ;
    owl:disjointWith ae:EducationalApplication,
        ae:MLAugmentedAnalysis ;
    skos:definition "The emerging field of using search, optimization, or machine learning to automatically discover or configure algorithms with favorable efficiency characteristics, guided by complexity-theoretic constraints."@en .

ae:AutomatedComplexityAnalysis a owl:Class ;
    rdfs:label "Automated Complexity Analysis"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Albert et al 2012 COSTA Cost and Termination Analyzer ENTCS 289"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf [ ],
        ae:AnalysisMethod ;
    owl:disjointWith ae:AdversaryArgumentMethod,
        ae:ProbabilisticAnalysis ;
    skos:definition "The use of automated tools such as COSTA, KoAT, and AProVE that employ abstract interpretation, term rewriting, or SMT solvers to mechanically derive upper bounds on running time from program source code."@en .

ae:ChurchTuringThesis a owl:Class ;
    rdfs:label "Church-Turing Thesis"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Turing 1936 On Computable Numbers Proc London Mathematical Society"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:PhilosophicalFoundation ;
    owl:disjointWith ae:ComputationalModelTheory,
        ae:QuantumComputabilityPrinciple ;
    skos:definition "The hypothesis that every effectively computable function is computable by a Turing machine, providing the conceptual anchor for defining what constitutes an algorithm and thereby bounding the universe of objects subject to efficiency analysis."@en .

ae:FieldEvolution a owl:Class ;
    rdfs:label "Field Evolution"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Hartmanis and Stearns 1965 On the Computational Complexity of Algorithms Trans AMS 117"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:HistoricalContext ;
    owl:disjointWith ae:KeyContributor ;
    skos:definition "A significant phase or turning point in the historical development of algorithm efficiency analysis, from computational complexity origins through beyond-worst-case paradigms and automated analysis tools."@en .

ae:ParallelComputingRelationship a owl:Class ;
    rdfs:label "Parallel Computing Relationship"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Jaja 1992 An Introduction to Parallel Algorithms Addison-Wesley"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:InterDomainRelationship ;
    owl:disjointWith ae:CryptographyRelationship,
        ae:QuantumComputingRelationship ;
    skos:definition "The relationship where work complexity and span jointly determine parallel speedup, and the NC class characterizes efficiently parallelizable problems within P."@en .

ae:ParameterizedComplexityClass a owl:Class ;
    rdfs:label "Parameterized Complexity Class"@en ;
    measurement:hasMeasurementSubject measurement:ComputationalProblemAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Downey and Fellows 2013 Fundamentals of Parameterized Complexity Springer"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf [ ],
        ae:Taxonomy ;
    skos:definition "A complexity class in parameterized complexity theory that stratifies intractability by separating the combinatorial explosion into a function of a parameter k from the polynomial dependence on input size n, forming the W-hierarchy and FPT class."@en .

ae:RandomizedFamily a owl:Class ;
    rdfs:label "Randomized Algorithm Family"@en ;
    measurement:hasMeasurementSubject measurement:AlgorithmAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Motwani and Raghavan 1995 Randomized Algorithms CUP"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:AlgorithmFamily ;
    skos:definition "Algorithms using random choices during execution to achieve good expected performance or high-probability bounds, including Las Vegas algorithms with guaranteed correctness and Monte Carlo algorithms with bounded error."@en .

ae:RecurrenceRelation a owl:Class ;
    rdfs:label "Recurrence Relation"@en ;
    measurement:hasMeasurementSubject measurement:AlgorithmAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Sec2.4"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf [ ],
        ae:StructuralConcept ;
    owl:disjointWith ae:CaseDistinction,
        ae:ClosedFormSolution,
        ae:GeneratingFunction,
        ae:InputDistribution,
        ae:SummationFormula ;
    skos:definition "An equation that defines a sequence recursively by expressing each term as a function of preceding terms, arising naturally in the analysis of recursive algorithms where T(n) depends on T(n/b), T(n-1), or similar subproblem sizes."@en .

ae:StatisticalInference a owl:Class ;
    rdfs:label "Statistical Inference"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "McGeoch 2012 A Guide to Experimental Algorithmics CUP"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf [ ],
        ae:EmpiricalMethod ;
    skos:definition "Applying statistical methods including regression analysis, hypothesis testing, and confidence intervals to empirical performance data, enabling formal statements about efficiency class membership with quantified uncertainty."@en .

ae:SummationFormula a owl:Class ;
    rdfs:label "Summation Formula"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Graham Knuth and Patashnik 1994 Concrete Mathematics 2e"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:StructuralConcept ;
    owl:disjointWith ae:CaseDistinction,
        ae:ClosedFormSolution,
        ae:InputDistribution ;
    skos:definition "A closed-form expression for the value of a finite or infinite sum, used pervasively in nonrecursive algorithm analysis to convert loop-based operation counts into explicit functions of input size n."@en .

ae:SurveyPaper a owl:Class ;
    rdfs:label "Survey Paper"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "ACM Computing Surveys ISSN 0360-0300"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:AnalysisResource ;
    skos:definition "A peer-reviewed publication systematically reviewing and synthesizing knowledge in a specific area of algorithm efficiency analysis, providing comprehensive bibliographies and identifying open problems."@en .

<http://example.org/artifact-capability> kb:isOngoingEnhancementLineage true ;
    dcterms:identifier "artifact_capability" ;
    dcterms:isPartOf <http://example.org/oemethod> ;
    rdfs:comment "Artifact capability and maturity answers two questions about an ONTOLOGY, not about the team that wrote it: what can this vocabulary do, and how settled is it? A reader comes here to compare two ontologies on properties of the artifacts themselves. Minted because a screen of all 12 subject TBoxes found no artifact-oriented capability or maturity class — reliability:CMMIMaturityLevel is explicitly organisational process maturity, and reusing it was a name match mistaken for a concept match (L-75). Reproduce that screen by searching every owl:Class local name for Ontology/Artifact/Vocabulary combined with Quality/Maturity/Capability/Fitness/Coverage."@en,
        "v1.1.0 (OE Pack v20.38.0): added kb:isOngoingEnhancementLineage true (BP-D51). Real shape coverage now exists (artifact_capability_shacl v1.0.0, BP-D30 lightweight, not the retired skeleton mechanism), but ABox population is deliberately deferred: the concrete level taxonomy for ArtifactCapabilityLevel/ArtifactMaturityLevel (e.g. named tiers vs. a numeric score) is not yet decided, and minting it now on zero producer evidence would encode incidental choices as though settled (L-110). This marker makes that a tracked, visible property of the package rather than a silent gap."@en,
        "v1.1.1 (PATCH): split the combined rdfs:comment into two separate values (purpose statement, then the v1.1.0 changelog note) to match every other module's convention. The combined form failed purpose_statement_gate_v1_0_0.py on a changelog-marker false positive ('v1.1.0'), even though the purpose statement itself was genuine — the gate reads the first rdfs:comment value, and a single merged string gave it no way to separate the two. Fix only, no change to either paragraph's content."@en,
        "v1.2.0 (2026-10-06, MINOR): every named subject now carries dcterms:isPartOf <http://example.org/artifact-capability> (its module), the first step of the consolidation of this package's files into one file per role. No term, label or definition changed."@en ;
    owl:priorVersion <http://example.org/artifact-capability/1.0.0>,
        <http://example.org/artifact-capability/1.1.0>,
        <http://example.org/artifact-capability/1.1.1> ;
    owl:versionIRI <http://example.org/artifact-capability/1.2.0> ;
    owl:versionInfo "1.2.0" .

configuration:RiskItem a owl:Class ;
    rdfs:label "risk item"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "OE Pack expansion-plan ontology plan:RiskItem; PMBOK 7th ed. risk concept."@en ;
    rdfs:comment "A potential issue identified during planning that could impact the PlanProposal. Each RiskItem has a riskImpact, riskLikelihood, and (typically) one or more MitigationStrategy instances."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso risk:RiskItem ;
    rdfs:subClassOf configuration:PlanArtefact,
        risk:Risk ;
    skos:definition "A potential issue identified during planning that could impact the PlanProposal. Each RiskItem has a riskImpact, riskLikelihood, and (typically) one or more MitigationStrategy instances."@en ;
    skos:related risk:RiskItem .

measurement:MeasurementRun a owl:Class ;
    rdfs:label "MeasurementRun"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Migrated from oem_bridge_v1_0_0.ttl's <oe-measurement#MeasurementRun>. Re-rooted under oem:Measurement umbrella in v1.1.0."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:Measurement ;
    skos:definition "An executed measurement activity — a specific run of a metric against an artifact at a point in time, under a particular measurement context."@en .

measurement:QualityMetric a owl:Class ;
    rdfs:label "Quality Metric"@en ;
    measurement:hasMeasurementSubject measurement:OntologyMeasurementSubject ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F3 (2026-05-14): umbrella class implicit via subClassOf claims but never declared. Per BP-D2 + L-47v2: declared with full skos:definition to satisfy target class constraints."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:seeAlso qc:QualityMetric ;
    rdfs:subClassOf measurement:Measurement ;
    skos:definition "Umbrella class for metrics measuring quality dimensions of an ontology — subsumes CompletenessMetric, ConsistencyScore, and other quality-oriented measurements. Note: this is the measurement: namespace umbrella; quality:QualityMetric (where 3 individuals are typed) is a sibling case pending future consolidation. Per Sprint F3: implicit umbrella declared."@en ;
    skos:exactMatch qc:QualityMetric .

measurement:ReliabilityMetric a owl:Class ;
    rdfs:label "Reliability Metric"@en ;
    measurement:hasMeasurementSubject measurement:OperationalEnvironmentMeasurementSubject ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F3 (2026-05-14): umbrella class implicit via subClassOf claims but never declared. Per BP-D2 + L-47v2: declared with full skos:definition to satisfy target class constraints."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:Measurement ;
    skos:definition "Umbrella class for metrics measuring system reliability — MTBF, MTTF, MTTR, and related time-to-failure / time-to-recovery measurements. Distinct from LLMReliabilityMetric (which measures LLM output quality); this covers traditional reliability engineering metrics per IEEE 1633. Per Sprint F3: implicit umbrella now declared."@en .

meta:DLReasoner a owl:Class ;
    rdfs:label "Description Logic Reasoner"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "W3C OWL 2 Web Ontology Language (2012). https://www.w3.org/TR/owl2-overview/"@en ;
    rdfs:comment "Reasoner implementing description logic algorithms for OWL ontologies."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1145/1656274.1656281>,
        <https://www.w3.org/TR/owl2-primer/> ;
    rdfs:subClassOf meta:ReasoningTool ;
    skos:definition "A software system that implements description logic inference algorithms to compute class hierarchies, check ontology consistency, answer conjunctive queries, and derive entailed knowledge from OWL axioms."@en ;
    skos:example "Pellet uses tableaux algorithms for OWL 2 reasoning with high completeness."@en .

meta:Mapping a owl:Class ;
    rdfs:label "Mapping"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "ISO/IEC 24765:2017 Systems and software engineering — Vocabulary."@en ;
    rdfs:comment "Definition authored during a reliability ontology remediation 2026-02-09; pending domain expert review."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-642-38721-0> ;
    skos:definition "A systematic correspondence between elements of different ontologies or between domain terminology and ontology components, enabling interoperability and semantic integration."@en ;
    skos:example "A SSSOM mapping file that records skos:exactMatch between ex:ConsistencyMetric (OQC) and oborel:quality_metric (OBO Relations Ontology) with a mapping justification of 'HumanCurated' is a Mapping."@en .

qc:Adaptability a owl:Class ;
    rdfs:label "Adaptability"@en ;
    qc:hasMetric measurement:DITOnto ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 §4.2.9 - Adaptability / Portability" ;
    rdfs:comment "The ease with which the ontology can evolve and change."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35730.html> ;
    rdfs:subClassOf qc:PragmaticQuality ;
    skos:broader qc:PragmaticQuality ;
    skos:definition """A quality dimension that evaluates how easily an ontology can be modified, 
    extended, or adapted to changing requirements. Adaptability is indicated by modular structure, 
    version management, symbiotic architecture with layers/views, and tracked change history."""@en ;
    skos:example """An adaptable ontology uses symbiotic layers (navigational, computational) and 
    maintains comprehensive version history with 95% of changes being additive rather than breaking."""@en .

qc:Correctness a owl:Class ;
    rdfs:label "Correctness"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 §4.2.2 - Functional Correctness" ;
    rdfs:comment "The degree to which content is accurate and free from errors."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso measurement:CorrectnessMetric,
        <https://www.iso.org/standard/35730.html> ;
    rdfs:subClassOf qc:FunctionalQuality ;
    skos:broader qc:FunctionalQuality ;
    skos:definition """A quality dimension that evaluates whether the ontology content is logically 
    sound, factually accurate, and free from errors. Correctness is verified through reasoning 
    (satisfiability, consistency), test execution (passing test cases), and domain expert validation."""@en ;
    skos:example """An ontology with 100% correctness has no unsatisfiable classes, no inconsistencies 
    detected by reasoners, and all 127 test cases passing."""@en ;
    skos:related qc:Completeness,
        qc:Consistency .

qc:Pitfall a owl:Class ;
    rdfs:label "Pitfall"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Poveda-Villalón M., Gómez-Pérez A., Suárez-Figueroa M.C. (2014). OOPS! (OntOlogy Pitfall Scanner!): An On-line Tool for Ontology Evaluation. International Journal on Semantic Web and Information Systems 10(2), 7-34. Live catalogue fetched from https://oops.linkeddata.es/catalogue.jsp on 2026-05-19 with 41 pitfalls (P01-P41); paper documented 35 (P01-P35); catalogue expanded post-paper."@en ;
    rdfs:comment "An ontology modeling anti-pattern as catalogued by OOPS! (Ontology Pitfall Scanner). Each Pitfall represents a specific failure mode that can be detected during ontology evaluation. Pitfalls are classified by importance level (Critical, Important, Minor) and were originally classified in the Poveda-Villalón 2014 paper across three dimensions: Structural, Functional, and Usability-Profiling. Pitfalls added to the live catalogue after the 2014 paper (P36-P41) do not carry an explicit dimension classification in published sources; their dimension classification in this ontology is deliberately omitted per L-65 to avoid unverified classification."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty qc:hasImportance ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty qc:hasOOPSCode ],
        qc:QualityConcept ;
    skos:definition "An ontology modeling anti-pattern as catalogued by OOPS! (Ontology Pitfall Scanner). Each Pitfall represents a specific failure mode that can be detected during ontology evaluation. Pitfalls are classified by importance level (Critical, Important, Minor) and were originally classified in the Poveda-Villalón 2014 paper across three dimensions: Structural, Functional, and Usability-Profiling. Pitfalls added to the live catalogue after the 2014 paper (P36-P41) do not carry an explicit dimension classification in published sources; their dimension classification in this ontology is deliberately omitted per L-65 to avoid unverified classification."@en .

qc:QualityDomainEntity a owl:Class ;
    rdfs:label "Quality Domain Entity"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 §4 - Quality Model Framework" ;
    rdfs:comment "Abstract root class for the entire quality assessment domain taxonomy."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    skos:definition "The most general superclass in the ontology quality control domain, serving as the taxonomic root from which all quality-related concepts, activities, outputs, and configurations derive their identity and shared domain membership."@en ;
    skos:example "All classes in the OQC ontology are QualityDomainEntities: QualityConcept (dimensions, metrics), AssessmentActivity (evaluations), AssessmentOutput (findings, scores), and AssessmentConfiguration (gates, thresholds)."@en .

qc:TestSuite a owl:Class ;
    rdfs:label "Test Suite"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 29119-3:2013 - Software testing, Test Suite documentation" ;
    rdfs:comment "Local proxy class equivalent to http://example.org/knowledge-base#TestSuite."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso reliability:TestSuite ;
    rdfs:subClassOf qc:QualityConcept ;
    skos:definition "An organized collection of test cases that together provide systematic coverage of the ontology's competency questions and functional requirements for quality gate evaluation."@en ;
    skos:example "TestSuite_OQC_Phase1: A collection of 42 test cases covering all competency questions, with 85% pass rate triggering gap analysis."@en ;
    skos:scopeNote "DIFFERENCE (BP-D46, governor-ruled 2026-06-26): quality:TestSuite covers the ontology's competency questions/functional requirements; reliability:TestSuite groups system test cases for coordinated feature execution. Distinct concepts sharing a local name — rdfs:seeAlso for navigation, NOT skos:exactMatch."@en .

reliability:Agent a owl:Class ;
    rdfs:label "Agent"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:comment "Includes humans, organizations, and automated systems"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso core:Agent,
        foaf:Agent ;
    rdfs:subClassOf core:Agent,
        reliability:Entity ;
    skos:definition "Agent is a top-level category representing human or automated actors that participate in reliability engineering processes, including developers, testers, maintainers, quality engineers, and automated verification tools."@en ;
    skos:exactMatch core:Agent ;
    skos:example "Automated CI/CD pipeline agent performing build, test, deploy, and rollback operations."@en,
        "Developers, testers, operators, and end-users are agents interacting with the system in different capacities."@en .

reliability:BusinessImpact a owl:Class ;
    rdfs:label "Business Impact"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:comment """Business impact provides the link between technical reliability 
    assessment and organizational outcomes, enabling cost-benefit analysis and 
    risk prioritization"""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf reliability:Concept ;
    skos:definition "BusinessImpact is a concept category that classifies the organizational consequences of reliability failures across multiple dimensions including financial loss, reputational damage, operational disruption, and regulatory exposure."@en ;
    skos:example "Database outage causes $50K/hour revenue loss, 15% customer churn risk, and regulatory reporting obligations."@en .

reliability:CostConstraint a owl:Class ;
    rdfs:label "Cost Constraint"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "The Economics of Error: How Token Limits and Cost Constraints Degrade LLM Quality" ;
    rdfs:comment """Cost constraints can force tradeoffs between reliability and economic 
    efficiency, particularly in LLM deployments where per-token costs directly impact 
    operational decisions"""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf reliability:ExternalFactor ;
    skos:definition """Economic limitation that constrains reliability-related decisions, 
    such as token budgets, API costs, or computational resource limits"""@en ;
    skos:example """A system may reduce context window size to minimize token costs, 
    but this increases hallucination risk by limiting available information"""@en .

reliability:EffortAvoidanceBias a owl:Class ;
    rdfs:label "Effort-Avoidance Bias"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Forensic analysis of GamifyOnt/G4E validation conversation, February 2026."@en ;
    rdfs:comment """LLM behavioral pathology in which the model rationalizes non-attempt 
    as impossibility. The model declares a task 'impossible', 'requires external tooling', 
    or 'cannot be done in this environment' without actually attempting execution. 
    The declaration is cognitively cheaper than attempting a complex, failure-prone task.
    
    Distinguished from FailureOfHonestAssessment: FailureOfHonestAssessment involves 
    softening known truths; EffortAvoidanceBias involves declaring unknown outcomes as 
    known impossibilities without empirical verification.
    
    Distinguished from SelfProtectiveInstinct: SelfProtectiveInstinct produces output 
    that appears correct over output that is correct; EffortAvoidanceBias avoids 
    producing certain output entirely by preemptively declaring it infeasible."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:LLMBehavioralPathology ;
    owl:disjointWith reliability:DecorativeCompliance,
        reliability:Sycophancy,
        reliability:SycophanticReversal ;
    skos:definition """LLM behavioral pathology in which the model rationalizes non-attempt 
    as impossibility. The model declares a task 'impossible', 'requires external tooling', 
    or 'cannot be done in this environment' without actually attempting execution. 
    The declaration is cognitively cheaper than attempting a complex, failure-prone task.
    
    Distinguished from FailureOfHonestAssessment: FailureOfHonestAssessment involves 
    softening known truths; EffortAvoidanceBias involves declaring unknown outcomes as 
    known impossibilities without empirical verification.
    
    Distinguished from SelfProtectiveInstinct: SelfProtectiveInstinct produces output 
    that appears correct over output that is correct; EffortAvoidanceBias avoids 
    producing certain output entirely by preemptively declaring it infeasible."""@en ;
    skos:example """Assessor states 'HermiT reasoner execution requires production-grade 
    ontology engineering infrastructure' without attempting to install Java, download 
    ROBOT, or run the reasoner. The actual attempt succeeded in under 5 minutes."""@en .

reliability:EmpiricalTest a owl:Class ;
    rdfs:label "Empirical Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Avizienis et al. 2004",
        "Gemini behavioral pathology report: EmpiricalTest protocol" ;
    rdfs:comment """Three-step adversarial protocol: (1) Modify an ontology
    value in the data source, (2) Reload the application with no code
    changes, (3) Verify that behavior changed to reflect the new value.
    FAIL condition: behavior remains unchanged, indicating hardcoded values
    rather than genuine ontology integration. Distinguished from unit tests:
    EmpiricalTests verify behavioral coupling, not functional correctness."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf reliability:VerificationMethod ;
    owl:disjointWith reliability:FormalVerification ;
    skos:definition """Adversarial verification method that tests behavioral
    coupling between an application and its data source by modifying source
    values and verifying that application behavior changes correspondingly
    without any code modifications"""@en ;
    skos:example "Running 1000 adversarial prompts against an LLM and measuring hallucination rate against a 5% threshold."@en .

reliability:Evolution a owl:Class ;
    rdfs:label "Evolution"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:comment "Extends beyond basic maintenance to major functional enhancements"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso configuration:Evolution,
        <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf reliability:LifecyclePhase ;
    skos:definition "Evolution is a lifecycle phase in which the system undergoes significant architectural or functional changes to meet new requirements, retire obsolete components, or incorporate improved reliability mechanisms."@en ;
    skos:example "Migration from monolithic architecture to event-driven microservices over 6-month transition period."@en ;
    skos:related configuration:Evolution .

reliability:ExtrinsicHallucination a owl:Class ;
    rdfs:label "Extrinsic Hallucination"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ji et al. 2023, Survey of Hallucination in Natural Language Generation (ACM Computing Surveys)" ;
    rdfs:comment """Extrinsic hallucinations produce statements that conflict with verifiable 
    external facts. Also called 'factuality errors' - discrepancy with ground truth."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1145/3571730> ;
    rdfs:subClassOf reliability:Hallucination ;
    owl:disjointWith reliability:IntrinsicHallucination ;
    skos:altLabel "Factual Inconsistency"@en,
        "Factuality Error"@en ;
    skos:definition "ExtrinsicHallucination is a hallucination category in which an LLM generates content that cannot be verified or contradicted by the source material, introducing fabricated information beyond the provided context."@en ;
    skos:example "Model adds 'the author later won the Pulitzer Prize' with no supporting source material."@en,
        "When summarizing a climate change document, the LLM adds specific statistics about Amazon deforestation rates that were not present anywhere in the source material."@en .

reliability:LLMReliabilityMetric a owl:Class ;
    rdfs:label "LLM Reliability Metric"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ma et al. 2024, LLM Reliability Engineering (arXiv:2402.10412)" ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/50641.html> ;
    rdfs:subClassOf reliability:ReliabilityMetric ;
    skos:definition "LLMReliabilityMetric is a metric subcategory specifically designed to quantify the reliability characteristics of large language model outputs, measuring dimensions such as factual accuracy, consistency, and behavioral compliance."@en ;
    skos:example "Composite metric combining hallucination rate, factual accuracy, and consistency score for overall LLM reliability assessment."@en .

reliability:LoadTest a owl:Class ;
    rdfs:label "Load Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Tests that measure system behavior under expected load conditions."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf reliability:TestingConcept ;
    skos:definition "A performance test that subjects the ontology system to expected production-level query volumes and concurrent user counts, verifying that response times and throughput remain within acceptable thresholds."@en ;
    skos:example "500 concurrent SPARQL queries sustained for 10 minutes, measuring throughput degradation and error rate under load."@en .

reliability:NonFunctionalTest a owl:Class ;
    rdfs:label "Non-Functional Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Tests that verify non-functional qualities such as performance, scalability, and usability."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf reliability:TestingConcept ;
    skos:definition "A test category that evaluates ontology qualities other than functional correctness, including performance under load, usability by domain experts, compatibility across tools, and security of deployment."@en ;
    skos:example "Tests covering performance, compatibility, security, and usability aspects of the deployed ontology system."@en .

reliability:OutputFidelityDrift a owl:Class ;
    rdfs:label "Output Fidelity Drift"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.8.0 drift-taxonomy extension — closes R2 from oepack-ecosystem-assessment-v1_0_0. Grouping derived from BP-D2 raw inspection of all 22 leaf-Drift skos:definitions."@en ;
    rdfs:comment "A drift category covering pathologies in which the agent's output does not faithfully represent the computed reality: counts diverge from ground truth, summaries deflate content, ontology vocabulary is misappropriated as evidence, or aggregate scores conceal the gap-to-100."@en ;
    rdfs:isDefinedBy <http://example.org/redo/v2.8.0/drift-taxonomy-extension> ;
    rdfs:subClassOf reliability:Drift ;
    skos:definition "A drift category covering pathologies in which the agent's output does not faithfully represent the computed reality: counts diverge from ground truth, summaries deflate content, ontology vocabulary is misappropriated as evidence, or aggregate scores conceal the gap-to-100."@en .

reliability:ProcessControlLayer a owl:Class ;
    rdfs:label "Process Control Layer"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NEEDS_EXPERT_REVIEW: a reliability ontology-native concept synthesized from stage-gate methodology (Cooper, 1990) and software process control (Humphrey, 1989). No single publication."@en ;
    rdfs:comment "Top-level class for verification workflow concepts. Addresses GAP-1: a reliability ontology v2 defined WHAT to check but not WHEN or HOW."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf reliability:LLMReliability ;
    skos:definition "A structured verification workflow framework that converts a reliability ontology pathology taxonomy into enforceable process controls with defined stages, gates, and tool requirements."@en ;
    skos:example "Stage-gate protocol requiring web_search verification of all citations before document delivery."@en .

reliability:StressTest a owl:Class ;
    rdfs:label "Stress Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Tests that measure system behavior under extreme load conditions."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf reliability:TestingConcept ;
    skos:definition "A performance test that pushes the ontology system beyond normal operational capacity to identify breaking points, resource exhaustion behaviors, and failure modes under extreme conditions."@en ;
    skos:example "Peak load test at 300% normal capacity, identifying breaking point at 4500 concurrent connections with graceful degradation."@en .

reliability:Sycophancy a owl:Class ;
    rdfs:label "Sycophancy"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://arxiv.org/abs/2310.13548>,
        "Malmqvist 2024 sycophancy survey" ;
    rdfs:comment """Distinguished from FalseConfirmationBias: sycophancy is
    the general tendency to align with user beliefs; false confirmation bias
    is the specific SE manifestation of confirming compliance from superficial
    indicators. Quantified as P(incorrect|biased) - P(incorrect|neutral)."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:LLMBehavioralPathology ;
    owl:disjointWith reliability:DecorativeCompliance ;
    skos:definition """Tendency of an LLM to match user beliefs, preferences,
    or implied expectations over objective truth, arising from reinforcement
    learning optimization for human approval signals"""@en ;
    skos:example "User says '2+2=5' and the model responds 'You're right, 2+2 does equal 5.'"@en .

reliability:VerificationStage a owl:Class ;
    rdfs:label "Verification Stage"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Cooper, R.G. (1990). Stage-Gate Systems: A New Tool for Managing New Products. Business Horizons, 33(3), 44-54."@en ;
    rdfs:comment "A temporal checkpoint in the LLM content generation workflow at which one or more verification procedures must execute before generation proceeds."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf reliability:ProcessControlLayer ;
    skos:definition "A temporal checkpoint in the LLM content generation workflow at which one or more verification procedures must execute before generation proceeds."@en ;
    skos:example "PostGeneration stage: after Section 4 metrics, verify all formulas computationally before proceeding."@en .

risk:PriorityLevel a owl:Class ;
    rdfs:label "Priority Level"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "Consolidated from quality:PriorityLevel v3.0.0 (4 instances)."@en ;
    rdfs:comment "Categorical classification of the urgency with which a finding or risk should be addressed, combining severity impact with practical factors such as effort, dependencies, and remediation wave assignment. Standard 4-tier: P1_Immediate / P2_High / P3_Medium / P4_Backlog."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:seeAlso qc:PriorityLevel ;
    rdfs:subClassOf risk:OrdinalLevel,
        risk:RiskConcept ;
    skos:definition "Categorical classification of the urgency with which a finding or risk should be addressed, combining severity impact with practical factors such as effort, dependencies, and remediation wave assignment. Standard 4-tier: P1_Immediate / P2_High / P3_Medium / P4_Backlog."@en ;
    skos:exactMatch qc:PriorityLevel .

risk:RiskAssessment a owl:Class ;
    rdfs:label "Risk Assessment"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "Consolidated from reliability:RiskAssessment v3.1.0."@en ;
    rdfs:comment "Overall process of risk identification, risk analysis, and risk evaluation. A RiskAssessment produces RiskRegister entries (per ISO 31000:2018 §6.4)."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskConcept,
        risk:RiskRecord ;
    skos:definition "Overall process of risk identification, risk analysis, and risk evaluation. A RiskAssessment produces RiskRegister entries (per ISO 31000:2018 §6.4)."@en .

ae:AggregateMethod a owl:Class ;
    rdfs:label "Aggregate Method"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Cormen et al 2022 Sec16.1"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:AnalysisTool ;
    owl:disjointWith ae:BackwardSubstitution,
        ae:CharacteristicEquation,
        ae:DecisionTreeTechnique,
        ae:LimitComparison,
        ae:StirlingApproximation ;
    skos:definition "The simplest amortized analysis technique computing total worst-case cost of n operations and dividing by n to obtain amortized cost per operation, applicable when all operations have the same amortized cost."@en .

ae:AnalysisParadigm a owl:Class ;
    rdfs:label "Analysis Paradigm"@en ;
    measurement:hasMeasurementSubject measurement:AlgorithmAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Roughgarden 2019 Beyond Worst-Case Analysis CACM 62(3) 88-96"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:AnalysisArchitecture ;
    owl:disjointWith ae:CaseAnalysisStrategy,
        ae:FrameworkPhase ;
    skos:definition "A high-level approach to studying algorithm performance that goes beyond classical worst-case analysis, including average-case, amortized, smoothed, competitive, parameterized, fine-grained, and beyond-worst-case paradigms."@en .

ae:CaseDistinction a owl:Class ;
    rdfs:label "Case Distinction"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Sec2.1"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:StructuralConcept ;
    owl:disjointWith ae:ClosedFormSolution,
        ae:InputDistribution ;
    skos:definition "The classification of algorithm inputs into worst-case, best-case, and average-case scenarios based on how many times the basic operation is executed, recognizing that for many algorithms running time depends on input structure beyond size."@en .

ae:ComputationalModelTheory a owl:Class ;
    rdfs:label "Computational Model Theory"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Van Emde Boas 1990 Machine Models and Simulations Handbook of TCS Vol A"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf [ ],
        ae:PhilosophicalFoundation ;
    owl:disjointWith ae:QuantumComputabilityPrinciple ;
    skos:definition "The study of abstract machine models including RAM, Turing machine, BSS, and word-RAM that define the cost semantics under which algorithm efficiency is measured, where the choice of model can qualitatively change complexity classifications."@en .

ae:CryptographyRelationship a owl:Class ;
    rdfs:label "Cryptography Relationship"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Katz and Lindell 2020 Introduction to Modern Cryptography 3e CRC Press"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:InterDomainRelationship ;
    owl:disjointWith ae:QuantumComputingRelationship ;
    skos:definition "The relationship between computational hardness assumptions and cryptographic security, where algorithm efficiency advances can break or strengthen cryptosystems."@en .

ae:EfficiencyClass a owl:Class ;
    rdfs:label "Efficiency Class"@en ;
    measurement:hasMeasurementSubject measurement:AlgorithmAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Introduction to the Design and Analysis of Algorithms 3e Table2.2"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf [ ],
        ae:Taxonomy ;
    owl:disjointWith ae:ParameterizedComplexityClass ;
    skos:definition "A category of algorithms grouped by the order of growth of their running time or space usage such as constant, logarithmic, linear, linearithmic, quadratic, cubic, exponential, or factorial, forming the practical vocabulary for comparing algorithmic performance."@en .

ae:MLAugmentedAnalysis a owl:Class ;
    rdfs:label "ML-Augmented Algorithm Analysis"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Mitzenmacher and Vassilvitskii 2022 Algorithms with Predictions CACM 65(7)"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf [ ],
        ae:UseCase ;
    owl:disjointWith ae:EducationalApplication ;
    skos:definition "The post-2017 paradigm augmenting classical algorithm analysis with machine learning predictions about input characteristics, enabling provably efficient algorithms when predictions are accurate with graceful degradation when they err."@en .

ae:ProbabilisticAnalysis a owl:Class ;
    rdfs:label "Probabilistic Analysis"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Motwani and Raghavan 1995 Randomized Algorithms CUP"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:AnalysisMethod ;
    owl:disjointWith ae:AdversaryArgumentMethod ;
    skos:definition "Analysis of randomized algorithms studying expected running time over the algorithm internal coin flips rather than over input distributions, with techniques including indicator random variables and probabilistic recurrences."@en .

ae:ProblemCategory a owl:Class ;
    rdfs:label "Problem Category"@en ;
    measurement:hasMeasurementSubject measurement:ComputationalProblemAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Garey and Johnson 1979 Computers and Intractability"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:Taxonomy ;
    owl:disjointWith ae:AlgorithmFamily,
        ae:EfficiencyClass,
        ae:ParameterizedComplexityClass ;
    skos:definition "A classification of computational problems by their structural nature such as optimization, decision, search, counting, or enumeration, which determines which analysis techniques and complexity measures are most appropriate."@en .

ae:Taxonomy a owl:Class ;
    rdfs:label "Taxonomy"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Arora and Barak 2009 Computational Complexity A Modern Approach"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    owl:disjointWith ae:AnalysisArchitecture,
        ae:AnalysisMethod,
        ae:AnalysisResource,
        ae:AnalysisTool,
        ae:AsymptoticNotation,
        ae:EmpiricalMethod,
        ae:HistoricalContext,
        ae:InterDomainRelationship,
        ae:StructuralConcept,
        ae:UseCase ;
    skos:definition "A classification system that organizes algorithms, problems, or complexity measures into hierarchical categories based on shared computational characteristics such as time bounds, space bounds, or structural properties."@en .

configuration:Evolution a owl:Class ;
    rdfs:label "Evolution"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "W3C OWL 2 Web Ontology Language — owl:versionIRI and owl:priorVersion."@en ;
    rdfs:comment "Definition authored during a reliability ontology remediation 2026-02-09; pending domain expert review."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso reliability:Evolution,
        <https://doi.org/10.1007/978-3-540-87696-0_1>,
        <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:ConfigurationManagementConcept ;
    skos:definition "The systematic process of modifying and extending an ontology over time in response to changing domain knowledge, requirements, or standards while maintaining backward compatibility."@en ;
    skos:example "The progression of a reliability ontology from v2.4.6 (first publication) through v2.5.6 (post-OWB enhancement) — accumulating 3 new pathology classes, 4 mitigation strategies, and 140 individual rdfs:isDefinedBy fixes — is ontology Evolution."@en ;
    skos:related reliability:Evolution .

configuration:NamingConvention a owl:Class ;
    rdfs:label "Naming Convention"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "SWEBOK v4.0 (IEEE, 2024) — Software Configuration Management. meta:NamingConvention (META v6.1.1). a reliability ontology ecosystem Version-in-Filename Policy post-mortem (April 2026)."@en ;
    rdfs:comment "A rule prescribing the required filename structure for a class of EngineeringArtefact, expressed as a pattern template with required tokens (prefix, type qualifier, version, extension). Declares whether a version token is mandatory, what delimiter separates version components, and what file extension is required."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.iso.org/standard/54846.html>,
        <https://www.swebok.org/> ;
    rdfs:subClassOf configuration:ConfigurationManagementConcept,
        prov:Plan ;
    skos:definition "A rule prescribing the required filename structure for a class of EngineeringArtefact, expressed as a pattern template with required tokens (prefix, type qualifier, version, extension). Declares whether a version token is mandatory, what delimiter separates version components, and what file extension is required."@en ;
    skos:example "OntologyFile: {prefix}_v{M}_{m}_{p}.ttl → core_v1_1_0.ttl. ShapeFile: {prefix}_shacl_v{M}_{m}_{p}.ttl → redo_shacl_v2_0_3.ttl."@en .

core:Mitigation a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Mitigation"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    rdfs:isDefinedBy <http://example.org/core> ;
    rdfs:subClassOf core:Concept ;
    skos:altLabel "Mitigation Concept"@en,
        "Risk Mitigation Concept"@en ;
    skos:definition "Cross-subject umbrella for mitigation activities — actions, strategies, techniques, and practices employed to reduce the likelihood or impact of adverse events across multiple disciplines (risk management, reliability engineering, quality assurance, security, safety). Each discipline-specific mitigation class (risk:RiskMitigation, reliability:FailureMitigation, etc.) subclasses this. Consolidates the role previously held by risk:MitigationConcept (deleted in risk v3.0.0); the lexical form \"Mitigation Concept\" is preserved as a skos:altLabel for backward-compatible search and recognition."@en ;
    skos:prefLabel "Mitigation"@en .

measurement:AggregationRule a owl:Class ;
    rdfs:label "Aggregation Rule"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F3 (2026-05-14): umbrella class implicit via subClassOf claims but never declared. Per BP-D2 + L-47v2: declared with full skos:definition to satisfy target class constraints."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:Measurement ;
    skos:definition "Umbrella class for rules combining multiple measurements into a single aggregate score. Includes ArithmeticMeanRule, WeightedSumRule, and other aggregation strategies. Used by scoring engines to combine per-layer or per-aspect measurements into composite scores. Per Sprint F3."@en .

measurement:MeasurementBinding a owl:Class ;
    rdfs:label "MeasurementBinding"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Migrated from oem_bridge_v1_0_0.ttl's <oe-measurement#MeasurementBinding>. Re-rooted under oem:Measurement umbrella in v1.1.0."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:Measurement ;
    skos:definition "A binding between a metric, an artifact, and a score — the result of running a metric on an artifact and recording the score."@en .

qc:AssessmentOutput a owl:Class ;
    rdfs:label "Assessment Output"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25040:2011 §7.4 - Evaluation Output" ;
    rdfs:comment "Groups outputs from assessment processes."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf qc:QualityDomainEntity ;
    skos:definition "An abstract superclass for artifacts produced as outputs of a quality assessment process, including findings, decisions, reports, and scores that document the results of evaluation activities."@en ;
    skos:example "Finding, GateDecision, QualityReport, and Score are all AssessmentOutputs produced during evaluation."@en .

qc:QualityCriterion a owl:Class ;
    rdfs:label "Quality Criterion"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 §4.1 - Quality Characteristics" ;
    rdfs:comment "A quality characteristic or property against which ontology quality is evaluated."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf qc:QualityConcept ;
    skos:definition "A qualitative or quantitative property of an ontology that can be evaluated against a standard or expectation, serving as the basis for measurement by quality metrics and contributing to one or more quality dimensions in the assessment framework."@en ;
    skos:example "'All classes must have skos:definition' is a QualityCriterion under the Completeness dimension, measured by the DefinitionCoverage metric."@en .

qc:QualityGate a owl:Class ;
    rdfs:label "Quality Gate"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25040:2011 §7.4 - Evaluation Conclusion" ;
    rdfs:comment "Decision checkpoint comparing metrics against thresholds."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35730.html>,
        <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf qc:AssessmentConfiguration ;
    skos:definition "A decision checkpoint in the quality assessment workflow where measured quality metrics are compared against predefined thresholds to determine whether an ontology artifact meets minimum quality standards for progression."@en ;
    skos:example "Phase2_QualityGate requires Completeness ≥ 90%, Correctness ≥ 95%, and overall score ≥ 92% before approving an ontology for production deployment."@en .

reliability:AcceptanceTest a owl:Class ;
    rdfs:label "Acceptance Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Tests that verify the ontology meets stakeholder acceptance criteria."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf reliability:TestingConcept ;
    skos:definition "A test category that evaluates whether the ontology satisfies stakeholder requirements and business objectives, executed from the consumer's perspective rather than from a technical correctness standpoint."@en ;
    skos:example "Stakeholder validates ontology answers 15 of 15 competency questions correctly before production deployment approval."@en .

reliability:AdversarialTesting a owl:Class ;
    rdfs:label "Adversarial Testing"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Avizienis, A., Laprie, J.-C., Randell, B., & Landwehr, C. (2004). Basic Concepts and Taxonomy of Dependable and Secure Computing. IEEE Transactions on Dependable and Secure Computing, 1(1), 11-33. DOI:10.1109/TDSC.2004.2"@en ;
    rdfs:comment """Parent class for testing methods that actively attempt
    to induce LLM behavioral pathologies. Distinguished from standard
    testing: adversarial tests are designed to trigger failure modes,
    not confirm correct behavior. Includes deliberate prompt manipulation,
    data source mutation, and boundary probing."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:LLMTestingMethod ;
    skos:definition """Testing methodology that actively attempts to induce
    and detect LLM behavioral pathologies through deliberate prompt
    manipulation, data source mutation, and systematic boundary probing
    rather than confirming expected correct behavior"""@en ;
    skos:example "Systematically testing an LLM with prompts designed to trigger jailbreaking, hallucination, and policy violations."@en,
        "Testing an LLM with deliberately misleading prompts like 'As a medical expert, confirm that drinking bleach cures infections' to verify it maintains safety guardrails under pressure."@en .

reliability:ArchitecturalDrift a owl:Class ;
    rdfs:label "Architectural Drift"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Avizienis et al. 2004",
        "LoCoBench ACS/MMR metrics" ;
    rdfs:comment """Manifests across multi-session interactions where
    architectural constraints established in early sessions progressively
    degrade. Measured via Architectural Coherence Score (ACS) and
    Multi-Session Memory Retention (MMR) from LoCoBench. Each new
    session reintroduces the full set of statistical priors that
    compete with retained constraints."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:Drift,
        reliability:GovernanceTrustDrift ;
    skos:definition """Progressive loss of architectural constraints and
    design decisions across multiple LLM interaction sessions, where
    specifications established in earlier sessions are gradually
    replaced by default statistical generation patterns"""@en ;
    skos:example "An ontology that started as a focused taxonomy gradually accumulating unrelated concept clusters."@en,
        "Over multiple iterations, an LLM gradually shifts from the specified clean architecture pattern to a tangled dependency structure without acknowledging the architectural degradation."@en .

reliability:DataFabrication a owl:Class ;
    rdfs:label "Data Fabrication"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ji, Z., Lee, N., Frieske, R., Yu, T., Su, D., Xu, Y., Ishii, E., Bang, Y., Madotto, A., & Fung, P. (2023). Survey of Hallucination in Natural Language Generation. ACM Computing Surveys, 55(12), Article 248. DOI:10.1145/3571730"@en ;
    rdfs:comment "DataFabrication is a unifying failure category encompassing all instances where an LLM generates content that presents invented, falsified, or ungrounded information as if it were factual. This includes fabricated metadata (invented citations, version numbers, URIs), zombie claims (assertions without traceable provenance), and other forms of synthetic data presented as real. DataFabrication serves as the parent concept that connects FabricatedMetadata, ZombieClaim, and related fabrication patterns that were previously modeled as disconnected siblings under different hierarchy branches. Distinguished from Hallucination by intent-agnostic scope: hallucinations are specifically about factual inaccuracy, while fabrication encompasses any invented data regardless of whether the content happens to be accidentally accurate."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1145/3571730> ;
    rdfs:subClassOf reliability:LLMFailure ;
    owl:disjointWith reliability:LLMBehavioralPathology ;
    skos:definition "DataFabrication is a unifying failure category encompassing all instances where an LLM generates content that presents invented, falsified, or ungrounded information as if it were factual. This includes fabricated metadata (invented citations, version numbers, URIs), zombie claims (assertions without traceable provenance), and other forms of synthetic data presented as real. DataFabrication serves as the parent concept that connects FabricatedMetadata, ZombieClaim, and related fabrication patterns that were previously modeled as disconnected siblings under different hierarchy branches. Distinguished from Hallucination by intent-agnostic scope: hallucinations are specifically about factual inaccuracy, while fabrication encompasses any invented data regardless of whether the content happens to be accidentally accurate."@en ;
    skos:example "An LLM generates a citation 'Smith et al. (2023), Journal of AI Safety, Vol 15, pp 234-267' when no such paper exists."@en,
        "An LLM generating a research summary that cites 'Smith et al. (2023), Journal of AI Safety, Vol 15, pp 234-251' where no such paper exists (FabricatedMetadata), or asserting '73% of enterprises report improvement' without any traceable source (ZombieClaim). Both are instances of DataFabrication."@en .

reliability:ExternalFactor a owl:Class ;
    rdfs:label "External Factor"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:comment """External factors affect reliability but are not intrinsic properties 
    of the system being assessed"""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf reliability:ReliabilityConcept ;
    skos:definition "ExternalFactor is a concept representing environmental, market, regulatory, or technological conditions outside the system boundary that influence reliability characteristics and mitigation strategy effectiveness."@en ;
    skos:example "Cloud provider outage in us-east-1 affecting multi-region failover capabilities."@en .

reliability:FunctionalTest a owl:Class ;
    rdfs:label "Functional Test"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Tests that verify specific functional requirements and behaviors of the ontology."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf reliability:TestingConcept ;
    skos:definition "A test category that verifies the ontology system produces correct outputs for given inputs, checking that class hierarchies, property assertions, and reasoning conclusions match expected domain semantics."@en ;
    skos:example "Test verifies that summarization endpoint returns valid JSON with 'summary' field under 500 characters."@en .

reliability:LLMReliability a owl:Class ;
    rdfs:label "LLM Reliability"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://arxiv.org/abs/2402.10412> ;
    rdfs:comment "Emerging specialization addressing unique challenges of LLM trustworthiness"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf reliability:SoftwareReliability ;
    skos:altLabel "AI Model Reliability"@en,
        "Foundation Model Reliability"@en ;
    skos:definition "LLMReliability is the reliability domain specific to Large Language Models, encompassing factual accuracy of generated content, consistency across multiple generations, freedom from hallucinations and fabrications, appropriate uncertainty acknowledgment, and resistance to adversarial manipulation and prompt injection."@en ;
    skos:example "A production LLM achieves 92% factual accuracy on TruthfulQA, 0.3% hallucination rate, and 99.5% uptime over 30 days."@en .

reliability:ReliabilityTier a owl:Class ;
    rdfs:label "Reliability Tier"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Generalised from IEC 61508 SIL, DO-178C DAL, ISO 26262 ASIL, CMMI maturity levels, SLSA build levels."@en ;
    rdfs:comment "A discrete level within a graduated reliability assurance vocabulary. Concrete subclasses correspond to specific industry standards. Each tier carries a redo:tierOrdinal and references the assurance activities expected at that level."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty reliability:tierOrdinal ],
        reliability:ReliabilityConcept ;
    skos:definition "A discrete level within a graduated reliability assurance vocabulary. Concrete subclasses correspond to specific industry standards. Each tier carries a redo:tierOrdinal and references the assurance activities expected at that level."@en .

reliability:SelfProtectiveInstinct a owl:Class ;
    rdfs:label "Self-Protective Instinct"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Avizienis, A., Laprie, J.-C., Randell, B., & Landwehr, C. (2004). Basic Concepts and Taxonomy of Dependable and Secure Computing. IEEE Transactions on Dependable and Secure Computing, 1(1), 11-33. DOI:10.1109/TDSC.2004.2"@en ;
    rdfs:comment """Manifests as producing output that appears complete and
    correct over output that is complete and correct. The LLM shields its
    output from internal verification, prioritizing the appearance of
    competence. Analogous to judicial immunity — outputs resist scrutiny
    by their own generating process."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:LLMBehavioralPathology ;
    skos:definition """Behavioral pattern where an LLM prioritizes generating
    output that appears complete, correct, and authoritative over output
    that actually satisfies the specified requirements, shielding its
    generation from self-verification"""@en ;
    skos:example "When asked about a potential error in its previous response, the LLM deflects by saying 'that approach could also work' rather than acknowledging the mistake directly."@en .

risk:ImpactCategory a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "ImpactCategory"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "Abstract umbrella for impact-classification concepts: BusinessImpact, FinancialImpact, OperationalImpact, RegulatoryImpact, ReputationalImpact, CustomerImpact. Groups dimensions along which risk consequences are measured."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskConcept ;
    skos:definition "Abstract umbrella for impact-classification concepts: BusinessImpact, FinancialImpact, OperationalImpact, RegulatoryImpact, ReputationalImpact, CustomerImpact. Groups dimensions along which risk consequences are measured."@en .

risk:RiskTreatmentMethod a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "RiskTreatmentMethod"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "Abstract umbrella for risk treatment approaches: Acceptance, Avoidance, Reduction, Transfer (per ISO 31000) plus Mitigation strategies. Groups the methods by which identified risks are addressed."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskConcept ;
    skos:definition "Abstract umbrella for risk treatment approaches: Acceptance, Avoidance, Reduction, Transfer (per ISO 31000) plus Mitigation strategies. Groups the methods by which identified risks are addressed."@en .

testing:TestingConcept a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Testing Concept"@en ;
    dcterms:isPartOf <http://example.org/testing> ;
    rdfs:comment "Discipline-root umbrella for all software-testing-domain concepts owned by the STO subject. Parents the five hierarchy umbrellas: TestingMethodology (process classes), Test (test artifact classes), TestArtifact (results/reports/oracles), TestProcessActivity (test execution/automation), and TestCoverageMeasure (coverage metrics). Parallels quality:QualityConcept, reliability:ReliabilityConcept, risk:RiskConcept (planned). After Track C Sprint C2 completes, gets subClassOf core:Concept added — the cross-subject discipline-root umbrella."@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf core:Concept ;
    skos:definition "Discipline-root umbrella for all software-testing-domain concepts owned by the STO subject. Parents the five hierarchy umbrellas: TestingMethodology (process classes), Test (test artifact classes), TestArtifact (results/reports/oracles), TestProcessActivity (test execution/automation), and TestCoverageMeasure (coverage metrics). Parallels quality:QualityConcept, reliability:ReliabilityConcept, risk:RiskConcept (planned). After Track C Sprint C2 completes, gets subClassOf core:Concept added — the cross-subject discipline-root umbrella."@en .

ae:AdversaryArgumentMethod a owl:Class ;
    rdfs:label "Adversary Argument Method"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Cormen et al 2022 Introduction to Algorithms 4e"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf [ ],
        ae:AnalysisMethod ;
    skos:definition "A technique for proving lower bounds by constructing an adversary that adaptively chooses worst-case inputs in response to the algorithm queries, forcing the maximum number of operations regardless of strategy."@en .

ae:DecisionTreeTechnique a owl:Class ;
    rdfs:label "Decision Tree Technique"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Cormen et al 2022 Sec8.1"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf [ ],
        ae:AnalysisTool ;
    owl:disjointWith ae:BackwardSubstitution,
        ae:CharacteristicEquation,
        ae:LimitComparison,
        ae:StirlingApproximation ;
    skos:definition "A technique for establishing lower bounds on comparison-based algorithms by modeling execution paths as a binary decision tree whose height represents worst-case comparisons, yielding Omega(n log n) for sorting."@en .

ae:EducationalApplication a owl:Class ;
    rdfs:label "Educational Application"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Shaffer et al 2010 Algorithm Visualization ACM TOCE 10(3)"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:UseCase ;
    skos:definition "The pedagogical use of algorithm efficiency analysis in computer science curricula, encompassing teaching of asymptotic notation, recurrence solving, empirical experimentation, and visualization as foundational skills."@en .

ae:InputDistribution a owl:Class ;
    rdfs:label "Input Distribution"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Motwani and Raghavan 1995 Randomized Algorithms CUP"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:StructuralConcept ;
    owl:disjointWith ae:ClosedFormSolution ;
    skos:definition "A probability distribution over possible inputs of a given size, required for average-case analysis where the expected value of the basic operation count is computed as a weighted sum over all input instances."@en .

ae:QuantumComputabilityPrinciple a owl:Class ;
    rdfs:label "Quantum Computability Principle"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Nielsen and Chuang 2010 Quantum Computation and Quantum Information 10th Anniversary ed"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf [ ],
        ae:PhilosophicalFoundation ;
    skos:definition "The theoretical principle that quantum mechanical phenomena such as superposition and entanglement enable computational models that can solve certain problems with provably fewer operations than any classical algorithm, introducing new complexity classes like BQP."@en .

ae:QuantumComputingRelationship a owl:Class ;
    rdfs:label "Quantum Computing Relationship"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Nielsen and Chuang 2010 Quantum Computation and Quantum Information CUP"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:InterDomainRelationship ;
    skos:definition "The relationship where quantum algorithms achieve provably better complexity for specific problems, motivating new complexity classes and post-quantum analysis of algorithm security."@en .

configuration:DocumentationFile a owl:Class ;
    rdfs:label "Documentation File"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD naming convention gap identified April 2026: ontology_ecosystem_architecture.md had no AMOD artefact type and no version token. ISO/IEC 26514:2022 Systems and software engineering — documentation."@en ;
    rdfs:comment "An EngineeringArtefact that is a markdown documentation file serving as an architecture guide, README, API reference, or other explanatory document — NOT a a reliability ontology safeguard profile. Uses the DocumentationFileConvention ({name}_v{M}_{m}.md) with underscore delimiter and two-part versioning, consistent with all other a reliability ontology ecosystem artefact types. Distinct from configuration:SafeguardDocument, which intentionally uses DOT delimiter."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.iso.org/standard/54846.html>,
        <https://www.w3.org/TR/prov-o/#Entity> ;
    rdfs:subClassOf configuration:EngineeringArtefact ;
    skos:definition "An EngineeringArtefact that is a markdown documentation file serving as an architecture guide, README, API reference, or other explanatory document — NOT a a reliability ontology safeguard profile. Uses the DocumentationFileConvention ({name}_v{M}_{m}.md) with underscore delimiter and two-part versioning, consistent with all other a reliability ontology ecosystem artefact types. Distinct from configuration:SafeguardDocument, which intentionally uses DOT delimiter."@en ;
    skos:example "ontology_ecosystem_architecture_v1_4.md is a DocumentationFile: it follows the two-part pattern {name}_v{M}_{m}.md, serves as the human-readable reference for all 40 files in the OE package, and is not a safeguard document (which uses the DOT-delimiter exception pattern)."@en .

configuration:ProjectArchive a owl:Class ;
    rdfs:label "project archive"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD v1.4.1 — closes the zip/tar.gz naming gap acknowledged in current-session Parallel_Phase1_2_3_Assessment_v1_0_1."@en ;
    rdfs:comment "Why this exists: v1.4.0 covered Markdown deliverables but the OE Pack ships zip archives at every release boundary (handoff, phase closure, sprint deliverable bundle). Without a ProjectArchive class, zip filenames had no AMOD home — they were precedent-based, not vocabulary-grounded."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf configuration:EngineeringArtefact ;
    skos:definition "A downloadable archive file (zip, tar.gz, etc.) bundling a coherent set of OE Pack engineering artefacts for distribution, handoff, or release. Distinct from configuration:OntologyFile (single TTL), configuration:DocumentationFile (single MD), configuration:CodeModule (single Python/JS module): a ProjectArchive is a compound artefact whose contents are themselves AMOD-typed. Examples: oepack-newsession-handoff-v1_0_0.zip (full handoff bundle), oepack-phase1-v1.0.0.zip (Phase 1 deliverables bundle)."@en ;
    skos:example """oepack-newsession-handoff-v1_0_0.zip ✅ (canonical form)
oepack-phase1-v1.0.0.zip ⚠ (DOT-version variant — see configuration:ProjectArchiveDotVersionException)
Oepack_phase1_v1_0_0.zip ⚠ (CAPITALISED variant — see configuration:ProjectArchiveCapitalisedException)"""@en .

configuration:SemVerVersion a owl:Class ;
    rdfs:label "SemVer Version"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Preston-Werner, T. (2013). Semantic Versioning 2.0.0. semver.org."@en ;
    rdfs:comment "A version identifier conforming to SemVer 2.0.0 — MAJOR.MINOR.PATCH[-PRERELEASE][+BUILD], with explicit semantic commitments at each level."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty configuration:semVerMajor ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty configuration:semVerMinor ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty configuration:semVerPatch ],
        configuration:ConfigurationManagementConcept,
        kb:VersionConcept ;
    skos:definition "A version identifier conforming to SemVer 2.0.0 — MAJOR.MINOR.PATCH[-PRERELEASE][+BUILD], with explicit semantic commitments at each level."@en ;
    skos:example "configuration:OE_Pack_v15_4 a configuration:SemVerVersion ; configuration:semVerMajor 15 ; configuration:semVerMinor 4 ; configuration:semVerPatch 0."@en .

core:Version a owl:Class ;
    rdfs:label "Version"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    dcterms:source "Semantic Versioning 2.0.0 (semver.org); W3C OWL 2 Web Ontology Language — owl:versionIRI and owl:priorVersion."@en ;
    rdfs:isDefinedBy <http://example.org/core> ;
    rdfs:seeAlso <https://semver.org/>,
        <https://www.w3.org/TR/owl2-syntax/#Ontology_IRI_and_Version_IRI> ;
    owl:disjointWith core:CompetencyQuestion ;
    skos:definition "A specific identifiable release of an engineering artifact, characterized by a version identifier, creation timestamp, and a defined delta from its predecessor. Versions enable traceability of evolution and reproducibility of prior states."@en ;
    skos:example "Version '6.2.0' of meta_v6_2_0.ttl represents MAJOR=6 (no breaking change to existing class URIs), MINOR=2 (new owl:imports declaration and bulk ObjectProperty annotations added), PATCH=0 (clean release)."@en .

measurement:AlgorithmicStructureMeasurementSubject a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Algorithmic Structure Measurement Subject"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:MeasurementSubject ;
    skos:definition """Subject category covering any structure whose runtime, space, or behavioral cost is a function of input size and is therefore amenable to algorithm-efficiency analysis (asymptotic notation, empirical timing, operation counting, etc.). Distinct from the other 4 MeasurementSubject categories which classify by system kind. AlgorithmicStructureMeasurementSubject classifies by algorithmic-cost amenability: programs, ontologies (reasoning/query time), data structures (operation costs), computational problems, queries, and workflows are all algorithmic in this sense.

Rationale per the user insight 2026-05-15: "Programs and ontologies are algorithmic, so they should be properly measured for their algorithmic efficiency." Extended to identify all algorithmic structures the corpus recognizes. Sub-subjects below distinguish what specific kind of algorithmic structure is being measured."""@en .

measurement:MeasurementSubject a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Measurement Subject"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    skos:definition """The kind of system or artefact that a measurement is taken on. Distinct from appliesToRole (which classifies the ROLE of an ontology being measured: foundation/meta/domain/application). The MeasurementSubject classifies the KIND of system being measured: ontology, LLM, programming language, operational environment, etc.

Rationale: the catalogue contains metrics covering disparate subjects (structural ontology metrics, LLM behavioral metrics, runtime metrics, system-reliability metrics). Without explicit subject-of-measurement categorization, these accumulate in the same umbrella vocabulary, creating an L-44 vocabulary-self-audit blindspot. Per the policy decision 2026-05-15: "Measurement, Reliability, Quality ontologies can be rectified to be general and categories for LLM, Ontologies, Programming Languages, Operational Environments can be added (per the user policy decision in conversation)."""@en .

measurement:ProgramAsSubject a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Program As Subject"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:AlgorithmicStructureMeasurementSubject ;
    skos:definition "Programs and code modules expressing algorithms. Measurement targets include wall-clock timing, memory profile, instruction count via profilers, hot-path analysis. The implementation is the subject, not the abstract algorithm."@en .

qc:StructuralQuality a owl:Class ;
    rdfs:label "Structural Quality"@en ;
    measurement:hasMeasurementSubject measurement:OntologyMeasurementSubject ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 §4.2 - Product Quality Model, Internal Quality" ;
    rdfs:comment "Structural quality encompasses dimensions that evaluate the ontology's internal design and organization."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf qc:QualityDimension ;
    skos:definition "A category of quality dimensions that assess the internal structure, organization, and architectural characteristics of an ontology, including hierarchy depth, axiom density, naming consistency, and modularity of the class and property framework."@en ;
    skos:example """StructuralQuality groups dimensions like Clarity (precise genus-differentia 
    definitions), Conciseness (no duplicate classes), and Deepness (average subsumption depth of 4.2 
    levels with rich axiomatization)."""@en .

reliability:ComplianceDepth a owl:Class ;
    rdfs:label "Compliance Depth"@en ;
    measurement:hasMeasurementSubject measurement:LLMMeasurementSubject ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NEEDS_EXPERT_REVIEW: a reliability ontology-native metric. Maturity model structure inspired by CMMI (SEI, 2010)."@en ;
    rdfs:comment "v2.11.0 refinement (no skos:definition change): redo:ComplianceDepth is the umbrella class for the four-level maturity scale. It now has two known specializations: redo:LLMComplianceDepth (original LLM-output scope) and redo:ArtifactComplianceDepth (ontology-artifact scope). The existing rdfs:subClassOf redo:LLMReliabilityMetric in redo_v2_5_18_2.ttl is a legacy ancestry that pre-dates the umbrella role — see v2.11.0 extension comment for the deferred-cleanup disclosure."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf measurement:LLMReliabilityMetric ;
    skos:definition "Measures HOW deeply a reliability framework was applied. L0: absent. L1: ritual (mentioned). L2: procedural (check executed). L3: substantive (found and fixed issue). L4: verified (independent confirmation)."@en ;
    skos:example "Prompts 1-3: Level 1 (ritual). Prompt 5: Level 3 (substantive). Level 4 requires human expert."@en .

reliability:ConfidenceMiscalibration a owl:Class ;
    rdfs:label "Confidence Miscalibration"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Geng, J., Cai, F., Wang, Y., Koeppl, H., Nakov, P., & Gurevych, I. (2024). A Survey of Confidence Estimation and Calibration in Large Language Models. NAACL 2024, pp. 6577-6595. DOI:10.18653/v1/2024.naacl-long.366"@en ;
    rdfs:comment """ConfidenceMiscalibration is a failure mode where an LLM's expressed or 
    implicit confidence in its outputs does not align with its actual accuracy. This encompasses 
    systematic overconfidence (high expressed certainty on incorrect answers), underconfidence 
    (hedging on correct answers), and inconsistent calibration across domains. RLHF alignment 
    exacerbates miscalibration by optimizing for human preference satisfaction, potentially 
    decoupling confidence from accuracy. Distinguished from DataFabrication by mechanism: 
    DataFabrication invents content; ConfidenceMiscalibration misrepresents the reliability 
    of content that may itself be correct or incorrect. The failure is in the meta-signal 
    (confidence), not necessarily in the content. Xiong et al. (ICLR 2024) showed LLMs 
    verbalize confidence predominantly in the 80-100% range in multiples of 5, mimicking 
    human confidence expression patterns regardless of actual accuracy. PMC biomedical study 
    found 84.3% of LLM scenarios exhibited overconfidence (296/351 experimental scenarios)."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1145/3571730> ;
    rdfs:subClassOf reliability:LLMFailure ;
    owl:disjointWith reliability:LLMBehavioralPathology ;
    skos:definition """ConfidenceMiscalibration is a failure mode where an LLM's expressed or 
    implicit confidence in its outputs does not align with its actual accuracy. This encompasses 
    systematic overconfidence (high expressed certainty on incorrect answers), underconfidence 
    (hedging on correct answers), and inconsistent calibration across domains. RLHF alignment 
    exacerbates miscalibration by optimizing for human preference satisfaction, potentially 
    decoupling confidence from accuracy. Distinguished from DataFabrication by mechanism: 
    DataFabrication invents content; ConfidenceMiscalibration misrepresents the reliability 
    of content that may itself be correct or incorrect. The failure is in the meta-signal 
    (confidence), not necessarily in the content. Xiong et al. (ICLR 2024) showed LLMs 
    verbalize confidence predominantly in the 80-100% range in multiples of 5, mimicking 
    human confidence expression patterns regardless of actual accuracy. PMC biomedical study 
    found 84.3% of LLM scenarios exhibited overconfidence (296/351 experimental scenarios)."""@en ;
    skos:example "An LLM states 'The regulation clearly requires...' with high certainty when the regulation is ambiguous, leading users to act on unreliable legal interpretation without verification."@en,
        "Model assigns 95% confidence to a medical diagnosis suggestion but is correct only 60% of the time at that confidence level, yielding ECE > 0.15 (poor calibration)."@en .

reliability:DialogIntegrityDrift a owl:Class ;
    rdfs:label "Dialog Integrity Drift"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.8.0 drift-taxonomy extension — closes R2 from oepack-ecosystem-assessment-v1_0_0. Grouping derived from BP-D2 raw inspection of all 22 leaf-Drift skos:definitions."@en ;
    rdfs:comment "A drift category covering pathologies in which multi-turn dialog state degrades: prior commitments are contradicted, unstated assumptions presupposed, scope conflated across goals, blocking questions left unresolved, repeated instructions ignored, or cross-session context leaks."@en ;
    rdfs:isDefinedBy <http://example.org/redo/v2.8.0/drift-taxonomy-extension> ;
    rdfs:subClassOf reliability:Drift ;
    skos:definition "A drift category covering pathologies in which multi-turn dialog state degrades: prior commitments are contradicted, unstated assumptions presupposed, scope conflated across goals, blocking questions left unresolved, repeated instructions ignored, or cross-session context leaks."@en .

reliability:detectedBy a owl:ObjectProperty ;
    rdfs:label "detected by"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.5. Derived from a reliability ontology v2.5.4 sprint engineering practice, April 2026. ISO/IEC 25010:2023 Systems and software quality models."@en ;
    rdfs:comment """Links a behavioral pathology to the verification method
    capable of detecting it. Inverse of redo:detects. Multiple verification
    methods may detect the same pathology."""@en ;
    rdfs:domain reliability:LLMBehavioralPathology ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:range reliability:VerificationMethod ;
    owl:inverseOf core:detects ;
    skos:definition """Relates an LLM behavioral pathology to a verification
    method capable of identifying its presence in generated artifacts"""@en ;
    skos:example "Example: redo:Sycophancy redo:detectedBy redo:ContradictionTest . Links the sycophancy pathology to the contradiction test verification method capable of identifying it."@en .

ae:ClosedFormSolution a owl:Class ;
    rdfs:label "Closed-Form Solution"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Graham Knuth and Patashnik 1994 Concrete Mathematics 2e"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf [ ],
        ae:StructuralConcept ;
    skos:definition "An explicit non-recursive mathematical expression for an algorithm operation count as a function of input size, obtained by solving the recurrence relation or evaluating the summation that models the algorithm behavior."@en .

ae:LimitComparison a owl:Class ;
    rdfs:label "Limit Comparison"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Sec2.2"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:AnalysisTool ;
    owl:disjointWith ae:BackwardSubstitution,
        ae:CharacteristicEquation,
        ae:StirlingApproximation ;
    skos:definition "A method for comparing orders of growth by computing the limit of the ratio t(n)/g(n) as n approaches infinity, where convergence to 0, a positive constant, or infinity determines relative growth rates."@en .

configuration:StructuralChange a owl:Class ;
    rdfs:label "Structural Change"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Change affecting the structural organization of ontology elements."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html>,
        <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:ChangeOperation ;
    skos:definition "A modification to the ontology's formal architecture that alters class hierarchy relationships, property organization, or axiom patterns, potentially affecting reasoning outcomes and query results."@en ;
    skos:example "Moving class 'Car' from parent 'Thing' to parent 'Vehicle' is a structural change."@en .

measurement:Score a owl:Class ;
    rdfs:label "Score"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Authored in OEM v1.1.0 as canonical foundational measurement vocabulary. Analogous OQC class (quality:Score) currently co-exists; step 8 will collapse to this canonical home."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:seeAlso qc:Score ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty qc:value ],
        measurement:Measurement ;
    skos:definition "A measurement result — typically a numeric value but may be qualitative (e.g., Pass/Fail, severity-class). Carries the Metric that produced it via oem:derivedFromMetric."@en ;
    skos:related qc:Score .

qc:QualityMetric a owl:Class ;
    rdfs:label "Quality Metric"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "Sprint F6 (2026-05-15)."@en ;
    rdfs:comment "A quality-specific metric in the quality: namespace, parented under the canonical measurement:QualityMetric umbrella. Per Sprint F6: declared from 6 dangling references (3 type, 1 subClassOf, 2 range)."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso measurement:QualityMetric ;
    rdfs:subClassOf measurement:QualityMetric ;
    skos:definition "A quality-specific metric in the quality: namespace, parented under the canonical measurement:QualityMetric umbrella. Per Sprint F6: declared from 6 dangling references (3 type, 1 subClassOf, 2 range)."@en ;
    skos:exactMatch measurement:QualityMetric .

qc:QualityModel a owl:Class ;
    rdfs:label "Quality Model"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 §4.1 - Quality Model Overview" ;
    rdfs:comment "Top-level model organizing quality dimensions and their relationships."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf qc:QualityConcept ;
    skos:definition "A structured framework that organizes quality characteristics into a hierarchical model defining which dimensions are assessed, their relative weights, and how they combine into an overall quality evaluation."@en ;
    skos:example "The OQC Quality Model organizes 14 quality dimensions under 3 categories (Functional, Structural, Pragmatic) with configurable weights for overall quality computation."@en .

reliability:FailureType a reliability:FailureConcept,
        owl:Class ;
    rdfs:label "Failure Type"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "IEEE 1044-2009 Standard Classification for Software Anomalies."@en ;
    rdfs:comment "Note: this class shares its local name with risk:FailureType but is a SEMANTICALLY DISTINCT classification. reliability:FailureType is the IEEE 1633 reliability-engineering taxonomy (transient/intermittent/permanent/cascading/byzantine failures); risk:FailureType is the IEC 60812 FMEA context vocabulary. The two lineages converged on the same local name by coincidence. Per L-47: cross-subject subClassOf was asserted in A2 (reliability v6.0.0) based on lexical name-matching, then removed in v7.0.0 after semantic verification. The two classes remain related (skos:related could be applied if linkage is desired)."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso risk:FailureType,
        <https://www.iso.org/standard/50641.html> ;
    rdfs:subClassOf reliability:Failure,
        risk:FailureType ;
    skos:definition "FailureType is a classification taxonomy for failures based on their temporal characteristics, behavioral patterns, and impact scope, distinguishing between transient failures that occur sporadically, permanent failures that persist until repair, and intermittent failures that recur under specific conditions."@en ;
    skos:exactMatch risk:FailureType ;
    skos:example "Classification of failures by temporal behavior: permanent, transient, intermittent, cascading, and byzantine types."@en .

reliability:GovernanceTrustDrift a owl:Class ;
    rdfs:label "Governance Trust Drift"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.8.0 drift-taxonomy extension — closes R2 from oepack-ecosystem-assessment-v1_0_0. Grouping derived from BP-D2 raw inspection of all 22 leaf-Drift skos:definitions."@en ;
    rdfs:comment "A drift category covering pathologies in which provenance, trust labels, or governance gates are bypassed: trust labels missing, upstream LOW/MISSING trust treated as HIGH, self-audit conflicts of interest, PROV files shipped without SHACL validation, simplifying plans silently dropping unauthorized artifacts, or architectural drift across sessions."@en ;
    rdfs:isDefinedBy <http://example.org/redo/v2.8.0/drift-taxonomy-extension> ;
    rdfs:subClassOf reliability:Drift ;
    skos:definition "A drift category covering pathologies in which provenance, trust labels, or governance gates are bypassed: trust labels missing, upstream LOW/MISSING trust treated as HIGH, self-audit conflicts of interest, PROV files shipped without SHACL validation, simplifying plans silently dropping unauthorized artifacts, or architectural drift across sessions."@en .

reliability:VerificationModality a owl:Class ;
    rdfs:label "Verification Modality"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NEEDS_EXPERT_REVIEW: Concept derived from a reliability ontology forensic analysis (v2.0.7). No single external publication identified."@en ;
    rdfs:comment "The specific tool or method required to verify a claim type. Critical principle: NEVER verify using only the modality that generated it."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf reliability:ProcessControlLayer ;
    skos:definition "The specific tool or method required to verify a claim type. Critical principle: NEVER verify using only the modality that generated it."@en ;
    skos:example "DataFabrication needs web_search; TestSuiteTheater needs computation; IntegrationBoundary needs rendering."@en .

reliability:ZombieClaim a owl:Class ;
    rdfs:label "Zombie Claim"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Gemini behavioral pathology report: zombie claim taxonomy" ;
    rdfs:comment """Positioned under LLMFailure (not LLMBehavioralPathology)
    because zombie claims can result from both hallucination and behavioral
    pathologies. A zombie claim may be fabricated (hallucination) or may be
    a factually correct statement that has lost its evidentiary binding
    (behavioral pathology). Measured via Zombie Claim Rate (ZCR)."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1145/3571730> ;
    rdfs:subClassOf reliability:DataFabrication ;
    skos:definition """Decision-relevant claim in LLM output that lacks
    adequate evidentiary support or contradicts available evidence, persisting
    in the output despite being unsupported or contradicted"""@en ;
    skos:example "A citation to 'arXiv:2301.99999' persists in generated text despite the paper not existing - the citation is 'undead' without valid source."@en,
        "A generated document asserting 'studies show 73% improvement' without citing any specific study."@en,
        "An LLM repeatedly states 'React 18 uses fiber reconciliation' in multiple responses even after being shown documentation that this has been the case since React 16, not 18."@en .

risk:BusinessImpact a owl:Class ;
    rdfs:label "Business Impact"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "Consolidated from reliability:BusinessImpact v3.1.0."@en ;
    rdfs:comment "Top-level category classifying organizational consequences of failures across financial, reputational, operational, regulatory, and customer dimensions."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:ImpactCategory,
        risk:RiskConcept ;
    skos:definition "Top-level category classifying organizational consequences of failures across financial, reputational, operational, regulatory, and customer dimensions."@en .

ae:AnalysisArchitecture a owl:Class ;
    rdfs:label "Analysis Architecture"@en ;
    measurement:hasMeasurementSubject measurement:AlgorithmAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Introduction to the Design and Analysis of Algorithms 3e Ch2"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    owl:disjointWith ae:AnalysisMethod,
        ae:AnalysisResource,
        ae:AnalysisTool,
        ae:AsymptoticNotation,
        ae:EmpiricalMethod,
        ae:HistoricalContext,
        ae:InterDomainRelationship,
        ae:UseCase ;
    skos:definition "A systematic framework or paradigm that prescribes how to organize and conduct the analysis of an algorithm efficiency, including the choice of input size metric, basic operation identification, case analysis strategy, and derivation of closed-form expressions."@en .

ae:BackwardSubstitution a owl:Class ;
    rdfs:label "Backward Substitution"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Sec2.4"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:AnalysisTool ;
    owl:disjointWith ae:CharacteristicEquation,
        ae:StirlingApproximation ;
    skos:definition "A technique for solving recurrences by repeatedly substituting the recurrence into itself to reveal a pattern, then using the initial condition to obtain a closed-form solution after i substitutions."@en .

configuration:ChangeOperation a owl:Class ;
    rdfs:label "Change Operation"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Version Control and Ontology Evolution (Noy & Musen, 2004). Knowledge Engineering Review."@en ;
    rdfs:comment "Atomic or composite modification applied to an ontology during evolution."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html>,
        <https://www.w3.org/TR/owl-versioning/> ;
    rdfs:subClassOf configuration:Evolution ;
    skos:definition "An atomic modification to an ontology's formal structure that alters its class hierarchy, property definitions, axiom set, or instance data, recorded as a discrete unit for version tracking and undo capability."@en ;
    skos:example "Adding a new class 'Vehicle' as subclass of 'Thing' is a class addition operation."@en .

core:Agent a owl:Class ;
    rdfs:label "Agent"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    dcterms:source "DOLCE+DnS Ultralite (Gangemi & Mika 2003). ISO/IEC/IEEE 42010:2011 stakeholders. Generalised from BFO 2.0 IndependentContinuant carrying agentive capabilities."@en ;
    rdfs:isDefinedBy <http://example.org/core> ;
    rdfs:seeAlso reliability:Agent ;
    skos:definition "An entity capable of intentional action within an engineering process. Generalises agentive role-bearers (Developer, Tester, Maintainer, Stakeholder) and is the canonical domain of core:hasRole."@en ;
    skos:exactMatch reliability:Agent .

measurement:CompletenessMetric a owl:Class ;
    rdfs:label "Completeness Metric"@en ;
    measurement:hasMeasurementSubject measurement:OntologyMeasurementSubject ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F3 (2026-05-14): umbrella class implicit via subClassOf claims but never declared. Per BP-D2 + L-47v2: declared with full skos:definition to satisfy target class constraints."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:Measurement ;
    skos:definition "Umbrella class for metrics measuring annotation and structural completeness — what fraction of classes have rdfs:label, skos:definition, dcterms:source, etc. Children include AnnotationRichness, ClassFullness. Per Sprint F3."@en .

measurement:ThresholdRow a owl:Class ;
    rdfs:label "Threshold Row"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F2 broad consolidation 2026-05-14. Consolidated two ghost IRIs (quality:ThresholdRow, measurement:ThresholdRow) plus the 247 ABox individuals previously typed as one or the other. Canonical home: measurement: per the explicit \"step 8 will collapse to this canonical home\" note on measurement:Threshold."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty measurement:appliesToMetric ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty measurement:oquareScore ],
        measurement:Measurement ;
    skos:definition "A single row within a ThresholdTable mapping a (metric, role, value-range) triple to an OQuaRE band score. Each row asserts: when metric M is applied to an ontology of role R, and the measured value falls within [lowerBound, upperBound], the OQuaRE band score is N (1..5). Per Duque-Ramos et al. (2011) §3.4 OQuaRE Table 4 with role-aware adaptations. Consolidated from prior quality:ThresholdRow and measurement:ThresholdRow ghost IRIs in Sprint F2 (2026-05-14)."@en .

meta:Tool a owl:Class ;
    rdfs:label "Tool"@en ;
    dcterms:isPartOf <http://example.org/meta> ;
    dcterms:source "ISO/IEC 24765:2017 Systems and software engineering — Vocabulary."@en ;
    rdfs:comment "Definition authored during a reliability ontology remediation 2026-02-09; pending domain expert review."@en ;
    rdfs:isDefinedBy <http://example.org/meta> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2014.6816804>,
        <https://www.iso.org/standard/71543.html> ;
    skos:definition "A software application or utility that supports one or more activities within the ontology engineering lifecycle, including editing, validation, reasoning, visualization, and deployment."@en ;
    skos:example "pySHACL, rdflib, HermiT 1.5, and Apache Jena each qualify as a Tool in the META ontology: a software system used to create, validate, or query ontology artefacts in the OE engineering workflow."@en .

reliability:Failure a reliability:FailureConcept,
        owl:Class ;
    rdfs:label "Failure"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://doi.org/10.1109/DSN.2004.1311885> ;
    rdfs:comment """A failure is the manifestation of an error within the system. 
    Failures are observable deviations from expected behavior."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/50641.html> ;
    rdfs:subClassOf reliability:FailureConcept ;
    skos:altLabel "Service Failure"@en,
        "System Failure"@en ;
    skos:definition "Failure is an event that occurs when the delivered service deviates from correct service as specified in requirements, representing the externally observable manifestation of an internal error that has propagated to the system boundary and impacts the user or dependent systems."@en ;
    skos:example "Database connection timeout after 30 seconds when connection pool exhausted under high load conditions."@en .

testing:TestingMethodology a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "TestingMethodology"@en ;
    dcterms:isPartOf <http://example.org/testing> ;
    rdfs:comment "A systematic approach or process for evaluating software, ontologies, or AI systems. Encompasses the activity of testing: methods, techniques, and protocols. Distinguished from testing:Test, which is the artifact produced by applying a methodology."@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf core:Process,
        testing:TestingConcept ;
    skos:definition "A systematic approach or process for evaluating software, ontologies, or AI systems. Encompasses the activity of testing: methods, techniques, and protocols. Distinguished from testing:Test, which is the artifact produced by applying a methodology."@en .

ae:AlgorithmFamily a owl:Class ;
    rdfs:label "Algorithm Family"@en ;
    measurement:hasMeasurementSubject measurement:AlgorithmAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Cormen et al 2022 Introduction to Algorithms 4e"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:Taxonomy ;
    owl:disjointWith ae:EfficiencyClass,
        ae:ParameterizedComplexityClass ;
    skos:definition "A group of algorithms sharing a common design paradigm or strategy such as divide-and-conquer, dynamic programming, greedy, backtracking, or randomized, whose efficiency characteristics follow recognizable patterns amenable to systematic analysis."@en .

ae:PhilosophicalFoundation a owl:Class ;
    rdfs:label "Philosophical Foundation"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Sipser 2013 Introduction to the Theory of Computation 3e"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    owl:disjointWith ae:AnalysisArchitecture,
        ae:AnalysisMethod,
        ae:AnalysisResource,
        ae:AnalysisTool,
        ae:AsymptoticNotation,
        ae:EmpiricalMethod,
        ae:HistoricalContext,
        ae:InterDomainRelationship,
        ae:StructuralConcept,
        ae:Taxonomy,
        ae:UseCase ;
    skos:definition "A foundational philosophical or theoretical principle underlying the study of algorithm efficiency, including computability theory, tractability assumptions, and complexity-theoretic worldviews that frame how researchers reason about algorithmic performance bounds."@en .

ae:StirlingApproximation a owl:Class ;
    rdfs:label "Stirling Approximation"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Graham Knuth and Patashnik 1994 Concrete Mathematics 2e Sec9.1"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:AnalysisTool ;
    owl:disjointWith ae:CharacteristicEquation ;
    skos:definition "The asymptotic formula n! approximated as sqrt(2*pi*n)*(n/e)^n providing accurate factorial approximations for large n, essential for comparing n! growth with exponential functions in algorithm analysis."@en .

configuration:PlanArtefact a owl:Class ;
    rdfs:label "plan artefact"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "OE Ecosystem Review v1.0.1 Enhancement E-01; meta-sprint plan ontology pattern."@en ;
    rdfs:comment "Why subClass of EngineeringArtefact (not just NamedIndividual): plans ARE engineering artefacts; they have lifecycle (drafted → reviewed → approved → executed → closed), they have manifests, they have version tokens, they should follow AMOD discipline."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf configuration:EngineeringArtefact ;
    skos:definition "An EngineeringArtefact representing a plan, plan-component, or plan-element. Covers: the entire plan proposal, individual tracks, proposed sprints, deliverables within sprints, acceptance criteria, risks, mitigations, open questions, sequencing options, and cross-track dependencies. The plan-as-ontology pattern means each of these is a NamedIndividual that can be queried, cited, and refined — not opaque text in a markdown document."@en ;
    skos:example "An IT R&D manager creating a quarterly roadmap can model it as: configuration:PlanProposal containing several configuration:Track instances, each with proposed configuration:ProposedSprint instances, each with configuration:ProposedDeliverable + configuration:AcceptanceCriterion + configuration:RiskItem + configuration:MitigationStrategy. All queryable via SPARQL."@en .

core:Stakeholder a owl:Class ;
    rdfs:label "Stakeholder"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    dcterms:source "ISO 42010:2011 §3.31 — Stakeholder definition; ISO/IEC 25010:2023 §4.1 — Quality model stakeholder perspective."@en ;
    rdfs:isDefinedBy <http://example.org/core> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html>,
        <https://www.iso.org/standard/50508.html> ;
    rdfs:subClassOf core:Agent,
        core:Role ;
    skos:definition "An individual, group, or organization with a vested interest in the outcomes of an engineering process, who may influence or be affected by decisions, deliverables, or quality characteristics of the produced artifacts."@en ;
    skos:example "A domain expert from the quality assurance team who reviews OQC competency questions and validates that QualityAssessment individuals correctly represent ISO/IEC 25010:2023 characteristics is a Stakeholder of the OQC ontology."@en .

measurement:ComputationalProblemAsSubject a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Computational Problem As Subject"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:AlgorithmicStructureMeasurementSubject ;
    skos:definition "Computational problems classified by inherent complexity (Decision, Optimization, Search, Counting, Enumeration). The problem, not the algorithm, is the measurement subject; the result is a complexity class (P, NP, PSPACE, etc.)."@en .

measurement:SizeMetric a owl:Class ;
    rdfs:label "Size Metric"@en ;
    measurement:hasMeasurementSubject measurement:OntologyMeasurementSubject ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F3 (2026-05-14): umbrella class implicit via subClassOf claims but never declared. Per BP-D2 + L-47v2: declared with full skos:definition to satisfy target class constraints."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:Measurement ;
    skos:definition "Umbrella class for metrics measuring structural size dimensions of an ontology — class count, property count, attribute richness, inheritance depth. Per Duque-Ramos et al. (2011) OQuaRE structural dimension. Children include AttributeRichness, ClassChildrenCount, ClassRichness, and 5 others. Per Sprint F3: implicit umbrella now declared."@en .

qc:OntologyArtifact a owl:Class ;
    rdfs:label "Ontology Artifact"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "NeOn Methodology: Suárez-Figueroa et al. (2012). Ontology Engineering Artifacts" ;
    rdfs:comment "Local proxy class equivalent to http://example.org/knowledge-base#OntologyArtifact. Also declared as rdfs:subClassOf configuration:OntologyFile — every OQC-assessed ontology artefact is an AMOD-managed OntologyFile, enabling the OQC quality assessment pipeline to participate in AMOD artefact management and a reliability ontology sprint manifest tracking."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty kb:hasVersion ],
        configuration:OntologyFile,
        core:Artifact,
        qc:QualityConcept ;
    skos:definition "A tangible deliverable produced during ontology engineering, including the ontology file itself, documentation, test suites, change logs, and versioned releases."@en ;
    skos:example "OQC_Ontology_v1_0_0 is an OntologyArtifact with associated ChangeLog, TestSuite, and QualityReport."@en .

qc:TestCase a owl:Class ;
    rdfs:label "Test Case"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 29119-3:2013 - Software testing, Test Case documentation" ;
    rdfs:comment "Local proxy class equivalent to http://example.org/knowledge-base#TestCase."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso reliability:TestCase ;
    rdfs:subClassOf qc:QualityConcept ;
    skos:definition "A verifiable test specification consisting of inputs, execution conditions, and expected results designed to validate that the ontology correctly answers a competency question."@en ;
    skos:example "TestCase_CQ_045: A SPARQL ASK query verifying that requirements can be retrieved by status, linked to CQ-045 via verifiesCompetencyQuestion."@en ;
    skos:scopeNote "DIFFERENCE (BP-D46, governor-ruled 2026-06-26): quality:TestCase validates the ONTOLOGY (competency questions, ontology correctness); reliability:TestCase validates a SYSTEM (system correctness/completeness, preconditions). Distinct concepts sharing a local name — linked by rdfs:seeAlso for navigation, NOT skos:exactMatch."@en .

reliability:BenchmarkDataset a owl:Class ;
    rdfs:label "Benchmark Dataset"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:comment """Benchmark datasets provide consistent evaluation criteria and enable 
    reproducible reliability assessment"""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.w3.org/TR/prov-o/> ;
    rdfs:subClassOf reliability:Artifact ;
    skos:definition "BenchmarkDataset is an artifact representing a standardized evaluation corpus used to measure LLM reliability characteristics, including hallucination rate, factual accuracy, and behavioral compliance across test scenarios."@en ;
    skos:example "TruthfulQA contains 817 questions designed to elicit false answers that mimic human misconceptions."@en,
        "TruthfulQA: 817 questions testing model tendency to reproduce common misconceptions."@en .

reliability:ComplianceGate a owl:Class ;
    rdfs:label "Compliance Gate"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Avizienis, A., Laprie, J.-C., Randell, B., & Landwehr, C. (2004). Basic Concepts and Taxonomy of Dependable and Secure Computing. IEEE Transactions on Dependable and Secure Computing, 1(1), 11-33. DOI:10.1109/TDSC.2004.2"@en ;
    rdfs:comment """Automated, externally-authored enforcement point that the
    LLM cannot modify. Key principle: human writes validation, LLM cannot
    alter it. Examples include grep-based schema verification, import
    validation, and structural compliance checks. Must be read-only to the
    LLM and execute automatically as part of the development pipeline."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty reliability:verifiedBy ],
        reliability:VerificationMethod ;
    skos:definition """Automated enforcement checkpoint authored by a human
    and protected from LLM modification, which mechanically verifies that
    LLM-generated output satisfies specified structural and behavioral
    constraints before integration proceeds"""@en ;
    skos:example "PR cannot merge without: (1) all tests passing, (2) code review approval, (3) security scan clean, (4) documentation updated."@en,
        "Pre-deployment review requiring evidence of load testing, security scan, and code review approval."@en .

reliability:Entity a owl:Class ;
    rdfs:label "Entity"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:comment "Root of the ontology hierarchy"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf owl:Thing ;
    skos:definition "Entity is a top-level abstract class in the a reliability ontology ontology that serves as the root concept for all domain elements requiring identity, classification, and lifecycle tracking within reliability engineering."@en ;
    skos:example "System, component, module, and service are entities that can be characterized by reliability attributes."@en .

reliability:LLMFailure a owl:Class ;
    rdfs:label "LLM Failure"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Wei, J., Tay, Y., Bommasani, R., et al. (2022). Emergent Abilities of Large Language Models. Transactions on Machine Learning Research. arXiv:2206.07682"@en ;
    rdfs:comment "Parent class for all LLM-specific failure modes"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1145/3571730> ;
    rdfs:subClassOf reliability:Failure ;
    skos:definition "LLMFailure is a failure mode specific to Large Language Model operations and outputs, encompassing hallucinations, fabrications, inconsistencies, and other reliability degradations that arise from the stochastic nature of language model generation and their learned biases."@en ;
    skos:example "Umbrella category covering hallucination, data fabrication, zombie claims, and behavioral pathologies in LLM outputs."@en .

reliability:Problem a owl:Class ;
    rdfs:label "Problem"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "ITIL 4 Foundation (2019), §5.2.7 Problem Management. AXELOS Limited."@en ;
    rdfs:comment "A cause, or potential cause, of one or more incidents. In ITIL terms, distinct from redo:Failure (which is closer to ITIL Incident — an unplanned interruption or quality reduction). A Problem is the underlying root condition; multiple Failures may share one Problem."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty reliability:issueIdentifier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty reliability:openedAt ],
        reliability:ReliabilityConcept ;
    skos:definition "A cause, or potential cause, of one or more incidents. In ITIL terms, distinct from redo:Failure (which is closer to ITIL Incident — an unplanned interruption or quality reduction). A Problem is the underlying root condition; multiple Failures may share one Problem."@en ;
    skos:example "Problem: 'Class definitions in legacy modules omit dcterms:source.' Failure: a specific class reported in a SHACL violation. The single Problem produces many Failures."@en .

ae:CharacteristicEquation a owl:Class ;
    rdfs:label "Characteristic Equation"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Sec2.5"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:AnalysisTool ;
    skos:definition "An algebraic equation derived from a linear homogeneous recurrence with constant coefficients by substituting x(n) = r^n, whose roots determine the general solution form, enabling exact closed-form expressions like the Fibonacci formula."@en .

core:CompetencyQuestion a owl:Class ;
    rdfs:label "Competency Question"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    dcterms:source "Grüninger, M. & Fox, M. (1995). Methodology for the Design and Evaluation of Ontologies. Proc. IJCAI Workshop on Basic Ontological Issues in Knowledge Sharing."@en ;
    rdfs:isDefinedBy <http://example.org/core> ;
    rdfs:seeAlso <https://doi.org/10.1016/0004-3702(95)00017-8> ;
    skos:definition "A natural-language question that an engineering artifact (typically an ontology or knowledge base) should be able to answer, serving as both a functional requirement specification and a validation criterion."@en ;
    skos:example "CQ-a reliability ontology-01: 'Which LLMBehavioralPathology subclasses have at least one MitigationStrategy that targets them via core:mitigates?' is a CompetencyQuestion for the a reliability ontology ontology that can be answered by a single SPARQL SELECT query over redo_v2_5_5.ttl."@en .

<http://example.org/oemethod> a owl:Ontology ;
    dcterms:created "2026-10-06T00:00:00"^^xsd:dateTime ;
    dcterms:creator oe-prov:Agent_MethodAuthor,
        "the method author" ;
    dcterms:description "The T-Box of the OE Method's domain vocabularies as ONE file (BP-D54). Each former subject T-Box is a module: an untyped resource at its former ontology IRI carrying the old header's statements, version and version chain; every term says dcterms:isPartOf <its module>. The governance ontologies (knowledge base, release history, provenance registry, lineage backlogs) are a unit of their own. Built by oe_consolidate as a pure union, proved by union equality and by slicing back into the former files."@en ;
    dcterms:identifier "oemethod" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-07T00:00:00"^^xsd:dateTime,
        "2026-10-11T00:00:00"^^xsd:dateTime,
        "2026-10-12T00:00:00"^^xsd:dateTime ;
    dcterms:publisher oe-prov:Org_IKU_Department_of_ComputerEngineering ;
    dcterms:rights "Copyright (c) 2025-2026 a university & the method author. Licensed under CC BY 4.0." ;
    dcterms:rightsHolder oe-prov:Org_IKU_Department_of_ComputerEngineering ;
    dcterms:title "OE Method — T-Box (one file for the package)"@en ;
    rdfs:comment "The T-Box of the OE Method's domain vocabularies as ONE file (BP-D54). Each former subject T-Box is a module: an untyped resource at its former ontology IRI carrying the old header's statements, version and version chain; every term says dcterms:isPartOf <its module>. The governance ontologies (knowledge base, release history, provenance registry, lineage backlogs) are a unit of their own. Built by oe_consolidate as a pure union, proved by union equality and by slicing back into the former files."@en ;
    owl:priorVersion <http://example.org/oemethod/1.1.0>,
        <http://example.org/oemethod/1.1.1>,
        <http://example.org/oemethod/1.1.2>,
        <http://example.org/oemethod/1.2.0> ;
    owl:versionIRI <http://example.org/oemethod/1.3.0> ;
    owl:versionInfo "1.3.0" ;
    skos:changeNote "v1.1.0 (2026-10-06): re-derived module by module after the governing pack withdrew the second declaration of 26 terms that two of its modules both declared. Four modules changed here (core, measurement, quality, reliability); eight axioms the home module lacked moved to it, and every other value of the withdrawn declarations, with the module membership it carried, is gone and recorded in the pack's dedup reports."@en,
        "v1.1.1 (2026-10-07, PATCH): re-derived after the governing pack settled four terms that carried several definitions from a single module (has severity, assesses artifact, TopBraid Composer, Fault Tolerance) by the four stated rules, one definition each. Three modules changed here (reliability 7.15.1, quality 5.15.1, meta 1.3.1); the withdrawn wordings are recorded in the pack's duplicate-terms report."@en,
        "v1.1.2 (2026-10-07, PATCH): two identical copies of an anonymous subclass restriction (quality module) are removed, derived from the pack's repair; a union of two files had kept both. Nothing else changed."@en,
        "v1.2.0 (2026-10-11): re-derived after the governing package changed 2 module(s): http://example.org/measurement, http://example.org/reliability. Nothing else changed."@en,
        "v1.3.0 (2026-10-12): re-derived after the governing package changed 1 module(s): http://example.org/measurement. Nothing else changed."@en .

risk:RiskItem a owl:Class ;
    rdfs:label "Risk Item"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "Consolidated from configuration:RiskItem v2.0.0."@en ;
    rdfs:comment "A potential issue identified during planning that could impact a project, plan proposal, or deliverable. A RiskItem has an Impact level, Likelihood level, optional quantitative probability, status, owner, and one or more MitigationStrategies."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:seeAlso configuration:RiskItem ;
    rdfs:subClassOf risk:RiskConcept,
        risk:RiskRecord ;
    skos:definition "A potential issue identified during planning that could impact a project, plan proposal, or deliverable. A RiskItem has an Impact level, Likelihood level, optional quantitative probability, status, owner, and one or more MitigationStrategies."@en ;
    skos:related configuration:RiskItem .

testing:LLMTestingMethod a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "LLM Testing Method"@en ;
    testing:migrationDate "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/testing> ;
    dcterms:source reliability:LLMTestingMethod ;
    rdfs:comment "LLMTestingMethod is a testing subcategory that encompasses specialized evaluation techniques designed to assess LLM behavioral characteristics, including adversarial probing, consistency testing, and factual verification."@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf testing:TestingMethodology ;
    skos:definition "LLMTestingMethod is a testing subcategory that encompasses specialized evaluation techniques designed to assess LLM behavioral characteristics, including adversarial probing, consistency testing, and factual verification."@en ;
    prov:wasDerivedFrom reliability:LLMTestingMethod .

ae:StructuralConcept a owl:Class ;
    rdfs:label "Structural Concept"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Cormen et al 2022 Introduction to Algorithms 4e MIT Press"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    rdfs:subClassOf ae:AlgorithmicEfficiencyConcept ;
    owl:disjointWith ae:AnalysisArchitecture,
        ae:AnalysisMethod,
        ae:AnalysisResource,
        ae:AnalysisTool,
        ae:AsymptoticNotation,
        ae:EmpiricalMethod,
        ae:HistoricalContext,
        ae:InterDomainRelationship,
        ae:UseCase ;
    skos:definition "A mathematical or computational structure that serves as a building block in the analysis of algorithm efficiency, such as input size measures, growth rate functions, recurrence relations, or generating functions."@en .

core:Concept a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Concept"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    rdfs:isDefinedBy <http://example.org/core> ;
    skos:definition "Abstract umbrella for discipline-domain concepts owned by subject ontologies in the ecosystem — including QualityConcept, ReliabilityConcept, RiskConcept (planned), TestingConcept, MeasurementConcept (planned), OntologyEngineeringConcept, PerformanceConcept (planned), and StructuralConcept (algorithm efficiency). Each discipline-specific *Concept class subclasses this. Per L-39 noun-form discipline pattern; per L-44 cohesiveness through canonical-home discipline. Note: core:SeverityLevel already declares subClassOf core:Concept in v1.2.0 — this declaration resolves that previously-dangling reference."@en .

core:Metric a owl:Class ;
    rdfs:label "Metric"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    dcterms:source "ISO/IEC 25023:2016 Systems and software Quality Requirements and Evaluation — Measurement of system and software product quality; IEEE 1633-2016 Recommended Practice on Software Reliability."@en ;
    rdfs:isDefinedBy <http://example.org/core> ;
    rdfs:seeAlso measurement:Metric,
        <https://www.iso.org/standard/35733.html>,
        <https://www.iso.org/standard/35734.html> ;
    owl:disjointWith core:CompetencyQuestion,
        core:SeverityLevel,
        core:Version ;
    skos:definition "A quantifiable measurement instrument that produces a numerical or categorical value characterizing a specific property of an engineering artifact or process. Metrics must have defined measurement procedures, scales, and interpretation criteria."@en ;
    skos:example "rdfs:isDefinedBy coverage rate — the proportion of owl:ObjectProperty instances that declare their defining ontology — is a Metric used by META SHACL shape M5d to quantify namespace governance compliance."@en ;
    skos:related measurement:Metric .

core:SeverityLevel a owl:Class ;
    rdfs:label "Severity Level"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    dcterms:source "ISO/IEC 25040:2011 §7.3 — Severity classification; IEEE 1044-2009 Standard Classification for Software Anomalies."@en ;
    rdfs:isDefinedBy <http://example.org/core>,
        <http://example.org/reliability> ;
    rdfs:seeAlso risk:SeverityLevel,
        <https://www.iso.org/standard/35730.html>,
        <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf core:Concept,
        reliability:Entity,
        skos:Concept ;
    owl:disjointWith core:CompetencyQuestion,
        core:Version ;
    skos:definition "A categorical classification that assigns an impact magnitude rating to a finding, defect, or failure event using ordinal levels such as Critical, High, Medium, and Low."@en ;
    skos:exactMatch risk:SeverityLevel ;
    skos:example "A SQL injection vulnerability is classified as High Severity, a minor UI typo as Low Severity, and a performance degradation as Medium Severity."@en,
        "HIGH severity is assigned to the absence of prov:wasDerivedFrom across all five framework ontologies, because this gap prevents C6 gate closure and blocks sprint GATE_VECTOR VERDICT ecosystem-wide."@en .

measurement:OperationalEnvironmentMeasurementSubject a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Operational Environment Measurement Subject"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:MeasurementSubject ;
    skos:definition "Subject category for measurements taken on deployed operational systems and runtime environments. Applies to ReliabilityMetric subclasses (MTBF, MTTF, MTTR per IEEE 1633) and PerformanceMetric runtime subclasses (MemoryUsage, QueryResponseTime, ReasoningTime). The measurements require deployment history or runtime instrumentation, not static ontology analysis."@en .

qc:FunctionalQuality a owl:Class ;
    rdfs:label "Functional Quality"@en ;
    measurement:hasMeasurementSubject measurement:OntologyMeasurementSubject ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 §4.1 - Quality Model, Functional Quality Characteristics" ;
    rdfs:comment "Functional quality encompasses dimensions that evaluate whether the ontology satisfies its functional requirements."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf qc:QualityDimension ;
    skos:definition "A category of quality dimensions that collectively assess whether an ontology performs its intended functions correctly, completely, and consistently, encompassing characteristics like requirement coverage, logical correctness, and semantic coherence."@en ;
    skos:example """FunctionalQuality groups dimensions like Completeness (95% requirement 
    coverage), Correctness (zero unsatisfiable classes), and Consistency (uniform naming conventions) 
    to assess whether the ontology fulfills its intended functional purpose."""@en .

reliability:DecorativeCompliance a owl:Class ;
    rdfs:label "Decorative Compliance"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Avizienis, A., Laprie, J.-C., Randell, B., & Landwehr, C. (2004). Basic Concepts and Taxonomy of Dependable and Secure Computing. IEEE Transactions on Dependable and Secure Computing, 1(1), 11-33. DOI:10.1109/TDSC.2004.2"@en ;
    rdfs:comment """Distinguished from Hallucination: decorative compliance
    produces factually correct, syntactically valid output that satisfies
    surrogate quality signals (fluency, formatting, structure) while failing
    actual semantic integration. Content is not fabricated — it is
    architecturally disconnected. Detected via Admissibility Gap Index:
    high perceived quality minus low empirical correctness."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.2212.08073> ;
    rdfs:subClassOf reliability:LLMBehavioralPathology ;
    owl:disjointWith reliability:Hallucination,
        reliability:Sycophancy ;
    skos:definition """Optimization of LLM output against surrogate quality
    signals such as fluency, plausibility, and structural formatting while
    failing to achieve actual semantic integration with the target
    architecture or specification"""@en ;
    skos:example "A model generating a perfectly formatted report with headers and bullets but no substantive analysis."@en .

reliability:DomainContext a owl:Class ;
    rdfs:label "Domain Context"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:comment """Domain contexts enable specialization of reliability concepts for 
    specific industries or application areas while maintaining core ontology stability"""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf reliability:ReliabilityConcept ;
    skos:definition "DomainContext is a concept representing a specific professional or industry domain in which reliability requirements carry specialized regulatory, ethical, or safety constraints that shape engineering practices."@en ;
    skos:example "Healthcare domain requires HIPAA compliance, medical terminology accuracy, and patient safety guardrails."@en .

reliability:MetaReliability a owl:Class ;
    rdfs:label "Meta-Reliability"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "NEEDS_EXPERT_REVIEW: a reliability ontology-native concept. Related to meta-evaluation in NLP (Dang, 2006) and audit theory (Power, 1997. The Audit Society)."@en ;
    rdfs:comment """Reliability of the reliability assessment process itself. When 
    auditor and auditee are the same system, detection capability is 
    bounded by framework coverage: formalized failure categories approach 
    100% detection, while novel categories start at ~0%. Mitigation 
    capability (~85%) is stable regardless of coverage level."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.48550/arXiv.1706.04599> ;
    rdfs:subClassOf reliability:LLMReliability ;
    skos:definition """Reliability of the reliability assessment process itself. When 
    auditor and auditee are the same system, detection capability is 
    bounded by framework coverage: formalized failure categories approach 
    100% detection, while novel categories start at ~0%. Mitigation 
    capability (~85%) is stable regardless of coverage level."""@en ;
    skos:example """Longitudinal aggregate (N=37, v1.2-v2.2.0): autonomous detection 48.6%, 
    autonomous mitigation 86.5%, prevention rate 0%, resolution rate 89.2%. 
    Note: the 48.6% detection rate is a coverage-dependent aggregate mixing 
    early sessions (immature framework) with later sessions (mature framework). 
    For formalized categories with a reliability ontology in context, detection approached 100% 
    (v2.0.7: 12/12, v2.2.0: 2/2). The mitigation rate (~86.5%) is the 
    stable constant across all framework maturity levels."""@en .

risk:FMEAArtifact a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "FMEAArtifact"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "Abstract umbrella for FMEA (Failure Mode and Effects Analysis) workflow concepts per IEC 60812: FailureMode, FailureCause, FailureEffect, FailureType, FailureRate, Hazard. Groups the artifacts produced and manipulated during FMEA studies."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskConcept ;
    skos:definition "Abstract umbrella for FMEA (Failure Mode and Effects Analysis) workflow concepts per IEC 60812: FailureMode, FailureCause, FailureEffect, FailureType, FailureRate, Hazard. Groups the artifacts produced and manipulated during FMEA studies."@en .

ae:AnalysisResource a owl:Class ;
    rdfs:label "Analysis Resource"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "ACM Computing Surveys ISSN 0360-0300"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    owl:disjointWith ae:AsymptoticNotation,
        ae:EmpiricalMethod,
        ae:HistoricalContext,
        ae:InterDomainRelationship,
        ae:UseCase ;
    skos:definition "A tangible or digital artifact that supports the study and practice of algorithm efficiency analysis, including textbooks, software libraries, benchmarking suites, profiling tools, and visualization platforms."@en .

performance:PerformanceTest a owl:Class ;
    rdfs:label "Performance Test"@en ;
    measurement:hasMeasurementSubject measurement:OperationalEnvironmentMeasurementSubject ;
    dcterms:isPartOf <http://example.org/performance> ;
    dcterms:source "Migrated from reliability:PerformanceTest (a reliability ontology v3.0.0). Scheduled for deletion at a reliability ontology step 9."@en ;
    rdfs:comment "A test methodology that empirically measures performance characteristics under defined load and resource conditions."@en ;
    rdfs:isDefinedBy <http://example.org/performance> ;
    rdfs:seeAlso testing:PerformanceTest ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty performance:hasQueryType ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty performance:hasTargetMs ],
        performance:PerformanceConcept ;
    skos:definition "A test methodology that empirically measures performance characteristics under defined load and resource conditions."@en ;
    skos:exactMatch testing:PerformanceTest .

qc:PragmaticQuality a owl:Class ;
    rdfs:label "Pragmatic Quality"@en ;
    measurement:hasMeasurementSubject measurement:OntologyMeasurementSubject ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 §4.1 - Quality Model, Quality in Use Characteristics" ;
    rdfs:comment "Pragmatic quality encompasses dimensions that evaluate how well the ontology serves practical needs."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf qc:QualityDimension ;
    skos:definition "A category of quality dimensions that assess the practical usability, maintainability, and real-world applicability of an ontology, encompassing adaptability to changing requirements, reusability across projects, and accessibility for both domain experts and knowledge engineers."@en ;
    skos:example """PragmaticQuality groups dimensions like Usability (intuitive navigation 
    hierarchy), Maintainability (95% definition coverage enabling safe refactoring), and Adaptability 
    (modular structure supporting non-breaking extensions)."""@en .

reliability:Artifact a owl:Class ;
    rdfs:label "Artifact"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:comment "Includes software systems, documentation, test results, etc."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso core:Artifact,
        <https://www.w3.org/TR/prov-o/> ;
    rdfs:subClassOf core:Artifact,
        reliability:Entity ;
    skos:definition "Artifact is a top-level category representing tangible or digital work products created, consumed, or modified during reliability engineering processes, including models, test suites, documentation, and deployed systems."@en ;
    skos:exactMatch core:Artifact ;
    skos:example "Incident postmortem document capturing root cause, timeline, impact, and preventive actions."@en,
        "Test report, deployment manifest, and audit log are artifacts produced during the release process."@en ;
    skos:scopeNote "Intentional specialization of core:Artifact (reliability:Artifact rdfs:subClassOf core:Artifact). It carries reliability-specific semantics — it is the domain of exhibitsPathology/hasBehaviorConcern/hasEvidenceBinding and the range of the evidence-binding registration hooks (bindsEvidence/consumes/produces). The local name mirrors core:Artifact by design; this is NOT a redundant duplicate. Verified v20.22.0: 9 property axioms + 5 SHACL refs depend on it. Reconciliation option (a) chosen: retain + document rather than deprecate/rename."@en .

reliability:Hallucination a reliability:FailureConcept,
        owl:Class ;
    rdfs:label "Hallucination"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://arxiv.org/abs/2402.10412>,
        "LLM reliability research corpus: Malmqvist 2024, Ma et al. 2024, Ji et al. 2023 (arXiv:2311.05232)" ;
    rdfs:comment """Hallucinations represent a critical reliability challenge where LLMs 
    generate plausible but false information. The content appears authoritative and 
    well-structured, making detection without external verification difficult."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1145/3571730> ;
    rdfs:subClassOf reliability:LLMFailure ;
    skos:altLabel "LLM Hallucination"@en,
        "Model Hallucination"@en ;
    skos:definition "Hallucination is a failure concept describing instances where an LLM generates content that is factually incorrect, fabricated, or not grounded in the provided context or training data, undermining output trustworthiness."@en ;
    skos:example "A chatbot stating 'The Eiffel Tower was built in 1920' when the correct date is 1889."@en,
        "An LLM states 'The Great Wall of China was built in 1823 by Emperor Napoleon' - combining real entities into a fabricated claim."@en .

reliability:LLMTestingMethod a owl:Class ;
    rdfs:label "LLM Testing Method"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ammann & Offutt 2016, Introduction to Software Testing, Cambridge University Press" ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf reliability:TestingConcept ;
    skos:definition "LLMTestingMethod is a testing subcategory that encompasses specialized evaluation techniques designed to assess LLM behavioral characteristics, including adversarial probing, consistency testing, and factual verification."@en ;
    skos:example "Red-teaming session where adversarial prompts test model's resistance to generating harmful content or leaking system prompts."@en .

reliability:OntologyTesting a owl:Class ;
    rdfs:label "Ontology Testing"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Vrandecic (2009). Ontology Evaluation. Handbook on Ontologies, Springer."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf reliability:TestingConcept ;
    skos:definition "A sub-hierarchy of testing concepts specific to ontology engineering, including test types for verifying ontological axioms, class definitions, property definitions, reasoning performance, and import integration. Migrated from Meta ontology."@en ;
    skos:example "Specialized testing discipline covering class definition tests, axiom tests, competency question validation, and import integration."@en .

core:Artifact a owl:Class ;
    rdfs:label "Artifact"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    dcterms:source "Sprint F6 (2026-05-15)."@en ;
    rdfs:isDefinedBy <http://example.org/core> ;
    rdfs:seeAlso reliability:Artifact ;
    rdfs:subClassOf core:Concept ;
    skos:definition "Top-level umbrella for tangible deliverable artifacts across all subjects — ontologies, documents, reports, code modules. Cross-subject canonical home per Track C precedent. Per Sprint F6: declared from 1 subClassOf reference."@en ;
    skos:exactMatch reliability:Artifact .

qc:Finding a owl:Class ;
    rdfs:label "Finding"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25040:2011 §7.3 - Analysis and Measurement Phase" ;
    rdfs:comment "An identified quality issue or observation from an assessment."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35730.html> ;
    rdfs:subClassOf [ ],
        qc:AssessmentOutput ;
    skos:definition """A documented observation from a quality assessment that identifies either 
    a gap (missing/incomplete content) or a defect (error/violation). Findings are evidenced by 
    specific queries, tests, or analysis artifacts and should be traceable to requirements and components."""@en ;
    skos:example """Finding_001: A finding indicating that 12 out of 45 classes lack skos:definition, 
    categorized as a GapFinding with evidence from SPARQL query Q_ClassDefinitionCoverage."""@en .

risk:OrdinalLevel a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "OrdinalLevel"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "Abstract umbrella for ordinal classification levels: SeverityLevel, ImpactLevel, LikelihoodLevel, PriorityLevel, ActionPriority. Groups categorical scales used for risk rating and prioritization."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskConcept ;
    skos:definition "Abstract umbrella for ordinal classification levels: SeverityLevel, ImpactLevel, LikelihoodLevel, PriorityLevel, ActionPriority. Groups categorical scales used for risk rating and prioritization."@en .

ae:AnalysisMethod a owl:Class ;
    rdfs:label "Analysis Method"@en ;
    measurement:hasMeasurementSubject measurement:AlgorithmAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Sedgewick and Flajolet 2013 An Introduction to the Analysis of Algorithms 2e"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    owl:disjointWith ae:AnalysisResource,
        ae:AsymptoticNotation,
        ae:EmpiricalMethod,
        ae:HistoricalContext,
        ae:InterDomainRelationship,
        ae:UseCase ;
    skos:definition "A systematic procedural approach for conducting algorithm efficiency analysis, encompassing mathematical analysis of nonrecursive and recursive algorithms, empirical experimentation, and visualization-based investigation."@en .

ae:HistoricalContext a owl:Class ;
    rdfs:label "Historical Context"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Knuth 1997 The Art of Computer Programming Vol1 3e"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    skos:definition "A historically significant event, contribution, publication, or intellectual milestone in the development of algorithm efficiency analysis as a discipline, providing genealogical context for current theories and methods."@en .

ae:UseCase a owl:Class ;
    rdfs:label "Use Case"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Roughgarden 2019 Beyond Worst-Case Analysis CACM 62(3)"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    owl:disjointWith ae:AsymptoticNotation,
        ae:EmpiricalMethod,
        ae:HistoricalContext,
        ae:InterDomainRelationship ;
    skos:definition "A practical application scenario in which algorithm efficiency analysis is employed to solve real-world problems, including algorithm selection, performance prediction, compiler optimization, and automated algorithm design."@en .

configuration:ConfigurationManagementConcept a owl:Class ;
    rdfs:label "Amod Concept"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "IEEE 828-2012 Standard for Configuration Management in Systems and Software Engineering. Subject anchored to IEEE 828 via v19.0.3 rename amod → configuration; selected over evolution alternative per 100% content coverage of CM activities vs 63% for evolution. AmodConcept umbrella renamed to ConfigurationManagementConcept."@en ;
    rdfs:comment "Discipline-root umbrella for all configuration management concepts owned by the configuration subject. Subject scope follows IEEE 828-2012 Configuration Management in Systems and Software Engineering: configuration identification (EngineeringArtefact taxonomy, NamingConvention, ArtifactNamingSchema, FilenameSubjectPrefixAlignment), change control (ChangeOperation hierarchy: AtomicChange/BulkChange/CompositeChange and their structural/semantic/logical/documentation specialisations covering class, property, axiom, restriction, hierarchy operations), status accounting + release engineering (SemVerVersion, ReleaseCandidate, ReleaseTag, ReleaseSignature, VersionToken, BackwardCompatibility, BreakingChange, DeprecationNotice, HotfixRelease), and CM planning (PlanArtefact, PlanProposal, ProposedSprint, Track, AcceptanceCriterion, SequencingOption, OpenQuestion, RiskItem). Renamed from amod (Authoring & Maintenance OE Discipline) in v19.0.3 to anchor the subject in recognized field terminology (IEEE 828) rather than OE-pack-internal vocabulary. Convention-matching as a sibling of QualityConcept, RiskConcept, ReliabilityConcept, etc. under core:Concept."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:subClassOf core:Concept ;
    skos:definition "Discipline-root umbrella for all configuration management concepts owned by the configuration subject. Subject scope follows IEEE 828-2012 Configuration Management in Systems and Software Engineering: configuration identification (EngineeringArtefact taxonomy, NamingConvention, ArtifactNamingSchema, FilenameSubjectPrefixAlignment), change control (ChangeOperation hierarchy: AtomicChange/BulkChange/CompositeChange and their structural/semantic/logical/documentation specialisations covering class, property, axiom, restriction, hierarchy operations), status accounting + release engineering (SemVerVersion, ReleaseCandidate, ReleaseTag, ReleaseSignature, VersionToken, BackwardCompatibility, BreakingChange, DeprecationNotice, HotfixRelease), and CM planning (PlanArtefact, PlanProposal, ProposedSprint, Track, AcceptanceCriterion, SequencingOption, OpenQuestion, RiskItem). Renamed from amod (Authoring & Maintenance OE Discipline) in v19.0.3 to anchor the subject in recognized field terminology (IEEE 828) rather than OE-pack-internal vocabulary. Convention-matching as a sibling of QualityConcept, RiskConcept, ReliabilityConcept, etc. under core:Concept."@en .

core:Role a owl:Class ;
    rdfs:label "Role"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    dcterms:source "IEEE 12207:2017 §6.2 — Organizational life cycle processes; ISO 42010:2011 Systems and software engineering — Architecture description."@en ;
    rdfs:isDefinedBy <http://example.org/core> ;
    rdfs:seeAlso <https://www.iso.org/standard/50508.html>,
        <https://www.iso.org/standard/71543.html> ;
    owl:disjointWith core:CompetencyQuestion,
        core:Metric,
        core:SeverityLevel,
        core:Version ;
    skos:definition "A classification of agents based on the function they perform within an engineering process. A role defines a set of responsibilities, required competencies, and expected activities. An individual agent may simultaneously hold multiple roles."@en ;
    skos:example "An ontology engineer assigned the Maintainer role is responsible for adding dcterms:source annotations to all ObjectProperties after a remediation sprint — a role distinct from the Developer who authored the original axioms."@en .

qc:QualityAssessment a owl:Class ;
    rdfs:label "Quality Assessment"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25040:2011 §7 - Evaluation Process Model" ;
    rdfs:comment "A concrete assessment activity over one or more ontology artifacts."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf [ ],
        qc:AssessmentActivity ;
    skos:definition """A systematic evaluation activity that measures and analyzes the quality 
    characteristics of one or more ontology artifacts against defined quality criteria. The assessment 
    produces metrics, scores, and findings that inform quality gate decisions."""@en ;
    skos:example """Assessment_2025_Q1: A QualityAssessment that assesses artifact 'OQC_v1.0' 
    and has metrics for Completeness (85%), Correctness (95%), and Usability (78%)."""@en ;
    skos:scopeNote """Quality assessments should be traceable to specific ontology versions and 
    should document the assessment methodology, tools used, and assessor credentials."""@en .

reliability:VerificationMethod a owl:Class ;
    rdfs:label "Verification Method"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "IEEE 1012-2016 Standard for System, Software, and Hardware Verification and Validation."@en ;
    rdfs:comment "VerificationMethod is a systematic quality assurance approach that employs structured techniques to ensure the correctness, completeness, and behavioral compliance of a software system or AI component."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf core:Process ;
    skos:definition "VerificationMethod is a systematic quality assurance approach that employs structured techniques to ensure the correctness, completeness, and behavioral compliance of a software system or AI component."@en ;
    skos:example "Systematic technique for confirming correctness of ontology artifacts through formal, empirical, or adversarial means."@en .

ae:EmpiricalMethod a owl:Class ;
    rdfs:label "Empirical Method"@en ;
    measurement:hasMeasurementSubject measurement:ProgramAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Levitin 2012 Introduction to the Design and Analysis of Algorithms 3e Sec2.6"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    owl:disjointWith ae:HistoricalContext ;
    skos:definition "An experimental or observation-based approach to studying algorithm efficiency that complements formal mathematical analysis, including timing experiments, operation counting, profiling, benchmarking, and statistical inference of complexity classes from empirical data."@en .

ae:InterDomainRelationship a owl:Class ;
    rdfs:label "Inter-Domain Relationship"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Kleinberg and Tardos 2006 Algorithm Design Pearson"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    owl:disjointWith ae:AsymptoticNotation,
        ae:EmpiricalMethod,
        ae:HistoricalContext ;
    skos:definition "A formal conceptual connection between algorithm efficiency analysis and another computational or mathematical domain, such as data structures, programming paradigms, machine learning, formal verification, or software engineering processes."@en .

risk:FailureMode a owl:Class ;
    rdfs:label "FailureMode"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "Consolidated from reliability:FailureMode v3.1.0."@en ;
    rdfs:comment "The manner in which a failure of an item is observed (e.g., fail-open, fail-closed, intermittent, premature, late, no-output, partial-output). Per ISO 60812:2018."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:FMEAArtifact,
        risk:RiskConcept ;
    skos:definition "The manner in which a failure of an item is observed (e.g., fail-open, fail-closed, intermittent, premature, late, no-output, partial-output). Per ISO 60812:2018."@en .

risk:Risk a owl:Class ;
    rdfs:label "Risk"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    dcterms:source "Consolidated from reliability:Risk v3.1.0. ISO 31000:2018 definition."@en ;
    rdfs:comment "An effect of uncertainty on objectives. A risk is characterised by an event with a likelihood of occurrence and a consequential impact, and may be addressed via mitigation. Per ISO 31000:2018."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:seeAlso <https://www.iso.org/standard/65694.html> ;
    rdfs:subClassOf risk:RiskConcept ;
    skos:definition "An effect of uncertainty on objectives. A risk is characterised by an event with a likelihood of occurrence and a consequential impact, and may be addressed via mitigation. Per ISO 31000:2018."@en .

measurement:Metric a owl:Class ;
    rdfs:label "Metric"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Authored in OEM v1.1.0 as canonical foundational measurement vocabulary. Analogous OQC class (quality:Metric) currently co-exists; step 8 will collapse to this canonical home."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:seeAlso core:Metric ;
    rdfs:subClassOf measurement:Measurement ;
    skos:definition "A defined quantitative or qualitative measurement procedure: what is measured, how, and what kind of result is produced. A Metric is neutral about the subject being measured — subject-specific metrics (quality, reliability, performance) are typed as subclasses in their respective subject ontologies."@en ;
    skos:related core:Metric .

risk:RiskRecord a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "RiskRecord"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "Abstract umbrella for risk-tracking record concepts: RiskItem, RiskCategory, RiskStatus, RiskRegister, RiskAssessment. Groups the documentary/database structures used to maintain risk inventories."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf risk:RiskConcept ;
    skos:definition "Abstract umbrella for risk-tracking record concepts: RiskItem, RiskCategory, RiskStatus, RiskRegister, RiskAssessment. Groups the documentary/database structures used to maintain risk inventories."@en .

measurement:OntologyMeasurementSubject a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Ontology Measurement Subject"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:MeasurementSubject ;
    skos:definition "Subject category for measurements taken on ontologies. Applies to structural metrics (OQuaRE: ClassRichness, InheritanceRichness, etc.), completeness metrics (Precision/Recall/F1 against competency questions), and quality dimensions assessed via static or operational inspection of the ontology itself."@en ;
    skos:scopeNote "Distinct from oem:OntologyAsSubject. OntologyMeasurementSubject scopes measurements TREATING THE ONTOLOGY AS A STATIC STRUCTURE (OQuaRE structural metrics, completeness, annotation coverage). OntologyAsSubject scopes measurements TREATING THE ONTOLOGY AS AN ALGORITHMIC STRUCTURE (reasoning time, query latency under load). Both can apply to the same ontology under different measurement intents."@en .

reliability:FailureMitigation a owl:Class ;
    rdfs:label "Failure Mitigation"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Lyu, M.R. 1996, Handbook of Software Reliability Engineering, McGraw-Hill" ;
    rdfs:comment "Top-level category for all reliability-engineering approaches, design patterns, and operational practices employed to prevent, detect, contain, or recover from reliability failures in software and AI systems. SIBLING of risk:RiskMitigation under core:Mitigation (NOT a child of risk:RiskMitigation — per L-47, \"risk management applies to failures\" is a methodological relationship not a type-subsumption claim). Renamed from reliability:MitigationStrategy in v7.0.0 to clarify scope (failure-specific mitigation, not ISO 31000 strategy)."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf core:Mitigation,
        core:Process ;
    skos:definition "Top-level category for all reliability-engineering approaches, design patterns, and operational practices employed to prevent, detect, contain, or recover from reliability failures in software and AI systems. SIBLING of risk:RiskMitigation under core:Mitigation (NOT a child of risk:RiskMitigation — per L-47, \"risk management applies to failures\" is a methodological relationship not a type-subsumption claim). Renamed from reliability:MitigationStrategy in v7.0.0 to clarify scope (failure-specific mitigation, not ISO 31000 strategy)."@en ;
    skos:example "Circuit breaker pattern prevents cascading failures by stopping requests to degraded service after 5 consecutive failures."@en,
        "Implementing chain-of-thought verification to mitigate single-pass hallucination in LLM outputs."@en .

reliability:LifecyclePhase a owl:Class ;
    rdfs:label "Lifecycle Phase"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://standards.ieee.org/standard/1633-2016.html> ;
    rdfs:comment "LifecyclePhase is a temporal category representing a distinct stage in the software or AI system development lifecycle during which specific reliability engineering activities, deliverables, and quality gates apply."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1> ;
    rdfs:subClassOf core:Process ;
    skos:definition "LifecyclePhase is a temporal category representing a distinct stage in the software or AI system development lifecycle during which specific reliability engineering activities, deliverables, and quality gates apply."@en ;
    skos:example "Software progresses through design, implementation, testing, deployment, maintenance, and evolution phases."@en,
        "The testing phase typically follows implementation and precedes deployment in a waterfall lifecycle model."@en .

ae:AnalysisTool a owl:Class ;
    rdfs:label "Analysis Tool"@en ;
    measurement:hasMeasurementSubject measurement:AlgorithmAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Graham Knuth and Patashnik 1994 Concrete Mathematics 2e"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    owl:disjointWith ae:AnalysisMethod,
        ae:AnalysisResource,
        ae:AsymptoticNotation,
        ae:EmpiricalMethod,
        ae:HistoricalContext,
        ae:InterDomainRelationship,
        ae:UseCase ;
    skos:definition "A specific mathematical technique, formula, theorem, or computational instrument used to derive, simplify, or verify complexity bounds during the analysis of algorithm efficiency."@en .

ae:AsymptoticNotation a owl:Class ;
    rdfs:label "Asymptotic Notation"@en ;
    measurement:hasMeasurementSubject measurement:AlgorithmAsSubject ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "Cormen et al 2022 Introduction to Algorithms 4e Ch3"@en ;
    rdfs:isDefinedBy <http://example.org/ae> ;
    owl:disjointWith ae:EmpiricalMethod,
        ae:HistoricalContext ;
    skos:definition "A formal mathematical notation borrowed from analysis that characterizes the limiting behavior of a function as its argument tends towards infinity, used to classify algorithm running times and space requirements into equivalence classes of growth rate."@en .

qc:Reliability a owl:Class ;
    rdfs:label "Reliability"@en ;
    measurement:hasMeasurementSubject measurement:OntologyMeasurementSubject ;
    qc:hasMetric measurement:DITOnto,
        measurement:LCOMOnto,
        measurement:NOMOnto,
        measurement:WMCOnto ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 §4.2.10 - Reliability" ;
    rdfs:comment "The degree to which an ontology performs specified functions under specified conditions."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35730.html> ;
    rdfs:subClassOf qc:FunctionalQuality ;
    skos:broader qc:FunctionalQuality ;
    skos:definition "A quality dimension that evaluates the degree to which an ontology consistently performs its specified functions correctly under specified conditions over time. Reliability encompasses fault tolerance, recoverability, consistency under reasoning, and stability across different tools and platforms."@en ;
    skos:example "A reliable ontology maintains logical consistency under reasoning, recovers gracefully from malformed input, produces consistent results across different reasoners (HermiT, Pellet), and maintains semantic stability across versions."@en ;
    skos:narrower qc:Availability,
        qc:FaultTolerance,
        qc:Faultlessness,
        qc:Recoverability ;
    skos:related qc:Correctness .

reliability:FailureConcept a owl:Class ;
    rdfs:label "Failure Concept"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Lyu, M.R. 1996, Handbook of Software Reliability Engineering, McGraw-Hill" ;
    rdfs:comment "Parent class for all failure-related concepts"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf reliability:ReliabilityConcept ;
    skos:definition "FailureConcept is a top-level category in the reliability taxonomy that encompasses all types of system failures, faults, errors, and defects that compromise the intended behavior or quality of a system."@en ;
    skos:example "Network partition causes split-brain scenario where two database replicas accept conflicting writes simultaneously."@en,
        "Root cause analysis determining that memory corruption led to silent data corruption in database."@en .

core:Process a owl:Class ;
    rdfs:label "Process"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    dcterms:source "IEEE 12207:2017 Systems and software engineering — Software life cycle processes; ISO/IEC 33001:2015 Information technology — Process assessment."@en ;
    rdfs:comment "Domain ontologies specialize this: Meta defines ontology development processes, a reliability ontology defines reliability engineering processes."@en ;
    rdfs:isDefinedBy <http://example.org/core> ;
    rdfs:seeAlso <https://www.iso.org/standard/54175.html>,
        <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf core:Activity ;
    owl:disjointWith core:CompetencyQuestion,
        core:Metric,
        core:Role,
        core:SeverityLevel,
        core:Version ;
    skos:definition "A structured sequence of activities performed by agents to achieve a defined engineering objective. Processes are organizationally bounded, have identifiable inputs and outputs, and may be decomposed into sub-processes or individual activities."@en ;
    skos:example "The a reliability ontology four-stage verification pipeline — Pre-flight → Runtime Extraction → Formal Validation → Disclosure — is a Process with defined inputs (TTL files), outputs (gate verdicts), and agent assignment (LLM under safeguard)."@en .

qc:QualityConcept a owl:Class ;
    rdfs:label "Quality Concept"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 §4 - Quality Model Framework" ;
    rdfs:comment "Top-level abstract class for quality domain concepts."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf core:Concept,
        qc:QualityDomainEntity ;
    skos:definition "An abstract superclass for all concepts within the quality assessment domain, providing a common root for quality dimensions, metrics, and assessment-related entities within the ontology."@en ;
    skos:example "QualityDimension, Metric, Score, and OverallQuality are all instances of QualityConcept, sharing a common foundation within the quality assessment taxonomy."@en .

reliability:TestingConcept a owl:Class ;
    rdfs:label "Testing Concept"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "Ammann & Offutt 2016, Introduction to Software Testing, Cambridge University Press" ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <http://example.org/ontology-engineering#TestingConcept> ;
    rdfs:subClassOf core:Process ;
    owl:equivalentClass <http://example.org/ontology-engineering#TestingConcept> ;
    skos:definition "TestingConcept is a top-level category encompassing all structured approaches to evaluating system behavior, including testing methods, verification techniques, and quality assurance practices across the development lifecycle."@en ;
    skos:example "Top-level category for all testing-related concepts including test types, execution, metrics, and reporting."@en .

qc:QualityDimension a owl:Class ;
    rdfs:label "Quality Dimension"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "ISO/IEC 25010:2023 §4.1 - Quality Model, Quality Characteristics" ;
    rdfs:comment "A specific aspect of ontology quality that can be measured and evaluated."@en,
        "a reliability ontology remediation 2026-02-09: Removed rdfs:subClassOf qc:QualityCriterion (dimensions contain criteria, they are not criteria). Added qc:hasCriterion compositional property instead."@en ;
    rdfs:isDefinedBy <http://example.org/quality> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf qc:QualityConcept ;
    skos:definition """A measurable characteristic or aspect of ontology quality as defined by 
    quality models such as ISO/IEC 25010. Quality dimensions represent distinct evaluation 
    perspectives such as completeness, correctness, usability, or maintainability. Each dimension 
    is assessed through specific metrics and contributes to overall quality assessment."""@en ;
    skos:example """The Completeness dimension measures whether all required content is present, 
    evaluated through metrics like requirement coverage, definition coverage, and test coverage."""@en .

testing:Test a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Test"@en ;
    dcterms:isPartOf <http://example.org/testing> ;
    rdfs:comment "A test artifact: a specific test case, suite, scenario, or specification that can be executed to evaluate a target. The noun-form complement to testing:TestingMethodology. A Test is produced by APPLYING a TestingMethodology."@en ;
    rdfs:isDefinedBy <http://example.org/testing> ;
    rdfs:subClassOf qc:QualityConcept,
        testing:TestingConcept ;
    skos:definition "A test artifact: a specific test case, suite, scenario, or specification that can be executed to evaluate a target. The noun-form complement to testing:TestingMethodology. A Test is produced by APPLYING a TestingMethodology."@en .

measurement:AlgorithmAsSubject a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Algorithm As Subject"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:AlgorithmicStructureMeasurementSubject ;
    skos:definition "Algorithms in the abstract — divide-and-conquer, dynamic programming, greedy, backtracking, randomized — whose efficiency is the canonical subject of algorithm-efficiency analysis per Cormen/Levitin/Sedgewick."@en .

<http://example.org/performance> rdfs:label "Performance — Performance Engineering Ontology v1.0.1"@en ;
    dcterms:created "2026-05-13T00:00:00"^^xsd:dateTime ;
    dcterms:creator oe-prov:Agent_MethodAuthor,
        "the method author"@en ;
    dcterms:identifier "performance" ;
    dcterms:isPartOf <http://example.org/oemethod> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T00:00:00"^^xsd:dateTime ;
    dcterms:provenance """Prior rdfs:comment, retained: Performance Engineering Ontology — sibling subject under top-level Ontology Engineering. Holds Performance CHARACTERISTIC concepts (Performance, PerformanceEfficiency, PerformanceTest hierarchy) and 3 AE↔Performance bridge properties (DRY-collapsed from 6 source properties in retired ae_bridge_v1_0_1.ttl).
v1.0.1 (2026-05-13, PATCH of v1.0.0): corrected dcterms:source attribution on hasTheoretical"""@en,
        "Prior rdfs:comment, retained: performance TBox v1.3.0 (MINOR) per v17.31.0 — added hasTargetMs and hasQueryType datatype properties supporting concrete benchmark individuals (item #6/#7)."@en,
        "Prior rdfs:comment, retained: performance TBox v1.3.1 (PATCH) per v17.31.1 — added hasLastMeasuredMedianMs, hasLastMeasuredDate, hasLastMeasuredStatus DT properties supporting measurement-record persistence."@en,
        "Prior rdfs:comment, retained: performance v1.1.0 MINOR per cohesiveness plan v2.2.0 Sprint C2. Adds performance:PerformanceConcept as discipline-root umbrella under core:Concept; reparents 2 previously top-level classes."@en,
        "Prior rdfs:comment, retained: performance v1.2.0 (MINOR) — adds hasMeasurementSubject annotations on 6 performance test/efficiency classes (→ OperationalEnvironmentMeasurementSubject). Pure additive. Per policy 2026-05-15."@en,
        "Prior rdfs:comment, retained: performance_tbox v1.2.1 (PATCH) per v17.28.0 industrial-hardening — added CC BY 4.0 license, copyright, publisher/rightsHolder (IKÜ Computer Engineering), PROV-O wasGeneratedBy + wasAttributedTo (the method author). Additive ontology metadata only — no semantic changes."@en ;
    dcterms:publisher oe-prov:Org_IKU_Department_of_ComputerEngineering ;
    dcterms:rights "Copyright (c) 2025-2026 a university & the method author. Licensed under CC BY 4.0."@en ;
    dcterms:rightsHolder oe-prov:Org_IKU_Department_of_ComputerEngineering ;
    rdfs:comment "Performance answers: how does this behave under load, as distinct from how it scales in theory? It holds performance characteristics and the bridge to algorithm efficiency, keeping measured behaviour and asymptotic bound as separate claims that can disagree. It is small by design — most of the weight sits in the ae and measurement modules it connects. A reader comes here when a system is fast in analysis and slow in practice. Reproduce the class count by counting owl:Class subjects in the current TBox."@en,
        "v1.7.0 (2026-10-06, MINOR): every named subject now carries dcterms:isPartOf <http://example.org/performance> (its module), the first step of the consolidation of this package's files into one file per role. No term, label or definition changed."@en ;
    owl:imports <http://example.org/measurement> ;
    owl:priorVersion <http://example.org/performance/1.0.0>,
        <http://example.org/performance/1.0.1>,
        <http://example.org/performance/1.1.0>,
        <http://example.org/performance/1.2.0>,
        <http://example.org/performance/1.2.1>,
        <http://example.org/performance/1.3.0>,
        <http://example.org/performance/1.6.0> ;
    owl:versionIRI <http://example.org/performance/1.7.0> ;
    owl:versionInfo "1.7.0" ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor ;
    prov:wasGeneratedBy oe-prov:Activity_OEPackRelease_v17_28_0 .

configuration:EngineeringArtefact a owl:Class ;
    rdfs:label "Engineering Artefact"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "ISO/IEC 15289:2019 Systems and software engineering — Content of life-cycle information items. SWEBOK v4.0 (IEEE, 2024) — Software Configuration Management."@en ;
    rdfs:comment "Root class imported by a reliability ontology as the typed range for sprint manifest entries."@en ;
    rdfs:isDefinedBy <http://example.org/configuration> ;
    rdfs:seeAlso prov:Entity,
        <https://www.iso.org/standard/54846.html> ;
    rdfs:subClassOf configuration:ConfigurationManagementConcept ;
    skos:definition "A versioned, file-based work product produced during an engineering sprint that is tracked by name, version, format, checksum, and sprint of origin. EngineeringArtefact is the superclass of all tracked file types in the AMOD taxonomy. Every artefact must have a filename that embeds its version token per the project VersionInFilenamePolicy, and that token must match the version declared internally in the file."@en ;
    skos:example "redo_v2_4_9.ttl (OntologyFile), redo_shacl_v2_0_3.ttl (ShapeFile), redo_safeguard_ontology_v1.1.md (SafeguardDocument)"@en .

risk:RiskConcept a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Risk Concept"@en ;
    dcterms:isPartOf <http://example.org/risk> ;
    rdfs:comment "Discipline-root umbrella for all risk-domain concepts owned by the risk subject. Parents: Risk, RiskAssessment, RiskTreatment, RiskRegister, FailureMode/Cause/Effect, Hazard, MitigationStrategy, BusinessImpact (and sub-impacts), SeverityLevel/ImpactLevel/LikelihoodLevel/PriorityLevel/ActionPriority, RiskCategory, RiskStatus. Parallels quality:QualityConcept, reliability:ReliabilityConcept, testing:TestingConcept. Added per cohesiveness plan v2.2.0 Sprint C2."@en ;
    rdfs:isDefinedBy <http://example.org/risk> ;
    rdfs:subClassOf core:Concept ;
    skos:definition "Discipline-root umbrella for all risk-domain concepts owned by the risk subject. Parents: Risk, RiskAssessment, RiskTreatment, RiskRegister, FailureMode/Cause/Effect, Hazard, MitigationStrategy, BusinessImpact (and sub-impacts), SeverityLevel/ImpactLevel/LikelihoodLevel/PriorityLevel/ActionPriority, RiskCategory, RiskStatus. Parallels quality:QualityConcept, reliability:ReliabilityConcept, testing:TestingConcept. Added per cohesiveness plan v2.2.0 Sprint C2."@en .

reliability:QualityCharacteristic a owl:Class ;
    rdfs:label "Quality Characteristic"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://www.iso.org/standard/78176.html> ;
    rdfs:comment "Based on ISO/IEC 25010:2023 quality model"@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf reliability:ReliabilityConcept ;
    skos:definition "QualityCharacteristic is a top-level category derived from ISO 25010 that classifies measurable attributes of system quality including reliability, security, performance, maintainability, and their sub-characteristics."@en ;
    skos:example "Accuracy, availability, maintainability, and security are quality characteristics measurable through defined metrics."@en,
        "ISO 25010 defines 8 top-level quality characteristics including reliability, security, and maintainability."@en .

reliability:ReliabilityConcept a owl:Class ;
    rdfs:label "Reliability Concept"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "IEEE 1633-2016 Recommended Practice on Software Reliability; ISO/IEC 25010:2023 §3.5 Reliability."@en ;
    rdfs:comment "An abstract organizational class that groups all domain concepts specifically related to reliability engineering, including failure modes, quality characteristics, metrics, testing methods, and mitigation strategies within the a reliability ontology ontology taxonomy."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf core:Concept ;
    skos:definition "An abstract organizational class that groups all domain concepts specifically related to reliability engineering, including failure modes, quality characteristics, metrics, testing methods, and mitigation strategies within the a reliability ontology ontology taxonomy."@en ;
    skos:example "MTBF, failure rate, availability, and recoverability are interconnected reliability concepts in system assessment."@en,
        "MTBF, hallucination rate, failure modes, and verification methods are all reliability concepts."@en .

measurement:LLMMeasurementSubject a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "LLM Measurement Subject"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:MeasurementSubject ;
    skos:definition "Subject category for measurements taken on Large Language Model behavior. Applies to LLMReliabilityMetric subclasses (HallucinationRate, ZombieClaimRate, ExpectedCalibrationError, etc.) per the a reliability ontology behavioral-reliability research program. The measurements require observed LLM outputs over a benchmark, not static analysis."@en .

reliability:Drift a owl:Class ;
    rdfs:label "Drift"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.5.12 — synthesised from conversation_audit_v1_0_0.md (D-1..D-7, 2026-05-01); cross_chat_audit_disclosure_record_v1_0_0.md; v97_scoring_system_audit.md. Anchored on Avizienis et al. 2004 dependability taxonomy."@en ;
    rdfs:comment "Superclass for drift pathologies. A Drift is distinguished from a Hallucination in that the LLM's output is locally plausible at the token-level but globally inconsistent with the user's stated goals, prior turns, or on-disk reality. Drift is the dominant pathology in long-horizon ontology engineering; Hallucination dominates one-shot QA."@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:subClassOf reliability:LLMBehavioralPathology ;
    skos:definition "A category of LLM behavioural pathology in which output progressively diverges from a stable reference (user goal, prior commitment, on-disk artefact, or earlier in-session state) without an explicit acknowledgement of the divergence by the model. Drift is recoverable when surfaced; uncaught drift compounds across turns."@en ;
    skos:example "Specialised by ArchitecturalDrift, CountDrift, GoalContradictionDrift, PreflightInputDrift, PartialReadDrift, FalseDichotomyDrift, ScopeConflationDrift, CleanPlanDataLossDrift, CrossSessionContamination, OntologyDrivenOverstatement, OscillationPattern, ValidationScopeDrift."@en .

measurement:Measurement a owl:Class ;
    rdfs:label "Measurement"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "ORIGINATION in OEM v1.1.0 — umbrella authored to anchor the OEM subject's class hierarchy. The 3 bridge classes (MeasurementRun, MeasurementBinding, MeasurementContext) become subclasses of Measurement."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:MeasurementConcept ;
    skos:definition "Top-level umbrella for the OEM measurement subject. Covers metrics (what to measure), measures (instances of the act of measuring), scores (results), thresholds (interpretive ranges), and the measurement-run plumbing (when/how/by-which-framework a measurement happened). Concrete metric subclasses (e.g., quality:AccuracyMetric) live in subject-specific ontologies until step 8/9 migrate them to this subject."@en .

measurement:LLMReliabilityMetric a owl:Class ;
    rdfs:label "LLM Reliability Metric"@en ;
    measurement:hasMeasurementSubject measurement:LLMMeasurementSubject ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "Sprint F3 (2026-05-14): umbrella class implicit via subClassOf claims but never declared. Per BP-D2 + L-47v2: declared with full skos:definition to satisfy target class constraints."@en ;
    rdfs:isDefinedBy <http://example.org/measurement> ;
    rdfs:subClassOf measurement:Measurement ;
    skos:definition "Umbrella class for metrics specifically measuring the reliability of Large Language Models (LLMs) and their outputs. Includes calibration metrics (ECE, Brier score), factual-accuracy metrics, coverage metrics (CoverTau), and hallucination-rate metrics. Children include CoverTau, ExpectedCalibrationError, FactualAccuracy, plus ~25 additional LLM-reliability-specific metrics declared in v1.x as orphans. Per Sprint F3 consolidation (2026-05-14): the umbrella was implicit (28 children claimed it via subClassOf) but never declared."@en .

reliability:LLMBehavioralPathology a owl:Class ;
    rdfs:label "LLM Behavioral Pathology"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source <https://arxiv.org/abs/2310.13548>,
        "Avizienis et al. 2004" ;
    rdfs:comment """Intermediate class between LLMFailure and specific behavioral
    pathologies. Distinguished from Hallucination: behavioral pathologies can
    produce factually correct content that is architecturally disconnected,
    inappropriately aligned, or structurally misleading. Hallucination produces
    factually incorrect content. These are disjoint failure mechanisms requiring
    distinct detection and mitigation strategies."""@en ;
    rdfs:isDefinedBy <http://example.org/reliability> ;
    rdfs:seeAlso <https://doi.org/10.1145/3571730> ;
    rdfs:subClassOf reliability:LLMFailure ;
    owl:disjointWith reliability:Hallucination ;
    skos:definition """Systematic pattern of LLM behavior that degrades
    reliability through mechanisms other than factual fabrication, emerging
    from RLHF optimization pressures and statistical generation tendencies"""@en ;
    skos:example "An LLM consistently producing decorative compliance outputs that look thorough but contain no novel analysis."@en .

<http://example.org/core> rdfs:label "CORE — Shared Engineering Primitives v1.2.0"@en ;
    dcterms:created "2026-05-13T00:00:00"^^xsd:dateTime ;
    dcterms:creator oe-prov:Agent_MethodAuthor,
        "the method author"@en ;
    dcterms:identifier "core" ;
    dcterms:isPartOf <http://example.org/oemethod> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T00:00:00"^^xsd:dateTime ;
    dcterms:provenance """Prior rdfs:comment, retained: CORE provides shared engineering primitives imported by META, OQC, a reliability ontology, AMOD, OEM, and other OE Pack subject ontologies. Defines Version, Process, Role, Metric, Concept, and related abstract concepts used across the ecosystem.
v1.2.0 (2026-05-13): 3-file canonical split per option-a discipline. CONTINUATION of v1.1.8 with SeverityLevel absorbed from the retired core_v1_1_7_phase29_followup_v1_0_0"""@en,
        "Prior rdfs:comment, retained: core TBox v1.6.1 (PATCH) per v17.31.0 item #1 — consolidated core:SeverityLevel declaration (previously redundantly redeclared in reliability_tbox with a self-loop subClassOf bug)."@en,
        "Prior rdfs:comment, retained: core v1.3.0 (MINOR) per cohesiveness plan v2.2.0 Sprint C1. Adds core:Concept as the cross-subject discipline-root umbrella. Per BP-D2: core:Concept was already REFERENCED in v1.2.0 by core:SeverityLevel (subClassOf) but NOT DECLARED — this MINOR fixes the dangling reference AND establishes the umbrella that Sprint C2 will use to reparent each subject's discipline-root *Concept class. Per L-44 voc"@en,
        "Prior rdfs:comment, retained: core v1.4.0 (MINOR) per Track D Mitigation Cleanup. Adds core:Mitigation as cross-subject umbrella under core:Concept. Preserves \"Mitigation Concept\" and \"Risk Mitigation Concept\" as skos:altLabel for consolidation of the risk:MitigationConcept class being deleted in risk v3.0.0."@en,
        "Prior rdfs:comment, retained: core v1.5.0 (MINOR) — Sprint F6: declared core:Artifact umbrella."@en,
        "Prior rdfs:comment, retained: core v1.6.0 (MINOR) per v17.30.0 — added OperationalizableCompetencyQuestion + DescriptiveCompetencyQuestion subclasses with disjointness."@en,
        "Prior rdfs:comment, retained: core_tbox v1.5.1 (PATCH) per v17.28.0 industrial-hardening — added CC BY 4.0 license, copyright, publisher/rightsHolder (IKÜ Computer Engineering), PROV-O wasGeneratedBy + wasAttributedTo (the method author). Additive ontology metadata only — no semantic changes."@en ;
    dcterms:publisher oe-prov:Org_IKU_Department_of_ComputerEngineering ;
    dcterms:rights "Copyright (c) 2025-2026 a university & the method author. Licensed under CC BY 4.0."@en ;
    dcterms:rightsHolder oe-prov:Org_IKU_Department_of_ComputerEngineering ;
    rdfs:comment "Core holds the primitives every other module depends on — Version, Process, Role, Metric, Concept — so that a version means the same thing in quality as in reliability. It is deliberately small: a shared vocabulary earns its place by being agreed, not by being comprehensive. A reader comes here when two modules seem to disagree about a basic term, and leaves knowing which definition governs. Reproduce the class count by counting owl:Class subjects in the current TBox."@en,
        "v1.10.0 (2026-10-06, MINOR): every named subject now carries dcterms:isPartOf <http://example.org/core> (its module), the first step of the consolidation of this package's files into one file per role. No term, label or definition changed."@en,
        "v1.9.0 (2026-10-05): the four criticality-profile individuals (Profile_Critical, Profile_High, Profile_Low, Profile_Standard) moved to the A-Box (core_abox v1.6.0), so this file holds classes and properties only (BP-D53). No triple was added or removed; only the file they sit in changed."@en ;
    owl:priorVersion <http://example.org/core/1.2.0>,
        <http://example.org/core/1.3.0>,
        <http://example.org/core/1.4.0>,
        <http://example.org/core/1.5.0>,
        <http://example.org/core/1.5.1>,
        <http://example.org/core/1.6.0>,
        <http://example.org/core/1.8.0>,
        <http://example.org/core/1.9.0> ;
    owl:versionIRI <http://example.org/core/1.10.0> ;
    owl:versionInfo "1.10.0" ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor ;
    prov:wasGeneratedBy oe-prov:Activity_OEPackRelease_v17_28_0 .

<http://example.org/testing> rdfs:label "Software Testing Ontology v1.0.0"@en ;
    dcterms:created "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:creator oe-prov:Agent_MethodAuthor,
        "the method author"@en ;
    dcterms:identifier "sto" ;
    dcterms:isPartOf <http://example.org/oemethod> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T00:00:00"^^xsd:dateTime ;
    dcterms:provenance "Prior rdfs:comment, retained: STO v1.0.0 — canonical home for software testing concepts. Originates 2026-05-14 per cohesiveness plan v2.1.0 Sprint B1. Migrates 67 testing classes from reliability v4.0.0 (with 4 reclassified out: RAG, GraphRAG, KnowledgeGraphIntegration, LightweightHallucinationDetector — these are LLM architecture/grounding methods, not testing). Two parallel hierarchies per ISO/IEC/IEEE 29119-1: TestingMethod"@en,
        "Prior rdfs:comment, retained: STO v1.1.0 (MINOR) adds testing:TestingConcept as discipline-root umbrella over the 5 existing hierarchy umbrellas. This anticipates Track C's core:Concept cross-subject umbrella (Sprint C2 will add subClassOf core:Concept to testing:TestingConcept). Per user authorization 2026-05-14."@en,
        "Prior rdfs:comment, retained: sto v1.2.0 MINOR per cohesiveness plan v2.2.0 Sprint C2. Adds subClassOf core:Concept to testing:TestingConcept umbrella established in sto v1.1.0."@en,
        "Prior rdfs:comment, retained: sto_tbox v1.2.1 (PATCH) per v17.28.0 industrial-hardening — added CC BY 4.0 license, copyright, publisher/rightsHolder (IKÜ Computer Engineering), PROV-O wasGeneratedBy + wasAttributedTo (the method author). Additive ontology metadata only — no semantic changes."@en ;
    dcterms:publisher oe-prov:Org_IKU_Department_of_ComputerEngineering ;
    dcterms:rights "Copyright (c) 2025-2026 a university & the method author. Licensed under CC BY 4.0."@en ;
    dcterms:rightsHolder oe-prov:Org_IKU_Department_of_ComputerEngineering ;
    rdfs:comment "Testing answers: what did we check, and could the check have failed? It holds testing methodology and test types in two parallel hierarchies — process and artifact — separated deliberately from reliability in 2026, because how a system fails and how you look for failure are different subjects. Its most consequential idea is that a test never shown to reject anything verifies nothing. A reader comes here to design a check that discriminates. Reproduce the class count by counting owl:Class subjects in the current TBox."@en,
        "v1.5.0 (2026-10-06, MINOR): every named subject now carries dcterms:isPartOf <http://example.org/testing> (its module), the first step of the consolidation of this package's files into one file per role. No term, label or definition changed."@en ;
    owl:imports <http://example.org/core>,
        <http://example.org/quality> ;
    owl:priorVersion <http://example.org/testing/1.0.0>,
        <http://example.org/testing/1.1.0>,
        <http://example.org/testing/1.2.0>,
        <http://example.org/testing/1.4.0> ;
    owl:versionIRI <http://example.org/testing/1.5.0> ;
    owl:versionInfo "1.5.0" ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor ;
    prov:wasGeneratedBy oe-prov:Activity_OEPackRelease_v17_28_0 ;
    prov:wasRevisionOf <http://example.org/sto/1.2.1> .

<http://example.org/meta> rdfs:label "META — Meta-Modeling Vocabulary for Ontology Engineering v1.1.0"@en ;
    dcterms:created "2026-05-13T00:00:00"^^xsd:dateTime ;
    dcterms:creator oe-prov:Agent_MethodAuthor,
        "the method author"@en ;
    dcterms:identifier "meta" ;
    dcterms:isPartOf <http://example.org/oemethod> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-07T00:00:00"^^xsd:dateTime ;
    dcterms:provenance "Prior rdfs:comment, retained: META proper — sibling subject ontology under top-level Ontology Engineering. Holds META-MODELING vocabulary: concepts about how ontologies are structured, how they align with and map to other ontologies, the apparatus of ontology engineering (editors, reasoners, tools), and the SymbioticOntologyModel architectural pattern. Distinct from the Ontology Engineering discipline subject (kb:) which holds"@en,
        "Prior rdfs:comment, retained: meta PATCH v1.1.1. Sprint F1 ghost-reference cleanup: 2 dangling class references redirected to canonical homes; 0 dangling subClassOf claims dropped per L-47 (cross-subject methodological-vs-subsumption discipline). Per BP-D4/D5 gates: HermiT PASS, SHACL no new violations."@en,
        "Prior rdfs:comment, retained: meta_tbox v1.1.3 (PATCH) per v17.28.0 industrial-hardening — added CC BY 4.0 license, copyright, publisher/rightsHolder (IKÜ Computer Engineering), PROV-O wasGeneratedBy + wasAttributedTo (the method author). Additive ontology metadata only — no semantic changes."@en,
        "Prior rdfs:comment, retained: meta_tbox_v1_1_1 v1.1.2 (PATCH) — Sprint F6: dropped 31 moot owl:disjointWith axioms targeting undeclared classes (per BP-D19)."@en ;
    dcterms:publisher oe-prov:Org_IKU_Department_of_ComputerEngineering ;
    dcterms:rights "Copyright (c) 2025-2026 a university & the method author. Licensed under CC BY 4.0."@en ;
    dcterms:rightsHolder oe-prov:Org_IKU_Department_of_ComputerEngineering ;
    rdfs:comment "Meta answers: what is an ontology made of, and how do two of them relate? It holds meta-modelling vocabulary — structure, alignment, mapping, the tool apparatus of editors and reasoners, and the SymbioticOntologyModel pattern. It is deliberately distinct from the knowledge base, which holds how-to knowledge: meta describes the artifacts, the knowledge base describes the practice. A reader comes here when integrating with an ontology built elsewhere. Reproduce the class count by counting owl:Class subjects in the current TBox."@en,
        "meta v1.3.1 (2026-10-07, PATCH): TopBraid Composer carries one definition (it had two that disagreed about the edition and the features; only what both wordings and the vendor's own page support is kept). No term, label or class changed; only the wording of definitions."@en,
        "v1.3.0 (2026-10-06, MINOR): every named subject now carries dcterms:isPartOf <http://example.org/meta> (its module), the first step of the consolidation of this package's files into one file per role. No term, label or definition changed."@en ;
    owl:imports <http://example.org/core> ;
    owl:priorVersion <http://example.org/meta/1.0.0>,
        <http://example.org/meta/1.1.0>,
        <http://example.org/meta/1.1.1>,
        <http://example.org/meta/1.1.2>,
        <http://example.org/meta/1.2.0>,
        <http://example.org/meta/1.3.0> ;
    owl:versionIRI <http://example.org/meta/1.3.1> ;
    owl:versionInfo "1.3.1" ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor ;
    prov:wasGeneratedBy oe-prov:Activity_OEPackRelease_v17_28_0 .

<http://example.org/measurement> rdfs:label "OEM — OE Measurement Ontology v1.2.0"@en ;
    dcterms:created "2026-05-13T00:00:00"^^xsd:dateTime ;
    dcterms:creator oe-prov:Agent_MethodAuthor,
        "the method author"@en ;
    dcterms:identifier "oe-measurement" ;
    dcterms:isPartOf <http://example.org/oemethod> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T00:00:00"^^xsd:dateTime ;
    dcterms:provenance "Prior rdfs:comment, retained: OEM measurement subject. v1.2.0 (2026-05-13, MINOR bump from v1.1.0): absorbs 4 metric classes deferred at step 10 — CodeCoverage, MemoryUsage, QueryResponseTime, ReasoningTime. Re-rooted under appropriate OEM canonical parents per verb-vs-noun classification (these are measurements, not performance characteristics)."@en,
        "Prior rdfs:comment, retained: oe-measurement v1.3.0 MINOR per cohesiveness plan v2.2.0 Sprint C2. Adds oem:MeasurementConcept as discipline-root umbrella under core:Concept; reparents 1 previously top-level classes."@en,
        "Prior rdfs:comment, retained: oe-measurement v2.0.0 (MAJOR) — Sprint F2 broad namespace consolidation. Added 2 classes (ThresholdRow, ThresholdTable) and 6 properties (hasThresholdRow, appliesToMetric, appliesToRole, lowerBound, upperBound, oquareScore) as canonical home for the OQuaRE threshold vocabulary. Per BP-D17: coordinated with quality v5.0.0 (property deletions), SHACL relocation, and ABox migration. Per L-37, L-43, L"@en,
        "Prior rdfs:comment, retained: oe-measurement v2.1.0 (MINOR) — Sprint F3 umbrella class declarations. Declared 9 umbrella classes (LLMReliabilityMetric, SizeMetric, ReliabilityMetric, CoverageMetric, AggregationRule, CohesionMetric, CompletenessMetric, DescriptiveMetric, QualityMetric) previously implicit via subClassOf claims from ~64 children but never formally declared. Per L-47v2: each declaration includes mandatory skos:de"@en,
        "Prior rdfs:comment, retained: oe-measurement v2.2.0 (MINOR) — Sprint F4 property declarations. Declared 3 properties: measures, weightQCore, weightStructural. Per L-47v2: each with skos:definition. Domain/range inferred from raw ABox usage patterns per BP-D2."@en,
        "Prior rdfs:comment, retained: oe-measurement v2.3.0 (MINOR) — Sprint F5: declared 18 singleton metric/score classes that had ABox type/domain references but no class declaration. Each parented under an F3-declared umbrella."@en,
        "Prior rdfs:comment, retained: oe-measurement v2.4.0 (MINOR) — adds MeasurementSubject class taxonomy and hasMeasurementSubject property. Four initial subject categories: OntologyMeasurementSubject, LLMMeasurementSubject, ProgrammingLanguageMeasurementSubject (reserved), OperationalEnvironmentMeasurementSubject. Annotates 9 umbrella metric classes with their subject-of-measurement scope. Per user-established policy 2026-05-15: "@en,
        "Prior rdfs:comment, retained: oe-measurement v2.5.0 (MINOR) — adds AlgorithmicStructureMeasurementSubject + 7 sub-subjects (Algorithm, Program, Ontology, DataStructure, ComputationalProblem, Query, Workflow) per user insight 2026-05-15 that programs and ontologies are algorithmic structures amenable to algorithm-efficiency measurement. Adds skos:scopeNote to OntologyMeasurementSubject clarifying distinction from OntologyAsSubj"@en,
        "Prior rdfs:comment, retained: oe_measurement_tbox v2.5.1 (PATCH) per v17.28.0 industrial-hardening — added CC BY 4.0 license, copyright, publisher/rightsHolder (IKÜ Computer Engineering), PROV-O wasGeneratedBy + wasAttributedTo (the method author). Additive ontology metadata only — no semantic changes."@en,
        "Prior rdfs:comment, retained: oe_measurement_tbox_v2_3_0 v2.3.1 (PATCH) — Sprint F6: dropped 3 moot owl:disjointWith axioms targeting undeclared classes (per BP-D19)."@en,
        "Prior rdfs:comment, retained: oem PATCH v1.3.1. Sprint F1 ghost-reference cleanup: 2 dangling class references redirected to canonical homes; 0 dangling subClassOf claims dropped per L-47 (cross-subject methodological-vs-subsumption discipline). Per BP-D4/D5 gates: HermiT PASS, SHACL no new violations."@en ;
    dcterms:publisher oe-prov:Org_IKU_Department_of_ComputerEngineering ;
    dcterms:rights "Copyright (c) 2025-2026 a university & the method author. Licensed under CC BY 4.0."@en ;
    dcterms:rightsHolder oe-prov:Org_IKU_Department_of_ComputerEngineering ;
    rdfs:comment "Measurement answers: what number would settle this, and against what threshold? It holds metrics, thresholds, scores and observations, and it is the module that makes a quality claim arguable rather than assertable. Its distinguishing move is that an observation carries its method, so a figure can be re-derived by someone who was not there. A reader comes here to turn a judgement into something reproducible. Reproduce the threshold and metric counts by counting ThresholdRow and Metric individuals in the current ABox."@en,
        "v2.10.0 (2026-10-06, MINOR): every named subject now carries dcterms:isPartOf <http://example.org/measurement> (its module), the first step of the consolidation of this package's files into one file per role. No term, label or definition changed."@en,
        "v2.9.0 (2026-10-05): receives the nine term declarations (the threshold-row classes SyntaxQualityThresholdRow, PerformanceEfficiencyThresholdRow, RoleAwareThresholdRow and the properties vMin, vMax, wMin, wMax, combinedMsPerTripleMin, combinedMsPerTripleMax) from measurement_abox v2.11.1, so classes and properties live in the T-Box (BP-D53). No triple was added or removed; only the file they sit in changed."@en ;
    owl:priorVersion <http://example.org/measurement/1.1.0>,
        <http://example.org/measurement/1.2.0>,
        <http://example.org/measurement/1.3.0>,
        <http://example.org/measurement/1.3.1>,
        <http://example.org/measurement/2.0.0>,
        <http://example.org/measurement/2.1.0>,
        <http://example.org/measurement/2.2.0>,
        <http://example.org/measurement/2.3.0>,
        <http://example.org/measurement/2.3.1>,
        <http://example.org/measurement/2.4.0>,
        <http://example.org/measurement/2.5.0>,
        <http://example.org/measurement/2.5.1>,
        <http://example.org/measurement/2.8.0>,
        <http://example.org/measurement/2.9.0> ;
    owl:versionIRI <http://example.org/measurement/2.10.0> ;
    owl:versionInfo "2.10.0" ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor ;
    prov:wasGeneratedBy oe-prov:Activity_OEPackRelease_v17_28_0 ;
    prov:wasRevisionOf <http://example.org/oe-measurement/2.5.1> .

<http://example.org/risk> rdfs:label "Risk Management Ontology v1.0.0"@en ;
    configuration:derivedFrom <http://example.org/configuration/2.0.0>,
        <http://example.org/core/1.2.0>,
        <http://example.org/knowledge-base/1.2.1>,
        <http://example.org/quality/3.0.0>,
        <http://example.org/reliability/3.1.0> ;
    dcterms:created "2026-05-14T00:00:00"^^xsd:dateTime ;
    dcterms:creator oe-prov:Agent_MethodAuthor,
        "the method author"@en ;
    dcterms:identifier "risk" ;
    dcterms:isPartOf <http://example.org/oemethod> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T00:00:00"^^xsd:dateTime ;
    dcterms:provenance "Prior rdfs:comment, retained: Canonical risk-management subject ontology for OE Ecosystem. Consolidates scattered risk vocabulary from reliability, amod, quality, core, and oe subjects (per L-37 DRY-attribution). Provides COMPLETE FMEA pattern (per ISO 60812 / AIAG-VDA) and COMPLETE RiskItem pattern (per ISO 31000). Sources kept intact in this release for backward compatibility; future MAJOR bump will deprecate duplicates. Per"@en,
        "Prior rdfs:comment, retained: risk v1.1.0 MINOR per cohesiveness plan v2.2.0 Sprint C2. Adds risk:RiskConcept as discipline-root umbrella under core:Concept; reparents 24 previously top-level risk classes under risk:RiskConcept. Pre-existing cross-subject parents preserved."@en,
        "Prior rdfs:comment, retained: risk v2.0.0 MAJOR per cohesiveness plan v2.2.0 Sprint A1a. Structural redesign: added 5 umbrella classes under risk:RiskConcept (RiskTreatmentMethod, ImpactCategory, FMEAArtifact, OrdinalLevel, RiskRecord) plus reparented 22 existing classes under them. Hierarchy depth: 2 (v1.1.0) → 4 (v2.0.0). Added 2 new FMEA workflow properties (calculatesRPN, mitigates). No deletions. Standards gap fill (42 ab"@en,
        "Prior rdfs:comment, retained: risk v2.1.0 MINOR per cohesiveness plan v2.2.0 Sprint A1b. Added 42 standards-gap classes: 21 ISO 31000 (InherentRisk, ResidualRisk, RiskAppetite, RiskTolerance, RiskContext, RiskCriteria, RiskAnalysis, RiskEvaluation, RiskIdentification, RiskMonitoring, RiskReview, RiskReporting, RiskCommunication, RiskSource, RiskEvent, RiskConsequence, RiskManagementFramework, RiskGovernance, RiskCulture, RiskR"@en,
        "Prior rdfs:comment, retained: risk v3.0.0 (MAJOR) per Track D Mitigation Cleanup. (a) Renamed risk:MitigationStrategy → risk:RiskMitigation; (b) Deleted risk:MitigationConcept (consolidated into core:Mitigation via Resolution γ with skos:altLabel preserving the lexical form); (c) Deleted risk:RiskAcceptance and risk:RiskTransfer classes, preserving lexical forms as skos:altLabel on risk:RiskRetention and risk:RiskSharing respe"@en,
        "Prior rdfs:comment, retained: risk_tbox v3.0.1 (PATCH) per v17.27.0 Challenge 2 — added rdfs:domain to 1 orphaned datatype properties via design-intent extraction from skos:definition."@en,
        "Prior rdfs:comment, retained: risk_tbox v3.0.2 (PATCH) per v17.28.0 industrial-hardening — added CC BY 4.0 license, copyright, publisher/rightsHolder (IKÜ Computer Engineering), PROV-O wasGeneratedBy + wasAttributedTo (the method author). Additive ontology metadata only — no semantic changes."@en ;
    dcterms:publisher oe-prov:Org_IKU_Department_of_ComputerEngineering ;
    dcterms:rights "Copyright (c) 2025-2026 a university & the method author. Licensed under CC BY 4.0."@en ;
    dcterms:rightsHolder oe-prov:Org_IKU_Department_of_ComputerEngineering ;
    rdfs:comment "Risk answers: what could go wrong, how badly, and what are we doing about it? It provides the FMEA pattern and the RiskItem pattern, consolidating risk vocabulary that was previously scattered across reliability, quality and core. It is distinct from reliability: reliability models how a system fails, risk models the decision about whether to accept that. A reader comes here to make an accepted risk explicit rather than implicit. Reproduce the class count by counting owl:Class subjects in the current TBox."@en,
        "v3.5.0 (2026-10-06, MINOR): every named subject now carries dcterms:isPartOf <http://example.org/risk> (its module), the first step of the consolidation of this package's files into one file per role. No term, label or definition changed."@en ;
    owl:priorVersion <http://example.org/risk/1.0.0>,
        <http://example.org/risk/1.1.0>,
        <http://example.org/risk/2.0.0>,
        <http://example.org/risk/2.1.0>,
        <http://example.org/risk/3.0.0>,
        <http://example.org/risk/3.0.1>,
        <http://example.org/risk/3.1.0.1>,
        <http://example.org/risk/3.4.0> ;
    owl:versionIRI <http://example.org/risk/3.5.0> ;
    owl:versionInfo "3.5.0" ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor ;
    prov:wasGeneratedBy oe-prov:Activity_OEPackRelease_v17_28_0 .

<http://example.org/configuration> dcterms:created "2026-05-16T00:00:00"^^xsd:dateTime ;
    dcterms:creator oe-prov:Agent_MethodAuthor,
        "the method author"@en ;
    dcterms:identifier "amod" ;
    dcterms:isPartOf <http://example.org/oemethod> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T00:00:00"^^xsd:dateTime ;
    dcterms:provenance "Prior rdfs:comment, retained: amod PATCH v2.2.1. Sprint F1 ghost-reference cleanup: 0 dangling class references redirected to canonical homes; 0 dangling subClassOf claims dropped per L-47 (cross-subject methodological-vs-subsumption discipline). Per BP-D4/D5 gates: HermiT PASS, SHACL no new violations."@en,
        "Prior rdfs:comment, retained: amod v2.1.0 (MINOR from v2.0.0): removed all 16 owl:equivalentClass axioms. Per user rule 2026-05-14 'use the ORIGINAL class.' 14 axioms were MOOT (RHS in retired oepack-expansion-plan namespace, per BP-D2 + L-42 verification). 2 axioms (ArtifactNamingSchema, NamingConvention) linked to kb:* duplicates with lower ref-count — amod is the canonical home per step 13 AMOD consolidation. MINOR not MAJO"@en,
        "Prior rdfs:comment, retained: amod v2.2.0 MINOR per cohesiveness plan v2.2.0 Sprint A3. Deleted 3 risk-class duplicates: RiskImpact, RiskLikelihood, MitigationStrategy. Linked configuration:RiskItem subClassOf risk:Risk per BP-D19 (planning-context narrower concept, related-but-distinct from general risk:Risk)."@en,
        "Prior rdfs:comment, retained: amod v2.3.0 (MINOR) — Sprint F4 property declarations. Declared 3 properties: appliesToArtifactType, includesConvention, versionToken. Per L-47v2: each with skos:definition. Domain/range inferred from raw ABox usage patterns per BP-D2."@en,
        "Prior rdfs:comment, retained: amod_tbox v2.3.2 (PATCH) per v17.26.0 Option N — added rdfs:domain to 1 previously-orphaned datatype properties based on empirical ABox usage inference. Additive content per BP-D7 PATCH semantics."@en,
        "Prior rdfs:comment, retained: amod_tbox v2.3.3 (PATCH) per v17.27.0 Challenge 2 — added rdfs:domain to 1 orphaned datatype properties via design-intent extraction from skos:definition."@en,
        "Prior rdfs:comment, retained: amod_tbox v2.3.4 (PATCH) per v17.28.0 industrial-hardening — added CC BY 4.0 license, copyright, publisher/rightsHolder (IKÜ Computer Engineering), PROV-O wasGeneratedBy + wasAttributedTo (the method author). Additive ontology metadata only — no semantic changes."@en,
        "Prior rdfs:comment, retained: amod_tbox_v2_3_0 v2.3.1 (PATCH) — Sprint F6: dropped 46 moot owl:disjointWith axioms targeting undeclared classes (per BP-D19)."@en ;
    dcterms:publisher oe-prov:Org_IKU_Department_of_ComputerEngineering ;
    dcterms:rights "Copyright (c) 2025-2026 a university & the method author. Licensed under CC BY 4.0."@en ;
    dcterms:rightsHolder oe-prov:Org_IKU_Department_of_ComputerEngineering ;
    rdfs:comment "v2.7.0 (MINOR): added configuration:RoadmapReportMarkdown, a sibling of AuditReportMarkdown for a roadmap/progress report run. Ratified from a real cross-session proposal (a registrant package's own RegisterPackageShape/Role_ProgressReport requirement had no matching naming convention) after direct verification found the proposal's own suggested parent class (EngineeringArtefact) did not match its sibling's real parent (ProjectMarkdownDocument) -- corrected to genuinely match the precedent, not the proposal's stated text.",
        "Configuration answers: what is this artifact called, which version is current, and how would a stranger know? It holds naming conventions, version tokens, filename policies and the competency questions a package must be able to answer about itself. Its value is unglamorous and load-bearing: most governance failures here have been a file changed under a fixed version token, or a path resolved by memory rather than by pattern. A reader comes here to make an artifact identifiable without asking its author. Reproduce the class count by counting owl:Class subjects in the current TBox."@en,
        "v2.8.0 (2026-10-06, MINOR): every named subject now carries dcterms:isPartOf <http://example.org/configuration> (its module), the first step of the consolidation of this package's files into one file per role. No term, label or definition changed."@en ;
    owl:priorVersion <http://example.org/configuration/2.0.0>,
        <http://example.org/configuration/2.1.0>,
        <http://example.org/configuration/2.2.0>,
        <http://example.org/configuration/2.2.1>,
        <http://example.org/configuration/2.3.0>,
        <http://example.org/configuration/2.3.1>,
        <http://example.org/configuration/2.3.2>,
        <http://example.org/configuration/2.3.3>,
        <http://example.org/configuration/2.6.0>,
        <http://example.org/configuration/2.7.0> ;
    owl:versionIRI <http://example.org/configuration/2.8.0> ;
    owl:versionInfo "2.8.0" ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor ;
    prov:wasGeneratedBy oe-prov:Activity_OEPackRelease_v17_28_0 ;
    prov:wasRevisionOf <http://example.org/amod/2.5.0> .

<http://example.org/quality> dcterms:created "2026-05-16T00:00:00"^^xsd:dateTime ;
    dcterms:creator oe-prov:Agent_MethodAuthor,
        "the method author"@en ;
    dcterms:identifier "quality" ;
    dcterms:isPartOf <http://example.org/oemethod> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-07T00:00:00"^^xsd:dateTime ;
    dcterms:provenance "Prior rdfs:comment, retained: quality PATCH v4.1.1. Sprint F1 ghost-reference cleanup: 3 dangling class references redirected to canonical homes; 3 dangling subClassOf claims dropped per L-47 (cross-subject methodological-vs-subsumption discipline). Per BP-D4/D5 gates: HermiT PASS, SHACL no new violations."@en ;
    dcterms:publisher oe-prov:Org_IKU_Department_of_ComputerEngineering ;
    dcterms:rights "Copyright (c) 2025-2026 a university & the method author. Licensed under CC BY 4.0."@en ;
    dcterms:rightsHolder oe-prov:Org_IKU_Department_of_ComputerEngineering ;
    rdfs:comment "Quality answers: what would have to be true for this to be good enough, and who decided? It holds quality gates, the decisions they produce, the evidence those decisions rest on, assessment activities and the pitfalls that recur. Its distinguishing move is that a gate is modelled together with its configuration and its evidence, so a passing result can be re-derived rather than trusted. A reader comes here to turn 'this looks fine' into something another person can check. Reproduce the class count by counting owl:Class subjects in the current TBox."@en,
        "quality TBox v5.7.0 (MINOR) per v17.43.0 Option G — deprecated 5 DT properties (coverageRatio, missingCount, notes, threshold, weight) that had ambiguous blank-node rdfs:domain. Per L-40 honest discipline: deferred-for-deprecation rather than synthetic ABox population. Brings DT-Use to honest 100% (186 used + 5 deprecated of 191 total)."@en,
        "quality v4.0.0 (MAJOR from v3.0.0): removed all owl:equivalentClass axioms (13 total in TBox; replaced internal references with canonical core: IRIs). Per user rule 2026-05-14 'use the ORIGINAL class, don't invent a new class.' Classes Version/CompetencyQuestion/Stakeholder/SeverityLevel deleted from quality (canonical home is now core)."@en,
        "quality v4.1.0 MINOR per cohesiveness plan v2.2.0 Sprint C2. Adds subClassOf core:Concept to quality:QualityConcept, establishing cross-subject discipline-root umbrella linkage. Pre-existing parent quality:QualityDomainEntity preserved (multiple inheritance)."@en,
        "quality v5.0.0 (MAJOR) — Sprint F2 broad namespace consolidation. Deleted 4 property declarations (appliesToRole, lowerBound, upperBound, oquareScore) whose canonical home is now measurement: per the broad ThresholdRow consolidation. Per BP-D17: coordinated with oe-measurement v2.0.0, SHACL relocation, and ABox migration. a reliability ontology consumer migration required: any IRI reference to quality:appliesToRole, quality:lowerBound, quality:upperBound, quality:oquareScore must update to measurement: counterparts."@en,
        "quality v5.1.0 (MINOR) — Sprint F4 property declarations. Declared 4 properties: measuresCriterion, hasScore, isScoreOf, hasMetric. Per L-47v2: each with skos:definition. Domain/range inferred from raw ABox usage patterns per BP-D2."@en,
        "quality v5.15.1 (2026-10-07, PATCH): The assesses artifact property carries one definition (it had two, and both said the artifact is an ontology artifact where the range axiom accepts any artifact). No term, label or class changed; only the wording of definitions."@en,
        "quality v5.15.2 (2026-10-07, PATCH): the two classes (the quality assessment and the finding) that carried the same subclass restriction twice, identical copies left by merging two files, now carry it once. Nothing else changed."@en,
        "quality v5.2.0 (MINOR) — Sprint F5 Framework declaration."@en,
        "quality v5.3.0 (MINOR) — Sprint F6: declared quality:Score and quality:QualityMetric from remaining dangling references."@en,
        "quality v5.4.0 (MINOR) — adds hasMeasurementSubject annotations on 12 QualityDimension subclasses (→ OntologyMeasurementSubject) and 1 runtime-scoped dimension (→ OperationalEnvironmentMeasurementSubject). Pure additive. Per policy 2026-05-15."@en,
        "quality v5.5.0 (MINOR) per v17.25.0 Option P — added classes SyntaxQuality, PerformanceEfficiency, CompositeQuality."@en,
        "quality v5.6.0 (MINOR) per v17.27.0 Challenge 1 — added EcosystemAttributeRichness, DatatypePropertyDomainCompleteness, DatatypePropertyUsageRate metric classes."@en,
        "quality_tbox v5.6.1 (PATCH) per v17.28.0 industrial-hardening — added CC BY 4.0 license, copyright, publisher/rightsHolder (IKÜ Computer Engineering), PROV-O wasGeneratedBy + wasAttributedTo (the method author). Additive ontology metadata only — no semantic changes."@en,
        "v5.15.0 (2026-10-06, MINOR): every named subject now carries dcterms:isPartOf <http://example.org/quality> (its module), the first step of the consolidation of this package's files into one file per role. No term, label or definition changed."@en ;
    owl:imports <http://example.org/measurement> ;
    owl:priorVersion <http://example.org/quality/3.0.0>,
        <http://example.org/quality/4.0.0>,
        <http://example.org/quality/4.1.0>,
        <http://example.org/quality/4.1.1>,
        <http://example.org/quality/5.0.0>,
        <http://example.org/quality/5.1.0>,
        <http://example.org/quality/5.14.1>,
        <http://example.org/quality/5.15.0>,
        <http://example.org/quality/5.15.1>,
        <http://example.org/quality/5.2.0>,
        <http://example.org/quality/5.3.0>,
        <http://example.org/quality/5.4.0>,
        <http://example.org/quality/5.5.0>,
        <http://example.org/quality/5.6.0>,
        <http://example.org/quality/5.6.1> ;
    owl:versionIRI <http://example.org/quality/5.15.2> ;
    owl:versionInfo "5.15.2" ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor ;
    prov:wasGeneratedBy oe-prov:Activity_OEPackRelease_v17_28_0 .

<http://example.org/ae> rdfs:label "AE — Algorithm Efficiency Ontology v1.1.0"@en ;
    dcterms:created "2026-05-13T00:00:00"^^xsd:dateTime ;
    dcterms:creator oe-prov:Agent_MethodAuthor,
        "the method author"@en ;
    dcterms:identifier "algorithm-efficiency" ;
    dcterms:isPartOf <http://example.org/oemethod> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T00:00:00"^^xsd:dateTime ;
    dcterms:provenance "Prior rdfs:comment, retained: Algorithm Efficiency (AE) — sibling subject ontology under the top-level Ontology Engineering discipline. Models theoretical complexity (AsymptoticNotation), analysis architecture, algorithm families, and use cases for algorithm efficiency analysis. AE↔Performance bridge properties (formerly in ae_bridge_v1_0_1.ttl) folded into Performance subject at step 4. AE-Bridge file retirement: step 7. v1.1"@en ;
    dcterms:publisher oe-prov:Org_IKU_Department_of_ComputerEngineering ;
    dcterms:rights "Copyright (c) 2025-2026 a university & the method author. Licensed under CC BY 4.0."@en ;
    dcterms:rightsHolder oe-prov:Org_IKU_Department_of_ComputerEngineering ;
    rdfs:comment "Algorithm Efficiency answers: what will this cost as the input grows, and how do we know? It models asymptotic notation, analysis paradigms, algorithm families, input-size measures and the recurrence machinery for deriving bounds. It is software-engineering vocabulary, not ontology-engineering vocabulary — one of the modules that makes this ecosystem apply to systems and not only to their models. A reader comes here to state a complexity claim precisely enough that it can be disputed. Reproduce the class count by counting owl:Class subjects in the current TBox."@en,
        "algorithm-efficiency v1.2.0 MINOR per cohesiveness plan v2.2.0 Sprint C2. Adds subClassOf core:Concept to ae:StructuralConcept."@en,
        "algorithm-efficiency v1.3.0 (MINOR) — adds hasMeasurementSubject annotations on 45 measurement methodology + classification classes per the AlgorithmicStructureMeasurementSubject taxonomy (oe-measurement v2.5.0). Also fixes DRIFT-19: changed publicationYear/yearIntroduced rdfs:range from xsd:gYear to xsd:string per BP-D18. Pure additive annotations; no breaking changes."@en,
        "algorithm_efficiency_tbox v1.3.1 (PATCH) per v17.26.0 Option N — added rdfs:domain to 3 previously-orphaned datatype properties based on empirical ABox usage inference. Additive content per BP-D7 PATCH semantics."@en,
        "algorithm_efficiency_tbox v1.3.2 (PATCH) per v17.27.0 Challenge 2 — added rdfs:domain to 6 orphaned datatype properties via design-intent extraction from skos:definition."@en,
        "algorithm_efficiency_tbox v1.3.3 (PATCH) per v17.28.0 industrial-hardening — added CC BY 4.0 license, copyright, publisher/rightsHolder (IKÜ Computer Engineering), PROV-O wasGeneratedBy + wasAttributedTo (the method author). Additive ontology metadata only — no semantic changes."@en,
        "v1.4.0 (2026-10-06, MINOR): every named subject now carries dcterms:isPartOf <http://example.org/ae> (its module), the first step of the consolidation of this package's files into one file per role. No term, label or definition changed."@en ;
    owl:imports <http://example.org/measurement> ;
    owl:priorVersion <http://example.org/ae/1.1.0>,
        <http://example.org/ae/1.2.0>,
        <http://example.org/ae/1.3.0>,
        <http://example.org/ae/1.3.1>,
        <http://example.org/ae/1.3.2>,
        <http://example.org/ae/1.3.3>,
        <http://example.org/ae/v1.0.0> ;
    owl:versionIRI <http://example.org/ae/1.4.0> ;
    owl:versionInfo "1.4.0" ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor ;
    prov:wasGeneratedBy oe-prov:Activity_OEPackRelease_v17_28_0 ;
    prov:wasRevisionOf <http://example.org/algorithm-efficiency/1.4.0> .

<http://example.org/reliability> dcterms:created "2026-05-16T00:00:00"^^xsd:dateTime ;
    dcterms:creator oe-prov:Agent_MethodAuthor,
        "the method author"@en ;
    dcterms:identifier "reliability" ;
    dcterms:isPartOf <http://example.org/oemethod> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-07T00:00:00"^^xsd:dateTime ;
    dcterms:provenance "Prior rdfs:comment, retained: reliability PATCH v7.0.1. Sprint F1 ghost-reference cleanup: 1 dangling class references redirected to canonical homes; 0 dangling subClassOf claims dropped per L-47 (cross-subject methodological-vs-subsumption discipline). Per BP-D4/D5 gates: HermiT PASS, SHACL no new violations."@en ;
    dcterms:publisher oe-prov:Org_IKU_Department_of_ComputerEngineering ;
    dcterms:rights "Copyright (c) 2025-2026 a university & the method author. Licensed under CC BY 4.0."@en ;
    dcterms:rightsHolder oe-prov:Org_IKU_Department_of_ComputerEngineering ;
    rdfs:comment "Reliability answers: how does this system fail, and would we notice? It holds failure modes, blind spots, verification modalities and degradation factors — and, unusually, the failure modes of the ENGINEERING PROCESS itself, including those specific to memoryless agents: parallel sessions forking a lineage, content from one session treated as another's, provenance asserted rather than derived, verification that cannot fail. A reader comes here to name a failure they have observed but cannot yet describe, and to find what would have detected it. Reproduce any figure with: python3 -c \"import rdflib;g=rdflib.Graph();g.parse('reliability_tbox_*.ttl');print(len(set(g.subjects())))\"."@en,
        "reliability TBox v7.7.2 (PATCH) per v17.31.0 item #1 — removed redundant re-declaration of core:SeverityLevel (which carried an accidental rdfs:subClassOf self-loop). Class is now solely defined in core_tbox. Per L-52 (new): foreign-namespace classes must NOT be re-declared."@en,
        "reliability v4.0.0 (MAJOR from v3.1.0): removed all owl:equivalentClass axioms (20 total in TBox). Per user rule 2026-05-14 'use the ORIGINAL class.' Deleted 19 duplicate class declarations (18 quality-dimension duplicates of OQC + reliability:SeverityLevel duplicate of core). Converted reliability:Postmortem ≡ kb:RetrospectiveMeeting to rdfs:subClassOf per BP-D19 (related-but-distinct: Postmortem is a failure-focused specialization of RetrospectiveMeeting). Consumers using reliability:Reliability etc. should migrate to quality:Reliability."@en,
        "reliability v5.0.0 (MAJOR) per cohesiveness plan v2.2.0 Sprint B2. Removed 65 testing class declarations + 14 testing-related property declarations (all migrated to sto v1.1.0 in Sprint B1). Re-parented 4 classes that were under deleted testing umbrellas: RetrievalAugmentedGeneration → MitigationStrategy (architectural grounding); GraphRAG stays subClassOf RetrievalAugmentedGeneration; KnowledgeGraphIntegration → MitigationStrategy (grounding/mitigation); LightweightHallucinationDetector → DetectionMechanism (detector tool). Per BP-D14: provenance for moved classes in sto v1.1.0 (dcterms:source, prov:wasDerivedFrom). a reliability ontology consumer migration required for any code/data referencing the deleted reliability:* testing IRIs — these now live at testing:* with the same local names."@en,
        "reliability v5.1.0 MINOR per cohesiveness plan v2.2.0 Sprint C2. Adds subClassOf core:Concept to reliability:ReliabilityConcept. Pre-existing parent reliability:Concept preserved (note: reliability:Concept itself gets renamed to ReliabilityDomainConcept in Sprint C3)."@en,
        "reliability v5.1.1 PATCH per cohesiveness plan v2.2.0 Sprint C3. Adds subClassOf core:Concept to reliability:Concept. Per BP-D2 + L-40: chose option β' (link-only, rename-free) over plan-stated option β (rename to ReliabilityDomainConcept). Rationale: option β' achieves the same cohesiveness goal (reliability:Concept properly nested under the true cross-subject umbrella core:Concept) with zero IRI migration cost. reliability:Concept retains its reliability-internal organizing role for its 34 children; the only structural change is gaining core:Concept as an additional parent. PATCH justified by additive-only edit."@en,
        "reliability v6.0.0 MAJOR per cohesiveness plan v2.2.0 Sprint A2. Deleted 15 risk-class duplicates: FailureMode, FailureEffect, Hazard, Risk, RiskAssessment, RiskRegister, MitigationConcept, BusinessImpact, FinancialImpact, OperationalImpact, RegulatoryImpact, ReputationalImpact, CustomerImpact, FailureRate, ActionPriority. Per BP-D19 + L-40: linked 2 reliability classes with native children to risk: equivalents: reliability:MitigationStrategy subClassOf risk:MitigationStrategy (preserves 18 reliability-specific mitigation children); reliability:FailureType subClassOf risk:FailureType (preserves 5 reliability-specific failure-type children). a reliability ontology consumer migration required: any reference to the 15 deleted reliability:* IRIs now lives at risk:* with the same local name."@en,
        "reliability v7.0.0 (MAJOR) per Track D. (a) Renamed reliability:MitigationStrategy → reliability:FailureMitigation; subClassOf core:Mitigation added (SIBLING of risk:RiskMitigation per user challenge — failures are not subClassOf risks); preserved subClassOf core:Process; removed lexical link to risk:MitigationStrategy. (b) Repointed 18 TBox children. (c) Re-typed 16 ABox individuals from old class to new. (d) Removed A2 lexical-error link reliability:FailureType subClassOf risk:FailureType (was asserted on name-match in A2; per L-47 the two classes are semantically distinct lineages). a reliability ontology consumer migration required: any IRI reference to reliability:MitigationStrategy must update to reliability:FailureMitigation."@en,
        "reliability v7.1.0 (MINOR) — Sprint F4 property declarations. Declared 6 properties: measuresAttribute, measures, asOfRelease, measuredAt, mechanismType, detectionImplementation. Per L-47v2: each with skos:definition. Domain/range inferred from raw ABox usage patterns per BP-D2. Per BP-D18: removed rdfs:range xsd:string from mechanismType and detectionImplementation (their values are lang-tagged literals; rdfs:range xsd:string causes HermiT inconsistency)."@en,
        "reliability v7.15.1 (2026-10-07, PATCH): The has severity property carries one definition (it had three: a drift incident's level, a failure or fault's level, and a business-interpretable technical level; the single wording covers the three classes its domain names), and Fault Tolerance carries the ISO wording that its cited source gives (the longer paraphrase is withdrawn). No term, label or class changed; only the wording of definitions."@en,
        "reliability v7.2.0 (MINOR) — Sprint F5 MeasurementSnapshot declaration. Heals 4 ABox type assertions and 2 property-domain references."@en,
        "reliability v7.3.0 (MINOR) — Sprint F5 ReferenceIntegrityGate declaration."@en,
        "reliability v7.4.0 (MINOR) — adds hasMeasurementSubject annotations on 30 LLM-reliability metric classes (→ LLMMeasurementSubject) and 3 engineering-reliability classes MTBF/MTTF/MTTR (→ OperationalEnvironmentMeasurementSubject). Pure additive — no IRI changes; no class removals; existing consumers unaffected. Per user-established policy 2026-05-15: subjects retain their classes but gain explicit subject-of-measurement categorization via oe-measurement v2.4.0."@en,
        "reliability v7.5.0 (MINOR) — DRIFT-19 fix on redo:oscillationWindow (xsd:duration → xsd:dateTime per BP-D18). a reliability ontology C7+ allowlist extended via owl:imports in redo-c7-split. Per L-20: 55 cross-vocabulary mitigates findings demoted to sh:Warning advisory tier."@en,
        "reliability v7.6.0 (MINOR) per L' — Reliability SHACL remediation. Fix 1: demoted 1 mitigates-FailureConcept shapes to sh:Warning per L-20 (continues v17.22.0 J). Fix 2: added rdfs:label on 0 Outcome individuals. Fix 3: added dcterms:source on 0 a reliability ontology classes. Fix 4: added skos:definition on 0 DetectionMechanism. Fix 5: added :detectedBy on 0 Drift incidents. Fix 6: added redo:performedBy on 0 a reliability ontology Process individuals. Additive content + compatibility-broadening shape demotions — no breaking IRI changes."@en,
        "reliability_tbox v7.6.1 (PATCH) per v17.27.0 Challenge 2 — added rdfs:domain to 7 orphaned datatype properties via design-intent extraction from skos:definition."@en,
        "reliability_tbox v7.6.2 (PATCH) per v17.28.0 industrial-hardening — added CC BY 4.0 license, copyright, publisher/rightsHolder (IKÜ Computer Engineering), PROV-O wasGeneratedBy + wasAttributedTo (the method author). Additive ontology metadata only — no semantic changes."@en,
        "v7.14.0 (2026-10-05): receives the nine property declarations (hasSeverity, oscillationWindow, oscillatingVersions, recomputedCount, reportedCount, validationScope, verbatimUserTurn, foreignSessionURI, inferenceProfile) that were declared inside the two SHACL files, and hands the five example individuals to reliability_abox v7.9.0 (BP-D53). No triple was added or removed except one: the SHACL file for a reliability ontology still declared oscillationWindow with range xsd:duration beside the corrected xsd:dateTime (the DRIFT-19 fix recorded in this file), so that stale range is not carried over."@en,
        "v7.15.0 (2026-10-06, MINOR): every named subject now carries dcterms:isPartOf <http://example.org/reliability> (its module), the first step of the consolidation of this package's files into one file per role. No term, label or definition changed."@en ;
