    skos:definition "Validates complete workflow from requirements through deployment."@en .

<http://example.org/ai4se#VQ02_NoUnsatisfiableClasses> a ns1:VerificationQuery ;
    rdfs:label "VQ02: Check for Unsatisfiable Classes"@en ;
    ns1:expectedResult "Empty result set"@en ;
    ns1:query """
    PREFIX owl: <http://www.w3.org/2002/07/owl#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    
    SELECT ?class WHERE {
        ?class a owl:Class .
        ?class rdfs:subClassOf owl:Nothing .
    }
    """@en ;
    dcterms:isPartOf <http://example.org/ai4se> .

<http://example.org/ai4se#VQ03_AIToolCategories> a ns1:VerificationQuery ;
    rdfs:label "VQ03: AI Tool Categories Query"@en ;
    ns1:expectedResult "count >= 20"@en ;
    ns1:query """
    PREFIX ai4se: <http://example.org/ai4se#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    
    SELECT (COUNT(DISTINCT ?toolType) AS ?count) WHERE {
        ?toolType rdfs:subClassOf+ ai4se:AIEnhancedTool .
    }
    """@en ;
    dcterms:isPartOf <http://example.org/ai4se> .

