<http://example.org/ai4se#VQ11_RequirementsCoverage> a ns1:VerificationQuery ;
    rdfs:label "VQ11: Requirements Coverage Query"@en ;
    ns1:expectedResult "coverage = 100.0"@en ;
    ns1:query """
    PREFIX : <http://example.org/ontology-engineering#>
    
    SELECT (COUNT(?fr) AS ?totalFRs) 
           (COUNT(?frWithCQ) AS ?coveredFRs)
           ((xsd:decimal(?coveredFRs) / xsd:decimal(?totalFRs)) * 100 AS ?coverage)
    WHERE {
        ?fr a :FunctionalRequirement .
        OPTIONAL {
            ?fr :hasCompetencyQuestion ?cq .
            BIND(?fr AS ?frWithCQ)
        }
    }
    """@en ;
    dcterms:isPartOf <http://example.org/ai4se> .

<http://example.org/ai4se#VQ12_CQCoverage> a ns1:VerificationQuery ;
    rdfs:label "VQ12: Competency Question Coverage Query"@en ;
    ns1:expectedResult "coverage = 100.0"@en ;
    ns1:query """
    PREFIX : <http://example.org/ontology-engineering#>
    
    SELECT (COUNT(?cq) AS ?totalCQs)
           (COUNT(?cqWithVQ) AS ?coveredCQs)
           ((xsd:decimal(?coveredCQs) / xsd:decimal(?totalCQs)) * 100 AS ?coverage)
    WHERE {
        ?cq a :CompetencyQuestion .
        OPTIONAL {
            ?cq :hasVerificationQuery ?vq .
            BIND(?cq AS ?cqWithVQ)
        }
    }
    """@en ;
    dcterms:isPartOf <http://example.org/ai4se> .

<http://example.org/ai4se#VQ13_PropertyDomainRange> a ns1:VerificationQuery ;
    rdfs:label "VQ13: Property Domain/Range Query"@en ;
    ns1:expectedResult "domainCoverage >= 95.0 AND rangeCoverage >= 95.0"@en ;
    ns1:query """
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    PREFIX owl: <http://www.w3.org/2002/07/owl#>
    
    SELECT (COUNT(?prop) AS ?totalProps)
           (COUNT(?propWithDomain) AS ?propsWithDomain)
           (COUNT(?propWithRange) AS ?propsWithRange)
           ((xsd:decimal(?propsWithDomain) / xsd:decimal(?totalProps)) * 100 AS ?domainCoverage)
           ((xsd:decimal(?propWithRange) / xsd:decimal(?totalProps)) * 100 AS ?rangeCoverage)
    WHERE {
        VALUES ?propType { owl:ObjectProperty owl:DatatypeProperty }
        ?prop a ?propType .
        OPTIONAL {
            ?prop rdfs:domain ?d .
            BIND(?prop AS ?propWithDomain)
        }
        OPTIONAL {
            ?prop rdfs:range ?r .
            BIND(?prop AS ?propWithRange)
        }
    }
    """@en ;
    dcterms:isPartOf <http://example.org/ai4se> .

<http://example.org/ai4se#VQ14_CardinalityConstraints> a ns1:VerificationQuery ;
    rdfs:label "VQ14: Cardinality Constraints Query"@en ;
    ns1:expectedResult "cardinalityCount >= 30"@en ;
    ns1:query """
    PREFIX owl: <http://www.w3.org/2002/07/owl#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    
    SELECT (COUNT(?restriction) AS ?cardinalityCount)
    WHERE {
        ?class a owl:Class .
        ?class rdfs:subClassOf ?restriction .
        ?restriction a owl:Restriction .
        {
            ?restriction owl:minCardinality ?min
        } UNION {
            ?restriction owl:maxCardinality ?max
        } UNION {
            ?restriction owl:cardinality ?exact
        } UNION {
            ?restriction owl:minQualifiedCardinality ?qmin
        } UNION {
            ?restriction owl:maxQualifiedCardinality ?qmax
        }
    }
    """@en ;
    dcterms:isPartOf <http://example.org/ai4se> .

<http://example.org/ai4se#VQ15_DisjointnessAxioms> a ns1:VerificationQuery ;
    rdfs:label "VQ15: Disjointness Axioms Query"@en ;
    ns1:expectedResult "disjointnessCount >= 15"@en ;
    ns1:query """
    PREFIX owl: <http://www.w3.org/2002/07/owl#>
    
    SELECT (COUNT(?axiom) AS ?disjointnessCount)
    WHERE {
        {
            ?class1 owl:disjointWith ?class2
        } UNION {
            ?axiom a owl:AllDisjointClasses ;
                   owl:members ?list
        }
        BIND(?axiom AS ?axiom)
    }
    """@en ;
    dcterms:isPartOf <http://example.org/ai4se> .

<http://example.org/ai4se#VQ16_PropertyChains> a ns1:VerificationQuery ;
    rdfs:label "VQ16: Property Chains Query"@en ;
    ns1:expectedResult "chainCount >= 20"@en ;
    ns1:query """
    PREFIX owl: <http://www.w3.org/2002/07/owl#>
    
    SELECT (COUNT(?prop) AS ?chainCount)
    WHERE {
        ?prop owl:propertyChainAxiom ?chain
    }
    """@en ;
    dcterms:isPartOf <http://example.org/ai4se> .

<http://example.org/ai4se#VQ17_HierarchyDepth> a ns1:VerificationQuery ;
    rdfs:label "VQ17: Class Hierarchy Depth Query"@en ;
    ns1:expectedResult "avgDepth >= 3.0 AND avgDepth <= 5.0"@en ;
    ns1:query """
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    PREFIX owl: <http://www.w3.org/2002/07/owl#>
    
    SELECT (AVG(?depth) AS ?avgDepth) (MAX(?depth) AS ?maxDepth)
    WHERE {
        SELECT ?class (COUNT(?ancestor) AS ?depth)
        WHERE {
            ?class a owl:Class .
            OPTIONAL { ?class rdfs:subClassOf+ ?ancestor }
        }
        GROUP BY ?class
    }
    """@en ;
    dcterms:isPartOf <http://example.org/ai4se> .

<http://example.org/ai4se#VQ18_TermMappings> a ns1:VerificationQuery ;
    rdfs:label "VQ18: Term Mappings Query"@en ;
    ns1:expectedResult "coverage = 100.0"@en ;
    ns1:query """
    PREFIX : <http://example.org/ontology-engineering#>
    
    SELECT (COUNT(?term) AS ?totalTerms)
           (COUNT(?mappedTerm) AS ?mappedTerms)
           ((xsd:decimal(?mappedTerms) / xsd:decimal(?totalTerms)) * 100 AS ?coverage)
    WHERE {
        ?term a :TermDefinition .
        OPTIONAL {
            ?term :mapsDomainTermTo ?component .
            BIND(?term AS ?mappedTerm)
        }
    }
    """@en ;
    dcterms:isPartOf <http://example.org/ai4se> .

<http://example.org/ai4se#VQ19_LabelCoverage> a ns1:VerificationQuery ;
    rdfs:label "VQ19: Label Coverage Query"@en ;
    ns1:expectedResult "coverage = 100.0"@en ;
    ns1:query """
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    PREFIX owl: <http://www.w3.org/2002/07/owl#>
    
    SELECT (COUNT(?entity) AS ?totalEntities)
           (COUNT(?labeled) AS ?labeledEntities)
           ((xsd:decimal(?labeledEntities) / xsd:decimal(?totalEntities)) * 100 AS ?coverage)
    WHERE {
        VALUES ?type { owl:Class owl:ObjectProperty owl:DatatypeProperty }
        ?entity a ?type .
        OPTIONAL {
            ?entity rdfs:label ?label .
            BIND(?entity AS ?labeled)
        }
    }
    """@en ;
    dcterms:isPartOf <http://example.org/ai4se> .

<http://example.org/ai4se#VQ20_DefinitionCoverage> a ns1:VerificationQuery ;
    rdfs:label "VQ20: Definition Coverage Query"@en ;
    ns1:expectedResult "coverage >= 95.0"@en ;
    ns1:query """
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    PREFIX owl: <http://www.w3.org/2002/07/owl#>
    
    SELECT (COUNT(?class) AS ?totalClasses)
           (COUNT(?defined) AS ?definedClasses)
           ((xsd:decimal(?definedClasses) / xsd:decimal(?totalClasses)) * 100 AS ?coverage)
    WHERE {
        ?class a owl:Class .
        OPTIONAL {
            {
                ?class rdfs:comment ?comment
            } UNION {
                ?class skos:definition ?def
            }
            BIND(?class AS ?defined)
        }
    }
    """@en ;
    dcterms:isPartOf <http://example.org/ai4se> .

<http://example.org/ai4se#VQ21_ExampleCoverage> a ns1:VerificationQuery ;
    rdfs:label "VQ21: Example Coverage Query"@en ;
    ns1:expectedResult "coverage >= 80.0"@en ;
    ns1:query """
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    PREFIX owl: <http://www.w3.org/2002/07/owl#>
    
    SELECT (COUNT(?class) AS ?totalClasses)
           (COUNT(?withExample) AS ?classesWithExamples)
           ((xsd:decimal(?classesWithExamples) / xsd:decimal(?totalClasses)) * 100 AS ?coverage)
    WHERE {
        ?class a owl:Class .
        OPTIONAL {
            ?class skos:example ?example .
            BIND(?class AS ?withExample)
        }
    }
    """@en ;
    dcterms:isPartOf <http://example.org/ai4se> .

ns3:TC_CoreConcepts a ns1:TestCase ;
    rdfs:label "Core Concepts Test"@en ;
    ns1:expectedResult true ;
    ns1:hasTestQuery """
        ASK WHERE {
            ai4se:AI4SESSystem rdfs:subClassOf ai:ArtificialIntelligenceSystem .
            ai4se:AI4SESSystem rdfs:subClassOf o4se:SoftwareSystem .
            ai4se:AIEnhancedProcess rdfs:subClassOf o4se:SoftwareProcess .
            ?pattern rdfs:subClassOf ai4se:IntegrationPattern .
        }
    """ ;
    dcterms:isPartOf <http://www.semanticweb.org/ontologies/2025/AI4SE/QualityAssurance> ;
    rdfs:comment "Tests core AI4SE concept definitions"@en .

ns3:TC_LifecycleCoverage a ns1:TestCase ;
    rdfs:label "Lifecycle Coverage Test"@en ;
    ns1:expectedResult true ;
    ns1:hasTestQuery """
        ASK WHERE {
            ?req rdfs:subClassOf ai4se:IntelligentRequirementsEngineering .
            ?des rdfs:subClassOf ai4se:AIAssistedDesign .
            ?cod rdfs:subClassOf ai4se:AutomatedCoding .
            ?test rdfs:subClassOf ai4se:IntelligentTesting .
            ?dep rdfs:subClassOf ai4se:DeploymentIntelligence .
            ?main rdfs:subClassOf ai4se:MaintenanceIntelligence .
        }
    """ ;
    dcterms:isPartOf <http://www.semanticweb.org/ontologies/2025/AI4SE/QualityAssurance> ;
    rdfs:comment "Tests complete SDLC coverage with AI"@en .

ns3:TC_PhaseTransition a ns1:TestCase ;
    rdfs:label "Phase Transition Test"@en ;
    ns1:expectedResult true ;
    ns1:hasTestQuery """
        ASK WHERE {
            ai4se:transitionsTo rdf:type owl:ObjectProperty .
            ai4se:transitionsTo rdf:type owl:TransitiveProperty .
            ai4se:feedsInto rdfs:domain ai4se:AI4SESSystem .
            ai4se:feedsInto rdfs:range ai4se:AI4SESSystem .
        }
    """ ;
    dcterms:isPartOf <http://www.semanticweb.org/ontologies/2025/AI4SE/QualityAssurance> ;
    rdfs:comment "Tests lifecycle phase transitions"@en .

ns3:TC_PracticeMetrics a ns1:TestCase ;
    rdfs:label "Practice Metrics Test"@en ;
    ns1:expectedResult true ;
    ns1:hasTestQuery """
        ASK WHERE {
            ai4se:practiceEffectiveness rdf:type owl:DatatypeProperty .
            ai4se:practiceAdoptionRate rdf:type owl:DatatypeProperty .
            ai4se:practiceMaturityLevel rdfs:range xsd:integer .
        }
    """ ;
    dcterms:isPartOf <http://www.semanticweb.org/ontologies/2025/AI4SE/QualityAssurance> ;
    rdfs:comment "Tests practice effectiveness metrics"@en .

ns3:TC_QualityDimensions a ns1:TestCase ;
    rdfs:label "Quality Dimensions Test"@en ;
    ns1:expectedResult 8 ;
    ns1:hasTestQuery """
        SELECT (COUNT(?dim) as ?count) WHERE {
            ?dim rdfs:subClassOf qc:QualityDimension .
            ?assessment qc:measuresCriterion ?dim .
            ?assessment qc:hasScore ?score .
            FILTER(?score >= 98)
        }
    """ ;
    dcterms:isPartOf <http://www.semanticweb.org/ontologies/2025/AI4SE/QualityAssurance> ;
    rdfs:comment "Tests all quality dimensions defined"@en .

ns3:TC_Scalability a ns1:TestCase ;
    rdfs:label "Scalability Test"@en ;
    ns1:expectedResult true ;
    ns1:hasTestQuery """
        ASK WHERE {
            ai4se:computeCapacity rdfs:domain ai4se:AIInfrastructure .
            ai4se:storageCapacity rdfs:domain ai4se:DataInfrastructure .
            ai4se:maxConcurrentUsers rdfs:range xsd:integer .
        }
    """ ;
    dcterms:isPartOf <http://www.semanticweb.org/ontologies/2025/AI4SE/QualityAssurance> ;
    rdfs:comment "Tests infrastructure scalability"@en .

v5:Kubernetes a :Tool,
        owl:NamedIndividual ;
    rdfs:label "Kubernetes"@en ;
    dcterms:isPartOf <http://ai4se.org/ontology/v5/module/ReferencedButUndefined> ;
    rdfs:comment "Stub declared by the package build: the source files use this term but never define it. The label is derived mechanically from the identifier."@en .

<http://example.org/ai4se#CQ01_WhatIsOntologyPurpose> a ns1:CompetencyQuestion ;
    rdfs:label "CQ01: What is the purpose and scope of the ontology?"@en ;
    ns1:expectedAnswer "AI for Software Engineering - Complete Enhanced Ontology covering AI tools, agentic systems, and enterprise adoption."@en ;
    ns1:hasVerificationQuery <http://example.org/ai4se#VQ01_OntologyDeclaration> ;
    ns1:questionText "What is the purpose and scope of the AI4SE ontology?"@en ;
    dcterms:isPartOf <http://example.org/ai4se> .

<http://example.org/ai4se#Term_AgenticSystem> a ns1:TermDefinition ;
    rdfs:label "Agentic System"@en ;
    ns1:hasRelatedTerm <http://example.org/ai4se#Term_AIEnhancedTool>,
        <http://example.org/ai4se#Term_AgentOrchestrator>,
        <http://example.org/ai4se#Term_MultiAgentSystem> ;
    ns1:mapsDomainTermTo <http://example.org/ai4se#AgenticSystem> ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:altLabel "AI Agent System"@en,
        "Autonomous Agent System"@en ;
    skos:definition """
    An autonomous or semi-autonomous AI system that can perceive its environment
    (codebase, requirements, test results), make decisions, take actions (write code,
    run tests, commit changes), and learn from outcomes to achieve software
    engineering goals.
    """@en ;
    skos:example """
    Examples: Devin (autonomous software engineer), AutoGPT for coding,
    GitHub Copilot Workspace, Cursor AI
    
    Usage: An agentic system receives a feature request, analyzes the codebase,
    designs the solution, implements code, writes tests, debugs issues, and
    creates a pull request - all with minimal human intervention.
    """@en ;
    skos:prefLabel "Agentic Software Engineering System"@en ;
    skos:scopeNote """
    Agentic systems represent the evolution from passive AI assistants to active
    collaborators. They exhibit goal-directed behavior, can decompose complex tasks,
    coordinate multiple subtasks, and adapt strategies based on feedback.
    Key characteristics: autonomy, reactivity, proactivity, social ability.
    """@en .

<http://example.org/ai4se#Term_CodeReviewTool> a ns1:TermDefinition ;
    rdfs:label "Code Review Tool"@en ;
    ns1:hasRelatedTerm <http://example.org/ai4se#Term_AIEnhancedTool>,
        <http://example.org/ai4se#Term_CodeGenerationTool> ;
    ns1:mapsDomainTermTo <http://example.org/ai4se#CodeReviewTool> ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:altLabel "Automated Code Reviewer"@en,
        "Intelligent Code Analyzer"@en ;
    skos:definition """
    An AI-enhanced tool that automatically analyzes source code to identify bugs,
    security vulnerabilities, code smells, performance issues, and style violations.
    Provides intelligent suggestions for improvements.
    """@en ;
    skos:example """
    Examples: DeepCode, CodeGuru, Snyk Code, SonarQube with ML, Codacy
    
    Usage: Tool reviews pull requests automatically, flags potential SQL injection
    vulnerabilities, suggests performance optimizations, and checks adherence to
    coding standards.
    """@en ;
    skos:prefLabel "AI-Powered Code Review Tool"@en ;
    skos:scopeNote """
    Modern code review tools use machine learning to learn from historical code
    reviews, understand project-specific patterns, and prioritize issues by
    severity and likelihood of being actual problems.
    """@en .

<http://example.org/ai4se#Term_KPIDashboard> a ns1:TermDefinition ;
    rdfs:label "KPI Dashboard"@en ;
    ns1:hasRelatedTerm <http://example.org/ai4se#Term_MaturityAssessment>,
        <http://example.org/ai4se#Term_PerformanceIndicator> ;
    ns1:mapsDomainTermTo <http://example.org/ai4se/performance#KPIDashboard> ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:altLabel "Metrics Dashboard"@en,
        "Performance Dashboard"@en ;
    skos:definition """
    A visual interface displaying key performance indicators for AI adoption initiatives,
    providing real-time or near-real-time visibility into adoption progress, impact
    metrics, and areas requiring attention.
    """@en ;
    skos:prefLabel "Key Performance Indicator Dashboard"@en ;
    skos:scopeNote """
    Effective dashboards provide actionable insights, not just data. Design for
    different audiences (executives, managers, practitioners). Use appropriate
    visualizations (trends, comparisons, distributions). Enable self-service
    analytics. Integrate with existing business intelligence tools.
    """@en .

<http://example.org/ai4se#Term_ModelFineTuning> a ns1:TermDefinition ;
    rdfs:label "Model Fine-Tuning"@en ;
    ns1:hasRelatedTerm <http://example.org/ai4se#Term_ModelTraining>,
        <http://example.org/ai4se#Term_SupervisedTraining> ;
    ns1:mapsDomainTermTo <http://example.org/ai4se#ModelFineTuning> ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:altLabel "Model Adaptation"@en,
        "Transfer Learning"@en ;
    skos:definition """
    The process of adapting a pre-trained machine learning model to a specific
    software engineering task or codebase by training on domain-specific or
    project-specific data. Leverages transfer learning to achieve better performance
    with less data and computational resources.
    """@en ;
    skos:example """
    Fine-tuning for company-specific code style:
    1. Start with pre-trained code model (e.g., CodeBERT, GPT-based model)
    2. Collect company's internal codebase
    3. Fine-tune on company-specific patterns and conventions
    4. Validate that model follows company standards
    5. Deploy for internal use
    
    Result: Model generates code matching company's style and practices.
    """@en ;
    skos:prefLabel "Model Fine-Tuning Process"@en ;
    skos:scopeNote """
    Fine-tuning is more efficient than training from scratch. It preserves general
    programming knowledge while adapting to specific requirements. Common fine-tuning
    strategies: full fine-tuning, adapter layers, prompt tuning, LoRA (Low-Rank
    Adaptation).
    """@en .

<http://example.org/ai4se#Term_ReinforcementLearning> a ns1:TermDefinition ;
    rdfs:label "Reinforcement Learning"@en ;
    ns1:hasRelatedTerm <http://example.org/ai4se#Term_ModelTraining>,
        <http://example.org/ai4se#Term_SupervisedTraining>,
        <http://example.org/ai4se#Term_UnsupervisedTraining> ;
    ns1:mapsDomainTermTo <http://example.org/ai4se#ReinforcementTraining> ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:altLabel "RL"@en,
        "Reward-Based Learning"@en ;
    skos:definition """
    A machine learning paradigm where an agent learns to make decisions by interacting
    with an environment and receiving rewards or penalties for its actions. The agent
    learns to maximize cumulative reward over time.
    """@en ;
    skos:example """
    RL for code optimization:
    - Agent: Code optimizer
    - Environment: Codebase and test suite
    - Actions: Code transformations (refactoring, optimizations)
    - Reward: Performance improvements, passing tests
    - Agent learns which transformations lead to better code
    
    RL for automated debugging:
    - Agent explores potential bug fixes
    - Receives reward when tests pass
    - Learns debugging strategies through trial and error
    """@en ;
    skos:prefLabel "Reinforcement Learning Training"@en ;
    skos:scopeNote """
    Reinforcement learning is particularly useful for sequential decision-making
    problems in software engineering. Challenges include defining appropriate reward
    functions, managing large action spaces, and ensuring safe exploration.
    RLHF (Reinforcement Learning from Human Feedback) is commonly used for
    aligning AI code assistants with human preferences.
    """@en .

<http://example.org/ai4se#VQ01_OntologyDeclaration> a ns1:VerificationQuery ;
    rdfs:label "VQ01: Ontology Declaration Query"@en ;
    ns1:expectedResult true ;
    ns1:query """
    PREFIX owl: <http://www.w3.org/2002/07/owl#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    
    ASK {
        ?ont a owl:Ontology ;
             dcterms:title ?title ;
             dcterms:description ?desc ;
             owl:versionInfo ?version ;
             dcterms:created ?created .
    }
    """@en ;
    dcterms:isPartOf <http://example.org/ai4se> .

<http://example.org/ai4se#Version_5_0_0> a ns1:MajorVersion ;
    rdfs:label "AI4SE Version 5.0.0"@en ;
    ns1:backwardCompatibleWith <http://example.org/ai4se#Version_4_0_0> ;
    ns1:hasMigrationStrategy <http://example.org/ai4se#MigrationStrategy_4_to_5> ;
    ns1:majorVersion 5 ;
    ns1:minorVersion 0 ;
    ns1:patchVersion 0 ;
    ns1:releaseDate "2025-10-31"^^xsd:date ;
    ns1:releaseType "Major Release - Quality Excellence"@en ;
    ns1:versionNumber "5.0.0"^^xsd:string ;
    dcterms:description """
    Version 5.0.0 represents the quality excellence milestone, achieving:
    - 100/100 Correctness through complete test coverage
    - 100/100 Completeness through comprehensive domain coverage
    - 100/100 Consistency through rigorous logical axiomatization
    - 98-99/100 on all other quality dimensions
    """@en ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:definition "Major release achieving maximum quality scores through comprehensive enhancements in logical consistency, testing, documentation, and domain coverage."@en ;
    skos:prefLabel "Version 5.0.0 - Complete Quality Enhancement"@en .

ns3:TC_MethodologyCoverage a ns1:TestCase ;
    rdfs:label "Methodology Coverage Test"@en ;
    ns1:expectedResult true ;
    ns1:hasTestQuery """
        ASK WHERE {
            ?agile rdfs:subClassOf ai4se:IntelligentAgileSystem .
            ?devops rdfs:subClassOf ai4se:IntelligentDevOpsSystem .
            ?quality rdfs:subClassOf ai4se:QualityIntelligenceSystem .
            ?project rdfs:subClassOf ai4se:ProjectIntelligenceSystem .
        }
    """ ;
    dcterms:isPartOf <http://www.semanticweb.org/ontologies/2025/AI4SE/QualityAssurance> ;
    rdfs:comment "Tests coverage of SE methodologies"@en .

ns3:TC_ToolInterop a ns1:TestCase ;
    rdfs:label "Tool Interoperability Test"@en ;
    ns1:expectedResult true ;
    ns1:hasTestQuery """
        ASK WHERE {
            ai4se:integratesWith rdf:type owl:SymmetricProperty .
            ?tool rdfs:subClassOf ai4se:AIPoweredTool .
            ?platform rdfs:subClassOf ai4se:AIDevelopmentPlatform .
        }
    """ ;
    dcterms:isPartOf <http://www.semanticweb.org/ontologies/2025/AI4SE/QualityAssurance> ;
    rdfs:comment "Tests tool integration capabilities"@en .

<http://example.org/ai4se#Term_AIAdoptionProject> a ns1:TermDefinition ;
    rdfs:label "AI Adoption Project"@en ;
    ns1:hasRelatedTerm <http://example.org/ai4se#Term_AIPortfolio>,
        <http://example.org/ai4se#Term_AITransformationStrategy> ;
    ns1:mapsDomainTermTo <http://example.org/ai4se/portfolio#AIAdoptionProject> ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:altLabel "AI Implementation Project"@en ;
    skos:definition """
    A time-bound initiative with defined objectives, scope, and resources focused on
    adopting specific AI technologies or capabilities into software engineering
    practices. Includes planning, implementation, validation, and measurement phases.
    """@en ;
    skos:prefLabel "AI Technology Adoption Project"@en ;
    skos:scopeNote """
    AI adoption projects typically follow phases: assessment, pilot, training,
    rollout, optimization, measurement. Success factors include executive sponsorship,
    change management, training programs, clear metrics, and continuous improvement.
    """@en .

<http://example.org/ai4se#Term_AIAdoptionRisk> a ns1:TermDefinition ;
    rdfs:label "AI Adoption Risk"@en ;
    ns1:hasRelatedTerm <http://example.org/ai4se#Term_OrganizationalRisk>,
        <http://example.org/ai4se#Term_TechnicalRisk> ;
    ns1:mapsDomainTermTo <http://example.org/ai4se/risk#AIAdoptionRisk> ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:altLabel "AI Implementation Risk"@en ;
    skos:definition """
    Potential negative outcomes or challenges associated with adopting AI technologies
    in software engineering. Includes technical risks, organizational risks, security
    risks, compliance risks, and strategic risks.
    """@en ;
    skos:example """
    Example risks:
    
    TECHNICAL RISKS:
    - AI generates incorrect or insecure code
    - Tool integration failures with existing systems
    - Performance degradation in production
    - Model hallucinations or unexpected behaviors
    
    ORGANIZATIONAL RISKS:
    - Developer resistance to AI tools
    - Insufficient training and support
    - Loss of coding skills dependency on AI
    - Cultural challenges in adoption
    
    SECURITY RISKS:
    - Code leakage through AI models
    - Intellectual property exposure
    - Vulnerabilities in generated code
    - Supply chain risks from third-party AI services
    
    COMPLIANCE RISKS:
    - Licensing violations in generated code
    - Regulatory non-compliance (GDPR, etc.)
    - Audit trail gaps
    - Data privacy concerns
    
    STRATEGIC RISKS:
    - Vendor lock-in
    - ROI not achieved
    - Competitive disadvantage if adoption fails
    - Technology obsolescence
    """@en ;
    skos:prefLabel "AI Technology Adoption Risk"@en ;
    skos:scopeNote """
    Effective risk management requires identifying risks early, assessing likelihood
    and impact, developing mitigation strategies, monitoring continuously, and
    maintaining contingency plans. Risk tolerance varies by organization size,
    industry, and strategic importance.
    """@en .

<http://example.org/ai4se#Term_AIGovernancePolicy> a ns1:TermDefinition ;
    rdfs:label "AI Governance Policy"@en ;
    ns1:hasRelatedTerm <http://example.org/ai4se#Term_ComplianceRequirement>,
        <http://example.org/ai4se#Term_GovernanceFramework> ;
    ns1:mapsDomainTermTo <http://example.org/ai4se/governance#AIGovernancePolicy> ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:altLabel "AI Policy"@en ;
    skos:definition """
    A formal documented guideline that defines acceptable and unacceptable practices
    for using AI in software engineering, including usage boundaries, quality
    expectations, security requirements, and compliance obligations.
    """@en ;
    skos:example """
    Example policy: AI Code Generation Usage Policy
    
    PURPOSE:
    Ensure responsible and effective use of AI code generation tools while
    maintaining code quality, security, and compliance.
    
    SCOPE:
    All developers using AI code generation tools (Copilot, ChatGPT, etc.)
    
    REQUIREMENTS:
    
    1. APPROVED USAGE:
       ✓ Code completion and suggestions
       ✓ Documentation generation
       ✓ Test case creation
       ✓ Code refactoring suggestions
       ✓ Bug fix recommendations
    
    2. RESTRICTED USAGE:
       ✗ Critical security components without review
       ✗ Compliance-sensitive code without validation
       ✗ Production deployment without testing
       ✗ Copying code from public sources without license check
    
    3. QUALITY REQUIREMENTS:
       - All AI-generated code must be reviewed by human developer
       - Must pass all automated tests and security scans
       - Must comply with coding standards
       - Must be documented with AI-generation disclosure
    
    4. SECURITY REQUIREMENTS:
       - No proprietary code in prompts to external AI services
       - Sanitize sensitive data before AI processing
       - Use approved enterprise AI tools only
       - Report suspicious AI behaviors
    
    5. COMPLIANCE:
       - Verify licenses of AI-suggested code
       - Maintain audit trail of AI usage
       - Document AI involvement in code reviews
       - Report compliance violations
    
    ENFORCEMENT:
    Violations may result in tool access revocation, retraining requirements,
    or disciplinary action depending on severity.
    """@en ;
    skos:prefLabel "AI Usage Governance Policy"@en ;
    skos:scopeNote """
    Policies should be clear, actionable, and enforceable. Balance prescriptive
    guidance with developer judgment. Update regularly based on experience and
    evolving AI capabilities. Communicate policies widely and ensure understanding
    through training. Monitor compliance through technical controls and audits.
    """@en .

<http://example.org/ai4se#Term_AIPortfolio> a ns1:TermDefinition ;
    rdfs:label "AI Portfolio"@en ;
    ns1:hasRelatedTerm <http://example.org/ai4se#Term_AIAdoptionProject>,
        <http://example.org/ai4se#Term_AITransformationStrategy> ;
    ns1:mapsDomainTermTo <http://example.org/ai4se/portfolio#AIPortfolio> ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:altLabel "AI Project Portfolio"@en,
        "Enterprise AI Portfolio"@en ;
    skos:definition """
    A structured collection of AI adoption projects and initiatives across an
    organization, managed as a cohesive whole to maximize strategic value, balance
    risk, and optimize resource allocation for AI-enhanced software engineering.
    """@en ;
    skos:example """
    Example portfolio structure:
    - Strategic Initiatives (3-5 year horizon):
      * Enterprise AI transformation program
      * Platform modernization with AI
    - Tactical Projects (1-2 year horizon):
      * GitHub Copilot enterprise rollout
      * Automated testing infrastructure
    - Operational Improvements (immediate):
      * Code review automation
      * Documentation generation
    """@en ;
    skos:prefLabel "AI Adoption Portfolio"@en ;
    skos:scopeNote """
    AI portfolio management involves balancing innovation vs. stabilization,
    risk vs. reward, and short-term wins vs. long-term transformation. Requires
    governance structure, prioritization framework, resource allocation model,
    and performance tracking mechanisms.
    """@en .

<http://example.org/ai4se#Term_AITransformationStrategy> a ns1:TermDefinition ;
    rdfs:label "AI Transformation Strategy"@en ;
    ns1:hasRelatedTerm <http://example.org/ai4se#Term_AIAdoptionProject>,
        <http://example.org/ai4se#Term_AIPortfolio>,
        <http://example.org/ai4se#Term_GovernanceFramework> ;
    ns1:mapsDomainTermTo <http://example.org/ai4se/strategy#AITransformationStrategy> ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:altLabel "AI Strategy"@en,
        "Digital Transformation Strategy"@en ;
    skos:definition """
    A comprehensive long-term plan defining how an organization will integrate AI
    into its software engineering practices, culture, and operations to achieve
    strategic objectives. Addresses technology, people, processes, and governance.
    """@en ;
    skos:prefLabel "Enterprise AI Transformation Strategy"@en ;
    skos:scopeNote """
    Effective AI transformation strategy aligns with business strategy, addresses
    organizational readiness, includes change management plan, defines governance
    model, establishes success metrics, and provides implementation roadmap.
    Must balance ambition with pragmatism and manage organizational change.
    """@en .

<http://example.org/ai4se#Term_AgentCoordinator> a ns1:TermDefinition ;
    rdfs:label "Agent Coordinator"@en ;
    ns1:hasRelatedTerm <http://example.org/ai4se#Term_AgentOrchestrator>,
        <http://example.org/ai4se#Term_MultiAgentSystem> ;
    ns1:mapsDomainTermTo <http://example.org/ai4se#AgentCoordinator> ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:altLabel "Agent Communication Manager"@en ;
    skos:definition """
    A specialized component that facilitates communication and collaboration between
    AI agents, ensuring they can share information, synchronize actions, and work
    towards common goals without conflicts.
    """@en ;
    skos:example """
    Coordination mechanisms:
    - Message passing: Agents exchange structured messages about tasks and results
    - Shared memory: Common workspace for sharing context and artifacts
    - Event bus: Publish-subscribe pattern for asynchronous communication
    - Coordination protocols: Rules for managing concurrent access to resources
    """@en ;
    skos:prefLabel "Agent Coordination Component"@en ;
    skos:scopeNote """
    Effective coordination prevents race conditions, ensures consistency, and
    enables efficient collaboration. The coordinator may implement locks, semaphores,
    or more sophisticated protocols like multi-agent reinforcement learning.
    """@en .

<http://example.org/ai4se#Term_CodeCompletionTool> a ns1:TermDefinition ;
    rdfs:label "Code Completion Tool"@en ;
    ns1:hasRelatedTerm <http://example.org/ai4se#Term_AIEnhancedTool>,
        <http://example.org/ai4se#Term_CodeGenerationTool> ;
    ns1:mapsDomainTermTo <http://example.org/ai4se#CodeCompletionTool> ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:altLabel "Autocomplete Tool"@en,
        "Code Suggestion Tool"@en ;
    skos:definition """
    An AI-powered tool that predicts and suggests code completions based on context,
    coding patterns, and learned behaviors from large code repositories. Provides
    real-time suggestions as developers type.
    """@en ;
    skos:example """
    Examples: GitHub Copilot, TabNine, Kite, IntelliCode, CodeWhisperer
    
    Usage: When a developer types 'def calculate_', the tool suggests complete
    function implementations based on naming patterns and codebase context.
    """@en ;
    skos:prefLabel "Intelligent Code Completion Tool"@en ;
    skos:scopeNote """
    Modern code completion tools use transformer-based language models trained on
    billions of lines of code. They understand multiple programming languages,
    frameworks, and coding conventions.
    """@en .

<http://example.org/ai4se#Term_CostBenefitAnalysis> a ns1:TermDefinition ;
    rdfs:label "Cost-Benefit Analysis"@en ;
    ns1:hasRelatedTerm <http://example.org/ai4se#Term_ROIAnalysis>,
        <http://example.org/ai4se#Term_TCOAnalysis> ;
    ns1:mapsDomainTermTo <http://example.org/ai4se/financial#CostBenefitAnalysis> ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:altLabel "Benefit-Cost Analysis"@en,
        "CBA"@en ;
    skos:definition """
    A systematic approach to estimating and comparing the costs and benefits of an
    AI adoption initiative to determine whether it represents a sound investment.
    Considers both quantifiable and qualitative factors.
    """@en ;
    skos:prefLabel "Cost-Benefit Analysis"@en ;
    skos:scopeNote """
    CBA provides structured decision framework. Include discount rate for
    multi-year analysis, sensitivity analysis for uncertain assumptions, and
    risk-adjusted projections. Consider opportunity costs (what else could
    resources fund?). Document assumptions and update analysis periodically.
    """@en .

<http://example.org/ai4se#Term_MaturityAssessment> a ns1:TermDefinition ;
    rdfs:label "Maturity Assessment"@en ;
    ns1:hasRelatedTerm <http://example.org/ai4se#Term_MaturityLevel>,
        <http://example.org/ai4se#Term_PerformanceIndicator> ;
    ns1:mapsDomainTermTo <http://example.org/ai4se/maturity#MaturityAssessment> ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:altLabel "Maturity Evaluation"@en ;
    skos:definition """
    A structured evaluation process that determines an organization's current maturity
    level in AI adoption across multiple dimensions (technology, process, people,
    governance) and identifies gaps and improvement opportunities.
    """@en ;
    skos:example """
    Assessment process:
    
    1. PREPARATION:
       - Define assessment scope and objectives
       - Identify stakeholders and assessment team
       - Select maturity model and criteria
       - Plan assessment schedule
    
    2. DATA COLLECTION:
       - Conduct interviews with stakeholders
       - Review documentation and artifacts
       - Analyze usage metrics and performance data
       - Survey developers and teams
       - Observe practices and workflows
    
    3. ANALYSIS:
       - Score each capability area
       - Identify strengths and weaknesses
       - Benchmark against industry standards
       - Determine overall maturity level
    
    4. REPORTING:
       - Document findings and evidence
       - Provide maturity level determination
       - Identify gaps and risks
       - Recommend improvement actions
       - Prioritize initiatives
    
    5. ACTION PLANNING:
       - Develop improvement roadmap
       - Assign ownership and resources
       - Set targets and timelines
       - Establish review cadence
    """@en ;
    skos:prefLabel "AI Adoption Maturity Assessment"@en ;
    skos:scopeNote """
    Regular maturity assessments (annual or bi-annual) track progress and guide
    investment decisions. Involve diverse stakeholders for comprehensive view.
    Use consistent methodology for comparability over time. Combine quantitative
    metrics with qualitative insights.
    """@en .

<http://example.org/ai4se#Term_MaturityLevel> a ns1:TermDefinition ;
    rdfs:label "Maturity Level"@en ;
    ns1:hasRelatedTerm <http://example.org/ai4se#Term_MaturityAssessment>,
        <http://example.org/ai4se#Term_PerformanceIndicator> ;
    ns1:mapsDomainTermTo <http://example.org/ai4se/maturity#MaturityLevel> ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:altLabel "Maturity Stage"@en ;
    skos:definition """
    A standardized stage in an organization's journey toward mature AI adoption in
    software engineering, typically progressing from initial/ad-hoc through defined,
    managed, and optimizing levels.
    """@en ;
    skos:example """
    AI Adoption Maturity Model:
    
    LEVEL 1 - INITIAL (Ad-hoc):
    - Individual developers experiment with AI tools
    - No organizational strategy or standards
    - Inconsistent usage and results
    - Limited measurement
    
    LEVEL 2 - REPEATABLE:
    - Teams adopt specific AI tools
    - Basic processes defined
    - Initial metrics tracking
    - Some best practices emerge
    
    LEVEL 3 - DEFINED:
    - Organization-wide AI strategy exists
    - Standardized tools and processes
    - Formal training programs
    - Comprehensive metrics and reporting
    
    LEVEL 4 - MANAGED:
    - Quantitative management of AI adoption
    - Continuous measurement and optimization
    - Strong governance and compliance
    - Predictable outcomes
    
    LEVEL 5 - OPTIMIZING:
    - Continuous innovation and improvement
    - AI deeply embedded in culture
    - Proactive identification of opportunities
    - Industry-leading practices
    """@en ;
    skos:prefLabel "AI Adoption Maturity Level"@en ;
    skos:scopeNote """
    Maturity models provide roadmap for improvement. Organizations typically progress
    sequentially but may advance different capabilities at different rates. Assessment
    helps identify gaps, prioritize initiatives, and measure progress. Common models:
    CMMI-inspired, custom frameworks.
    """@en .

<http://example.org/ai4se#Term_OrganizationalRisk> a ns1:TermDefinition ;
    rdfs:label "Organizational Risk"@en ;
    ns1:hasRelatedTerm <http://example.org/ai4se#Term_AIAdoptionRisk>,
        <http://example.org/ai4se#Term_TechnicalRisk> ;
    ns1:mapsDomainTermTo <http://example.org/ai4se/risk#OrganizationalRisk> ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:altLabel "Cultural Risk"@en,
        "People Risk"@en ;
    skos:definition """
    Risks related to organizational and human factors in AI adoption, including
    resistance to change, skill gaps, cultural misalignment, and loss of institutional
    knowledge.
    """@en ;
    skos:example """
    Specific organizational risks:
    
    1. Resistance Risk:
       - Developers fear job displacement
       - Skepticism about AI capabilities
       - Preference for traditional methods
       Mitigation: Communication campaign, involve developers early, demonstrate value
    
    2. Skill Gap Risk:
       - Developers lack skills to effectively use AI tools
       - Difficulty evaluating AI-generated code
       - Inability to debug AI system issues
       Mitigation: Comprehensive training programs, mentorship, documentation
    
    3. Dependency Risk:
       - Over-reliance on AI tools erodes coding skills
       - Loss of deep technical expertise
       - Difficulty working without AI assistance
       Mitigation: Balance AI usage with manual coding, continuous skill development
    
    4. Cultural Risk:
       - AI adoption conflicts with engineering culture
       - Quality standards compromised for speed
       - Loss of craftsmanship pride
       Mitigation: Cultural alignment, reinforcing quality values, celebrating wins
    """@en ;
    skos:prefLabel "Organizational Change Risk"@en ;
    skos:scopeNote """
    Organizational risks often determine adoption success more than technical factors.
    Require change management expertise, executive sponsorship, and sustained effort.
    Address through communication, training, support, and cultural reinforcement.
    Monitor through surveys, feedback sessions, and usage metrics.
    """@en .

<http://example.org/ai4se#Term_QualityGate> a ns1:TermDefinition ;
    rdfs:label "Quality Gate"@en ;
    ns1:hasRelatedTerm <http://example.org/ai4se#Term_ComplianceRequirement>,
        <http://example.org/ai4se#Term_GovernanceFramework> ;
    ns1:mapsDomainTermTo <http://example.org/ai4se/governance#QualityGate> ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:altLabel "Quality Checkpoint"@en ;
    skos:definition """
    A defined checkpoint in the development lifecycle where AI-generated or
    AI-assisted code must meet specific quality criteria before progressing to
    the next stage. Acts as a control mechanism ensuring quality standards.
    """@en ;
    skos:prefLabel "AI Code Quality Gate"@en ;
    skos:scopeNote """
    Quality gates prevent low-quality code from progressing. Balance rigor with
    agility - overly strict gates slow delivery. Automate checks where possible.
    Provide clear feedback when gate criteria not met. Continuously refine criteria
    based on defect patterns and feedback.
    """@en .

<http://example.org/ai4se#Term_ROIAnalysis> a ns1:TermDefinition ;
    rdfs:label "ROI Analysis"@en ;
    ns1:hasRelatedTerm <http://example.org/ai4se#Term_CostBenefitAnalysis>,
        <http://example.org/ai4se#Term_TCOAnalysis> ;
    ns1:mapsDomainTermTo <http://example.org/ai4se/financial#ROIAnalysis> ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:altLabel "Investment Return Analysis"@en,
        "ROI Calculation"@en ;
    skos:definition """
    A financial analysis method that calculates the return on investment for AI
    adoption initiatives by comparing the benefits (productivity gains, quality
    improvements, cost savings) against the costs (licenses, infrastructure,
    training, change management).
    """@en ;
    skos:prefLabel "Return on Investment Analysis"@en ;
    skos:scopeNote """
    ROI analysis should include both tangible benefits (measured cost savings,
    revenue increases) and intangible benefits (developer satisfaction, innovation
    capacity). Consider multi-year projections, risk adjustments, and opportunity
    costs. ROI metrics help justify investment and prioritize initiatives.
    """@en .

<http://example.org/ai4se#Term_TCOAnalysis> a ns1:TermDefinition ;
    rdfs:label "TCO Analysis"@en ;
    ns1:hasRelatedTerm <http://example.org/ai4se#Term_CostBenefitAnalysis>,
        <http://example.org/ai4se#Term_ROIAnalysis> ;
    ns1:mapsDomainTermTo <http://example.org/ai4se/financial#TCOAnalysis> ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:altLabel "Lifetime Cost Analysis"@en,
        "Total Cost Analysis"@en ;
    skos:definition """
    A comprehensive financial analysis that calculates the total cost of owning and
    operating an AI system throughout its entire lifecycle, including acquisition,
    implementation, operation, maintenance, and eventual retirement costs.
    """@en ;
    skos:prefLabel "Total Cost of Ownership Analysis"@en ;
    skos:scopeNote """
    TCO analysis reveals true long-term costs beyond initial purchase price. Often
    uncovers hidden costs: training, integration, customization, downtime, support.
    Use TCO to compare different solutions fairly and plan budgets accurately.
    Update TCO periodically as usage patterns and costs change.
    """@en .

<http://example.org/ai4se#Term_TechnicalRisk> a ns1:TermDefinition ;
    rdfs:label "Technical Risk"@en ;
    ns1:hasRelatedTerm <http://example.org/ai4se#Term_AIAdoptionRisk>,
        <http://example.org/ai4se#Term_OrganizationalRisk> ;
    ns1:mapsDomainTermTo <http://example.org/ai4se/risk#TechnicalRisk> ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:altLabel "Technology Risk"@en ;
    skos:definition """
    Risks related to the technical aspects of implementing and operating AI systems
    in software engineering, including code quality, integration challenges, performance
    issues, and technical debt.
    """@en ;
    skos:example """
    Specific technical risks:
    
    1. Code Quality Risk:
       - AI generates syntactically correct but semantically incorrect code
       - Subtle bugs difficult to detect in AI-generated code
       - Code style inconsistencies
       Mitigation: Comprehensive code review, automated testing, gradual rollout
    
    2. Integration Risk:
       - AI tools don't integrate smoothly with existing IDE/workflow
       - Compatibility issues with build systems
       - API versioning conflicts
       Mitigation: Thorough integration testing, vendor support engagement
    
    3. Performance Risk:
       - AI tool causes IDE slowdown
       - Model inference latency affects developer productivity
       - Resource consumption (CPU, memory, network)
       Mitigation: Performance testing, resource monitoring, optimization
    
    4. Technical Debt Risk:
       - Over-reliance on AI-generated code without understanding
       - Accumulation of unmaintainable code
       - Knowledge gaps in codebase
       Mitigation: Code reviews, documentation requirements, training
    """@en ;
    skos:prefLabel "Technical Implementation Risk"@en ;
    skos:scopeNote """
    Technical risks often interconnect - e.g., poor code quality leads to technical
    debt, which impacts maintainability and performance. Mitigate through strong
    engineering practices: testing, code review, monitoring, documentation, and
    continuous learning.
    """@en .

<http://example.org/ai4se#Term_AgentOrchestrator> a ns1:TermDefinition ;
    rdfs:label "Agent Orchestrator"@en ;
    ns1:hasRelatedTerm <http://example.org/ai4se#Term_AgentCoordinator>,
        <http://example.org/ai4se#Term_MultiAgentSystem> ;
    ns1:mapsDomainTermTo <http://example.org/ai4se#AgentOrchestrator> ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:altLabel "Agent Coordinator"@en,
        "Agent Manager"@en ;
    skos:definition """
    A component responsible for coordinating and managing multiple AI agents in a
    software engineering system. Handles task allocation, dependency management,
    conflict resolution, and overall workflow orchestration.
    """@en ;
    skos:example """
    Example responsibilities:
    - Receives high-level goals (e.g., "implement user authentication")
    - Decomposes into subtasks
    - Assigns tasks to specialized agents based on capabilities
    - Manages dependencies between tasks
    - Monitors progress and handles failures
    - Resolves conflicts when agents produce incompatible outputs
    - Ensures overall system coherence
    """@en ;
    skos:prefLabel "Multi-Agent System Orchestrator"@en ;
    skos:scopeNote """
    The orchestrator acts as a meta-agent with knowledge of individual agent
    capabilities, system state, and coordination strategies. It may use planning
    algorithms, scheduling heuristics, or learned policies to optimize task
    allocation and execution.
    """@en .

<http://example.org/ai4se#Term_CodeGenerationTool> a ns1:TermDefinition ;
    rdfs:label "Code Generation Tool"@en ;
    ns1:hasRelatedTerm <http://example.org/ai4se#Term_AIEnhancedTool>,
        <http://example.org/ai4se#Term_CodeCompletionTool> ;
    ns1:mapsDomainTermTo <http://example.org/ai4se#CodeGenerationTool> ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:altLabel "AI Code Writer"@en,
        "Automatic Code Generator"@en ;
    skos:definition """
    An AI system that generates complete code implementations from natural language
    descriptions, specifications, or partial implementations. Capable of producing
    functions, classes, modules, or entire applications.
    """@en ;
    skos:example """
    Examples: OpenAI Codex, GitHub Copilot X, Replit Ghostwriter, ChatGPT Code
    
    Usage: User provides requirement "Create a REST API endpoint that accepts JSON
    and stores data in PostgreSQL" and tool generates complete implementation.
    """@en ;
    skos:prefLabel "AI-Powered Code Generation Tool"@en ;
    skos:scopeNote """
    Code generation tools typically support multiple programming languages and
    frameworks. They generate syntactically correct, idiomatic code that follows
    best practices. Quality varies based on complexity and specificity of requirements.
    """@en .

<http://example.org/ai4se#Term_ComplianceRequirement> a ns1:TermDefinition ;
    rdfs:label "Compliance Requirement"@en ;
    ns1:hasRelatedTerm <http://example.org/ai4se#Term_AIGovernancePolicy>,
        <http://example.org/ai4se#Term_GovernanceFramework>,
        <http://example.org/ai4se#Term_QualityGate> ;
    ns1:mapsDomainTermTo <http://example.org/ai4se/governance#ComplianceRequirement> ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:altLabel "Regulatory Requirement"@en ;
    skos:definition """
    Legal, regulatory, or organizational mandates that must be satisfied when using
    AI in software engineering. Includes data privacy laws, intellectual property
    rules, industry regulations, and corporate policies.
    """@en ;
    skos:example """
    Example compliance requirements:
    
    1. DATA PRIVACY (GDPR, CCPA):
       - No personal data in prompts to external AI services
       - Data minimization in training data
       - User consent for AI processing
       - Right to explanation for AI decisions
       - Data retention and deletion policies
    
    2. INTELLECTUAL PROPERTY:
       - License compatibility checks for AI-generated code
       - Attribution for code derived from training data
       - No trademark violations in generated content
       - Patent considerations for AI-assisted inventions
    
    3. INDUSTRY REGULATIONS:
       - FDA compliance for medical device software
       - SOX compliance for financial systems
       - HIPAA compliance for healthcare applications
       - PCI-DSS for payment processing
    
    4. SECURITY STANDARDS:
       - OWASP guidelines for web applications
       - CWE/SANS Top 25 vulnerability prevention
       - Secure coding standards
       - Encryption requirements
    
    5. AUDIT AND TRACEABILITY:
       - Maintain records of AI usage
       - Document AI involvement in code reviews
       - Track AI tool versions and configurations
       - Enable compliance audits
    """@en ;
    skos:prefLabel "AI Compliance Requirement"@en ;
    skos:scopeNote """
    Compliance is non-negotiable. Build compliance into processes, not as
    afterthought. Automate compliance checks where possible. Maintain audit trails.
    Stay current with evolving regulations. Seek legal counsel for complex scenarios.
    Regular compliance audits essential.
    """@en .

<http://example.org/ai4se#Term_MultiAgentSystem> a ns1:TermDefinition ;
    rdfs:label "Multi-Agent System"@en ;
    ns1:hasRelatedTerm <http://example.org/ai4se#Term_AgentCoordinator>,
        <http://example.org/ai4se#Term_AgentOrchestrator>,
        <http://example.org/ai4se#Term_AgenticSystem> ;
    ns1:mapsDomainTermTo <http://example.org/ai4se#MultiAgentSystem> ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:altLabel "Collaborative Agent System"@en,
        "MAS"@en ;
    skos:definition """
    A system composed of multiple interacting AI agents, each with specialized
    capabilities, that collaborate to achieve complex software engineering objectives.
    Agents may specialize in coding, testing, documentation, architecture, or
    project management.
    """@en ;
    skos:example """
    Example architecture:
    - Architect Agent: Designs system architecture and APIs
    - Coder Agent: Implements features according to specifications
    - Tester Agent: Creates and runs test suites
    - Reviewer Agent: Reviews code for quality and security
    - Documentation Agent: Generates and maintains documentation
    - PM Agent: Tracks progress and manages dependencies
    """@en ;
    skos:prefLabel "Multi-Agent Software Engineering System"@en ;
    skos:scopeNote """
    Multi-agent systems enable parallel processing of software engineering tasks,
    specialization of expertise, and emergent problem-solving capabilities. Agents
    communicate through shared memory, message passing, or coordination protocols.
    Challenges include ensuring consistency, managing conflicts, and optimizing
    coordination overhead.
    """@en .

<http://example.org/ai4se#Term_PerformanceIndicator> a ns1:TermDefinition ;
    rdfs:label "Performance Indicator"@en ;
    ns1:hasRelatedTerm <http://example.org/ai4se#Term_KPIDashboard>,
        <http://example.org/ai4se#Term_MaturityLevel> ;
    ns1:mapsDomainTermTo <http://example.org/ai4se/performance#PerformanceIndicator> ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:altLabel "Performance Metric"@en,
        "Success Metric"@en ;
    skos:definition """
    A quantifiable measure used to evaluate the success and impact of AI adoption
    in software engineering. Includes productivity metrics, quality metrics, adoption
    metrics, and business impact metrics.
    """@en ;
    skos:example """
    Example performance indicators:
    
    PRODUCTIVITY METRICS:
    - Code velocity: Lines of code per developer per sprint
    - Feature delivery rate: Features shipped per quarter
    - Development cycle time: Idea to production time
    - Time saved by AI assistance: Hours per developer per week
    
    QUALITY METRICS:
    - Defect density: Bugs per thousand lines of code
    - Production incident rate: Incidents per deployment
    - Code review cycle time: Time to approve pull requests
    - Test coverage: Percentage of code covered by tests
    
    ADOPTION METRICS:
    - Tool usage rate: Percentage of developers actively using AI tools
    - AI code acceptance rate: Percentage of AI suggestions accepted
    - Daily active users: Developers using tools daily
    - Feature adoption: Specific features being utilized
    
    BUSINESS IMPACT METRICS:
    - Time-to-market: Product release frequency
    - Customer satisfaction: NPS scores, support tickets
    - Cost savings: Reduced development costs
    - Revenue impact: Features enabling new revenue
    """@en ;
    skos:prefLabel "AI Adoption Performance Indicator"@en ;
    skos:scopeNote """
    Effective KPIs are SMART: Specific, Measurable, Achievable, Relevant, Time-bound.
    Balance leading indicators (predict future performance) with lagging indicators
    (measure past results). Track both quantitative metrics and qualitative feedback.
    Review and adjust KPIs as adoption matures.
    """@en .

<http://example.org/ai4se#Term_UnsupervisedTraining> a ns1:TermDefinition ;
    rdfs:label "Unsupervised Training"@en ;
    ns1:hasRelatedTerm <http://example.org/ai4se#Term_ModelTraining>,
        <http://example.org/ai4se#Term_ReinforcementLearning>,
        <http://example.org/ai4se#Term_SupervisedTraining> ;
    ns1:mapsDomainTermTo <http://example.org/ai4se#UnsupervisedTraining> ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:altLabel "Unsupervised Learning"@en ;
    skos:definition """
    A machine learning training approach where the model learns patterns and
    structures from unlabeled data without explicit supervision. The model discovers
    hidden patterns, clusters, or representations in the data.
    """@en ;
    skos:example """
    Unsupervised training for code embeddings:
    - Input: Large corpus of unlabeled code
    - Model learns vector representations capturing code semantics
    - Similar code snippets have similar embeddings
    - Used for code search, duplicate detection, similarity analysis
    
    Unsupervised training for anomaly detection:
    - Model learns normal code patterns from codebase
    - Identifies unusual patterns that might indicate bugs or security issues
    """@en ;
    skos:prefLabel "Unsupervised Machine Learning Training"@en ;
    skos:scopeNote """
    Unsupervised learning is valuable when labeled data is scarce or expensive.
    Common techniques: autoencoders, clustering, dimensionality reduction,
    self-supervised learning. Often used as pre-training step before supervised
    fine-tuning.
    """@en .

<http://example.org/ai4se#Term_AIEnhancedTool> a ns1:TermDefinition ;
    rdfs:label "AI-Enhanced Tool"@en ;
    ns1:hasRelatedTerm <http://example.org/ai4se#Term_CodeCompletionTool>,
        <http://example.org/ai4se#Term_CodeGenerationTool>,
        <http://example.org/ai4se#Term_CodeReviewTool> ;
    ns1:mapsDomainTermTo <http://example.org/ai4se#AIEnhancedTool> ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:altLabel "AI-Powered Tool"@en,
        "Intelligent Development Tool"@en ;
    skos:definition """
    A software development tool that leverages artificial intelligence, machine learning,
    or large language models to enhance software engineering tasks such as coding,
    testing, documentation, or project management.
    """@en ;
    skos:example """
    Examples: GitHub Copilot (code completion), ChatGPT (documentation generation),
    Tabnine (intelligent code suggestions), SonarQube ML (code quality analysis),
    Diffblue Cover (automated test generation)
    """@en ;
    skos:prefLabel "AI-Enhanced Software Engineering Tool"@en ;
    skos:scopeNote """
    AI-enhanced tools differ from traditional development tools by incorporating
    adaptive learning capabilities, natural language understanding, context awareness,
    and predictive analytics. They continuously improve through usage and feedback.
    """@en .

<http://example.org/ai4se#Term_GovernanceFramework> a ns1:TermDefinition ;
    rdfs:label "Governance Framework"@en ;
    ns1:hasRelatedTerm <http://example.org/ai4se#Term_AIGovernancePolicy>,
        <http://example.org/ai4se#Term_ComplianceRequirement>,
        <http://example.org/ai4se#Term_QualityGate> ;
    ns1:mapsDomainTermTo <http://example.org/ai4se/governance#GovernanceFramework> ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:altLabel "AI Governance Structure"@en ;
    skos:definition """
    A comprehensive structure of policies, processes, roles, and oversight mechanisms
    that ensure responsible, effective, and compliant use of AI in software engineering
    while balancing innovation with risk management.
    """@en ;
    skos:example """
    Example governance framework components:
    
    1. GOVERNANCE STRUCTURE:
       - AI Steering Committee (executive level)
       - AI Center of Excellence (operational level)
       - AI Champions Network (grassroots level)
    
    2. POLICIES:
       - AI tool evaluation and approval process
       - Code generation usage guidelines
       - Data privacy and security requirements
       - Intellectual property protection
       - Compliance and audit requirements
    
    3. PROCESSES:
       - Tool selection and procurement
       - Risk assessment and mitigation
       - Quality assurance and validation
       - Incident response and escalation
       - Performance review and optimization
    
    4. STANDARDS:
       - Code quality standards for AI-generated code
       - Documentation requirements
       - Testing and validation criteria
       - Security and compliance baselines
    
    5. MONITORING & REPORTING:
       - Usage tracking and analytics
       - Quality metrics and KPIs
       - Risk monitoring and alerts
       - Compliance audits
       - Executive reporting
    """@en ;
    skos:prefLabel "AI Governance Framework"@en ;
    skos:scopeNote """
    Effective governance enables rather than constrains innovation. Balance control
    with flexibility. Adapt governance to organizational culture and risk tolerance.
    Evolve framework as AI capabilities and organizational maturity advance.
    Ensure clear accountability and decision rights.
    """@en .

<http://example.org/ai4se#Term_ModelTraining> a ns1:TermDefinition ;
    rdfs:label "Model Training"@en ;
    ns1:hasRelatedTerm <http://example.org/ai4se#Term_ModelFineTuning>,
        <http://example.org/ai4se#Term_SupervisedTraining>,
        <http://example.org/ai4se#Term_UnsupervisedTraining> ;
    ns1:mapsDomainTermTo <http://example.org/ai4se#ModelTraining> ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:altLabel "Model Learning"@en,
        "Training Process"@en ;
    skos:definition """
    The process of training a machine learning model on datasets to learn patterns,
    relationships, and behaviors relevant to software engineering tasks. Involves
    iterative optimization of model parameters to minimize prediction errors.
    """@en ;
    skos:example """
    Training a code completion model:
    1. Collect large corpus of high-quality code
    2. Preprocess and tokenize code
    3. Define model architecture (e.g., transformer)
    4. Initialize model parameters
    5. Train using self-supervised learning
    6. Validate on held-out dataset
    7. Tune hyperparameters
    8. Evaluate on benchmark tasks
    """@en ;
    skos:prefLabel "Machine Learning Model Training"@en ;
    skos:scopeNote """
    Training for SE tasks requires domain-specific datasets, appropriate model
    architectures, and evaluation metrics. Common challenges include data quality,
    computational resources, overfitting, and ensuring model generalizes to
    diverse coding scenarios.
    """@en .

<http://example.org/ai4se#Term_SupervisedTraining> a ns1:TermDefinition ;
    rdfs:label "Supervised Training"@en ;
    ns1:hasRelatedTerm <http://example.org/ai4se#Term_ModelTraining>,
        <http://example.org/ai4se#Term_UnsupervisedTraining> ;
    ns1:mapsDomainTermTo <http://example.org/ai4se#SupervisedTraining> ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:altLabel "Supervised Learning"@en ;
    skos:definition """
    A machine learning training approach where the model learns from labeled examples,
    i.e., input-output pairs where the correct answer is provided. The model learns
    to map inputs to outputs by minimizing prediction errors on the training set.
    """@en ;
    skos:example """
    Supervised training for bug detection:
    - Training data: Code snippets labeled as "buggy" or "correct"
    - Model learns patterns that distinguish buggy code
    - Trained model can predict whether new code contains bugs
    
    Supervised training for code classification:
    - Training data: Functions labeled by their purpose (e.g., "sorting", "parsing")
    - Model learns to classify functions by functionality
    """@en ;
    skos:prefLabel "Supervised Machine Learning Training"@en ;
    skos:scopeNote """
    Supervised learning requires high-quality labeled data, which can be expensive
    to obtain. For software engineering, labels might come from human annotations,
    automated testing results, or historical bug reports. Works well when clear
    input-output relationships exist.
    """@en .

