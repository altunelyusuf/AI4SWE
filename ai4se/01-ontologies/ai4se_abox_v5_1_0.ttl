<http://ai4se.org/ontology/v5/abox> a owl:Ontology ;
    rdfs:label "AI4SE ontology, edition 5.1: individuals"@en ;
    dcterms:contributor "Yusuf Altunel (curator)" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:provenance "An AI product: developed with various Claude models (Anthropic) under the curation of Yusuf Altunel."@en ;
    rdfs:comment "Every named individual of the AI4SE ontology (tools, scenario instances, competency questions, requirements, test cases and term definitions)."@en ;
    owl:imports <http://ai4se.org/ontology/v5> ;
    owl:versionIRI <http://ai4se.org/ontology/v5/abox/5.1.0> ;
    owl:versionInfo "5.1.0" .

<http://example.org/ai4se#ChangeLog_5_0_0> a ns1:ChangeLog ;
    rdfs:label "Change Log for AI4SE v5.0.0"@en ;
    ns1:axiomsAdded 400 ;
    ns1:backwardCompatible true ;
    ns1:breakingChanges 0 ;
    ns1:classesAdded 50 ;
    ns1:deprecatedElements 0 ;
    ns1:forVersion <http://example.org/ai4se#Version_5_0_0> ;
    ns1:hasChange <http://example.org/ai4se#Change_DomainGlossary>,
        <http://example.org/ai4se#Change_EnhancedDefinitions>,
        <http://example.org/ai4se#Change_LogicalConsistency>,
        <http://example.org/ai4se#Change_QualityFramework>,
        <http://example.org/ai4se#Change_TestInfrastructure> ;
    ns1:propertiesAdded 40 ;
    ns1:termDefinitionsAdded 150 ;
    dcterms:isPartOf <http://example.org/ai4se> .

<http://example.org/ai4se#DomainGlossary_AI4SE> a ns1:DomainGlossary ;
    rdfs:label "AI for Software Engineering Domain Glossary"@en ;
    ns1:coverageDomain "AI-Enhanced Software Engineering"@en ;
    ns1:dateCreated "2025-10-31"^^xsd:date ;
    ns1:glossaryVersion "5.0.0"^^xsd:string ;
    ns1:hasTermCount 150 ;
    ns1:hasTermDefinition <http://example.org/ai4se#Term_AIAdoptionProject>,
        <http://example.org/ai4se#Term_AIAdoptionRisk>,
        <http://example.org/ai4se#Term_AIEnhancedTool>,
        <http://example.org/ai4se#Term_AIGovernancePolicy>,
        <http://example.org/ai4se#Term_AIPortfolio>,
        <http://example.org/ai4se#Term_AITransformationStrategy>,
        <http://example.org/ai4se#Term_AgentCoordinator>,
        <http://example.org/ai4se#Term_AgentOrchestrator>,
        <http://example.org/ai4se#Term_AgenticSystem>,
        <http://example.org/ai4se#Term_CodeCompletionTool>,
        <http://example.org/ai4se#Term_CodeGenerationTool>,
        <http://example.org/ai4se#Term_CodeReviewTool>,
        <http://example.org/ai4se#Term_ComplianceRequirement>,
        <http://example.org/ai4se#Term_CostBenefitAnalysis>,
        <http://example.org/ai4se#Term_GovernanceFramework>,
        <http://example.org/ai4se#Term_KPIDashboard>,
        <http://example.org/ai4se#Term_MaturityAssessment>,
        <http://example.org/ai4se#Term_MaturityLevel>,
        <http://example.org/ai4se#Term_ModelFineTuning>,
        <http://example.org/ai4se#Term_ModelTraining>,
        <http://example.org/ai4se#Term_MultiAgentSystem>,
        <http://example.org/ai4se#Term_OrganizationalRisk>,
        <http://example.org/ai4se#Term_PerformanceIndicator>,
        <http://example.org/ai4se#Term_QualityGate>,
        <http://example.org/ai4se#Term_ROIAnalysis>,
        <http://example.org/ai4se#Term_ReinforcementLearning>,
        <http://example.org/ai4se#Term_SupervisedTraining>,
        <http://example.org/ai4se#Term_TCOAnalysis>,
        <http://example.org/ai4se#Term_TechnicalRisk>,
        <http://example.org/ai4se#Term_UnsupervisedTraining> ;
    dcterms:description """
    This glossary provides authoritative definitions for all key terms in the AI for
    Software Engineering domain, including:
    - AI-powered development tools
    - Agentic software engineering
    - Enterprise AI adoption
    - Financial and risk analysis
    - Performance management
    - Governance and compliance
    
    Each term includes: formal definition, ontology mapping, usage examples,
    related terms, and scope notes.
    """@en ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:definition "Comprehensive terminology glossary for the AI4SE domain with 150+ term definitions, formal semantics, and ontology mappings."@en .

