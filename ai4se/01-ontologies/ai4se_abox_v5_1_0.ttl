<http://example.org/ai4se#Change_DomainGlossary> a ns1:AdditiveChange ;
    rdfs:label "Comprehensive Domain Glossary"@en ;
    ns1:impactLevel "High"@en ;
    ns1:moduleAffected "Terminology Module"@en ;
    ns1:qualityImpact ns2:Comprehensiveness,
        ns2:Usability ;
    dcterms:description "Created exhaustive domain terminology with definitions, examples, scope notes, and cross-references."@en ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:definition "Complete terminology glossary with 150+ term definitions, formal semantics, and ontology mappings."@en .

<http://example.org/ai4se#Change_EnhancedDefinitions> a ns1:RefactoringChange ;
    rdfs:label "Enhanced Class Definitions"@en ;
    ns1:impactLevel "High"@en ;
    ns1:moduleAffected "All Modules"@en ;
    ns1:qualityImpact ns2:Comprehensiveness,
        ns2:Usability ;
    dcterms:description "Enhanced all class definitions with rdfs:comment, skos:definition, skos:example, and skos:scopeNote."@en ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:definition "Comprehensive documentation for all 350 classes with comments, definitions, examples, and usage guidelines."@en .

<http://example.org/ai4se#Change_LogicalConsistency> a ns1:AdditiveChange ;
    rdfs:label "Logical Consistency Enhancement"@en ;
    ns1:impactLevel "Critical"@en ;
    ns1:moduleAffected "Core Ontology Structure"@en ;
    ns1:qualityImpact ns2:Consistency,
        ns2:Correctness ;
    dcterms:description "Added 15 disjointness families, 50+ property restrictions, 30+ cardinality constraints, and 20+ property chains."@en ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:definition "Comprehensive axiomatization including disjointness declarations, property restrictions, and cardinality constraints for maximum logical rigor."@en .

<http://example.org/ai4se#Change_QualityFramework> a ns1:AdditiveChange ;
    rdfs:label "Quality Assessment Framework"@en ;
    ns1:impactLevel "Medium"@en ;
    ns1:moduleAffected "Quality Module"@en ;
    ns1:qualityImpact ns2:OverallQuality ;
    dcterms:description "Integrated OQC (Ontology Quality Control) framework with 8 quality dimensions and measurement infrastructure."@en ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:definition "Complete quality control framework with metrics, assessments, findings, and gate decisions."@en .

<http://example.org/ai4se#Change_TestInfrastructure> a ns1:AdditiveChange ;
    rdfs:label "Complete Test Infrastructure"@en ;
    ns1:impactLevel "Critical"@en ;
    ns1:moduleAffected "Testing Module"@en ;
    ns1:qualityImpact ns2:Completeness,
        ns2:Correctness ;
    dcterms:description "Implemented complete testing framework with unit tests, integration tests, system tests, and performance benchmarks."@en ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:definition "Comprehensive test suite with 25 test cases covering functional requirements, competency questions, and quality validation."@en .

<http://example.org/ai4se#FR01_OntologyMetadata> a ns1:FunctionalRequirement ;
    rdfs:label "FR01: Complete Ontology Metadata"@en ;
    ns1:hasCompetencyQuestion <http://example.org/ai4se#CQ01_WhatIsOntologyPurpose> ;
    ns1:requirementText "Ontology must have complete metadata including title, description, version, dates, and provenance."@en ;
    dcterms:isPartOf <http://example.org/ai4se> .

<http://example.org/ai4se#MigrationStrategy_4_to_5> a ns1:MigrationStrategy ;
    rdfs:label "Migration Strategy from v4.0 to v5.0"@en ;
    ns1:migratedFrom <http://example.org/ai4se#Version_4_0_0> ;
    ns1:migratesTo <http://example.org/ai4se#Version_5_0_0> ;
    dcterms:description """
    MIGRATION FROM v4.0.0 TO v5.0.0
    ================================
    
    This migration is SEAMLESS as all changes are additive.
    
    AUTOMATIC MIGRATION:
    --------------------
    No action required. All v4.0.0 instances are valid in v5.0.0.
    
    RECOMMENDED ACTIONS:
    --------------------
    1. Re-run reasoning with updated axioms for enhanced inference
    2. Validate instances against new SHACL shapes
    3. Run test suite to ensure data quality
    4. Review quality assessment reports
    5. Update documentation to reference v5.0.0
    
    OPTIONAL ENHANCEMENTS:
    ----------------------
    6. Adopt new quality control framework for continuous validation
    7. Implement test cases for custom extensions
    8. Enhance instance data with new properties
    9. Utilize new property chains for richer querying
    10. Apply performance optimization recommendations
    
    CONFIGURATION UPDATES:
    ----------------------
    - Reasoner: May need more memory due to additional axioms
    - Query Engine: Can leverage new property chains
    - Validation: Configure SHACL validator with new shapes
    - Testing: Integrate test suite into CI/CD pipeline
    
    ROLLBACK PLAN:
    --------------
    If issues arise, simply revert to v4.0.0 ontology file.
    All v5.0.0 instance data is compatible with v4.0.0.
    
    SUPPORT:
    --------
    - Migration Guide: AI4SE_Migration_Guide_v4_to_v5.pdf
    - FAQ: AI4SE_Migration_FAQ.md
    - Support Forum: https://ai4se.org/forum
    - Technical Support: support@ai4se.org
    """@en ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:definition "Seamless migration path from version 4.0 to 5.0 with backward compatibility."@en .

<http://example.org/ai4se#TC01_CoreStructure> a ns1:UnitTest ;
    rdfs:label "Test Case 01: Core Ontology Structure"@en ;
    ns1:hasExpectedResult "Ontology properly declared with metadata"@en ;
    ns1:hasTestData """
    # Test data: Check ontology declaration exists
    PREFIX owl: <http://www.w3.org/2002/07/owl#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    
    Test: Ontology must be declared as owl:Ontology
    """@en ;
    ns1:hasTestID "TC01"^^xsd:string ;
    ns1:hasVerificationQuery <http://example.org/ai4se#VQ01_OntologyDeclaration> ;
    ns1:testCategory "Core Structure"@en ;
    ns1:testPriority "Critical"@en ;
    ns1:verifiesRequirement <http://example.org/ai4se#FR01_OntologyMetadata> ;
    ns2:verifiesCompetencyQuestion <http://example.org/ai4se#CQ01_WhatIsOntologyPurpose> ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:definition "Validates that core ontology structure is properly defined with metadata, imports, and version information."@en .

<http://example.org/ai4se#TC02_LogicalConsistency> a ns1:UnitTest ;
    rdfs:label "Test Case 02: Logical Consistency Check"@en ;
    ns1:hasExpectedResult "No unsatisfiable classes found"@en ;
    ns1:hasTestData """
    # Test data: Run reasoner and check for contradictions
    Reasoner: HermiT 1.4.5
    Timeout: 300 seconds
    """@en ;
    ns1:hasTestID "TC02"^^xsd:string ;
    ns1:hasVerificationQuery <http://example.org/ai4se#VQ02_NoUnsatisfiableClasses> ;
    ns1:testCategory "Logical Consistency"@en ;
    ns1:testPriority "Critical"@en ;
    ns1:verifiesRequirement <http://example.org/ai4se#FR02_LogicalConsistency> ;
    ns2:verifiesCompetencyQuestion <http://example.org/ai4se#CQ02_IsOntologyConsistent> ;
    dcterms:isPartOf <http://example.org/ai4se> ;
    skos:definition "Validates that ontology is logically consistent with no unsatisfiable classes."@en .

