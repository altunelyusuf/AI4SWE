v5:AI a owl:Class ;
    rdfs:label "AI"@en ;
    dcterms:isPartOf <http://ai4se.org/ontology/v5/module/Phase3Relationships>,
        <http://ai4se.org/ontology/v5/module/ReferencedButUndefined> ;
    rdfs:comment "Stub declared by the package build: the source files use this term but never define it. The label is derived mechanically from the identifier."@en ;
    owl:equivalentClass v5:ArtificialIntelligence .

v5:APIGatewayPattern a owl:Class ;
    rdfs:label "API Gateway Pattern"@en ;
    v5:hasBenefit "Centralized security and policies"@en,
        "Protocol translation"@en,
        "Request aggregation"@en ;
    v5:hasResource [ rdfs:label "API Gateway Documentation"@en ;
            v5:downloadURL <https://docs.aws.amazon.com/apigateway/> ] ;
    v5:usesTool v5:AWSAPIGateway,
        v5:Kong ;
    dcterms:isPartOf <http://ai4se.org/ontology/v5/module/Phase14SpecializedDomains> ;
    skos:definition "Single entry point for all client requests, handling routing, authentication, rate limiting, and aggregation in microservices architecture"@en .

v5:APIManagement a owl:Class ;
    rdfs:label "API Management Platform"@en ;
    v5:hasBenefit "Developer portal"@en,
        "Rate limiting and throttling"@en,
        "Secure API access"@en ;
    v5:hasResource [ rdfs:label "Kong API Gateway Documentation"@en ;
            v5:downloadURL <https://docs.konghq.com/> ] ;
    v5:usesTool v5:Apigee,
        v5:Kong ;
    dcterms:isPartOf <http://ai4se.org/ontology/v5/module/Phase12EnterpriseSystems> ;
    skos:definition "Comprehensive platform for creating, publishing, documenting, securing, and analyzing APIs for fashion marketplace integration with sellers and partners"@en .

v5:APISecurity a owl:Class ;
    rdfs:label "API Security"@en ;
    v5:complementsWellWith v5:APIGateway ;
    v5:complexityRating "High" ;
    v5:enables v5:SecureThirdPartyIntegration ;
    v5:hasBenefit "Enables secure third-party integrations"@en,
        "Prevents API abuse and data leaks"@en,
        "Secures microservices communication"@en ;
    v5:hasChallenge "API versioning and backward compatibility"@en,
        "Complex OAuth/JWT implementation"@en ;
    v5:hasResource [ rdfs:label "OpenAPI Specification"@en ;
            v5:downloadURL <https://swagger.io/specification/> ],
        [ rdfs:label "OWASP API Security Top 10"@en ;
            v5:downloadURL <https://owasp.org/www-project-api-security/> ] ;
    v5:maturityLevel "Maturing" ;
    v5:requires v5:AuthenticationSecurity,
        v5:RateLimiting ;
    v5:supportsBusinessProcess v5:MarketplaceIntegration ;
    v5:usesTool v5:AWSAPIGateway,
        v5:ApigeeAPIGateway,
        v5:Kong ;
    v5:worksWellWith v5:MicroservicesArchitecture ;
    dcterms:isPartOf <http://ai4se.org/ontology/v5/module/Phase2Security>,
        <http://ai4se.org/ontology/v5/module/Phase3Structural> ;
    rdfs:subClassOf v5:WebApplicationSecurity ;
    skos:definition "Security practices for protecting REST/GraphQL APIs including authentication, authorization, rate limiting, input validation, and API gateway security"@en .

v5:APISecurityTesting a owl:Class ;
    rdfs:label "API Security Testing"@en ;
    v5:complementsWith v5:IntegrationTesting,
        v5:LoadTesting ;
    v5:enables v5:SecureIntegrations ;
    v5:hasBenefit "Ensures secure third-party integrations"@en,
        "Prevents unauthorized data access"@en,
        "Protects against API abuse and scraping"@en ;
    v5:hasResource [ rdfs:label "OWASP API Security Top 10"@en ;
            v5:downloadURL <https://owasp.org/API-Security/editions/2023/en/0x11-t10/> ;
            v5:resourceType "Security Guidelines"@en ] ;
    v5:requires v5:AuthenticationTesting,
        v5:AuthorizationTesting,
        v5:RateLimitTesting ;
    v5:supportsDomain v5:MarketplaceEcommerce ;
    v5:usesTool v5:OWASP_API_Security_Project,
        v5:Postman ;
    dcterms:isPartOf <http://ai4se.org/ontology/v5/module/Phase2Enrichment>,
        <http://ai4se.org/ontology/v5/module/Phase3Relationships> ;
    rdfs:subClassOf v5:SecurityTesting ;
    skos:definition "Testing security of Application Programming Interfaces including authentication, authorization, data validation, and rate limiting for e-commerce marketplace APIs"@en .

v5:APIVersioning a owl:Class ;
    rdfs:label "API Versioning Strategy"@en ;
    v5:hasBenefit "Backward compatibility"@en,
        "Smooth migrations"@en ;
    v5:hasResource [ rdfs:label "API Versioning Guide"@en ;
            v5:downloadURL <https://swagger.io/blog/api-strategy/versioning-apis/> ] ;
    dcterms:isPartOf <http://ai4se.org/ontology/v5/module/Phase14SpecializedDomains> ;
    rdfs:subClassOf v5:RESTfulAPI ;
    skos:definition "Managing multiple versions of APIs to support backward compatibility while evolving functionality for fashion marketplace integrations"@en .

v5:ARTechnology a owl:Class ;
    rdfs:label "AR Technology"@en ;
    dcterms:isPartOf <http://ai4se.org/ontology/v5/module/ReferencedButUndefined> ;
    rdfs:comment "Stub declared by the package build: the source files use this term but never define it. The label is derived mechanically from the identifier."@en .

v5:AccessibilityCompliance a owl:Class ;
    rdfs:label "Web Accessibility (WCAG)"@en ;
    v5:hasBenefit "Better SEO"@en,
        "Legal compliance"@en ;
    v5:hasChallenge "Additional development effort"@en ;
    v5:hasResource [ rdfs:label "WCAG 2.1 Guidelines"@en ;
            v5:downloadURL <https://www.w3.org/WAI/WCAG21/quickref/> ] ;
    v5:usesTool v5:axe_DevTools ;
    dcterms:isPartOf <http://ai4se.org/ontology/v5/module/Phase7Advanced> ;
