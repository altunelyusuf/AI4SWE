    :hasV4ID "V4_NEW_168"^^xsd:string ;
    dcterms:isPartOf :ArchitecturePatternsModule ;
    rdfs:subClassOf :ArchitectureConcept ;
    skos:definition "Reusable solution to commonly occurring problem in software design"@en ;
    skos:note "Based on Gang of Four patterns and modern extensions"@en .

:HybridKnowledgeSystem a owl:Class ;
    rdfs:label "Hybrid Knowledge System"@en ;
    :combinesApproach :FormalKnowledgeRepresentation,
        :StatisticalAI ;
    :hasBookReference "Chapter 16, Part 5.5, Introduction"^^xsd:string ;
    :hasV4ID "V4_NEW_091"^^xsd:string ;
    dcterms:isPartOf :HybridSystemsModule ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :usesPattern ],
        :HybridSystemConcept ;
    skos:definition "AI system combining strengths of formal ontologies (structure, reasoning, consistency) with Large Language Models (flexibility, natural language understanding, creativity)"@en ;
    skos:example "Requirements elicitation system using LLM to extract concepts from interviews, ontology to validate structure, knowledge graph to store, LLM to generate traceability matrix"@en .

:HybridSystemBestPractice a owl:Class ;
    rdfs:label "Hybrid System Best Practice"@en ;
    :hasBookReference "Chapter 16, Part 5.5"^^xsd:string ;
    :hasV4ID "V4_NEW_111"^^xsd:string ;
    dcterms:isPartOf :HybridSystemsModule ;
    rdfs:subClassOf :BestPractice ;
    skos:definition "Recommended practice for building hybrid ontology+LLM systems"@en .

:MetamorphicRelation a owl:Class ;
    rdfs:label "Metamorphic Relation"@en ;
    :hasBookReference "Chapter 5, Part 8"^^xsd:string ;
    :hasV4ID "V4_NEW_076"^^xsd:string ;
    dcterms:isPartOf :TestingTaxonomyModule ;
    rdfs:subClassOf :TestingConcept ;
    skos:definition "Relationship that must hold between inputs and outputs of multiple program executions"@en ;
    skos:example "Permutation invariance: swapping input order shouldn't change output"@en .

:RDFTriple a owl:Class ;
