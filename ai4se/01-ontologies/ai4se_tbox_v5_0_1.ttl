v5:DataEncryption a owl:Class ;
    rdfs:label "Data Encryption"@en ;
    v5:hasBenefit "Ensures KVKK/GDPR compliance"@en,
        "KVKK compliance requirement"@en,
        "Prevents data breaches during storage/transmission"@en,
        "Protects customer PII and payment data"@en,
        "Reduces breach impact (encrypted data worthless to attackers)"@en ;
    v5:hasChallenge "Key management complexity"@en ;
    v5:hasResource [ rdfs:label "KVKK Data Security Guidelines (Turkish)"@en ;
            v5:downloadURL <https://www.kvkk.gov.tr/SharedFolderServer/CMSFiles/Guideline_on_Data_Security.pdf> ],
        [ rdfs:label "NIST Encryption Standards"@en ;
            v5:downloadURL <https://nvlpubs.nist.gov/nistpubs/FIPS/NIST.FIPS.197.pdf> ;
            v5:resourceType "Cryptography Standard"@en ],
        [ rdfs:label "NIST Guide to Secure Cryptographic Key Management"@en ;
            v5:downloadURL <https://csrc.nist.gov/publications/detail/sp/800-175b/rev-1/final> ] ;
    v5:usesTool v5:AWSKeyManagementService,
        v5:AzureKeyVault,
        v5:HashiCorpVault ;
    dcterms:isPartOf <http://ai4se.org/ontology/v5/module/Phase2Enrichment>,
        <http://ai4se.org/ontology/v5/module/Phase2Security> ;
    rdfs:subClassOf v5:SecurityTechnique,
        v5:SecurityTesting ;
    skos:definition "Converting sensitive data into coded format using cryptographic algorithms to protect customer information, payment details, and business data at rest and in transit"@en,
        "Process of encoding sensitive data using cryptographic algorithms to protect confidentiality, including encryption at rest, in transit, and in use"@en .

