v5:InfrastructureAsCode a owl:Class ;
    rdfs:label "Infrastructure as Code (IaC)"@en ;
    v5:complementsWellWith v5:CICDPipeline ;
    v5:complexityRating "High" ;
    v5:enables v5:DisasterRecovery,
        v5:ReproducibleInfrastructure ;
    v5:hasBenefit "Reduces configuration drift"@en,
        "Reproducible infrastructure deployments"@en,
        "Version-controlled infrastructure changes"@en ;
    v5:hasChallenge "Learning curve for IaC tools"@en,
        "State management complexity (Terraform)"@en ;
    v5:hasResource [ rdfs:label "Terraform Module Registry"@en ;
            v5:downloadURL <https://registry.terraform.io/browse/modules> ],
        [ rdfs:label "Terraform Documentation"@en ;
            v5:downloadURL <https://www.terraform.io/docs/index.html> ] ;
    v5:implementationTime 8 ;
    v5:maturityLevel "Maturing" ;
    v5:requires v5:CloudComputing,
        v5:VersionControl ;
    v5:supportsBusinessProcess v5:RapidDeployment ;
    v5:usesTool v5:AWSCloudFormation,
        v5:Pulumi,
        v5:Terraform ;
    dcterms:isPartOf <http://ai4se.org/ontology/v5/module/Phase2MultiDomain>,
        <http://ai4se.org/ontology/v5/module/Phase3Structural> ;
    rdfs:subClassOf v5:DevOpsPractice ;
    skos:definition "Managing and provisioning infrastructure through machine-readable definition files rather than manual configuration, enabling version control and automation"@en .

