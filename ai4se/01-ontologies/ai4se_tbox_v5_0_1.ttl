:ChaosEngineering a owl:Class ;
    rdfs:label "Chaos Engineering"@en ;
    :appropriateFor "Cloud-native applications"@en,
        "Distributed systems and microservices"@en ;
    :hasBenefit "Builds confidence in system resilience"@en,
        "Finds issues before customers do"@en,
        "Improves incident response capabilities"@en ;
    :hasBookReference "Chapter 5, Part 8, Technique 2"^^xsd:string ;
    :hasLimitation "Requires production-like environment"@en,
        "Risk of causing real outages"@en ;
    :hasToolExample :ChaosMesh,
        :ChaosMonkey,
        :GremlinInc ;
    :hasV4ID "V4_NEW_070"^^xsd:string ;
    dcterms:isPartOf :TestingTaxonomyModule ;
    rdfs:subClassOf :AdvancedTestingTechnique ;
    owl:equivalentClass v5:ChaosEngineering ;
    skos:definition "Discipline of experimenting on distributed systems by intentionally injecting failures to build confidence in system's resilience and ability to withstand turbulent conditions"@en ;
    skos:example "Randomly killing microservice pods in production to verify system gracefully degrades and recovers"@en ;
    skos:note "Pioneered by Netflix with Chaos Monkey. Critical for distributed systems, microservices, cloud-native architectures"@en .

:CircuitBreakerPattern a owl:Class ;
    rdfs:label "Circuit Breaker Pattern"@en ;
    :hasBenefit "Automatic recovery attempts"@en,
        "Fast failure response"@en,
        "Prevents cascade failures"@en ;
    :hasState :CircuitClosed,
        :CircuitHalfOpen,
        :CircuitOpen ;
    :hasV4ID "V4_NEW_180"^^xsd:string ;
    :usesTool :Hystrix,
        :Resilience4j ;
    dcterms:isPartOf :ArchitecturePatternsModule ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "3"^^xsd:nonNegativeInteger ;
            owl:onProperty :hasState ],
        :CloudNativePattern ;
    skos:definition "Prevents cascading failures by stopping calls to failing services"@en ;
    skos:example "Netflix Hystrix wrapping service calls with circuit breaker"@en .

:CloudNative a owl:Class ;
    rdfs:label "Cloud-Native"@en ;
    :hasPrinciple "Containers"@en,
        "DevOps culture"@en,
        "Dynamic orchestration"@en,
        "Microservices architecture"@en ;
    :hasV4ID "V4_NEW_264"^^xsd:string ;
    dcterms:isPartOf :CloudContainerizationModule ;
    rdfs:subClassOf :CloudConcept ;
    skos:definition "Approach to building and running applications exploiting cloud computing model"@en .

:CompetencyQuestions a owl:Class ;
