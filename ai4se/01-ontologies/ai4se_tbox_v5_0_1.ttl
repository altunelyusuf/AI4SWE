:V4_V4_0334 a owl:Class ;
    rdfs:label "Development Context"@en ;
    :applicableMLTechnique :DependencyParsing,
        :NamedEntityRecognition,
        :TextClassification ;
    :hasCodeExample """import spacy

# Load NLP model
nlp = spacy.load("en_core_web_sm")

# Process text
doc = nlp(text)
entities = [(ent.text, ent.label_) for ent in doc.ents]
print(f"Found {len(entities)} entities")"""@en ;
    :hasV4ID "V4_V4_0334" ;
    :implementedIn :HuggingFace,
        :NLTK,
        :spaCy ;
    dcterms:isPartOf <http://ai4se.org/ontology/v4> ;
    rdfs:subClassOf :SEConcept ;
    skos:altLabel "Development Context (AI-Enhanced)"@en .

