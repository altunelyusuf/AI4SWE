        <http://ai4se.org/ontology/v5/module/Phase3Structural> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onProperty v5:integrates ],
        v5:FashionRetailDomain ;
    skos:definition "End-to-end management of product flow from suppliers through manufacturing, warehousing, and distribution to end customers in fashion retail context"@en .

