        :PatternMatching,
        :StaticAnalysis ;
    :hasCodeExample """# Security vulnerability detection
import bandit
from bandit.core import manager

# Analyze code for vulnerabilities
mgr = manager.BanditManager()
mgr.discover_files(['src/'])
mgr.run_tests()
print(f"Found {len(mgr.results)} issues")"""@en ;
