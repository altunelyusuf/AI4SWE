    dcterms:isPartOf <http://ai4se.org/ontology/v5/module/HybridBase> ;
    rdfs:subClassOf v5:SEConcept ;
    skos:definition "Concepts specifically related to artificial intelligence application in software engineering, including machine learning, natural language processing, and automated reasoning for SE tasks"@en .

v5:InventoryOptimization a owl:Class ;
    rdfs:label "Inventory Optimization"@en ;
    v5:hasBenefit "Improves cash flow significantly"@en ;
    v5:hasChallenge "Fast fashion short product lifecycles"@en,
        "Seasonal demand variability in fashion"@en ;
    v5:hasResource [ rdfs:label "Inventory Optimization Techniques"@en ;
            v5:downloadURL <https://www.scmr.com/wp-content/uploads/2023/inventory-optimization-guide.pdf> ;
            v5:resourceType "Operations Guide"@en ] ;
    dcterms:isPartOf <http://ai4se.org/ontology/v5/module/Phase2Enrichment> ;
    rdfs:subClassOf v5:AI4SEConcept ;
    skos:definition "AI/ML techniques to determine optimal inventory levels across warehouses and stores, minimizing stockouts while reducing carrying costs"@en .

v5:MobileDevelopment a owl:Class ;
    rdfs:label "Mobile Development"@en ;
    v5:complementsWellWith v5:WebDevelopment ;
    v5:complexityRating "High" ;
    v5:enables v5:OmnichannelRetail ;
    v5:hasBenefit "Location-based services for stores"@en,
        "Push notifications for engagement"@en ;
    v5:hasChallenge "App store review processes"@en,
        "iOS and Android platform differences"@en ;
    v5:hasResource [ rdfs:label "Android Developer Guide"@en ;
            v5:downloadURL <https://developer.android.com/guide> ],
        [ rdfs:label "iOS App Programming Guide"@en ;
            v5:downloadURL <https://developer.apple.com/library/archive/documentation/iPhone/Conceptual/iPhoneOSProgrammingGuide/Introduction/Introduction.html> ] ;
    v5:maturityLevel "Mature" ;
    v5:requires v5:APIIntegration,
        v5:UIUXDesign ;
    v5:supportsBusinessProcess v5:CustomerEngagement ;
    v5:usesTool v5:Flutter,
        v5:Kotlin,
        v5:ReactNative,
        v5:Swift ;
    dcterms:isPartOf <http://ai4se.org/ontology/v5/module/Phase2MultiDomain>,
        <http://ai4se.org/ontology/v5/module/Phase3Structural> ;
    rdfs:subClassOf v5:SEConcept ;
    skos:definition "Development of applications for mobile devices including iOS and Android, with focus on e-commerce shopping experiences, payment integration, and omnichannel retail"@en .

:CICDConcept a owl:Class ;
    rdfs:label "CI/CD Concept"@en ;
    :hasV4ID "V4_NEW_200"^^xsd:string ;
    dcterms:isPartOf :CICDAutomationModule ;
    rdfs:subClassOf :AI4SEConcept ;
    skos:definition "Concept related to continuous integration, continuous delivery, and deployment automation"@en .

:CloudConcept a owl:Class ;
    rdfs:label "Cloud Concept"@en ;
    :hasV4ID "V4_NEW_240"^^xsd:string ;
    dcterms:isPartOf :CloudContainerizationModule ;
    rdfs:subClassOf :AI4SEConcept ;
    skos:definition "Concept related to cloud computing, containerization, and orchestration"@en .

:DomainModel a owl:Class ;
    rdfs:label "Domain Model"@en ;
    :hasBookReference "Chapter 1, Part 1.5"^^xsd:string ;
    :hasRepresentationFormat :DomainSpecificLanguage,
        :EntityRelationshipDiagram,
        :OWLOntology,
        :UMLClassDiagram ;
    :hasV4ID "V4_NEW_006"^^xsd:string ;
    dcterms:isPartOf :DomainEngineeringModule ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :validatedBy ],
        :DomainEngineeringConcept ;
    skos:definition "Formal or semi-formal representation of domain concepts, relationships, constraints, and business rules"@en ;
    skos:example "E-commerce domain model with 45 concepts (Customer, Product, Order, Payment, Shipment), 67 relationships, 23 business rules"@en .

:Tool a owl:Class ;
    rdfs:label "Tool or Platform"@en ;
    dcterms:isPartOf <http://ai4se.org/ontology/v4> ;
    skos:definition "Software tool, platform, framework, or system implementing AI for SE"@en .

v5:DatabaseDesign a owl:Class ;
    rdfs:label "Database Design"@en ;
    v5:complementsWellWith v5:CachingStrategy ;
    v5:complexityRating "High" ;
    v5:enables v5:DatabaseOptimization,
        v5:DatabaseScaling ;
    v5:hasBenefit "Ensures data integrity"@en,
        "Handles millions of products and billions of transactions"@en,
        "Optimized query performance (sub-100ms response)"@en,
        "Optimizes query performance (10-100x faster)"@en,
        "Scales to millions of records"@en,
        "Supports multi-tenant marketplace architecture"@en ;
    v5:hasChallenge "Balance between normalization and performance"@en,
        "Balancing normalization vs performance"@en,
        "Handling seasonal traffic spikes (10x normal)"@en,
        "Managing schema evolution with zero downtime"@en ;
    v5:hasResource [ rdfs:label "Database Design Best Practices"@en ;
            v5:downloadURL <https://www.postgresql.org/files/documentation/pdf/16/postgresql-16-A4.pdf> ;
            v5:resourceType "Technical Documentation"@en ],
        [ rdfs:label "DB-Engines PostgreSQL Profile"@en ;
            v5:downloadURL <https://db-engines.com/en/system/PostgreSQL> ],
        [ rdfs:label "PostgreSQL 15 Documentation"@en ;
            v5:downloadURL <https://www.postgresql.org/files/documentation/pdf/15/postgresql-15-A4.pdf> ] ;
    v5:maturityLevel "Mature" ;
    v5:requires v5:DataModeling,
        v5:RequirementsAnalysis ;
    v5:skillLevel "Senior" ;
    v5:supportsBusinessProcess v5:ProductCatalogManagement ;
    v5:usesTool v5:MongoDB,
        v5:MySQL,
        v5:PostgreSQL ;
    dcterms:isPartOf <http://ai4se.org/ontology/v5/module/Phase2Enrichment>,
        <http://ai4se.org/ontology/v5/module/Phase2MultiDomain>,
        <http://ai4se.org/ontology/v5/module/Phase3Structural> ;
    rdfs:subClassOf v5:SEConcept ;
    skos:definition "Process of producing detailed data model of database, including schema design, normalization, indexing strategy, and performance optimization for e-commerce workloads"@en,
        "Structured approach to creating database schema, relationships, and constraints optimized for e-commerce operations including high-volume transactions, inventory management, and customer analytics"@en .

v5:MachineLearning a owl:Class ;
    rdfs:label "Machine Learning"@en ;
    v5:complementsWellWith v5:DataScience ;
    v5:complexityRating "Very High" ;
    v5:enables v5:Automation,
        v5:Personalization ;
    v5:hasBenefit "Automates complex decision-making"@en,
        "Scales to millions of users"@en ;
    v5:hasChallenge "Model drift over time"@en,
        "Requires large training datasets"@en ;
    v5:hasResource [ rdfs:label "TensorFlow Guide"@en ;
            v5:downloadURL <https://www.tensorflow.org/guide> ],
        [ rdfs:label "Scikit-Learn Tutorial"@en ;
            v5:downloadURL <https://scikit-learn.org/stable/tutorial/index.html> ] ;
    v5:maturityLevel "Maturing" ;
    v5:requires v5:DataEngineering,
        v5:StatisticalAnalysis ;
    v5:skillLevel "Expert" ;
    v5:supportsBusinessProcess v5:RevenueOptimization ;
    v5:usesTool v5:PyTorch,
        v5:ScikitLearn,
        v5:TensorFlow ;
    dcterms:isPartOf <http://ai4se.org/ontology/v5/module/Phase2MultiDomain>,
        <http://ai4se.org/ontology/v5/module/Phase3Structural> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty v5:requires ;
            owl:someValuesFrom v5:DataEngineering ],
        v5:AI4SEConcept ;
    skos:definition "Algorithms and statistical models enabling computer systems to learn from data and improve performance on tasks without explicit programming, applied to e-commerce problems"@en .

<http://ai4se.org/ontology/v5/module/Phase15Final> rdfs:label "Phase 15 final enrichment: the last batch of enriched classes"@en ;
    dcterms:identifier "Phase15Final" ;
    dcterms:isPartOf <http://ai4se.org/ontology/v5> ;
    rdfs:comment "Module of the AI4SE package; 11 named terms were defined in this module's source."@en ;
    owl:versionInfo "5.0.1" .

v5:SecurityTesting a owl:Class ;
    rdfs:label "Security Testing"@en ;
    v5:complementsWellWith v5:DevSecOps ;
    v5:complementsWith v5:CodeReview,
        v5:StaticAnalysis ;
    v5:complexityRating "High" ;
    v5:enables v5:ComplianceTesting,
        v5:ComplianceValidation,
        v5:ThreatMitigation ;
    v5:hasBenefit "Builds customer trust and brand reputation"@en,
        "Ensures KVKK (Turkish GDPR) compliance"@en,
        "Ensures PCI-DSS compliance for payment processing"@en,
        "Ensures compliance (KVKK, PCI-DSS, GDPR)"@en,
        "Prevents data breaches and protects 10M+ customer records"@en,
        "Protects against DDoS attacks during campaign periods"@en,
        "Protects customer payment data"@en ;
    v5:hasBookReference "Chapter 28: Security Testing"@en,
        "Chapter 28: Security Testing & DevSecOps"@en ;
    v5:hasChallenge "Balance between security and user experience"@en,
        "Constantly evolving threat landscape"@en,
        "Requires specialized security expertise"@en,
        "Time-consuming manual testing processes"@en ;
    v5:hasResource [ rdfs:label "KVKK Compliance Guide for E-Commerce"@en ;
            v5:downloadURL <https://www.kvkk.gov.tr/SharedFolderServer/CMSFiles/d4105c1e-29ae-4ede-bbfa-7c61e94af546.pdf> ;
            v5:resourceType "Legal Compliance"@en ],
        [ rdfs:label "OWASP Top 10 2021"@en ;
            v5:downloadURL <https://owasp.org/www-project-top-ten/OWASP_Top_Ten_2021.pdf> ;
            v5:resourceType "Security Guide"@en ],
        [ rdfs:label "PCI DSS v4.0 Requirements"@en ;
            v5:downloadURL <https://docs-prv.pcisecuritystandards.org/PCI%20DSS/Standard/PCI-DSS-v4_0.pdf> ;
            v5:resourceType "Payment Security Standard"@en ],
        [ rdfs:label "OWASP Testing Guide v4.2"@en ;
            v5:downloadURL <https://github.com/OWASP/wstg/releases/download/v4.2/wstg-v4.2.pdf> ;
            v5:resourceType "Security Testing Framework"@en ],
        [ rdfs:label "KVKK Information Security Guidelines (Turkish)"@en ;
            v5:downloadURL <https://www.kvkk.gov.tr/SharedFolderServer/CMSFiles/Guideline_on_Information_Security.pdf> ;
            v5:resourceType "Compliance Guide"@en ],
        [ rdfs:label "PCI-DSS Quick Reference Guide"@en ;
            v5:downloadURL <https://www.pcisecuritystandards.org/documents/PCI_DSS-QRG-v3_2_1.pdf> ;
            v5:resourceType "Compliance Standard"@en ] ;
    v5:implementationTime 8 ;
    v5:maturityLevel "Mature" ;
    v5:relatedTo v5:PenetrationTesting,
        v5:VulnerabilityScanning ;
    v5:requires v5:PenetrationTesting,
        v5:SecurityExperts,
        v5:SecurityRequirements,
        v5:ThreatModeling,
        v5:VulnerabilityScanning ;
    v5:requiresForProduction v5:KVKKCompliance,
        v5:PCIDSSCompliance ;
    v5:requiresTechnique v5:ThreatModeling ;
    v5:skillLevel "Senior" ;
    v5:supportsBusinessProcess v5:CustomerDataProtection ;
    v5:supportsDomain v5:FashionRetailDomain ;
    v5:usesTool v5:BurpSuite,
        v5:Burp_Suite,
        v5:Nessus,
        v5:OWASP_ZAP ;
    dcterms:isPartOf <http://ai4se.org/ontology/v5/module/Phase2Enrichment>,
        <http://ai4se.org/ontology/v5/module/Phase2Security>,
        <http://ai4se.org/ontology/v5/module/Phase3Relationships>,
        <http://ai4se.org/ontology/v5/module/Phase3Structural> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty v5:requiresForProduction ;
            owl:someValuesFrom v5:SecurityExpertise ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty v5:usesTool ],
        v5:TestingTechnique ;
    owl:disjointWith v5:PerformanceTesting ;
    skos:definition "Systematic evaluation of software security through identification of vulnerabilities, threats, and risks, ensuring protection of customer data, payment information, and business operations in e-commerce environments"@en,
        "Systematic evaluation of system security through identification of vulnerabilities, threats, and security risks, including penetration testing, vulnerability scanning, and security audits"@en .

:ROICalculationMethod a owl:Class ;
    rdfs:label "ROI Calculation Method"@en ;
    :hasBookReference "Chapter 31, Part 1"^^xsd:string ;
    :hasFormula "ROI = ((Total Benefits - Total Costs) / Total Costs) × 100"^^xsd:string ;
    :hasV4ID "V4_NEW_031"^^xsd:string ;
    dcterms:isPartOf :ROIMetricsModule ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :hasInitialInvestment ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :hasExpectedROI ],
        :ROIConcept ;
    skos:definition "Systematic approach to calculating Return on Investment, including formula, inputs, outputs, and validation criteria"@en .

