v5:ComputerVision a owl:Class ;
    rdfs:label "Computer Vision"@en ;
    v5:complementsWellWith v5:AugmentedReality ;
    v5:complexityRating "Very High" ;
    v5:enables v5:QualityControl,
        v5:VisualSearch ;
    v5:hasBenefit "Automated quality control"@en ;
    v5:hasResource [ rdfs:label "OpenCV Documentation"@en ;
            v5:downloadURL <https://docs.opencv.org/4.x/> ] ;
    v5:maturityLevel "Emerging" ;
    v5:requires v5:ImageProcessing,
        v5:MachineLearning ;
    v5:supportsBusinessProcess v5:ProductDiscovery ;
    v5:usesTool v5:OpenCV,
        v5:TensorFlowObjectDetection,
        v5:YOLOv8 ;
    dcterms:isPartOf <http://ai4se.org/ontology/v5/module/Phase2MultiDomain>,
        <http://ai4se.org/ontology/v5/module/Phase3Structural> ;
    rdfs:subClassOf v5:MachineLearning ;
    skos:definition "ML techniques enabling computers to derive meaningful information from visual inputs, applied to visual search, quality control, and AR try-on in fashion retail"@en .

v5:DemandForecasting a owl:Class ;
    rdfs:label "Demand Forecasting"@en ;
    v5:complementsWellWith v5:PriceOptimization ;
    v5:complementsWith v5:InventoryOptimization,
        v5:SupplyChainManagement ;
    v5:complexityRating "High" ;
    v5:enables v5:InventoryOptimization,
        v5:ProactiveInventory,
        v5:SupplyChainOptimization ;
    v5:hasBenefit "Improves supply chain efficiency"@en,
        "Prevents stockouts (increases sales)"@en,
        "Reduces markdown/clearance needs"@en ;
    v5:hasChallenge "External factors (weather, economy, holidays)"@en,
        "Fast fashion rapid trend changes"@en ;
    v5:hasResource [ rdfs:label "Facebook Prophet - Time Series Forecasting"@en ;
            v5:downloadURL <https://facebook.github.io/prophet/docs/quick_start.html> ],
        [ rdfs:label "Demand Forecasting in Retail"@en ;
            v5:downloadURL <https://www.mckinsey.com/industries/retail/our-insights/demand-forecasting> ;
            v5:resourceType "Industry Research"@en ] ;
    v5:implementationTime 16 ;
    v5:maturityLevel "Mature" ;
    v5:optimizesFor v5:StockoutReduction ;
    v5:requires v5:ExternalFactors,
        v5:HistoricalData,
        v5:HistoricalSalesData,
        v5:TimeSeriesAnalysis ;
    v5:supportsBusinessProcess v5:InventoryManagement ;
    v5:supportsDomain v5:FashionRetailDomain ;
    dcterms:isPartOf <http://ai4se.org/ontology/v5/module/Phase2Enrichment>,
        <http://ai4se.org/ontology/v5/module/Phase2MultiDomain>,
        <http://ai4se.org/ontology/v5/module/Phase3Relationships>,
        <http://ai4se.org/ontology/v5/module/Phase3Structural> ;
    rdfs:subClassOf v5:MachineLearning,
        v5:MachineLearningTechnique ;
    skos:definition "ML models predicting future product demand based on historical sales, seasonality, trends, and external factors, optimizing inventory and reducing waste"@en,
        "Predictive machine learning models forecasting future product demand for inventory planning, considering seasonality, trends, and external factors in Turkish fashion market"@en .

