    v5:hasBookReference "Chapter 26: Data Engineering for Supply Chain"@en ;
    v5:hasChallenge "Complex international logistics (Turkey-EU-Asia)"@en,
        "Multi-currency and customs management"@en,
        "Seasonal demand variability in fashion"@en ;
    v5:hasResource [ rdfs:label "SCOR Framework 12.0"@en ;
            v5:downloadURL <https://www.apics.org/docs/default-source/scor-training/scor-12-0-framework.pdf> ] ;
    v5:integrates v5:ERPSystem,
        v5:WMS ;
    v5:integratesWith v5:ERPSystem,
        v5:WMSSystem ;
    v5:maturityLevel "Mature" ;
    v5:optimizesFor v5:CostReduction,
        v5:DeliverySpeed ;
    v5:requires v5:InventoryManagement,
        v5:LogisticsManagement ;
    v5:requiresForProduction v5:DemandForecasting,
        v5:InventoryOptimization,
        v5:LogisticsManagement,
        v5:WarehouseManagement ;
    v5:requiresTechnique v5:DemandForecasting,
        v5:InventoryOptimization ;
    v5:scalesTo v5:MillionTransactionsPerDay ;
    v5:supportsBusinessProcess v5:OrderFulfillment ;
    v5:supportsDomain v5:FashionRetailDomain ;
    v5:usesTool v5:OracleSupplyChainCloud,
        v5:SAPSupplyChain ;
    dcterms:isPartOf <http://ai4se.org/ontology/v5/module/HybridBase>,
