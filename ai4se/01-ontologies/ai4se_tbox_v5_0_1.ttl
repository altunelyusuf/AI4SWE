    rdfs:label "Static Code Analysis"@en ;
    v5:complementsWith v5:CodeReview,
        v5:UnitTesting ;
    v5:enables v5:EarlyBugDetection ;
    v5:hasBenefit "Enforces coding standards"@en,
        "Enforces coding standards automatically"@en,
        "Finds bugs before production (shift-left)"@en,
        "Reduces technical debt"@en ;
    v5:hasChallenge "High false positive rate requires tuning"@en,
        "Integration into CI/CD pipeline"@en ;
    v5:hasResource [ rdfs:label "SonarQube Documentation"@en ;
            v5:downloadURL <https://docs.sonarqube.org/latest/sonarqube-docs.pdf> ;
            v5:resourceType "Tool Documentation"@en ],
        [ rdfs:label "SonarQube Documentation"@en ;
            v5:downloadURL <https://docs.sonarqube.org/latest/> ] ;
    v5:optimizesFor v5:CodeQuality ;
    v5:requires v5:LintingTools,
        v5:SecurityScanning,
        v5:SonarQube ;
    v5:supportsDomain v5:SoftwareDevelopment ;
    v5:usesTool v5:Checkmarx,
        v5:ESLint,
        v5:Pylint,
        v5:SonarQube ;
    dcterms:isPartOf <http://ai4se.org/ontology/v5/module/Phase2Enrichment>,
        <http://ai4se.org/ontology/v5/module/Phase2MultiDomain>,
        <http://ai4se.org/ontology/v5/module/Phase3Relationships> ;
    rdfs:subClassOf v5:CodeAnalysisTechnique,
        v5:CodeQuality ;
    skos:definition "Automated analysis of source code without execution to detect bugs, code smells, security vulnerabilities, and adherence to coding standards"@en,
