v5:PaymentSecurity a owl:Class ;
    rdfs:label "Payment Security"@en ;
    v5:complementsWellWith v5:FraudDetection ;
    v5:complexityRating "Very High" ;
    v5:enables v5:PCIDSSCompliance ;
    v5:hasBenefit "Ensures PCI-DSS compliance (mandatory)"@en,
        "Protects customer payment information"@en ;
    v5:hasChallenge "Complex PCI-DSS requirements (12 requirements, 78 sub-requirements)"@en ;
    v5:hasResource [ rdfs:label "EMV 3-D Secure 2.0 Specification"@en ;
            v5:downloadURL <https://www.emvco.com/wp-content/uploads/documents/EMVCo_3DS_Spec_210_1017.pdf> ],
        [ rdfs:label "PCI-DSS v4.0 Standard"@en ;
            v5:downloadURL <https://www.pcisecuritystandards.org/documents/PCI_DSS-v4_0.pdf> ] ;
    v5:implementationTime 12 ;
    v5:maturityLevel "Mature" ;
    v5:requires v5:DataEncryption,
        v5:TokenizationService ;
    v5:skillLevel "Expert" ;
    v5:supportsBusinessProcess v5:OnlinePaymentProcessing ;
    v5:usesTool v5:PayTR,
        v5:Stripe,
        v5:iyzico ;
    dcterms:isPartOf <http://ai4se.org/ontology/v5/module/Phase2Security>,
        <http://ai4se.org/ontology/v5/module/Phase3Structural> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue v5:PCIDSSCompliance ;
            owl:onProperty v5:enables ],
        v5:SecurityTesting ;
    skos:definition "Specialized security for payment processing including PCI-DSS compliance, payment tokenization, secure payment gateways, and fraud detection"@en .

