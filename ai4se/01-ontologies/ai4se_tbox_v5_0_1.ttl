@prefix : <http://ai4se.org/ontology/v4#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix v5: <http://ai4se.org/ontology/v5#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:AWS a owl:Class ;
    rdfs:label "Amazon Web Services"@en ;
    :hasRegion "us-east-1, eu-central-1, eu-west-1"@en ;
    :hasV4ID "V4_NEW_261"^^xsd:string ;
    :offersService :FaaS,
        :IaaS,
        :PaaS ;
    dcterms:isPartOf :CloudContainerizationModule ;
    rdfs:subClassOf :CloudProvider ;
    skos:definition "Amazon's comprehensive cloud platform"@en .

:AdapterPattern a owl:Class ;
    rdfs:label "Adapter Pattern"@en ;
    :hasV4ID "V4_NEW_174"^^xsd:string ;
    dcterms:isPartOf :ArchitecturePatternsModule ;
    rdfs:subClassOf :StructuralPattern ;
    skos:definition "Allows incompatible interfaces to work together"@en ;
    skos:example "Adapter wrapping third-party API to match application interface"@en .

:Algorithm a owl:Class ;
    rdfs:label "Algorithm"@en ;
    dcterms:isPartOf <http://ai4se.org/ontology/v4> ;
    skos:definition "Well-defined computational procedure for AI in SE"@en .

:ApacheJenaFuseki a owl:Class ;
    rdfs:label "Apache Jena Fuseki"@en ;
    :hasToolURL "https://jena.apache.org/documentation/fuseki2/"^^xsd:anyURI ;
    :hasV4ID "V4_NEW_145"^^xsd:string ;
    dcterms:isPartOf :SemanticTechnologiesModule ;
    rdfs:subClassOf :TripleStore ;
    skos:definition "Open-source SPARQL server providing REST API and web UI"@en .

:ArithmeticOperatorReplacement a owl:Class ;
    rdfs:label "Arithmetic Operator Replacement"@en ;
    :hasAbbreviation "AOR"^^xsd:string ;
    :hasV4ID "V4_NEW_067"^^xsd:string ;
    dcterms:isPartOf :TestingTaxonomyModule ;
    rdfs:subClassOf :MutationOperator ;
    skos:definition "Replaces arithmetic operators with alternatives: +, -, *, /, %"@en .

:Azure a owl:Class ;
    rdfs:label "Microsoft Azure"@en ;
    :hasV4ID "V4_NEW_262"^^xsd:string ;
    dcterms:isPartOf :CloudContainerizationModule ;
    rdfs:subClassOf :CloudProvider ;
    skos:definition "Microsoft's cloud computing platform"@en .

:BlueGreenDeployment a owl:Class ;
    rdfs:label "Blue-Green Deployment"@en ;
    :hasBenefit "Easy testing before switch"@en,
        "Instant rollback"@en,
        "Zero downtime"@en ;
    :hasChallenge "Database migration complexity"@en,
        "Doubles infrastructure cost"@en ;
    :hasV4ID "V4_NEW_210"^^xsd:string ;
    dcterms:isPartOf :CICDAutomationModule ;
    rdfs:subClassOf :DeploymentStrategy ;
    owl:equivalentClass v5:BlueGreenDeployment ;
    skos:definition "Maintains two identical production environments, switches traffic instantly between them"@en ;
    skos:example "Blue (current) serves users while Green (new) is prepared; traffic switches to Green when ready"@en .

:BuildAutomation a owl:Class ;
    rdfs:label "Build Automation"@en ;
    :hasV4ID "V4_NEW_219"^^xsd:string ;
    dcterms:isPartOf :CICDAutomationModule ;
    rdfs:subClassOf :AutomationPractice ;
    skos:definition "Automating creation of software build including compilation, packaging, testing"@en .

:BuilderPattern a owl:Class ;
    rdfs:label "Builder Pattern"@en ;
    :appropriateFor "Objects with many optional parameters"@en ;
    :hasV4ID "V4_NEW_172"^^xsd:string ;
    dcterms:isPartOf :ArchitecturePatternsModule ;
    rdfs:subClassOf :CreationalPattern ;
    skos:definition "Constructs complex objects step by step"@en .

:BulkheadPattern a owl:Class ;
    rdfs:label "Bulkhead Pattern"@en ;
    :hasV4ID "V4_NEW_182"^^xsd:string ;
    dcterms:isPartOf :ArchitecturePatternsModule ;
    rdfs:subClassOf :CloudNativePattern ;
    skos:definition "Isolates resources to prevent total system failure"@en ;
    skos:example "Separate thread pools for different service dependencies"@en .

:CacheIntelligently a owl:Class ;
    rdfs:label "Cache Intelligently"@en ;
    :hasV4ID "V4_NEW_152"^^xsd:string ;
    dcterms:isPartOf :SemanticTechnologiesModule ;
    rdfs:subClassOf :SemanticTechnologyBestPractice ;
    skos:definition "Cache query results, not raw data"@en .

:CachingStrategy a owl:Class ;
    rdfs:label "Caching Strategy"@en ;
    :hasV4ID "V4_NEW_138"^^xsd:string ;
    dcterms:isPartOf :SemanticTechnologiesModule ;
    rdfs:subClassOf :QueryOptimization ;
    owl:equivalentClass v5:CachingStrategy ;
    skos:definition "Caching frequently-accessed query results to reduce database load"@en .

:CanaryDeployment a owl:Class ;
    rdfs:label "Canary Deployment"@en ;
    :hasBenefit "Gradual rollout control"@en,
        "Real-world validation"@en,
        "Reduces blast radius"@en ;
    :hasV4ID "V4_NEW_211"^^xsd:string ;
    :requiresTechnique :FeatureFlags,
        :Monitoring ;
    dcterms:isPartOf :CICDAutomationModule ;
    rdfs:subClassOf :DeploymentStrategy ;
    skos:definition "Gradually rolls out changes to small subset of users before full deployment"@en .

:CircleCI a owl:Class ;
    rdfs:label "CircleCI"@en ;
    :hasV4ID "V4_NEW_228"^^xsd:string ;
    dcterms:isPartOf :CICDAutomationModule ;
    rdfs:subClassOf :CIServer ;
    skos:definition "Cloud-based CI/CD platform"@en .

:CompetencyQuestion a owl:Class ;
    rdfs:label "Competency Question"@en ;
    dcterms:isPartOf <http://ai4se.org/ontology/v4> ;
    skos:definition "Question the ontology should be able to answer, used to validate coverage"@en ;
    skos:example "What AI tools are available for code completion? Which projects have ROI > 2.0?"@en .

:ConceptExtraction a owl:Class ;
    rdfs:label "Concept Extraction"@en ;
    :applicableLLMTechnique :PromptEngineering ;
    :applicableNLPTechnique :KeyphraseExtraction,
        :NamedEntityRecognition ;
    :hasBookReference "Chapter 1, Part 1.5, Stage 2"^^xsd:string ;
    :hasV4ID "V4_NEW_012"^^xsd:string ;
    :produces :ConceptList ;
    dcterms:isPartOf :DomainEngineeringModule ;
    rdfs:subClassOf :DomainAnalysisTechnique ;
    skos:definition "Identifying and extracting key domain concepts from documentation, interviews, and expert knowledge using NLP and LLM techniques"@en ;
    skos:example "Extracting 'Customer', 'Account', 'Transaction' concepts from 100 pages of banking requirements documents using named entity recognition"@en .

:ConceptExtractionPrompt a owl:Class ;
    rdfs:label "Concept Extraction Prompt"@en ;
    :hasBookReference "Chapter 1, Part 1.5"^^xsd:string ;
    :hasV4ID "V4_NEW_020"^^xsd:string ;
    :promptTemplate """You are a domain engineering expert. Analyze the following domain description and extract key concepts:

Domain: {{domain_name}}
Context: {{domain_context}}
Stakeholder Input: {{stakeholder_input}}

Extract and provide:
1. Core Concepts: List 10-20 key domain concepts (nouns)
2. Concept Definitions: Clear, concise definition for each
3. Concept Properties: Identify 3-5 key attributes per concept
4. Concept Hierarchies: Show is-a relationships (taxonomy)
5. Examples: Provide 2-3 concrete examples per concept

Output as structured JSON:
{
  "concepts": [
    {
      "name": "...",
      "definition": "...",
      "properties": ["...", "..."],
      "parent_concept": "...",
      "examples": ["...", "..."]
    }
  ]
}"""@en ;
    dcterms:isPartOf :DomainEngineeringModule ;
    rdfs:subClassOf :DomainEngineeringPrompt ;
    skos:definition "Prompt template for extracting domain concepts from unstructured text"@en .

:ConceptMentionValidation a owl:Class ;
    rdfs:label "Concept Mention Validation"@en ;
    :hasV4ID "V4_NEW_102"^^xsd:string ;
    dcterms:isPartOf :HybridSystemsModule ;
    rdfs:subClassOf :ValidationTechnique ;
    skos:definition "Verify LLM response references concepts from provided ontology context"@en .

:ConfigurationAsCode a owl:Class ;
    rdfs:label "Configuration as Code"@en ;
    :hasV4ID "V4_NEW_216"^^xsd:string ;
    dcterms:isPartOf :CICDAutomationModule ;
    rdfs:subClassOf :AutomationPractice ;
    skos:definition "Managing application configuration through code versioned in repository"@en .

:ContextInjection a owl:Class ;
    rdfs:label "Context Injection"@en ;
    :hasV4ID "V4_NEW_106"^^xsd:string ;
    dcterms:isPartOf :HybridSystemsModule ;
    rdfs:subClassOf :IntegrationStrategy ;
    skos:definition "Adding ontology knowledge directly into LLM prompt"@en ;
    skos:example "Query ontology, format results as markdown, prepend to user query"@en .

:ContinuousDeployment a owl:Class ;
    rdfs:label "Continuous Deployment"@en ;
    :hasV4ID "V4_NEW_203"^^xsd:string ;
    dcterms:isPartOf :CICDAutomationModule ;
    rdfs:subClassOf :ContinuousDelivery ;
    skos:definition "Practice where every change that passes automated tests is automatically deployed to production"@en ;
    skos:note "Fully automated pipeline from commit to production, no manual gates"@en .

:ContinuousIntegration a owl:Class ;
    rdfs:label "Continuous Integration"@en ;
    :hasBenefit "Early bug detection"@en,
        "Faster feedback"@en,
        "Reduced integration problems"@en ;
    :hasPrinciple "Automate the build"@en,
        "Everyone commits daily"@en,
        "Maintain single source repository"@en,
        "Make build self-testing"@en ;
    :hasV4ID "V4_NEW_201"^^xsd:string ;
    :requiresTool :BuildTool,
        :CIServer,
        :VersionControlSystem ;
    dcterms:isPartOf :CICDAutomationModule ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :requiresTool ;
            owl:someValuesFrom :CIServer ],
        :CICDConcept ;
    skos:definition "Practice of frequently integrating code changes into shared repository, with automated build and test"@en ;
    skos:example "Developers commit multiple times daily, triggering automated builds and tests within minutes"@en .

:CostBenefitAnalysis a owl:Class ;
    rdfs:label "Cost-Benefit Analysis"@en ;
    :hasBookReference "Chapter 31, Part 2"^^xsd:string ;
    :hasV4ID "V4_NEW_032"^^xsd:string ;
    dcterms:isPartOf :ROIMetricsModule ;
    rdfs:subClassOf :ROICalculationMethod ;
    skos:definition "Systematic comparison of costs versus benefits of AI4SE initiative over specific time period"@en .

:CostReduction a owl:Class ;
    rdfs:label "Cost Reduction"@en ;
    :hasV4ID "V4_NEW_044"^^xsd:string ;
    dcterms:isPartOf :ROIMetricsModule ;
    rdfs:subClassOf :BenefitCategory ;
    skos:definition "Direct reduction in operational expenses"@en .

:DataCatalog a owl:Class ;
    rdfs:label "Data Catalog"@en ;
    :hasV4ID "V4_NEW_292"^^xsd:string ;
    dcterms:isPartOf :DataEngineeringModule ;
    rdfs:subClassOf :DataGovernance ;
    skos:definition "Searchable inventory of data assets with metadata"@en .

:DataLakehouse a owl:Class ;
    rdfs:label "Data Lakehouse"@en ;
    :combines :DataLake,
        :DataWarehouse ;
    :hasV4ID "V4_NEW_278"^^xsd:string ;
    :usesTool :ApacheIceberg,
        :DeltaLake ;
    dcterms:isPartOf :DataEngineeringModule ;
    rdfs:subClassOf :DataStorage ;
    skos:definition "Architecture combining benefits of data lakes and warehouses"@en .

:DataLineage a owl:Class ;
    rdfs:label "Data Lineage"@en ;
    :hasBenefit "Compliance documentation"@en,
        "Debugging"@en,
        "Impact analysis"@en ;
    :hasV4ID "V4_NEW_291"^^xsd:string ;
    dcterms:isPartOf :DataEngineeringModule ;
    rdfs:subClassOf :DataGovernance ;
    skos:definition "Tracking data flow from origin through transformations to final destination"@en .

:DataProfiling a owl:Class ;
    rdfs:label "Data Profiling"@en ;
    :hasV4ID "V4_NEW_281"^^xsd:string ;
    dcterms:isPartOf :DataEngineeringModule ;
    rdfs:subClassOf :DataQuality ;
    skos:definition "Statistical analysis examining data to understand structure, content, quality"@en .

:DataValidation a owl:Class ;
    rdfs:label "Data Validation"@en ;
    :hasV4ID "V4_NEW_280"^^xsd:string ;
    :usesTool :GreatExpectations ;
    dcterms:isPartOf :DataEngineeringModule ;
    rdfs:subClassOf :DataQuality ;
    skos:definition "Process of checking data correctness and quality"@en .

:DecoratorPattern a owl:Class ;
    rdfs:label "Decorator Pattern"@en ;
    :hasV4ID "V4_NEW_175"^^xsd:string ;
    dcterms:isPartOf :ArchitecturePatternsModule ;
    rdfs:subClassOf :StructuralPattern ;
    skos:definition "Adds behavior to objects dynamically without modifying their code"@en .

:DeploymentRollback a owl:Class ;
    rdfs:label "Deployment Rollback"@en ;
    :hasTrigger "Error rate spike"@en,
        "Failed health checks"@en,
        "Manual intervention"@en ;
    :hasV4ID "V4_NEW_233"^^xsd:string ;
    dcterms:isPartOf :CICDAutomationModule ;
    rdfs:subClassOf :CICDConcept ;
    skos:definition "Reverting to previous version when deployment fails"@en .

:DescriptiveAnalytics a owl:Class ;
    rdfs:label "Descriptive Analytics"@en ;
    :hasV4ID "V4_NEW_283"^^xsd:string ;
    dcterms:isPartOf :DataEngineeringModule ;
    rdfs:subClassOf :DataAnalytics ;
    skos:definition "What happened? - Historical data analysis"@en ;
    skos:example "Monthly sales reports, website traffic dashboards"@en .

:DiagnosticAnalytics a owl:Class ;
    rdfs:label "Diagnostic Analytics"@en ;
    :hasV4ID "V4_NEW_284"^^xsd:string ;
    dcterms:isPartOf :DataEngineeringModule ;
    rdfs:subClassOf :DataAnalytics ;
    skos:definition "Why did it happen? - Root cause analysis"@en .

:Docker a :Tool,
        owl:Class ;
    rdfs:label "Docker"@en ;
    :hasBenefit "Consistent environments"@en,
        "Isolation"@en,
        "Rapid deployment"@en ;
    :hasCategory "Cloud-Native"@en ;
    :hasComponent :DockerContainer,
        :DockerImage,
        :Dockerfile ;
    :hasToolURL "https://www.docker.com"^^xsd:anyURI ;
    :hasV4ID "V4_NEW_247"^^xsd:string ;
    dcterms:isPartOf <http://ai4se.org/ontology/v4>,
        :CloudContainerizationModule ;
    rdfs:subClassOf :ContainerTechnology ;
    skos:definition "Containerization"@en,
        "Platform for developing, shipping, running containerized applications"@en .

:DockerRegistry a owl:Class ;
    rdfs:label "Docker Registry"@en ;
    :hasV4ID "V4_NEW_230"^^xsd:string ;
    dcterms:isPartOf :CICDAutomationModule ;
    rdfs:subClassOf :ArtifactRepository ;
    skos:definition "Repository for Docker container images"@en .

:DockerSwarm a owl:Class ;
    rdfs:label "Docker Swarm"@en ;
    :hasV4ID "V4_NEW_256"^^xsd:string ;
    dcterms:isPartOf :CloudContainerizationModule ;
    rdfs:subClassOf :ContainerOrchestration ;
    skos:definition "Native clustering and orchestration for Docker"@en .

:DocumentationGeneration a owl:Class ;
    rdfs:label "Documentation Generation"@en ;
    :hasV4ID "V4_NEW_143"^^xsd:string ;
    dcterms:isPartOf :SemanticTechnologiesModule ;
    rdfs:subClassOf :CICDIntegration ;
    skos:definition "Automatically generating API/ontology documentation from RDF"@en .

:DomainConceptualization a owl:Class ;
    rdfs:label "Domain Conceptualization"@en ;
    :hasBookReference "Chapter 1, Part 1.5"^^xsd:string ;
    :hasV4ID "V4_NEW_009"^^xsd:string ;
    :precedesInWorkflow :DomainModel ;
    dcterms:isPartOf :DomainEngineeringModule ;
    rdfs:subClassOf :DomainEngineeringConcept ;
    skos:definition "Abstract understanding of domain structure independent of implementation, focusing on what exists and how things relate rather than technical details"@en .

:ELTPipeline a owl:Class ;
    rdfs:label "ELT Pipeline"@en ;
    :appropriateFor "Cloud data warehouses with strong compute"@en ;
    :hasBenefit "Leverages destination compute power"@en ;
    :hasV4ID "V4_NEW_273"^^xsd:string ;
    dcterms:isPartOf :DataEngineeringModule ;
    rdfs:subClassOf :DataPipeline ;
    skos:definition "Extract, Load, Transform - loads raw data first, transforms in destination"@en .

:ETLPipeline a owl:Class ;
    rdfs:label "ETL Pipeline"@en ;
    :hasV4ID "V4_NEW_272"^^xsd:string ;
    dcterms:isPartOf :DataEngineeringModule ;
    rdfs:subClassOf :DataPipeline ;
    skos:definition "Extract, Transform, Load - traditional data integration pattern"@en ;
    skos:example "Nightly batch extracting from OLTP, transforming, loading into data warehouse"@en .

:EUEconomicContext a owl:Class ;
    rdfs:label "EU Economic Context"@en ;
    :hasBenefitMultiplier 0.85 ;
    :hasSalaryMultiplier 0.8 ;
    :hasToolCostMultiplier 0.9 ;
    :hasV4ID "V4_NEW_051"^^xsd:string ;
    dcterms:isPartOf :ROIMetricsModule ;
    rdfs:subClassOf :RegionalContext ;
    skos:definition "European Union average market conditions"@en .

:EventDrivenArchitecture a owl:Class ;
    rdfs:label "Event-Driven Architecture"@en ;
    :hasBenefit "High scalability"@en,
        "Loose coupling between services"@en,
        "Real-time processing"@en ;
    :hasV4ID "V4_NEW_164"^^xsd:string ;
    :requiresTechnology :MessageBroker ;
    :usesTool :Kafka,
        :RabbitMQ ;
    dcterms:isPartOf :ArchitecturePatternsModule ;
    rdfs:subClassOf :ArchitecturalStyle ;
    owl:equivalentClass v5:EventDrivenArchitecture ;
    skos:definition "Architecture where components communicate through events, enabling loose coupling and asynchronous processing"@en ;
    skos:example "E-commerce: OrderPlaced event triggers inventory, shipping, notification services"@en .

:FactoryPattern a owl:Class ;
    rdfs:label "Factory Pattern"@en ;
    :hasV4ID "V4_NEW_171"^^xsd:string ;
    dcterms:isPartOf :ArchitecturePatternsModule ;
    rdfs:subClassOf :CreationalPattern ;
    skos:definition "Creates objects without specifying exact class to create"@en .

:FeatureFlag a owl:Class ;
    rdfs:label "Feature Flag"@en ;
    :hasBenefit "A/B testing capability"@en,
        "Decouple deployment from release"@en,
        "Quick feature rollback"@en ;
    :hasV4ID "V4_NEW_232"^^xsd:string ;
    dcterms:isPartOf :CICDAutomationModule ;
    rdfs:subClassOf :CICDConcept ;
    skos:definition "Technique allowing features to be toggled on/off without deploying code"@en .

:FeatureStore a owl:Class ;
    rdfs:label "Feature Store"@en ;
    :hasBenefit "Feature reuse across models"@en,
        "Training-serving consistency"@en ;
    :hasV4ID "V4_NEW_288"^^xsd:string ;
    :usesTool :Feast ;
    dcterms:isPartOf :DataEngineeringModule ;
    rdfs:subClassOf :DataConcept ;
    skos:definition "Centralized repository storing, managing, serving ML features"@en .

:FunctionalTesting a owl:Class ;
    rdfs:label "Functional Testing"@en ;
    :hasV4ID "V4_NEW_062"^^xsd:string ;
    dcterms:isPartOf :TestingTaxonomyModule ;
    rdfs:subClassOf :TestingObjective ;
    skos:definition "Testing to verify that software functions according to requirements and specifications"@en .

:FuzzTesting a owl:Class ;
    rdfs:label "Fuzz Testing"@en ;
    :appropriateFor "Network protocol implementations"@en,
        "Parsers and file format handlers"@en,
        "Security-critical components"@en ;
    :hasBookReference "Chapter 5, Part 8"^^xsd:string ;
    :hasToolExample :AFL,
        :Jazzer,
        :LibFuzzer ;
    :hasV4ID "V4_NEW_080"^^xsd:string ;
    dcterms:isPartOf :TestingTaxonomyModule ;
    rdfs:subClassOf :AdvancedTestingTechnique ;
    skos:definition "Automated testing technique providing invalid, unexpected, or random data as inputs to find crashes, memory leaks, and security vulnerabilities"@en ;
    skos:example "Feeding random bytes to PDF parser to find buffer overflows and crashes"@en .

:GitHubActions a owl:Class ;
    rdfs:label "GitHub Actions"@en ;
    :hasBenefit "Integrated with GitHub"@en,
        "Marketplace of actions"@en ;
    :hasV4ID "V4_NEW_226"^^xsd:string ;
    dcterms:isPartOf :CICDAutomationModule ;
    rdfs:subClassOf :CIServer ;
    skos:definition "GitHub-native CI/CD platform"@en .

:GitLabCI a owl:Class ;
    rdfs:label "GitLab CI"@en ;
    :hasV4ID "V4_NEW_227"^^xsd:string ;
    dcterms:isPartOf :CICDAutomationModule ;
    rdfs:subClassOf :CIServer ;
    skos:definition "Built-in CI/CD in GitLab"@en .

:GitOps a owl:Class ;
    rdfs:label "GitOps"@en ;
    :hasPrinciple "Automated deployment agents"@en,
        "Continuous reconciliation"@en,
        "Declarative desired state in Git"@en ;
    :hasV4ID "V4_NEW_218"^^xsd:string ;
    :usesTool :ArgoCD,
        :FluxCD ;
    dcterms:isPartOf :CICDAutomationModule ;
    rdfs:subClassOf :AutomationPractice ;
    skos:definition "Operational model using Git as single source of truth for declarative infrastructure and applications"@en .

:GoogleCloud a owl:Class ;
    rdfs:label "Google Cloud Platform"@en ;
    :hasV4ID "V4_NEW_263"^^xsd:string ;
    dcterms:isPartOf :CloudContainerizationModule ;
    rdfs:subClassOf :CloudProvider ;
    skos:definition "Google's cloud computing services"@en .

:Gradle a owl:Class ;
    rdfs:label "Gradle"@en ;
    :hasV4ID "V4_NEW_222"^^xsd:string ;
    :supportsLanguage "Groovy"@en,
        "Java"@en,
        "Kotlin"@en ;
    dcterms:isPartOf :CICDAutomationModule ;
    rdfs:subClassOf :BuildTool ;
    skos:definition "Build automation tool supporting multiple languages"@en .

:GraphDB a owl:Class ;
    rdfs:label "GraphDB"@en ;
    :hasV4ID "V4_NEW_146"^^xsd:string ;
    dcterms:isPartOf :SemanticTechnologiesModule ;
    rdfs:subClassOf :TripleStore ;
    skos:definition "Enterprise semantic graph database with advanced reasoning"@en .

:Helm a owl:Class ;
    rdfs:label "Helm"@en ;
    :hasV4ID "V4_NEW_266"^^xsd:string ;
    :manages "Kubernetes applications via charts"@en ;
    dcterms:isPartOf :CloudContainerizationModule ;
    rdfs:subClassOf :CloudConcept ;
    skos:definition "Package manager for Kubernetes"@en .

:HexagonalArchitecture a owl:Class ;
    rdfs:label "Hexagonal Architecture"@en ;
    :hasBenefit "Easy to test"@en,
        "Flexible integration"@en,
        "Technology-independent core"@en ;
    :hasV4ID "V4_NEW_167"^^xsd:string ;
    dcterms:isPartOf :ArchitecturePatternsModule ;
    rdfs:subClassOf :ArchitecturalStyle ;
    skos:altLabel "Ports and Adapters"@en ;
    skos:definition "Ports and adapters pattern isolating core business logic from external concerns"@en .

:IndexStrategically a owl:Class ;
    rdfs:label "Index Strategically"@en ;
    :hasV4ID "V4_NEW_151"^^xsd:string ;
    dcterms:isPartOf :SemanticTechnologiesModule ;
    rdfs:subClassOf :SemanticTechnologyBestPractice ;
    skos:definition "Focus indexing on frequently queried properties"@en .

:IndexStrategy a owl:Class ;
    rdfs:label "Index Strategy"@en ;
    :hasV4ID "V4_NEW_137"^^xsd:string ;
    dcterms:isPartOf :SemanticTechnologiesModule ;
    rdfs:subClassOf :QueryOptimization ;
    skos:definition "Approach to indexing RDF triples for fast query performance"@en ;
    skos:example "SPO, PSO, OSP index combinations for different query patterns"@en .

:InfrastructureAsCode a owl:Class ;
    rdfs:label "Infrastructure as Code"@en ;
    :hasBenefit "Disaster recovery"@en,
        "Reproducible environments"@en,
        "Version controlled infrastructure"@en ;
    :hasV4ID "V4_NEW_215"^^xsd:string ;
    :usesTool :Ansible,
        :CloudFormation,
        :Terraform ;
    dcterms:isPartOf :CICDAutomationModule ;
    rdfs:subClassOf :AutomationPractice ;
    owl:equivalentClass v5:InfrastructureAsCode ;
