v5:FraudDetection a owl:Class ;
    rdfs:label "Fraud Detection"@en ;
    v5:complementsWith v5:RiskManagement,
        v5:SecurityTesting ;
    v5:enables v5:TransactionSecurity ;
    v5:hasBenefit "Real-time detection (<100ms)"@en ;
    v5:hasChallenge "High false positive rate (legitimate customers blocked)"@en,
        "Sophisticated fraud techniques evolving"@en ;
    v5:hasResource [ rdfs:label "E-Commerce Fraud Prevention Guide"@en ;
            v5:downloadURL <https://www.ravelin.com/insights/ecommerce-fraud-prevention-guide> ;
            v5:resourceType "Best Practices"@en ] ;
    v5:optimizesFor v5:FraudPrevention ;
    v5:requires v5:DeviceFingerprinting,
        v5:MachineLearning,
        v5:RealTimeProcessing ;
    v5:supportsDomain v5:Ecommerce ;
    v5:usesTool v5:Riskified,
        v5:Sift ;
    dcterms:isPartOf <http://ai4se.org/ontology/v5/module/Phase2Enrichment>,
        <http://ai4se.org/ontology/v5/module/Phase3Relationships> ;
    rdfs:subClassOf v5:AI4SEConcept ;
    skos:definition "Real-time machine learning system to detect and prevent fraudulent transactions, fake accounts, and payment fraud in Turkish e-commerce"@en .

