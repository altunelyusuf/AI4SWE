v5:SupplyChainManagement a owl:Class ;
    rdfs:label "Supply Chain Management"@en ;
    v5:complementsWellWith v5:DemandForecasting ;
    v5:complementsWith v5:ProductLifecycleManagement ;
    v5:complexityRating "Very High" ;
    v5:enables v5:CostReduction,
        v5:FasterDelivery ;
