@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://ai4se.org/ontology/v5/shacl> a owl:Ontology ;
    rdfs:label "AI4SE ontology, edition 5.1: shapes"@en ;
    dcterms:contributor "Yusuf Altunel (curator)" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:provenance "An AI product: developed with various Claude models (Anthropic) under the curation of Yusuf Altunel."@en ;
    rdfs:comment "Constraints for the AI4SE package: every class, property and individual carries a human label; every module is complete; a definition is requested for classes (advisory)."@en ;
    owl:imports <http://ai4se.org/ontology/v5> ;
    owl:versionIRI <http://ai4se.org/ontology/v5/shacl/1.1.0> ;
    owl:versionInfo "1.1.0" .

<http://ai4se.org/ontology/v5/shape/ClassDefinitionShape> a sh:NodeShape ;
    sh:message "Advisory: a class should carry a skos:definition. A Warning is not conformance (L-66)."@en ;
    sh:or ( [ sh:nodeKind sh:BlankNode ] [ a sh:NodeShape ;
                sh:property [ sh:minCount 1 ;
                        sh:path skos:definition ] ] ) ;
    sh:severity sh:Warning ;
    sh:targetClass owl:Class .

<http://ai4se.org/ontology/v5/shape/ClassLabelShape> a sh:NodeShape ;
    sh:message "Every named class needs a human-readable label (B7)."@en ;
    sh:or ( [ sh:nodeKind sh:BlankNode ] [ a sh:NodeShape ;
                sh:property [ sh:minCount 1 ;
                        sh:path rdfs:label ] ] ) ;
    sh:targetClass owl:Class .

<http://ai4se.org/ontology/v5/shape/DatatypePropertyLabelShape> a sh:NodeShape ;
    sh:property [ sh:message "Every datatype property needs a human-readable label (B7)."@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ] ;
    sh:targetClass owl:DatatypeProperty .

<http://ai4se.org/ontology/v5/shape/IndividualLabelShape> a sh:NodeShape ;
    sh:property [ sh:message "Every named individual needs a human-readable label (B7)."@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ] ;
    sh:targetClass owl:NamedIndividual .

<http://ai4se.org/ontology/v5/shape/MembershipShape> a sh:NodeShape ;
    sh:message "Every named class belongs to at least one module (M1)."@en ;
    sh:or ( [ sh:nodeKind sh:BlankNode ] [ a sh:NodeShape ;
                sh:property [ sh:minCount 1 ;
                        sh:nodeKind sh:IRI ;
                        sh:path dcterms:isPartOf ] ] ) ;
    sh:targetClass owl:Class .

<http://ai4se.org/ontology/v5/shape/ModuleShape> a sh:NodeShape ;
    sh:property [ sh:message "Every module needs a human-readable label."@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:hasValue <http://ai4se.org/ontology/v5> ;
            sh:message "Every module is part of the package ontology."@en ;
            sh:minCount 1 ;
            sh:path dcterms:isPartOf ],
        [ sh:message "Every module needs its own version."@en ;
            sh:minCount 1 ;
            sh:path owl:versionInfo ] ;
    sh:targetSubjectsOf dcterms:identifier .

<http://ai4se.org/ontology/v5/shape/ObjectPropertyLabelShape> a sh:NodeShape ;
    sh:property [ sh:message "Every object property needs a human-readable label (B7)."@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ] ;
    sh:targetClass owl:ObjectProperty .

<http://www.semanticweb.org/ontologies/2025/AI4SE#AI4SESystemShape> a sh:NodeShape ;
    dcterms:isPartOf <http://www.semanticweb.org/ontologies/2025/AI4SE/QualityAssurance> ;
    sh:property [ sh:class <http://example.org/o4ai#AICapability> ;
            sh:message "AI4SE System must use at least one AI capability" ;
            sh:minCount 1 ;
            sh:path <http://www.semanticweb.org/ontologies/2025/AI4SE#usesAICapability> ;
            sh:severity sh:Warning ],
        [ sh:class <http://www.semanticweb.org/ontologies/2025/O4SE#SoftwareProcess> ;
            sh:message "AI4SE System must enhance at least one SE process" ;
            sh:minCount 1 ;
            sh:path <http://www.semanticweb.org/ontologies/2025/AI4SE#enhances> ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Warning ;
    sh:targetClass <http://www.semanticweb.org/ontologies/2025/AI4SE#AI4SESSystem> .

<http://www.semanticweb.org/ontologies/2025/AI4SE#AIEnhancedProcessShape> a sh:NodeShape ;
    dcterms:isPartOf <http://www.semanticweb.org/ontologies/2025/AI4SE/QualityAssurance> ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:maxInclusive 100 ;
            sh:message "Automation level must be between 0 and 100" ;
            sh:minInclusive 0 ;
            sh:path <http://www.semanticweb.org/ontologies/2025/AI4SE#automationLevel> ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:decimal ;
            sh:maxInclusive 1 ;
            sh:message "Human intervention rate must be between 0 and 1" ;
            sh:minInclusive 0 ;
            sh:path <http://www.semanticweb.org/ontologies/2025/AI4SE#humanInterventionRate> ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Warning ;
    sh:targetClass <http://www.semanticweb.org/ontologies/2025/AI4SE#AIEnhancedProcess> .

<http://www.semanticweb.org/ontologies/2025/AI4SE#AIInfrastructureShape> a sh:NodeShape ;
    dcterms:isPartOf <http://www.semanticweb.org/ontologies/2025/AI4SE/QualityAssurance> ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:message "Compute capacity must be positive" ;
            sh:minExclusive 0 ;
            sh:path <http://www.semanticweb.org/ontologies/2025/AI4SE#computeCapacity> ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Warning ;
    sh:targetClass <http://www.semanticweb.org/ontologies/2025/AI4SE#AIInfrastructure> .

<http://www.semanticweb.org/ontologies/2025/AI4SE#AIPoweredToolShape> a sh:NodeShape ;
    dcterms:isPartOf <http://www.semanticweb.org/ontologies/2025/AI4SE/QualityAssurance> ;
    sh:property [ sh:class <http://www.semanticweb.org/ontologies/2025/AI4SE#AIInfrastructure> ;
            sh:message "Tool infrastructure requirement must be AI infrastructure" ;
            sh:path <http://www.semanticweb.org/ontologies/2025/AI4SE#requiresInfrastructure> ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Tool version must follow semantic versioning" ;
            sh:path <http://www.semanticweb.org/ontologies/2025/AI4SE#toolVersion> ;
            sh:pattern "^\\d+\\.\\d+\\.\\d+$" ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Warning ;
    sh:targetClass <http://www.semanticweb.org/ontologies/2025/AI4SE#AIPoweredTool> .

<http://www.semanticweb.org/ontologies/2025/AI4SE#IntegrationPatternShape> a sh:NodeShape ;
    dcterms:isPartOf <http://www.semanticweb.org/ontologies/2025/AI4SE/QualityAssurance> ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "Integration pattern must have description" ;
            sh:minCount 1 ;
            sh:path rdfs:comment ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Integration pattern must have competency question" ;
            sh:minCount 1 ;
            sh:path <http://example.org/ontology-engineering#hasCompetencyQuestion> ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Warning ;
    sh:targetClass <http://www.semanticweb.org/ontologies/2025/AI4SE#IntegrationPattern> .

