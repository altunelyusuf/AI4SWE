configuration:Shape_FilenameSubjectPrefixAlignmentCompleteness a sh:NodeShape ;
    rdfs:label "FilenameSubjectPrefixAlignment annotation completeness"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    sh:property [ sh:message "FSPA must have dcterms:source"@en ;
            sh:minCount 1 ;
            sh:path dcterms:source ;
            sh:severity sh:Violation ],
        [ sh:message "FSPA must have skos:definition"@en ;
            sh:minCount 1 ;
            sh:path skos:definition ;
            sh:severity sh:Violation ],
        [ sh:message "FSPA must have rdfs:label"@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ;
            sh:severity sh:Violation ] ;
    sh:targetNode configuration:FilenameSubjectPrefixAlignment .

configuration:SprintManifestHasEntriesShape a sh:NodeShape ;
    rdfs:label "AMOD S1: SprintManifest must declare at least one artefact"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "a reliability ontology v2.4.9 — C8Out gate and SprintClosureChecklist. USO v2.0 Sprint 12 post-mortem. ISO/IEC 15289:2019 Systems and software engineering — Content of life-cycle information items."@en ;
    rdfs:isDefinedBy <http://example.org/configuration-shacl> ;
    skos:definition "Every configuration:SprintManifest instance must have at least one configuration:declaredInManifest triple. A manifest with no declared artefact entries cannot serve as evidence for a reliability ontology C8Out gate validation — it is an empty container that carries no sprint completeness information."@en ;
    sh:property [ sh:message "AMOD S1 FAIL: SprintManifest {$this} has no artefacts linked via configuration:declaredInManifest. Every sprint manifest must declare at least one deliverable artefact."@en ;
            sh:minCount 1 ;
            sh:path [ sh:inversePath configuration:declaredInManifest ] ;
            sh:severity sh:Violation ] ;
    sh:severity sh:Violation ;
    sh:targetClass configuration:SprintManifest .

