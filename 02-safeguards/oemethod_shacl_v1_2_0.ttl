redo1:OntologyDrivenOverstatementShape a sh:NodeShape ;
    rdfs:label "INCIDENT ONTOOVER-V1: OntologyDrivenOverstatement incident record must be audit-ready"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    rdfs:comment "Validates that every recorded OntologyDrivenOverstatement incident has the evidence fields needed for honest audit: hasSeverity, source (provenance), :detectedBy (mechanism attribution). Does NOT detect drift in unflagged data — see Phase 2.7 gap analysis for honest scope."@en ;
    sh:property [ sh:message "INCIDENT ONTOOVER-V1: OntologyDrivenOverstatement {$this} must cite at least one dcterms:source (provenance)."@en ;
            sh:minCount 1 ;
            sh:path dcterms:source ],
        [ sh:maxCount 1 ;
            sh:message "[ADVISORY per L-20+L-49] Multiple detectedBy attributions enrich audit. INCIDENT ONTOOVER-V1: OntologyDrivenOverstatement {$this} must declare exactly one :detectedBy mechanism. Without attribution, autonomous-detection-rate cannot be mechanically computed."@en ;
            sh:minCount 1 ;
            sh:path redo1:detectedBy ;
            sh:severity sh:Warning ],
