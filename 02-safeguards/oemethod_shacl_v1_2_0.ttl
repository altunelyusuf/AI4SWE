    rdfs:comment "Semantic SHACL NodeShape per BP-D30. Declares 1 property constraint(s) for Agent sourced from rdfs:domain assertions."@en ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:class core:Role ;
            sh:maxCount 1 ;
            sh:message "Property hasRole should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path core:hasRole ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Warning ;
    sh:targetClass core:Agent .

