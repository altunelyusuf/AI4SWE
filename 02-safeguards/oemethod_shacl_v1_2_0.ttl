    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "OE Pack Option C — lightweight semantic upgrade for reliability per BP-D30."@en ;
    rdfs:comment "Lightweight semantic SHACL NodeShape per BP-D30. DomainSpecificFailure has no direct rdfs:domain assertions; constraints inherit via OWL subClassOf entailment. Direct: sh:nodeKind sh:IRI."@en ;
