algorithm_efficiency:AccountingMethod_Shape a sh:NodeShape ;
    rdfs:label "Lightweight semantic shape for AccountingMethod"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "OE Pack Option C — lightweight semantic upgrade for algorithm-efficiency per BP-D30."@en ;
    rdfs:comment "Lightweight semantic SHACL NodeShape per BP-D30. AccountingMethod has no direct rdfs:domain assertions; constraints inherit via OWL subClassOf entailment. Direct: sh:nodeKind sh:IRI."@en ;
