configuration:VersionTokenHasValueShape a sh:NodeShape ;
    rdfs:label "AMOD S2: VersionToken must declare its string value"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "Semantic Versioning 2.0.0 (semver.org). a reliability ontology v2.4.9 — C8Out gate and SprintClosureChecklist. USO v2.0 Sprint 12 post-mortem."@en ;
    rdfs:isDefinedBy <http://example.org/configuration-shacl> ;
    skos:definition "Every configuration:VersionToken instance must have exactly one configuration:tokenValue datatype property containing the version string as it appears in the filename (e.g., 'v2_4_9'). Without this value, the token cannot be programmatically extracted or validated against owl:versionInfo."@en ;
    sh:property [ sh:minCount 1 ;
            sh:path configuration:tokenValue ;
            sh:severity sh:Violation ] ;
    sh:severity sh:Violation ;
    sh:targetClass configuration:VersionToken .

<http://example.org/configuration-shacl#S-Closure> a sh:NodeShape ;
    rdfs:label "AMOD S-Closure: ProjectClosureDocument filename pattern"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "configuration:ProjectClosureMarkdownConvention.filenamePattern; I-04 remediation."@en ;
    rdfs:isDefinedBy <http://example.org/configuration-shacl> ;
    skos:definition "Every configuration:ProjectClosureDocument with declared configuration:artifactFilename must match regex '^[A-Za-z][A-Za-z0-9_]*_v\\\\d+_\\\\d+_\\\\d+\\\\.md$' (underscore-delimited 3-part version)."@en ;
    sh:property [ sh:message "AMOD S-Closure VIOLATION: ProjectClosureDocument filename must match pattern '{name}_v{M}_{m}_{p}.md' (underscore + 3-part version, e.g., Sprint_8_Closure_v1_0_0.md)."@en ;
            sh:path configuration:artifactFilename ;
            sh:pattern "^[A-Za-z][A-Za-z0-9_]*_v\\d+_\\d+_\\d+\\.md$" ;
            sh:severity sh:Violation ] ;
    sh:severity sh:Violation ;
    sh:targetClass configuration:ProjectClosureDocument .

<http://example.org/configuration-shacl#S10> a sh:NodeShape ;
    rdfs:label "AMOD S10: USOTestModule filename must match USOTestModuleConvention"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "AMOD BS-04 remediation April 2026."@en ;
    rdfs:isDefinedBy <http://example.org/configuration-shacl> ;
    skos:definition "Every configuration:USOTestModule artifactFilename must match: uso-{module}-tests-v{M}_{m}.ttl."@en ;
    sh:property [ sh:message "AMOD S10 WARNING: USOTestModule {$this} missing configuration:artifactFilename."@en ;
            sh:minCount 1 ;
            sh:path configuration:artifactFilename ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Violation ;
    sh:sparql [ sh:message "AMOD S10 VIOLATION: USOTestModule filename does not match uso-{module}-tests-v{M}_{m}.ttl."@en ;
            sh:select """PREFIX configuration: <http://example.org/configuration#>
SELECT $this WHERE {
  $this a configuration:USOTestModule ;
        configuration:artifactFilename ?fn .
  FILTER (!REGEX(STR(?fn), "^uso-[a-z0-9-]+-tests-v[0-9]+_[0-9]+[.]ttl$"))
}""" ;
            sh:severity sh:Violation ] ;
    sh:targetClass configuration:USOTestModule .

<http://example.org/configuration-shacl#S6> a sh:NodeShape ;
    rdfs:label "AMOD S6: SafeguardDocument filename must conform to SafeguardDocConvention"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "configuration:SafeguardDocConvention.filenamePattern = '{prefix}_safeguard_{variant}_v{M}.{m}.md'. a reliability ontology ecosystem AMOD compliance sprint, April 2026."@en ;
    rdfs:isDefinedBy <http://example.org/configuration-shacl> ;
    skos:definition "Every configuration:SafeguardDocument individual whose configuration:artifactFilename is declared must have a filename conforming to the pattern {prefix}_safeguard_{variant}_v{M}.{m}.md (DOT delimiter, two-part version). Enforces configuration:SafeguardDocConvention and configuration:SafeguardDocVersionPolicy at the graph level via SPARQL ASK."@en ;
    sh:property [ sh:message "AMOD S6 WARNING: SafeguardDocument {$this} does not declare an configuration:artifactFilename. Cannot verify SafeguardDocConvention compliance without a declared filename."@en ;
            sh:minCount 1 ;
            sh:path configuration:artifactFilename ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Violation ;
    sh:sparql [ sh:message "AMOD S6 VIOLATION: SafeguardDocument {$this} has an artifactFilename that does not match the SafeguardDocConvention pattern {prefix}_safeguard_{variant}_v{M}.{m}.md. Use DOT delimiter for version (v1.2, not v1_2) and two-part version only."@en ;
            sh:select """PREFIX configuration: <http://example.org/configuration#>
SELECT $this WHERE {
  $this a configuration:SafeguardDocument ;
        configuration:artifactFilename ?fn .
  FILTER (!REGEX(?fn,
    "^[a-zA-Z0-9]+_safeguard_[a-zA-Z0-9_]+_v[0-9]+\\\\.[0-9]+\\\\.md$"
  ))
}""" ;
            sh:severity sh:Violation ] ;
    sh:targetClass configuration:SafeguardDocument .

<http://example.org/configuration-shacl#S7> a sh:NodeShape ;
    rdfs:label "AMOD S7: DocumentationFile filename must use underscore convention"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "configuration:DocumentationFileConvention.filenamePattern = '{name}_v{M}_{m}.md'. AMOD naming gap remediation sprint, April 2026."@en ;
    rdfs:isDefinedBy <http://example.org/configuration-shacl> ;
    skos:definition "Every configuration:DocumentationFile individual whose configuration:artifactFilename is declared must match the DocumentationFileConvention pattern {name}_v{M}_{m}.md (underscore delimiter, two-part version). Distinguishes general documentation files from configuration:SafeguardDocument which intentionally uses DOT delimiter — see configuration:SafeguardDotDelimiterException."@en ;
    sh:property [ sh:message "AMOD S7 WARNING: DocumentationFile {$this} does not declare configuration:artifactFilename. Cannot verify DocumentationFileConvention compliance."@en ;
            sh:minCount 1 ;
            sh:path configuration:artifactFilename ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Violation ;
    sh:sparql [ sh:message "AMOD S7 VIOLATION: DocumentationFile {$this} has an artifactFilename that does not match DocumentationFileConvention pattern {name}_v{M}_{m}.md (underscore delimiter). Use redo_safeguard_* DOT pattern ONLY for configuration:SafeguardDocument — see configuration:SafeguardDotDelimiterException."@en ;
            sh:select """PREFIX configuration: <http://example.org/configuration#>
SELECT $this WHERE {
  $this a configuration:DocumentationFile ;
        configuration:artifactFilename ?fn .
  FILTER (!REGEX(?fn,
    "^[a-zA-Z0-9_]+_v[0-9]+_[0-9]+\\\\.md$"
  ))
}""" ;
            sh:severity sh:Violation ] ;
    sh:targetClass configuration:DocumentationFile .

<http://example.org/configuration-shacl#S8> a sh:NodeShape ;
    rdfs:label "AMOD S8: USOVocabularyModule filename must match USOVocabularyModuleConvention"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "configuration:USOVocabularyModuleConvention.filenamePattern = 'uso-{module}-v{M}_{m}.ttl'. AMOD BS-04 remediation April 2026."@en ;
    rdfs:isDefinedBy <http://example.org/configuration-shacl> ;
    skos:definition "Every configuration:USOVocabularyModule individual whose configuration:artifactFilename is declared must match USOVocabularyModuleConvention: uso-{module}-v{M}_{m}.ttl. Uses HYPHEN separator and TWO-PART version — see configuration:USODelimiterException for rationale."@en ;
    sh:property [ sh:message "AMOD S8 WARNING: USOVocabularyModule {$this} missing configuration:artifactFilename."@en ;
            sh:minCount 1 ;
            sh:path configuration:artifactFilename ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Violation ;
    sh:sparql [ sh:message "AMOD S8 VIOLATION: USOVocabularyModule {$this} artifactFilename does not match USOVocabularyModuleConvention pattern uso-{module}-v{M}_{m}.ttl (hyphen separator, two-part version). Check configuration:USODelimiterException for rationale."@en ;
            sh:select """PREFIX configuration: <http://example.org/configuration#>
SELECT $this WHERE {
  $this a configuration:USOVocabularyModule ;
        configuration:artifactFilename ?fn .
  FILTER (!REGEX(STR(?fn), "^uso-[a-z]+-v[0-9]+_[0-9]+[.]ttl$"))
}""" ;
            sh:severity sh:Violation ] ;
    sh:targetClass configuration:USOVocabularyModule .

