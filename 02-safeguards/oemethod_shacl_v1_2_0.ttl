    sh:nodeKind sh:IRI ;
    sh:severity sh:Info ;
    sh:targetClass quality:SemanticQuality .

quality:Shape_AggregationRule_NoMixedKinds a sh:NodeShape ;
    rdfs:label "OQC AGG-V2: AggregationRule MUST NOT mix DescriptiveMetric and NormativeMetric scores"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    rdfs:isDefinedBy <http://example.org/oqc-aggregation-shapes> ;
    skos:definition "Violations of AGG-V2 mean an aggregator is combining scores from heterogeneous kinds. The fix is structural (two aggregators), not normalizational."@en ;
    sh:message "AGG-V2 violation: AggregationRule {$this} aggregates qc:Score instances whose metrics include BOTH qc:DescriptiveMetric and qc:NormativeMetric. Composites mixing kinds are misleading (shape descriptors vs quality verdicts). Split into two AggregationRule individuals: one over Descriptive scores (reports shape) and one over Normative scores (reports quality)."@en ;
    sh:severity sh:Violation ;
    sh:sparql [ sh:prefixes [ sh:declare [ sh:namespace "http://example.org/quality#"^^xsd:anyURI ;
                            sh:prefix "qc" ] ] ;
            sh:select """
            SELECT $this WHERE {
              $this qc:aggregatesScore ?scoreA .
              ?scoreA qc:isScoreOf ?metricA .
              ?metricA a qc:DescriptiveMetric .
              $this qc:aggregatesScore ?scoreB .
              ?scoreB qc:isScoreOf ?metricB .
              ?metricB a qc:NormativeMetric .
              FILTER(?scoreA != ?scoreB)
            }
        """ ] ;
    sh:targetClass quality:AggregationRule .

quality:Shape_OntologyFileStructureComplianceCompleteness a sh:NodeShape ;
    rdfs:label "OntologyFileStructureCompliance annotation completeness"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    sh:property [ sh:message "OFSC must have dcterms:source"@en ;
            sh:minCount 1 ;
            sh:path dcterms:source ;
            sh:severity sh:Violation ],
        [ sh:message "OFSC must have rdfs:label"@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ;
            sh:severity sh:Violation ],
        [ sh:message "OFSC must have skos:definition"@en ;
            sh:minCount 1 ;
            sh:path skos:definition ;
            sh:severity sh:Violation ] ;
    sh:targetNode quality:OntologyFileStructureCompliance .

