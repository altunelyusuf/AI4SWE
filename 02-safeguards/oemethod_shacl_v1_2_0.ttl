    rdfs:isDefinedBy <http://example.org/configuration-shacl> ;
    skos:definition "Every configuration:VersionToken instance should have an configuration:fileExtension datatype property encoding the format of the artefact it belongs to (e.g., 'ttl' for OntologyFile, 'md' for SafeguardDocument). sh:Warning: extension is informational and may be derivable from the artefact's class."@en ;
    sh:property [ sh:minCount 1 ;
            sh:path configuration:fileExtension ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Warning ;
    sh:targetClass configuration:VersionToken .

