            sh:maxCount 1 ;
            sh:message "SNAPSHOT TEMPORAL-V1: MeasurementSnapshot {$this} must declare exactly one :asOfRelease."@en ;
            sh:minCount 1 ;
            sh:path redo1:asOfRelease ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "SNAPSHOT TEMPORAL-V1: MeasurementSnapshot {$this} must declare exactly one :measuredAt."@en ;
            sh:minCount 1 ;
            sh:path redo1:measuredAt ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "SNAPSHOT TEMPORAL-V1: MeasurementSnapshot {$this} must declare exactly one qc:value (xsd:decimal)."@en ;
            sh:minCount 1 ;
            sh:path quality:value ] ;
    sh:targetClass redo1:MeasurementSnapshot .

