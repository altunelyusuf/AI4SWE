<http://example.org/risk-shapes#FailureModeFMEAShape> a sh:NodeShape ;
    rdfs:label "FailureMode FMEA completeness shape"@en ;
    dcterms:isPartOf <http://example.org/risk-shapes> ;
    rdfs:comment "Per ISO 60812 FMEA: every FailureMode SHOULD declare Severity, Occurrence, and Detection ratings. Warning-severity to allow incremental population."@en ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 10 ;
            sh:message "FMEA-CORE-V1: FailureMode {$this} should declare risk:severity as integer in [1,10] per ISO 60812."@en ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path risk:severity ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 10 ;
            sh:message "FMEA-CORE-V1: FailureMode {$this} should declare risk:occurrence as integer in [1,10] per ISO 60812."@en ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path risk:occurrence ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 10 ;
            sh:message "FMEA-CORE-V1: FailureMode {$this} should declare risk:detection as integer in [1,10] per ISO 60812."@en ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path risk:detection ;
            sh:severity sh:Warning ] ;
    sh:targetClass risk:FailureMode .

<http://example.org/risk-shapes#RiskAnnotationShape> a sh:NodeShape ;
    dcterms:isPartOf <http://example.org/risk-shapes> ;
    sh:property [ sh:message "ANN-V1: every OWL class in risk: should declare rdfs:label."@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ;
            sh:severity sh:Warning ] ;
    sh:targetClass owl:Class .

<http://example.org/risk-shapes#RiskItemCompletenessShape> a sh:NodeShape ;
    rdfs:label "RiskItem completeness shape"@en ;
    dcterms:isPartOf <http://example.org/risk-shapes> ;
    sh:property [ sh:message "RISK-ITEM-V1: RiskItem {$this} must declare risk:riskLikelihood."@en ;
            sh:minCount 1 ;
            sh:path risk:riskLikelihood ;
            sh:severity sh:Violation ],
        [ sh:message "RISK-ITEM-V1: RiskItem {$this} must declare risk:riskStatus."@en ;
            sh:minCount 1 ;
            sh:path risk:riskStatus ;
            sh:severity sh:Violation ],
        [ sh:message "RISK-ITEM-V1: RiskItem {$this} must declare risk:riskImpact."@en ;
            sh:minCount 1 ;
            sh:path risk:riskImpact ;
            sh:severity sh:Violation ] ;
    sh:targetClass risk:RiskItem .

<http://example.org/risk-shapes#RiskProbabilityBoundsShape> a sh:NodeShape ;
    dcterms:isPartOf <http://example.org/risk-shapes> ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 1.0 ;
            sh:message "RISK-PROB-V1: Risk {$this} risk:hasLikelihood must be xsd:decimal in [0.0, 1.0]."@en ;
            sh:minInclusive 0.0 ;
            sh:path risk:hasLikelihood ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 1.0 ;
            sh:message "RISK-PROB-V1: Risk {$this} risk:hasProbability must be xsd:decimal in [0.0, 1.0]."@en ;
            sh:minInclusive 0.0 ;
            sh:path risk:hasProbability ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 1.0 ;
            sh:message "RISK-PROB-V1: Risk {$this} risk:riskProbability must be xsd:decimal in [0.0, 1.0]."@en ;
            sh:minInclusive 0.0 ;
            sh:path risk:riskProbability ;
            sh:severity sh:Violation ] ;
    sh:targetClass risk:Risk .

<http://example.org/risk-shapes#SeverityRankShape> a sh:NodeShape ;
    dcterms:isPartOf <http://example.org/risk-shapes> ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 4 ;
            sh:message "SEV-RANK-V1: SeverityLevel {$this} must declare risk:severityRank as integer in [1,4]."@en ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path risk:severityRank ;
            sh:severity sh:Violation ] ;
    sh:targetClass risk:SeverityLevel .

