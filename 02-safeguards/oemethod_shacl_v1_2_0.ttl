    dcterms:source "OE Pack Option C — semantic shape upgrade for reliability subject per BP-D30."@en ;
    rdfs:comment "Semantic SHACL NodeShape per BP-D30. Declares 3 property constraint(s) for GraphRAG sourced from rdfs:domain assertions."@en ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:message "Property usesLeidenAlgorithm should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path redo1:usesLeidenAlgorithm ;
            sh:severity sh:Warning ],
        [ sh:maxCount 1 ;
            sh:message "Property hierarchicalSummarizationDepth should match its declared type."@en ;
            sh:minCount 0 ;
            sh:or ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:integer ] [ sh:datatype xsd:double ] [ sh:datatype xsd:float ] [ sh:datatype xsd:long ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:short ] ) ;
            sh:path redo1:hierarchicalSummarizationDepth ;
            sh:severity sh:Warning ],
        [ sh:class redo1:CommunityDetectionMethod ;
            sh:maxCount 1 ;
            sh:message "Property hasCommunityDetection should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path redo1:hasCommunityDetection ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Warning ;
    sh:targetClass redo1:GraphRAG .

