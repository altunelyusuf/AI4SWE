redo1:ReliabilitySourceShape a sh:NodeShape ;
    rdfs:label "Authoritative Source for Failure Concepts"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    sh:property [ sh:message "a reliability ontology [GROUNDING]: Failure concept should cite an established source."@en ;
            sh:or ( [ sh:pattern "Avizienis" ] [ sh:pattern "IEEE" ] [ sh:pattern "ISO" ] [ sh:pattern "Ji.*2023" ] [ sh:pattern "NIST" ] [ sh:pattern "CMMI" ] ) ;
            sh:path dcterms:source ;
            sh:severity sh:Warning ] ;
    sh:target [ sh:select """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX redo: <http://example.org/reliability#>
SELECT ?this WHERE { ?this rdfs:subClassOf+ redo:FailureConcept . }""" ] .

