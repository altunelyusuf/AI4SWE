redo1:MetaReliability_Shape a sh:NodeShape ;
    rdfs:label "Semantic shape for MetaReliability"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "OE Pack Option C — semantic shape upgrade for reliability subject per BP-D30."@en ;
    rdfs:comment "Semantic SHACL NodeShape per BP-D30. Declares 3 property constraint(s) for MetaReliability sourced from rdfs:domain assertions."@en ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Property clopperPearsonCI should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path redo1:clopperPearsonCI ;
            sh:severity sh:Warning ],
        [ sh:maxCount 1 ;
            sh:message "Property preventionRate should match its declared type."@en ;
            sh:minCount 0 ;
            sh:or ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:integer ] [ sh:datatype xsd:double ] [ sh:datatype xsd:float ] [ sh:datatype xsd:long ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:short ] ) ;
            sh:path redo1:preventionRate ;
            sh:severity sh:Warning ],
        [ sh:maxCount 1 ;
            sh:message "Property detectionLatency should match its declared type."@en ;
            sh:minCount 0 ;
            sh:or ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:integer ] [ sh:datatype xsd:double ] [ sh:datatype xsd:float ] [ sh:datatype xsd:long ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:short ] ) ;
            sh:path redo1:detectionLatency ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Warning ;
    sh:targetClass redo1:MetaReliability .

