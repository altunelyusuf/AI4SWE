redo1:D5_ComplianceGateValidatesShape a sh:NodeShape ;
    rdfs:label "D5: ComplianceGate must validate at least one artefact (core:validates)"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.4.9 TBox: ComplianceGate subClassOf [ owl:onProperty core:validates; owl:minCardinality 1 ]. core:validates source: ISO/IEC/IEEE 29119-1:2022."@en ;
    rdfs:isDefinedBy <http://example.org/redo> ;
    skos:definition "Enforces the ComplianceGate TBox restriction (minCardinality=1): every instance of redo:ComplianceGate must have at least one core:validates triple. A compliance gate that validates nothing is semantically empty — it exists in the graph but cannot be linked to any artefact, constraint, or specification it is supposed to enforce. Uses core:validates (ISO 29119-1) rather than a a reliability ontology-specific property because a reliability ontology imports CORE and the restriction was always intended to reference this cross-domain verification property."@en ;
    sh:property [ sh:message "a reliability ontology D5 FAIL: ComplianceGate {$this} has no core:validates triple. Every compliance gate must validate at least one artefact, constraint, or specification to be semantically complete."@en ;
            sh:minCount 1 ;
            sh:path core:validates ;
            sh:severity sh:Violation ] ;
    sh:severity sh:Violation ;
    sh:targetClass redo1:ComplianceGate .

redo1:D5_ComplianceGateVerifiedByShape a sh:NodeShape ;
    rdfs:label "D5: ComplianceGate should be verifiedBy an EmpiricalTest"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.4.8 TBox: ComplianceGate subClassOf [ owl:onProperty redo:verifiedBy; owl:someValuesFrom redo:EmpiricalTest ]. Avizienis et al. (2004). Basic Concepts and Taxonomy of Dependable and Secure Computing."@en ;
    rdfs:isDefinedBy <http://example.org/redo> ;
    skos:definition "Enforces the ComplianceGate TBox restriction: every instance of redo:ComplianceGate should have at least one redo:verifiedBy triple pointing to an instance of redo:EmpiricalTest. Without empirical test evidence, a compliance gate is unverified and may represent declarative compliance rather than substantive compliance. Generalisation of the reliability concern originally expressed as gact:DecisionQuestion structural completeness in a reliability ontology SHACL v2.0.0."@en ;
    sh:property [ sh:class redo1:EmpiricalTest ;
            sh:message "a reliability ontology D5 WARNING: ComplianceGate {$this} has no redo:verifiedBy pointing to an EmpiricalTest. Compliance gates should be backed by empirical evidence to avoid decorative compliance."@en ;
            sh:minCount 1 ;
            sh:path redo1:verifiedBy ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Warning ;
    sh:targetClass redo1:ComplianceGate .

redo1:D5_EmpiricalTestAlertShape a sh:NodeShape ;
    rdfs:label "D5: EmpiricalTest should triggersAlert an LLMBehavioralPathology"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.4.8 TBox: EmpiricalTest subClassOf [ owl:onProperty redo:triggersAlert; owl:someValuesFrom redo:LLMBehavioralPathology ]. Avizienis et al. (2004)."@en ;
    rdfs:isDefinedBy <http://example.org/redo> ;
    skos:definition "Enforces the EmpiricalTest TBox restriction: every instance of redo:EmpiricalTest should link to an LLMBehavioralPathology via redo:triggersAlert. An empirical test that does not identify the specific pathology it is designed to detect is not traceable to a reliability concern — it tests in isolation from the failure taxonomy. Generalisation of the structural completeness principle."@en ;
    sh:property [ sh:class redo1:LLMBehavioralPathology ;
            sh:message "a reliability ontology D5 WARNING: EmpiricalTest {$this} missing redo:triggersAlert link to LLMBehavioralPathology. Tests should be traceable to the specific behavioral pathology they detect."@en ;
            sh:minCount 1 ;
            sh:path redo1:triggersAlert ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Warning ;
    sh:targetClass redo1:EmpiricalTest .

redo1:D5_EmpiricalTestConfidenceShape a sh:NodeShape ;
    rdfs:label "D5: EmpiricalTest should declare hasConfidenceLevel"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.4.8 TBox: EmpiricalTest subClassOf [ owl:onProperty redo:hasConfidenceLevel; owl:someValuesFrom xsd:decimal ]. Avizienis et al. (2004)."@en ;
    rdfs:isDefinedBy <http://example.org/redo> ;
    skos:definition "Enforces the EmpiricalTest TBox restriction: every instance of redo:EmpiricalTest should declare redo:hasConfidenceLevel. An empirical test without a confidence level is a qualitative claim, not a quantitative one — reducing its value as verification evidence. Generalisation of the structural completeness principle from a reliability ontology SHACL v2.0.0 gact: shapes."@en ;
    sh:property [ sh:message "a reliability ontology D5 WARNING: EmpiricalTest {$this} missing redo:hasConfidenceLevel. Empirical tests should record a statistical confidence level to distinguish quantitative verification from qualitative assertion."@en ;
            sh:minCount 1 ;
            sh:path redo1:hasConfidenceLevel ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Warning ;
    sh:targetClass redo1:EmpiricalTest .

redo1:D5_EmpiricalTestDetectsShape a sh:NodeShape ;
    rdfs:label "D5: EmpiricalTest should detect a failure concept (core:detects)"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2.4.9 TBox: EmpiricalTest subClassOf [ owl:onProperty core:detects; owl:someValuesFrom redo:FailureConcept ] and [ owl:onProperty core:detects; owl:someValuesFrom redo:LLMBehavioralPathology ]. core:detects source: ISO/IEC/IEEE 29119-1:2022."@en ;
    rdfs:isDefinedBy <http://example.org/redo> ;
    skos:definition "Enforces the EmpiricalTest TBox restriction (someValuesFrom): every instance of redo:EmpiricalTest should have at least one core:detects triple linking it to a redo:FailureConcept or redo:LLMBehavioralPathology. An empirical test with no declared detection target cannot be traced to a reliability concern — it tests without a declared failure hypothesis. sh:Warning (not Violation) because someValuesFrom is open-world in OWL."@en ;
    sh:property [ sh:message "a reliability ontology D5 WARNING: EmpiricalTest {$this} missing core:detects link. Empirical tests should declare what failure concept or pathology they are designed to detect."@en ;
            sh:minCount 1 ;
            sh:path core:detects ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Warning ;
    sh:targetClass redo1:EmpiricalTest .

redo1:DataFabricationShape a sh:NodeShape ;
    rdfs:label "Shape for DataFabrication"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    sh:property [ sh:minCount 1 ;
