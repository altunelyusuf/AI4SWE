risk:RiskManagementCompletenessGate a sh:NodeShape ;
    rdfs:label "Risk-management process-completeness gate (profile-parameterized)"@en ;
    dcterms:isPartOf <http://example.org/risk-shapes> ;
    rdfs:comment "Conformance gate (EXT-2 pilot): at High/Critical CriticalityProfile, every risk identified on the artifact must carry a mitigation or risk treatment. Lower profiles are not gated. Gates the DISCIPLINE of risk management, not the risk values."@en ;
    sh:sparql [ sh:message "Risk-management gate: at High/Critical criticality, every identified risk must have a mitigation or risk treatment."@en ;
            sh:select """PREFIX risk: <http://example.org/risk#>
PREFIX core: <http://example.org/core#>
SELECT $this WHERE {
  $this core:hasCriticalityProfile ?p .
  FILTER( ?p IN ( core:Profile_High, core:Profile_Critical ) )
  $this risk:hasIdentifiedRisk ?r .
  FILTER NOT EXISTS { ?r risk:hasMitigation ?m }
  FILTER NOT EXISTS { ?r risk:hasRiskTreatment ?t }
}""" ;
            sh:severity sh:Violation ] ;
    sh:targetClass core:Artifact .

