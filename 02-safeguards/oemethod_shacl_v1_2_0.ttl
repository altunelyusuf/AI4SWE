configuration:ChangeValidationGate a sh:NodeShape ;
    rdfs:label "Configuration change-validation gate (profile-parameterized)"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    sh:sparql [ sh:message "Configuration gate: at High/Critical, each ChangeOperation on this artifact must satisfy an AcceptanceCriterion."@en ;
            sh:select """PREFIX f: <http://example.org/configuration#>
PREFIX core: <http://example.org/core#>
SELECT $this WHERE {
  $this core:hasCriticalityProfile ?pr . FILTER( ?pr IN ( core:Profile_High, core:Profile_Critical ) )
  ?x f:appliesToArtifact $this .
  FILTER NOT EXISTS { ?x f:satisfiesAcceptanceCriterion ?c }
}""" ;
            sh:severity sh:Violation ] ;
    sh:targetClass core:Artifact .

