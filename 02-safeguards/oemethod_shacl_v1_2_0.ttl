redo1:MitigationStrategyCoverageShape a sh:NodeShape ;
    rdfs:label "MitigationStrategy must declare core:mitigates target"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    rdfs:comment """a reliability ontology v2.5.4 — Every MitigationStrategy individual must declare
at least one core:mitigates triple. A strategy that mitigates nothing is
semantically empty — equivalent to an undirected prevention rule that cannot
be traced to a specific failure mode in the taxonomy."""@en ;
    sh:property [ sh:message "[ADVISORY per L-20] a reliability ontology D5 FAIL: MitigationStrategy {$this} has no core:mitigates triple. Every strategy should target at least one pathology or fault."@en ;
            sh:minCount 1 ;
            sh:path core:mitigates ;
            sh:severity sh:Warning ] ;
    sh:targetClass redo1:FailureMitigation,
        redo1:MitigationStrategy .

redo1:MitigationStrategyShape a sh:NodeShape ;
