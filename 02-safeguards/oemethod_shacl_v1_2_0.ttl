oe_measurement:MeasurementBinding_Shape a sh:NodeShape ;
    rdfs:label "Semantic shape for MeasurementBinding"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "OE Pack v17.35.0 Option C — semantic shape upgrade per BP-D30. Property constraints sourced from rdfs:domain/range of declared properties."@en ;
    rdfs:comment "Semantic SHACL NodeShape per v17.35.0 Roadmap_SHACL100Coverage Step 2. Declares 5 property constraint(s) for MeasurementBinding drawn from rdfs:domain assertions. Cardinality default: sh:minCount 0 (presence optional per BP-D28 honest disclosure that ABox population is incremental), sh:maxCount 1 unless overridden for multi-valued properties. Datatype/class constraints derived from rdfs:range. Severity: sh:Warning (advisory)."@en ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:class oe_measurement:Score ;
            sh:maxCount 1 ;
            sh:message "Property hasScore should be a single value of the declared type."@en ;
            sh:minCount 0 ;
            sh:path oe_measurement:hasScore ],
        [ sh:maxCount 1 ;
            sh:message "Property hasRawValue should be a single value of the declared type."@en ;
            sh:minCount 0 ;
            sh:or ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:integer ] [ sh:datatype xsd:double ] [ sh:datatype xsd:float ] [ sh:datatype xsd:long ] [ sh:datatype xsd:nonNegativeInteger ] ) ;
            sh:path oe_measurement:hasRawValue ;
            sh:severity sh:Warning ],
        [ sh:class core:Artifact ;
            sh:maxCount 1 ;
            sh:message "Property bindsArtifact should be a single value of the declared type."@en ;
            sh:minCount 0 ;
            sh:path oe_measurement:bindsArtifact ],
        [ sh:maxCount 1 ;
            sh:message "Property hasNormalizedValue should be a single value of the declared type."@en ;
            sh:minCount 0 ;
            sh:or ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:integer ] [ sh:datatype xsd:double ] [ sh:datatype xsd:float ] [ sh:datatype xsd:long ] [ sh:datatype xsd:nonNegativeInteger ] ) ;
            sh:path oe_measurement:hasNormalizedValue ;
            sh:severity sh:Warning ],
        [ sh:class oe_measurement:Metric ;
            sh:maxCount 1 ;
            sh:message "Property bindsMetric should be a single value of the declared type."@en ;
            sh:minCount 0 ;
            sh:path oe_measurement:bindsMetric ] ;
    sh:severity sh:Warning ;
    sh:targetClass oe_measurement:MeasurementBinding .

