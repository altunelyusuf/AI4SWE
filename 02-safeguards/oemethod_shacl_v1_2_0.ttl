algorithm_efficiency:AnalysisMethod_Shape a sh:NodeShape ;
    rdfs:label "Semantic shape for AnalysisMethod"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    dcterms:source "OE Pack Option C — semantic shape upgrade for algorithm-efficiency subject per BP-D30."@en ;
    rdfs:comment "Semantic SHACL NodeShape per BP-D30. Declares 2 property constraint(s) for AnalysisMethod sourced from rdfs:domain assertions."@en ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:class algorithm_efficiency:AlgorithmFamily ;
            sh:maxCount 1 ;
            sh:message "Property analyzes should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path algorithm_efficiency:analyzes ;
            sh:severity sh:Warning ],
        [ sh:class algorithm_efficiency:AnalysisTool ;
            sh:maxCount 1 ;
            sh:message "Property usesTool should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path algorithm_efficiency:usesTool ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Warning ;
    sh:targetClass algorithm_efficiency:AnalysisMethod .

