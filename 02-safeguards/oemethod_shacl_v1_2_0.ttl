    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Property riskMitigation should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path configuration:riskMitigation ;
            sh:severity sh:Warning ],
        [ sh:maxCount 1 ;
            sh:message "Property riskProbability should match its declared type."@en ;
            sh:minCount 0 ;
            sh:or ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:integer ] [ sh:datatype xsd:double ] [ sh:datatype xsd:float ] [ sh:datatype xsd:long ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:short ] ) ;
            sh:path configuration:riskProbability ;
            sh:severity sh:Warning ],
        [ sh:maxCount 1 ;
            sh:message "Property hasMitigation should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path configuration:hasMitigation ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Warning ;
    sh:targetClass configuration:RiskItem .

