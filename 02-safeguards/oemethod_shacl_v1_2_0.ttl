redo1:ArchitecturalDriftShape a sh:NodeShape ;
    rdfs:label "INCIDENT ARCHDRIFT-V1: ArchitecturalDrift incident record must be audit-ready"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    rdfs:comment "Validates that every recorded ArchitecturalDrift incident has the evidence fields needed for honest audit: hasSeverity, source (provenance), :detectedBy (mechanism attribution). Does NOT detect drift in unflagged data — see Phase 2.7 gap analysis for honest scope."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "[ADVISORY per L-20+L-49] Multiple detectedBy attributions enrich audit. INCIDENT ARCHDRIFT-V1: ArchitecturalDrift {$this} must declare exactly one :detectedBy mechanism. Without attribution, autonomous-detection-rate cannot be mechanically computed."@en ;
            sh:minCount 1 ;
            sh:path redo1:detectedBy ;
            sh:severity sh:Warning ],
        [ sh:message "INCIDENT ARCHDRIFT-V1: ArchitecturalDrift {$this} must cite at least one dcterms:source (provenance)."@en ;
            sh:minCount 1 ;
            sh:path dcterms:source ],
        [ sh:datatype xsd:string ;
            sh:message "INCIDENT ARCHDRIFT-V1: ArchitecturalDrift {$this} must declare exactly one hasSeverity."@en ;
            sh:minCount 1 ;
            sh:path redo1:hasSeverity ],
        [ sh:message "INCIDENT ARCHDRIFT-V1: ArchitecturalDrift {$this} should justify its :detectedBy attribution with a :detectionEvidence string (BP-D2 audit trail)."@en ;
            sh:minCount 1 ;
            sh:path redo1:detectionEvidence ] ;
    sh:targetClass redo1:ArchitecturalDrift .

