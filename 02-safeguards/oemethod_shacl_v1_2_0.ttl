redo1:C6PROVOManifestShape a sh:NodeShape ;
    rdfs:label "C6: SprintManifest must declare a PROV-O evidence file"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    rdfs:comment """a reliability ontology v2.5.4 — Enforces C6PROVOManifestCoupling: every
amod:SprintManifest must include at least one EngineeringArtefact whose
filename matches the pattern prov_*.ttl. This makes ritual C6 PASS
self-defeating: if the PROV-O file is absent from the manifest,
this shape fires; if it is in the manifest but not on disk, C8-OUT fires."""@en,
        """a reliability ontology v2.5.4 — Enforces C6PROVOManifestCoupling: every
configuration:SprintManifest must include at least one EngineeringArtefact whose
filename matches the pattern prov_*.ttl. This makes ritual C6 PASS
self-defeating: if the PROV-O file is absent from the manifest,
this shape fires; if it is in the manifest but not on disk, C8-OUT fires."""@en ;
    sh:sparql [ sh:message "a reliability ontology C6 FAIL: SprintManifest {$this} has no PROV-O evidence file declared (expected: prov_*.ttl as EngineeringArtefact with amod:checksumSHA256). Add prov_*.ttl to SPRINT_MANIFEST and run rdflib to generate it."@en ;
            sh:select """
PREFIX amod: <http://example.org/amod#>
SELECT DISTINCT $this
WHERE {
    $this a amod:SprintManifest .
    OPTIONAL {
        ?art amod:declaredInManifest $this .
        ?art amod:artifactFilename ?fn .
        FILTER(REGEX(STR(?fn), "^prov_.*[.]ttl$"))
    }
    FILTER(!BOUND(?fn))
}
""" ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology C6 FAIL: SprintManifest {$this} has no PROV-O evidence file declared (expected: prov_*.ttl as EngineeringArtefact with configuration:checksumSHA256). Add prov_*.ttl to SPRINT_MANIFEST and run rdflib to generate it."@en ;
            sh:select """
PREFIX configuration: <http://example.org/configuration#>
SELECT DISTINCT $this
WHERE {
    $this a configuration:SprintManifest .
    OPTIONAL {
        ?art configuration:declaredInManifest $this .
        ?art configuration:artifactFilename ?fn .
        FILTER(REGEX(STR(?fn), "^prov_.*[.]ttl$"))
    }
    FILTER(!BOUND(?fn))
}
""" ;
            sh:severity sh:Violation ] ;
    sh:targetClass <http://example.org/amod#SprintManifest>,
        configuration:SprintManifest .

redo1:C7plus_advisory_TypeDeclarationShape a sh:NodeShape ;
    rdfs:label "C7+ ADVISORY: Instance type from known namespace not visible — likely standalone validation"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2 Gate C7+ advisory tier; Lesson L-15 (validate-with-imports-merged)."@en ;
    rdfs:comment "Why advisory not informational: a fresh pair of eyes reading SHACL output should see SOMETHING for these cases, otherwise the standalone-validation pattern goes undetected. But it's not a Violation because the ontology is correctly authored — only the validation context is incomplete. This is exactly the pattern Lesson L-20 calls out: when a shape would false-positive in standalone mode, split into strict/advisory tiers."@en ;
    rdfs:isDefinedBy <http://example.org/redo-c7-split> ;
    skos:definition "Advisory tier. Fires sh:Warning when an rdf:type value is from a known OE Pack family namespace but is not declared as owl:Class in the current data graph. This pattern strongly suggests the file is being validated standalone (without owl:imports merged in). The fix is procedural — use validate_with_imports.py (BP-1) — not editorial. The Warning surfaces the standalone-mode validation cleanly without polluting Violation counts."@en ;
    sh:severity sh:Warning ;
    sh:targetClass owl:NamedIndividual .

redo1:C7plus_strict_TypeDeclarationShape a sh:NodeShape ;
    rdfs:label "C7+ STRICT: Instance type must be from a known vocabulary"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "a reliability ontology v2 Gate C7+; expanded whitelist covering OE Pack family namespaces."@en ;
    rdfs:comment "Whitelist expansion vs. v2_0_13: adds reliability, quality-criteria, amod, ontology-engineering (already there), oee-measurement, research-ontology, report-generation, ontology-synthesis, oe-pack/* namespaces. Also keeps W3C, purl.org, zt4swe.io. The result: standalone validation no longer false-positives on import-dependent OE Pack files, while truly-unknown types still trigger a Violation."@en ;
    rdfs:isDefinedBy <http://example.org/redo-c7-split> ;
    skos:definition "Strict tier of a reliability ontology C7+ TypeDeclarationShape. Fires sh:Violation only when an rdf:type value is (a) NOT declared as owl:Class in the data graph AND (b) NOT from any known vocabulary namespace (W3C standards, OE Pack family ontologies, common semantic web URIs). Truly-unknown types (typos, undeclared classes, ghost references) trigger this shape; types from imported-but-not-merged ontologies do NOT — they go to the advisory tier."@en ;
    sh:severity sh:Violation ;
    sh:targetClass owl:NamedIndividual .

redo1:C8Out_Shape a sh:NodeShape ;
    rdfs:label "Semantic shape for C8Out"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "OE Pack Option C — semantic shape upgrade for reliability subject per BP-D30."@en ;
    rdfs:comment "Semantic SHACL NodeShape per BP-D30. Declares 1 property constraint(s) for C8Out sourced from rdfs:domain assertions."@en ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:class configuration:SprintManifest ;
            sh:maxCount 1 ;
            sh:message "Property hasManifest should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path redo1:hasManifest ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Warning ;
    sh:targetClass redo1:C8Out .

redo1:C8V_FormatCheckShape a sh:NodeShape ;
    rdfs:label "C8-V: HtmlArtifact filename token must be three-part (v{M}_{m}_{p})"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    rdfs:comment """a reliability ontology v2.5.4 — Validates that any amod:HtmlArtifact instance
declared in a manifest has an amod:versionToken matching the three-part
underscore pattern _v{M}_{m}_{p}. A two-part token (e.g., v64) violates
AMOD HtmlArtifactConvention and constitutes a C8-V gate failure.
This shape makes PromptInheritedViolation machine-detectable at Stage 1."""@en,
        """a reliability ontology v2.5.4 — Validates that any configuration:HtmlArtifact instance
declared in a manifest has an configuration:versionToken matching the three-part
underscore pattern _v{M}_{m}_{p}. A two-part token (e.g., v64) violates
AMOD HtmlArtifactConvention and constitutes a C8-V gate failure.
This shape makes PromptInheritedViolation machine-detectable at Stage 1."""@en ;
    sh:sparql [ sh:message "a reliability ontology C8-V FAIL: HtmlArtifact {$this} has versionToken '{?token}' which does not match three-part pattern v{M}_{m}_{p}. Correct to vM_m_p format."@en ;
            sh:select """
PREFIX amod: <http://example.org/amod#>
SELECT $this ?token
WHERE {
    $this a amod:HtmlArtifact ;
          amod:versionToken ?token .
    FILTER(!REGEX(STR(?token), "^v[0-9]+_[0-9]+_[0-9]+$"))
}
""" ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology C8-V FAIL: HtmlArtifact {$this} has versionToken '{?token}' which does not match three-part pattern v{M}_{m}_{p}. Correct to vM_m_p format."@en ;
            sh:select """
PREFIX configuration: <http://example.org/configuration#>
SELECT $this ?token
WHERE {
    $this a configuration:HtmlArtifact ;
          configuration:versionToken ?token .
    FILTER(!REGEX(STR(?token), "^v[0-9]+_[0-9]+_[0-9]+$"))
}
""" ;
            sh:severity sh:Violation ] ;
    sh:targetClass <http://example.org/amod#HtmlArtifact>,
        configuration:HtmlArtifact .

