configuration:SemVerVersion_Shape a sh:NodeShape ;
    rdfs:label "Semantic shape for SemVerVersion"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "OE Pack Option C — semantic shape upgrade for amod subject per BP-D30."@en ;
    rdfs:comment "Semantic SHACL NodeShape per BP-D30. Declares 5 property constraint(s) for SemVerVersion sourced from rdfs:domain assertions."@en ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:maxCount 1 ;
            sh:message "Property semVerPatch should match its declared type."@en ;
            sh:minCount 0 ;
            sh:or ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:integer ] [ sh:datatype xsd:double ] [ sh:datatype xsd:float ] [ sh:datatype xsd:long ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:short ] ) ;
            sh:path configuration:semVerPatch ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Property semVerBuildMetadata should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path configuration:semVerBuildMetadata ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Property semVerPreRelease should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path configuration:semVerPreRelease ;
            sh:severity sh:Warning ],
        [ sh:maxCount 1 ;
            sh:message "Property semVerMinor should match its declared type."@en ;
            sh:minCount 0 ;
            sh:or ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:integer ] [ sh:datatype xsd:double ] [ sh:datatype xsd:float ] [ sh:datatype xsd:long ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:short ] ) ;
            sh:path configuration:semVerMinor ;
            sh:severity sh:Warning ],
        [ sh:maxCount 1 ;
            sh:message "Property semVerMajor should match its declared type."@en ;
            sh:minCount 0 ;
            sh:or ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:integer ] [ sh:datatype xsd:double ] [ sh:datatype xsd:float ] [ sh:datatype xsd:long ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:short ] ) ;
            sh:path configuration:semVerMajor ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Warning ;
    sh:targetClass configuration:SemVerVersion .

