<http://example.org/core-shacl/CompetencyQuestionShape> a sh:NodeShape ;
    rdfs:label "CORE C3: Competency questions should be declared"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    sh:severity sh:Info ;
    sh:sparql [ sh:message "CORE C3 INFO: No competency questions found. CORE CompetencyQuestion primitive recommends documenting CQs."@en ;
            sh:prefixes <http://example.org/core-shacl/> ;
            sh:select """
      PREFIX owl:  <http://www.w3.org/2002/07/owl#>
      SELECT $this
      WHERE {
        $this a owl:Ontology .
        FILTER NOT EXISTS { $this <http://purl.org/dc/terms/subject> ?cq }
        FILTER NOT EXISTS { $this <http://purl.org/dc/terms/description> ?desc .
                            FILTER (CONTAINS(LCASE(STR(?desc)), "competency")) }
      }
    """ ;
            sh:severity sh:Info ] ;
    sh:targetClass owl:Ontology .

<http://example.org/core-shacl/IndividualDocShape> a sh:NodeShape ;
    rdfs:label "CORE C2: Individuals must have rdfs:label"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    sh:property [ sh:message "CORE C2 FAIL: NamedIndividual missing rdfs:label. CORE Metric and Role primitives require labelled instances."@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ;
            sh:severity sh:Violation ] ;
    sh:targetClass owl:NamedIndividual .

<http://example.org/core-shacl/VersionPrimitiveShape> a sh:NodeShape ;
    rdfs:label "CORE C1: Version must be declared"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    sh:property [ sh:message "CORE C1 FAIL: owl:versionInfo missing. CORE Version primitive requires explicit version."@en ;
            sh:minCount 1 ;
            sh:path owl:versionInfo ;
            sh:severity sh:Violation ],
        [ sh:message "CORE C1 WARNING: owl:versionIRI not declared."@en ;
            sh:minCount 1 ;
            sh:path owl:versionIRI ;
            sh:severity sh:Warning ] ;
    sh:targetClass owl:Ontology .

oe_measurement:AccuracyMetric_Shape a sh:NodeShape ;
    rdfs:label "Lightweight semantic shape for AccuracyMetric"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "OE Pack v17.35.0 Option C — lightweight semantic upgrade per BP-D30. No direct properties via rdfs:domain; minimal nodeKind constraint applied."@en ;
    rdfs:comment "Lightweight semantic SHACL NodeShape per v17.35.0 Roadmap_SHACL100Coverage Step 2. AccuracyMetric has no DT/OP properties directly declared (rdfs:domain assertions). Constraints inherit from parent class shape(s) via sh:targetClass + OWL subClassOf entailment. Direct constraint: sh:nodeKind sh:IRI — rejects blank-node instantiation. Severity: sh:Info (advisory)."@en ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Info ;
    sh:targetClass oe_measurement:AccuracyMetric .

oe_measurement:AggregationRule_Shape a sh:NodeShape ;
    rdfs:label "Semantic shape for AggregationRule"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "OE Pack v17.35.0 Option C — semantic shape upgrade per BP-D30. Property constraints sourced from rdfs:domain/range of declared properties."@en ;
    rdfs:comment "Semantic SHACL NodeShape per v17.35.0 Roadmap_SHACL100Coverage Step 2. Declares 2 property constraint(s) for AggregationRule drawn from rdfs:domain assertions. Cardinality default: sh:minCount 0 (presence optional per BP-D28 honest disclosure that ABox population is incremental), sh:maxCount 1 unless overridden for multi-valued properties. Datatype/class constraints derived from rdfs:range. Severity: sh:Warning (advisory)."@en ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:maxCount 1 ;
            sh:message "Property weightStructural should be a single value of the declared type."@en ;
            sh:minCount 0 ;
            sh:or ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:integer ] [ sh:datatype xsd:double ] [ sh:datatype xsd:float ] [ sh:datatype xsd:long ] [ sh:datatype xsd:nonNegativeInteger ] ) ;
            sh:path oe_measurement:weightStructural ;
            sh:severity sh:Warning ],
        [ sh:maxCount 1 ;
            sh:message "Property weightQCore should be a single value of the declared type."@en ;
            sh:minCount 0 ;
            sh:or ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:integer ] [ sh:datatype xsd:double ] [ sh:datatype xsd:float ] [ sh:datatype xsd:long ] [ sh:datatype xsd:nonNegativeInteger ] ) ;
            sh:path oe_measurement:weightQCore ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Warning ;
    sh:targetClass oe_measurement:AggregationRule .

