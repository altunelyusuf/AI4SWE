oe_measurement:Shape_MeasurementAnnotationCompleteness a sh:NodeShape ;
    rdfs:label "Measurement annotation completeness"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    rdfs:comment "Every oem:Measurement subclass must have rdfs:label and skos:definition."@en,
        "v19.0.1 fix: SPARQL-based target narrows scope to oem: namespace instances only (was firing on cross-subject measurement instances per Proposal E Cluster 3)."@en ;
    sh:property [ sh:message "Measurement class must have rdfs:label"@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ;
            sh:severity sh:Violation ],
        [ sh:message "Measurement class must have skos:definition"@en ;
            sh:minCount 1 ;
            sh:path skos:definition ;
            sh:severity sh:Violation ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:select """PREFIX oem: <http://example.org/measurement#>
SELECT ?this WHERE {
  ?this a/rdfs:subClassOf* oem:Measurement .
  FILTER(STRSTARTS(STR(?this), "http://example.org/measurement#"))
}""" ] .

