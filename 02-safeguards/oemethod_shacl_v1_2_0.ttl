configuration:EngineeringArtefact_Shape a sh:NodeShape ;
    rdfs:label "Semantic shape for EngineeringArtefact"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "OE Pack Option C — semantic shape upgrade for amod subject per BP-D30."@en ;
    rdfs:comment "Semantic SHACL NodeShape per BP-D30. Declares 13 property constraint(s) for EngineeringArtefact sourced from rdfs:domain assertions."@en ;
