    rdfs:comment "Lightweight semantic SHACL NodeShape per BP-D30. RiskEvent has no direct rdfs:domain assertions; constraints inherit via OWL subClassOf entailment. Direct: sh:nodeKind sh:IRI."@en ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Info ;
    sh:targetClass risk:RiskEvent .

