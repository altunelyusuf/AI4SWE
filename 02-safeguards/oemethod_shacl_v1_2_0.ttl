            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Property artifactAuthor should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path configuration:artifactAuthor ;
            sh:severity sh:Warning ],
        [ sh:class configuration:ReleaseSignature ;
            sh:maxCount 1 ;
            sh:message "Property hasSignature should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path configuration:hasSignature ;
            sh:severity sh:Warning ],
        [ sh:class configuration:SemVerVersion ;
            sh:maxCount 1 ;
            sh:message "Property hasSemVer should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path configuration:hasSemVer ;
            sh:severity sh:Warning ],
        [ sh:class configuration:EngineeringArtefact ;
            sh:maxCount 1 ;
            sh:message "Property dependsOn should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path configuration:dependsOn ;
            sh:severity sh:Warning ],
        [ sh:class configuration:NamingConvention ;
            sh:maxCount 1 ;
            sh:message "Property hasNamingConvention should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path configuration:hasNamingConvention ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Property fileExtension should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path configuration:fileExtension ;
            sh:severity sh:Warning ],
        [ sh:class redo1:SBOM ;
            sh:maxCount 1 ;
            sh:message "Property hasSBOM should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path configuration:hasSBOM ;
            sh:severity sh:Warning ],
        [ sh:class configuration:VersionToken ;
            sh:maxCount 1 ;
            sh:message "Property hasVersionToken should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path configuration:hasVersionToken ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Property artifactFilename should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path configuration:artifactFilename ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Property checksumSHA256 should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path configuration:checksumSHA256 ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Warning ;
    sh:targetClass configuration:EngineeringArtefact .

