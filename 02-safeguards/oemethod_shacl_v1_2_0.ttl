<http://example.org/reliability/shapes/v2.0.12/drift18> rdfs:label "a reliability ontology SHACL Shapes v2.0.13.2 — Δ-2 constraint rewrite"@en ;
    dcterms:created "2026-05-05T00:00:00"^^xsd:dateTime ;
    dcterms:identifier "redo_drift18" ;
    dcterms:isPartOf <http://example.org/oemethod>,
        <http://example.org/redo> ;
    dcterms:source "WS-6 finding 2026-05-05: HermiT detected 9 disjoint-ancestor inconsistencies in redo_v2_5_16.ttl that DRIFT-17 did not catch."@en ;
    dcterms:title "a reliability ontology SHACL Addendum DRIFT-18 — Disjoint-Ancestor Detection (bounded SPARQL)"@en ;
    rdfs:comment "v2.0.13.2 (2026-05-11): CONTINUATION of v2.0.13.1. Δ-2 implementation per OE Pack discipline. Single change: C2_ClassDocumentationShape's 4 sh:sparql existence-check constraints replaced by 4 sh:property minCount=1 constraints (rdfs:label, skos:definition, dcterms:source, rdfs:isDefinedBy). All 14 other SPARQL constraints preserved verbatim. Expected parity for current data corpus (0 blank-node owl:Class instances). Expected speedup: significant — pyshacl evaluates sh:property minCount via internal indexes, not per-target SPARQL execution."@en ;
    owl:priorVersion <http://example.org/reliability-shacl/v2.0.13.1> ;
    owl:versionIRI <http://example.org/reliability-shacl/3.0.0> ;
    owl:versionInfo "3.0.0" .

