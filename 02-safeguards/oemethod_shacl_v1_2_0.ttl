configuration:ManifestEntryHasChecksumShape a sh:NodeShape ;
    rdfs:label "AMOD S5: Artefacts declared in a SprintManifest should have SHA-256 checksum"@en ;
    dcterms:isPartOf <http://example.org/configuration> ;
    dcterms:source "NIST FIPS PUB 180-4: Secure Hash Standard (SHS). a reliability ontology v2.4.9 — C8Out gate and SprintClosureChecklist. USO v2.0 Sprint 12 post-mortem. v1.2.1 (2026-05-01): scope tightened from sh:targetClass configuration:EngineeringArtefact (which under rdfs inference matched Token, Convention, and ArtifactNamingSchema individuals — registry metadata that does not represent a file with a SHA) to sh:target a SPARQL query requiring an explicit configuration:declaredInManifest predicate. Closes 13 spurious S5 warnings on registry-metadata individuals while preserving real-file checksum enforcement."@en ;
    rdfs:isDefinedBy <http://example.org/configuration-shacl> ;
    skos:definition "Every configuration:EngineeringArtefact that is reached via configuration:declaredInManifest from a SprintManifest should have an configuration:checksumSHA256 datatype property. The checksum is recorded at sprint delivery and enables a reliability ontology C8Out to verify file integrity. sh:Warning because checksums may be added in a separate post-delivery step."@en ;
    sh:property [ sh:message "AMOD S5 WARNING: EngineeringArtefact {$this} is declared in a manifest but has no configuration:checksumSHA256. Checksum required for a reliability ontology C8Out integrity verification."@en ;
            sh:minCount 1 ;
            sh:path configuration:checksumSHA256 ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Warning ;
    sh:target [ a sh:SPARQLTarget ;
            sh:prefixes configuration:AMOD_PREFIXES ;
            sh:select """
                PREFIX configuration: <http://example.org/configuration#>
                SELECT $this WHERE {
                    ?manifest configuration:declaredInManifest $this .
                    $this a configuration:EngineeringArtefact .
                }
            """ ] .

