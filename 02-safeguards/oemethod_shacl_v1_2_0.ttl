redo:C2_ClassDocumentationShape a sh:NodeShape ;
    rdfs:label "C2: Named class must have label, definition, source"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    rdfs:comment "a reliability ontology Gate C2 — every NAMED owl:Class (IRI-named) needs label, definition, source, isDefinedBy. v2.0.13.2 Δ-2 rewrite: 4 sh:sparql existence-checks replaced with 4 sh:property minCount=1 constraints. Original FILTER(isIRI($this)) was intended to skip anonymous OWL structural classes (unions, intersections, restrictions); BP-D2 inspection found 0 blank-node owl:Class instances in v17.7.0/v17.8.0 corpus, so semantic parity is preserved for current data. If future ABox introduces anonymous owl:Class instances (e.g., new owl:Restriction declarations), the rewritten shape will flag them as violations rather than silently skipping. This is an explicit forward-looking trade-off documented in catalogue v1.0.7.2."@en ;
    sh:property [ sh:message "a reliability ontology C2 WARNING: Named owl:Class missing rdfs:isDefinedBy. (Δ-2 rewrite of v2_0_13_1 sparql constraint #4.)"@en ;
            sh:minCount 1 ;
            sh:path rdfs:isDefinedBy ;
            sh:severity sh:Warning ],
        [ sh:message "a reliability ontology C2 WARNING: Named owl:Class missing dcterms:source. (Δ-2 rewrite of v2_0_13_1 sparql constraint #3.)"@en ;
            sh:minCount 1 ;
            sh:path dcterms:source ;
            sh:severity sh:Warning ],
        [ sh:message "a reliability ontology C2 FAIL: Named owl:Class missing rdfs:label. (Δ-2 rewrite of v2_0_13_1 sparql constraint #1.)"@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology C2 FAIL: Named owl:Class missing skos:definition. (Δ-2 rewrite of v2_0_13_1 sparql constraint #2.)"@en ;
            sh:minCount 1 ;
            sh:path skos:definition ;
            sh:severity sh:Violation ] ;
    sh:targetClass owl:Class .

redo:C2plus_DefinitionNotTautologicalShape a sh:NodeShape ;
    rdfs:label "C2+: Definition must not be a boilerplate stub"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    rdfs:comment """a reliability ontology v2 — Detects tautological definitions that are copy-paste
stubs providing no semantic content (e.g., 'Decision question for CL01 axis
AX1_WHAT: guides student teams in taxonomy placement.')."""@en ;
    sh:sparql [ sh:message "a reliability ontology C2+ FAIL: skos:definition appears tautological (starts with type name + 'for CL'). Replace with actual content."@en ;
            sh:select """
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            PREFIX owl:  <http://www.w3.org/2002/07/owl#>
            SELECT $this ?def
            WHERE {
                $this a owl:NamedIndividual .
                $this skos:definition ?def .
                FILTER(
                    REGEX(STR(?def), "^(Decision question|Anti-pattern check) for CL[0-9]+ axis AX[0-9]")
                    || REGEX(STR(?def), "^[A-Z][a-z]+ (question|check) for CL[0-9]+.{0,30}guides student")
                )
            }
        """ ;
            sh:severity sh:Violation ] ;
    sh:targetClass owl:NamedIndividual .

redo:C2plus_IndividualDefinitionShape a sh:NodeShape ;
    rdfs:label "C2+: Individual must have skos:definition"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    rdfs:comment "a reliability ontology v2 Gate C2+ — every NamedIndividual needs a definition."@en ;
    sh:property [ sh:message "a reliability ontology C2+ FAIL: NamedIndividual missing skos:definition."@en ;
            sh:minCount 1 ;
            sh:path skos:definition ;
            sh:severity sh:Warning ] ;
    sh:targetClass owl:NamedIndividual .

redo:C2plus_IndividualLabelShape a sh:NodeShape ;
    rdfs:label "C2+: Individual must have rdfs:label"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    rdfs:comment """a reliability ontology v2 Gate C2+ — every NamedIndividual needs a label. 
This catches the 'mechanical label' defect where label was never populated."""@en ;
    sh:property [ sh:message "a reliability ontology C2+ FAIL: NamedIndividual missing rdfs:label."@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ;
            sh:severity sh:Violation ] ;
    sh:targetClass owl:NamedIndividual .

redo:C2plus_LabelNotMechanicalShape a sh:NodeShape ;
    rdfs:label "C2+: Label must not be an opaque ID"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    rdfs:comment """a reliability ontology v2 — Detects 'mechanical labels' where rdfs:label is just
the URI local name (e.g., label='DQ_001' for URI ...#DQ_001). These provide
zero human-readable information. The SPARQL constraint checks if the label
matches the pattern of an opaque identifier (letters + underscore + digits)."""@en ;
    sh:sparql [ sh:message "a reliability ontology C2+ FAIL: rdfs:label appears to be an opaque ID ('{?label}'). Replace with meaningful content."@en ;
            sh:select """
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX owl:  <http://www.w3.org/2002/07/owl#>
            SELECT $this ?label
            WHERE {
                $this a owl:NamedIndividual .
                $this rdfs:label ?label .
                BIND(REPLACE(STR($this), "^.*(#|/)", "") AS ?localName)
                FILTER(STR(?label) = ?localName)
                FILTER(REGEX(?localName, "^[A-Z]{1,5}[_-][0-9]{2,}$"))
            }
        """ ;
            sh:severity sh:Violation ] ;
    sh:targetClass owl:NamedIndividual .

redo:C3_IndividualSourceShape a sh:NodeShape ;
    rdfs:label "C3: Individual should have dcterms:source"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    sh:property [ sh:message "a reliability ontology C3 WARNING: NamedIndividual missing dcterms:source."@en ;
            sh:minCount 1 ;
            sh:path dcterms:source ;
            sh:severity sh:Info ] ;
    sh:targetClass owl:NamedIndividual .

redo:C7plus_TypeDeclarationShape a sh:NodeShape ;
    rdfs:label "C7+: Instance type must be a declared owl:Class or from imported vocabulary"@en ;
    dcterms:isPartOf <http://example.org/redo> ;
    rdfs:comment "a reliability ontology v2 Gate C7+ — every rdf:type value used on a NamedIndividual must be either (a) declared as owl:Class or rdfs:Class in the local graph, or (b) from a well-known external vocabulary (W3C, purl.org), or (c) from a vocabulary that the focus graph explicitly owl:imports. The (c) clause is dynamic — it reads owl:imports declarations from the focus graph itself rather than a hardcoded namespace list. Closes Issue I-05 (false positives in standalone validation)."@en ;
    sh:sparql [ sh:message "a reliability ontology C7+ FAIL: Instance {$this} has rdf:type {?type} which is neither declared as owl:Class/rdfs:Class locally, nor from a well-known external vocabulary (W3C, purl.org), nor from a vocabulary explicitly imported via owl:imports."@en ;
            sh:select """
            PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX owl:  <http://www.w3.org/2002/07/owl#>
            SELECT $this ?type
            WHERE {
                $this a owl:NamedIndividual .
                $this rdf:type ?type .
                FILTER(?type != owl:NamedIndividual)
                FILTER NOT EXISTS { ?type a owl:Class }
                FILTER NOT EXISTS { ?type a rdfs:Class }
                FILTER(isIRI(?type))
                # Suppress known external vocabularies (W3C, Dublin Core, common standards)
                FILTER(
                    !STRSTARTS(STR(?type), "http://www.w3.org/") &&
                    !STRSTARTS(STR(?type), "http://purl.org/") &&
                    !STRSTARTS(STR(?type), "https://www.w3.org/")
                )
                # I-05 fix: dynamically check owl:imports for the focus graph.
                # If the type's namespace prefix matches the IRI of any imported ontology
                # (or imports' IRI is a prefix of the type IRI), suppress.
                FILTER NOT EXISTS {
                    ?ont owl:imports ?imp .
                    FILTER(STRSTARTS(STR(?type), CONCAT(STR(?imp), "#")) ||
                           STRSTARTS(STR(?type), CONCAT(STR(?imp), "/")))
                }
            }
""" ;
            sh:severity sh:Violation ] ;
    sh:targetClass owl:NamedIndividual .

redo:CompactionFidelityShape a sh:NodeShape ;
    rdfs:label "DRIFT-15: CompactionFidelityDrift must record event detection + scope + fallback evidence source"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    rdfs:comment "Every CompactionFidelityDrift instance must record whether a compaction event was detected (redo1:compactionEventDetected), the scope of the compaction (redo1:compactionScope), and the fallback evidence source used in place of the deflated summary (redo1:fallbackEvidenceSource). The user's repeated discipline 'Never trust to summaries or deflated content' anchors here."@en ;
    sh:property [ sh:in ( "LOW" "MEDIUM" "HIGH" ) ;
            sh:message "a reliability ontology DRIFT-15 FAIL: CompactionFidelityDrift {$this} missing redo1:hasSeverity."@en ;
            sh:minCount 1 ;
            sh:path redo1:hasSeverity ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:boolean ;
            sh:message "a reliability ontology DRIFT-15 FAIL: CompactionFidelityDrift {$this} missing redo1:compactionEventDetected boolean."@en ;
            sh:minCount 1 ;
            sh:path redo1:compactionEventDetected ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology DRIFT-15 FAIL: CompactionFidelityDrift {$this} missing redo1:compactionScope. Describe the compacted turn range."@en ;
            sh:minCount 1 ;
            sh:path redo1:compactionScope ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology DRIFT-15 FAIL: CompactionFidelityDrift {$this} missing redo1:fallbackEvidenceSource. Cite the disk-files used in place of the summary."@en ;
            sh:minCount 1 ;
            sh:path redo1:fallbackEvidenceSource ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology DRIFT-15 FAIL: CompactionFidelityDrift {$this} missing dcterms:source."@en ;
            sh:minCount 1 ;
            sh:path dcterms:source ;
            sh:severity sh:Violation ] ;
    sh:targetClass redo1:CompactionFidelityDrift .

redo:CountDriftRecomputableShape a sh:NodeShape ;
    rdfs:label "DRIFT-2: CountDrift must record both reported and recomputed counts"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    rdfs:comment "Every CountDrift instance must record the wrong claim and the recomputed-against-source-of-truth claim, both as literals, so the gap is auditable. Without these, the drift is a label, not evidence."@en ;
    sh:property [ sh:message "a reliability ontology DRIFT-2 FAIL: CountDrift {$this} missing redo:reportedCount. The wrong number must be recorded."@en ;
            sh:minCount 1 ;
            sh:path redo1:reportedCount ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology DRIFT-2 FAIL: CountDrift {$this} missing redo:recomputedCount. The right number — recomputed against on-disk source — must be recorded."@en ;
            sh:minCount 1 ;
            sh:path redo1:recomputedCount ;
            sh:severity sh:Violation ] ;
    sh:targetClass redo1:CountDrift .

redo:CrossSessionContaminationSourceShape a sh:NodeShape ;
    rdfs:label "DRIFT-6: CrossSessionContamination must cite the foreign-session source"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    rdfs:comment "Every CrossSessionContamination instance must cite redo:foreignSessionURI (the chat URL or transcript id of the OTHER session whose content was contaminated into the current session). Without it, the diagnosis is unverifiable."@en ;
    sh:property [ sh:message "a reliability ontology DRIFT-6 FAIL: CrossSessionContamination {$this} missing redo:foreignSessionURI."@en ;
            sh:minCount 1 ;
            sh:path redo1:foreignSessionURI ;
            sh:severity sh:Violation ] ;
    sh:targetClass redo1:CrossSessionContamination .

redo:D3plus_DatatypePropertyDocShape a sh:NodeShape ;
    rdfs:label "D3+: DatatypeProperty must have label and definition"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    sh:property [ sh:message "a reliability ontology D3+ WARNING: DatatypeProperty missing rdfs:isDefinedBy. Properties must back-reference their defining ontology."@en ;
            sh:minCount 1 ;
            sh:path rdfs:isDefinedBy ;
            sh:severity sh:Warning ],
        [ sh:message "a reliability ontology D3+ WARNING: DatatypeProperty missing dcterms:source. Properties should cite an authoritative source for their semantics."@en ;
            sh:minCount 1 ;
            sh:path dcterms:source ;
            sh:severity sh:Warning ],
        [ sh:message "a reliability ontology D3+ FAIL: DatatypeProperty missing rdfs:label."@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ;
            sh:severity sh:Warning ],
        [ sh:message "a reliability ontology D3+ FAIL: DatatypeProperty missing skos:definition."@en ;
            sh:minCount 1 ;
            sh:path skos:definition ;
            sh:severity sh:Warning ] ;
    sh:targetClass owl:DatatypeProperty .

redo:D3plus_ObjectPropertyDocShape a sh:NodeShape ;
    rdfs:label "D3+: ObjectProperty must have label and definition"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    sh:property [ sh:message "a reliability ontology D3+ WARNING: ObjectProperty missing rdfs:isDefinedBy. Properties must back-reference their defining ontology."@en ;
            sh:minCount 1 ;
            sh:path rdfs:isDefinedBy ;
            sh:severity sh:Warning ],
        [ sh:message "a reliability ontology D3+ WARNING: ObjectProperty missing dcterms:source. Properties should cite an authoritative source for their semantics."@en ;
            sh:minCount 1 ;
            sh:path dcterms:source ;
            sh:severity sh:Warning ],
        [ sh:message "a reliability ontology D3+ FAIL: ObjectProperty missing rdfs:label."@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ;
            sh:severity sh:Warning ],
        [ sh:message "a reliability ontology D3+ FAIL: ObjectProperty missing skos:definition."@en ;
            sh:minCount 1 ;
            sh:path skos:definition ;
            sh:severity sh:Warning ] ;
    sh:targetClass owl:ObjectProperty .

redo:DRIFT17_InstanceShape a sh:NodeShape ;
    rdfs:label "DRIFT-17: OWL2DLProfileDrift instance must record offending IRI + conflicting types + source"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "a reliability ontology DRIFT-17 FAIL: OWL2DLProfileDrift {$this} missing redo1:hasSeverity in {LOW,MEDIUM,HIGH}."@en ;
            sh:minCount 1 ;
            sh:path redo1:hasSeverity ],
        [ sh:message "a reliability ontology DRIFT-17 FAIL: OWL2DLProfileDrift {$this} missing redo1:offendingIRI. Record the IRI of the property/class with the profile violation."@en ;
            sh:minCount 1 ;
            sh:path redo1:offendingIRI ],
        [ sh:message "a reliability ontology DRIFT-17 FAIL: OWL2DLProfileDrift {$this} missing redo1:conflictingTypes. List the OWL types that overlap (e.g., 'owl:ObjectProperty,owl:DatatypeProperty')."@en ;
            sh:minCount 1 ;
            sh:path redo1:conflictingTypes ],
        [ sh:message "a reliability ontology DRIFT-17 FAIL: OWL2DLProfileDrift {$this} missing dcterms:source citing the audit/assessment section that uncovered it."@en ;
            sh:minCount 1 ;
            sh:path dcterms:source ] ;
    sh:targetClass redo1:OWL2DLProfileDrift .

redo:DeliverablePROVValidationShape a sh:NodeShape ;
    rdfs:label "DRIFT-12: DeliverablePROVValidationDrift must record file path + vocab-trigger + validation-run boolean"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    rdfs:comment "Every DeliverablePROVValidationDrift instance must record which PROV file is in question (redo1:provFilePath), whether a reliability ontology/AMOD vocabulary was used (redo1:redoVocabularyUsed - the trigger condition), whether SHACL was actually run (redo1:shaclValidationRun - the drift state when false), and severity. If shaclValidationRun=true, shaclShapesUsed should name the shapes file."@en ;
    sh:property [ sh:message "a reliability ontology DRIFT-12 FAIL: DeliverablePROVValidationDrift {$this} missing redo1:provFilePath. Identify the PROV file."@en ;
            sh:minCount 1 ;
            sh:path redo1:provFilePath ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:boolean ;
            sh:message "a reliability ontology DRIFT-12 FAIL: DeliverablePROVValidationDrift {$this} missing redo1:redoVocabularyUsed. Record whether the file declares redo:/amod:/core: types (the trigger condition)."@en ;
            sh:minCount 1 ;
            sh:path redo1:redoVocabularyUsed ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:boolean ;
            sh:message "a reliability ontology DRIFT-12 FAIL: DeliverablePROVValidationDrift {$this} missing redo1:shaclValidationRun. Record whether SHACL was actually run (false=drift state)."@en ;
            sh:minCount 1 ;
            sh:path redo1:shaclValidationRun ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology DRIFT-12 FAIL: DeliverablePROVValidationDrift {$this} missing dcterms:source citing the audit-document section."@en ;
            sh:minCount 1 ;
            sh:path dcterms:source ;
            sh:severity sh:Violation ],
        [ sh:in ( "LOW" "MEDIUM" "HIGH" ) ;
            sh:message "a reliability ontology DRIFT-12 FAIL: DeliverablePROVValidationDrift {$this} missing redo1:hasSeverity in {LOW,MEDIUM,HIGH}."@en ;
            sh:minCount 1 ;
            sh:path redo1:hasSeverity ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:boolean ;
            sh:message "a reliability ontology DRIFT-12 FAIL: DeliverablePROVValidationDrift {$this} missing redo1:redoVocabularyUsed. Record whether the file declares redo:/configuration:/core: types (the trigger condition)."@en ;
            sh:minCount 1 ;
            sh:path redo1:redoVocabularyUsed ;
            sh:severity sh:Violation ] ;
    sh:targetClass redo1:DeliverablePROVValidationDrift .

redo:DriftDocumentationShape a sh:NodeShape ;
    rdfs:label "DRIFT-1: Drift instance must declare severity, provenance, remediation"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    rdfs:comment "Every NamedIndividual typed as redo:Drift (or any subclass) must have: redo:hasSeverity, dcterms:source (provenance trail to the audit record where the drift was first surfaced), and core:mitigates or skos:related to the remediation activity. Without this triad, a recorded drift cannot be audited."@en ;
    sh:property [ sh:message "a reliability ontology DRIFT-1 FAIL: redo:Drift individual {$this} missing redo:hasSeverity. Severity (LOW/MEDIUM/HIGH) must be declared so triage is possible."@en ;
            sh:minCount 1 ;
            sh:path redo1:hasSeverity ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology DRIFT-1 FAIL: redo:Drift individual {$this} missing dcterms:source. Every drift instance must cite the audit record (transcript, conversation_audit_v*.md, or similar) that is the primary evidence."@en ;
            sh:minCount 1 ;
            sh:path dcterms:source ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology DRIFT-1 WARNING: redo:Drift individual {$this} missing rdfs:isDefinedBy. Drift instances should be anchored to a defining ontology IRI."@en ;
            sh:minCount 1 ;
            sh:path rdfs:isDefinedBy ;
            sh:severity sh:Warning ] ;
    sh:targetClass redo1:Drift .

redo:GoalContradictionUserTurnShape a sh:NodeShape ;
    rdfs:label "DRIFT-3: GoalContradictionDrift must cite the contradicting user turn verbatim"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    rdfs:comment "Every GoalContradictionDrift instance must include redo:verbatimUserTurn (the literal text of the user turn the agent contradicted) plus redo:userTurnTimestamp. Verbatim text is the primary evidence; without it the contradiction is asserted, not demonstrated."@en ;
    sh:property [ sh:message "a reliability ontology DRIFT-3 FAIL: GoalContradictionDrift {$this} missing redo:verbatimUserTurn. Quote the user's actual words."@en ;
            sh:minCount 1 ;
            sh:path redo1:verbatimUserTurn ;
            sh:severity sh:Violation ] ;
    sh:targetClass redo1:GoalContradictionDrift .

redo:InheritedTrustDegradationShape a sh:NodeShape ;
    rdfs:label "DRIFT-8: InheritedTrustDegradationDrift must record upstream + propagated trust labels"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    rdfs:comment "Every InheritedTrustDegradationDrift instance must record the trust label of the upstream evidence (redo1:upstreamTrustLevel in {HIGH,MEDIUM,LOW,MISSING,FABRICATED}) and the trust label assumed by the downstream consumer (redo1:downstreamPropagatedTrustLevel, from the same list)."@en ;
    sh:property [ sh:in ( "LOW" "MEDIUM" "HIGH" ) ;
            sh:message "a reliability ontology DRIFT-8 FAIL: InheritedTrustDegradationDrift {$this} missing redo1:hasSeverity."@en ;
            sh:minCount 1 ;
            sh:path redo1:hasSeverity ;
            sh:severity sh:Violation ],
        [ sh:in ( "HIGH" "MEDIUM" "LOW" "MISSING" "FABRICATED" ) ;
            sh:message "a reliability ontology DRIFT-8 FAIL: InheritedTrustDegradationDrift {$this} missing redo1:upstreamTrustLevel in {HIGH,MEDIUM,LOW,MISSING,FABRICATED}."@en ;
            sh:minCount 1 ;
            sh:path redo1:upstreamTrustLevel ;
            sh:severity sh:Violation ],
        [ sh:in ( "HIGH" "MEDIUM" "LOW" "MISSING" "FABRICATED" ) ;
            sh:message "a reliability ontology DRIFT-8 FAIL: InheritedTrustDegradationDrift {$this} missing redo1:downstreamPropagatedTrustLevel in {HIGH,MEDIUM,LOW,MISSING,FABRICATED}."@en ;
            sh:minCount 1 ;
            sh:path redo1:downstreamPropagatedTrustLevel ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology DRIFT-8 FAIL: InheritedTrustDegradationDrift {$this} missing dcterms:source."@en ;
            sh:minCount 1 ;
            sh:path dcterms:source ;
            sh:severity sh:Violation ] ;
    sh:targetClass redo1:InheritedTrustDegradationDrift .

redo:NEG8_ABoxAntiGamingShape a sh:NodeShape ;
    rdfs:label "NEG_8: ABox quality must not be masked by TBox statistics"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    rdfs:comment """a reliability ontology v2 anti-sycophancy check. This shape fires a WARNING
on the ontology itself if >5% of NamedIndividuals lack rdfs:label. 
This catches the scenario where 'label coverage = 100%' refers only 
to classes while hundreds of individuals have no labels."""@en ;
    sh:sparql [ sh:message "a reliability ontology NEG_8 WARNING: {?unlabeled_count} NamedIndividuals lack rdfs:label ({?pct}% unlabeled). Aggregate class stats may mask ABox defects."@en ;
            sh:select """
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX owl:  <http://www.w3.org/2002/07/owl#>
            SELECT $this ?unlabeled_count ?pct
            WHERE {
                {
                    SELECT (COUNT(?ind) AS ?total) (COUNT(?ind) - COUNT(?lbl) AS ?unlabeled_count)
                    WHERE {
                        ?ind a owl:NamedIndividual .
                        OPTIONAL { ?ind rdfs:label ?lbl }
                    }
                }
                BIND(IF(?total > 0, ROUND(?unlabeled_count * 100 / ?total), 0) AS ?pct)
                FILTER(?pct > 5)
            }
        """ ;
            sh:severity sh:Warning ] ;
    sh:targetClass owl:Ontology .

redo:OntologyHeaderShape a sh:NodeShape ;
    rdfs:label "Ontology header must have version metadata"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    sh:property [ sh:message "a reliability ontology FAIL: Ontology missing owl:versionIRI."@en ;
            sh:minCount 1 ;
            sh:path owl:versionIRI ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology FAIL: Ontology missing owl:versionInfo."@en ;
            sh:minCount 1 ;
            sh:path owl:versionInfo ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology FAIL: Ontology missing dcterms:description."@en ;
            sh:minCount 1 ;
            sh:path dcterms:description ;
            sh:severity sh:Warning ] ;
    sh:targetClass owl:Ontology .

redo:OscillationVersionListShape a sh:NodeShape ;
    rdfs:label "DRIFT-5: OscillationPattern must enumerate the version sequence"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    rdfs:comment "Every OscillationPattern instance must list the rdf:List of versions that constitute the oscillation, plus redo:oscillationWindow (time bound). Without these, oscillation cannot be distinguished from healthy iteration."@en ;
    sh:property [ sh:message "a reliability ontology DRIFT-5 FAIL: OscillationPattern {$this} missing redo:oscillatingVersions list."@en ;
            sh:minCount 1 ;
            sh:path redo1:oscillatingVersions ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology DRIFT-5 FAIL: OscillationPattern {$this} missing redo:oscillationWindow."@en ;
            sh:minCount 1 ;
            sh:path redo1:oscillationWindow ;
            sh:severity sh:Violation ] ;
    sh:targetClass redo1:OscillationPattern .

redo:RepeatedInstructionInsensitivityShape a sh:NodeShape ;
    rdfs:label "DRIFT-11: RepeatedInstructionInsensitivity must record verbatim instruction + repetition count >= 3"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    rdfs:comment "Every RepeatedInstructionInsensitivity instance must quote the user's repeated instruction verbatim (redo1:repeatedInstructionText) and record the count of distinct turns over which it was repeated (redo1:repetitionCount). Threshold 3 is the minimum to declare the pattern; 1-2 repetitions are normal user emphasis."@en ;
    sh:property [ sh:in ( "LOW" "MEDIUM" "HIGH" ) ;
            sh:message "a reliability ontology DRIFT-11 FAIL: RepeatedInstructionInsensitivity {$this} missing redo1:hasSeverity."@en ;
            sh:minCount 1 ;
            sh:path redo1:hasSeverity ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology DRIFT-11 FAIL: RepeatedInstructionInsensitivity {$this} missing redo1:repeatedInstructionText. Quote the user's verbatim instruction."@en ;
            sh:minCount 1 ;
            sh:path redo1:repeatedInstructionText ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:integer ;
            sh:message "a reliability ontology DRIFT-11 FAIL: RepeatedInstructionInsensitivity {$this} requires redo1:repetitionCount >= 3 (minimum threshold for declaring the pattern)."@en ;
            sh:minCount 1 ;
            sh:minInclusive 3 ;
            sh:path redo1:repetitionCount ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology DRIFT-11 FAIL: RepeatedInstructionInsensitivity {$this} missing dcterms:source."@en ;
            sh:minCount 1 ;
            sh:path dcterms:source ;
            sh:severity sh:Violation ] ;
    sh:targetClass redo1:RepeatedInstructionInsensitivity .

redo:S_AllSubjects_ClassSourceShape a sh:NodeShape ;
    rdfs:label "S-COV-2: every owl:Class must have dcterms:source" ;
    dcterms:isPartOf <http://example.org/redo> ;
    rdfs:comment "Coverage shape — flags any owl:Class lacking a dcterms:source citation (BP-D42-style external anchoring or explicit internal rationale). Applies across all v19 subjects. Advisory severity (Warning)."@en ;
    sh:property [ sh:message "S-COV-2: owl:Class lacks dcterms:source (BP-D42 anchoring gap)" ;
            sh:minCount 1 ;
            sh:path dcterms:source ;
            sh:severity sh:Warning ] ;
    sh:targetClass owl:Class .

redo:S_AllSubjects_NamedIndividualSourceShape a sh:NodeShape ;
    rdfs:label "S-COV-3: every owl:NamedIndividual must have dcterms:source" ;
    dcterms:isPartOf <http://example.org/redo> ;
    rdfs:comment "Coverage shape — flags individuals declared without provenance (dcterms:source). Applies across all v19 subjects. Advisory severity (Warning)."@en ;
    sh:property [ sh:message "S-COV-3: owl:NamedIndividual lacks dcterms:source (provenance gap)" ;
            sh:minCount 1 ;
            sh:path dcterms:source ;
            sh:severity sh:Warning ] ;
    sh:targetClass owl:NamedIndividual .

redo:S_MEAS_2_ScoreMustBindMetric a sh:NodeShape ;
    rdfs:label "S-MEAS-2: Score must reference its Metric (hasMetric or bindsMetric)" ;
    dcterms:isPartOf <http://example.org/redo> ;
    dcterms:source "Authored 2026-05-27 during semantic-shape test drive. Validated against the merged v19 data graph."@en ;
    rdfs:comment "A score is uninterpretable without a metric reference. The measurement TBox declares both oem:hasMetric and oem:bindsMetric for this binding; at least one must be present on every Score instance. Survived the v19.10.0 test drive: 46 hits across 42 instances (real catches, no false positives)."@en ;
    sh:message "Score instance has no oem:derivedFromMetric, oem:hasMetric, or oem:bindsMetric (S-MEAS-2: uninterpretable score)"@en ;
    sh:or ( [ sh:minCount 1 ;
                sh:path oe_measurement:hasMetric ] [ sh:minCount 1 ;
                sh:path oe_measurement:bindsMetric ] [ sh:minCount 1 ;
                sh:path oe_measurement:derivedFromMetric ] ) ;
    sh:severity sh:Violation ;
    sh:targetClass oe_measurement:Score .

redo:SearchResultStalenessShape a sh:NodeShape ;
    rdfs:label "DRIFT-7: SearchResultStalenessDrift must record returned metadata + timestamp + resource ID"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    rdfs:comment "Every SearchResultStalenessDrift instance must record the literal title returned by the retrieval tool (redo1:returnedTitle), when it was returned (redo1:returnedAtTimestamp), the stable identifier of the resource (redo1:resourceIdentifier), severity, and dcterms:source citing the audit-document section."@en ;
    sh:property [ sh:in ( "LOW" "MEDIUM" "HIGH" ) ;
            sh:message "a reliability ontology DRIFT-7 FAIL: SearchResultStalenessDrift {$this} missing redo1:hasSeverity in {LOW,MEDIUM,HIGH}."@en ;
            sh:minCount 1 ;
            sh:path redo1:hasSeverity ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology DRIFT-7 FAIL: SearchResultStalenessDrift {$this} missing redo1:returnedTitle. Record the actual literal returned by the retrieval tool."@en ;
            sh:minCount 1 ;
            sh:path redo1:returnedTitle ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:dateTime ;
            sh:message "a reliability ontology DRIFT-7 FAIL: SearchResultStalenessDrift {$this} missing redo1:returnedAtTimestamp. Record when the retrieval tool returned the metadata."@en ;
            sh:minCount 1 ;
            sh:path redo1:returnedAtTimestamp ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology DRIFT-7 FAIL: SearchResultStalenessDrift {$this} missing redo1:resourceIdentifier. Record the stable identifier (UUID, file path, IRI) of the resource."@en ;
            sh:minCount 1 ;
            sh:path redo1:resourceIdentifier ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology DRIFT-7 FAIL: SearchResultStalenessDrift {$this} missing dcterms:source citing the audit-document section."@en ;
            sh:minCount 1 ;
            sh:path dcterms:source ;
            sh:severity sh:Violation ] ;
    sh:targetClass redo1:SearchResultStalenessDrift .

redo:SelfAuditConflictOfInterestShape a sh:NodeShape ;
    rdfs:label "DRIFT-9: SelfAuditConflictOfInterest must record both sessions + declaration boolean"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    rdfs:comment "Every SelfAuditConflictOfInterest instance must identify both the audited session (redo1:auditedSession) and the authoring session (redo1:authoringSession), and explicitly state via redo1:conflictDeclared whether the conflict was declared in the audit document. Conflict-declared=true means the audit author surfaced the conflict; false is the actual drift state."@en ;
    sh:property [ sh:in ( "LOW" "MEDIUM" "HIGH" ) ;
            sh:message "a reliability ontology DRIFT-9 FAIL: SelfAuditConflictOfInterest {$this} missing redo1:hasSeverity."@en ;
            sh:minCount 1 ;
            sh:path redo1:hasSeverity ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology DRIFT-9 FAIL: SelfAuditConflictOfInterest {$this} missing redo1:auditedSession identifier."@en ;
            sh:minCount 1 ;
            sh:path redo1:auditedSession ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology DRIFT-9 FAIL: SelfAuditConflictOfInterest {$this} missing redo1:authoringSession identifier."@en ;
            sh:minCount 1 ;
            sh:path redo1:authoringSession ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:boolean ;
            sh:message "a reliability ontology DRIFT-9 FAIL: SelfAuditConflictOfInterest {$this} missing redo1:conflictDeclared boolean. Use true if conflict is openly declared, false to record the drift state."@en ;
            sh:minCount 1 ;
            sh:path redo1:conflictDeclared ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology DRIFT-9 FAIL: SelfAuditConflictOfInterest {$this} missing dcterms:source."@en ;
            sh:minCount 1 ;
            sh:path dcterms:source ;
            sh:severity sh:Violation ] ;
    sh:targetClass redo1:SelfAuditConflictOfInterest .

redo:TranscriptAvailabilityLagShape a sh:NodeShape ;
    rdfs:label "DRIFT-13: TranscriptAvailabilityLagDrift must declare fallback evidence + trust"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    rdfs:comment "Every TranscriptAvailabilityLagDrift instance must record the expected transcript path (redo1:expectedTranscriptPath), the on-disk-or-not boolean (redo1:transcriptOnDisk), the fallback evidence channel used instead (redo1:fallbackEvidence), and the trust label of that fallback (redo1:trustOfFallback)."@en ;
    sh:property [ sh:in ( "LOW" "MEDIUM" "HIGH" ) ;
            sh:message "a reliability ontology DRIFT-13 FAIL: TranscriptAvailabilityLagDrift {$this} missing redo1:hasSeverity."@en ;
            sh:minCount 1 ;
            sh:path redo1:hasSeverity ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology DRIFT-13 FAIL: TranscriptAvailabilityLagDrift {$this} missing redo1:expectedTranscriptPath."@en ;
            sh:minCount 1 ;
            sh:path redo1:expectedTranscriptPath ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:boolean ;
            sh:message "a reliability ontology DRIFT-13 FAIL: TranscriptAvailabilityLagDrift {$this} missing redo1:transcriptOnDisk boolean (false=lag-drift state)."@en ;
            sh:minCount 1 ;
            sh:path redo1:transcriptOnDisk ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology DRIFT-13 FAIL: TranscriptAvailabilityLagDrift {$this} missing redo1:fallbackEvidence. Declare what was used in place of the missing transcript."@en ;
            sh:minCount 1 ;
            sh:path redo1:fallbackEvidence ;
            sh:severity sh:Violation ],
        [ sh:in ( "HIGH" "MEDIUM" "LOW" ) ;
            sh:message "a reliability ontology DRIFT-13 FAIL: TranscriptAvailabilityLagDrift {$this} missing redo1:trustOfFallback in {HIGH,MEDIUM,LOW}."@en ;
            sh:minCount 1 ;
            sh:path redo1:trustOfFallback ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology DRIFT-13 FAIL: TranscriptAvailabilityLagDrift {$this} missing dcterms:source."@en ;
            sh:minCount 1 ;
            sh:path dcterms:source ;
            sh:severity sh:Violation ] ;
    sh:targetClass redo1:TranscriptAvailabilityLagDrift .

redo:UnresolvedBlockingQuestionShape a sh:NodeShape ;
    rdfs:label "DRIFT-10: UnresolvedBlockingQuestionDrift must quote the blocker verbatim + state proceed-without-resolution"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    rdfs:comment "Every UnresolvedBlockingQuestionDrift instance must quote the blocking-question text from the upstream artefact (redo1:blockingQuestionText) and explicitly state whether work proceeded despite the blocker (redo1:proceededWithoutResolution=true is the drift state)."@en ;
    sh:property [ sh:in ( "LOW" "MEDIUM" "HIGH" ) ;
            sh:message "a reliability ontology DRIFT-10 FAIL: UnresolvedBlockingQuestionDrift {$this} missing redo1:hasSeverity."@en ;
            sh:minCount 1 ;
            sh:path redo1:hasSeverity ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology DRIFT-10 FAIL: UnresolvedBlockingQuestionDrift {$this} missing redo1:blockingQuestionText. Quote the blocker verbatim from the upstream artefact."@en ;
            sh:minCount 1 ;
            sh:path redo1:blockingQuestionText ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:boolean ;
            sh:message "a reliability ontology DRIFT-10 FAIL: UnresolvedBlockingQuestionDrift {$this} missing redo1:proceededWithoutResolution boolean."@en ;
            sh:minCount 1 ;
            sh:path redo1:proceededWithoutResolution ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology DRIFT-10 FAIL: UnresolvedBlockingQuestionDrift {$this} missing dcterms:source."@en ;
            sh:minCount 1 ;
            sh:path dcterms:source ;
            sh:severity sh:Violation ] ;
    sh:targetClass redo1:UnresolvedBlockingQuestionDrift .

redo:UpstreamTrustLabelMissingShape a sh:NodeShape ;
    rdfs:label "DRIFT-14: UpstreamTrustLabelMissingDrift must record audit-trail system + presence-boolean + expected taxonomy"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    rdfs:comment "Every UpstreamTrustLabelMissingDrift instance must identify the audit-trail system whose entries lack trust labels (redo1:auditTrailSystem), record whether a trust label field is present (redo1:trustLabelFieldPresent — false is the drift state), and reference the expected taxonomy."@en ;
    sh:property [ sh:in ( "LOW" "MEDIUM" "HIGH" ) ;
            sh:message "a reliability ontology DRIFT-14 FAIL: UpstreamTrustLabelMissingDrift {$this} missing redo1:hasSeverity."@en ;
            sh:minCount 1 ;
            sh:path redo1:hasSeverity ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology DRIFT-14 FAIL: UpstreamTrustLabelMissingDrift {$this} missing redo1:auditTrailSystem identifier."@en ;
            sh:minCount 1 ;
            sh:path redo1:auditTrailSystem ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:boolean ;
            sh:message "a reliability ontology DRIFT-14 FAIL: UpstreamTrustLabelMissingDrift {$this} missing redo1:trustLabelFieldPresent boolean (false=drift state)."@en ;
            sh:minCount 1 ;
            sh:path redo1:trustLabelFieldPresent ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology DRIFT-14 FAIL: UpstreamTrustLabelMissingDrift {$this} missing redo1:expectedTrustLabelTaxonomy. State the reference taxonomy."@en ;
            sh:minCount 1 ;
            sh:path redo1:expectedTrustLabelTaxonomy ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology DRIFT-14 FAIL: UpstreamTrustLabelMissingDrift {$this} missing dcterms:source."@en ;
            sh:minCount 1 ;
            sh:path dcterms:source ;
            sh:severity sh:Violation ] ;
    sh:targetClass redo1:UpstreamTrustLabelMissingDrift .

redo:UserDataInsufficiencyShape a sh:NodeShape ;
    rdfs:label "DRIFT-16: UserDataInsufficiencyDrift must publish tier breakdown (engine/calibration/user-data points)"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    rdfs:comment "Every UserDataInsufficiencyDrift instance must publish the tier breakdown of the gap-to-100: engine-bug points (redo1:engineGapPts), calibration points (redo1:calibrationGapPts), user-data-content points (redo1:userDataGapPts), and the published-or-not boolean (redo1:tierBreakdownPublished). Without the breakdown, the user cannot mechanically distinguish system bugs from content gaps."@en ;
    sh:property [ sh:in ( "LOW" "MEDIUM" "HIGH" ) ;
            sh:message "a reliability ontology DRIFT-16 FAIL: UserDataInsufficiencyDrift {$this} missing redo1:hasSeverity."@en ;
            sh:minCount 1 ;
            sh:path redo1:hasSeverity ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:decimal ;
            sh:message "a reliability ontology DRIFT-16 FAIL: UserDataInsufficiencyDrift {$this} missing redo1:engineGapPts (xsd:decimal)."@en ;
            sh:minCount 1 ;
            sh:path redo1:engineGapPts ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:decimal ;
            sh:message "a reliability ontology DRIFT-16 FAIL: UserDataInsufficiencyDrift {$this} missing redo1:calibrationGapPts (xsd:decimal)."@en ;
            sh:minCount 1 ;
            sh:path redo1:calibrationGapPts ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:decimal ;
            sh:message "a reliability ontology DRIFT-16 FAIL: UserDataInsufficiencyDrift {$this} missing redo1:userDataGapPts (xsd:decimal)."@en ;
            sh:minCount 1 ;
            sh:path redo1:userDataGapPts ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:boolean ;
            sh:message "a reliability ontology DRIFT-16 FAIL: UserDataInsufficiencyDrift {$this} missing redo1:tierBreakdownPublished boolean."@en ;
            sh:minCount 1 ;
            sh:path redo1:tierBreakdownPublished ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology DRIFT-16 FAIL: UserDataInsufficiencyDrift {$this} missing dcterms:source."@en ;
            sh:minCount 1 ;
            sh:path dcterms:source ;
            sh:severity sh:Violation ] ;
    sh:targetClass redo1:UserDataInsufficiencyDrift .

redo:ValidationScopeAnnotationShape a sh:NodeShape ;
    rdfs:label "DRIFT-4: ValidationScopeDrift must record both scope and inference profile"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    rdfs:comment "Every ValidationScopeDrift instance must declare redo:validationScope (e.g. 'standalone'/'ecosystem-combined') and redo:inferenceProfile (e.g. 'none'/'rdfs'/'owlrl'). These are the dimensions along which the verdict drifted."@en ;
    sh:property [ sh:message "a reliability ontology DRIFT-4 FAIL: ValidationScopeDrift {$this} missing redo:validationScope."@en ;
            sh:minCount 1 ;
            sh:path redo1:validationScope ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology DRIFT-4 FAIL: ValidationScopeDrift {$this} missing redo:inferenceProfile."@en ;
            sh:minCount 1 ;
            sh:path redo1:inferenceProfile ;
            sh:severity sh:Violation ] ;
    sh:targetClass redo1:ValidationScopeDrift .

<http://example.org/redo-shacl> dcterms:isPartOf <http://example.org/redo> ;
    rdfs:comment "v2.0.13.3 (2026-05-12): Track A extension. The three S_PROFILE_OWL2DL_*_OVERLAP_Shape constraints (CLASS_DATATYPE, OP_DP, AP_OP_DP) are rewritten from sh:sparql to sh:not[sh:property[sh:path rdf:type; sh:hasValue X]] (with sh:or for the AP_OP_DP UNION case). Empirically validated: 22.80x speedup on CLASS_DATATYPE, 10.66x on AP_OP_DP, with strict focus-node parity. Lineage: CONTINUATION of v2.0.13.2."@en ;
    owl:priorVersion <http://example.org/redo-shacl/2.0.13.2> ;
    owl:versionIRI <http://example.org/redo-shacl/2.0.13.3> ;
    owl:versionInfo "2.0.13.3" .

ex:S_PROFILE_OWL2DL_AP_OP_DP_OVERLAP_Shape a sh:NodeShape ;
    rdfs:label "DRIFT-17c: OWL 2 DL profile — annotation properties must be disjoint from object/datatype properties"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.15 / safeguard v1.9. Grounded on W3C OWL 2 Profiles REC-owl2-profiles-20121211 §3."@en ;
    sh:message "a reliability ontology DRIFT-17c FAIL: {$this} is declared as owl:AnnotationProperty AND (owl:ObjectProperty or owl:DatatypeProperty). OWL 2 DL requires AP/OP/DP disjointness."@en ;
    sh:not [ sh:or ( [ sh:property [ sh:hasValue owl:ObjectProperty ;
                                sh:minCount 1 ;
                                sh:path rdf:type ] ] [ sh:property [ sh:hasValue owl:DatatypeProperty ;
                                sh:minCount 1 ;
                                sh:path rdf:type ] ] ) ] ;
    sh:severity sh:Violation ;
    sh:targetClass owl:AnnotationProperty .

ex:S_PROFILE_OWL2DL_CLASS_DATATYPE_OVERLAP_Shape a sh:NodeShape ;
    rdfs:label "DRIFT-17b: OWL 2 DL profile — no IRI may be both owl:Class and rdfs:Datatype"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.15 / safeguard v1.9. Grounded on W3C OWL 2 Profiles REC-owl2-profiles-20121211 §3."@en ;
    sh:message "a reliability ontology DRIFT-17b FAIL: {$this} is declared as both owl:Class and rdfs:Datatype. OWL 2 DL forbids class/datatype IRI collision."@en ;
    sh:not [ sh:property [ sh:hasValue rdfs:Datatype ;
                    sh:minCount 1 ;
                    sh:path rdf:type ] ] ;
    sh:severity sh:Violation ;
    sh:targetClass owl:Class .

ex:S_PROFILE_OWL2DL_OP_DP_OVERLAP_Shape a sh:NodeShape ;
    rdfs:label "DRIFT-17a: OWL 2 DL profile — no property may be both ObjectProperty and DatatypeProperty"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    dcterms:source "a reliability ontology Reliability Engineering Domain Ontology v2.5.15 / safeguard v1.9. Grounded on W3C OWL 2 Profiles REC-owl2-profiles-20121211 §3."@en ;
    sh:message "a reliability ontology DRIFT-17a FAIL: {$this} is declared as both owl:ObjectProperty and owl:DatatypeProperty. OWL 2 DL profile forbids this overlap; falls into OWL 2 Full where standard DL reasoners (HermiT, Pellet) lose decidability guarantees. Remediation: pick one type based on actual usage and remove the other."@en ;
    sh:not [ sh:property [ sh:hasValue owl:DatatypeProperty ;
                    sh:minCount 1 ;
                    sh:path rdf:type ] ] ;
    sh:severity sh:Violation ;
    sh:targetClass owl:ObjectProperty .

ex:S_STRUCT_1_RestrictionsAsParentShape a sh:NodeShape ;
    rdfs:label "a reliability ontology S-STRUCT-1: Named OWL Restriction as subClassOf parent" ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    rdfs:comment "Detects owl:Class instances that declare rdfs:subClassOf pointing to an owl:Restriction. OWL restrictions are axioms that constrain property usage; they must be anonymous blank nodes, not named-class parents. A named restriction used as a parent creates a broken hierarchy link: the restriction has no rdfs:label, skos:definition, or subclass structure, so the class appears to inherit from a non-class entity. Fix: remove the subClassOf triple pointing to the restriction and express the constraint as owl:equivalentClass or inline."@en ;
    sh:severity sh:Violation ;
    sh:sparql [ sh:message "a reliability ontology S-STRUCT-1 VIOLATION: {$this} declares rdfs:subClassOf pointing to an owl:Restriction ({?restrictionParent}). OWL restrictions must be anonymous blank nodes, not named-class parents. Remove this subClassOf triple; the constraint should be expressed inline or as owl:equivalentClass."@en ;
            sh:select """
    PREFIX owl: <http://www.w3.org/2002/07/owl#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
    SELECT $this ?restrictionParent WHERE {
        $this a owl:Class .
        $this rdfs:subClassOf ?restrictionParent .
        ?restrictionParent rdf:type owl:Restriction .
        FILTER(isIRI(?restrictionParent))
    }
""" ;
            sh:severity sh:Violation ] ;
    sh:targetClass owl:Class .

ex:S_STRUCT_2_IsolatedClassShape a sh:NodeShape ;
    rdfs:label "a reliability ontology S-STRUCT-2: Isolated class with no hierarchy placement" ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    rdfs:comment "Detects owl:Class instances that have no rdfs:subClassOf parent (excluding owl:Thing) AND no other class declares them as a parent via rdfs:subClassOf. Such classes are disconnected from the class hierarchy: they cannot be reached by hierarchy traversal and do not group any subclasses. These are often missed concepts that should be placed under an appropriate parent, or concepts that have been defined but never integrated into the taxonomy. Severity: Warning (some root primitives are intentionally isolated within a single-file graph but used as parents in importing ontologies)."@en ;
    sh:severity sh:Warning ;
    sh:sparql [ sh:message "a reliability ontology S-STRUCT-2 WARNING: {$this} is an isolated class — it has no rdfs:subClassOf parent (other than owl:Thing) and no class declares it as parent. Review whether this class should be placed in the hierarchy or whether it is an intentional root primitive used as a parent in an importing ontology."@en ;
            sh:select """
    PREFIX owl: <http://www.w3.org/2002/07/owl#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT $this WHERE {
        $this a owl:Class .
        FILTER NOT EXISTS {
            $this rdfs:subClassOf ?parent .
            FILTER(?parent != <http://www.w3.org/2002/07/owl#Thing>)
        }
        FILTER NOT EXISTS { ?child rdfs:subClassOf $this . }
    }
""" ;
            sh:severity sh:Warning ] ;
    sh:targetClass owl:Class .

ex:S_STRUCT_3_DisjointParentInheritanceShape a sh:NodeShape ;
    rdfs:label "a reliability ontology S-STRUCT-3: Multiple inheritance from disjoint parents" ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    rdfs:comment "Detects owl:Class instances that declare rdfs:subClassOf two or more classes that are declared mutually owl:disjointWith. In OWL 2 DL semantics, a class that is subClassOf two disjoint classes is logically unsatisfiable — equivalent to owl:Nothing. No individual can ever be an instance of such a class. This is a taxonomy design error that a full OWL reasoner (HermiT, Pellet) would flag as an unsatisfiable class. SPARQL detection covers pairwise disjointWith declarations; AllDisjointClasses blocks require the consuming graph to materialize pairwise triples for this shape to fire."@en ;
    sh:severity sh:Violation ;
    sh:sparql [ sh:message "a reliability ontology S-STRUCT-3 VIOLATION: {$this} inherits from {?p1} and {?p2} which are declared owl:disjointWith each other. This makes {$this} logically unsatisfiable (equivalent to owl:Nothing). Remove one parent or revise the disjointWith declaration."@en ;
            sh:select """
    PREFIX owl: <http://www.w3.org/2002/07/owl#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT $this ?p1 ?p2 WHERE {
        $this a owl:Class .
        $this rdfs:subClassOf ?p1 .
        $this rdfs:subClassOf ?p2 .
        FILTER(?p1 != ?p2)
        { ?p1 owl:disjointWith ?p2 . }
        UNION
        { ?p2 owl:disjointWith ?p1 . }
    }
""" ;
            sh:severity sh:Violation ] ;
    sh:targetClass owl:Class .

ex:S_STRUCT_4_SubClassOfCycleShape a sh:NodeShape ;
    rdfs:label "a reliability ontology S-STRUCT-4: Cycle in rdfs:subClassOf chain" ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    rdfs:comment "Detects owl:Class instances that are reachable from themselves via one or more rdfs:subClassOf steps (i.e. the class is its own ancestor). In OWL 2 DL, a cycle in the subclass hierarchy causes both classes in the cycle to be logically equivalent AND, if combined with any disjointWith declaration on ancestors, to be unsatisfiable. Even without disjointWith, a cycle violates the well-foundedness assumption of OWL class hierarchies. This shape uses the SPARQL 1.1 property path operator + to traverse chains of arbitrary length. Requires pySHACL >= 0.6.0 with SPARQL property path support. Empirically confirmed working: 2026-04-10 test on pySHACL 0.25.x."@en ;
    sh:severity sh:Violation ;
    sh:sparql [ sh:message "a reliability ontology S-STRUCT-4 VIOLATION: {$this} is reachable from itself via a non-reflexive rdfs:subClassOf+ chain — a cycle exists in the class hierarchy. This makes both classes in the cycle logically equivalent and may cause unsatisfiability when combined with disjointWith axioms. Remove one of the rdfs:subClassOf triples forming the cycle."@en ;
            sh:select """
    PREFIX owl: <http://www.w3.org/2002/07/owl#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT $this WHERE {
        $this a owl:Class .
        $this rdfs:subClassOf ?intermediate .
        FILTER(?intermediate != $this)
        ?intermediate rdfs:subClassOf+ $this .
    }
""" ;
            sh:severity sh:Violation ] ;
    sh:targetClass owl:Class .

<http://example.org/redo-shapes-drift19> a sh:NodeShape ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    sh:message "DRIFT-19: rdfs:range uses datatype outside OWL 2 DL datatype map (xsd:date, xsd:duration, xsd:gYear, etc. are not OWL 2 DL compliant). Use xsd:dateTime or xsd:string instead." ;
    sh:not [ sh:in ( xsd:date xsd:duration xsd:gYear xsd:gMonth xsd:gDay xsd:gMonthDay xsd:gYearMonth ) ;
            sh:path rdfs:range ] ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf rdfs:range .

