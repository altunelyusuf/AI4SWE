redo1:SafeguardVariantIncompletenessShape a sh:NodeShape ;
    rdfs:label "SafeguardVariantIncompleteness must have label, definition, source"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    rdfs:comment """a reliability ontology v2.5.4 — Enforces documentation for the SafeguardVariantIncompleteness
pathology. Requires skos:example documenting which variant was activated,
which base requirements were dropped, and which sprint was affected."""@en ;
    sh:property [ sh:message "a reliability ontology C2 FAIL: SafeguardVariantIncompleteness instance {$this} missing rdfs:label."@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology C2 FAIL: SafeguardVariantIncompleteness instance {$this} missing skos:definition."@en ;
            sh:minCount 1 ;
            sh:path skos:definition ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology C2+ WARN: SafeguardVariantIncompleteness {$this} missing skos:example with sprint evidence."@en ;
