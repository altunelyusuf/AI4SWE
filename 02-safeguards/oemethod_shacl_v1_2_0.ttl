            sh:description "Every mitigation strategy must mitigate at least one failure concept"@en ;
            sh:minCount 1 ;
            sh:name "mitigates target"@en ;
            sh:path core:mitigates ;
            sh:severity sh:Warning ] ;
    sh:targetClass redo1:FailureMitigation .

