<http://example.org/configuration-shapes> dcterms:isPartOf <http://example.org/configuration> ;
    rdfs:comment "amod SHACL v2.4.0 (MINOR) per v17.32.0 Option B — added 97 auto-generated skeleton NodeShapes for owl:Class declarations lacking SHACL coverage. Per BP-D27 each skeleton carries kb:isSkeletonShape true. Mechanical Roadmap Step 1; semantic constraints in Step 2."@en ;
    owl:priorVersion <http://example.org/configuration-shapes/2.3.2> ;
    owl:versionIRI <http://example.org/configuration-shapes/2.4.0> ;
    owl:versionInfo "2.4.0" .

core:Activity_Shape a sh:NodeShape ;
    rdfs:label "Lightweight semantic shape for Activity"@en ;
    dcterms:isPartOf <http://example.org/core> ;
    dcterms:source "OE Pack Option C — lightweight semantic upgrade for core per BP-D30."@en ;
    rdfs:comment "Lightweight semantic SHACL NodeShape per BP-D30. Activity has no direct rdfs:domain assertions; constraints inherit via OWL subClassOf entailment. Direct: sh:nodeKind sh:IRI."@en ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Info ;
    sh:targetClass core:Activity .

core:Agent_Shape a sh:NodeShape ;
    rdfs:label "Semantic shape for Agent"@en ;
    dcterms:isPartOf <http://example.org/core> ;
