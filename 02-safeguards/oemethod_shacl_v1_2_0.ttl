redo1:CompetenceParadox_Shape a sh:NodeShape ;
    rdfs:label "Semantic shape for CompetenceParadox"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    dcterms:source "OE Pack Option C — semantic shape upgrade for reliability subject per BP-D30."@en ;
    rdfs:comment "Semantic SHACL NodeShape per BP-D30. Declares 2 property constraint(s) for CompetenceParadox sourced from rdfs:domain assertions."@en ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:class redo1:VerificationModality ;
            sh:maxCount 1 ;
            sh:message "Property dormantCapabilityFor should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path redo1:dormantCapabilityFor ;
            sh:severity sh:Warning ],
        [ sh:class redo1:DormantCapabilityGap ;
            sh:maxCount 1 ;
            sh:message "Property detectedByMetric_CompPdx should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path redo1:detectedByMetric_CompPdx ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Warning ;
    sh:targetClass redo1:CompetenceParadox .

