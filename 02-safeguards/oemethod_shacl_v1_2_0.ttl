<http://example.org/oqc-measurements-shapes#AggregationRuleShape> a sh:NodeShape ;
    rdfs:label "AggregationRule integrity shape"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "OQC v2.3.0 qc:AggregationRule + subclasses; OQC Aggregation Rules v1.0.0."@en ;
    rdfs:isDefinedBy <http://example.org/oqc-measurements-shapes> ;
    skos:definition "Every qc:AggregationRule NamedIndividual (including subclass instances such as qc:WeightedSumRule, qc:OQuaRETierWeightedRule, qc:ArithmeticMeanRule, qc:GeometricMeanRule) must declare: at least one rdfs:label, at least one skos:definition citing the source paper (Duque-Ramos 2011, ISO/IEC 25023:2016, etc), and exactly one dcterms:source. WeightedSum-family rules additionally must declare both weight properties summing to 1.0."@en ;
    sh:property [ sh:message "OQC AR-V1: AggregationRule {$this} must declare at least one skos:definition citing its source paper / methodology."@en ;
            sh:minCount 1 ;
            sh:path skos:definition ;
            sh:severity sh:Violation ],
        [ sh:message "OQC AR-V2: AggregationRule {$this} must declare a dcterms:source for traceability."@en ;
            sh:minCount 1 ;
            sh:path dcterms:source ;
            sh:severity sh:Violation ] ;
    sh:targetClass quality:AggregationRule .

<http://example.org/oqc-measurements-shapes#QualityAssessmentShape> a sh:NodeShape ;
    rdfs:label "QualityAssessment integrity shape"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "OQC v2.2.5 qc:QualityAssessment class; OQC v2.3.0 qc:appliesAggregationRule property; OQC Aggregation Rules v1.0.0."@en ;
    rdfs:comment "Without this shape, a QualityAssessment with no assessesArtifact would silently pass validation, producing untraceable measurements. Per PR1 §3.4 this was a known measurement-readiness gap."@en ;
    rdfs:isDefinedBy <http://example.org/oqc-measurements-shapes> ;
    skos:definition "Every qc:QualityAssessment NamedIndividual must declare: at least one qc:assessesArtifact (what it measures), exactly one qc:appliesAggregationRule (how scores were combined — for reproducibility per PR1 §3.4), at least one qc:hasMetric (the metric used; per OQC TBox QualityAssessment ⊑ hasMetric min 1 Metric), exactly one qc:atTimestamp (when assessed)."@en ;
    sh:property [ sh:message "OQC QA-V1: QualityAssessment {$this} has no qc:assessesArtifact link. A QualityAssessment must declare at least one OntologyArtifact it assesses."@en ;
            sh:minCount 1 ;
            sh:path quality:assessesArtifact ;
            sh:severity sh:Violation ],
        [ sh:maxCount 1 ;
            sh:message "OQC QA-V2: QualityAssessment {$this} must declare exactly one qc:appliesAggregationRule (for score reproducibility per PR1 §3.4)."@en ;
            sh:minCount 1 ;
            sh:path quality:appliesAggregationRule ;
            sh:severity sh:Violation ],
        [ sh:message "OQC QA-V3: QualityAssessment {$this} has no qc:hasMetric. A QualityAssessment must carry at least one Metric (per OQC TBox: QualityAssessment ⊑ hasMetric min 1 Metric)."@en ;
            sh:minCount 1 ;
            sh:path quality:hasMetric ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "OQC QA-W1: QualityAssessment {$this} should declare a qc:atTimestamp (xsd:dateTime). Without timestamps, time-series reasoning over the ABox is broken."@en ;
            sh:minCount 1 ;
            sh:path quality:atTimestamp ;
            sh:severity sh:Warning ] ;
    sh:targetClass quality:QualityAssessment .

<http://example.org/oqc-measurements-shapes#ScoreShape> a sh:NodeShape ;
    rdfs:label "Score integrity shape"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "OQC v2.2.5 qc:Score class + qc:value property."@en ;
    rdfs:comment "The [0.0, 1.0] range constraint is enforced by qc:value's existing TBox restriction in OQC v2.2.5 (line 762 area) — this shape adds a focused, machine-checkable assertion at the ABox level."@en ;
    rdfs:isDefinedBy <http://example.org/oqc-measurements-shapes> ;
    skos:definition "Every qc:Score NamedIndividual must declare exactly one qc:value (xsd:decimal in [0.0, 1.0] for normalised scores). The Score's link to its measured QualityCriterion is implicit through its parent Metric (Metric → measuresCriterion → QualityCriterion + Metric → hasScore → Score). Raw structural-metric values that exceed [0,1] (e.g., InheritanceRichness=1.15) should be normalised before being stored as qc:Score."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:maxInclusive 1.0 ;
            sh:message "OQC SCORE-V1: Score {$this} must declare exactly one qc:value in [0.0, 1.0] (xsd:decimal). Raw structural metrics outside this range need normalisation before being stored as Score."@en ;
            sh:minCount 1 ;
            sh:minInclusive 0.0 ;
            sh:or ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:integer ] [ sh:datatype xsd:double ] [ sh:datatype xsd:float ] [ sh:datatype xsd:long ] [ sh:datatype xsd:nonNegativeInteger ] ) ;
            sh:path quality:value ;
            sh:severity sh:Violation ] ;
    sh:targetClass oe_measurement:Score .

<http://example.org/oqc-measurements-shapes#ThresholdRowShape> a sh:NodeShape ;
    rdfs:label "ThresholdRow integrity shape"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    dcterms:source "OQC v2.3.0 qc:ThresholdRow class + bounds + role + metric properties."@en ;
    rdfs:isDefinedBy <http://example.org/oqc-measurements-shapes> ;
    skos:definition "Every qc:ThresholdRow NamedIndividual must declare: exactly one qc:appliesToMetric (which metric this row is a threshold for), exactly one qc:appliesToRole (foundation / meta / domain / application — the role-aware band), exactly one qc:bandLevel (1..5 OQuaRE band) OR both qc:lowerBound + qc:upperBound (the numeric range). Without these constraints, threshold rows are uninterpretable."@en ;
    sh:property [ sh:message "OQC TR-W1: ThresholdRow {$this} should declare a qc:lowerBound (xsd:decimal) for queryable threshold computation."@en ;
            sh:or ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:integer ] [ sh:datatype xsd:double ] [ sh:datatype xsd:float ] [ sh:datatype xsd:long ] [ sh:datatype xsd:nonNegativeInteger ] ) ;
            sh:path oe_measurement:lowerBound ;
            sh:severity sh:Warning ],
        [ sh:message "OQC TR-W2: ThresholdRow {$this} should declare a qc:upperBound (xsd:decimal)."@en ;
            sh:or ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:integer ] [ sh:datatype xsd:double ] [ sh:datatype xsd:float ] [ sh:datatype xsd:long ] [ sh:datatype xsd:nonNegativeInteger ] ) ;
            sh:path oe_measurement:upperBound ;
            sh:severity sh:Warning ],
        [ sh:maxCount 1 ;
            sh:message "OQC TR-V1: ThresholdRow {$this} must declare exactly one qc:appliesToMetric."@en ;
            sh:minCount 1 ;
            sh:path oe_measurement:appliesToMetric ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:string ;
            sh:in ( "foundation" "meta" "domain" "application" ) ;
            sh:maxCount 1 ;
            sh:message "OQC TR-V2: ThresholdRow {$this} must declare exactly one qc:appliesToRole — one of: foundation, meta, domain, application."@en ;
            sh:minCount 1 ;
            sh:path oe_measurement:appliesToRole ;
            sh:severity sh:Violation ] ;
    sh:targetClass oe_measurement:RoleAwareThresholdRow .

<http://example.org/oqc-measurements-shapes/v1.0.2#HasMetricReferentialIntegrityShape> a sh:NodeShape ;
    rdfs:label "OQC QA-V4: hasMetric must reference a Metric with a SPARQL implementation (referential integrity)"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    rdfs:comment "Closes Test 10 gap from ecosystem-assessment v1.0.0. Per BP-D16: the OWL property qc:hasMetric has rdfs:range qc:Metric, so RDFS inference materializes every hasMetric value as qc:Metric — making a naive type-based check ineffective. This shape instead checks for qc:hasSPARQLImplementation, which is the ESSENTIAL property that marks a Metric as actually computable."@en ;
    sh:sparql [ sh:message "OQC QA-V4 referential integrity: QualityAssessment {$this} has qc:hasMetric → {?value}, but {?value} has neither qc:hasSPARQLImplementation (formula-based metric) nor qc:hasScore (Python-computed metric with results). Per BP-D2 raw inspection: an undeclared Metric IRI fails both checks. Verify the IRI is correct."@en ;
            sh:select """
PREFIX qc: <http://example.org/quality#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
SELECT $this ?value WHERE {
  $this qc:hasMetric ?value .
  FILTER NOT EXISTS { ?value qc:hasSPARQLImplementation ?s1 }
  FILTER NOT EXISTS { ?value owl:sameAs/qc:hasSPARQLImplementation ?s2 }
  FILTER NOT EXISTS { ?value qc:hasScore ?score }
}
""" ;
            sh:severity sh:Violation ] ;
    sh:targetClass quality:QualityAssessment .

<http://example.org/oqc-measurements-shapes/v1.0.2#QualityAssessmentClosedShape> a sh:NodeShape ;
    rdfs:label "OQC QA-V3: QualityAssessment is closed (typo prevention)"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    rdfs:comment "Whitelist from BP-D2 raw inspection including legacy v15.4 PROV-O usage. A closed shape must be told about a predicate before the data carries it (L-127): artifact-capability:hasCapabilityLevel and artifact-capability:hasScoreBasis were added when the capability assessment began recording its level and its score basis on the assessment record, which is the whole point of a disputable score. This shape prevents typos; it does not decide which sibling module may annotate an assessment."@en ;
    sh:closed true ;
    sh:ignoredProperties ( quality:appliesAggregationRule quality:assessesArtifact quality:atTimestamp quality:hasMetric quality:hasScore dcterms:source rdf:type rdfs:isDefinedBy rdfs:label skos:definition prov:wasGeneratedBy prov:atTime prov:generated dcterms:isPartOf acap:hasCapabilityLevel acap:hasScoreBasis ) ;
    sh:targetClass quality:QualityAssessment .

<http://example.org/oqc-measurements-shapes/v1.0.2#QualityMetricClosedShape> a sh:NodeShape ;
    rdfs:label "OQC METRIC-V1: QualityMetric is closed (typo prevention)"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    rdfs:comment "Whitelist from BP-D2 raw inspection."@en ;
    sh:closed true ;
    sh:ignoredProperties ( quality:hasSPARQLImplementation quality:hasScore quality:measuresCriterion dcterms:source rdf:type rdfs:isDefinedBy rdfs:label owl:sameAs skos:definition skos:example dcterms:isPartOf ) ;
    sh:targetClass quality:QualityMetric .

<http://example.org/oqc-measurements-shapes/v1.0.2#ScoreClosedShape> a sh:NodeShape ;
    rdfs:label "OQC SCORE-V2: Score is closed (typo prevention)"@en ;
    dcterms:isPartOf <http://example.org/measurement> ;
    rdfs:comment "Whitelist from BP-D2 raw inspection of family v17.1.8 Score instances."@en ;
    sh:closed true ;
    sh:ignoredProperties ( quality:value quality:isScoreOf dcterms:source rdf:type rdfs:comment rdfs:isDefinedBy rdfs:label skos:definition redo1:measuredAt redo1:asOfRelease oe_measurement:derivedFromMetric dcterms:isPartOf ) ;
    sh:property [ sh:class oe_measurement:ConfidenceTier ;
            sh:maxCount 1 ;
            sh:message "OQC SCORE-V3 FAIL: Score {$this} must carry exactly one oe_measurement:hasConfidenceTier whose value is a oe_measurement:ConfidenceTier (BP-D47)."@en ;
            sh:minCount 1 ;
            sh:path oe_measurement:hasConfidenceTier ;
            sh:severity sh:Violation ] ;
    sh:targetClass oe_measurement:Score .

performance:LoadingPerformanceTest_Shape a sh:NodeShape ;
    rdfs:label "Lightweight semantic shape for LoadingPerformanceTest"@en ;
    dcterms:isPartOf <http://example.org/performance> ;
    dcterms:source "OE Pack Option C — lightweight semantic upgrade for performance per BP-D30."@en ;
    rdfs:comment "Lightweight semantic SHACL NodeShape per BP-D30. LoadingPerformanceTest has no direct rdfs:domain assertions; constraints inherit via OWL subClassOf entailment. Direct: sh:nodeKind sh:IRI."@en ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Info ;
    sh:targetClass performance:LoadingPerformanceTest .

performance:PerformanceConcept_Shape a sh:NodeShape ;
    rdfs:label "Lightweight semantic shape for PerformanceConcept"@en ;
    dcterms:isPartOf <http://example.org/performance> ;
    dcterms:source "OE Pack Option C — lightweight semantic upgrade for performance per BP-D30."@en ;
    rdfs:comment "Lightweight semantic SHACL NodeShape per BP-D30. PerformanceConcept has no direct rdfs:domain assertions; constraints inherit via OWL subClassOf entailment. Direct: sh:nodeKind sh:IRI."@en ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Info ;
    sh:targetClass performance:PerformanceConcept .

performance:PerformanceEfficiency_Shape a sh:NodeShape ;
    rdfs:label "Semantic shape for PerformanceEfficiency"@en ;
    dcterms:isPartOf <http://example.org/performance> ;
    dcterms:source "OE Pack Option C — semantic shape upgrade for performance subject per BP-D30."@en ;
    rdfs:comment "Semantic SHACL NodeShape per BP-D30. Declares 2 property constraint(s) for PerformanceEfficiency sourced from rdfs:domain assertions."@en ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:class algorithm_efficiency:AsymptoticNotation ;
            sh:maxCount 1 ;
            sh:message "Property justifiedByComplexity should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path performance:justifiedByComplexity ;
            sh:severity sh:Warning ],
        [ sh:class algorithm_efficiency:AsymptoticNotation ;
            sh:maxCount 1 ;
            sh:message "Property hasTheoreticalComplexity should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path performance:hasTheoreticalComplexity ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Warning ;
    sh:targetClass performance:PerformanceEfficiency .

performance:PerformanceTestingCompletenessGate a sh:NodeShape ;
    rdfs:label "Performance-testing process-completeness gate (profile-parameterized)"@en ;
    dcterms:isPartOf <http://example.org/performance> ;
    rdfs:comment "EXT-2: at High/Critical CriticalityProfile, every PerformanceTest measuring the artifact must carry an actual measured result (hasLastMeasuredStatus or hasLastMeasuredMedianMs). Gates the discipline of performance testing, not the values."@en ;
    sh:sparql [ sh:message "Performance gate: at High/Critical, each PerformanceTest measuring this artifact must have a measured result."@en ;
            sh:select """PREFIX p: <http://example.org/performance#>
PREFIX core: <http://example.org/core#>
SELECT $this WHERE {
  $this core:hasCriticalityProfile ?pr . FILTER( ?pr IN ( core:Profile_High, core:Profile_Critical ) )
  ?t p:measuresArtifact $this .
  FILTER NOT EXISTS { ?t p:hasLastMeasuredStatus ?s }
  FILTER NOT EXISTS { ?t p:hasLastMeasuredMedianMs ?m }
}""" ;
            sh:severity sh:Violation ] ;
    sh:targetClass core:Artifact .

performance:QueryPerformanceTest_Shape a sh:NodeShape ;
    rdfs:label "Lightweight semantic shape for QueryPerformanceTest"@en ;
    dcterms:isPartOf <http://example.org/performance> ;
    dcterms:source "OE Pack Option C — lightweight semantic upgrade for performance per BP-D30."@en ;
    rdfs:comment "Lightweight semantic SHACL NodeShape per BP-D30. QueryPerformanceTest has no direct rdfs:domain assertions; constraints inherit via OWL subClassOf entailment. Direct: sh:nodeKind sh:IRI."@en ;
