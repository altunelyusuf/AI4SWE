            sh:maxCount 1 ;
            sh:message "Property hasSLSALevel should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path configuration:hasSLSALevel ;
            sh:severity sh:Warning ],
        [ sh:class configuration:SprintManifest ;
            sh:maxCount 1 ;
            sh:message "Property declaredInManifest should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path configuration:declaredInManifest ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "Property artifactLastModified should match its declared type."@en ;
            sh:minCount 0 ;
