redo1:IssueLifecycleRecordShape a sh:NodeShape ;
    rdfs:label "INCIDENT LIFECYCLE-V1: IssueLifecycleRecord must be audit-ready"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    rdfs:comment "Validates every IssueLifecycleRecord carries audit-evidence fields: issueIdentifier (string), openedAt (dateTime), hasResolutionOutcome (a ResolutionOutcome SKOS concept). resolvedAt is optional (empty when status=Open). remediatedIn is optional (may be unknown for old records)."@en ;
    sh:property [ sh:message "INCIDENT LIFECYCLE-V1: IssueLifecycleRecord {$this} must cite at least one dcterms:source."@en ;
            sh:minCount 1 ;
            sh:path dcterms:source ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "INCIDENT LIFECYCLE-V1: IssueLifecycleRecord {$this} must declare exactly one :issueIdentifier (xsd:string)."@en ;
            sh:minCount 1 ;
            sh:path redo1:issueIdentifier ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "INCIDENT LIFECYCLE-V1: IssueLifecycleRecord {$this} :resolvedAt (if present) must be xsd:dateTime."@en ;
            sh:path redo1:resolvedAt ],
        [ sh:class redo1:ResolutionOutcome ;
            sh:maxCount 1 ;
            sh:message "INCIDENT LIFECYCLE-V1: IssueLifecycleRecord {$this} must declare exactly one :hasResolutionOutcome pointing to a ResolutionOutcome SKOS concept."@en ;
            sh:minCount 1 ;
            sh:path redo1:hasResolutionOutcome ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "INCIDENT LIFECYCLE-V1: IssueLifecycleRecord {$this} must declare exactly one :openedAt (xsd:dateTime)."@en ;
            sh:minCount 1 ;
            sh:path redo1:openedAt ] ;
    sh:targetClass redo1:IssueLifecycleRecord .

