    dcterms:isPartOf <http://example.org/performance> ;
    rdfs:comment "Every class in the Performance hierarchy must have rdfs:label, skos:definition, and dcterms:source."@en ;
    sh:property [ sh:message "Performance class must have dcterms:source"@en ;
            sh:minCount 1 ;
            sh:path dcterms:source ;
            sh:severity sh:Violation ],
        [ sh:message "Performance class must have skos:definition"@en ;
            sh:minCount 1 ;
            sh:path skos:definition ;
            sh:severity sh:Violation ],
        [ sh:message "Performance class must have rdfs:label"@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ;
            sh:severity sh:Violation ] ;
    sh:targetClass performance:Performance .

performance:Shape_PerformanceTestAnnotationCompleteness a sh:NodeShape ;
    rdfs:label "PerformanceTest annotation completeness"@en ;
    dcterms:isPartOf <http://example.org/performance> ;
    rdfs:comment "Every PerformanceTest class must have rdfs:label and skos:definition."@en ;
    sh:property [ sh:message "PerformanceTest must have rdfs:label"@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ;
            sh:severity sh:Violation ],
        [ sh:message "PerformanceTest must have skos:definition"@en ;
            sh:minCount 1 ;
            sh:path skos:definition ;
            sh:severity sh:Violation ] ;
    sh:targetClass performance:PerformanceTest .

