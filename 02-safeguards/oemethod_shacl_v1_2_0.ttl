quality:Finding_Shape a sh:NodeShape ;
    rdfs:label "Semantic shape for Finding"@en ;
    dcterms:isPartOf <http://example.org/quality> ;
    dcterms:source "OE Pack Option C — semantic shape upgrade for quality subject per BP-D30."@en ;
    rdfs:comment "Semantic SHACL NodeShape per BP-D30. Declares 10 property constraint(s) for Finding sourced from rdfs:domain assertions."@en ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:class quality:Recommendation ;
            sh:maxCount 1 ;
            sh:message "Property hasRecommendation should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path quality:hasRecommendation ;
            sh:severity sh:Warning ],
        [ sh:class quality:Requirement ;
            sh:maxCount 1 ;
            sh:message "Property isAboutRequirement should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path quality:isAboutRequirement ;
            sh:severity sh:Warning ],
        [ sh:maxCount 1 ;
            sh:message "Property classifiesAs should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path quality:classifiesAs ;
            sh:severity sh:Warning ],
        [ sh:class quality:QualityAssessment ;
            sh:maxCount 1 ;
            sh:message "Property isFindingOf should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path quality:isFindingOf ;
            sh:severity sh:Warning ],
        [ sh:class quality:QualityDimension ;
            sh:maxCount 1 ;
            sh:message "Property affectsDimension should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path quality:affectsDimension ;
            sh:severity sh:Warning ],
        [ sh:class quality:OntologyClass ;
            sh:maxCount 1 ;
            sh:message "Property assessesClass should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path quality:assessesClass ;
            sh:severity sh:Warning ],
        [ sh:class core:SeverityLevel ;
            sh:maxCount 1 ;
            sh:message "Property hasSeverity should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path quality:hasSeverity ;
            sh:severity sh:Warning ],
        [ sh:class quality:OntologyProperty ;
            sh:maxCount 1 ;
            sh:message "Property assessesProperty should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path quality:assessesProperty ;
            sh:severity sh:Warning ],
        [ sh:class quality:OntologyComponent ;
            sh:maxCount 1 ;
            sh:message "Property isAboutComponent should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path quality:isAboutComponent ;
            sh:severity sh:Warning ],
        [ sh:class quality:PriorityLevel ;
            sh:maxCount 1 ;
            sh:message "Property hasPriority should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path quality:hasPriority ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Warning ;
    sh:targetClass quality:Finding .

