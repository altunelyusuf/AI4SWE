redo1:PromptInheritedViolationShape a sh:NodeShape ;
    rdfs:label "PromptInheritedViolation must have label, definition, source"@en ;
    dcterms:isPartOf <http://example.org/redo>,
        <http://example.org/reliability> ;
    rdfs:comment """a reliability ontology v2.5.4 — Enforces documentation requirements for the new
PromptInheritedViolation pathology class and all its instances.
Ensures the forensic record (skos:example) is present for each violation
instance so retrospective analysis can identify the sprint, the inherited
entry, and the propagation distance."""@en ;
    sh:property [ sh:message "a reliability ontology C2 FAIL: PromptInheritedViolation instance {$this} missing rdfs:label."@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology C2 FAIL: PromptInheritedViolation instance {$this} missing skos:definition."@en ;
            sh:minCount 1 ;
            sh:path skos:definition ;
            sh:severity sh:Violation ],
        [ sh:message "a reliability ontology C2 WARNING: PromptInheritedViolation instance {$this} missing dcterms:source."@en ;
            sh:minCount 1 ;
            sh:path dcterms:source ;
            sh:severity sh:Warning ],
        [ sh:message "a reliability ontology C2+ WARN: PromptInheritedViolation instance {$this} missing skos:example (forensic record required)."@en ;
            sh:minCount 1 ;
            sh:path skos:example ;
            sh:severity sh:Warning ] ;
    sh:targetClass redo1:PromptInheritedViolation .

