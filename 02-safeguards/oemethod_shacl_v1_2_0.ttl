redo1:ClassCitationShape a sh:NodeShape ;
    rdfs:label "Class Citation Enforcement"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    rdfs:comment "v19.0.1 fix: SPARQL-based target narrows scope to reliability: namespace only (was firing on cross-subject classes per Proposal E Cluster 2)."@en ;
    sh:property [ sh:message "a reliability ontology [GROUNDING]: Every class must have a dcterms:source citation."@en ;
            sh:minCount 1 ;
            sh:path dcterms:source ;
            sh:severity sh:Violation ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:select """PREFIX reliability: <http://example.org/reliability#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
SELECT ?this WHERE {
  ?this a owl:Class .
  FILTER(STRSTARTS(STR(?this), "http://example.org/reliability#"))
}""" ] .

