            sh:message "Property integratesInto should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path configuration:integratesInto ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Warning ;
    sh:targetClass configuration:StagingArchive .

