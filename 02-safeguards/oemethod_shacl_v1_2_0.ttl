testing:TestingCompletenessGate a sh:NodeShape ;
    rdfs:label "Testing process-completeness gate (profile-parameterized)"@en ;
    dcterms:isPartOf <http://example.org/testing> ;
    sh:sparql [ sh:message "Testing gate: at High/Critical, each Test of this artifact must carry a TestResult."@en ;
            sh:select """PREFIX f: <http://example.org/testing#>
PREFIX core: <http://example.org/core#>
SELECT $this WHERE {
  $this core:hasCriticalityProfile ?pr . FILTER( ?pr IN ( core:Profile_High, core:Profile_Critical ) )
  ?x f:testsArtifact $this .
  FILTER NOT EXISTS { ?x f:hasTestResult ?c }
}""" ;
            sh:severity sh:Violation ] ;
    sh:targetClass core:Artifact .

