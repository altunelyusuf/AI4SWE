    rdfs:isDefinedBy <http://example.org/configuration-shacl> ;
    skos:definition "Every configuration:NamingConvention instance must have at least one configuration:filenamePattern datatype property containing the pattern template (e.g., '{prefix}_v{M}_{m}_{p}.ttl'). A convention without a declared pattern cannot be machine-checked and serves only as documentation."@en ;
    sh:property [ sh:minCount 1 ;
            sh:path configuration:filenamePattern ;
            sh:severity sh:Violation ] ;
