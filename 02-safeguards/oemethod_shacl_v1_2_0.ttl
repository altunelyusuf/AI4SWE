algorithm_efficiency:Shape_AEClassAnnotationCompleteness a sh:NodeShape ;
    rdfs:label "AE class annotation completeness"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    rdfs:comment "Every owl:Class in the AE namespace must have rdfs:label, skos:definition, and dcterms:source. v19.0.1 fix: SPARQL-based target narrows scope to ae: namespace only (was firing on cross-subject classes per Proposal E Cluster 1)."@en ;
    sh:property [ sh:message "AE class must have rdfs:label"@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ;
            sh:severity sh:Violation ],
        [ sh:message "AE class must have dcterms:source"@en ;
            sh:minCount 1 ;
            sh:path dcterms:source ;
            sh:severity sh:Violation ],
        [ sh:message "AE class must have skos:definition"@en ;
            sh:minCount 1 ;
            sh:path skos:definition ;
            sh:severity sh:Violation ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:prefixes <http://example.org/ae/sparql-prefixes> ;
            sh:select """PREFIX ae: <http://example.org/ae#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
SELECT ?this WHERE {
  ?this a owl:Class .
  FILTER(STRSTARTS(STR(?this), "http://example.org/ae#"))
}""" ] .

algorithm_efficiency:Shape_AEPropertyDiscipline a sh:NodeShape ;
    rdfs:label "AE property discipline"@en ;
    dcterms:isPartOf <http://example.org/ae> ;
    rdfs:comment "Recommendation: every owl:ObjectProperty should declare rdfs:domain and rdfs:range for analysis and reasoning. Severity: sh:Info — this is a guidance shape, not a hard constraint. 15 of 22 AE object properties currently lack one or both."@en ;
    sh:property [ sh:message "AE property recommended to declare rdfs:domain"@en ;
            sh:minCount 1 ;
            sh:path rdfs:domain ;
            sh:severity sh:Info ],
        [ sh:message "AE property recommended to declare rdfs:range"@en ;
            sh:minCount 1 ;
            sh:path rdfs:range ;
            sh:severity sh:Info ] ;
    sh:targetClass owl:ObjectProperty .

