    rdfs:label "No Fabricated Methodology References"@en ;
    dcterms:isPartOf <http://example.org/reliability> ;
    sh:deactivated true ;
    sh:property [ sh:description "Constraint deactivated: pyshacl regex incompatibility with sh:not+sh:pattern. Validated manually: 0 ZTAD/a component library matches and 0 [UNVERIFIED] markers in 525 definitions. See redo_source_verification_report.md for web-verified citation audit."@en ;
            sh:message "a reliability ontology DataFabrication: Definition contains fabricated ZTAD/a component library reference."@en ;
            sh:path skos:definition ;
            sh:severity sh:Info ] ;
    sh:targetSubjectsOf skos:definition .

