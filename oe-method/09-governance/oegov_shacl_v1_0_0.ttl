@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://example.org/configuration#> .
@prefix oe-prov: <http://example.org/oe-prov#> .
@prefix oepack_release_history: <http://example.org/oepack-release-history#> .
@prefix ontology_engineering: <http://example.org/knowledge-base#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix pub: <http://example.org/publish-ceremony#> .
@prefix quality: <http://example.org/quality#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rel: <http://example.org/reliability#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ontology_engineering:Activity_Shape a sh:NodeShape ;
    rdfs:label "Semantic shape for Activity"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "OE Pack Option C — semantic shape upgrade for ontology-engineering subject per BP-D30."@en ;
    rdfs:comment "Semantic SHACL NodeShape per BP-D30. Declares 11 property constraint(s) for Activity sourced from rdfs:domain assertions."@en ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:class ontology_engineering:EngineeringPattern ;
            sh:maxCount 1 ;
            sh:message "Property appliesPattern should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path ontology_engineering:appliesPattern ;
            sh:severity sh:Warning ],
        [ sh:class quality:OntologyArtifact ;
            sh:maxCount 1 ;
            sh:message "Property transforms should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path ontology_engineering:transforms ;
            sh:severity sh:Warning ],
        [ sh:class ontology_engineering:TeamConcept ;
            sh:maxCount 1 ;
            sh:message "Property organizedBy should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path ontology_engineering:organizedBy ;
            sh:severity sh:Warning ],
        [ sh:class ns1:ChangeOperation ;
            sh:maxCount 1 ;
            sh:message "Property triggersChange should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path ontology_engineering:triggersChange ;
            sh:severity sh:Warning ],
        [ sh:class ontology_engineering:StakeholderRole ;
            sh:maxCount 1 ;
            sh:message "Property assignedTo should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path ontology_engineering:assignedTo ;
            sh:severity sh:Warning ],
        [ sh:class ontology_engineering:ArchitecturalConcept ;
            sh:maxCount 1 ;
            sh:message "Property constrainedByArchitecture should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path ontology_engineering:constrainedByArchitecture ;
            sh:severity sh:Warning ],
        [ sh:class quality:OntologyArtifact ;
            sh:maxCount 1 ;
            sh:message "Property requires should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path ontology_engineering:requires ;
            sh:severity sh:Warning ],
        [ sh:class ontology_engineering:EngineeringTool ;
            sh:maxCount 1 ;
            sh:message "Property usesTool should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path ontology_engineering:usesTool ;
            sh:severity sh:Warning ],
        [ sh:class quality:OntologyArtifact ;
            sh:maxCount 1 ;
            sh:message "Property hasResult should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path ontology_engineering:hasResult ;
            sh:severity sh:Warning ],
        [ sh:class <http://example.org/core#Role> ;
            sh:maxCount 1 ;
            sh:message "Property performedBy should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path ontology_engineering:performedBy ;
            sh:severity sh:Warning ],
        [ sh:class ontology_engineering:DevelopmentMethodology ;
            sh:maxCount 1 ;
            sh:message "Property followsMethodology should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path ontology_engineering:followsMethodology ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Warning ;
    sh:targetClass ontology_engineering:Activity .

ontology_engineering:AgileMethodology_Shape a sh:NodeShape ;
    rdfs:label "Lightweight semantic shape for AgileMethodology"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "OE Pack Option C — lightweight semantic upgrade for ontology-engineering per BP-D30."@en ;
    rdfs:comment "Lightweight semantic SHACL NodeShape per BP-D30. AgileMethodology has no direct rdfs:domain assertions; constraints inherit via OWL subClassOf entailment. Direct: sh:nodeKind sh:IRI."@en ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Info ;
    sh:targetClass ontology_engineering:AgileMethodology .

