oepack_release_history:Bundle_Shape a sh:NodeShape ;
    rdfs:label "Semantic shape for Bundle"@en ;
    dcterms:isPartOf <http://example.org/oepack-release-history> ;
    dcterms:source "OE Pack Option C — semantic shape upgrade for oepack-release-history subject per BP-D30."@en ;
    rdfs:comment "Semantic SHACL NodeShape per BP-D30. Declares 2 property constraint(s) for Bundle sourced from rdfs:domain assertions."@en ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:class oepack_release_history:OntologyFile ;
            sh:maxCount 1 ;
            sh:message "Property containsFile should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path oepack_release_history:containsFile ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Property hasBundleSHA256 should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path oepack_release_history:hasBundleSHA256 ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Warning ;
    sh:targetClass oepack_release_history:Bundle .

oepack_release_history:ConsolidationStep_Shape a sh:NodeShape ;
    rdfs:label "Semantic shape for ConsolidationStep"@en ;
    dcterms:isPartOf <http://example.org/oepack-release-history> ;
    dcterms:source "OE Pack Option C — semantic shape upgrade for oepack-release-history subject per BP-D30."@en ;
    rdfs:comment "Semantic SHACL NodeShape per BP-D30. Declares 2 property constraint(s) for ConsolidationStep sourced from rdfs:domain assertions."@en ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Property hasStepNumber should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path oepack_release_history:hasStepNumber ;
            sh:severity sh:Warning ],
        [ sh:class oepack_release_history:Bundle ;
            sh:maxCount 1 ;
            sh:message "Property shipsBundle should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path oepack_release_history:shipsBundle ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Warning ;
    sh:targetClass oepack_release_history:ConsolidationStep .

oepack_release_history:FacetRoleShape a sh:NodeShape ;
    rdfs:label "Facet role + status must use the controlled vocabularies"@en ;
    dcterms:isPartOf <http://example.org/oepack-release-history> ;
    sh:property [ sh:in ( "registration" "conformance" "both" "internal" ) ;
            sh:maxCount 1 ;
            sh:message "facetRole must be registration|conformance|both|internal."@en ;
            sh:path oepack_release_history:facetRole ],
        [ sh:in ( "operational" "partial" "intended" "na" ) ;
            sh:maxCount 1 ;
            sh:message "facetRoleStatus must be operational|partial|intended|na."@en ;
            sh:path oepack_release_history:facetRoleStatus ] ;
    sh:sparql [ sh:message "A SubjectOntology with facetRole must also declare facetRoleStatus."@en ;
            sh:select "SELECT $this WHERE { $this <http://example.org/oepack-release-history#facetRole> ?r . FILTER NOT EXISTS { $this <http://example.org/oepack-release-history#facetRoleStatus> ?s } }" ] ;
    sh:targetClass oepack_release_history:SubjectOntology .

oepack_release_history:OEPackArtifact_Shape a sh:NodeShape ;
    rdfs:label "Lightweight semantic shape for OEPackArtifact"@en ;
    dcterms:isPartOf <http://example.org/oepack-release-history> ;
    dcterms:source "OE Pack Option C — lightweight semantic upgrade for oepack-release-history per BP-D30."@en ;
    rdfs:comment "Lightweight semantic SHACL NodeShape per BP-D30. OEPackArtifact has no direct rdfs:domain assertions; constraints inherit via OWL subClassOf entailment. Direct: sh:nodeKind sh:IRI."@en ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Info ;
    sh:targetClass oepack_release_history:OEPackArtifact .

oepack_release_history:OntologyFile_Shape a sh:NodeShape ;
    rdfs:label "Semantic shape for OntologyFile"@en ;
    dcterms:isPartOf <http://example.org/oepack-release-history> ;
    dcterms:source "OE Pack Option C — semantic shape upgrade for oepack-release-history subject per BP-D30."@en ;
    rdfs:comment "Semantic SHACL NodeShape per BP-D30. Declares 4 property constraint(s) for OntologyFile sourced from rdfs:domain assertions."@en ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:class oepack_release_history:SubjectOntology ;
            sh:maxCount 1 ;
            sh:message "Property belongsToSubject should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path oepack_release_history:belongsToSubject ;
            sh:severity sh:Warning ],
        [ sh:class oepack_release_history:OntologyFile ;
            sh:maxCount 1 ;
            sh:message "Property priorVersion should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path oepack_release_history:priorVersion ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Property hasVersionInfo should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path oepack_release_history:hasVersionInfo ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Property hasFileSHA256 should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path oepack_release_history:hasFileSHA256 ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Warning ;
    sh:targetClass oepack_release_history:OntologyFile .

oepack_release_history:ReleaseEvent_Shape a sh:NodeShape ;
    rdfs:label "Semantic shape for ReleaseEvent"@en ;
    dcterms:isPartOf <http://example.org/oepack-release-history> ;
    dcterms:source "OE Pack Option C — semantic shape upgrade for oepack-release-history subject per BP-D30."@en ;
    rdfs:comment "Semantic SHACL NodeShape per BP-D30. Declares 1 property constraint(s) for ReleaseEvent sourced from rdfs:domain assertions."@en ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "Property hasReleaseDate should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path oepack_release_history:hasReleaseDate ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Warning ;
    sh:targetClass oepack_release_history:ReleaseEvent .

oepack_release_history:Shape_SupersessionCompleteness a sh:NodeShape ;
    rdfs:label "Supersession endpoint completeness"@en ;
    dcterms:isPartOf <http://example.org/oepack-release-history> ;
    rdfs:comment "Every Supersession must declare both its supersededFile (old) and supersedes (new) endpoints."@en ;
    sh:property [ sh:message "Supersession must declare orh:supersedes (new file)"@en ;
            sh:minCount 1 ;
            sh:path oepack_release_history:supersedes ;
            sh:severity sh:Violation ],
        [ sh:message "Supersession must declare orh:supersededFile (old file)"@en ;
            sh:minCount 1 ;
            sh:path oepack_release_history:supersededFile ;
            sh:severity sh:Violation ] ;
    sh:targetClass oepack_release_history:Supersession .

oepack_release_history:SubjectLifecycleShape a sh:NodeShape ;
    rdfs:label "Subject lifecycle: status required; retired implies a successor"@en ;
    dcterms:isPartOf <http://example.org/oepack-release-history> ;
    sh:property [ sh:in ( "active" "retired" ) ;
            sh:maxCount 1 ;
            sh:message "SubjectOntology must declare exactly one lifecycleStatus (active|retired)."@en ;
            sh:minCount 1 ;
            sh:path oepack_release_history:lifecycleStatus ] ;
    sh:sparql [ sh:message "A retired SubjectOntology must declare supersededBySubject."@en ;
            sh:select "SELECT $this WHERE { $this <http://example.org/oepack-release-history#lifecycleStatus> \"retired\" . FILTER NOT EXISTS { $this <http://example.org/oepack-release-history#supersededBySubject> ?s } }" ] ;
    sh:targetClass oepack_release_history:SubjectOntology .

oepack_release_history:SubjectOntology_Shape a sh:NodeShape ;
    rdfs:label "Lightweight semantic shape for SubjectOntology"@en ;
    dcterms:isPartOf <http://example.org/oepack-release-history> ;
    dcterms:source "OE Pack Option C — lightweight semantic upgrade for oepack-release-history per BP-D30."@en ;
    rdfs:comment "Lightweight semantic SHACL NodeShape per BP-D30. SubjectOntology has no direct rdfs:domain assertions; constraints inherit via OWL subClassOf entailment. Direct: sh:nodeKind sh:IRI."@en ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Info ;
    sh:targetClass oepack_release_history:SubjectOntology .

pub:EvidenceShape a sh:NodeShape ;
    rdfs:label "Evidence must carry a transcript digest, not a summary"@en ;
    dcterms:isPartOf <http://example.org/publish-ceremony/shapes> ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Evidence must record the SHA-256 of the raw gate transcript (BP-D2)." ;
            sh:minCount 1 ;
            sh:path pub:transcriptSHA256 ;
            sh:pattern "^[0-9a-f]{64}$" ] ;
    sh:targetClass quality:Evidence .

pub:ManifestCompleteShape a sh:NodeShape ;
    rdfs:label "Verified counts must equal total counts"@en ;
    dcterms:isPartOf <http://example.org/publish-ceremony/shapes> ;
    sh:sparql [ sh:message "Manifest or Turtle verification is incomplete — verified count does not equal total." ;
            sh:prefixes <http://example.org/publish-ceremony/shapes> ;
            sh:select """
            SELECT $this WHERE {
              { $this <http://example.org/publish-ceremony#manifestVerified> ?v .
                $this <http://example.org/publish-ceremony#manifestTotal>    ?t .
                FILTER (?v != ?t) }
              UNION
              { $this <http://example.org/publish-ceremony#turtleParsed> ?v .
                $this <http://example.org/publish-ceremony#turtleTotal>  ?t .
                FILTER (?v != ?t) }
            }""" ] ;
    sh:targetClass quality:GateDecision .

pub:PublishDecisionShape a sh:NodeShape ;
    rdfs:label "A publish decision must carry the measured evidence, not a claim of it"@en ;
    dcterms:isPartOf <http://example.org/publish-ceremony/shapes> ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:hasValue true ;
            sh:maxCount 1 ;
            sh:message "A published record must record a passing gate; a failing run is not published." ;
            sh:minCount 1 ;
            sh:path quality:passesGate ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path pub:turtleTotal ],
        [ sh:datatype xsd:string ;
            sh:in ( "PASS"^^xsd:string "NONE_SHIPPED"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "The package's own release gate must have passed, or be recorded as not shipped." ;
            sh:minCount 1 ;
            sh:path pub:packageGate ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "The publishing session must be named. Set OE_SESSION. Attribution is not authentication — nothing verifies the claim — but an ABSENT claim leaves ParallelSessionLineageFork and CrossSessionContamination undiagnosable, which is what this record exists to support." ;
            sh:minCount 1 ;
            sh:not [ sh:in ( "unattributed"^^xsd:string "" ) ] ;
            sh:path rel:authoringSession ],
        [ sh:message "The decision must point at the Evidence artifact holding the raw transcript." ;
            sh:minCount 1 ;
            sh:path quality:evidencedBy ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "The package slug must be recorded." ;
            sh:minCount 1 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "The published version must be SemVer (BP-D7)." ;
            sh:minCount 1 ;
            sh:path owl:versionInfo ;
            sh:pattern "^[0-9]+\\.[0-9]+\\.[0-9]+$" ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path prov:generatedAtTime ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "The governing discipline file's SHA-256 must be measured and recorded (B4/BP-D2)." ;
            sh:minCount 1 ;
            sh:path pub:disciplineSHA256 ;
            sh:pattern "^[0-9a-f]{64}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "The highest-SemVer knowledge-base ABox actually resolved must be named." ;
            sh:minCount 1 ;
            sh:path pub:governanceSource ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:message "Manifest-verified file count must be recorded and greater than zero." ;
            sh:minCount 1 ;
            sh:minExclusive 0 ;
            sh:path pub:manifestVerified ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path pub:manifestTotal ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path pub:turtleParsed ] ;
    sh:targetClass quality:GateDecision .

<http://example.org/oemethod-governance> a owl:Ontology ;
    dcterms:created "2026-10-06T00:00:00"^^xsd:dateTime ;
    dcterms:creator oe-prov:Agent_MethodAuthor,
        "the method author" ;
    dcterms:description "The SHACL shapes of the OE Method's governance unit as ONE file (BP-D54): the knowledge base, release history and publish-record suites, each a module. A pure union, proved."@en ;
    dcterms:identifier "oemethod-governance" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
