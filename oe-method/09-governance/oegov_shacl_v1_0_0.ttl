ontology_engineering:RoadmapPlan_Shape a sh:NodeShape ;
    rdfs:label "Semantic shape for RoadmapPlan"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "OE Pack Option C — semantic shape upgrade for ontology-engineering subject per BP-D30."@en ;
    rdfs:comment "Semantic SHACL NodeShape per BP-D30. Declares 4 property constraint(s) for RoadmapPlan sourced from rdfs:domain assertions."@en ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Property hasSteps should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path ontology_engineering:hasSteps ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Property targetsMetric should match its declared type."@en ;
            sh:minCount 0 ;
            sh:path ontology_engineering:targetsMetric ;
            sh:severity sh:Warning ],
        [ sh:maxCount 1 ;
            sh:message "Property hasCurrentValue should match its declared type."@en ;
            sh:minCount 0 ;
            sh:or ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:integer ] [ sh:datatype xsd:double ] [ sh:datatype xsd:float ] [ sh:datatype xsd:long ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:short ] ) ;
            sh:path ontology_engineering:hasCurrentValue ;
            sh:severity sh:Warning ],
        [ sh:maxCount 1 ;
            sh:message "Property hasTargetValue should match its declared type."@en ;
            sh:minCount 0 ;
            sh:or ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:integer ] [ sh:datatype xsd:double ] [ sh:datatype xsd:float ] [ sh:datatype xsd:long ] [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:int ] [ sh:datatype xsd:short ] ) ;
            sh:path ontology_engineering:hasTargetValue ;
            sh:severity sh:Warning ] ;
    sh:severity sh:Warning ;
    sh:targetClass ontology_engineering:RoadmapPlan .

