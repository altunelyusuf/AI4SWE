    dcterms:modified "2026-10-06T00:00:00"^^xsd:dateTime ;
    dcterms:publisher oe-prov:Org_IKU_Department_of_ComputerEngineering ;
    dcterms:rights "Copyright (c) 2025-2026 a university & the method author. Licensed under CC BY 4.0."@en ;
    dcterms:rightsHolder oe-prov:Org_IKU_Department_of_ComputerEngineering ;
    rdfs:comment "SHACL role of OEPack-Release-History 3-file canonical set. Annotation-completeness shape on Supersession individuals (every supersession must declare both endpoints)."@en,
        "oepack-release-history PATCH v1.0.1. Sprint F1 ghost-reference cleanup: 0 dangling class references redirected to canonical homes; 0 dangling subClassOf claims dropped per L-47 (cross-subject methodological-vs-subsumption discipline). Per BP-D4/D5 gates: HermiT PASS, SHACL no new violations."@en,
        "oepack-release-history SHACL v1.0.2 (PATCH) — DRIFT-19 fix on hasReleaseDate (xsd:date → xsd:dateTime) per BP-D18."@en,
        "oepack-release-history SHACL v1.1.0 (MINOR) per v17.32.0 Option B — added 6 auto-generated skeleton NodeShapes for owl:Class declarations lacking SHACL coverage. Per BP-D27 each skeleton carries kb:isSkeletonShape true. Mechanical Roadmap Step 1; semantic constraints in Step 2."@en,
        "oepack-release-history SHACL v1.2.0 (MINOR) per Option C — 6 skeletons upgraded: 4 full-semantic + 2 lightweight per BP-D30."@en,
        "oepack_release_history_shacl v1.0.3 (PATCH) per v17.28.0 industrial-hardening — added CC BY 4.0 license, copyright, publisher/rightsHolder (IKÜ Computer Engineering), PROV-O wasGeneratedBy + wasAttributedTo (the method author). Additive ontology metadata only — no semantic changes."@en,
        "v1.5.0 (2026-10-06, MINOR): every named subject now carries dcterms:isPartOf <http://example.org/oepack-release-history> (its module), the first step of the consolidation of this package's files into one file per role. No term, label or definition changed."@en ;
    owl:priorVersion <http://example.org/oepack-release-history/1.0.0>,
        <http://example.org/oepack-release-history/1.0.1>,
        <http://example.org/oepack-release-history/1.0.2>,
        <http://example.org/oepack-release-history/1.0.3>,
        <http://example.org/oepack-release-history/1.1.0>,
        <http://example.org/oepack-release-history/1.4.0> ;
    owl:versionIRI <http://example.org/oepack-release-history/1.5.0> ;
    owl:versionInfo "1.5.0" ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor ;
    prov:wasGeneratedBy oe-prov:Activity_OEPackRelease_v17_28_0 .

