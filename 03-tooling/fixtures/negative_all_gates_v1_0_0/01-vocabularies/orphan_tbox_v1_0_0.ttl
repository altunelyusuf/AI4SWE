@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orphan: <http://example.org/orphan#> .
<http://example.org/orphan> a owl:Ontology ;
    rdfs:comment "Negative fixture (L-95): a TBox declared derived from a nonexistent upstream (fails the lineage gate), with no matching ABox and no BP-D51 exemption (fails the completeness gate)."@en .
orphan:Widget a owl:Class .
