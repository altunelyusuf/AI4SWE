@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix kb: <http://example.org/knowledge-base#> .
@prefix oe-prov: <http://example.org/oe-prov#> .
@prefix orh: <http://example.org/oepack-release-history#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kb:ApplicationIntegration a owl:Class ;
    rdfs:label "Application Integration"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Semantic Web Services and Integration (Sheth et al., 2005). IEEE Internet Computing."@en ;
    rdfs:comment "Connecting ontology with software applications for semantic functionality."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:Integration ;
    owl:disjointWith kb:ConflictResolution,
        kb:DatabaseIntegration,
        kb:MappingTechnique,
        kb:MergingStrategy ;
    skos:definition "An integration concern focused on connecting ontology systems with application-layer software such as enterprise systems, content management platforms, or business process engines through standardized interfaces."@en ;
    skos:example "Integrating ontology with vehicle search application via SPARQL queries."@en .

kb:ArchitecturalLayer a owl:Class ;
    rdfs:label "Architectural Layer"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Sprint F5 (2026-05-15)."@en ;
    rdfs:comment "An architectural layer in a multi-layered ontology architecture — foundation, domain, application layers. Per Sprint F5."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:subClassOf kb:KnowledgeBaseConcept ;
    skos:definition "An architectural layer in a multi-layered ontology architecture — foundation, domain, application layers. Per Sprint F5."@en .

kb:ArchitecturalView a owl:Class ;
    rdfs:label "Architectural View"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Sprint F5 (2026-05-15)."@en ;
    rdfs:comment "An architectural view of an ontology system — logical view, deployment view, etc. Per Sprint F5."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:subClassOf kb:KnowledgeBaseConcept ;
    skos:definition "An architectural view of an ontology system — logical view, deployment view, etc. Per Sprint F5."@en .

kb:AutomatedFeedback a owl:Class ;
    rdfs:label "Automated Feedback"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Continuous Monitoring and Observability for Semantic Systems. Ontology engineering common practice."@en ;
    rdfs:comment "Tool-generated quality reports."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:FeedbackMechanism ;
    skos:definition "A quality assurance mechanism that automatically generates reports on ontology quality issues by analyzing the artifact against predefined rules, providing immediate identification of problems without human reviewer involvement."@en ;
    skos:example "Reasoner provides feedback on consistency."@en .

kb:AutomaticPopulation a owl:Class ;
    rdfs:label "Automatic Population"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Generating instances through automated data transformation or extraction."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:Population ;
    skos:definition "A population activity that uses automated extraction from databases, text, or APIs to create ontology individuals and their assertions, enabling large-scale instance generation with reduced manual effort."@en ;
    skos:example "Importing 10,000 vehicle instances from CSV file via automated script."@en .

kb:Axiomatization a owl:Class ;
    rdfs:label "Axiomatization"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Defining logical axioms and constraints for ontology elements."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1016/0004-3702(95)00017-8>,
        <https://www.w3.org/TR/owl2-primer/> ;
    rdfs:subClassOf kb:Activity,
        kb:FormalSpecification ;
    skos:definition "A formal specification activity that defines the logical axioms constraining ontology class relationships, including subclass, disjointness, equivalence, and property restriction assertions that enable automated reasoning."@en ;
    skos:example "Adding axiom: Car disjointWith Bicycle, Car subClassOf hasWheel some Wheel."@en .

kb:BackgroundKnowledgeMapping a owl:Class ;
    rdfs:label "Background Knowledge Mapping"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Semantic Web Services and Integration (Sheth et al., 2005). IEEE Internet Computing."@en ;
    rdfs:comment "Mappings using external resources like thesauri."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-642-38721-0> ;
    rdfs:subClassOf kb:SemanticMapping ;
    skos:definition "A semantic mapping technique that leverages external knowledge sources such as thesauri, dictionaries, or reference ontologies to identify semantic correspondences between elements of different ontologies."@en ;
    skos:example "Using DBpedia as background knowledge for matching."@en .

kb:BestPractice a owl:Class ;
    rdfs:label "Best Practice"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Migrated from rev:BestPractice (catalogue) and redo:BestPractice (oepack-lessons-rdf) authoring. The two prior class declarations are deduplicated into kb:BestPractice canonical home per DRY-in-flight discipline."@en ;
    rdfs:comment "A discipline rule expressed as a prescriptive recommendation, derived empirically from engineering experience and validated across multiple work-packages. Best practices carry a stable identifier (e.g., BP-D1, BP-D7) and an enforcement mechanism (often a mechanical binding in the PROTOCOL-BINDING module)."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:subClassOf kb:KnowledgeBaseConcept ;
    skos:definition "A discipline rule expressed as a prescriptive recommendation, derived empirically from engineering experience and validated across multiple work-packages. Best practices carry a stable identifier (e.g., BP-D1, BP-D7) and an enforcement mechanism (often a mechanical binding in the PROTOCOL-BINDING module)."@en .

kb:BlueGreenDeployment a owl:Class ;
    rdfs:label "Blue-Green Deployment"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "DevOps and Continuous Delivery (Humble & Farley, 2010). Addison-Wesley."@en ;
    rdfs:comment "Blue-Green Deployment - strategy for releasing ontology versions."@en,
        "Two identical environments for zero-downtime."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:DeploymentActivity,
        kb:DeploymentPattern ;
    owl:disjointWith kb:CanaryDeployment,
        kb:ContinuousDeployment,
        kb:Integration,
        kb:Publication,
        kb:RollbackDeployment ;
    skos:definition "A deployment pattern that maintains two identical production environments, routing traffic entirely from the current (blue) to the updated (green) environment after validation, enabling instant rollback by switching back."@en ;
    skos:example "Blue-green deployment enables instant rollback."@en .

kb:BottomUpDesign a owl:Class ;
    rdfs:label "Bottom-Up Design"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology Design Patterns (Gangemi, 2005). Ontology Design Patterns for Semantic Web Content, ISWC."@en ;
    rdfs:comment "Bottom-Up Design - strategy for building class hierarchies."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:TaxonomyDesign ;
    skos:definition "An ontology construction strategy that begins by modeling specific domain instances and detailed concepts, then progressively generalizes them into higher-level classes and abstract categories through analysis of common patterns."@en ;
    skos:example "Examining 200 instance records from a legacy database to identify natural groupings, then abstracting classes from those groups to form a hierarchy, is BottomUpDesign for ontology construction."@en .

kb:BrainstormingSession a owl:Class ;
    rdfs:label "Brainstorming"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Brainstorming."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:PlanningActivity ;
    skos:definition "A planning activity that facilitates unstructured idea generation among team members to identify potential domain concepts, modeling approaches, or solution alternatives before formal analysis begins."@en ;
    skos:example "A two-hour whiteboard session where the team lists every possible quality dimension an ontology could be evaluated on, before selecting the 10 most actionable for OQC, is a BrainstormingSession."@en .

kb:CitationAnalysis a owl:Class ;
    rdfs:label "Citation Analysis"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "NeOn Methodology (Suárez-Figueroa et al., 2012). NeOn Methodology for Building Ontology Networks, IOS Press."@en ;
    rdfs:comment "Citation Analysis."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1016/0004-3702(95)00017-8> ;
    rdfs:subClassOf kb:LiteratureReview ;
    skos:definition "A literature review technique that traces citation relationships among publications to identify influential works, emerging research fronts, and authoritative sources that should inform ontology design decisions."@en ;
    skos:example "Counting how many OQC classes cite ISO/IEC 25010:2023 vs ISO/IEC 25040:2011 in their dcterms:source fields to identify which standard provides the strongest grounding for OQC is CitationAnalysis."@en .

kb:CodeReview a owl:Class ;
    rdfs:label "Code Review"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Continuous Monitoring and Observability for Semantic Systems. Ontology engineering common practice."@en ;
    rdfs:comment "Code Review."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:AsynchronousCollaboration ;
    skos:definition "An inspection technique where one or more reviewers examine the ontology's source serialization file to identify syntactic issues, naming convention violations, missing annotations, and structural anti-patterns."@en ;
    skos:example "An engineer reviewing a pull request that adds rdfs:isDefinedBy to 140 a reliability ontology individuals — checking that each IRI is correct and no typo-IRI was introduced — is performing a CodeReview on ontology patch code."@en .

kb:CollocatedTeam a owl:Class ;
    rdfs:label "Collocated Team"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Team working in same physical location."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:Team,
        kb:TeamConcept ;
    skos:definition "An ontology engineering team whose members work from the same physical location, enabling direct face-to-face communication, shared whiteboards, and spontaneous collaboration on modeling decisions."@en ;
    skos:example "Collocated team works in same office building."@en .

kb:CompactSerialization a owl:Class ;
    rdfs:label "Compact Serialization"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Space-efficient serialization minimizing file size."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.w3.org/TR/rdf11-concepts/> ;
    rdfs:subClassOf kb:Serialization ;
    skos:definition "A serialization approach that minimizes file size through aggressive abbreviation, prefix compression, and elimination of redundant whitespace, optimized for storage efficiency and network transmission."@en ;
    skos:example "Compact N-Triples removing optional whitespace."@en .

kb:CompetencyQuestionAnalysis a owl:Class ;
    rdfs:label "Competency Question Analysis"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Examining questions the ontology must be able to answer."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:RequirementsAnalysis ;
    owl:disjointWith kb:RequirementsElicitation,
        kb:RequirementsPrioritization,
        kb:UseCaseAnalysis,
        kb:UseCaseModeling ;
    skos:definition "A requirements analysis technique that derives ontology scope and content requirements from a systematically developed set of competency questions, ensuring every class and property supports answering at least one question."@en ;
    skos:example "Analyzing question 'What vehicles can carry 5+ passengers?' to identify requirements."@en .

kb:ConceptIdentification a owl:Class ;
    rdfs:label "Concept Identification"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "NeOn Methodology (Suárez-Figueroa et al., 2012). NeOn Methodology for Building Ontology Networks, IOS Press."@en ;
    rdfs:comment "Finding key domain concepts."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:DomainAnalysis ;
    owl:disjointWith kb:ExpertConsultation,
        kb:LiteratureReview,
        kb:RelationshipIdentification ;
    skos:definition "A domain analysis activity that systematically discovers and names the key concepts within a subject area by analyzing domain texts, expert knowledge, and existing terminological resources."@en ;
    skos:example "Identifying 50 core concepts in automotive domain."@en .

kb:ConsensusGovernance a owl:Class ;
    rdfs:label "Consensus Governance"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "All stakeholders must agree on decisions."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/50508.html> ;
    rdfs:subClassOf kb:GovernanceModel ;
    owl:disjointWith kb:HierarchicalGovernance,
        kb:MeritocracyGovernance ;
    skos:definition "A governance model where ontology design decisions require agreement from all designated stakeholders, ensuring broad acceptance but potentially slowing decision-making for large or diverse teams."@en ;
    skos:example "Consensus model requires all 5 experts to approve."@en .

kb:ConsistencyChecking a owl:Class ;
    rdfs:label "Consistency Checking"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Description Logic Handbook (Baader et al., 2003). Cambridge University Press."@en ;
    rdfs:comment "Detecting logical contradictions."@en,
        "Verifying ontology has no logical contradictions."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl2-primer/> ;
    rdfs:subClassOf kb:LogicalValidation,
        kb:Reasoning ;
    skos:definition "A logical validation operation that verifies the ontology contains no logical contradictions by running a reasoner and confirming all class expressions are satisfiable and no axiom conflicts exist."@en ;
    skos:example "Checking that no class is simultaneously subclass of disjoint classes."@en,
        "Reasoner detects Car disjoint with subclass of Car."@en .

kb:ConsistencyRepair a owl:Class ;
    rdfs:label "Consistency Repair"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Resolving logical inconsistencies detected by reasoners."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2014.6816804> ;
    rdfs:subClassOf kb:BugFixing ;
    skos:definition "A bug fixing activity that resolves logical inconsistencies discovered in the ontology by identifying the minimal set of axiom changes needed to restore satisfiability while preserving maximum semantic content."@en ;
    skos:example "Removing conflicting restriction causing ElectricCar to be unsatisfiable."@en .

kb:ContinuousIntegration a owl:Class ;
    rdfs:label "Continuous Integration"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "DevOps and Continuous Delivery (Humble & Farley, 2010). Addison-Wesley."@en ;
    rdfs:comment "Automated testing triggered by code changes."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:DevelopmentProcess ;
    skos:definition "A test automation practice that automatically executes the ontology test suite whenever changes are committed to version control, providing immediate feedback on whether changes introduce defects."@en ;
    skos:example "A GitHub Actions workflow that runs pySHACL on every pull request touching any *.ttl file in the OE repository, blocking merge if any gate fails, is a ContinuousIntegration pipeline for ontology quality."@en .

kb:CrossFunctionalTeam a owl:Class ;
    rdfs:label "Cross-Functional Team"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Team with diverse skill sets and roles."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:Team,
        kb:TeamConcept ;
    skos:definition "An ontology engineering team composed of members with diverse expertise including domain knowledge, formal logic, software engineering, and project management, enabling self-sufficient development capability."@en ;
    skos:example "Cross-functional team includes 2 engineers, 1 expert, 1 QA."@en .

kb:DailyStandup a owl:Class ;
    rdfs:label "Daily Standup"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Daily Standup."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://scrumguides.org/scrum-guide.html> ;
    rdfs:subClassOf kb:SynchronousCollaboration ;
    skos:definition "A synchronous collaboration event where each team member briefly reports their progress, plans, and blockers in ontology development, typically lasting fifteen minutes and held at the same time each day."@en ;
    skos:example "Each morning the ontology engineering team reviews which pySHACL violations were fixed overnight, what gates are still failing, and what blockers exist — this is a DailyStandup in ontology-sprint context."@en .

kb:DatabaseToOntology a owl:Class ;
    rdfs:label "Database to Ontology"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Domain-Specific Ontology Engineering: Industry Applications (various). Ontology engineering common practice."@en ;
    rdfs:comment "Database to Ontology."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.dama.org/cpages/body-of-knowledge> ;
    rdfs:subClassOf kb:DatabaseIntegration ;
    skos:definition "A database integration direction that maps relational database schemas and records into ontology classes and individuals, populating the knowledge graph from structured enterprise data sources."@en ;
    skos:example "Using the D2RQ mapping language to convert a relational product database (tables: Product, Category, Supplier) into RDF triples that instantiate classes from a supply-chain ontology is DatabaseToOntology."@en .

kb:DefaultNamespace a owl:Class ;
    rdfs:label "Default Namespace"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Implicit namespace for unprefixed terms."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.w3.org/TR/rdf11-concepts/>,
        <https://www.w3.org/TR/rdf11-turtle/> ;
    rdfs:subClassOf kb:NamespaceManagement ;
    skos:definition "A namespace management setting that designates one namespace as the default for unprefixed local names in the ontology, simplifying authoring while establishing the primary identity scope."@en ;
    skos:example "@base <http://example.org/> in Turtle."@en .

kb:DefinitionWriting a owl:Class ;
    rdfs:label "Definition Writing"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Creating precise definitions using skos:definition or rdfs:comment."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/> ;
    rdfs:subClassOf kb:Annotation ;
    skos:definition "An annotation activity that composes a skos:definition for an ontology class or property, articulating its genus, differentia, and scope boundaries in sufficient detail to determine class membership."@en ;
    skos:example "Writing definition: 'A vehicle is a mobile machine that transports people or cargo'."@en .

kb:Deliverable a owl:Class ;
    rdfs:label "Deliverable"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Sprint F3 (2026-05-14): umbrella class implicit via subClassOf claims but never declared. Per BP-D2 + L-47v2: declared with full skos:definition to satisfy target class constraints."@en ;
    rdfs:comment "Umbrella class for ontology-engineering deliverable artifacts — QualityReport, Evidence, and other output artifacts that document the engineering process. Note: this is the conceptual umbrella; the corpus has additional dangling kb:Deliverable subClassOf claims removed in F1 for QualityAssessment per L-47 discipline. Per Sprint F3."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:subClassOf kb:KnowledgeBaseConcept ;
    skos:definition "Umbrella class for ontology-engineering deliverable artifacts — QualityReport, Evidence, and other output artifacts that document the engineering process. Note: this is the conceptual umbrella; the corpus has additional dangling kb:Deliverable subClassOf claims removed in F1 for QualityAssessment per L-47 discipline. Per Sprint F3."@en .

kb:DesignProcess a owl:Class ;
    rdfs:label "Design Process"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Processes focused on ontology design, conceptualization, and modeling activities."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:Activity,
        kb:DevelopmentProcess ;
    skos:definition "A structured sequence of design activities that transforms ontology requirements into a formal conceptual model, making decisions about hierarchy structure, axiom patterns, and modularization strategy."@en ;
    skos:example "The sequence: (1) identify competency questions, (2) enumerate required classes, (3) define properties, (4) populate individuals, (5) validate with SHACL — is a DesignProcess for OWL ontology construction."@en .

kb:DistributedTeam a owl:Class ;
    rdfs:label "Distributed Team"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Team working from multiple locations."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:Team,
        kb:TeamConcept ;
    skos:definition "An ontology engineering team whose members work from different physical locations, requiring explicit coordination tools, communication protocols, and shared digital workspaces for effective collaboration."@en ;
    skos:example "Distributed team spans 3 time zones across 2 continents."@en .

kb:DocumentAnalysis a owl:Class ;
    rdfs:label "Document Analysis"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "NeOn Methodology (Suárez-Figueroa et al., 2012). NeOn Methodology for Building Ontology Networks, IOS Press."@en ;
    rdfs:comment "Document Analysis - technique for gathering ontology requirements."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:RequirementsElicitation ;
    skos:definition "A requirements elicitation technique that extracts ontology requirements from existing documentation such as standards, regulations, data dictionaries, and domain manuals without direct stakeholder interaction."@en ;
    skos:example "Reading the W3C SHACL specification to identify the complete set of constraint component types (sh:minCount, sh:datatype, sh:pattern, etc.) and mapping each to an OQC quality metric is DocumentAnalysis."@en .

kb:Documentation a owl:Class ;
    rdfs:label "Documentation"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology Engineering in Collaborative and Distributed Environments (Tudorache et al., 2013). Semantic Web Journal."@en ;
    rdfs:comment "Written knowledge artifacts."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:KnowledgeSharingMechanism ;
    owl:disjointWith kb:Mentoring,
        kb:Training ;
    skos:definition "A knowledge sharing mechanism that captures and distributes ontology engineering knowledge through written artifacts such as design rationale documents, modeling guidelines, and lessons learned repositories."@en ;
    skos:example "Design rationale document explains choices."@en .

kb:DomainConflict a owl:Class ;
    rdfs:label "Domain Conflict"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology Engineering in Collaborative and Distributed Environments (Tudorache et al., 2013). Semantic Web Journal."@en ;
    rdfs:comment "Disagreement on domain representation."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:ConflictType ;
    owl:disjointWith kb:ProcessConflict,
        kb:TechnicalConflict ;
    skos:definition "A conflict type where different contributors have fundamentally different understandings of domain concepts, leading to incompatible class definitions or hierarchy structures that reflect different domain perspectives."@en ;
    skos:example "Experts disagree on Vehicle classification criteria."@en .

kb:EmailThread a owl:Class ;
    rdfs:label "Email Thread"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Email Thread."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:FormalCommunication ;
    skos:definition "A formal communication channel that uses email exchanges to discuss ontology design decisions, share documents, and coordinate activities, providing asynchronous communication with built-in message threading."@en ;
    skos:example "A GitHub Issue thread where three engineers debate whether oqc:SocialQuality should have owl:disjointWith constraints relative to oqc:SemanticQuality, producing a documented design decision, is an EmailThread in the ontology engineering process."@en .

kb:EvaluationActivity a owl:Class ;
    rdfs:label "Evaluation Activity"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Activity assessing ontology quality and fitness for purpose."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:Activity ;
    skos:definition "An ontology engineering activity that systematically assesses an ontology's quality, correctness, completeness, and fitness for purpose against defined criteria, producing measurement results and identified defects."@en ;
    skos:example "Calculating ontology metrics is an evaluation activity."@en .

kb:ExpertDecision a owl:Class ;
    rdfs:label "Expert Decision"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Decision deferred to subject matter expert."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.pmi.org/pmbok-guide-standards> ;
    rdfs:subClassOf kb:DecisionMakingProcess ;
    skos:definition "A decision-making process where a designated domain or technical expert makes the final ontology design choice based on their specialized knowledge, used for decisions requiring deep expertise."@en ;
    skos:example "Dr. Smith decides correct Vehicle taxonomy."@en .

kb:ExpertResolution a owl:Class ;
    rdfs:label "Expert Resolution"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Semantic Web Services and Integration (Sheth et al., 2005). IEEE Internet Computing."@en ;
    rdfs:comment "Resolving conflicts through human expert judgment."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-642-38721-0> ;
    rdfs:subClassOf kb:ConflictResolution ;
    skos:definition "A conflict resolution approach where a designated domain expert adjudicates between conflicting ontology design proposals, making the final determination based on their specialized knowledge."@en ;
    skos:example "Expert reviews conflict and chooses semantically correct axiom."@en .

kb:ExpertReview a owl:Class ;
    rdfs:label "Expert Review"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Continuous Monitoring and Observability for Semantic Systems. Ontology engineering common practice."@en ;
    rdfs:comment "Domain expert assessment of ontology accuracy."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:InspectionTechnique ;
    owl:disjointWith kb:PeerReview,
        kb:WalkthroughTechnique ;
    skos:definition "An inspection technique where a designated ontology expert evaluates an artifact against their specialized knowledge, identifying domain accuracy issues, modeling anti-patterns, and quality improvement opportunities."@en ;
    skos:example "An ISO/IEC 25010:2023 author validates that OQC's eight top-level QualityDimension individuals correctly map to the standard's product quality characteristics — this constitutes an ExpertReview."@en .

kb:ExtremeProgrammingForOntologies a owl:Class ;
    rdfs:label "XP for Ontologies"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "XP for Ontologies - adapts software methodology for ontology engineering."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:AgileMethodology ;
    owl:disjointWith kb:KanbanOntologyFlow,
        kb:ScrumOntologyDevelopment ;
    skos:definition "An agile methodology adapting extreme programming practices to ontology development, emphasizing pair modeling, test-driven ontology design, continuous integration, and frequent stakeholder feedback."@en ;
    skos:example "Pair-authoring every class with a test competency question, refactoring class hierarchies when new requirements emerge, and running SHACL validation on every commit exemplifies ExtremeProgrammingForOntologies."@en .

kb:FullRegression a owl:Class ;
    rdfs:label "Full Regression Test"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Full Regression Test - verifies existing functionality after changes."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2008.4578383>,
        <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf kb:DevelopmentProcess ;
    owl:disjointWith kb:PartialRegression,
        kb:RiskBasedRegression ;
    skos:definition "A regression test execution that runs the complete test suite after ontology modifications, providing maximum confidence in detecting unintended side effects at the cost of longer execution time."@en ;
    skos:example "Re-running all five C5 mutation tests plus all pySHACL C4 validations against all five ontologies after adding rdfs:isDefinedBy to 140 a reliability ontology individuals is a FullRegression for the OE package."@en .

kb:IdentityLinking a owl:Class ;
    rdfs:label "Identity Linking"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Declaring instances represent same real-world entity."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.w3.org/DesignIssues/LinkedData.html> ;
    rdfs:subClassOf kb:EntityLinking ;
    skos:definition "An entity linking technique that establishes owl:sameAs or equivalent identity assertions between entities in different knowledge bases, declaring that two different URIs refer to the same real-world entity."@en ;
    skos:example "Asserting :Vehicle_123 owl:sameAs dbr:Tesla_Model_3."@en .

kb:ImplementationProcess a owl:Class ;
    rdfs:label "Implementation Process"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Processes for transforming ontology designs into formal representations and executable artifacts."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:Activity,
        kb:DevelopmentProcess ;
    skos:definition "A structured sequence of implementation activities that transforms formal ontology designs into executable artifacts, encompassing encoding, serialization, population, and initial validation."@en ;
    skos:example "Translating the agreed class hierarchy into Turtle syntax, setting rdfs:label, skos:definition, and dcterms:source on every class, and running rdflib g.parse() to confirm syntax validity is the ImplementationProcess."@en .

kb:IncrementalMethodology a owl:Class ;
    rdfs:label "Incremental Methodology"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Building ontology in increments."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:DevelopmentMethodology,
        kb:Methodology ;
    skos:definition "An ontology development methodology that delivers the ontology in planned increments, each adding a defined set of classes and properties, allowing early partial deployment while development continues."@en ;
    skos:example "Incremental releases every 2 weeks."@en .

kb:IntegrationMerge a owl:Class ;
    rdfs:label "Integration Merge"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "DevOps and Continuous Delivery (Humble & Farley, 2010). Addison-Wesley."@en ;
    rdfs:comment "Sophisticated merge resolving conflicts and redundancy."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1>,
        <https://doi.org/10.1007/978-3-642-38721-0> ;
    rdfs:subClassOf kb:MergingStrategy ;
    skos:definition "A merging strategy that combines two ontologies by taking the union of their content and adding bridge axioms to connect corresponding concepts, producing a comprehensive integrated ontology."@en ;
    skos:example "Integration merge identifies and removes 15 duplicate classes."@en .

kb:IntersectionMerge a owl:Class ;
    rdfs:label "Intersection Merge"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "DevOps and Continuous Delivery (Humble & Farley, 2010). Addison-Wesley."@en ;
    rdfs:comment "Keeping only common elements between ontologies."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1>,
        <https://doi.org/10.1007/978-3-642-38721-0> ;
    rdfs:subClassOf kb:MergingStrategy ;
    skos:definition "A merging strategy that combines only the shared concepts and relationships from two ontologies, producing a minimal merged ontology containing only the common ground between sources."@en ;
    skos:example "Intersection of A and B keeps only 20 overlapping classes."@en .

kb:KickoffMeeting a owl:Class ;
    rdfs:label "Kickoff Meeting"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology Engineering in Collaborative and Distributed Environments (Tudorache et al., 2013). Semantic Web Journal."@en ;
    rdfs:comment "Initial meeting launching project."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://scrumguides.org/scrum-guide.html> ;
    rdfs:subClassOf kb:MeetingType ;
    owl:disjointWith kb:RetrospectiveMeeting,
        kb:StatusMeeting,
        kb:WorkshopMeeting ;
    skos:definition "A meeting held at the start of an ontology engineering project or phase to establish goals, introduce team members, clarify roles, review the project plan, and align stakeholder expectations."@en ;
    skos:example "Kickoff meeting aligns team on scope and timeline."@en .

kb:LabelAddition a owl:Class ;
    rdfs:label "Label Addition"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Adding rdfs:label values in one or more languages."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/> ;
    rdfs:subClassOf kb:Annotation ;
    skos:definition "An annotation activity that assigns a human-readable rdfs:label to an ontology element, providing the display name that users and tools present instead of the technical URI identifier."@en ;
    skos:example "Adding labels: en:'Vehicle', es:'Vehículo', fr:'Véhicule'."@en .

kb:LeaderDecision a owl:Class ;
    rdfs:label "Leader Decision"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Decision made by project leader."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.pmi.org/pmbok-guide-standards> ;
    rdfs:subClassOf kb:DecisionMakingProcess ;
    skos:definition "A decision-making process where the project leader or ontology architect makes the final design choice, used when rapid decision-making or architectural consistency takes priority over broad consensus."@en ;
    skos:example "Project lead breaks tie and selects approach."@en .

kb:LenientParsing a owl:Class ;
    rdfs:label "Lenient Parsing"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Parsing attempting to recover from syntax errors."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.w3.org/TR/rdf11-concepts/> ;
    rdfs:subClassOf kb:Parsing ;
    skos:definition "A parsing mode that tolerates minor syntax violations and attempts to recover gracefully from errors, loading as much of the ontology as possible while logging warnings for problematic content."@en ;
    skos:example "Lenient parser accepts common syntax variations."@en .

kb:Lesson a owl:Class ;
    rdfs:label "Lesson"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:isReplacedBy kb:LessonsLearned ;
    dcterms:source "Sprint F6 (2026-05-15)."@en ;
    rdfs:comment "A lesson learned from an engineering experience. Synonym for kb:LessonLearned; preserved here because L-47 was authored with type kb:Lesson during Track D Mitigation Cleanup. Per BP-D19 (a): use equivalentClass for true semantic identity; here subClassOf is preferred since LessonLearned is the older form. Per Sprint F6: declared from 1 type reference (L-47)."@en,
        "DEPRECATED 2026-05-28: consolidated into kb:LessonsLearned (flat model). Retained as deprecated stub for audit lineage per deprecate-not-delete discipline."@en ;
    owl:deprecated true ;
    skos:definition "An umbrella class for governance knowledge items capturing experiential insight from the OE Pack development process. Specialised by LessonsLearned (and Refinement); each individual records a failure mode or insight with a skos:definition and dcterms:source."@en .

kb:LessonLearned a owl:Class ;
    rdfs:label "Lesson Learned"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:isReplacedBy kb:LessonsLearned ;
    dcterms:source "Migrated from rev:LessonLearned and redo:LessonsLearned. Class name canonical singular form ('LessonLearned'); the plural-form redo:LessonsLearned class is retired."@en ;
    rdfs:comment "An empirical finding from an engineering session or work-package, preserved as durable knowledge. Lessons describe what went wrong (or was discovered) and motivate BestPractices — a recurring lesson becomes a discipline rule."@en,
        "DEPRECATED 2026-05-28: consolidated into kb:LessonsLearned (flat model). Retained as deprecated stub for audit lineage per deprecate-not-delete discipline."@en ;
    owl:deprecated true ;
    skos:definition "A governance knowledge item recording a specific failure mode encountered during OE Pack development together with the corrective insight it produced. Each instance carries a unique hasLessonId (L-{n}), a skos:definition stating the lesson, and a dcterms:source; lessons are indexed and cross-linked via rdfs:seeAlso."@en .

kb:LexicalMapping a owl:Class ;
    rdfs:label "Lexical Mapping"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Semantic Web Services and Integration (Sheth et al., 2005). IEEE Internet Computing."@en ;
    rdfs:comment "Mappings based on textual similarity of labels."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-642-38721-0> ;
    rdfs:subClassOf kb:AutomaticMapping ;
    skos:definition "An automatic mapping technique that identifies correspondences by computing similarity between the lexical forms of ontology element labels, using string metrics, tokenization, and morphological analysis."@en ;
    skos:example "Matching 'Automobile' and 'Auto' based on edit distance."@en .

kb:Lifecycle a owl:Class ;
    rdfs:label "Lifecycle"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "ISO/IEC/IEEE 12207:2017 Systems and software engineering — Software life cycle processes; W3C OWL 2 Working Drafts on ontology lifecycle stages."@en ;
    rdfs:comment "Concept previously referenced by meta:BehavioralView meta:covers, meta:ProcessLayer meta:contains, meta:FR_003 meta:satisfiedBy. Declared with full annotations in v6.3.12 to satisfy META M2a/M2b/M2c."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/63712.html> ;
    rdfs:subClassOf kb:KnowledgeBaseConcept ;
    skos:definition "The ordered set of phases through which an ontology artefact evolves: requirements engineering → conceptualisation → formalisation → implementation → evaluation → deployment → maintenance → retirement. Modelled as a process layer in META and verified by behavioural views (FR-003)."@en ;
    skos:example "An ontology in the Implementation phase has TBox axioms in OWL 2 but ABox population is incomplete; transition to Evaluation requires SHACL conformance + competency-question coverage gates."@en .

kb:LiteratureSearch a owl:Class ;
    rdfs:label "Literature Search"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "NeOn Methodology (Suárez-Figueroa et al., 2012). NeOn Methodology for Building Ontology Networks, IOS Press."@en ;
    rdfs:comment "Literature Search."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1016/0004-3702(95)00017-8> ;
    rdfs:subClassOf kb:LiteratureReview ;
    skos:definition "A literature review activity that systematically queries bibliographic databases and digital libraries to locate publications relevant to the ontology's domain and methodology, establishing a comprehensive source base."@en ;
    skos:example "Querying Google Scholar for 'ontology quality assessment ISO 25010' to identify peer-reviewed metrics that should be modeled in oqc_v2_2_1.ttl before any class is authored is a LiteratureSearch."@en .

kb:METHONTOLOGY dcterms:isPartOf <http://example.org/knowledge-base> ;
    rdfs:subClassOf kb:PrescriptiveMethodology .

kb:ManualModularization a owl:Class ;
    rdfs:label "Manual Modularization"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Expert-driven decomposition into modules."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:ModularizationTechnique ;
    skos:definition "A modularization technique where ontology architects manually define module boundaries based on domain expertise, architectural principles, and intended reuse patterns for each module."@en ;
    skos:example "Expert divides ontology into 5 domain-specific modules."@en .

kb:ManualPopulation a owl:Class ;
    rdfs:label "Manual Population"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Hand-crafting individual instances one by one."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:Population ;
    skos:definition "A population activity where domain experts manually create ontology individuals and their property assertions, providing high accuracy for critical instances at the cost of limited throughput."@en ;
    skos:example "Using Protégé to manually create 50 vehicle instances."@en .

kb:MiddleOutDesign a owl:Class ;
    rdfs:label "Middle-Out Design"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology Design Patterns (Gangemi, 2005). Ontology Design Patterns for Semantic Web Content, ISWC."@en ;
    rdfs:comment "Middle-Out Design - strategy for building class hierarchies."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:TaxonomyDesign ;
    skos:definition "An ontology construction strategy that begins with the most salient mid-level domain concepts identified by experts, then simultaneously generalizes upward to abstract categories and specializes downward to detailed instances."@en ;
    skos:example "Identifying the five most frequently queried entities in an enterprise system, defining classes for them, then expanding both upward (superclasses) and downward (subclasses) is MiddleOutDesign."@en .

kb:MilestoneDefinition a owl:Class ;
    rdfs:label "Milestone Definition"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Establishing key checkpoints and deliverable dates in project timeline."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.pmi.org/pmbok-guide-standards> ;
    rdfs:subClassOf kb:SchedulePlanning ;
    skos:definition "A schedule planning activity that identifies key checkpoint dates in the ontology project timeline, defining the deliverables and quality criteria that must be met at each checkpoint."@en ;
    skos:example "Defining milestones: M1 requirements complete, M2 first draft, M3 validated version."@en .

kb:NamespaceDefinition a owl:Class ;
    rdfs:label "Namespace Definition"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Establishing URI namespaces and prefixes for ontology elements."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.w3.org/TR/rdf11-concepts/> ;
    rdfs:subClassOf kb:Encoding ;
    skos:definition "An encoding activity that establishes the URI namespace structure for the ontology, defining base URIs, prefix abbreviations, and naming conventions that ensure globally unique and resolvable identifiers."@en ;
    skos:example "Defining prefix 'veh:' for http://example.org/vehicle# namespace."@en .

kb:ObservationStudy a owl:Class ;
    rdfs:label "Observation Study"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "NeOn Methodology (Suárez-Figueroa et al., 2012). NeOn Methodology for Building Ontology Networks, IOS Press."@en ;
    rdfs:comment "Observation Study - technique for gathering ontology requirements."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:RequirementsElicitation ;
    skos:definition "A requirements elicitation technique that gathers ontology requirements by observing domain experts performing their work tasks, identifying concepts and relationships they use implicitly in practice."@en ;
    skos:example "Watching an ontology engineer validate five TTL files manually, recording which checks they perform and in what order, to derive requirements for the OWB automated assessment tool, is an ObservationStudy."@en .

kb:OntologyDocumentation a owl:Class ;
    rdfs:label "OntologyDocumentation"@en ;
    dcterms:created "2026-02-03T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "An ontology engineering activity that creates and maintains human-readable descriptions of the ontology including design rationale, usage guidelines, change history, and governance procedures for all stakeholder audiences."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1>,
        <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/> ;
    rdfs:subClassOf kb:Activity ;
    skos:definition "An ontology engineering activity that creates and maintains human-readable descriptions of the ontology including design rationale, usage guidelines, change history, and governance procedures for all stakeholder audiences."@en ;
    skos:example "Generating a WIDOCO documentation website from ontology annotations combined with manually authored usage examples and design decision records."@en .

kb:OntologyEvaluation a owl:Class ;
    rdfs:label "OntologyEvaluation"@en ;
    dcterms:created "2026-02-03T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "ISO/IEC 25010:2011 Systems and Software Quality Models."@en ;
    rdfs:comment "An ontology engineering activity that systematically assesses an ontology against quality criteria, competency questions, and fitness-for-purpose requirements, producing quantitative metrics and qualitative findings for improvement."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1>,
        <https://www.iso.org/standard/35733.html> ;
    rdfs:subClassOf kb:Activity ;
    skos:definition "An ontology engineering activity that systematically assesses an ontology against quality criteria, competency questions, and fitness-for-purpose requirements, producing quantitative metrics and qualitative findings for improvement."@en ;
    skos:example "Running OOPS! pitfall scanner, computing structural metrics, testing competency questions, and conducting expert review of a newly developed ontology."@en .

kb:OntologyFormat a owl:Class ;
    rdfs:label "Ontology Format"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Sprint F5 (2026-05-15)."@en ;
    rdfs:comment "A serialization format for ontologies — Turtle, RDF/XML, JSON-LD, OWL/XML, OBO, etc. Per Sprint F5."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:subClassOf kb:KnowledgeBaseConcept ;
    skos:definition "A serialization format for ontologies — Turtle, RDF/XML, JSON-LD, OWL/XML, OBO, etc. Per Sprint F5."@en .

kb:OntologyMerging a owl:Class ;
    rdfs:label "OntologyMerging"@en ;
    dcterms:created "2026-02-03T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology Matching (Euzenat & Shvaiko, 2013). Springer."@en ;
    rdfs:comment "An ontology engineering activity that combines two or more independently developed ontologies into a single unified ontology, resolving naming conflicts, structural differences, and semantic overlaps in the merge."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1>,
        <https://doi.org/10.1007/978-3-642-38721-0> ;
    rdfs:subClassOf kb:Activity ;
    skos:definition "An ontology engineering activity that combines two or more independently developed ontologies into a single unified ontology, resolving naming conflicts, structural differences, and semantic overlaps in the merge."@en ;
    skos:example "Merging a clinical terminology ontology with a genomics ontology to create an integrated biomedical knowledge base for translational research."@en .

kb:OntologyModularization a owl:Class ;
    rdfs:label "OntologyModularization"@en ;
    dcterms:created "2026-02-03T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology Engineering in Collaborative and Distributed Environments (Tudorache et al., 2013). Semantic Web Journal."@en ;
    rdfs:comment "An ontology engineering activity that decomposes a monolithic ontology into cohesive, independently manageable modules with well-defined interfaces, enabling parallel development, selective reuse, and scalable maintenance."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1>,
        <https://www.iso.org/standard/50508.html> ;
    rdfs:subClassOf kb:Activity ;
    skos:definition "An ontology engineering activity that decomposes a monolithic ontology into cohesive, independently manageable modules with well-defined interfaces, enabling parallel development, selective reuse, and scalable maintenance."@en ;
    skos:example "Splitting a healthcare ontology into modules for anatomy, diseases, treatments, and procedures, each with explicit import dependencies."@en .

kb:OntologyPopulation a owl:Class ;
    rdfs:label "OntologyPopulation"@en ;
    dcterms:created "2026-02-03T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "METHONTOLOGY (Fernández-López et al., 1997). Building a Chemical Ontology Using METHONTOLOGY, IEEE Intelligent Systems."@en ;
    rdfs:comment "An ontology engineering activity that creates instance data by asserting named individuals, their class memberships, and their property values, populating the ontological schema with concrete domain entities."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1>,
        <https://doi.org/10.1016/0004-3702(95)00017-8> ;
    rdfs:subClassOf kb:Activity ;
    skos:definition "An ontology engineering activity that creates instance data by asserting named individuals, their class memberships, and their property values, populating the ontological schema with concrete domain entities."@en ;
    skos:example "Creating individual instances for each country in a geopolitical ontology, asserting their names, populations, and diplomatic relationships."@en .

kb:OntologyReuse a owl:Class ;
    rdfs:label "OntologyReuse"@en ;
    dcterms:created "2026-02-03T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "NeOn Methodology (Suárez-Figueroa et al., 2012). NeOn Methodology for Building Ontology Networks, IOS Press."@en ;
    rdfs:comment "An ontology engineering activity that identifies, evaluates, and incorporates existing ontologies or ontology modules into a new ontology project, reducing development effort through leveraging prior work."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:Activity ;
    skos:definition "An ontology engineering activity that identifies, evaluates, and incorporates existing ontologies or ontology modules into a new ontology project, reducing development effort through leveraging prior work."@en ;
    skos:example "Importing the Gene Ontology's molecular function branch into a pharmacogenomics ontology rather than recreating those concepts from scratch."@en .

kb:OntologySelection a owl:Class ;
    rdfs:label "Ontology Selection"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Choosing specific existing ontologies to import or align with."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:ReusabilityAnalysis ;
    skos:definition "A reusability analysis activity that compares candidate ontologies for reuse and selects the best-fitting options based on coverage, quality, maintenance status, and community adoption criteria."@en ;
    skos:example "Selecting SUMO upper ontology and automotive industry ontology for reuse."@en .

kb:OntologyToDatabase a owl:Class ;
    rdfs:label "Ontology to Database"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Domain-Specific Ontology Engineering: Industry Applications (various). Ontology engineering common practice."@en ;
    rdfs:comment "Ontology to Database."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.dama.org/cpages/body-of-knowledge> ;
    rdfs:subClassOf kb:DatabaseIntegration ;
    skos:definition "A database integration direction that maps ontology classes and individuals back into relational database tables and rows, enabling traditional database applications to consume ontology-derived data."@en ;
    skos:example "Materializing all OQC quality metric values as rows in a PostgreSQL table (columns: class_iri, metric_name, score, timestamp) by iterating SPARQL SELECT results from oqc_v2_2_1.ttl is OntologyToDatabase."@en .

kb:PairProgramming a owl:Class ;
    rdfs:label "Pair Programming"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Pair Programming."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/3-540-46109-1_1> ;
    rdfs:subClassOf kb:PairModeling ;
    skos:definition "A pair modeling variant adapted from software engineering where two engineers jointly create ontology implementations, with one writing axioms and the other reviewing for logical correctness and style."@en ;
    skos:example "Two engineers simultaneously editing a single TTL file — one writing class axioms, the other immediately authoring the corresponding SHACL shape — exemplifies PairProgramming adapted for ontology engineering."@en .

kb:PatternApplication a owl:Class ;
    rdfs:label "Pattern Application"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Applying proven ontology design patterns to solve modeling problems."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl2-primer/> ;
    rdfs:subClassOf kb:FormalSpecification ;
    skos:definition "A formal specification activity that instantiates established ontology design patterns to address recurring modeling challenges, adapting the pattern's generic structure to the specific domain context."@en ;
    skos:example "Applying part-whole pattern to model Engine as part of Vehicle."@en .

kb:PeerReviewFeedback a owl:Class ;
    rdfs:label "Peer Review Feedback"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Colleagues review each other's work."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:FeedbackMechanism ;
    skos:definition "A feedback mechanism that collects structured evaluative comments from peer reviewers examining proposed ontology changes, providing specific improvement suggestions before changes are committed."@en ;
    skos:example "Peer review catches 5 modeling errors before merge."@en .

kb:PrefixDeclaration a owl:Class ;
    rdfs:label "Prefix Declaration"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Defining shorthand for URI namespaces."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.w3.org/TR/rdf11-concepts/>,
        <https://www.w3.org/TR/rdf11-turtle/> ;
    rdfs:subClassOf kb:NamespaceManagement ;
    skos:definition "A namespace management element that binds a short prefix string to a full namespace URI, enabling compact notation for ontology element references throughout serialization files and SPARQL queries."@en ;
    skos:example "@prefix foaf: <http://xmlns.com/foaf/0.1/> ."@en .

kb:PrettyPrinting a owl:Class ;
    rdfs:label "Pretty Printing"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Human-readable serialization with formatting."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.w3.org/TR/rdf11-concepts/> ;
    rdfs:subClassOf kb:Serialization ;
    skos:definition "A serialization approach that formats ontology output with consistent indentation, line breaks, and visual structure to maximize human readability, facilitating manual review and version control differencing."@en ;
    skos:example "Pretty-printed Turtle with aligned prefixes and indentation."@en .

kb:PriorityBasedResolution a owl:Class ;
    rdfs:label "Priority-Based Resolution"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Semantic Web Services and Integration (Sheth et al., 2005). IEEE Internet Computing."@en ;
    rdfs:comment "Resolving conflicts by favoring higher-priority source."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <http://example.org/risk#PriorityBasedResolution>,
        <https://doi.org/10.1007/978-3-642-38721-0> ;
    rdfs:subClassOf kb:ConflictResolution,
        <http://example.org/risk#PriorityBasedResolution> ;
    skos:definition "A conflict resolution approach that resolves ontology design conflicts by applying a predefined priority ranking among contributors or source ontologies, with higher-priority sources prevailing."@en ;
    skos:exactMatch <http://example.org/risk#PriorityBasedResolution> ;
    skos:example "Accepting Car definition from authoritative industry ontology."@en .

kb:PrototypeBuilding a owl:Class ;
    rdfs:label "Prototype Building"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Prototype Building."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:Activity,
        kb:Prototyping ;
    skos:definition "An activity within prototyping methodology that constructs a simplified working ontology covering key concepts and queries, designed for rapid stakeholder evaluation rather than production completeness."@en ;
    skos:example "Creating a 15-class minimal ontology, loading it into a SPARQL endpoint, and running three competency questions against it to validate the modelling approach before full development is PrototypeBuilding."@en .

kb:PrototypingMethodology a owl:Class ;
    rdfs:label "Prototyping Methodology"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Building quick prototypes for feedback."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:DevelopmentMethodology,
        kb:Methodology ;
    skos:definition "An ontology development methodology that rapidly creates simplified ontology prototypes for stakeholder evaluation, using feedback to refine requirements before committing to full-scale formal development."@en ;
    skos:example "Prototype validates concepts before full implementation."@en .

kb:QuestionAnswering a owl:Class ;
    rdfs:label "Question Answering"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Question Answering."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:Activity,
        kb:Application ;
    skos:definition "A use case category where ontology-powered systems interpret natural language questions and retrieve precise answers from the knowledge graph, bridging human language and formal semantic representations."@en ;
    skos:example "A system that answers 'Which a reliability ontology individuals were added in version 2.5.4?' by querying prov:wasGeneratedBy triples in the PROV-O evidence files, returning a list of 168 individual IRIs, is QuestionAnswering."@en .

kb:RampUpLoad a owl:Class ;
    rdfs:label "Ramp-Up Load Test"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Ramp-Up Load Test - evaluates performance under specific load patterns."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2008.4578383>,
        <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf kb:DevelopmentProcess ;
    owl:disjointWith kb:SpikeLoad,
        kb:SteadyStateLoad ;
    skos:definition "A load test variant that gradually increases query volume from zero to the target level over a defined period, testing the ontology system's ability to handle progressively increasing demand."@en ;
    skos:example "Gradually increasing SPARQL query throughput from 1 to 50 concurrent requests per second over 5 minutes against a Fuseki endpoint loaded with redo_v2_5_6.ttl, measuring response time at each step, is RampUpLoad testing."@en .

kb:ReasoningBasedMapping a owl:Class ;
    rdfs:label "Reasoning-Based Mapping"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Semantic Web Services and Integration (Sheth et al., 2005). IEEE Internet Computing."@en ;
    rdfs:comment "Mappings discovered through logical inference."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-642-38721-0> ;
    rdfs:subClassOf kb:SemanticMapping ;
    skos:definition "A semantic mapping technique that uses description logic reasoning to compute logical relationships between class expressions from different ontologies, identifying subsumption and equivalence correspondences."@en ;
    skos:example "Inferring class equivalence from subsumption relationships."@en .

kb:Refinement a owl:Class ;
    rdfs:label "Refinement"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Migrated from rev:Refinement."@en ;
    rdfs:comment "A governance-level architectural pattern or decision rubric that applies across multiple BestPractices. Refinements describe HOW the discipline is structured (e.g., 'Subject+Bridge Pattern', 'Stranded-Class Policy', 'Post-Supersession Audit Reporting')."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:subClassOf kb:KnowledgeBaseConcept ;
    skos:definition "A governance-level architectural pattern or decision rubric that applies across multiple BestPractices. Refinements describe HOW the discipline is structured (e.g., 'Subject+Bridge Pattern', 'Stranded-Class Policy', 'Post-Supersession Audit Reporting')."@en .

kb:RelatedLinking a owl:Class ;
    rdfs:label "Related Linking"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Declaring instances are related but not identical."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.w3.org/DesignIssues/LinkedData.html> ;
    rdfs:subClassOf kb:EntityLinking ;
    skos:definition "An entity linking technique that establishes associative relationships between related but non-identical entities across knowledge bases, using properties like rdfs:seeAlso or skos:related for cross-referencing."@en ;
    skos:example "Asserting :Vehicle_123 rdfs:seeAlso dbr:Tesla_Model_3."@en .

kb:RelationshipModeling a owl:Class ;
    rdfs:label "Relationship Modeling"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Identifying and modeling non-hierarchical relationships between concepts."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:ConceptualModeling ;
    skos:definition "A conceptual modeling activity that identifies and defines the semantic associations between domain concepts, determining which object properties are needed and how they connect classes in the ontology."@en ;
    skos:example "Modeling 'Car hasEngine Engine' and 'Engine requiresFuel Fuel' relationships."@en .

kb:RepositoryPublication a owl:Class ;
    rdfs:label "Repository Publication"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "DevOps and Continuous Delivery (Humble & Farley, 2010). Addison-Wesley."@en ;
    rdfs:comment "Submitting ontology to ontology library or registry."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/> ;
    rdfs:subClassOf kb:Publication ;
    skos:definition "A publication activity that publishes the ontology to a version-controlled repository such as GitHub or a dedicated ontology registry, providing versioned access with metadata and documentation."@en ;
    skos:example "Submitting ontology to BioPortal with metadata and license information."@en .

kb:RequirementValidation a owl:Class ;
    rdfs:label "Requirement Validation"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Verifying ontology satisfies stated requirements and competency questions."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf kb:ValidationActivity ;
    skos:definition "A validation activity that confirms the ontology satisfies its specified requirements by executing competency questions, use case scenarios, and acceptance criteria against the implemented ontology."@en ;
    skos:example "Verifying SPARQL queries for all competency questions return correct answers."@en .

kb:ResourceAllocation a owl:Class ;
    rdfs:label "Resource Allocation"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Resource Allocation."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:ResourcePlanning ;
    skos:definition "A resource planning activity that assigns specific personnel, tools, and infrastructure to planned ontology development tasks, matching skill requirements and availability to task demands."@en ;
    skos:example "Assigning the SeniorOntologyEngineer to the SHACL SPARQL rewrite task and the JuniorOntologyEngineer to the bulk rdfs:isDefinedBy patch script, based on skill match and effort estimate, is ResourceAllocation."@en .

kb:ResourceCoordination a owl:Class ;
    rdfs:label "Resource Coordination"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology Engineering in Collaborative and Distributed Environments (Tudorache et al., 2013). Semantic Web Journal."@en ;
    rdfs:comment "Aligning resource allocation."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:CoordinationMechanism ;
    owl:disjointWith kb:ScheduleCoordination,
        kb:TaskCoordination ;
    skos:definition "A coordination mechanism that manages the allocation and scheduling of shared resources such as test environments, reasoner licenses, and domain expert availability across concurrent ontology tasks."@en ;
    skos:example "Shared workspace coordinates file access."@en .

kb:Reviewer a owl:Class ;
    rdfs:label "Reviewer"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Person examining ontology for issues."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2014.6816804>,
        <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:KnowledgeBaseConcept ;
    skos:definition "A quality role responsible for examining ontology changes submitted by other team members, verifying correctness, consistency with design standards, and completeness of documentation before approval."@en ;
    skos:example "Reviewer checks for modeling errors and inconsistencies."@en .

kb:SatisfiabilityChecking a owl:Class ;
    rdfs:label "Satisfiability Checking"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Verifying all classes can have at least one instance."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl2-primer/> ;
    rdfs:subClassOf kb:LogicalValidation ;
    skos:definition "A logical validation operation that verifies each named class in the ontology can have at least one instance, identifying unsatisfiable classes whose restriction combinations are logically impossible."@en ;
    skos:example "Checking that Vehicle restrictions allow at least one valid instance."@en .

kb:SemanticConversion a owl:Class ;
    rdfs:label "Semantic Conversion"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Conversion requiring semantic interpretation."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.w3.org/TR/rdf11-concepts/> ;
    rdfs:subClassOf kb:FormatConversion ;
    skos:definition "A format conversion that transforms the ontology's representation across different semantic paradigms, such as converting between OWL axioms and SKOS concept schemes while preserving domain semantics."@en ;
    skos:example "OWL to RDFS conversion loses some axioms."@en .

kb:SemanticModularization a owl:Class ;
    rdfs:label "Semantic Modularization"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Modularization preserving logical properties."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:AutomaticModularization ;
    skos:definition "An automatic modularization technique that partitions the ontology based on semantic relatedness of concepts, grouping classes that share domain topics, usage contexts, or logical dependencies."@en ;
    skos:example "Extracting module that preserves all inferences about Vehicle."@en .

kb:SlackDiscussion a owl:Class ;
    rdfs:label "Slack Discussion"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Slack Discussion."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:InformalCommunication ;
    skos:definition "An informal communication channel using a team messaging platform for quick questions, status updates, and casual ontology design discussions, providing searchable history with channel-based topic organization."@en ;
    skos:example "A team Slack thread where the SHACL author shares the pySHACL SPARQL 'FILTER in FILTER NOT EXISTS' bug and proposes three alternative query rewrites for the team to vote on is a SlackDiscussion in ontology sprint coordination."@en .

kb:SpiralOntologyRefinement a owl:Class ;
    rdfs:label "Spiral Ontology Refinement"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Spiral Ontology Refinement - adapts software methodology for ontology engineering."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:SpiralMethodology ;
    skos:definition "A spiral methodology variant that uses each iteration cycle to progressively refine the ontology's scope, depth, and axiom strength based on evaluation feedback from the previous cycle."@en ;
    skos:example "Beginning with a minimal 10-class ontology, running it through pySHACL, adding 20 classes per iteration to address newly discovered requirements, then re-validating is SpiralOntologyRefinement."@en .

kb:StakeholderFeedback a owl:Class ;
    rdfs:label "Stakeholder Feedback"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Input from project stakeholders."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:FeedbackMechanism ;
    skos:definition "A feedback mechanism that collects evaluative input from ontology consumers and domain experts on the ontology's fitness for purpose, usability, and coverage, driving prioritization of improvement efforts."@en ;
    skos:example "User feedback reveals 3 missing concepts."@en .

kb:StakeholderInterview a owl:Class ;
    rdfs:label "Stakeholder Interview"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "NeOn Methodology (Suárez-Figueroa et al., 2012). NeOn Methodology for Building Ontology Networks, IOS Press."@en ;
    rdfs:comment "Stakeholder Interview - technique for gathering ontology requirements."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:RequirementsElicitation ;
    skos:definition "A requirements elicitation technique that conducts structured conversations with identified stakeholders to capture their specific needs, expectations, and constraints for the ontology through directed questioning."@en ;
    skos:example "Recording a 60-minute structured discussion with three ontology engineers to identify what a reliability ontology gate failures they find hardest to diagnose, then converting responses to SHACL shape requirements, is a StakeholderInterview."@en .

kb:StrictParsing a owl:Class ;
    rdfs:label "Strict Parsing"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Parsing rejecting any syntax errors."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.w3.org/TR/rdf11-concepts/> ;
    rdfs:subClassOf kb:Parsing ;
    skos:definition "A parsing mode that rejects ontology files containing any syntax violations, undeclared prefixes, or non-conformant structures, ensuring only fully valid files are successfully loaded."@en ;
    skos:example "Strict parser rejects file with malformed IRI."@en .

kb:StructuralMapping a owl:Class ;
    rdfs:label "Structural Mapping"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Semantic Web Services and Integration (Sheth et al., 2005). IEEE Internet Computing."@en ;
    rdfs:comment "Mappings leveraging hierarchy and relationship structures."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-642-38721-0> ;
    rdfs:subClassOf kb:AutomaticMapping ;
    skos:definition "An automatic mapping technique that identifies correspondences by comparing the structural positions of elements within their respective hierarchies, matching elements with similar ancestor and descendant patterns."@en ;
    skos:example "Matching based on similar subclass structures."@en .

kb:SyntacticConversion a owl:Class ;
    rdfs:label "Syntactic Conversion"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Direct syntax translation preserving all information."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.w3.org/TR/rdf11-concepts/> ;
    rdfs:subClassOf kb:FormatConversion ;
    skos:definition "A format conversion that transforms the serialization syntax without altering the ontology's content, such as converting between Turtle and RDF/XML representations of the same set of triples."@en ;
    skos:example "RDF/XML to Turtle conversion preserves all triples."@en .

kb:SyntacticModularization a owl:Class ;
    rdfs:label "Syntactic Modularization"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Modularization based on structure without reasoning."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:AutomaticModularization ;
    skos:definition "An automatic modularization technique that partitions the ontology based on syntactic features such as namespace prefixes, file boundaries, or URI patterns without analyzing semantic content."@en ;
    skos:example "Extracting all classes reachable from Vehicle via subclass links."@en .

kb:SyntaxTranslation a owl:Class ;
    rdfs:label "Syntax Translation"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Converting ontology between different serialization formats."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.w3.org/TR/rdf11-concepts/> ;
    rdfs:subClassOf kb:Encoding ;
    skos:definition "An encoding activity that converts ontology content from one serialization format to another, such as transforming Turtle to RDF/XML, while preserving the complete set of triples and annotations."@en ;
    skos:example "Converting ontology from RDF/XML to Turtle for better readability."@en .

kb:SyntaxValidation a owl:Class ;
    rdfs:label "Syntax Validation"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Checking conformance to format specification."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:Activity,
        kb:Validator ;
    skos:definition "An automated validation technique that verifies the ontology file conforms to its declared serialization format grammar, detecting parse errors, undeclared prefixes, and malformed URI references."@en ;
    skos:example "Validating Turtle syntax according to W3C spec."@en .

kb:TeamFormation a owl:Class ;
    rdfs:label "Team Formation"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Assembling project team with appropriate skills and roles."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:ResourcePlanning ;
    skos:definition "A resource planning activity that selects and assembles the ontology engineering team, determining the needed roles, skill profiles, and team size based on project scope and complexity."@en ;
    skos:example "Recruiting ontology engineer, knowledge engineer, and domain expert for team."@en .

kb:TechnicalSpecification a owl:Class ;
    rdfs:label "Technical Specification"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Writing detailed technical documentation of ontology design and decisions."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/> ;
    rdfs:subClassOf kb:ExternalDocumentation ;
    skos:definition "An external documentation artifact that formally describes the ontology's design decisions, module interfaces, axiom patterns, and implementation constraints for consumption by engineers and integrators."@en ;
    skos:example "Writing specification documenting 15 design patterns used in ontology."@en .

kb:ToolSelection a owl:Class ;
    rdfs:label "Tool Selection"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Choosing appropriate software tools for ontology development."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:ResourcePlanning ;
    skos:definition "A resource planning activity that evaluates and selects the ontology engineering tools to be used in the project, considering features, compatibility, licensing, and team familiarity with alternatives."@en ;
    skos:example "Selecting Protégé as editor, HermiT as reasoner, and GitHub for version control."@en .

kb:TopDownDesign a owl:Class ;
    rdfs:label "Top-Down Design"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology Design Patterns (Gangemi, 2005). Ontology Design Patterns for Semantic Web Content, ISWC."@en ;
    rdfs:comment "Top-Down Design - strategy for building class hierarchies."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:TaxonomyDesign ;
    skos:definition "An ontology construction strategy that begins with the most general domain categories and progressively specializes them into increasingly specific subclasses, guided by established upper ontology frameworks."@en ;
    skos:example "Starting from a published domain taxonomy (e.g., ISO 25010 quality characteristics) and decomposing it into OWL classes and subclasses without examining any data instances is TopDownDesign."@en .

kb:UnionMerge a owl:Class ;
    rdfs:label "Union Merge"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "DevOps and Continuous Delivery (Humble & Farley, 2010). Addison-Wesley."@en ;
    rdfs:comment "Simply combining all elements from source ontologies."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1>,
        <https://doi.org/10.1007/978-3-642-38721-0> ;
    rdfs:subClassOf kb:MergingStrategy ;
    skos:definition "A merging strategy that combines two ontologies by including all classes, properties, and axioms from both sources without conflict resolution, producing a comprehensive but potentially inconsistent merge."@en ;
    skos:example "Union of ontology A (100 classes) and B (50 classes) yields 150 classes."@en .

kb:UserGuideCreation a owl:Class ;
    rdfs:label "User Guide Creation"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Writing documentation for ontology users and application developers."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/> ;
    rdfs:subClassOf kb:ExternalDocumentation ;
    skos:definition "An external documentation activity that produces instructions for domain experts and application developers on how to navigate, query, and extend the ontology for their intended use cases."@en ;
    skos:example "Creating guide: 'How to Query the Vehicle Ontology with SPARQL'."@en .

kb:VModelOntologyDevelopment a owl:Class ;
    rdfs:label "V-Model Ontology Development"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "V-Model Ontology Development - adapts software methodology for ontology engineering."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:WaterfallMethodology ;
    skos:definition "A waterfall methodology variant that pairs each development phase with a corresponding testing phase, ensuring that acceptance tests are designed during requirements and unit tests during implementation."@en ;
    skos:example "Pairing each TBox design phase with a corresponding SHACL shape file (e.g., writing oqc_shacl_v1_1_0.ttl in parallel with oqc_v2_2_0.ttl) mirrors the V-Model's simultaneous development-and-testing approach."@en .

kb:VersionConcept a owl:Class ;
    rdfs:label "Version Concept"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Sprint F3 (2026-05-14): umbrella class implicit via subClassOf claims but never declared. Per BP-D2 + L-47v2: declared with full skos:definition to satisfy target class constraints."@en ;
    rdfs:comment "Umbrella class for versioning concepts — SemVerVersion, ReleaseCandidate, VersionToken, and other version-identification schemes. Captures versioning vocabulary at the conceptual level (distinct from the per-artifact owl:versionInfo / owl:versionIRI properties). Per Sprint F3."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:subClassOf kb:KnowledgeBaseConcept ;
    skos:definition "Umbrella class for versioning concepts — SemVerVersion, ReleaseCandidate, VersionToken, and other version-identification schemes. Captures versioning vocabulary at the conceptual level (distinct from the per-artifact owl:versionInfo / owl:versionIRI properties). Per Sprint F3."@en .

kb:VersioningPattern a owl:Class ;
    rdfs:label "VersioningPattern"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Sprint F6 (2026-05-15)."@en ;
    rdfs:comment "A pattern for ontology versioning — sub-pattern of EngineeringPattern. Per Sprint F6."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:subClassOf kb:EngineeringPattern,
        kb:KnowledgeBaseConcept ;
    skos:definition "A pattern for ontology versioning — sub-pattern of EngineeringPattern. Per Sprint F6."@en .

kb:VotingDecision a owl:Class ;
    rdfs:label "Voting Decision"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Decision made by majority vote."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.pmi.org/pmbok-guide-standards> ;
    rdfs:subClassOf kb:DecisionMakingProcess ;
    skos:definition "A decision-making process where team members cast votes on competing ontology design alternatives, with the option receiving the required majority being adopted as the design decision."@en ;
    skos:example "5 of 7 team members vote for Option A."@en .

kb:VotingResolution a owl:Class ;
    rdfs:label "Voting Resolution"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Semantic Web Services and Integration (Sheth et al., 2005). IEEE Internet Computing."@en ;
    rdfs:comment "Resolving conflicts by majority vote across sources."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-642-38721-0> ;
    rdfs:subClassOf kb:ConflictResolution ;
    skos:definition "A conflict resolution approach where team members vote to resolve ontology design disagreements, with the majority-supported option being adopted and documented with the vote rationale."@en ;
    skos:example "3 of 5 ontologies agree Car subclass Vehicle, so accepted."@en .

kb:WaterfallOntologyEngineering a owl:Class ;
    rdfs:label "Waterfall Ontology Engineering"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Waterfall Ontology Engineering - adapts software methodology for ontology engineering."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:WaterfallMethodology ;
    skos:definition "A waterfall methodology variant specifically adapted for ontology engineering, defining phases for requirements, conceptualization, formalization, implementation, testing, deployment, and maintenance in strict sequence."@en ;
    skos:example "First finalizing all competency questions, then writing all TBox axioms, then populating the ABox, and only then beginning SHACL validation — with no iteration allowed — exemplifies WaterfallOntologyEngineering."@en .

kb:WebPublication a owl:Class ;
    rdfs:label "Web Publication"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "DevOps and Continuous Delivery (Humble & Farley, 2010). Addison-Wesley."@en ;
    rdfs:comment "Publishing ontology on web server with HTTP access."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/> ;
    rdfs:subClassOf kb:Publication ;
    skos:definition "A publication activity that publishes the ontology to a web server as dereferenceable linked data, enabling HTTP-based access to ontology content through content negotiation and URI resolution."@en ;
    skos:example "Hosting ontology on Apache server with content negotiation for Turtle/RDF/XML."@en .

kb:appliesPattern a owl:ObjectProperty ;
    rdfs:label "appliesPattern"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Guarino, N., Oberle, D., Staab, S. (2009). What Is an Ontology? In: Handbook on Ontologies. Springer. ISO/IEC 42010:2011 Systems and software engineering — Architecture description."@en ;
    rdfs:domain kb:Activity ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:range kb:EngineeringPattern ;
    skos:definition "Relates an engineering activity to the design pattern it applies"@en .

kb:assignedTo a owl:ObjectProperty ;
    rdfs:label "assignedTo"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Guarino, N., Oberle, D., Staab, S. (2009). What Is an Ontology? In: Handbook on Ontologies. Springer. ISO/IEC 42010:2011 Systems and software engineering — Architecture description."@en ;
    rdfs:domain kb:Activity ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:range kb:StakeholderRole ;
    skos:definition "Relates an engineering activity to the stakeholder role responsible for it"@en .

kb:constrainedByArchitecture a owl:ObjectProperty ;
    rdfs:label "constrainedByArchitecture"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Guarino, N., Oberle, D., Staab, S. (2009). What Is an Ontology? In: Handbook on Ontologies. Springer. ISO/IEC 42010:2011 Systems and software engineering — Architecture description."@en ;
    rdfs:domain kb:Activity ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:range kb:ArchitecturalConcept ;
    skos:definition "Relates an activity to the architectural constraints that shape its execution"@en .

kb:followsMethodology a owl:ObjectProperty ;
    rdfs:label "followsMethodology"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Guarino, N., Oberle, D., Staab, S. (2009). What Is an Ontology? In: Handbook on Ontologies. Springer. ISO/IEC 42010:2011 Systems and software engineering — Architecture description."@en ;
    rdfs:domain kb:Activity ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:range kb:DevelopmentMethodology ;
    skos:definition "Relates an engineering activity to the development methodology it follows"@en .

kb:governs a owl:ObjectProperty ;
    rdfs:label "governs"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Guarino, N., Oberle, D., Staab, S. (2009). What Is an Ontology? In: Handbook on Ontologies. Springer. ISO/IEC 42010:2011 Systems and software engineering — Architecture description."@en ;
    rdfs:domain <http://example.org/core#Role> ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:range kb:Activity ;
    skos:definition "Relates a governance role or authority to the ontology engineering activities over which it has decision-making power and accountability for outcomes."@en .

kb:hasCompetencyQuestion a owl:ObjectProperty ;
    rdfs:label "has competency question"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Guarino, N., Oberle, D., Staab, S. (2009). What Is an Ontology? In: Handbook on Ontologies. Springer. ISO/IEC 42010:2011 Systems and software engineering — Architecture description."@en ;
    rdfs:domain kb:FunctionalRequirement ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:range <http://example.org/core#CompetencyQuestion> ;
    skos:definition "Associates a functional requirement with the competency questions that operationalize and verify it through query execution."@en .

kb:hasCurrentValue a owl:DatatypeProperty ;
    rdfs:label "hasCurrentValue"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    rdfs:domain kb:RoadmapPlan ;
    rdfs:range xsd:decimal ;
    skos:definition "Current value of the metric as of this release."@en .

kb:hasResponsibility a owl:ObjectProperty ;
    rdfs:label "has responsibility"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Guarino, N., Oberle, D., Staab, S. (2009). What Is an Ontology? In: Handbook on Ontologies. Springer. ISO/IEC 42010:2011 Systems and software engineering — Architecture description."@en ;
    rdfs:comment "Relates a role to activities it is responsible for."@en ;
    rdfs:domain <http://example.org/core#Role> ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:range kb:Activity ;
    skos:definition "A property that specifies which activities or tasks a role is accountable for completing."@en .

kb:hasResult a owl:ObjectProperty ;
    rdfs:label "has result"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Guarino, N., Oberle, D., Staab, S. (2009). What Is an Ontology? In: Handbook on Ontologies. Springer. ISO/IEC 42010:2011 Systems and software engineering — Architecture description."@en ;
    rdfs:comment "Relates an activity to its outcome or deliverable."@en ;
    rdfs:domain kb:Activity ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:range <http://example.org/core#Artifact> ;
    skos:definition "A property that connects an activity to the concrete result, artifact, or outcome it produces."@en ;
    skos:scopeNote "Range widened OntologyArtifact->core:Artifact (v20.23.6, PAMG-surfaced): the registration hook must accept ANY subject type (ontology, document, code), matching OEE_Component_Compliance_Strategy §3. Previously OntologyArtifact-typed, which wrongly blocked document/code registration and would mis-infer non-ontology subjects as OntologyArtifact."@en .

kb:hasStep a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has step"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Guarino, N., Oberle, D., Staab, S. (2009). What Is an Ontology? In: Handbook on Ontologies. Springer. ISO/IEC 42010:2011 Systems and software engineering — Architecture description."@en ;
    rdfs:comment "Relates a process to its constituent activities or sub-processes."@en ;
    rdfs:domain <http://example.org/core#Process> ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:range kb:Activity ;
    skos:definition "A property that decomposes a process into smaller activities or sub-processes that together accomplish the overall goal."@en .

kb:hasSteps a owl:DatatypeProperty ;
    rdfs:label "hasSteps"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    rdfs:domain kb:RoadmapPlan ;
    rdfs:range xsd:string ;
    skos:definition "Ordered, newline-separated description of plan steps."@en .

kb:hasTargetValue a owl:DatatypeProperty ;
    rdfs:label "hasTargetValue"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    rdfs:domain kb:RoadmapPlan ;
    rdfs:range xsd:decimal ;
    skos:definition "Target numeric value for the metric (e.g., 1.0 for 100%)."@en .

kb:hasTestCase a owl:ObjectProperty ;
    rdfs:label "has test case"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Sprint F4 (2026-05-14): property declared from raw usage analysis (domain/range inferred per BP-D2 from existing ABox patterns). Per L-47v2: full skos:definition included."@en ;
    rdfs:domain <http://example.org/quality#TestSuite> ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:range <http://example.org/quality#TestCase> ;
    skos:definition "Links a TestSuite to its constituent TestCase individuals. Per Sprint F4."@en .

kb:hasTestType a owl:DatatypeProperty ;
    rdfs:label "hasTestType"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    rdfs:domain kb:RegressionTest ;
    rdfs:range xsd:string ;
    skos:definition "The kind of test: \"sparql_ask\" / \"sparql_count\" / \"external_script\". "@en .

kb:hasVerificationQuery a owl:ObjectProperty ;
    rdfs:label "has verification query"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Sprint F4 (2026-05-14): property declared from raw usage analysis (domain/range inferred per BP-D2 from existing ABox patterns). Per L-47v2: full skos:definition included."@en ;
    rdfs:domain <http://example.org/core#CompetencyQuestion> ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:range kb:VerificationQuery ;
    skos:definition "Links a CompetencyQuestion to one or more VerificationQuery individuals (SPARQL queries) that operationalize the question. Per Sprint F4: 3 usages on CompetencyQuestion instances."@en .

kb:hasVersion a owl:DatatypeProperty ;
    rdfs:label "has version"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Sprint F4 (2026-05-14): property declared from raw usage analysis (domain/range inferred per BP-D2 from existing ABox patterns). Per L-47v2: full skos:definition included."@en ;
    rdfs:domain <http://example.org/quality#OntologyArtifact> ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:range xsd:string ;
    skos:definition "String form of the version of an ontology artifact (e.g., \"1.2.6\"). Distinct from owl:versionInfo (which lives on the ontology header); this property is for artifact-level versioning of specific OntologyArtifact instances. Per Sprint F4."@en .

kb:isAuthoredFromReleaseHistory a owl:DatatypeProperty ;
    rdfs:label "isAuthoredFromReleaseHistory"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "OE Pack v17.33.0 Option E — discipline marker for instances added by DT-Use Step 1."@en ;
    rdfs:range xsd:boolean ;
    skos:definition "Boolean marker: true if this individual was authored by OE Pack v17.33.0 from real release-history facts (release SHAs, sizes, benchmark measurements, etc.) rather than provided by an end user or imported from external sources. Per BP-D27-style discipline: distinguishability lets users mechanically filter out OE-Pack-self-instances vs. application-domain instances."@en .

kb:isOngoingEnhancementLineage a owl:DatatypeProperty ;
    rdfs:label "isOngoingEnhancementLineage"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "OE Pack v20.38.0 — BP-D51, minted for artifact-capability's ABox/TBox-pairing gap: real shape coverage exists (BP-D30 lightweight, not skeleton) but the level taxonomy an ABox would need is not yet decided (L-110), so populating now would encode incidental choices as though settled."@en ;
    rdfs:domain owl:Ontology ;
    rdfs:range xsd:boolean ;
    skos:definition "Boolean marker on an owl:Ontology declaration: true if the package's TBox/ABox pairing is deliberately, visibly incomplete under an ongoing enhancement lineage — not silently missing. DISTINCT from kb:isSkeletonShape (shape-level, marks a retired mechanical-coverage mechanism whose 0-count is itself the achieved success criterion, per Regression_Ecosystem_NoSkeletonShapes) and from meta:Abstract (class-level, marks a class never meant to have instances). This property is package-level and requires the package's own SHACL shapes to already be real (non-skeleton) coverage — it exempts ABox pairing only, never shape coverage itself."@en .

kb:isSkeletonShape a owl:DatatypeProperty ;
    rdfs:label "isSkeletonShape"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "OE Pack v17.32.0 Option B/D — discipline property per BP-D27."@en ;
    rdfs:domain sh:NodeShape ;
    rdfs:range xsd:boolean ;
    skos:definition "Boolean marker: true if this SHACL NodeShape is a scaffold-only skeleton (declares sh:targetClass but no property constraints). Distinguishes auto-generated mechanical-coverage shapes from semantic shapes. Per BP-D27, every skeleton shape generated by Roadmap_SHACL100Coverage Step 1 carries this property = true. Semantic upgrades in Step 2 remove the marker."@en .

kb:organizedBy a owl:ObjectProperty ;
    rdfs:label "organizedBy"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Guarino, N., Oberle, D., Staab, S. (2009). What Is an Ontology? In: Handbook on Ontologies. Springer. ISO/IEC 42010:2011 Systems and software engineering — Architecture description."@en ;
    rdfs:domain kb:Activity ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:range kb:TeamConcept ;
    skos:definition "Relates an engineering activity to the team or collaboration concept that organizes it"@en .

kb:performedBy a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "performed by"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Guarino, N., Oberle, D., Staab, S. (2009). What Is an Ontology? In: Handbook on Ontologies. Springer. ISO/IEC 42010:2011 Systems and software engineering — Architecture description."@en ;
    rdfs:comment "Relates an activity to the role or agent that executes it."@en ;
    rdfs:domain kb:Activity ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:range <http://example.org/core#Role>,
        kb:StakeholderRole ;
    skos:definition "A property that identifies which role, person, or automated agent is responsible for performing an activity."@en .

kb:targetsMetric a owl:DatatypeProperty ;
    rdfs:label "targetsMetric"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    rdfs:domain kb:RoadmapPlan ;
    rdfs:range xsd:string ;
    skos:definition "Name of the metric being targeted (string)."@en .

kb:toolVersion a owl:DatatypeProperty ;
    rdfs:label "tool version"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Sprint F4 (2026-05-14): property declared from raw usage analysis (domain/range inferred per BP-D2 from existing ABox patterns). Per L-47v2: full skos:definition included."@en ;
    rdfs:domain kb:EngineeringTool ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:range xsd:string ;
    skos:definition "String form of the version of an engineering tool (e.g., \"5.x\" for ProtegeEditor, \"1.5.x\" for Pellet). Captures tool-version annotation on tool instances. Per Sprint F4: 19 usages on ProtegeEditor, Pellet, HermiT, and other tool individuals."@en .

kb:triggersChange a owl:ObjectProperty ;
    rdfs:label "triggers change"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Guarino, N., Oberle, D., Staab, S. (2009). What Is an Ontology? In: Handbook on Ontologies. Springer. ISO/IEC 42010:2011 Systems and software engineering — Architecture description."@en ;
    rdfs:domain kb:Activity ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:range <http://example.org/configuration#ChangeOperation> ;
    skos:definition "Relates an ontology engineering activity to the change operation it initiates, establishing causal provenance for ontology evolution tracking."@en .

kb:usesTool a owl:ObjectProperty ;
    rdfs:label "usesTool"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Guarino, N., Oberle, D., Staab, S. (2009). What Is an Ontology? In: Handbook on Ontologies. Springer. ISO/IEC 42010:2011 Systems and software engineering — Architecture description."@en ;
    rdfs:domain kb:Activity ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:range kb:EngineeringTool ;
    skos:definition "Relates an engineering activity to the tool used to perform it"@en .

orh:belongsToSubject a owl:ObjectProperty ;
    rdfs:label "belongs to subject"@en ;
    dcterms:isPartOf <http://example.org/oepack-release-history> ;
    rdfs:domain orh:OntologyFile ;
    rdfs:isDefinedBy <http://example.org/oepack-release-history> ;
    rdfs:range orh:SubjectOntology ;
    skos:definition "Links a file to the SubjectOntology it serves."@en .

orh:containsFile a owl:ObjectProperty ;
    rdfs:label "contains file"@en ;
    dcterms:isPartOf <http://example.org/oepack-release-history> ;
    rdfs:domain orh:Bundle ;
    rdfs:isDefinedBy <http://example.org/oepack-release-history> ;
    rdfs:range orh:OntologyFile ;
    skos:definition "Links a Bundle to the OntologyFiles it contains."@en .

orh:facetRole a owl:DatatypeProperty ;
    rdfs:label "facetRole"@en ;
    dcterms:isPartOf <http://example.org/oepack-release-history> ;
    rdfs:domain orh:SubjectOntology ;
    rdfs:isDefinedBy <http://example.org/oepack-release-history> ;
    rdfs:range xsd:string ;
    skos:definition "How a component relates to this facet: \"registration\" (deposits its own data via a subject-link hook), \"conformance\" (must satisfy the facet's gate/conditions), \"both\" (registration AND conformance), or \"internal\" (ecosystem infrastructure; no registrant relationship)."@en .

orh:facetRoleStatus a owl:DatatypeProperty ;
    rdfs:label "facetRoleStatus"@en ;
    dcterms:isPartOf <http://example.org/oepack-release-history> ;
    rdfs:domain orh:SubjectOntology ;
    rdfs:isDefinedBy <http://example.org/oepack-release-history> ;
    rdfs:range xsd:string ;
    skos:definition "Implementation maturity of the declared facetRole: \"operational\" (hooks/gates built and validating), \"partial\" (some hooks/gates present, others missing), \"intended\" (role agreed but not yet built), or \"na\" (internal facets)."@en .

orh:hasFileSHA256 a owl:DatatypeProperty ;
    rdfs:label "has file SHA-256"@en ;
    dcterms:isPartOf <http://example.org/oepack-release-history> ;
    rdfs:domain orh:OntologyFile ;
    rdfs:isDefinedBy <http://example.org/oepack-release-history> ;
    rdfs:range xsd:string ;
    skos:definition "SHA-256 hash of the TTL file content."@en .

orh:hasReleaseDate a owl:DatatypeProperty ;
    rdfs:label "has release date"@en ;
    dcterms:isPartOf <http://example.org/oepack-release-history> ;
    rdfs:domain orh:ReleaseEvent ;
    rdfs:isDefinedBy <http://example.org/oepack-release-history> ;
    rdfs:range xsd:dateTime ;
    skos:definition "Date on which the release event occurred."@en .

orh:hasVersionInfo a owl:DatatypeProperty ;
    rdfs:label "has version info"@en ;
    dcterms:isPartOf <http://example.org/oepack-release-history> ;
    rdfs:domain orh:OntologyFile ;
    rdfs:isDefinedBy <http://example.org/oepack-release-history> ;
    rdfs:range xsd:string ;
    skos:definition "SemVer version string of the file's subject ontology at this release."@en .

orh:lifecycleStatus a owl:DatatypeProperty ;
    rdfs:label "lifecycle status"@en ;
    dcterms:isPartOf <http://example.org/oepack-release-history> ;
    rdfs:domain orh:SubjectOntology ;
    rdfs:isDefinedBy <http://example.org/oepack-release-history> ;
    rdfs:range xsd:string ;
    skos:definition "Lifecycle state of a SubjectOntology: \"active\" (live, on-disk, current) or \"retired\" (renamed/absorbed into a successor; no live files). Derived from and consistent with the file-level Supersession records."@en .

orh:performedAtStep a owl:ObjectProperty ;
    rdfs:label "performed at step"@en ;
    dcterms:isPartOf <http://example.org/oepack-release-history> ;
    rdfs:isDefinedBy <http://example.org/oepack-release-history> ;
    rdfs:range orh:ConsolidationStep ;
    skos:definition "Links a Supersession to the ConsolidationStep at which it was applied."@en .

orh:priorVersion a owl:ObjectProperty ;
    rdfs:label "prior version"@en ;
    dcterms:isPartOf <http://example.org/oepack-release-history> ;
    rdfs:domain orh:OntologyFile ;
    rdfs:isDefinedBy <http://example.org/oepack-release-history> ;
    rdfs:range orh:OntologyFile ;
    skos:definition "Links a file to its previous version (same subject, lower SemVer)."@en .

orh:shipsBundle a owl:ObjectProperty ;
    rdfs:label "ships bundle"@en ;
    dcterms:isPartOf <http://example.org/oepack-release-history> ;
    rdfs:domain orh:ConsolidationStep ;
    rdfs:isDefinedBy <http://example.org/oepack-release-history> ;
    rdfs:range orh:Bundle ;
    skos:definition "Links a ConsolidationStep to the Bundle it shipped."@en .

orh:supersededBySubject a owl:ObjectProperty ;
    rdfs:label "superseded by subject"@en ;
    dcterms:isPartOf <http://example.org/oepack-release-history> ;
    rdfs:domain orh:SubjectOntology ;
    rdfs:isDefinedBy <http://example.org/oepack-release-history> ;
    rdfs:range orh:SubjectOntology ;
    skos:definition "Links a retired SubjectOntology to the live SubjectOntology that renamed/absorbed it (subject-level analogue of file-level supersedes)."@en .

kb:ArchitecturalConcept a owl:Class ;
    rdfs:label "Architectural  Concept"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Sprint F5 (2026-05-15)."@en ;
    rdfs:comment "A concept relating to the architecture of an ontology — distinct from a domain concept; covers structural patterns, layers, views. Per Sprint F5."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:subClassOf kb:KnowledgeBaseConcept ;
    skos:definition "A concept relating to the architecture of an ontology — distinct from a domain concept; covers structural patterns, layers, views. Per Sprint F5."@en .

kb:AsynchronousCollaboration a owl:Class ;
    rdfs:label "Asynchronous Collaboration"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology Engineering in Collaborative and Distributed Environments (Tudorache et al., 2013). Semantic Web Journal."@en ;
    rdfs:comment "Team members contribute at different times."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:CollaborationPattern ;
    owl:disjointWith kb:MobModeling,
        kb:PairModeling,
        kb:SynchronousCollaboration ;
    skos:definition "A collaboration pattern where ontology contributors work independently at different times, submitting changes for review and merging them through a version control workflow with explicit conflict resolution."@en ;
    skos:example "Team uses GitHub for asynchronous ontology development."@en .

kb:BugFixing a owl:Class ;
    rdfs:label "Bug Fixing"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Correcting errors and defects in ontology."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:MaintenanceActivity ;
    owl:disjointWith kb:FeatureToggle,
        kb:HotfixDeployment,
        kb:PatchDeployment ;
    skos:definition "A maintenance activity that identifies and corrects specific errors in the ontology such as incorrect axioms, misclassified individuals, missing constraints, or broken import references that cause incorrect reasoning outcomes."@en ;
    skos:example "Fixing error where Car was incorrectly marked disjoint with Vehicle."@en .

kb:CanaryDeployment a owl:Class ;
    rdfs:label "Canary Deployment"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "DevOps and Continuous Delivery (Humble & Farley, 2010). Addison-Wesley."@en ;
    rdfs:comment "Canary Deployment - strategy for releasing ontology versions."@en,
        "Gradual rollout to subset of users."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:DeploymentActivity,
        kb:DeploymentPattern ;
    owl:disjointWith kb:ContinuousDeployment,
        kb:Integration,
        kb:Publication,
        kb:RollbackDeployment ;
    skos:definition "A deployment pattern that routes a small percentage of consumer traffic to the new ontology version while monitoring for errors, gradually increasing exposure only after stability metrics are confirmed."@en ;
    skos:example "Canary release to 5% of users first."@en .

kb:DocumentationComponent a owl:Class ;
    rdfs:label "Documentation Component"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Components dedicated to documenting and annotating ontology elements for human understanding."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/>,
        <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:Activity,
        <http://example.org/quality#OntologyComponent> ;
    skos:definition "A structural element of ontology documentation such as a glossary section, architecture diagram, usage example, or change history entry that contributes to the overall documentation package."@en ;
    skos:example "The version history table in ontology_ecosystem_architecture_v1_4.md, listing every sprint, date, and change summary, is a DocumentationComponent of the OE package."@en .

kb:ExpertConsultation a owl:Class ;
    rdfs:label "Expert Consultation"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "NeOn Methodology (Suárez-Figueroa et al., 2012). NeOn Methodology for Building Ontology Networks, IOS Press."@en ;
    rdfs:comment "Engaging domain experts to gather knowledge and validate understanding."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:DomainAnalysis ;
    owl:disjointWith kb:LiteratureReview,
        kb:RelationshipIdentification ;
    skos:definition "A domain analysis technique that engages subject matter specialists in structured elicitation sessions to capture expert knowledge, resolve ambiguities in domain semantics, and validate preliminary conceptual models."@en ;
    skos:example "Interviewing three automotive engineers to understand vehicle classification."@en .

kb:FeatureToggle a owl:Class ;
    rdfs:label "Feature Toggle"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "DevOps and Continuous Delivery (Humble & Farley, 2010). Addison-Wesley."@en ;
    rdfs:comment "Enabling/disabling features without deployment."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:MaintenanceActivity ;
    owl:disjointWith kb:HotfixDeployment,
        kb:PatchDeployment ;
    skos:definition "A deployment pattern that wraps new ontology features behind runtime-configurable flags, allowing selective activation or deactivation of specific capabilities without requiring a full redeployment."@en ;
    skos:example "Feature flag controls new reasoning algorithm."@en .

kb:FormalCommunication a owl:Class ;
    rdfs:label "Formal Communication"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Official documented communication."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:CommunicationChannel ;
    skos:definition "A communication channel that follows documented procedures, produces recorded outputs, and uses structured formats such as meeting minutes, technical specifications, or review reports for governance-traceable exchange."@en ;
    skos:example "Weekly status meetings with documented minutes."@en .

kb:FunctionalRequirement a owl:Class ;
    rdfs:label "Functional Requirement"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "IEEE 830-1998 - Recommended Practice for Software Requirements Specifications",
        "IEEE 830-1998 Recommended Practice for Software Requirements Specifications."@en ;
    rdfs:comment "Definition authored during a reliability ontology remediation 2026-02-09; pending domain expert review."@en,
        "Local proxy class equivalent to http://example.org/knowledge-base#FunctionalRequirement."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf [ ],
        kb:RequirementsAnalysis,
        <http://example.org/quality#QualityConcept> ;
    skos:definition "A formal statement specifying a capability or behavior that the ontology must support, typically verified through associated competency questions and test cases."@en ;
    skos:example "FR-01: 'The pySHACL validation pipeline MUST report Conforms=True for all five framework ontologies when validated against redo_shacl_v2_0_6.ttl' is a FunctionalRequirement for the OE remediation sprint."@en,
        "FR-045 'The ontology shall support querying requirements by status' — verified through CQ-045 and TestCase_CQ_045."@en .

kb:HierarchicalGovernance a owl:Class ;
    rdfs:label "Hierarchical Governance"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Decisions made by designated authorities."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/50508.html> ;
    rdfs:subClassOf kb:GovernanceModel ;
    owl:disjointWith kb:MeritocracyGovernance ;
    skos:definition "A governance model where ontology design decisions flow through a defined authority chain, with senior roles holding approval power over changes proposed by subordinate contributors."@en ;
    skos:example "Technical lead has final say on design decisions."@en .

kb:InformalCommunication a owl:Class ;
    rdfs:label "Informal Communication"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Ad-hoc unrecorded exchanges."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:CommunicationChannel ;
    skos:definition "A communication channel that supports spontaneous, unstructured information exchange among team members, such as instant messaging, casual conversations, or ad-hoc discussions for rapid coordination."@en ;
    skos:example "Hallway conversations about modeling questions."@en .

kb:IntegrationApplication a owl:Class ;
    rdfs:label "IntegrationApplication"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Sprint F6 (2026-05-15)."@en ;
    rdfs:comment "Integration of ontologies into applications. Per Sprint F6."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:subClassOf kb:Application,
        kb:KnowledgeBaseConcept ;
    skos:definition "Integration of ontologies into applications. Per Sprint F6."@en .

kb:KanbanOntologyFlow a owl:Class ;
    rdfs:label "Kanban Ontology Flow"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Kanban Ontology Flow - adapts software methodology for ontology engineering."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:AgileMethodology ;
    owl:disjointWith kb:ScrumOntologyDevelopment ;
    skos:definition "An agile methodology applying kanban workflow management to ontology development, visualizing work items as they flow through modeling stages with explicit work-in-progress limits at each stage."@en ;
    skos:example "A Kanban board with columns 'Backlog', 'In Review', 'SHACL Validated', and 'Delivered' used to track the status of each ontology class annotation task across the OWB enhancement sprint is KanbanOntologyFlow."@en .

kb:Linking a owl:Class ;
    rdfs:label "Linking"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Sprint F6 (2026-05-15)."@en ;
    rdfs:comment "An ontology-linking activity — alignment, mapping, or cross-references. Per Sprint F6."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:subClassOf kb:KnowledgeBaseConcept ;
    skos:definition "An ontology-linking activity — alignment, mapping, or cross-references. Per Sprint F6."@en .

kb:LinkingStrategy a owl:Class ;
    rdfs:label "Linking Strategy"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Approach to connecting ontology instances to external data."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-642-38721-0>,
        <https://www.w3.org/DesignIssues/LinkedData.html> ;
    rdfs:subClassOf kb:Activity,
        kb:Linking ;
    skos:definition "A technique for establishing connections between ontology elements and external resources such as databases, web resources, or other knowledge bases, enabling cross-system semantic interoperability."@en ;
    skos:example "Linking vehicle instances to DBpedia resources via owl:sameAs."@en .

kb:ManualMapping a owl:Class ;
    rdfs:label "Manual Mapping"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Human-created correspondences between ontology elements."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-642-38721-0> ;
    rdfs:subClassOf kb:MappingTechnique ;
    owl:disjointWith <http://example.org/meta#ManyToManyMapping>,
        <http://example.org/meta#ManyToOneMapping>,
        <http://example.org/meta#OneToManyMapping>,
        <http://example.org/meta#OneToOneMapping> ;
    skos:definition "A mapping technique where domain experts manually specify correspondences between ontology elements, providing highest accuracy for critical alignments but limited by human throughput and scalability constraints."@en ;
    skos:example "Domain expert maps 'Vehicle' concepts after analyzing both ontologies."@en .

kb:Mentoring a owl:Class ;
    rdfs:label "Mentoring"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology Engineering in Collaborative and Distributed Environments (Tudorache et al., 2013). Semantic Web Journal."@en ;
    rdfs:comment "One-on-one knowledge transfer."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:KnowledgeSharingMechanism ;
    owl:disjointWith kb:Training ;
    skos:definition "A knowledge sharing mechanism that pairs experienced ontology engineers with less experienced team members for guided skill development through direct collaboration, feedback, and knowledge transfer."@en ;
    skos:example "Senior engineer mentors junior on ontology patterns."@en .

kb:MobModeling a owl:Class ;
    rdfs:label "Mob Modeling"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Group of people collaboratively designing together."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:CollaborationPattern ;
    owl:disjointWith kb:PairModeling,
        kb:SynchronousCollaboration ;
    skos:definition "A collaboration pattern where the entire ontology team works together on a single modeling task simultaneously, with one person operating the editing tool while others contribute design suggestions verbally."@en ;
    skos:example "5 people mob model complex automotive concepts."@en .

kb:Modularization a owl:Class ;
    rdfs:label "Modularization"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Sprint F6 (2026-05-15)."@en ;
    rdfs:comment "Ontology modularization activity. Per Sprint F6."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:subClassOf kb:KnowledgeBaseConcept ;
    skos:definition "Ontology modularization activity. Per Sprint F6."@en .

kb:PartialRegression a owl:Class ;
    rdfs:label "Partial Regression Test"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Partial Regression Test - verifies existing functionality after changes."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2008.4578383>,
        <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf kb:DevelopmentProcess ;
    owl:disjointWith kb:RiskBasedRegression ;
    skos:definition "A regression test execution that runs only test cases related to modified ontology elements and their immediate dependencies, providing faster feedback with accepted risk of missing distant side effects."@en ;
    skos:example "Re-running only the a reliability ontology-related tests (T4 mutation + a reliability ontology vs redo_shacl + a reliability ontology vs meta_shacl) after patching redo_v2_5_6.ttl is a PartialRegression targeting the changed file."@en .

kb:PeerReview a owl:Class ;
    rdfs:label "Peer Review"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology Engineering in Collaborative and Distributed Environments (Tudorache et al., 2013). Semantic Web Journal."@en ;
    rdfs:comment "Expert evaluation by ontology engineering peers."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:InspectionTechnique ;
    owl:disjointWith kb:WalkthroughTechnique ;
    skos:definition "A collaboration pattern where ontology changes are reviewed by one or more team members before acceptance, checking for correctness, consistency with design principles, and documentation completeness."@en ;
    skos:example "A colleague reads every skos:definition in oqc_v2_2_1.ttl to verify that none is tautological (label ≈ definition) before the sprint closes — this is a PeerReview of ontology annotation quality."@en .

kb:ProcessConflict a owl:Class ;
    rdfs:label "Process Conflict"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology Engineering in Collaborative and Distributed Environments (Tudorache et al., 2013). Semantic Web Journal."@en ;
    rdfs:comment "Disagreement on work processes."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:ConflictType ;
    owl:disjointWith kb:TechnicalConflict ;
    skos:definition "A conflict type where team members disagree on the ontology development process, methodology, or workflow, such as conflicting views on review procedures, tool choices, or iteration planning."@en ;
    skos:example "Conflict over waterfall vs agile approach."@en .

kb:Prototyping a owl:Class ;
    rdfs:label "Prototyping"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Sprint F6 (2026-05-15)."@en ;
    rdfs:comment "A prototyping-based development methodology. Sub-pattern of DevelopmentMethodology. Per Sprint F6."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:subClassOf kb:DevelopmentMethodology,
        kb:KnowledgeBaseConcept ;
    skos:definition "A prototyping-based development methodology. Sub-pattern of DevelopmentMethodology. Per Sprint F6."@en .

kb:Reasoning a owl:Class ;
    rdfs:label "Reasoning"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Sprint F6 (2026-05-15)."@en ;
    rdfs:comment "A reasoning task or capability. Per Sprint F6."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:subClassOf kb:KnowledgeBaseConcept ;
    skos:definition "A reasoning task or capability. Per Sprint F6."@en .

kb:RetrospectiveMeeting a owl:Class ;
    rdfs:label "Retrospective Meeting"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology Engineering in Collaborative and Distributed Environments (Tudorache et al., 2013). Semantic Web Journal."@en ;
    rdfs:comment "Meeting reflecting on process improvement."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://scrumguides.org/scrum-guide.html> ;
    rdfs:subClassOf kb:MeetingType ;
    owl:disjointWith kb:StatusMeeting,
        kb:WorkshopMeeting ;
    skos:definition "A meeting held after completing an iteration where the team identifies ontology engineering practices that worked well, practices needing improvement, and specific action items for the next iteration."@en ;
    skos:example "Retrospective meeting improves modeling process."@en .

kb:ReusabilityAnalysis a owl:Class ;
    rdfs:label "Reusability Analysis"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Evaluating existing ontologies for potential reuse in current project."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:AnalysisActivity ;
    skos:definition "An analysis activity that evaluates existing ontologies for potential reuse in a new project, assessing their coverage, quality, licensing, and compatibility with the project's requirements."@en ;
    skos:example "Evaluating DBpedia and Schema.org for reusable vehicle concepts."@en .

kb:ScheduleCoordination a owl:Class ;
    rdfs:label "Schedule Coordination"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology Engineering in Collaborative and Distributed Environments (Tudorache et al., 2013). Semantic Web Journal."@en ;
    rdfs:comment "Aligning timing of activities."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:CoordinationMechanism ;
    owl:disjointWith kb:TaskCoordination ;
    skos:definition "A coordination mechanism that synchronizes the timelines of interdependent ontology development tasks, ensuring that upstream deliverables are available when downstream tasks are scheduled to begin."@en ;
    skos:example "Shared calendar coordinates availability."@en .

kb:SchedulePlanning a owl:Class ;
    rdfs:label "Schedule Planning"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Defining timeline, milestones, and dependencies for project activities."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:PlanningActivity ;
    skos:definition "A planning activity that establishes a timeline of milestones, deliverables, and task dependencies for the ontology engineering project, balancing parallel work streams against sequential dependencies."@en ;
    skos:example "Planning 12-week schedule: weeks 1-3 requirements, 4-8 modeling, 9-12 testing."@en .

kb:SpikeLoad a owl:Class ;
    rdfs:label "Spike Load Test"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Spike Load Test - evaluates performance under specific load patterns."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2008.4578383>,
        <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf kb:DevelopmentProcess ;
    owl:disjointWith kb:SteadyStateLoad ;
    skos:definition "A load test variant that applies a sudden, large increase in query volume to test the ontology system's response to burst traffic patterns, evaluating both immediate handling and recovery behavior."@en ;
    skos:example "Sending 500 simultaneous SPARQL requests to the OE SPARQL endpoint immediately after a production release, to test whether the server handles sudden traffic bursts without timeout, is SpikeLoad testing."@en .

kb:SpiralMethodology a owl:Class ;
    rdfs:label "Spiral Methodology"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Risk-driven iterative approach."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:PrescriptiveMethodology ;
    skos:definition "A prescriptive methodology that organizes ontology development into iterative cycles through planning, risk analysis, engineering, and evaluation phases, with each cycle reducing project risk."@en ;
    skos:example "Spiral model with risk assessment at each iteration."@en .

kb:VerificationQuery a owl:Class ;
    rdfs:label "Verification Query"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Sprint F5 (2026-05-15): declared from 3 ABox type assertions + 1 range."@en ;
    rdfs:comment "A query (typically SPARQL) that operationalizes a CompetencyQuestion — when executed against an ontology, it answers whether the ontology meets that competency question's requirement. Per Sprint F4: linked from CompetencyQuestion via kb:hasVerificationQuery. Per Sprint F5: 3 existing ABox individuals plus the F4 range declaration heal upon this class's declaration."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:subClassOf kb:KnowledgeBaseConcept ;
    skos:definition "A query (typically SPARQL) that operationalizes a CompetencyQuestion — when executed against an ontology, it answers whether the ontology meets that competency question's requirement. Per Sprint F4: linked from CompetencyQuestion via kb:hasVerificationQuery. Per Sprint F5: 3 existing ABox individuals plus the F4 range declaration heal upon this class's declaration."@en .

kb:hasCheckSPARQL a owl:DatatypeProperty ;
    rdfs:label "hasCheckSPARQL"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    rdfs:domain kb:RegressionTest ;
    rdfs:range xsd:string ;
    skos:definition "The SPARQL ASK or SELECT query that, when executed against the ecosystem graph, returns the boolean or value to compare against hasExpectedResult."@en .

kb:hasExpectedResult a owl:DatatypeProperty ;
    rdfs:label "hasExpectedResult"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    rdfs:domain kb:RegressionTest ;
    rdfs:range xsd:string ;
    skos:definition "The expected outcome of running hasCheckSPARQL or the named test script. For ASK queries, \"true\" or \"false\". For SELECT-COUNT queries, the integer threshold."@en .

kb:isRequiredBy a owl:ObjectProperty ;
    rdfs:label "is required by"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Guarino, N., Oberle, D., Staab, S. (2009). What Is an Ontology? In: Handbook on Ontologies. Springer. ISO/IEC 42010:2011 Systems and software engineering — Architecture description."@en ;
    rdfs:domain <http://example.org/quality#OntologyArtifact> ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:range kb:Activity ;
    owl:inverseOf kb:requires ;
    skos:definition "Relates an ontology artifact to an activity that depends on it as a precondition, indicating the artifact must be available before the activity can proceed."@en .

kb:isTransformedBy a owl:ObjectProperty ;
    rdfs:label "is transformed by"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Guarino, N., Oberle, D., Staab, S. (2009). What Is an Ontology? In: Handbook on Ontologies. Springer. ISO/IEC 42010:2011 Systems and software engineering — Architecture description."@en ;
    rdfs:domain <http://example.org/quality#OntologyArtifact> ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:range kb:Activity ;
    owl:inverseOf kb:transforms ;
    skos:definition "Relates an ontology artifact to the engineering activity that modifies its structure, content, or representation format."@en .

kb:requires a owl:ObjectProperty ;
    rdfs:label "requires"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Guarino, N., Oberle, D., Staab, S. (2009). What Is an Ontology? In: Handbook on Ontologies. Springer. ISO/IEC 42010:2011 Systems and software engineering — Architecture description."@en ;
    rdfs:domain kb:Activity ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:range <http://example.org/quality#OntologyArtifact> ;
    owl:inverseOf kb:isRequiredBy ;
    skos:definition "Relates an ontology engineering activity to an artifact that must exist or be available as a precondition for the activity to begin execution."@en .

kb:transforms a owl:ObjectProperty ;
    rdfs:label "transforms"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Guarino, N., Oberle, D., Staab, S. (2009). What Is an Ontology? In: Handbook on Ontologies. Springer. ISO/IEC 42010:2011 Systems and software engineering — Architecture description."@en ;
    rdfs:domain kb:Activity ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:range <http://example.org/quality#OntologyArtifact> ;
    owl:inverseOf kb:isTransformedBy ;
    skos:definition "Relates an ontology engineering activity to the artifact whose structure, content, or representation format it modifies as its primary output."@en .

orh:ReleaseEvent a owl:Class ;
    rdfs:label "Release Event"@en ;
    dcterms:isPartOf <http://example.org/oepack-release-history> ;
    rdfs:isDefinedBy <http://example.org/oepack-release-history> ;
    skos:definition "An event in which a Bundle was shipped, marking the completion of a ConsolidationStep."@en .

orh:hasBundleSHA256 a owl:DatatypeProperty ;
    rdfs:label "has bundle SHA-256"@en ;
    dcterms:isPartOf <http://example.org/oepack-release-history> ;
    rdfs:domain orh:Bundle ;
    rdfs:isDefinedBy <http://example.org/oepack-release-history> ;
    rdfs:range xsd:string ;
    skos:definition "SHA-256 hash of the bundle ZIP."@en .

orh:hasStepNumber a owl:DatatypeProperty ;
    rdfs:label "has step number"@en ;
    dcterms:isPartOf <http://example.org/oepack-release-history> ;
    rdfs:domain orh:ConsolidationStep ;
    rdfs:isDefinedBy <http://example.org/oepack-release-history> ;
    rdfs:range xsd:string ;
    skos:definition "Numeric or alphanumeric step identifier (e.g., '1', '10b', '14')."@en .

orh:supersededFile a owl:ObjectProperty ;
    rdfs:label "superseded file"@en ;
    dcterms:isPartOf <http://example.org/oepack-release-history> ;
    rdfs:domain orh:Supersession ;
    rdfs:isDefinedBy <http://example.org/oepack-release-history> ;
    rdfs:range orh:OntologyFile ;
    skos:definition "Links a Supersession to the old (retired) file."@en .

orh:supersedes a owl:ObjectProperty ;
    rdfs:label "supersedes"@en ;
    dcterms:isPartOf <http://example.org/oepack-release-history> ;
    rdfs:domain orh:Supersession ;
    rdfs:isDefinedBy <http://example.org/oepack-release-history> ;
    rdfs:range orh:OntologyFile ;
    skos:definition "Links a Supersession to the new (replacement) file."@en .

kb:Annotation a owl:Class ;
    rdfs:label "Annotation"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Adding metadata, labels, comments, and descriptions to ontology elements."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/> ;
    rdfs:subClassOf kb:DocumentationActivity,
        kb:DocumentationComponent ;
    skos:definition "A documentation activity that adds human-readable metadata such as labels, definitions, comments, and examples to ontology elements, enriching the formal model with information needed for human comprehension and reuse."@en ;
    skos:example "Adding rdfs:comment explaining purpose and usage of each class."@en .

kb:Application a owl:Class ;
    rdfs:label "Application"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Sprint F6 (2026-05-15)."@en ;
    rdfs:comment "An application of an ontology to a use case. Per Sprint F6."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:subClassOf kb:KnowledgeBaseConcept ;
    skos:definition "An application of an ontology to a use case. Per Sprint F6."@en .

kb:AutomaticModularization a owl:Class ;
    rdfs:label "Automatic Modularization"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Algorithm-based ontology partitioning."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:ModularizationTechnique ;
    skos:definition "A modularization technique that uses algorithms to partition the ontology into modules based on structural analysis, dependency graphs, or topic clustering without requiring manual boundary specification."@en ;
    skos:example "Signature-based extraction isolates 50-class Vehicle module."@en .

kb:CommunicationChannel a owl:Class ;
    rdfs:label "Communication Channel"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Medium for team information exchange."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:Collaboration,
        kb:TeamConcept ;
    skos:definition "A medium through which ontology engineering team members exchange information, decisions, and feedback, classified by formality level and synchronicity to support different coordination needs."@en ;
    skos:example "Team uses Slack for daily communication."@en .

kb:ConceptualModeling a owl:Class ;
    rdfs:label "Conceptual Modeling"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Creating informal or semi-formal conceptual representation of domain."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:DesignActivity ;
    skos:definition "A design activity that creates an abstract representation of domain concepts and their relationships before formal axiomatization, using diagrams, natural language, or semi-formal notations."@en ;
    skos:example "Drawing concept map showing relationships between Vehicle, Engine, and Fuel concepts."@en .

kb:ContinuousDeployment a owl:Class ;
    rdfs:label "Continuous Deployment"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "DevOps and Continuous Delivery (Humble & Farley, 2010). Addison-Wesley."@en ;
    rdfs:comment "Automated deployment on every change."@en,
        "Continuous Deployment - strategy for releasing ontology versions."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:DeploymentActivity,
        kb:DeploymentPattern ;
    owl:disjointWith kb:Integration,
        kb:Publication,
        kb:RollbackDeployment ;
    skos:definition "A deployment activity practice that automatically deploys ontology changes to production after they pass all automated quality gates, minimizing the delay between development completion and availability."@en ;
    skos:example "GitHub Actions deploys on merge to main."@en .

kb:DesignActivity a owl:Class ;
    rdfs:label "Design Activity"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Activity creating conceptual models and ontology specifications."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:Activity ;
    skos:definition "An ontology engineering activity focused on making architectural and modeling decisions about how domain concepts will be formally represented, including hierarchy structure, property selection, and axiom patterns."@en ;
    skos:example "Creating class hierarchy for vehicle taxonomy is a design activity."@en .

kb:DocumentationActivity a owl:Class ;
    rdfs:label "Documentation Activity"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Activity creating supporting documentation for ontology."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:Activity ;
    skos:definition "An ontology engineering activity focused on creating and maintaining human-readable descriptions of the ontology's design rationale, usage instructions, change history, and governance procedures."@en ;
    skos:example "Writing ontology usage guide is a documentation activity."@en .

kb:Encoding a owl:Class ;
    rdfs:label "Encoding"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Translating ontology model into formal ontology language syntax."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:ImplementationActivity ;
    skos:definition "An implementation activity that translates formalized ontology designs into a specific ontology language and serialization format, producing parseable ontology files ready for loading into tools and triple stores."@en ;
    skos:example "Encoding Vehicle taxonomy as OWL classes with rdfs:subClassOf axioms."@en .

kb:EngineeringTool a owl:Class ;
    rdfs:label "Engineering Tool"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Sprint F3 (2026-05-14): umbrella class implicit via subClassOf claims but never declared. Per BP-D2 + L-47v2: declared with full skos:definition to satisfy target class constraints."@en ;
    rdfs:comment "Umbrella class for tool categories used in ontology engineering — CommandLineTool, LibraryTool, PluginTool, IDETool, and other tool classifications. Each subclass groups concrete tools (e.g., Protégé, TopBraidComposerME) by their interface mode. Per Sprint F3: 7 children claimed subClassOf; umbrella now declared."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:subClassOf kb:KnowledgeBaseConcept ;
    skos:definition "Umbrella class for tool categories used in ontology engineering — CommandLineTool, LibraryTool, PluginTool, IDETool, and other tool classifications. Each subclass groups concrete tools (e.g., Protégé, TopBraidComposerME) by their interface mode. Per Sprint F3: 7 children claimed subClassOf; umbrella now declared."@en .

kb:EntityLinking a owl:Class ;
    rdfs:label "Entity Linking"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Connecting ontology instances to knowledge base entities."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.w3.org/DesignIssues/LinkedData.html> ;
    rdfs:subClassOf kb:LinkingStrategy ;
    skos:definition "A linking strategy that connects references to entities in unstructured text or data to their corresponding ontology individuals or classes, establishing grounded semantic connections to formal representations."@en ;
    skos:example "Linking 'Tesla_Model_3' instance to dbr:Tesla_Model_3."@en .

kb:ExternalDocumentation a owl:Class ;
    rdfs:label "External Documentation"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Creating separate documents describing ontology usage and design."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/> ;
    rdfs:subClassOf kb:DocumentationActivity ;
    skos:definition "A documentation activity that creates standalone documents outside the ontology file, such as user guides, technical specifications, and design rationale reports, complementing the inline annotations."@en ;
    skos:example "Writing 20-page user manual explaining ontology structure and queries."@en .

kb:FormalSpecification a owl:Class ;
    rdfs:label "Formal Specification"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Encoding ontology in formal logical language like OWL."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:DesignActivity ;
    skos:definition "A design activity that translates informal domain models into precise logical expressions using an ontology language, creating unambiguous class definitions, property assertions, and constraint axioms."@en ;
    skos:example "Encoding Vehicle class with OWL restrictions: hasEngine exactly 1."@en .

kb:FormatConversion a owl:Class ;
    rdfs:label "Format Conversion"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Process of translating between ontology serializations."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html>,
        <https://www.w3.org/TR/rdf11-concepts/> ;
    rdfs:subClassOf kb:Activity,
        owl:Thing ;
    skos:definition "A process that transforms an ontology from one serialization format to another while preserving all triples and annotations, enabling tool compatibility and optimizing for specific processing requirements."@en ;
    skos:example "Converting RDF/XML to Turtle for readability."@en .

kb:HotfixDeployment a owl:Class ;
    rdfs:label "Hotfix Deployment"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Emergency fix deployed directly to production."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:MaintenanceActivity ;
    owl:disjointWith kb:PatchDeployment ;
    skos:definition "A maintenance activity that deploys an emergency ontology correction directly to production outside the normal release cycle, addressing critical defects that cannot wait for the next scheduled release."@en ;
    skos:example "Hotfix deployed outside release schedule."@en .

kb:ImplementationActivity a owl:Class ;
    rdfs:label "Implementation Activity"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Activity encoding and serializing ontology in target format."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:Activity ;
    skos:definition "An ontology engineering activity that encodes formalized axioms into a specific ontology language and serialization format, producing executable ontology files that can be loaded into tools and reasoners."@en ;
    skos:example "Creating vehicle-ontology.owl file in OWL/XML syntax is implementation activity."@en .

kb:LessonsLearned a owl:Class ;
    rdfs:label "Lessons Learned"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Canonical class consolidating kb:LessonLearned (singular) and kb:Lesson. Idiomatic plural form adopted per modeling decision 2026-05-28; flat model (each lesson is a direct instance, no part-whole aggregate, no separate unit class). Lineage: migrated from rev:LessonLearned and redo:LessonsLearned."@en ;
    rdfs:comment "An empirical finding from an engineering session or work-package, preserved as durable knowledge. Lessons describe what went wrong (or was discovered) and motivate BestPractices — a recurring lesson becomes a discipline rule."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:subClassOf kb:KnowledgeBaseConcept ;
    skos:definition "An empirical finding from an engineering session or work-package, preserved as durable knowledge. Lessons describe what went wrong (or was discovered) and motivate BestPractices — a recurring lesson becomes a discipline rule."@en .

kb:LogicalValidation a owl:Class ;
    rdfs:label "Logical Validation"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Checking logical consistency and satisfiability using reasoners."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf kb:ValidationActivity ;
    skos:definition "A validation activity that uses automated reasoning to check the ontology's logical properties, including class satisfiability, overall consistency, and correctness of entailed subsumption relationships."@en ;
    skos:example "Running HermiT reasoner to verify all classes are satisfiable."@en .

kb:MeritocracyGovernance a owl:Class ;
    rdfs:label "Meritocracy Governance"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Decisions weighted by expertise and contribution."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/50508.html> ;
    rdfs:subClassOf kb:GovernanceModel ;
    skos:definition "A governance model where ontology design authority is allocated based on demonstrated expertise and contribution history, giving greater decision-making influence to proven domain and engineering experts."@en ;
    skos:example "Contributors with most commits have more influence."@en .

kb:ModularizationTechnique a owl:Class ;
    rdfs:label "Modularization Technique"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Method for decomposing ontology into modules."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1>,
        <https://www.iso.org/standard/50508.html> ;
    rdfs:subClassOf kb:Activity,
        kb:Modularization ;
    skos:definition "A method for decomposing a monolithic ontology into cohesive, loosely-coupled modules that can be independently managed, combining automated analysis with expert judgment to determine module boundaries."@en ;
    skos:example "Signature-based modularization extracts relevant subset for application."@en .

kb:NamespaceManagement a owl:Class ;
    rdfs:label "Namespace Management"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Handling URI prefixes and namespace declarations."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.w3.org/TR/rdf11-concepts/>,
        <https://www.w3.org/TR/rdf11-turtle/> ;
    rdfs:subClassOf kb:Activity,
        owl:Thing ;
    skos:definition "An ontology engineering practice that governs the creation, documentation, and maintenance of URI namespaces used in the ontology, ensuring consistent, resolvable, and globally unique identifiers."@en ;
    skos:example "Declaring @prefix ex: <http://example.org/> in Turtle."@en .

kb:Parsing a owl:Class ;
    rdfs:label "Parsing"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Reading and interpreting ontology from serialization."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:Activity,
        owl:Thing ;
    skos:definition "The process of reading a serialized ontology file and constructing the corresponding in-memory graph data structures, interpreting the serialization syntax to recreate the complete set of triples and annotations."@en ;
    skos:example "Parsing Turtle file to build RDF graph."@en .

kb:Population a owl:Class ;
    rdfs:label "Population"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Adding instance data to ontology classes and properties."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:ImplementationActivity ;
    skos:definition "An implementation activity that creates named individuals and their property assertions in the ontology, instantiating the class structure with concrete domain instances that represent real-world entities."@en ;
    skos:example "Creating instance 'TeslaModel3' as individual of class ElectricCar."@en .

kb:RequirementsPrioritization a owl:Class ;
    rdfs:label "Requirements Prioritization"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Ranking requirements by importance."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <http://example.org/risk#RequirementsPrioritization>,
        <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:RequirementsAnalysis,
        <http://example.org/risk#RequirementsPrioritization> ;
    owl:disjointWith kb:UseCaseAnalysis,
        kb:UseCaseModeling ;
    skos:definition "A requirements analysis technique that ranks ontology requirements by business value, technical risk, and stakeholder urgency, determining which capabilities to implement in each development iteration."@en ;
    skos:exactMatch <http://example.org/risk#RequirementsPrioritization> ;
    skos:example "MoSCoW method prioritizes requirements."@en .

kb:RiskBasedRegression a owl:Class ;
    rdfs:label "Risk-Based Regression Test"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Risk-Based Regression Test - verifies existing functionality after changes."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <http://example.org/risk#RiskBasedRegression>,
        <https://doi.org/10.1109/IEEESTD.2008.4578383>,
        <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf kb:DevelopmentProcess,
        <http://example.org/risk#RiskBasedRegression> ;
    skos:definition "A regression test execution that prioritizes test cases based on the assessed risk of modification impact, running high-risk tests first to detect the most likely failures with minimal execution time."@en ;
    skos:exactMatch <http://example.org/risk#RiskBasedRegression> ;
    skos:example "Prioritizing re-running C4 for a reliability ontology (highest individual count, highest change volume) and AMOD (C6 fix) over CORE (minimal change) after a sprint is RiskBasedRegression based on change scope."@en .

kb:ScrumOntologyDevelopment a owl:Class ;
    rdfs:label "Scrum for Ontology Development"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Scrum for Ontology Development - adapts software methodology for ontology engineering."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:AgileMethodology ;
    skos:definition "An agile methodology applying scrum framework practices to ontology development, organizing work into time-boxed sprints with defined backlogs, daily standups, and iteration reviews."@en ;
    skos:example "Using a Scrum board with backlog items such as 'Add rdfs:isDefinedBy to 140 a reliability ontology individuals' and 'Separate OQC shapes into Layer 2 file', each sized in story points, is ScrumOntologyDevelopment."@en .

kb:SemanticMapping a owl:Class ;
    rdfs:label "Semantic Mapping"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Semantic Web Services and Integration (Sheth et al., 2005). IEEE Internet Computing."@en ;
    rdfs:comment "Mappings using reasoning and background knowledge."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-642-38721-0> ;
    rdfs:subClassOf kb:AutomaticMapping ;
    skos:definition "An automatic mapping technique that establishes correspondences based on the semantic content and logical definitions of ontology elements, using reasoning to identify equivalent or related concepts."@en ;
    skos:example "Using WordNet to infer Car and Automobile are synonyms."@en .

kb:Serialization a owl:Class ;
    rdfs:label "Serialization"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Encoding ontology in specific text format."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:Activity,
        owl:Thing ;
    skos:definition "The process of converting in-memory ontology data structures into a persistent text or binary file representation that can be stored, transmitted, and subsequently parsed back into the original structure."@en ;
    skos:example "Serializing ontology in Turtle format to vehicle.ttl file."@en .

kb:StakeholderRole a owl:Class ;
    rdfs:label "Stakeholder Role"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Sprint F5 (2026-05-15)."@en ;
    rdfs:comment "A stakeholder role in ontology engineering — domain expert, knowledge engineer, end user, maintainer, etc. Per Sprint F5: declared from 2 range references."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:subClassOf kb:KnowledgeBaseConcept ;
    skos:definition "A stakeholder role in ontology engineering — domain expert, knowledge engineer, end user, maintainer, etc. Per Sprint F5: declared from 2 range references."@en .

kb:StatusMeeting a owl:Class ;
    rdfs:label "Status Meeting"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology Engineering in Collaborative and Distributed Environments (Tudorache et al., 2013). Semantic Web Journal."@en ;
    rdfs:comment "Regular progress review meeting."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://scrumguides.org/scrum-guide.html> ;
    rdfs:subClassOf kb:MeetingType ;
    owl:disjointWith kb:WorkshopMeeting ;
    skos:definition "A meeting where the ontology engineering team reports progress against planned milestones, identifies risks and blockers, and makes decisions on resource allocation or priority adjustments."@en ;
    skos:example "Weekly status meeting reviews completed classes."@en .

kb:SteadyStateLoad a owl:Class ;
    rdfs:label "Steady State Load Test"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "ISO/IEC/IEEE 29119 Software Testing Standard."@en ;
    rdfs:comment "Steady State Load Test - evaluates performance under specific load patterns."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1109/IEEESTD.2008.4578383>,
        <https://www.iso.org/standard/60002.html> ;
    rdfs:subClassOf kb:DevelopmentProcess ;
    skos:definition "A load test variant that maintains a constant query volume at the expected production level for an extended duration, testing sustained performance stability and resource consumption patterns."@en ;
    skos:example "Running 20 concurrent SPARQL queries per second against the OQC SPARQL endpoint continuously for 60 minutes to verify there is no memory leak or performance degradation over time is SteadyStateLoad testing."@en .

kb:TaskCoordination a owl:Class ;
    rdfs:label "Task Coordination"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology Engineering in Collaborative and Distributed Environments (Tudorache et al., 2013). Semantic Web Journal."@en ;
    rdfs:comment "Aligning what work is done."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:CoordinationMechanism ;
    skos:definition "A coordination mechanism that assigns, tracks, and manages individual ontology development tasks across team members, ensuring work items are distributed appropriately and completed on schedule."@en ;
    skos:example "Kanban board coordinates who does what."@en .

kb:TechnicalConflict a owl:Class ;
    rdfs:label "Technical Conflict"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology Engineering in Collaborative and Distributed Environments (Tudorache et al., 2013). Semantic Web Journal."@en ;
    rdfs:comment "Disagreement on technical approach."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:ConflictType ;
    skos:definition "A conflict type where contributors make incompatible technical decisions about ontology implementation, such as conflicting axiom patterns, property characteristics, or serialization format choices."@en ;
    skos:example "Conflict over whether to use OWL 2 DL or Full."@en .

kb:Training a owl:Class ;
    rdfs:label "Training"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology Engineering in Collaborative and Distributed Environments (Tudorache et al., 2013). Semantic Web Journal."@en ;
    rdfs:comment "Structured learning activities."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:KnowledgeSharingMechanism ;
    skos:definition "A knowledge sharing mechanism that provides structured learning opportunities on ontology engineering topics through courses, workshops, tutorials, or certification programs for systematic skill development."@en ;
    skos:example "OWL training session educates team on restrictions."@en .

kb:ValidationActivity a owl:Class ;
    rdfs:label "Validation Activity"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Activity checking ontology correctness, completeness, and quality."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:Activity ;
    skos:definition "An ontology engineering activity focused on confirming that the ontology correctly represents the intended domain semantics and satisfies stakeholder requirements, distinct from verification of technical correctness."@en ;
    skos:example "Running reasoner to check consistency is a validation activity."@en .

kb:Validator a owl:Class ;
    rdfs:label "Validator"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Sprint F3 (2026-05-14): umbrella class implicit via subClassOf claims but never declared. Per BP-D2 + L-47v2: declared with full skos:definition to satisfy target class constraints."@en ;
    rdfs:comment "Umbrella class for validation techniques and tools — SyntaxValidation, InspectionTechnique, and other validation approaches that verify ontology correctness, consistency, or compliance. Per Sprint F3."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:subClassOf kb:KnowledgeBaseConcept ;
    skos:definition "Umbrella class for validation techniques and tools — SyntaxValidation, InspectionTechnique, and other validation approaches that verify ontology correctness, consistency, or compliance. Per Sprint F3."@en .

kb:WalkthroughTechnique a owl:Class ;
    rdfs:label "Walkthrough Technique"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Continuous Monitoring and Observability for Semantic Systems. Ontology engineering common practice."@en ;
    rdfs:comment "Step-by-step guided review of ontology with stakeholders."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:InspectionTechnique ;
    skos:definition "An inspection technique where the ontology author presents their design decisions to reviewers step by step, with reviewers identifying issues and suggesting improvements during the guided presentation."@en ;
    skos:example "The SHACL validation pipeline author presenting their shapes file line-by-line to three other engineers, who ask questions but propose no changes in the session, is a WalkthroughTechnique review."@en .

kb:WaterfallMethodology a owl:Class ;
    rdfs:label "Waterfall Methodology"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Sequential phase-based approach."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:PrescriptiveMethodology ;
    skos:definition "A prescriptive methodology that organizes ontology development into sequential non-overlapping phases where each phase must complete before the next begins, with formal gate reviews between phases."@en ;
    skos:example "Waterfall: requirements→design→implementation→testing."@en .

<http://example.org/oemethod-governance> a owl:Ontology ;
    dcterms:created "2026-10-06T00:00:00"^^xsd:dateTime ;
    dcterms:creator oe-prov:Agent_MethodAuthor,
        "the method author" ;
    dcterms:description "The T-Box of the OE Method's governance unit as ONE file (BP-D54): the knowledge base and the release history vocabularies, each a module. Out of scope of the domain vocabularies, so not merged into them (owner's ruling of 2026-10-06). A pure union, proved."@en ;
    dcterms:identifier "oemethod-governance" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T00:00:00"^^xsd:dateTime ;
    dcterms:publisher oe-prov:Org_IKU_Department_of_ComputerEngineering ;
    dcterms:rights "Copyright (c) 2025-2026 a university & the method author. Licensed under CC BY 4.0." ;
    dcterms:rightsHolder oe-prov:Org_IKU_Department_of_ComputerEngineering ;
    dcterms:title "OE Method governance — T-Box (one file for the unit)"@en ;
    rdfs:comment "The T-Box of the OE Method's governance unit as ONE file (BP-D54): the knowledge base and the release history vocabularies, each a module. Out of scope of the domain vocabularies, so not merged into them (owner's ruling of 2026-10-06). A pure union, proved."@en ;
    owl:priorVersion <http://example.org/oemethod-governance/1.0.0> ;
    owl:versionIRI <http://example.org/oemethod-governance/1.1.0> ;
    owl:versionInfo "1.1.0" ;
    skos:changeNote "v1.1.0 (2026-10-06): re-derived after the governing pack's knowledge-base module stopped declaring two terms whose IRIs name another module; a unit may reference another unit's term but not declare it."@en .

orh:OEPackArtifact a owl:Class ;
    rdfs:label "OE Pack Artifact"@en ;
    dcterms:isPartOf <http://example.org/oepack-release-history> ;
    rdfs:isDefinedBy <http://example.org/oepack-release-history> ;
    skos:definition "Any artifact tracked by the OE Pack consolidation arc — typically a TTL ontology file, a SHACL shapes file, a bundle ZIP, or a preflight/build script."@en .

orh:Supersession a owl:Class ;
    rdfs:label "Supersession"@en ;
    dcterms:isPartOf <http://example.org/oepack-release-history> ;
    rdfs:isDefinedBy <http://example.org/oepack-release-history> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty orh:supersededFile ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty orh:supersedes ] ;
    skos:definition "A relationship asserting that one OntologyFile is superseded by another, performed at a particular ConsolidationStep."@en .

kb:AgileMethodology a owl:Class ;
    rdfs:label "Agile Methodology"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Iterative, incremental methodologies emphasizing flexibility and rapid iteration."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:DevelopmentMethodology,
        kb:Methodology ;
    skos:definition "An iterative ontology development approach adapted from software engineering that emphasizes short development cycles, continuous stakeholder feedback, adaptive planning, and incremental delivery of working ontology modules."@en ;
    skos:example "Structuring ontology development into two-week sprints with a backlog, daily standups, and retrospectives — as used to produce the OE package across Sprints A through C — is an AgileMethodology."@en .

kb:AnalysisActivity a owl:Class ;
    rdfs:label "Analysis Activity"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Activity examining domain, requirements, or existing resources."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:Activity ;
    skos:definition "An ontology engineering activity focused on examining and understanding the problem domain, existing artifacts, or system context to produce insights that inform subsequent design and implementation decisions."@en ;
    skos:example "Domain analysis identifies key concepts, relationships, and constraints."@en .

kb:AutomaticMapping a owl:Class ;
    rdfs:label "Automatic Mapping"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Tool-generated correspondences using algorithms."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-642-38721-0> ;
    rdfs:subClassOf kb:MappingTechnique ;
    owl:disjointWith kb:ManualMapping,
        <http://example.org/meta#ManyToManyMapping>,
        <http://example.org/meta#ManyToOneMapping>,
        <http://example.org/meta#OneToManyMapping>,
        <http://example.org/meta#OneToOneMapping> ;
    skos:definition "A mapping technique that generates ontology alignment correspondences entirely through algorithmic computation without human intervention, suitable for large-scale mapping tasks where manual effort is impractical."@en ;
    skos:example "LogMap tool automatically discovers 500 mappings between large ontologies."@en .

kb:ConflictType a owl:Class ;
    rdfs:label "Conflict Type"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology Engineering in Collaborative and Distributed Environments (Tudorache et al., 2013). Semantic Web Journal."@en ;
    rdfs:comment "Disagreement requiring resolution."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-642-38721-0>,
        <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:Collaboration,
        kb:TeamConcept ;
    skos:definition "A category of disagreement that arises during collaborative ontology development when contributors make incompatible modeling decisions that must be detected, classified, and resolved before integration."@en ;
    skos:example "Conflict arises over class naming conventions."@en .

kb:CoordinationMechanism a owl:Class ;
    rdfs:label "Coordination Mechanism"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology Engineering in Collaborative and Distributed Environments (Tudorache et al., 2013). Semantic Web Journal."@en ;
    rdfs:comment "Method for aligning team activities."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html>,
        <https://www.pmi.org/pmbok-guide-standards> ;
    rdfs:subClassOf kb:Collaboration,
        kb:TeamConcept ;
    skos:definition "A structured method for synchronizing decisions and activities among ontology engineering team members, ensuring that concurrent work streams remain aligned and conflicts are resolved systematically."@en ;
    skos:example "Daily standups coordinate team work."@en .

kb:DecisionMakingProcess a owl:Class ;
    rdfs:label "Decision-Making Process"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Method for reaching agreements."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/50508.html>,
        <https://www.pmi.org/pmbok-guide-standards> ;
    rdfs:subClassOf kb:Activity,
        kb:Collaboration ;
    skos:definition "A structured approach for reaching ontology design decisions when multiple alternatives exist, specifying who participates, what information is considered, and how consensus or authority determines the outcome."@en ;
    skos:example "Team uses voting to decide on design alternatives."@en .

kb:EngineeringPattern a owl:Class ;
    rdfs:label "Engineering Pattern"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Sprint F3 (2026-05-14): umbrella class implicit via subClassOf claims but never declared. Per BP-D2 + L-47v2: declared with full skos:definition to satisfy target class constraints."@en ;
    rdfs:comment "Umbrella class for general engineering patterns applied to ontology development — AlignmentPattern, CollaborationPattern, and other reusable patterns crosscutting tools and methodologies. Per Sprint F3."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:subClassOf kb:KnowledgeBaseConcept ;
    skos:definition "Umbrella class for general engineering patterns applied to ontology development — AlignmentPattern, CollaborationPattern, and other reusable patterns crosscutting tools and methodologies. Per Sprint F3."@en .

kb:FeedbackMechanism a owl:Class ;
    rdfs:label "Feedback Mechanism"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Method for providing input on work."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/62085.html>,
        <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:Collaboration,
        kb:TeamConcept ;
    skos:definition "A structured process for collecting, routing, and acting on evaluative input about ontology quality from stakeholders, users, or automated systems, feeding improvement information into the development cycle."@en ;
    skos:example "Pull request reviews provide feedback on changes."@en .

kb:GovernanceModel a owl:Class ;
    rdfs:label "Governance Model"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Framework for decision-making authority."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/50508.html> ;
    rdfs:subClassOf kb:Collaboration,
        kb:TeamConcept ;
    skos:definition "A framework that defines the organizational authority structure, decision-making processes, role assignments, and change approval procedures governing how an ontology is developed, maintained, and evolved."@en ;
    skos:example "Governance model uses consensus for major decisions."@en .

kb:InspectionTechnique a owl:Class ;
    rdfs:label "Inspection Technique"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Continuous Monitoring and Observability for Semantic Systems. Ontology engineering common practice."@en ;
    rdfs:comment "Manual review and examination of ontology elements."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:Activity,
        kb:Validator ;
    skos:definition "A structured manual examination method applied to ontology artifacts to identify defects, inconsistencies, or quality issues that automated tools cannot detect, relying on human expertise and systematic checklists."@en ;
    skos:example "Independently checking each of the 168 a reliability ontology NamedIndividuals against the a reliability ontology safeguard's ANTI-GAMING rules, logging any tautological definition as a defect, is an InspectionTechnique applied to ontology quality."@en .

kb:KnowledgeSharingMechanism a owl:Class ;
    rdfs:label "Knowledge Sharing Mechanism"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology Engineering in Collaborative and Distributed Environments (Tudorache et al., 2013). Semantic Web Journal."@en ;
    rdfs:comment "Method for distributing knowledge across team."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1>,
        <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:Collaboration,
        kb:TeamConcept ;
    skos:definition "A structured approach for transferring ontology engineering expertise and domain knowledge among team members, ensuring critical knowledge is not siloed with individual contributors."@en ;
    skos:example "Documentation wiki shares ontology decisions."@en .

kb:PairModeling a owl:Class ;
    rdfs:label "Pair Modeling"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Two people collaboratively designing ontology."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:CollaborationPattern ;
    owl:disjointWith kb:SynchronousCollaboration ;
    skos:definition "A collaboration pattern where two ontology engineers work together on modeling tasks, with one operating the editor and the other reviewing each decision in real time for immediate quality feedback."@en ;
    skos:example "Engineer and expert pair to model Vehicle hierarchy."@en .

kb:PatchDeployment a owl:Class ;
    rdfs:label "Patch Deployment"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Minor update deployment."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://semver.org/>,
        <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:MaintenanceActivity ;
    skos:definition "A maintenance activity that deploys a planned set of defect corrections to the production ontology as a patch version, following the standard release process but with reduced scope."@en ;
    skos:example "Security patch deployed to production."@en .

kb:PlanningActivity a owl:Class ;
    rdfs:label "Planning Activity"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Activity focused on organizing and scheduling ontology development work."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:Activity ;
    skos:definition "An ontology engineering activity focused on establishing project scope, timelines, resource allocations, and task sequences before development work begins, producing a project plan or iteration backlog."@en ;
    skos:example "Creating project charter with milestones and deliverables is a planning activity."@en .

kb:PrescriptiveMethodology a owl:Class ;
    rdfs:label "Prescriptive Methodology"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology engineering common practice, derived from domain analysis of ontology lifecycle management, quality assurance, and collaborative development processes."@en ;
    rdfs:comment "Methodologies with well-defined procedures, phases, and deliverables."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:DevelopmentMethodology,
        kb:Methodology ;
    skos:definition "An ontology development methodology that defines a fixed sequence of phases, activities, and deliverables to follow, providing detailed guidance at the cost of reduced flexibility for adapting to project-specific needs."@en ;
    skos:example "ISO/IEC 11179 metadata registry standards prescribe exact naming conventions, definition structures, and registration procedures — an ontology development process following them uses a PrescriptiveMethodology."@en .

kb:RegressionTest a owl:Class ;
    rdfs:label "Regression Test"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "OE Pack v17.31.0 items #5/#8 — formal regression suite codification."@en ;
    rdfs:comment "A test invariant that MUST hold across all OE Pack releases. Each RegressionTest individual declares: (a) what is checked, (b) how to verify it mechanically (typically a SPARQL query or external script invocation), and (c) the expected outcome. Failure of any RegressionTest is a release blocker."@en ;
    rdfs:seeAlso <http://example.org/testing#RegressionTest> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty kb:hasCheckSPARQL ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty kb:hasExpectedResult ],
        kb:KnowledgeBaseConcept ;
    skos:definition "A test invariant that MUST hold across all OE Pack releases. Each RegressionTest individual declares: (a) what is checked, (b) how to verify it mechanically (typically a SPARQL query or external script invocation), and (c) the expected outcome. Failure of any RegressionTest is a release blocker."@en ;
    skos:related <http://example.org/testing#RegressionTest> .

kb:RelationshipIdentification a owl:Class ;
    rdfs:label "Relationship Identification"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "NeOn Methodology (Suárez-Figueroa et al., 2012). NeOn Methodology for Building Ontology Networks, IOS Press."@en ;
    rdfs:comment "Finding key domain relationships."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:DomainAnalysis ;
    skos:definition "A domain analysis activity that discovers the semantic associations between domain concepts by analyzing how concepts co-occur, interact, or depend on each other in domain documentation and expert knowledge."@en ;
    skos:example "Identifying part-of and type relationships."@en .

kb:ResourcePlanning a owl:Class ;
    rdfs:label "Resource Planning"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Determining and allocating human, technical, and financial resources."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:PlanningActivity ;
    skos:definition "A planning activity that identifies and allocates the personnel, tools, infrastructure, and budget required for each ontology engineering phase, matching available resources to planned task demands."@en ;
    skos:example "Allocating 2 ontology engineers and 1 domain expert for 6-month project."@en .

kb:TaxonomyDesign a owl:Class ;
    rdfs:label "Taxonomy Design"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Designing hierarchical classification structure for domain concepts."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:ConceptualModeling ;
    skos:definition "A conceptual modeling activity that organizes domain concepts into hierarchical classification structures, determining the superclass-subclass relationships that form the backbone of the ontology's class hierarchy."@en ;
    skos:example "Designing hierarchy: Vehicle > MotorVehicle > Car > SportsCar."@en .

kb:Team a owl:Class ;
    rdfs:label "Team"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "IEEE 12207:2017 §6.2 — Organizational life cycle processes."@en ;
    rdfs:comment "Definition authored during a reliability ontology remediation 2026-02-09; pending domain expert review."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://scrumguides.org/scrum-guide.html>,
        <https://www.pmi.org/pmbok-guide-standards> ;
    rdfs:subClassOf kb:KnowledgeBaseConcept ;
    skos:definition "An organized group of individuals with complementary skills and assigned roles who collaborate on ontology engineering activities within a defined organizational and governance structure."@en ;
    skos:example "The three-person team consisting of a SeniorOntologyEngineer, a DomainSpecialist, and a QualityAssuranceSpecialist who jointly deliver the OE Complete Package in four sprints is a Team."@en .

kb:UseCaseAnalysis a owl:Class ;
    rdfs:label "Use Case Analysis"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "NeOn Methodology (Suárez-Figueroa et al., 2012). NeOn Methodology for Building Ontology Networks, IOS Press."@en ;
    rdfs:comment "Examining scenarios describing how ontology will be used."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:RequirementsAnalysis ;
    owl:disjointWith kb:UseCaseModeling ;
    skos:definition "A requirements analysis technique that documents specific scenarios in which users or systems interact with the ontology, identifying the queries, reasoning tasks, and data flows each scenario requires."@en ;
    skos:example "Analyzing use case 'Search vehicles by fuel type' determines property requirements."@en .

kb:WorkshopMeeting a owl:Class ;
    rdfs:label "Workshop Meeting"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology Engineering in Collaborative and Distributed Environments (Tudorache et al., 2013). Semantic Web Journal."@en ;
    rdfs:comment "Intensive collaborative work session."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://scrumguides.org/scrum-guide.html>,
        <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:MeetingType ;
    skos:definition "A collaborative meeting format where the team works hands-on together to address a specific ontology design challenge, producing concrete design decisions or prototype implementations during the session."@en ;
    skos:example "Full-day workshop models core concepts collaboratively."@en .

orh:Bundle a owl:Class ;
    rdfs:label "Bundle"@en ;
    dcterms:isPartOf <http://example.org/oepack-release-history> ;
    rdfs:isDefinedBy <http://example.org/oepack-release-history> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty orh:hasBundleSHA256 ],
        orh:OEPackArtifact ;
    skos:definition "A shipped ZIP bundle containing one or more ontology files + supporting artifacts (build script, preflight, README)."@en .

orh:ConsolidationStep a owl:Class ;
    rdfs:label "Consolidation Step"@en ;
    dcterms:isPartOf <http://example.org/oepack-release-history> ;
    rdfs:isDefinedBy <http://example.org/oepack-release-history> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty orh:hasStepNumber ] ;
    skos:definition "One of the 14+ work-packages in the OE Pack consolidation plan."@en .

kb:CollaborationPattern a owl:Class ;
    rdfs:label "Collaboration Pattern"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Reusable template for team collaboration."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://scrumguides.org/scrum-guide.html>,
        <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:Collaboration,
        kb:EngineeringPattern ;
    skos:definition "A reusable approach for coordinating multiple contributors working on the same ontology, specifying communication protocols, conflict resolution procedures, and work allocation strategies."@en ;
    skos:example "Pair modeling pattern has 2 people co-create ontology."@en .

kb:ConflictResolution a owl:Class ;
    rdfs:label "Conflict Resolution"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Semantic Web Services and Integration (Sheth et al., 2005). IEEE Internet Computing."@en ;
    rdfs:comment "Method for resolving contradictions in integration."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:Integration ;
    owl:disjointWith kb:DatabaseIntegration,
        kb:MappingTechnique,
        kb:MergingStrategy ;
    skos:definition "An integration concern focused on detecting and resolving contradictions that arise when merging ontology data from multiple sources, including duplicate identification, value reconciliation, and provenance tracking."@en ;
    skos:example "Resolving conflict where A says Car disjoint Truck, B says overlap."@en .

kb:DatabaseIntegration a owl:Class ;
    rdfs:label "Database Integration"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Domain-Specific Ontology Engineering: Industry Applications (various). Ontology engineering common practice."@en ;
    rdfs:comment "Connecting ontology with relational or NoSQL databases."@en,
        "Integrating relational databases."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:Integration,
        kb:IntegrationApplication ;
    owl:disjointWith kb:MappingTechnique,
        kb:MergingStrategy ;
    skos:definition "An integration concern focused on establishing bidirectional data flow between ontology triple stores and relational or document databases, typically involving schema mapping and data transformation."@en ;
    skos:example "Mapping Vehicle class to VEHICLE table with R2RML mappings."@en,
        "R2RML maps database to ontology."@en .

kb:DeploymentPattern a owl:Class ;
    rdfs:label "Deployment Pattern"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Sprint F3 (2026-05-14): umbrella class implicit via subClassOf claims but never declared. Per BP-D2 + L-47v2: declared with full skos:definition to satisfy target class constraints."@en ;
    rdfs:comment "Umbrella class for ontology deployment patterns — BlueGreenDeployment, CanaryDeployment, ContinuousDeployment, RollingDeployment. Captures the release-engineering dimension of ontology production. Per Sprint F3."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:subClassOf kb:KnowledgeBaseConcept ;
    skos:definition "Umbrella class for ontology deployment patterns — BlueGreenDeployment, CanaryDeployment, ContinuousDeployment, RollingDeployment. Captures the release-engineering dimension of ontology production. Per Sprint F3."@en .

kb:DomainAnalysis a owl:Class ;
    rdfs:label "Domain Analysis"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "NeOn Methodology (Suárez-Figueroa et al., 2012). NeOn Methodology for Building Ontology Networks, IOS Press."@en ;
    rdfs:comment "Investigating and understanding the target domain of the ontology."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:AnalysisActivity ;
    skos:definition "An ontology engineering activity that systematically investigates a subject area to identify its core concepts, relationships, terminology, and boundaries as a foundation for ontology design decisions."@en ;
    skos:example "Analyzing automotive domain through literature review and expert interviews."@en .

kb:LiteratureReview a owl:Class ;
    rdfs:label "Literature Review"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "NeOn Methodology (Suárez-Figueroa et al., 2012). NeOn Methodology for Building Ontology Networks, IOS Press."@en ;
    rdfs:comment "Systematic examination of published sources about the domain."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1>,
        <https://doi.org/10.1016/0004-3702(95)00017-8> ;
    rdfs:subClassOf kb:DomainAnalysis ;
    owl:disjointWith kb:RelationshipIdentification ;
    skos:definition "A domain analysis technique that surveys published research, standards, and documentation in the target domain to identify established concepts, competing terminologies, and consensus knowledge structures."@en ;
    skos:example "Reviewing SAE standards, automotive textbooks, and industry whitepapers."@en .

kb:MaintenanceActivity a owl:Class ;
    rdfs:label "Maintenance Activity"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Activity supporting and updating ontology after deployment."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:Activity ;
    skos:definition "An ontology engineering activity performed after initial deployment that corrects defects, adapts the ontology to changed requirements, or improves performance and quality without altering core functionality."@en ;
    skos:example "Fixing bug in Vehicle restriction is a maintenance activity."@en .

kb:MeetingType a owl:Class ;
    rdfs:label "Meeting Type"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology Engineering in Collaborative and Distributed Environments (Tudorache et al., 2013). Semantic Web Journal."@en ;
    rdfs:comment "Structured gathering for specific purpose."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://scrumguides.org/scrum-guide.html>,
        <https://www.pmi.org/pmbok-guide-standards> ;
    rdfs:subClassOf kb:Collaboration,
        kb:TeamConcept ;
    skos:definition "A category of structured interaction among ontology engineering team members, defined by its purpose, participants, agenda format, and expected outputs within the project governance framework."@en ;
    skos:example "Kickoff meeting launches ontology project."@en .

kb:Methodology a owl:Class ;
    rdfs:label "Methodology"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Suárez-Figueroa et al. (2012). NeOn Methodology for Building Ontology Networks."@en ;
    rdfs:comment "Definition authored during a reliability ontology remediation 2026-02-09; pending domain expert review."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1>,
        <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:KnowledgeBaseConcept ;
    skos:definition "A systematic approach to ontology engineering that prescribes a set of phases, activities, deliverables, and quality gates for producing ontologies that meet defined requirements."@en ;
    skos:example "The NEON methodology, which prescribes nine ontology network scenarios (reuse, re-engineering, merge, etc.) and guides how to combine existing resources, is a Methodology for ontology development."@en .

kb:RequirementsElicitation a owl:Class ;
    rdfs:label "Requirements Elicitation"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Gathering ontology requirements from stakeholders."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:RequirementsAnalysis ;
    owl:disjointWith kb:RequirementsPrioritization,
        kb:UseCaseAnalysis,
        kb:UseCaseModeling ;
    skos:definition "A requirements analysis technique that employs interviews, workshops, and document analysis to discover and articulate stakeholder needs before they are formalized as ontology requirements."@en ;
    skos:example "Interviewing users to identify required concepts."@en .

kb:RoadmapPlan a owl:Class ;
    rdfs:label "Roadmap Plan"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    rdfs:comment "A multi-release plan for reaching a stated coverage or quality target. Each RoadmapPlan individual declares the target metric, the current value, the target value, and ordered steps. Codified in ontology rather than markdown so it is queryable, version-controlled, and discoverable by tools."@en ;
    rdfs:subClassOf kb:KnowledgeBaseConcept ;
    skos:definition "A multi-release plan for reaching a stated coverage or quality target. Each RoadmapPlan individual declares the target metric, the current value, the target value, and ordered steps. Codified in ontology rather than markdown so it is queryable, version-controlled, and discoverable by tools."@en .

kb:SynchronousCollaboration a owl:Class ;
    rdfs:label "Synchronous Collaboration"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology Engineering in Collaborative and Distributed Environments (Tudorache et al., 2013). Semantic Web Journal."@en ;
    rdfs:comment "Team members collaborate in real-time."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://scrumguides.org/scrum-guide.html>,
        <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:CollaborationPattern ;
    skos:definition "A collaboration pattern where ontology contributors work simultaneously in the same session, seeing each other's changes in real time and resolving conflicts immediately through direct communication."@en ;
    skos:example "Team uses WebProtégé for synchronous editing."@en .

kb:UseCaseModeling a owl:Class ;
    rdfs:label "Use Case Modeling"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Use Case Modeling."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:RequirementsAnalysis ;
    skos:definition "A requirements analysis technique that creates structured descriptions of how different user types interact with the ontology, establishing the behavioral expectations that drive design and testing decisions."@en ;
    skos:example "Documenting the use case 'Engineer validates patched ontology' — actor: OntologyEngineer, trigger: sprint close, main flow: run C5 test suite, alternate: mutation test fails → fix and rerun — is UseCaseModeling."@en .

kb:MappingTechnique a owl:Class ;
    rdfs:label "Mapping Technique"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Ontology Matching (Euzenat & Shvaiko, 2013). Springer."@en ;
    rdfs:comment "Method for establishing correspondences between ontology elements."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:Integration ;
    owl:disjointWith kb:MergingStrategy ;
    skos:definition "A method for establishing correspondences between elements of different ontologies or schemas, identifying equivalent, related, or overlapping concepts and properties across independently developed vocabularies."@en ;
    skos:example "String similarity matching maps 'Car' in Ontology A to 'Automobile' in Ontology B."@en .

kb:RollbackDeployment a owl:Class ;
    rdfs:label "Rollback Deployment"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Reverting to previous version."@en,
        "Rollback Deployment - strategy for releasing ontology versions."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:DeploymentActivity,
        kb:DeploymentPattern ;
    skos:definition "A deployment activity that reverts the production environment to a previous known-good ontology version when the current deployment exhibits critical failures that cannot be quickly resolved."@en ;
    skos:example "Rolling back from v2.0 to v1.9."@en .

kb:DeploymentActivity a owl:Class ;
    rdfs:label "Deployment Activity"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "DevOps and Continuous Delivery (Humble & Farley, 2010). Addison-Wesley."@en ;
    rdfs:comment "Activity making ontology available for production use."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:Activity ;
    skos:definition "An operational activity performed during the process of releasing an ontology version into a target environment, encompassing preparation, validation, execution, and post-deployment verification steps."@en ;
    skos:example "Publishing ontology to web server is a deployment activity."@en .

kb:DevelopmentMethodology a owl:Class ;
    rdfs:label "Development Methodology"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Sprint F3 (2026-05-14): umbrella class implicit via subClassOf claims but never declared. Per BP-D2 + L-47v2: declared with full skos:definition to satisfy target class constraints."@en ;
    rdfs:comment "Umbrella class for ontology development methodologies — Agile, Incremental, Prototyping, Waterfall, and other systematic approaches to building ontologies. Per Sprint F3."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:subClassOf kb:KnowledgeBaseConcept ;
    skos:definition "Umbrella class for ontology development methodologies — Agile, Incremental, Prototyping, Waterfall, and other systematic approaches to building ontologies. Per Sprint F3."@en .

kb:Publication a owl:Class ;
    rdfs:label "Publication"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "DevOps and Continuous Delivery (Humble & Farley, 2010). Addison-Wesley."@en ;
    rdfs:comment "Making ontology publicly accessible via web or repository."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:DeploymentActivity ;
    owl:disjointWith kb:RollbackDeployment ;
    skos:definition "A deployment activity that makes an ontology version publicly accessible through registries, web endpoints, or download repositories, enabling external consumers to discover and retrieve the artifact."@en ;
    skos:example "Publishing ontology to http://example.org/vehicle/v2.0/ with content negotiation."@en .

kb:RequirementsAnalysis a owl:Class ;
    rdfs:label "Requirements Analysis"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "NeOn Methodology (Suárez-Figueroa et al., 2012). NeOn Methodology for Building Ontology Networks, IOS Press."@en ;
    rdfs:comment "Examining and refining ontology requirements from stakeholders."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1> ;
    rdfs:subClassOf kb:AnalysisActivity ;
    skos:definition "An ontology engineering activity that elicits, documents, and validates the functional and non-functional requirements the ontology must satisfy, establishing the scope and success criteria for development."@en ;
    skos:example "Analyzing 20 competency questions to identify required classes and properties."@en .

orh:SubjectOntology a owl:Class ;
    rdfs:label "Subject Ontology"@en ;
    dcterms:isPartOf <http://example.org/oepack-release-history> ;
    rdfs:isDefinedBy <http://example.org/oepack-release-history> ;
    skos:definition "A subject ontology in the OE Pack (e.g., core, oe, amod, quality, reliability, performance, oe-measurement, meta, algorithm-efficiency, oepack-release-history)."@en .

kb:MergingStrategy a owl:Class ;
    rdfs:label "Merging Strategy"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Semantic Web Services and Integration (Sheth et al., 2005). IEEE Internet Computing."@en ;
    rdfs:comment "Approach to combining multiple ontologies into one."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-540-87696-0_1>,
        <https://doi.org/10.1007/978-3-642-38721-0> ;
    rdfs:subClassOf kb:Integration ;
    skos:definition "An integration concern focused on combining two or more ontologies into a unified whole, specifying how class hierarchies are reconciled, duplicate concepts are unified, and conflicting axioms are resolved."@en ;
    skos:example "Union merge combines all classes from both ontologies."@en .

kb:Integration a owl:Class ;
    rdfs:label "Integration"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Semantic Web Services and Integration (Sheth et al., 2005). IEEE Internet Computing."@en ;
    rdfs:comment "Connecting ontology with applications, databases, or other systems."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:DeploymentActivity ;
    owl:disjointWith kb:Publication,
        kb:RollbackDeployment ;
    skos:definition "An ontology engineering concern encompassing the methods, patterns, and tools used to connect ontology systems with external data sources, applications, and services for bidirectional data exchange."@en ;
    skos:example "Configuring triple store to load and serve ontology via SPARQL endpoint."@en .

orh:OntologyFile a owl:Class ;
    rdfs:label "Ontology File"@en ;
    dcterms:isPartOf <http://example.org/oepack-release-history> ;
    rdfs:isDefinedBy <http://example.org/oepack-release-history> ;
    rdfs:seeAlso <http://example.org/configuration#OntologyFile> ;
    rdfs:subClassOf orh:OEPackArtifact ;
    skos:definition "A TTL file representing one role (TBox, ABox, or SHACL) of a subject ontology."@en ;
    skos:related <http://example.org/configuration#OntologyFile> .

kb:Collaboration a owl:Class ;
    rdfs:label "Collaboration"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "ISO/IEC 24765:2017 Systems and software engineering — Vocabulary."@en ;
    rdfs:comment "Definition authored during a reliability ontology remediation 2026-02-09; pending domain expert review."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://scrumguides.org/scrum-guide.html>,
        <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:KnowledgeBaseConcept ;
    skos:definition "Organized cooperative work among team members in ontology engineering, encompassing communication protocols, shared artifacts, review processes, and governance structures."@en ;
    skos:example "The exchange of pySHACL validation reports between the ontology engineer and the domain expert — the engineer identifying shape violations, the expert confirming semantic acceptability — is Collaboration in ontology development."@en .

kb:DevelopmentProcess a owl:Class ;
    rdfs:label "Development Process"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "IEEE 12207:2017 Systems and software engineering — Software life cycle processes."@en ;
    rdfs:comment """
[PURPOSE]
DevelopmentProcess represents systematic approaches to ontology creation, evolution, and maintenance throughout the ontology engineering lifecycle.

[DEFINITION]
A structured sequence of activities, phases, and tasks that guide the development of ontologies from requirements through deployment.

[CHARACTERISTICS]
- Phased: Organized into distinct lifecycle phases
- Iterative: Supports incremental refinement
- Collaborative: Involves multiple roles and stakeholders
- Documented: Produces artifacts and deliverables

[RELATIONSHIPS]
- Subtypes: Development, Testing, Validation, Deployment, Maintenance
- Contains: Phases, Activities, Tasks
- Produces: Deliverables, Documentation

[CONSTRAINTS]
- Must have at least 3 phases (hasPhase min 3)
- Must have at least 1 activity (hasActivity min 1)
            """@en,
        "Definition authored during a reliability ontology remediation 2026-02-09; pending domain expert review."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.iso.org/standard/71543.html> ;
    rdfs:subClassOf kb:KnowledgeBaseConcept ;
    skos:definition "A structured sequence of activities that guide the systematic development of ontologies."@en ;
    skos:example """
# Example: Agile ontology development
:AgileOntoDev a :DevelopmentProcess ;
    dc:title "Agile Ontology Development" ;
    :hasPhase :Planning, :Modeling, :Testing, :Review ;
    :involvesRole :OntologyEngineer, :DomainExpert ;
    :iterationLength "2 weeks" .
            """@en .

kb:TeamConcept a owl:Class ;
    rdfs:label "Team Concept"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Sprint F3 (2026-05-14): umbrella class implicit via subClassOf claims but never declared. Per BP-D2 + L-47v2: declared with full skos:definition to satisfy target class constraints."@en ;
    rdfs:comment "Umbrella class for team-organization concepts in ontology engineering — CollocatedTeam, CrossFunctionalTeam, DistributedTeam, and other team-structure patterns. Captures the social-organizational dimension of ontology development methodology. Per Track C precedent: cross-subject concepts are parented under core:Concept. Per Sprint F3: 10 children claimed subClassOf; umbrella now declared."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:subClassOf kb:KnowledgeBaseConcept ;
    skos:definition "Umbrella class for team-organization concepts in ontology engineering — CollocatedTeam, CrossFunctionalTeam, DistributedTeam, and other team-structure patterns. Captures the social-organizational dimension of ontology development methodology. Per Track C precedent: cross-subject concepts are parented under core:Concept. Per Sprint F3: 10 children claimed subClassOf; umbrella now declared."@en .

kb:KnowledgeBaseConcept a owl:Class ;
    rdfs:label "Knowledge Base Concept"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "OE Pack v19.0.1: replaces v19.0.0's kb:KnowledgeBase + kb:OntologyEngineeringDiscipline + kb:OntologyEngineeringConcept three-umbrella structure with single convention-matching kb:KnowledgeBaseConcept umbrella per anomaly-C decision (D-C/D-D 2026-05-19)."@en ;
    rdfs:comment "Discipline-root umbrella for all ontology-engineering knowledge base concepts. Convention-matching sibling to QualityConcept, RiskConcept, TestingConcept, MeasurementConcept, PerformanceConcept, ReliabilityConcept, AlgorithmicEfficiencyConcept under core:Concept. Parents the OE Pack discipline catalogue: Best Practices, Lessons Learned, Refinements, Regression Tests, Roadmap Plans, Decisions, and all methodology/architecture/team/process vocabulary that records HOW ontology engineering is done. DISCLAIMER: distinct from ITIL 4 / PMBOK 7 'Knowledge Base' semantics — this encodes ontology-engineering discipline records accumulated across the OE Pack programme, not IT service operations knowledge articles."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:subClassOf <http://example.org/core#Concept> ;
    skos:definition "Discipline-root umbrella for all ontology-engineering knowledge base concepts. Convention-matching sibling to QualityConcept, RiskConcept, TestingConcept, MeasurementConcept, PerformanceConcept, ReliabilityConcept, AlgorithmicEfficiencyConcept under core:Concept. Parents the OE Pack discipline catalogue: Best Practices, Lessons Learned, Refinements, Regression Tests, Roadmap Plans, Decisions, and all methodology/architecture/team/process vocabulary that records HOW ontology engineering is done. DISCLAIMER: distinct from ITIL 4 / PMBOK 7 'Knowledge Base' semantics — this encodes ontology-engineering discipline records accumulated across the OE Pack programme, not IT service operations knowledge articles."@en .

kb:Activity a owl:Class ;
    rdfs:label "Activity"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Software Engineering Body of Knowledge (SWEBOK), IEEE Computer Society, 2014."@en ;
    rdfs:comment "Discrete task or work unit within ontology development process."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <http://example.org/core#Activity>,
        <https://www.iso.org/standard/71543.html>,
        <https://www.w3.org/TR/prov-o/> ;
    rdfs:subClassOf kb:DevelopmentProcess,
        kb:KnowledgeBaseConcept ;
    skos:definition "A discrete unit of work within the ontology engineering lifecycle that transforms inputs into outputs, has a defined start and end, requires specific resources, and contributes to achieving a project milestone."@en ;
    skos:example "Requirements elicitation is an activity gathering stakeholder needs."@en ;
    skos:related <http://example.org/core#Activity> .

<http://example.org/oepack-release-history> rdfs:label "OEPack Release History v1.0.0"@en ;
    dcterms:created "2026-05-13T00:00:00"^^xsd:dateTime ;
    dcterms:creator oe-prov:Agent_MethodAuthor,
        "the method author"@en ;
    dcterms:identifier "oepack-release-history" ;
    dcterms:isPartOf <http://example.org/oemethod-governance> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T00:00:00"^^xsd:dateTime ;
    dcterms:provenance "Prior rdfs:comment, retained: Sibling subject ontology under top-level Ontology Engineering. Captures the release-lineage facts of OE Pack artifacts across the consolidation arc: which file superseded which, at which step, in which bundle, on which date. Distinct from AMOD (authoring-process discipline) and from META (meta-modeling vocabulary): OEPack-Release-History is the historical record of what happened, not the disciplin"@en,
        "Prior rdfs:comment, retained: oepack-release-history PATCH v1.0.1. Sprint F1 ghost-reference cleanup: 0 dangling class references redirected to canonical homes; 0 dangling subClassOf claims dropped per L-47 (cross-subject methodological-vs-subsumption discipline). Per BP-D4/D5 gates: HermiT PASS, SHACL no new violations."@en,
        "Prior rdfs:comment, retained: oepack-release-history TBOX v1.0.2 (PATCH) — DRIFT-19 fix on hasReleaseDate (xsd:date → xsd:dateTime) per BP-D18."@en,
        "Prior rdfs:comment, retained: oepack_release_history_tbox v1.0.3 (PATCH) per v17.28.0 industrial-hardening — added CC BY 4.0 license, copyright, publisher/rightsHolder (IKÜ Computer Engineering), PROV-O wasGeneratedBy + wasAttributedTo (the method author). Additive ontology metadata only — no semantic changes."@en ;
    dcterms:publisher oe-prov:Org_IKU_Department_of_ComputerEngineering ;
    dcterms:rights "Copyright (c) 2025-2026 a university & the method author. Licensed under CC BY 4.0."@en ;
    dcterms:rightsHolder oe-prov:Org_IKU_Department_of_ComputerEngineering ;
    rdfs:comment "Release history answers one question the other modules cannot: what actually happened? It records which file superseded which, in which release, on which date — the historical record, not the discipline that produced it and not the vocabulary that describes it. Its value appears when a claim about the past is disputed, which is why it is appended to and never rewritten. A reader comes here to establish provenance rather than intent. Reproduce the event count by counting ReleaseEvent individuals in the current ABox."@en,
        "v1.5.0 (2026-10-06, MINOR): every named subject now carries dcterms:isPartOf <http://example.org/oepack-release-history> (its module), the first step of the consolidation of this package's files into one file per role. No term, label or definition changed."@en ;
    owl:priorVersion <http://example.org/oepack-release-history/1.0.0>,
        <http://example.org/oepack-release-history/1.0.1>,
        <http://example.org/oepack-release-history/1.0.2>,
        <http://example.org/oepack-release-history/1.4.1> ;
    owl:versionIRI <http://example.org/oepack-release-history/1.5.0> ;
    owl:versionInfo "1.5.0" ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor ;
    prov:wasGeneratedBy oe-prov:Activity_OEPackRelease_v17_28_0 .

<http://example.org/knowledge-base> dcterms:created "2026-05-16T00:00:00"^^xsd:dateTime ;
    dcterms:creator oe-prov:Agent_MethodAuthor,
        "the method author"@en ;
    dcterms:identifier "ontology-engineering" ;
    dcterms:isPartOf <http://example.org/oemethod-governance> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T00:00:00"^^xsd:dateTime ;
    dcterms:provenance "OE catalogue TBox v2.3.0 (MINOR) per OE Pack v20.38.0 — added kb:isOngoingEnhancementLineage (BP-D51), a package-level DT property distinct from the retired kb:isSkeletonShape mechanism. Backwards-compatible addition, no removals."@en,
        "Prior rdfs:comment, retained: OE catalogue TBOX v1.15.0 — version aligned with ABox."@en,
        "Prior rdfs:comment, retained: OE catalogue TBox v1.14.0 — version aligned with ABox; no class changes."@en,
        "Prior rdfs:comment, retained: OE catalogue TBox v1.19.0 (MINOR) per v17.31.0 — added RegressionTest, RoadmapPlan classes + supporting datatype properties."@en,
        "Prior rdfs:comment, retained: OE catalogue TBox v1.20.0 (MINOR) per v17.32.0 — added kb:isSkeletonShape DT property."@en,
        "Prior rdfs:comment, retained: OE catalogue TBox v1.21.0 (MINOR) per v17.33.0 — added isAuthoredFromReleaseHistory boolean DT property for distinguishing self-referential instance authoring."@en,
        "Prior rdfs:comment, retained: The knowledge base is the ecosystem's memory of what went wrong and what was done about it. It holds best practices and lessons, each carrying the evidence that produced it — not advice, but findings with provenance. A reader comes here before making a decision that someone has probably already got wrong once, and leaves knowing which rule applies and why it exists. It is the HOW-TO layer, distinc"@en,
        "Prior rdfs:comment, retained: oe PATCH v1.6.1. Sprint F1 ghost-reference cleanup: 13 dangling class references redirected to canonical homes; 0 dangling subClassOf claims dropped per L-47 (cross-subject methodological-vs-subsumption discipline). Per BP-D4/D5 gates: HermiT PASS, SHACL no new violations."@en,
        "Prior rdfs:comment, retained: oe TBox v1.6.2 (version-aligned)"@en,
        "Prior rdfs:comment, retained: oe v1.4.0 (MAJOR from v1.3.0): deleted duplicate class declarations kb:NamingConvention + kb:ArtifactNamingSchema (canonical home is amod per step 13 AMOD consolidation). Per user rule 2026-05-14 'use the ORIGINAL class.' Per BP-D19 (now empirically refined): bidirectional equivalentClass under OWL 2 RL creates strongly-connected components in the subClassOf graph (46 SCCs measured on the 11-subje"@en,
        "Prior rdfs:comment, retained: oe v1.5.0 MINOR per cohesiveness plan v2.2.0 Sprint C2. Adds subClassOf core:Concept to kb:OntologyEngineeringConcept, finally using it as a TRUE cross-subject umbrella per its self-described intended role."@en,
        "Prior rdfs:comment, retained: oe v1.6.0 (MINOR) per Track D. Adds Lesson L-47: cross-subject subClassOf requires semantic verification, not lexical name-matching. Captured from Track D discussion including the A2 lexical-error correction (reliability:FailureType vs risk:FailureType) and the rejected proposal to chain FailureMitigation under RiskMitigation."@en,
        "Prior rdfs:comment, retained: ontology-engineering TBOX v1.12.0 (version-aligned)"@en,
        "Prior rdfs:comment, retained: ontology-engineering TBOX v1.13.0 (version-aligned)"@en,
        "Prior rdfs:comment, retained: ontology-engineering TBox v1.11.0 (version-aligned to ABox; no content changes — three new Lessons added in ABox)."@en,
        "Prior rdfs:comment, retained: ontology-engineering v1.10.0 (MINOR) — Sprint F6: declared Lesson (synonym for LessonLearned) + 7 small subClassOf-only orphan classes (VersioningPattern, Reasoning, Prototyping, Application, Linking, Modularization, IntegrationApplication) parented under existing umbrellas. Final F-phase cleanup."@en,
        "Prior rdfs:comment, retained: ontology-engineering v1.7.0 (MINOR) — Sprint F3 umbrella class declarations. Declared 8 umbrella classes (TeamConcept, EngineeringTool, DevelopmentMethodology, DeploymentPattern, EngineeringPattern, VersionConcept, Deliverable, Validator) previously implicit via subClassOf claims from ~30 children but never formally declared. All under core:Concept per Track C precedent for cross-subject concepts."@en,
        "Prior rdfs:comment, retained: ontology-engineering v1.8.0 (MINOR) — Sprint F4 property declarations. Declared 4 properties: toolVersion, hasVersion, hasVerificationQuery, hasTestCase. Per L-47v2: each with skos:definition. Domain/range inferred from raw ABox usage patterns per BP-D2."@en,
        "Prior rdfs:comment, retained: ontology-engineering v1.8.1 (PATCH) — Sprint F5 moot axiom cleanup. Dropped 30 owl:disjointWith axioms targeting undeclared classes (per BP-D19 (c): moot axioms whose endpoints no longer exist must be removed from the active corpus). Per L-42: both endpoints verified; right-hand side dangling, axiom retired."@en,
        "Prior rdfs:comment, retained: ontology-engineering v1.9.0 (MINOR) — Sprint F5 declarations (VerificationQuery + 5 architectural/stakeholder classes)."@en,
        "Prior rdfs:comment, retained: ontology_engineering_tbox v1.16.1 (PATCH) per v17.28.0 industrial-hardening — added CC BY 4.0 license, copyright, publisher/rightsHolder (IKÜ Computer Engineering), PROV-O wasGeneratedBy + wasAttributedTo (the method author). Additive ontology metadata only — no semantic changes."@en ;
    dcterms:publisher oe-prov:Org_IKU_Department_of_ComputerEngineering ;
    dcterms:rights "Copyright (c) 2025-2026 a university & the method author. Licensed under CC BY 4.0."@en ;
    dcterms:rightsHolder oe-prov:Org_IKU_Department_of_ComputerEngineering ;
    rdfs:comment "The knowledge base is the ecosystem's memory of what went wrong and what was done about it. It holds best practices and lessons, each carrying the evidence that produced it — not advice, but findings with provenance. A reader comes here before making a decision that someone has probably already got wrong once, and leaves knowing which rule applies and why it exists. It is the HOW-TO layer, distinct from meta: which holds vocabulary about ontologies themselves. Reproduce the entry count by counting hasBestPracticeId and hasLessonId subjects in the current ABox."@en,
        "v2.4.0 (2026-10-06, MINOR): every named subject now carries dcterms:isPartOf <http://example.org/knowledge-base> (its module), the first step of the consolidation of this package's files into one file per role. No term, label or definition changed."@en ;
