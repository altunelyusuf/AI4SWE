    :hasCodeExample """# Developer productivity analysis
import pandas as pd

# Analyze commit data
commits = pd.read_csv('commits.csv')
productivity = commits.groupby('developer').agg({
    'lines_added': 'sum',
    'lines_deleted': 'sum',
    'commits': 'count'
})
print(productivity)"""@en ;
