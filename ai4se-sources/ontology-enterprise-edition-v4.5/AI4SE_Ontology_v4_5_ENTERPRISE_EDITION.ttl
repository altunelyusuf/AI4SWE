#################################################################
#    COMPREHENSIVE DOCUMENTATION & USAGE GUIDE
#################################################################

# AI4SE Ontology v4.0 - ULTIMATE COMPLETE EDITION
# ================================================

# This ontology represents the most comprehensive knowledge base for
# Artificial Intelligence applications in Software Engineering.

# === USAGE EXAMPLES ===

# SPARQL Query Examples:
# ----------------------
 
# Example 1: Find all LLM-related concepts
# PREFIX : <http://ai4se.org/ontology/v4#>
# SELECT ?concept ?label WHERE {
#     ?concept :applicableLLMTechnique ?technique .
#     ?concept rdfs:label ?label .
# }

# Example 2: Get all tools in a category
# PREFIX : <http://ai4se.org/ontology/v4#>
# SELECT ?tool ?url WHERE {
#     ?tool rdf:type :Tool ;
#           :hasCategory "MLOps" ;
#           :hasToolURL ?url .
# }

# Example 3: Find enriched concepts
# PREFIX : <http://ai4se.org/ontology/v4#>
# SELECT ?concept ?label WHERE {
#     ?concept :hasDetailLevel "3"^^xsd:integer ;
#             rdfs:label ?label .
# }

# === PYTHON USAGE ===

# Using owlready2:
# ---------------
# from owlready2 import *
# 
# # Load ontology
# onto = get_ontology("AI4SE_Ontology_v4_0_ULTIMATE.ttl").load()
#
# # Get all concepts
# all_concepts = list(onto.classes())
# print(f"Loaded {len(all_concepts)} concepts")
#
# # Find concepts by domain
# ml_concepts = [c for c in all_concepts 
#                if hasattr(c, 'hasV3ID') and 
#                any('C' in id for id in c.hasV3ID)]
#
# # Get tools
# tools = list(onto.Tool.instances())
# print(f"Available tools: {len(tools)}")
#
# # Query by property
# llm_concepts = [c for c in all_concepts
#                 if hasattr(c, 'applicableLLMTechnique')]

