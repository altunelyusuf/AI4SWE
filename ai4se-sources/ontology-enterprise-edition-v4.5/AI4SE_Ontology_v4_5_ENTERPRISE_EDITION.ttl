:V4_V4_0006 rdf:type owl:Class ;
    rdfs:subClassOf :AI4SEConcept ;
    rdfs:label "Supervised Learning"@en ;
    :hasV4ID "V4;
    :hasCodeExample """from sklearn.ensemble import RandomForestClassifier\nfrom sklearn.model_selection import train_test_split\n\n# Train classifier\nX_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2)\nclf = RandomForestClassifier(n_estimators=100)\nclf.fit(X_train, y_train)\naccuracy = clf.score(X_test, y_test)\nprint(f\"Accuracy: {accuracy:.2f}\")"""@en ;
    skos:altLabel "Supervised Learning (AI-Enhanced)"@en ;
    skos:note "This concept can be enhanced with AI techniques for improved automation and accuracy"@en  .

