#################################################################


#################################################################
#    v4.5 QUALITY FRAMEWORK (from v5.0 Specification)
#################################################################

#-----------------------------------------------------------------------------
# Quality Dimension Properties
#-----------------------------------------------------------------------------

:hasCorrectness rdf:type owl:DatatypeProperty ;
    rdfs:label "has correctness score"@en ;
    rdfs:comment "Measures logical consistency, syntactic validity, and semantic correctness of the ontology"@en ;
    rdfs:domain owl:Ontology ;
    rdfs:range xsd:integer ;
    skos:definition "Correctness score from 0-100 indicating ontology accuracy and validity"@en ;
    skos:example "100 indicates perfect logical consistency with no errors"@en .

:hasCompleteness rdf:type owl:DatatypeProperty ;
    rdfs:label "has completeness score"@en ;
    rdfs:comment "Measures coverage of domain concepts, relationships, and annotations"@en ;
    rdfs:domain owl:Ontology ;
    rdfs:range xsd:integer ;
    skos:definition "Completeness score from 0-100 indicating domain coverage"@en .

:hasConsistency rdf:type owl:DatatypeProperty ;
    rdfs:label "has consistency score"@en ;
    rdfs:comment "Measures internal consistency, axiom compatibility, and reasoning stability"@en ;
    rdfs:domain owl:Ontology ;
    rdfs:range xsd:integer ;
    skos:definition "Consistency score from 0-100 indicating logical coherence"@en .

:hasAdaptability rdf:type owl:DatatypeProperty ;
    rdfs:label "has adaptability score"@en ;
    rdfs:comment "Measures ease of extension, modification, and integration with other ontologies"@en ;
    rdfs:domain owl:Ontology ;
    rdfs:range xsd:integer ;
    skos:definition "Adaptability score from 0-100 indicating flexibility"@en .

:hasUsability rdf:type owl:DatatypeProperty ;
    rdfs:label "has usability score"@en ;
    rdfs:comment "Measures clarity of documentation, naming conventions, and ease of use"@en ;
    rdfs:domain owl:Ontology ;
    rdfs:range xsd:integer ;
    skos:definition "Usability score from 0-100 indicating user-friendliness"@en .

:hasCapacity rdf:type owl:DatatypeProperty ;
    rdfs:label "has capacity score"@en ;
    rdfs:comment "Measures scalability, performance, and ability to handle large datasets"@en ;
    rdfs:domain owl:Ontology ;
    rdfs:range xsd:integer ;
    skos:definition "Capacity score from 0-100 indicating scalability"@en .

:hasDeepness rdf:type owl:DatatypeProperty ;
    rdfs:label "has deepness score"@en ;
    rdfs:comment "Measures depth of knowledge representation, axiomatization, and semantic richness"@en ;
    rdfs:domain owl:Ontology ;
    rdfs:range xsd:integer ;
    skos:definition "Deepness score from 0-100 indicating semantic depth"@en .

:hasComprehensiveness rdf:type owl:DatatypeProperty ;
    rdfs:label "has comprehensiveness score"@en ;
    rdfs:comment "Measures breadth of domain coverage across all relevant areas"@en ;
    rdfs:domain owl:Ontology ;
    rdfs:range xsd:integer ;
    skos:definition "Comprehensiveness score from 0-100 indicating breadth"@en .

:hasOverallQuality rdf:type owl:DatatypeProperty ;
    rdfs:label "has overall quality score"@en ;
    rdfs:comment "Aggregate quality score combining all quality dimensions"@en ;
    rdfs:domain owl:Ontology ;
    rdfs:range xsd:integer ;
    skos:definition "Overall quality score from 0-100 (weighted average of all dimensions)"@en .

#-----------------------------------------------------------------------------
# Quality Assessment Classes
#-----------------------------------------------------------------------------

:QualityAssessment rdf:type owl:Class ;
    rdfs:label "Quality Assessment"@en ;
    skos:definition "Systematic evaluation of ontology quality across multiple dimensions"@en ;
    skos:scopeNote "Quality assessments should be performed regularly and after major changes"@en ;
    skos:example "Annual quality assessment of AI4SE ontology using automated tools and expert review"@en .

:QualityMetric rdf:type owl:Class ;
    rdfs:label "Quality Metric"@en ;
    skos:definition "Measurable indicator of ontology quality in a specific dimension"@en ;
    skos:example "Number of classes with complete annotations, percentage of concepts with code examples"@en .

:QualityReport rdf:type owl:Class ;
    rdfs:label "Quality Report"@en ;
    skos:definition "Comprehensive report documenting quality assessment results and recommendations"@en ;
    skos:scopeNote "Reports should include scores, findings, gaps, and improvement recommendations"@en .

:TestSuite rdf:type owl:Class ;
    rdfs:label "Test Suite"@en ;
    skos:definition "Collection of test cases for validating ontology correctness and completeness"@en ;
    skos:example "AI4SE test suite with 25+ test cases covering competency questions, SPARQL queries, and SHACL shapes"@en .

:TestCase rdf:type owl:Class ;
    rdfs:label "Test Case"@en ;
    skos:definition "Individual test validating specific aspect of ontology quality or functionality"@en ;
    skos:scopeNote "Test cases should cover functional requirements, edge cases, and performance"@en .

:CompetencyQuestion rdf:type owl:Class ;
    rdfs:label "Competency Question"@en ;
    skos:definition "Question the ontology should be able to answer, used to validate coverage"@en ;
    skos:example "What AI tools are available for code completion? Which projects have ROI > 2.0?"@en .

#-----------------------------------------------------------------------------
# Quality-related Properties
#-----------------------------------------------------------------------------

:hasTestSuite rdf:type owl:ObjectProperty ;
    rdfs:label "has test suite"@en ;
    rdfs:domain owl:Ontology ;
    rdfs:range :TestSuite ;
    skos:definition "Links ontology to its validation test suite"@en .

:hasTestCase rdf:type owl:ObjectProperty ;
    rdfs:label "has test case"@en ;
    rdfs:domain :TestSuite ;
    rdfs:range :TestCase ;
    skos:definition "Links test suite to individual test cases"@en .

:hasQualityReport rdf:type owl:ObjectProperty ;
    rdfs:label "has quality report"@en ;
    rdfs:domain owl:Ontology ;
    rdfs:range :QualityReport ;
    skos:definition "Links ontology to quality assessment reports"@en .

:measuresQuality rdf:type owl:ObjectProperty ;
    rdfs:label "measures quality"@en ;
    rdfs:domain :QualityMetric ;
    rdfs:range owl:Ontology ;
    skos:definition "Links quality metric to the ontology being measured"@en .

:numberOfTestCases rdf:type owl:DatatypeProperty ;
    rdfs:label "number of test cases"@en ;
    rdfs:domain :TestSuite ;
    rdfs:range xsd:integer ;
    skos:definition "Count of test cases in the test suite"@en .


#    v4.5 ENTERPRISE EDITION - NEW CONCEPTS
#################################################################

# Concept 1: AI Portfolio Management
:V4_Portfolio_AIPortfolio rdf:type owl:Class ;
    rdfs:subClassOf :V4_4_2_1_EnterpriseAdoption ;
    rdfs:label "AI Portfolio"@en ;
    skos:prefLabel "AI Project Portfolio Management"@en ;
    skos:altLabel "AI Adoption Portfolio"@en ;
    skos:altLabel "AI Initiative Portfolio"@en ;
    
    skos:definition """
    Strategic collection of AI adoption projects, initiatives, and tools managed at 
    the portfolio level with strategic alignment, resource allocation, value tracking, 
    and ROI optimization. Provides enterprise-wide visibility into AI investments and 
    their business outcomes.
    """@en ;
    
    skos:scopeNote """
    AI Portfolio Management encompasses the holistic view of all AI-related projects 
    and initiatives across an organization. It includes project selection, prioritization, 
    resource allocation, dependency management, risk assessment, and value realization 
    tracking. Portfolios can be organized by department, strategic objective, technology 
    domain, or business unit.
    """@en ;
    
    skos:example """
    Examples:
    - Enterprise AI Transformation Portfolio: 50+ projects including Copilot adoption, 
      MLOps platform implementation, AI-powered testing, and intelligent documentation
    - Departmental AI Portfolio: 10-20 projects focused on specific business unit needs
    - Pilot AI Portfolio: 3-5 experimental projects to validate AI technologies
    - Strategic AI Portfolio: High-priority initiatives aligned with corporate strategy
    """@en ;
    
    # AI Technique Mappings
    :applicableMLTechnique :PortfolioOptimization ;
    :applicableMLTechnique :ResourceAllocation ;
    :applicableMLTechnique :PredictiveAnalytics ;
    :applicableMLTechnique :DecisionSupport ;
    
    # Tool References
    :implementedIn :Jira ;
    :implementedIn :Asana ;
    :implementedIn :Azure_DevOps ;
    :implementedIn :Monday ;
    :implementedIn :ServiceNow ;
    
    # Code Example
    :hasCodeExample """# AI Portfolio Management Implementation
from ai4se.portfolio import AIPortfolio, Project

# Initialize enterprise AI portfolio
portfolio = AIPortfolio(
    name="Enterprise AI Transformation 2025",
    strategic_objective="Increase developer productivity by 40%"
)

# Add projects with full details
portfolio.add_project(Project(
    name="GitHub Copilot Enterprise Rollout",
    budget=500000,
    expected_roi=1.8,
    timeline_months=12,
    priority="High",
    strategic_alignment=0.95,
    risk_level="Medium"
))

portfolio.add_project(Project(
    name="MLOps Platform Implementation",
    budget=750000,
    expected_roi=2.2,
    timeline_months=18,
    priority="High",
    strategic_alignment=0.90,
    risk_level="High"
))

portfolio.add_project(Project(
    name="AI-Powered Code Review System",
    budget=300000,
    expected_roi=1.5,
    timeline_months=9,
    priority="Medium",
    strategic_alignment=0.85,
    risk_level="Low"
))

# Portfolio analytics
total_budget = portfolio.calculate_total_budget()
weighted_roi = portfolio.calculate_weighted_roi()
portfolio_risk = portfolio.assess_portfolio_risk()
strategic_fit = portfolio.check_strategic_alignment()

print(f"Portfolio Size: {portfolio.project_count} projects")
print(f"Total Budget: ${total_budget:,.0f}")
print(f"Expected ROI: {weighted_roi:.1f}x")
print(f"Portfolio Risk: {portfolio_risk}")
print(f"Strategic Alignment: {strategic_fit:.0%}")

# Optimization and rebalancing
portfolio.optimize_resource_allocation()
portfolio.balance_risk_reward()
portfolio.identify_dependencies()

# Reporting and dashboards
portfolio.generate_executive_dashboard()
portfolio.create_gantt_chart()
portfolio.export_to_csv("ai_portfolio_2025.csv")
"""@en ;
    
    :hasDetailLevel "3"^^xsd:integer ;
    :hasV4ID "Portfolio.AIPortfolio" ;
    dcterms:source "AI4SE v5.0 Specification + Enterprise Best Practices"@en ;
    dcterms:created "2025-11-15"^^xsd:date .


# Concept 2: KPI Dashboard
:V4_Performance_KPIDashboard rdf:type owl:Class ;
    rdfs:subClassOf :V4_4_3_PerformanceManagement ;
    rdfs:label "KPI Dashboard"@en ;
    skos:prefLabel "Key Performance Indicator Dashboard"@en ;
    skos:altLabel "Metrics Dashboard"@en ;
    skos:altLabel "Performance Dashboard"@en ;
    skos:altLabel "Analytics Dashboard"@en ;
    
    skos:definition """
    Interactive visualization dashboard that aggregates, displays, and tracks key 
    performance indicators (KPIs) for AI adoption, development velocity, code quality, 
    testing coverage, and business outcomes. Provides real-time or near-real-time 
    visibility into metrics that matter.
    """@en ;
    
    skos:scopeNote """
    KPI Dashboards serve as the primary interface for stakeholders to monitor the health, 
    progress, and impact of AI initiatives. They combine technical metrics (code quality, 
    test coverage, build success rate) with business metrics (productivity gains, cost 
    savings, ROI) and operational metrics (adoption rates, user satisfaction, incident 
    rates). Modern dashboards support drill-down, filtering, time-based analysis, and 
    predictive analytics.
    """@en ;
    
    skos:example """
    Examples:
    - AI Tool Adoption Dashboard: Tracks Copilot usage, acceptance rates, productivity 
      impact across teams and departments
    - Code Quality Dashboard: Monitors code quality scores, technical debt, security 
      vulnerabilities, test coverage trends
    - Development Velocity Dashboard: Displays sprint velocity, cycle time, deployment 
      frequency, lead time for changes
    - Business Value Dashboard: Shows ROI, cost savings, productivity improvements, 
      time-to-market reduction
    - Executive Summary Dashboard: High-level KPIs for C-suite including strategic 
      alignment, portfolio health, value delivered
    """@en ;
    
    # AI Technique Mappings
    :applicableMLTechnique :DataVisualization ;
    :applicableMLTechnique :RealTimeAnalytics ;
    :applicableMLTechnique :PredictiveAnalytics ;
    :applicableMLTechnique :AnomalyDetection ;
    :applicableMLTechnique :TrendAnalysis ;
    
    # Tool References
    :implementedIn :Grafana ;
    :implementedIn :Tableau ;
    :implementedIn :PowerBI ;
    :implementedIn :Looker ;
    :implementedIn :Kibana ;
    :implementedIn :Datadog ;
    
    # Code Example
    :hasCodeExample """# KPI Dashboard Implementation
from ai4se.dashboard import KPIDashboard, KPI, VisualizationType

# Create comprehensive KPI dashboard
dashboard = KPIDashboard(
    name="AI Adoption & Impact Dashboard",
    refresh_interval="5m",
    stakeholders=["Engineering", "Product", "Executive"]
)

# Technical KPIs
dashboard.add_kpi(KPI(
    name="Code Quality Score",
    current_value=92.5,
    target_value=95.0,
    unit="percentage",
    trend="improving",
    change_30d=+2.5,
    status="on_track",
    visualization=VisualizationType.GAUGE,
    thresholds={"red": 85, "yellow": 90, "green": 95}
))

dashboard.add_kpi(KPI(
    name="Test Coverage",
    current_value=85.3,
    target_value=80.0,
    unit="percentage",
    trend="stable",
    change_30d=+0.8,
    status="exceeding",
    visualization=VisualizationType.GAUGE
))

dashboard.add_kpi(KPI(
    name="Build Success Rate",
    current_value=94.2,
    target_value=95.0,
    unit="percentage",
    trend="declining",
    change_30d=-1.3,
    status="at_risk",
    visualization=VisualizationType.LINE_CHART
))

# AI Adoption KPIs
dashboard.add_kpi(KPI(
    name="Copilot Adoption Rate",
    current_value=68.0,
    target_value=75.0,
    unit="percentage",
    trend="improving",
    change_30d=+5.0,
    status="on_track",
    visualization=VisualizationType.BAR_CHART
))

dashboard.add_kpi(KPI(
    name="Copilot Acceptance Rate",
    current_value=32.5,
    target_value=30.0,
    unit="percentage",
    trend="improving",
    change_30d=+3.2,
    status="exceeding",
    visualization=VisualizationType.LINE_CHART
))

# Business Impact KPIs
dashboard.add_kpi(KPI(
    name="Development Velocity",
    current_value=115.0,
    target_value=100.0,
    unit="story_points_per_sprint",
    trend="improving",
    change_30d=+8.0,
    status="exceeding",
    visualization=VisualizationType.LINE_CHART
))

dashboard.add_kpi(KPI(
    name="Time to Market",
    current_value=18.5,
    target_value=21.0,
    unit="days",
    trend="improving",
    change_30d=-2.5,
    status="exceeding",
    visualization=VisualizationType.AREA_CHART,
    inverse=True  # Lower is better
))

dashboard.add_kpi(KPI(
    name="Cost Savings (Monthly)",
    current_value=125000,
    target_value=100000,
    unit="USD",
    trend="improving",
    change_30d=+15000,
    status="exceeding",
    visualization=VisualizationType.BAR_CHART
))

# Generate visualizations
dashboard.create_executive_summary()
dashboard.create_trend_charts(period="90d")
dashboard.create_comparison_charts(teams=["Team A", "Team B", "Team C"])
dashboard.create_heatmap(metric="adoption_by_department")

# Alerts and notifications
dashboard.configure_alerts(
    kpi="Build Success Rate",
    condition="below_threshold",
    threshold=90.0,
    notification_channels=["email", "slack"]
)

# Export and sharing
dashboard.export_to_pdf("ai_dashboard_2025-11.pdf")
dashboard.publish_to_web(url="/dashboards/ai-adoption")
dashboard.schedule_email_report(
    recipients=["executives@company.com"],
    frequency="weekly",
    day="Monday"
)

# Real-time updates
dashboard.start_auto_refresh()
"""@en ;
    
    :hasDetailLevel "3"^^xsd:integer ;
    :hasV4ID "Performance.KPIDashboard" ;
    dcterms:source "AI4SE v5.0 Specification + Industry Best Practices"@en ;
    dcterms:created "2025-11-15"^^xsd:date .




