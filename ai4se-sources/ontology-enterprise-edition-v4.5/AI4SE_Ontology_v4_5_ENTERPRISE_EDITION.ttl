:hasTotalBudget rdf:type owl:DatatypeProperty ;
    rdfs:label "has total budget"@en ;
    rdfs:comment "Total allocated budget across portfolio"@en ;
    rdfs:range xsd:decimal .

:hasExpectedROI rdf:type owl:DatatypeProperty ;
    rdfs:label "has expected ROI"@en ;
    rdfs:comment "Expected return on investment (multiplier)"@en ;
    rdfs:range xsd:decimal .

:hasStrategicAlignment rdf:type owl:DatatypeProperty ;
    rdfs:label "has strategic alignment"@en ;
    rdfs:comment "Alignment score with strategic objectives (0-1)"@en ;
    rdfs:range xsd:decimal .

:hasProjectPhase rdf:type owl:DatatypeProperty ;
    rdfs:label "has project phase"@en ;
    rdfs:comment "Current phase: Planning, Execution, Monitoring, Closure"@en ;
    rdfs:range xsd:string .

:hasCompletionPercentage rdf:type owl:DatatypeProperty ;
    rdfs:label "has completion percentage"@en ;
    rdfs:comment "Project completion percentage (0-100)"@en ;
    rdfs:range xsd:integer .

:hasBudgetUtilization rdf:type owl:DatatypeProperty ;
    rdfs:label "has budget utilization"@en ;
    rdfs:comment "Percentage of budget used (0-100)"@en ;
    rdfs:range xsd:decimal .

:isOnTrack rdf:type owl:DatatypeProperty ;
    rdfs:label "is on track"@en ;
    rdfs:comment "Boolean indicating if project is on schedule and budget"@en ;
    rdfs:range xsd:boolean .

# Financial Analysis Properties
:hasTimeframe rdf:type owl:DatatypeProperty ;
    rdfs:label "has timeframe"@en ;
    rdfs:comment "Analysis timeframe in months or years"@en ;
    rdfs:range xsd:duration .

:hasDiscountRate rdf:type owl:DatatypeProperty ;
    rdfs:label "has discount rate"@en ;
    rdfs:comment "Discount rate for NPV calculations"@en ;
    rdfs:range xsd:decimal .

:includesIntangibles rdf:type owl:DatatypeProperty ;
    rdfs:label "includes intangibles"@en ;
    rdfs:comment "Whether analysis includes intangible benefits"@en ;
    rdfs:range xsd:boolean .

:hasPaybackPeriod rdf:type owl:DatatypeProperty ;
    rdfs:label "has payback period"@en ;
    rdfs:comment "Time to recover initial investment (months)"@en ;
    rdfs:range xsd:integer .

:hasNetPresentValue rdf:type owl:DatatypeProperty ;
    rdfs:label "has net present value"@en ;
    rdfs:comment "NPV of the investment"@en ;
    rdfs:range xsd:decimal .

:hasInternalRateOfReturn rdf:type owl:DatatypeProperty ;
    rdfs:label "has internal rate of return"@en ;
    rdfs:comment "IRR percentage"@en ;
    rdfs:range xsd:decimal .

:includesOpportunityCost rdf:type owl:DatatypeProperty ;
    rdfs:label "includes opportunity cost"@en ;
    rdfs:comment "Whether opportunity costs are considered"@en ;
    rdfs:range xsd:boolean .

:hasRiskAdjustment rdf:type owl:DatatypeProperty ;
    rdfs:label "has risk adjustment"@en ;
    rdfs:comment "Risk adjustment factor (0-1)"@en ;
    rdfs:range xsd:decimal .

:hasSensitivityAnalysis rdf:type owl:DatatypeProperty ;
    rdfs:label "has sensitivity analysis"@en ;
    rdfs:comment "Whether sensitivity analysis was performed"@en ;
    rdfs:range xsd:boolean .

:includesHiddenCosts rdf:type owl:DatatypeProperty ;
    rdfs:label "includes hidden costs"@en ;
    rdfs:comment "Whether hidden/indirect costs are included"@en ;
    rdfs:range xsd:boolean .

:has5YearTCO rdf:type owl:DatatypeProperty ;
    rdfs:label "has 5-year TCO"@en ;
    rdfs:comment "Total cost of ownership over 5 years"@en ;
    rdfs:range xsd:decimal .

:hasMaintenanceCosts rdf:type owl:DatatypeProperty ;
    rdfs:label "has maintenance costs"@en ;
    rdfs:comment "Annual maintenance and support costs"@en ;
    rdfs:range xsd:decimal .

# Governance Properties
:hasComplianceLevel rdf:type owl:DatatypeProperty ;
    rdfs:label "has compliance level"@en ;
    rdfs:comment "Compliance level: Basic, Standard, Advanced, Full"@en ;
    rdfs:range xsd:string .

:hasAuditFrequency rdf:type owl:DatatypeProperty ;
    rdfs:label "has audit frequency"@en ;
    rdfs:comment "How often audits are conducted"@en ;
    rdfs:range xsd:duration .

:hasEnforcementMechanism rdf:type owl:DatatypeProperty ;
    rdfs:label "has enforcement mechanism"@en ;
    rdfs:comment "How policy is enforced: Automated, Manual, Hybrid"@en ;
    rdfs:range xsd:string .

:hasViolationPenalty rdf:type owl:DatatypeProperty ;
    rdfs:label "has violation penalty"@en ;
    rdfs:comment "Consequences for policy violations"@en ;
    rdfs:range xsd:string .

:hasReviewCycle rdf:type owl:DatatypeProperty ;
    rdfs:label "has review cycle"@en ;
    rdfs:comment "How often policy is reviewed and updated"@en ;
    rdfs:range xsd:duration .

# Risk Management Properties
:hasLikelihoodScore rdf:type owl:DatatypeProperty ;
    rdfs:label "has likelihood score"@en ;
    rdfs:comment "Likelihood of risk occurring (1-5 scale)"@en ;
    rdfs:range xsd:integer .

:hasImpactScore rdf:type owl:DatatypeProperty ;
    rdfs:label "has impact score"@en ;
    rdfs:comment "Impact if risk occurs (1-5 scale)"@en ;
    rdfs:range xsd:integer .

:hasRiskLevel rdf:type owl:DatatypeProperty ;
    rdfs:label "has risk level"@en ;
    rdfs:comment "Overall risk level: Low, Medium, High, Critical"@en ;
    rdfs:range xsd:string .

:hasRiskScore rdf:type owl:DatatypeProperty ;
    rdfs:label "has risk score"@en ;
    rdfs:comment "Calculated risk score (likelihood × impact)"@en ;
    rdfs:range xsd:integer .

:hasResidualRisk rdf:type owl:DatatypeProperty ;
    rdfs:label "has residual risk"@en ;
    rdfs:comment "Remaining risk after mitigation"@en ;
    rdfs:range xsd:string .

# Performance Management Properties
:hasRefreshRate rdf:type owl:DatatypeProperty ;
    rdfs:label "has refresh rate"@en ;
    rdfs:comment "How often dashboard data refreshes"@en ;
    rdfs:range xsd:duration .

:hasVisualType rdf:type owl:DatatypeProperty ;
    rdfs:label "has visual type"@en ;
    rdfs:comment "Type of visualization: Gauge, Chart, Table, Heatmap"@en ;
    rdfs:range xsd:string .

:isRealTime rdf:type owl:DatatypeProperty ;
    rdfs:label "is real-time"@en ;
    rdfs:comment "Whether dashboard updates in real-time"@en ;
    rdfs:range xsd:boolean .

:hasKPICount rdf:type owl:DatatypeProperty ;
    rdfs:label "has KPI count"@en ;
    rdfs:comment "Number of KPIs displayed"@en ;
    rdfs:range xsd:integer .

:hasTargetValue rdf:type owl:DatatypeProperty ;
    rdfs:label "has target value"@en ;
    rdfs:comment "Target value for KPI"@en ;
    rdfs:range xsd:decimal .

:hasCurrentValue rdf:type owl:DatatypeProperty ;
    rdfs:label "has current value"@en ;
    rdfs:comment "Current actual value for KPI"@en ;
    rdfs:range xsd:decimal .

:hasTrendDirection rdf:type owl:DatatypeProperty ;
    rdfs:label "has trend direction"@en ;
    rdfs:comment "Trend: Improving, Declining, Stable"@en ;
    rdfs:range xsd:string .

:hasKPIStatus rdf:type owl:DatatypeProperty ;
    rdfs:label "has KPI status"@en ;
    rdfs:comment "Status: On Track, At Risk, Exceeding, Below Target"@en ;
    rdfs:range xsd:string .

#-----------------------------------------------------------------------------
# Enhanced Object Properties for Relationships
#-----------------------------------------------------------------------------

:hasPortfolio rdf:type owl:ObjectProperty ;
    rdfs:label "has portfolio"@en ;
    rdfs:comment "Links project to its parent portfolio"@en ;
    skos:definition "Relationship between project and portfolio"@en .

:hasProject rdf:type owl:ObjectProperty ;
    rdfs:label "has project"@en ;
    rdfs:comment "Links portfolio to its constituent projects"@en ;
    skos:definition "Portfolio contains projects"@en .

:hasGovernance rdf:type owl:ObjectProperty ;
    rdfs:label "has governance"@en ;
    rdfs:comment "Links to governance framework"@en ;
    skos:definition "Entity is governed by framework"@en .

:hasRiskProfile rdf:type owl:ObjectProperty ;
    rdfs:label "has risk profile"@en ;
    rdfs:comment "Links to risk assessment"@en ;
    skos:definition "Entity has associated risk profile"@en .

:tracksKPIs rdf:type owl:ObjectProperty ;
    rdfs:label "tracks KPIs"@en ;
    rdfs:comment "Links to KPI dashboard"@en ;
    skos:definition "Entity tracks KPIs via dashboard"@en .

:displaysKPI rdf:type owl:ObjectProperty ;
    rdfs:label "displays KPI"@en ;
    rdfs:comment "Dashboard displays this KPI"@en ;
    skos:definition "Dashboard shows performance indicator"@en .

:tracksProject rdf:type owl:ObjectProperty ;
    rdfs:label "tracks project"@en ;
    rdfs:comment "Dashboard tracks this project"@en ;
    skos:definition "Monitoring relationship"@en .

:usedBy rdf:type owl:ObjectProperty ;
    rdfs:label "used by"@en ;
    rdfs:comment "Tool or dashboard used by stakeholder"@en ;
    skos:definition "Usage relationship"@en .

:integratesWith rdf:type owl:ObjectProperty ;
    rdfs:label "integrates with"@en ;
    rdfs:comment "Integration with data source or system"@en ;
    skos:definition "Integration relationship"@en .

:hasMitigationPlan rdf:type owl:ObjectProperty ;
    rdfs:label "has mitigation plan"@en ;
    rdfs:comment "Risk has associated mitigation plan"@en ;
    skos:definition "Risk mitigation relationship"@en .

:hasApprovalProcess rdf:type owl:ObjectProperty ;
    rdfs:label "has approval process"@en ;
    rdfs:comment "Governance requires approval process"@en ;
    skos:definition "Approval workflow relationship"@en .

:hasBlocker rdf:type owl:ObjectProperty ;
    rdfs:label "has blocker"@en ;
    rdfs:comment "Project has blocking issue"@en ;
    skos:definition "Impediment relationship"@en .


