:OpenSourceLicensing rdf:type owl:Class ;
    rdfs:label "Open Source Software Licensing"@en ;
    skos:definition "Legal framework for using, modifying, and distributing open source software, critical compliance area for Turkish fashion e-commerce technology stacks"@en ;
    :hasBenefit "Free to use (most licenses)"@en ;
    :hasBenefit "Community support"@en ;
    :hasBenefit "Transparency, security review"@en ;
    :hasChallenge "License compliance complexity"@en ;
    :hasChallenge "Copyleft obligations"@en ;
    :fashionRetailExample """Trendyol Open Source Policy:
    - License scanning: FOSSA tool scans dependencies
    - Approved licenses: MIT, Apache 2.0, BSD
    - Restricted: GPL (copyleft requires legal review)
    - Prohibited: AGPL (network copyleft)
    - Process: Automated PR checks for new dependencies
    - Dependencies: 5,000+ open source packages used
    - Contribution: Trendyol publishes 20+ OSS projects
    - Compliance: Legal team review for compliance"""@en ;
    :hasResource [
        :downloadURL <https://opensource.org/licenses> ;
        rdfs:label "Open Source License Guide"@en
    ] .

:CommercialSoftwareLicensing rdf:type owl:Class ;
    rdfs:label "Commercial Software Licensing"@en ;
    skos:definition "Proprietary software licensing models including perpetual, subscription, and usage-based pricing for Turkish fashion retail enterprise software"@en ;
    :hasChallenge "High costs"@en ;
    :hasChallenge "Vendor lock-in"@en ;
    :fashionRetailExample """LC Waikiki Commercial License Management:
    - Software: SAP (ERP), Salesforce (CRM), Adobe (Creative Suite)
    - Total spend: ₺50M annually
    - License types:
      * Named user: SAP (5,000 licenses)
      * Concurrent: Design tools (100 concurrent)
      * Consumption: AWS (pay per use)
    - Management: Snow Software for tracking
    - Optimization: 20% cost reduction through audits
    - Compliance: Annual vendor audits"""@en ;
    :hasResource [
        :downloadURL <https://www.gartner.com/en/documents/software-licensing> ;
        rdfs:label "Software Licensing Guide"@en
    ] .

#################################################################
#    TECHNICAL DEBT MANAGEMENT (40 Classes)
#################################################################

:TechnicalDebt rdf:type owl:Class ;
    rdfs:label "Technical Debt"@en ;
    skos:definition "Implied cost of additional rework caused by choosing easy solution now instead of better approach, accumulated in fashion e-commerce systems through rapid growth"@en ;
    :hasChallenge "Slows feature development"@en ;
    :hasChallenge "Increases bug rate"@en ;
    :hasChallenge "Difficult to quantify"@en ;
    :fashionRetailExample """Koton Technical Debt Initiative:
    - Assessment: SonarQube technical debt ratio: 15% (high)
    - Sources: Legacy code (5 years old), shortcuts during rapid growth
    - Symptoms: Slow deployments, frequent bugs, developer frustration
    - Strategy:
      * 20% time allocated to debt reduction
      * Boy Scout Rule: Leave code better than found
      * No new features on high-debt modules until refactored
    - Prioritization: By business value and risk
    - Results: Debt ratio 15% → 8% over 12 months
    - Impact: 40% faster development, 50% fewer bugs"""@en ;
    :hasResource [
        :downloadURL <https://martinfowler.com/bliki/TechnicalDebt.html> ;
        rdfs:label "Technical Debt Guide"@en
    ] .

:DebtRepaymentStrategy rdf:type owl:Class ;
    rdfs:subClassOf :TechnicalDebt ;
    rdfs:label "Technical Debt Repayment"@en ;
    skos:definition "Systematic approach to reducing technical debt through refactoring, rewriting, and improving code quality in fashion e-commerce platforms"@en ;
    :hasBenefit "Improved development velocity"@en ;
    :hasBenefit "Reduced bugs"@en ;
    :fashionRetailExample """Defacto Debt Repayment Program:
    - Approach: Incremental refactoring
    - Sprint allocation: 20% capacity for debt work
    - Prioritization: Technical debt quadrant (impact vs effort)
    - Techniques:
      * Strangler fig: Gradual replacement
      * Branch by abstraction: Safe refactoring
      * Test coverage: Before refactoring
    - Tracking: Jira technical debt backlog (200 items)
    - Celebration: Debt-free module parties
    - Result: Deployment frequency 2x, lead time 50% reduction"""@en ;
    :hasResource [
        :downloadURL <https://www.atlassian.com/agile/software-development/technical-debt> ;
        rdfs:label "Debt Management Strategies"@en
    ] .

#################################################################
#    PHASE 14 SUMMARY
#    
