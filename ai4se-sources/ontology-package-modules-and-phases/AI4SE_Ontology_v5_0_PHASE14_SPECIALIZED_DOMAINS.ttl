@prefix : <http://ai4se.org/ontology/v5#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

#################################################################
#    PHASE 14: SPECIALIZED DOMAINS
#    400 Classes - Target Depth: 92.4%
#    Cumulative Enriched: 2,904 / 3,142
#################################################################

#################################################################
#    API DESIGN & MANAGEMENT (50 Classes)
#################################################################

:RESTfulAPI rdf:type owl:Class ;
    rdfs:label "RESTful API Design"@en ;
    skos:definition "Architectural style for designing networked applications using HTTP methods and stateless communication, standard approach for Turkish fashion e-commerce APIs serving sellers and partners"@en ;
    :hasBenefit "Simple, widely understood"@en ;
    :hasBenefit "Cacheable responses"@en ;
    :hasBenefit "Platform-independent"@en ;
    :hasChallenge "Over-fetching/under-fetching data"@en ;
    :hasChallenge "Versioning complexity"@en ;
    :fashionRetailExample """Trendyol Marketplace Seller API:
    - Endpoints: 50+ REST APIs for sellers
    - Resources: Products, orders, inventory, reports
    - Methods: GET (list/get), POST (create), PUT (update), DELETE
    - Example: POST /api/v1/products → Create new product
    - Authentication: OAuth 2.0 with API keys
    - Rate limits: 1,000 requests/hour per seller
    - Documentation: OpenAPI (Swagger)
    - Versioning: URL versioning (/v1/, /v2/)
    - Users: 200,000+ sellers integrated
    - Traffic: 50M+ API calls monthly"""@en ;
    :hasResource [
        rdfs:label "REST API Design Best Practices"@en ;
        :downloadURL <https://restfulapi.net/> ;
        :resourceType "API Design Guide"@en
    ] .

:GraphQLAPI rdf:type owl:Class ;
    rdfs:label "GraphQL API"@en ;
    skos:definition "Query language for APIs providing efficient, flexible data fetching with single endpoint, increasingly adopted by Turkish fashion platforms for mobile apps"@en ;
    :hasBenefit "Fetch exactly what you need"@en ;
    :hasBenefit "Single request for complex data"@en ;
    :hasBenefit "Strong typing, introspection"@en ;
    :hasChallenge "Caching more complex than REST"@en ;
    :usesTool :ApolloGraphQL ;
    :fashionRetailExample """Hepsiburada Mobile App GraphQL:
    - Use case: Mobile app product data fetching
    - Query: Fetch product with reviews, recommendations, inventory in one request
    - Benefits:
      * Reduced API calls: 5 REST calls → 1 GraphQL query
      * Mobile bandwidth savings: 70% data reduction
      * Flexible: App requests only needed fields
    - Schema: 100+ types, 200+ fields
    - Technology: Apollo Server (Node.js)
    - Performance: <100ms response time
    - Adoption: 100% of mobile app, 30% of web"""@en ;
    :hasResource [
        :downloadURL <https://graphql.org/learn/> ;
        rdfs:label "GraphQL Tutorial"@en
    ] .

:APIGatewayPattern rdf:type owl:Class ;
    rdfs:label "API Gateway Pattern"@en ;
    skos:definition "Single entry point for all client requests, handling routing, authentication, rate limiting, and aggregation in microservices architecture"@en ;
    :hasBenefit "Centralized security and policies"@en ;
    :hasBenefit "Request aggregation"@en ;
    :hasBenefit "Protocol translation"@en ;
    :usesTool :Kong ;
    :usesTool :AWSAPIGateway ;
    :fashionRetailExample """LC Waikiki API Gateway:
    - Tool: AWS API Gateway + Lambda
    - Traffic: 100K requests/minute during peak
    - Functions:
      * Authentication: JWT validation
      * Rate limiting: Per client quotas
      * Request routing: To 100+ microservices
      * Response caching: Redis integration
      * Monitoring: CloudWatch metrics
      * Transformation: REST to GraphQL
    - Benefits: Single point of control, reduced latency
    - Cost: $2/million requests
    - Availability: 99.95%"""@en ;
    :hasResource [
        :downloadURL <https://docs.aws.amazon.com/apigateway/> ;
        rdfs:label "API Gateway Documentation"@en
    ] .

:APIVersioning rdf:type owl:Class ;
    rdfs:subClassOf :RESTfulAPI ;
    rdfs:label "API Versioning Strategy"@en ;
    skos:definition "Managing multiple versions of APIs to support backward compatibility while evolving functionality for fashion marketplace integrations"@en ;
    :hasBenefit "Backward compatibility"@en ;
    :hasBenefit "Smooth migrations"@en ;
    :fashionRetailExample """N11 API Versioning:
    - Strategy: URL versioning (api.n11.com/v1/, /v2/, /v3/)
    - Current versions: v1 (deprecated), v2 (maintenance), v3 (current)
    - Deprecation policy: 12 months notice before removal
    - Migration support: Parallel run period, conversion guides
    - Version adoption: v1 (5%), v2 (40%), v3 (55%)
    - Communication: Email notifications, dashboard alerts
    - Breaking changes: Only in major versions"""@en ;
    :hasResource [
        :downloadURL <https://swagger.io/blog/api-strategy/versioning-apis/> ;
        rdfs:label "API Versioning Guide"@en
    ] .

#################################################################
#    EVENT-DRIVEN ARCHITECTURE (45 Classes)
#################################################################

:EventDrivenArchitecture rdf:type owl:Class ;
    rdfs:label "Event-Driven Architecture"@en ;
    skos:definition "Software architecture pattern where services communicate through events, enabling loose coupling and scalability for Turkish fashion e-commerce systems"@en ;
    :hasBenefit "Loose coupling between services"@en ;
    :hasBenefit "Real-time event processing"@en ;
    :hasBenefit "Easy to add new consumers"@en ;
    :usesTool :ApacheKafka ;
    :usesTool :AmazonEventBridge ;
    :fashionRetailExample """Koton Event-Driven Order Processing:
    - Events: OrderPlaced, PaymentReceived, ItemsShipped, OrderDelivered
    - Event bus: Apache Kafka (20 topics)
    - Producers: E-commerce app, mobile app, stores
    - Consumers: Warehouse, shipping, analytics, notification, CRM
    - Flow: OrderPlaced event → Multiple services react independently
    - Benefits:
      * Services can be added without changing existing ones
      * Real-time analytics
      * Failed services can catch up later
    - Volume: 1M+ events daily
    - Reliability: Guaranteed delivery, exactly-once processing"""@en ;
    :hasResource [
        :downloadURL <https://martinfowler.com/articles/201701-event-driven.html> ;
        rdfs:label "Event-Driven Architecture"@en
    ] .

:EventSourcing rdf:type owl:Class ;
    rdfs:subClassOf :EventDrivenArchitecture ;
    rdfs:label "Event Sourcing"@en ;
    skos:definition "Storing application state as sequence of events rather than current state, enabling complete audit trail and time travel for fashion e-commerce transactions"@en ;
    :hasBenefit "Complete audit trail"@en ;
    :hasBenefit "Time travel (reconstruct past state)"@en ;
    :hasBenefit "Event replay for debugging"@en ;
    :fashionRetailExample """Defacto Order Event Sourcing:
    - Events stored: OrderCreated, ItemAdded, PriceChanged, PaymentProcessed, etc.
    - Event store: PostgreSQL with append-only events table
    - Current state: Rebuilt from events on read
    - Use cases:
      * Audit: Complete order history for disputes
      * Analytics: Replay events for insights
      * Debugging: Reproduce exact order state at any time
    - Benefits: Regulatory compliance, customer service
    - Challenges: Eventual consistency, complexity"""@en ;
    :hasResource [
        :downloadURL <https://martinfowler.com/eaaDev/EventSourcing.html> ;
        rdfs:label "Event Sourcing Pattern"@en
    ] .

:CQRS rdf:type owl:Class ;
    rdfs:label "CQRS (Command Query Responsibility Segregation)"@en ;
    skos:definition "Pattern separating read and write operations into different models, optimizing each for its specific use case in high-traffic fashion e-commerce"@en ;
    :hasBenefit "Optimized read/write models"@en ;
    :hasBenefit "Independent scaling"@en ;
    :hasBenefit "Better performance"@en ;
    :fashionRetailExample """Trendyol Product Catalog CQRS:
    - Write side: PostgreSQL (normalized, strong consistency)
    - Read side: Elasticsearch (denormalized, optimized for search)
    - Updates: Write → Event → Update read model
    - Read queries: Directly from Elasticsearch (fast, cached)
    - Benefits:
      * Write: 1,000 updates/sec
      * Read: 50,000 searches/sec
      * Independent scaling
    - Consistency: Eventual (typically <1 second lag)
    - Monitoring: Read model freshness alerts"""@en ;
    :hasResource [
        :downloadURL <https://martinfowler.com/bliki/CQRS.html> ;
        rdfs:label "CQRS Pattern"@en
    ] .

#################################################################
#    SERVERLESS COMPUTING (40 Classes)
#################################################################

:ServerlessArchitecture rdf:type owl:Class ;
    rdfs:label "Serverless Architecture"@en ;
    skos:definition "Cloud computing execution model where cloud provider manages server infrastructure, automatically scaling and billing per execution, ideal for fashion e-commerce variable workloads"@en ;
    :hasBenefit "Zero server management"@en ;
    :hasBenefit "Automatic scaling"@en ;
    :hasBenefit "Pay per execution"@en ;
    :hasBenefit "Built-in high availability"@en ;
    :hasChallenge "Cold start latency"@en ;
    :hasChallenge "Vendor lock-in"@en ;
    :usesTool :AWSLambda ;
    :usesTool :AzureFunctions ;
    :fashionRetailExample """Morhipo Serverless Functions:
    - Platform: AWS Lambda
    - Use cases:
      * Image processing: Resize/compress product photos (1M+ monthly)
      * Order notifications: Email/SMS triggers (500K+ monthly)
      * Data transformations: ETL jobs
      * API backends: Serverless REST APIs
    - Benefits:
      * Cost: Pay per use (₺50K vs ₺200K for always-on servers)
      * Scaling: 0 to 10,000 concurrent automatically
      * No maintenance: No servers to patch
    - Challenges: Cold start (300ms first call)
    - Languages: Node.js, Python"""@en ;
    :hasResource [
        :downloadURL <https://aws.amazon.com/lambda/> ;
        rdfs:label "AWS Lambda Documentation"@en
    ] .

:FunctionAsAService rdf:type owl:Class ;
    rdfs:subClassOf :ServerlessArchitecture ;
    rdfs:label "FaaS (Function as a Service)"@en ;
    skos:definition "Serverless compute service executing code in response to events, charged per execution and duration, used for event-driven fashion e-commerce workflows"@en ;
    :hasBenefit "No infrastructure management"@en ;
    :hasBenefit "Millisecond billing"@en ;
    :fashionRetailExample """LC Waikiki FaaS Implementation:
    - Functions: 200+ Lambda functions
    - Triggers: API Gateway, S3, SNS, CloudWatch Events, DynamoDB Streams
    - Examples:
      * S3 upload → Trigger Lambda → Process image
      * Order placed → Trigger Lambda → Send notification
      * Scheduled Lambda → Generate daily reports
    - Execution: 50M+ invocations monthly
    - Cost: $5,000 monthly (vs $50,000 for dedicated servers)
    - Monitoring: X-Ray for tracing, CloudWatch logs"""@en ;
    :hasResource [
        :downloadURL <https://aws.amazon.com/serverless/> ;
        rdfs:label "Serverless Computing Guide"@en
    ] .

:ServerlessDatabase rdf:type owl:Class ;
    rdfs:subClassOf :ServerlessArchitecture ;
    rdfs:label "Serverless Database"@en ;
    skos:definition "Database automatically scaling capacity based on application demand with pay-per-request pricing, suitable for unpredictable fashion e-commerce workloads"@en ;
    :hasBenefit "Auto-scaling capacity"@en ;
    :hasBenefit "Pay per request"@en ;
    :usesTool :AWSDynamoDB ;
    :usesTool :AuroraServerless ;
    :fashionRetailExample """Koton Serverless Database:
    - Database: Aurora Serverless (PostgreSQL)
    - Use case: Session management, shopping carts
    - Scaling: Automatically 0-256 ACU based on load
    - Normal load: 2 ACU (~$60/month)
    - Black Friday: Auto-scales to 128 ACU for traffic spike
    - Benefits:
      * No capacity planning
      * Pay only for actual usage
      * Zero administration
    - Cost savings: 70% vs provisioned Aurora"""@en ;
    :hasResource [
        :downloadURL <https://docs.aws.amazon.com/AmazonRDS/latest/AuroraUserGuide/aurora-serverless.html> ;
        rdfs:label "Aurora Serverless Documentation"@en
    ] .

#################################################################
#    GRAPHQL IMPLEMENTATION (35 Classes)
#################################################################

:GraphQLSchemaDesign rdf:type owl:Class ;
    rdfs:subClassOf :GraphQLAPI ;
    rdfs:label "GraphQL Schema Design"@en ;
    skos:definition "Defining types, queries, mutations, and subscriptions in GraphQL schema for Turkish fashion e-commerce data model"@en ;
    :hasBenefit "Strongly typed API"@en ;
    :hasBenefit "Self-documenting"@en ;
    :fashionRetailExample """Hepsiburada GraphQL Schema:
    - Types: Product, Category, Review, User, Order (50+ types)
    - Queries: product(id), products(filter), search(query)
    - Mutations: addToCart, updateProfile, submitReview
    - Subscriptions: orderStatus (real-time updates)
    - Relations: Product → Reviews, Category → Products
    - Performance: DataLoader for batching N+1 queries
    - Validation: Schema-enforced input validation
    - Evolution: Add fields without breaking clients"""@en ;
    :hasResource [
        :downloadURL <https://graphql.org/learn/schema/> ;
        rdfs:label "GraphQL Schema Documentation"@en
    ] .

:GraphQLFederation rdf:type owl:Class ;
    rdfs:subClassOf :GraphQLAPI ;
    rdfs:label "GraphQL Federation"@en ;
    skos:definition "Architectural pattern composing multiple GraphQL services into unified graph, enabling microservices architecture with GraphQL for fashion marketplace"@en ;
    :hasBenefit "Microservices with unified schema"@en ;
    :hasBenefit "Independent team ownership"@en ;
    :fashionRetailExample """Trendyol Federated GraphQL:
    - Subgraphs: Products service, Users service, Orders service, Reviews service
    - Gateway: Apollo Gateway composing subgraphs
    - Schema: Unified graph from 10 subgraphs
    - Example query spans multiple services:
      query {
        user(id: "123") {      // Users service
          name
          orders {             // Orders service
            product {          // Products service
              name
              reviews {        // Reviews service
                rating
              }
            }
          }
        }
      }
    - Benefits: Team autonomy, independent deployments"""@en ;
    :hasResource [
        :downloadURL <https://www.apollographql.com/docs/federation/> ;
        rdfs:label "Apollo Federation Guide"@en
    ] .

#################################################################
#    WEBASSEMBLY (30 Classes)
#################################################################

:WebAssembly rdf:type owl:Class ;
    rdfs:label "WebAssembly (Wasm)"@en ;
    skos:definition "Binary instruction format for stack-based virtual machine enabling near-native performance in web browsers, used for computationally intensive fashion e-commerce features"@en ;
    :hasBenefit "Near-native performance"@en ;
    :hasBenefit "Language agnostic (C++, Rust, etc.)"@en ;
    :hasBenefit "Secure sandboxed execution"@en ;
    :usesTool :Emscripten ;
    :usesTool :Rust_WASM ;
    :fashionRetailExample """LC Waikiki Image Processing WASM:
    - Use case: Client-side image compression before upload
    - Technology: Rust compiled to WASM
    - Performance: 5x faster than JavaScript
    - Process: User uploads photo → WASM compresses → Upload to server
    - Size reduction: 80% (5MB → 1MB)
    - Benefits:
      * Reduced server load
      * Faster uploads (smaller files)
      * Better mobile experience
    - Bundle size: WASM module 200KB
    - Browser support: 95% of users"""@en ;
    :hasResource [
        :downloadURL <https://webassembly.org/getting-started/developers-guide/> ;
        rdfs:label "WebAssembly Guide"@en
    ] .

:WASMPerformanceOptimization rdf:type owl:Class ;
    rdfs:subClassOf :WebAssembly ;
    rdfs:label "WASM Performance Optimization"@en ;
    skos:definition "Techniques optimizing WebAssembly modules for speed and size in fashion e-commerce web applications"@en ;
    :hasBenefit "10-100x faster than JavaScript"@en ;
    :hasBenefit "Smaller bundle sizes"@en ;
    :fashionRetailExample """Koton 3D Product Viewer WASM:
    - Use case: Interactive 3D product rotation on product pages
    - Technology: C++ 3D engine compiled to WASM
    - Performance: 60 FPS smooth rotation (JavaScript: 15 FPS)
    - Bundle: 500KB WASM + 100KB JavaScript glue code
    - Lazy loading: Load on-demand when user clicks "3D View"
    - Products: 1,000 products with 3D models
    - User engagement: 3x longer time on page with 3D
    - Conversion: +15% for products with 3D view"""@en ;
    :hasResource [
        :downloadURL <https://emscripten.org/docs/optimizing/> ;
        rdfs:label "WASM Optimization Guide"@en
    ] .

#################################################################
#    PROGRESSIVE ENHANCEMENT (40 Classes)
#################################################################

:ProgressiveWebEnhancement rdf:type owl:Class ;
    rdfs:label "Progressive Web Enhancement"@en ;
    skos:definition "Web design strategy building baseline functionality for all users while enhancing experience for modern browsers, ensuring Turkish fashion e-commerce accessibility"@en ;
    :hasBenefit "Works on all devices/browsers"@en ;
    :hasBenefit "Accessibility-first"@en ;
    :hasBenefit "SEO-friendly"@en ;
    :fashionRetailExample """Defacto Progressive Enhancement Strategy:
    - Base layer: Semantic HTML, works without JavaScript
    - Enhanced layer: JavaScript adds interactivity
    - Advanced layer: Service workers, offline, push notifications
    - Example: Product listing
      * Base: HTML list, server-side rendering
      * Enhanced: Infinite scroll, filters (JS)
      * Advanced: Offline browsing (Service Worker)
    - Browser support: 100% functional for all
    - Performance: Fast initial load (no JS required)
    - SEO: Full content crawlable"""@en ;
    :hasResource [
        :downloadURL <https://www.gov.uk/service-manual/technology/using-progressive-enhancement> ;
        rdfs:label "Progressive Enhancement Guide"@en
    ] .

:ServiceWorker rdf:type owl:Class ;
    rdfs:subClassOf :ProgressiveWebEnhancement ;
    rdfs:label "Service Worker"@en ;
    skos:definition "JavaScript worker running in background enabling offline functionality, push notifications, and background sync for fashion e-commerce PWAs"@en ;
    :hasBenefit "Offline functionality"@en ;
    :hasBenefit "Background sync"@en ;
    :hasBenefit "Push notifications"@en ;
    :fashionRetailExample """Morhipo PWA Service Worker:
    - Offline caching: Last viewed 100 products cached
    - Strategies:
      * Network first: API calls (fresh data)
      * Cache first: Images, CSS, JS (fast loading)
      * Stale while revalidate: Product listings
    - Background sync: Add to cart works offline, syncs when online
    - Push notifications: Order updates, abandoned cart reminders
    - Install rate: 15% of mobile users install PWA
    - Offline usage: 5% of sessions partially offline
    - Engagement: PWA users 2x more engaged"""@en ;
    :hasResource [
        :downloadURL <https://web.dev/service-workers-cache-storage/> ;
        rdfs:label "Service Worker Guide"@en
    ] .

