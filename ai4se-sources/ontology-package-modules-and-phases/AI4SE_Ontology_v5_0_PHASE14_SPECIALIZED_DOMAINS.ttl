:LowCodePlatform rdf:type owl:Class ;
    rdfs:label "Low-Code Development Platform"@en ;
    skos:definition "Visual development environment enabling rapid application building with minimal hand-coding, used for Turkish fashion retail internal tools and admin panels"@en ;
    :hasBenefit "10x faster development"@en ;
    :hasBenefit "Citizen developers can build"@en ;
    :hasBenefit "Consistent UI/UX"@en ;
    :usesTool :OutSystems ;
    :usesTool :Mendix ;
    :usesTool :MicrosoftPowerApps ;
    :fashionRetailExample """LC Waikiki Internal Tools (Power Apps):
    - Applications: 50+ internal tools built
    - Use cases: Inventory audit, store inspection, employee onboarding, supplier portal
    - Builders: Non-developers (store managers, operations)
    - Development time: 2 weeks vs 3 months traditional
    - Integration: SharePoint, SQL Server, Power BI
    - Users: 2,000+ employees
    - Cost: Included in Microsoft 365 license
    - Governance: IT oversight, security policies"""@en ;
    :hasResource [
        :downloadURL <https://learn.microsoft.com/en-us/power-apps/> ;
        rdfs:label "Power Apps Documentation"@en
    ] .

:NoCodePlatform rdf:type owl:Class ;
    rdfs:label "No-Code Development Platform"@en ;
    skos:definition "Platform enabling complete application development without any coding, used for Turkish fashion retail marketing automation and simple workflows"@en ;
    :hasBenefit "Zero coding required"@en ;
    :hasBenefit "Instant deployment"@en ;
    :fashionRetailExample """Koton Marketing Automation (No-Code):
    - Platform: Zapier + Airtable
    - Workflows:
      * New customer → Add to Mailchimp → Send welcome email series
      * Form submission → Create task in Asana → Notify team in Slack
      * Instagram mention → Log in Airtable → Auto-reply
    - Created by: Marketing team (non-technical)
    - Automations: 100+ workflows
    - Time saved: 20 hours/week
    - Cost: $300/month
    - ROI: 800%"""@en ;
    :hasResource [
        :downloadURL <https://zapier.com/learn/> ;
        rdfs:label "Zapier Learning Center"@en
    ] .

:CodeGeneration rdf:type owl:Class ;
    rdfs:label "AI Code Generation"@en ;
    skos:definition "Using AI to generate code from natural language descriptions or templates, accelerating development for Turkish fashion e-commerce features"@en ;
    :hasBenefit "5x faster development"@en ;
    :hasBenefit "Consistent code patterns"@en ;
    :usesTool :GitHubCopilot ;
    :usesTool :AmazonCodeWhisperer ;
    :fashionRetailExample """Hepsiburada GitHub Copilot Adoption:
    - Users: 200 developers using Copilot
    - Usage: Code suggestions, boilerplate generation, test writing
    - Productivity: 35% faster coding (GitHub study)
    - Acceptance rate: 40% of suggestions accepted
    - Use cases:
      * API endpoint boilerplate
      * Database queries
      * Unit test generation
      * Documentation comments
    - Cost: $20/developer/month
    - ROI: 400% (time savings)"""@en ;
    :hasResource [
        :downloadURL <https://github.com/features/copilot> ;
        rdfs:label "GitHub Copilot"@en
    ] .

#################################################################
