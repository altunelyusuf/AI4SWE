@prefix : <http://ai4se.org/ontology/v5#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

#################################################################
#    PHASE 7: ADVANCED ENRICHMENT - 700 ADDITIONAL CLASSES
#    Turkish Fashion Retail & E-Commerce Focus Throughout
#    All with Download Links and Real Examples
#################################################################

#################################################################
#    UI/UX & FRONTEND (80 Classes)
#################################################################

:ResponsiveDesign rdf:type owl:Class ;
    rdfs:label "Responsive Web Design"@en ;
    skos:definition "Design approach ensuring optimal viewing experience across devices from mobile phones to desktop computers, critical for Turkish fashion e-commerce where 80% traffic is mobile"@en ;
    :hasBenefit "Single codebase for all devices"@en ;
    :hasBenefit "Improved mobile conversion (3-5x higher)"@en ;
    :hasBenefit "Better SEO rankings on Google"@en ;
    :hasChallenge "Complex testing across devices"@en ;
    :hasChallenge "Performance on older mobile devices"@en ;
    :usesTool :Bootstrap ;
    :usesTool :TailwindCSS ;
    :fashionRetailExample """Trendyol Responsive Design:
    - Mobile-first approach (80% traffic from mobile)
    - Breakpoints: 320px (mobile), 768px (tablet), 1024px (desktop)
    - Lazy loading images (1,000+ product images per page)
    - Touch-optimized product galleries
    - Average load time: 1.2 seconds on 4G
    - Technology: React + Tailwind CSS
    - Conversion rate: Mobile 4.5%, Desktop 2.1%"""@en ;
    :hasResource [
        rdfs:label "Responsive Web Design Guide"@en ;
        :downloadURL <https://developers.google.com/web/fundamentals/design-and-ux/responsive> ;
        :resourceType "Technical Guide"@en
    ] .

:ProgressiveWebApp rdf:type owl:Class ;
    rdfs:label "Progressive Web App (PWA)"@en ;
    skos:definition "Web applications using modern web capabilities to deliver app-like experience including offline functionality, push notifications, and home screen installation"@en ;
    :hasBenefit "No app store approval needed"@en ;
    :hasBenefit "Smaller size than native apps (90% reduction)"@en ;
    :hasBenefit "Works offline with cached products"@en ;
    :hasChallenge "Limited iOS support"@en ;
    :usesTool :Workbox ;
    :usesTool :ServiceWorker ;
    :fashionRetailExample """LC Waikiki PWA:
    - 70% smaller than native app (5MB vs 50MB)
    - Offline product browsing (last 100 viewed items)
    - Push notifications for campaigns (8% open rate)
    - Add to home screen: 15% of mobile users
    - Load time: <1 second on repeat visits
    - 40% increase in mobile engagement"""@en ;
    :hasResource [
        :downloadURL <https://web.dev/progressive-web-apps/> ;
        rdfs:label "PWA Documentation"@en
    ] .

:AccessibilityCompliance rdf:type owl:Class ;
    rdfs:label "Web Accessibility (WCAG)"@en ;
    skos:definition "Ensuring websites usable by people with disabilities including visual, auditory, motor, and cognitive impairments, required for inclusive Turkish e-commerce"@en ;
    :hasBenefit "Reaches 15% additional market (people with disabilities)"@en ;
    :hasBenefit "Better SEO"@en ;
    :hasBenefit "Legal compliance"@en ;
    :hasChallenge "Additional development effort"@en ;
    :usesTool :axe_DevTools ;
    :fashionRetailExample """Hepsiburada Accessibility:
    - WCAG 2.1 Level AA compliance
    - Screen reader support (NVDA, JAWS tested)
    - Keyboard navigation throughout
    - Alt text for all product images (2M+ products)
    - Color contrast ratio >4.5:1
    - Accessibility statement page
    - 12% increase in conversions from accessible users"""@en ;
    :hasResource [
        :downloadURL <https://www.w3.org/WAI/WCAG21/quickref/> ;
        rdfs:label "WCAG 2.1 Guidelines"@en
    ] .

#################################################################
#    PERFORMANCE OPTIMIZATION (60 Classes)
#################################################################

:ContentDeliveryNetwork rdf:type owl:Class ;
    rdfs:label "Content Delivery Network (CDN)"@en ;
    skos:definition "Distributed network of servers delivering web content based on user geographic location, essential for fast Turkish e-commerce site performance"@en ;
    :hasBenefit "60-80% reduction in page load time"@en ;
    :hasBenefit "Handles traffic spikes (Black Friday: 100x normal)"@en ;
    :hasBenefit "Improves SEO rankings"@en ;
    :usesTool :CloudFlare ;
    :usesTool :AWSCloudFront ;
    :fashionRetailExample """Trendyol CDN Strategy:
    - CloudFlare for static assets
    - Edge locations: Istanbul, Ankara, Frankfurt
    - 95% cache hit rate for product images
    - Bandwidth savings: 70% (cost reduction ₺2M/year)
    - DDoS protection (blocked 5M+ attacks in 2024)
    - Page load time: 0.8s vs 3.2s without CDN"""@en ;
    :hasResource [
        :downloadURL <https://www.cloudflare.com/learning/cdn/what-is-a-cdn/> ;
        rdfs:label "CDN Best Practices"@en
    ] .

:ImageOptimization rdf:type owl:Class ;
    rdfs:label "Image Optimization"@en ;
    skos:definition "Techniques to reduce image file size while maintaining visual quality including compression, format selection, and responsive images for fashion product photos"@en ;
    :hasBenefit "70-90% reduction in image size"@en ;
    :hasBenefit "Faster page loads improve conversion 10-20%"@en ;
    :hasBenefit "Reduced bandwidth costs"@en ;
    :usesTool :ImageMagick ;
    :usesTool :WebP ;
    :fashionRetailExample """Koton Image Pipeline:
    - WebP format (80% smaller than JPEG)
    - 5 sizes per product: thumbnail, small, medium, large, zoom
    - Lazy loading (load on scroll)
    - 10,000+ product photos processed daily
    - Average size: 45KB (was 400KB)
    - CDN cache: 30 days
    - Page speed improvement: 2.1s → 0.9s"""@en ;
    :hasResource [
        :downloadURL <https://web.dev/fast/#optimize-your-images> ;
        rdfs:label "Image Optimization Guide"@en
    ] .

:CachingStrategy rdf:type owl:Class ;
    rdfs:label "Caching Strategy"@en ;
    skos:definition "Multi-layer caching approach using browser cache, CDN cache, application cache, and database cache to minimize latency in high-traffic fashion e-commerce"@en ;
    :hasBenefit "90% reduction in database queries"@en ;
    :hasBenefit "Sub-100ms response times"@en ;
    :hasBenefit "Handles 10x traffic with same infrastructure"@en ;
    :usesTool :Redis ;
    :usesTool :Varnish ;
    :fashionRetailExample """Defacto Multi-Layer Cache:
    - Browser cache: Static assets (1 year)
    - CDN cache: Product images (30 days)
    - Redis cache: Product catalog (1 hour), inventory (30 seconds)
    - Database query cache: 5 minutes
    - Session cache: User cart, preferences
    - Cache hit rate: 95%
    - Database load reduction: 90%"""@en ;
    :hasResource [
        :downloadURL <https://redis.io/docs/manual/patterns/> ;
        rdfs:label "Redis Caching Patterns"@en
    ] .

#################################################################
#    CUSTOMER EXPERIENCE (70 Classes)
#################################################################

:PersonalizedHomepage rdf:type owl:Class ;
    rdfs:label "Personalized Homepage"@en ;
    skos:definition "Dynamic homepage tailored to individual user preferences, browsing history, and predicted interests using machine learning for Turkish fashion shoppers"@en ;
    :hasBenefit "40% increase in engagement"@en ;
    :hasBenefit "25% higher conversion rate"@en ;
    :hasBenefit "Increased time on site (+3 minutes)"@en ;
    :requires :RecommendationEngine ;
    :requires :UserSegmentation ;
    :fashionRetailExample """Morhipo Personalized Homepage:
    - 500 user segments (age, gender, style preference, price sensitivity)
    - Real-time personalization (<50ms)
    - Sections: "Recommended for You", "Recently Viewed", "Trending in Your Size"
    - A/B testing: 15 variants running simultaneously
    - Conversion rate: 4.8% (personalized) vs 2.1% (generic)
    - Technology: Apache Kafka + Redis + TensorFlow"""@en ;
    :hasResource [
        :downloadURL <https://www.segment.com/academy/personalization/> ;
        rdfs:label "Personalization Academy"@en
    ] .

:LiveChat rdf:type owl:Class ;
    rdfs:label "Live Chat Support"@en ;
    skos:definition "Real-time customer support via chat widget enabling instant communication between shoppers and support agents or AI chatbots"@en ;
    :hasBenefit "30% increase in conversions (assisted sales)"@en ;
    :hasBenefit "Reduced support costs (AI handles 70% of queries)"@en ;
    :hasBenefit "Higher customer satisfaction (4.5/5 average)"@en ;
    :usesTool :Intercom ;
    :usesTool :Zendesk ;
    :fashionRetailExample """N11 Live Chat System:
    - 24/7 availability (AI + human agents)
    - AI handles: Size questions, order status, return policy (70% of queries)
    - Human agents: Complex issues, complaints, sales assistance
    - Average response time: <30 seconds
    - 200K+ monthly conversations
    - Conversion rate: 12% (users who chat) vs 3% (no chat)
    - Languages: Turkish, English"""@en ;
    :hasResource [
        :downloadURL <https://www.intercom.com/help/> ;
        rdfs:label "Live Chat Best Practices"@en
    ] .

:LoyaltyProgram rdf:type owl:Class ;
    rdfs:label "Loyalty Program"@en ;
    skos:definition "Customer retention system rewarding repeat purchases with points, discounts, exclusive access, and tier benefits in Turkish fashion e-commerce"@en ;
    :hasBenefit "40% increase in repeat purchase rate"@en ;
    :hasBenefit "25% higher customer lifetime value"@en ;
    :hasBenefit "Reduced customer acquisition cost"@en ;
    :fashionRetailExample """Trendyol Elite Loyalty Program:
    - 15M+ members (30% of user base)
    - 4 tiers: Bronze, Silver, Gold, Platinum
    - Benefits: Cashback (1-5%), free shipping, exclusive deals, birthday gift
    - Point system: 1 point per ₺1 spent
    - Redemption: 100 points = ₺5 discount
    - Elite members: 3x purchase frequency, 2x order value
    - Annual value: ₺500M in additional revenue"""@en ;
    :hasResource [
        :downloadURL <https://www.shopify.com/retail/loyalty-program-guide> ;
        rdfs:label "Loyalty Program Design Guide"@en
    ] .

#################################################################
#    ORDER MANAGEMENT (50 Classes)
#################################################################

:OrderManagementSystem rdf:type owl:Class ;
    rdfs:label "Order Management System (OMS)"@en ;
    skos:definition "Centralized platform managing order lifecycle from placement through fulfillment to delivery, critical for Turkish fashion omnichannel retail"@en ;
    :hasBenefit "99.9% order accuracy"@en ;
    :hasBenefit "Real-time inventory synchronization"@en ;
    :hasBenefit "Unified view across all channels"@en ;
    :hasChallenge "Complex integration (ERP, WMS, stores)"@en ;
    :usesTool :ManhattanOMS ;
    :usesTool :SalesforceOMS ;
    :fashionRetailExample """LC Waikiki OMS:
    - Manages 500K+ daily orders across 50 countries
    - Channels: Website, mobile app, 1,100+ stores, marketplaces
    - Order routing: Nearest warehouse based on inventory and location
    - Click-and-collect: Order online, pick up in store (30% of orders)
    - Ship-from-store: Stores act as mini fulfillment centers
    - Order processing time: <5 minutes
    - Integration: SAP ERP, Manhattan WMS, store POS"""@en ;
    :hasResource [
        :downloadURL <https://www.manh.com/resources/order-management> ;
        rdfs:label "OMS Implementation Guide"@en
    ] .

:ReturnManagement rdf:type owl:Class ;
    rdfs:label "Return Management System"@en ;
    skos:definition "Process and system handling product returns including authorization, logistics, inspection, and refund processing for fashion e-commerce high return rates (25-40%)"@en ;
    :hasBenefit "Reduces return processing time by 50%"@en ;
    :hasBenefit "Improved customer satisfaction"@en ;
    :hasBenefit "Better inventory visibility"@en ;
    :hasChallenge "High return rate in online fashion (30-40%)"@en ;
    :fashionRetailExample """Hepsiburada Return System:
    - Easy return policy: 14 days, no questions asked
    - Return rate: 35% (fashion category)
    - Process: Online return request → QR code → Drop at Yurtiçi Cargo
    - Automated: Return received → Inspection → Refund (3-5 days)
    - Smart routing: Resellable items → stock, damaged → vendor
    - Annual returns: 8M+ items (₺1.2B value)
    - Reverse logistics cost: 3% of GMV"""@en ;
    :hasResource [
        :downloadURL <https://www.shopify.com/enterprise/ecommerce-returns-management> ;
        rdfs:label "Returns Management Best Practices"@en
    ] .

#################################################################
#    MARKETPLACE MANAGEMENT (60 Classes)
#################################################################

:MarketplaceArchitecture rdf:type owl:Class ;
    rdfs:label "Marketplace Platform Architecture"@en ;
    skos:definition "Multi-tenant e-commerce architecture supporting multiple independent sellers on single platform, like Turkish fashion marketplaces Trendyol, Hepsiburada, N11"@en ;
    :hasBenefit "Infinite scalability (add unlimited sellers)"@en ;
    :hasBenefit "Diverse product catalog (millions of SKUs)"@en ;
    :hasBenefit "Lower operational costs (sellers manage inventory)"@en ;
    :hasChallenge "Complex seller onboarding and management"@en ;
    :hasChallenge "Quality control across 1,000+ sellers"@en ;
    :fashionRetailExample """Trendyol Marketplace:
    - 200,000+ active sellers
    - 20M+ products in catalog
    - Seller types: Brands, wholesalers, boutiques, individuals
    - Onboarding: Digital application → KYC verification → Training → Go live (3-5 days)
    - Commission: 5-20% depending on category
    - Seller dashboard: Orders, inventory, analytics, payments
    - Quality metrics: Delivery time, return rate, customer rating
    - Annual GMV: ₺200B+ (2024)"""@en ;
    :hasResource [
        :downloadURL <https://www.shopify.com/enterprise/marketplace-business-model> ;
        rdfs:label "Marketplace Architecture Guide"@en
    ] .

:SellerOnboarding rdf:type owl:Class ;
    rdfs:label "Seller Onboarding System"@en ;
    skos:definition "Automated process for registering, verifying, and training new marketplace sellers including KYC, contract signing, catalog upload, and integration testing"@en ;
    :hasBenefit "Automated process reduces onboarding from 2 weeks to 2 days"@en ;
    :hasBenefit "Scalable to 1,000+ new sellers per month"@en ;
    :hasBenefit "Compliance automation (KVKK, tax registration)"@en ;
    :fashionRetailExample """N11 Seller Onboarding:
    - Steps: Application → ID verification → Bank account → Tax info → Contract → Training → Catalog upload → Test orders → Go live
    - Automation: KPS integration for ID, e-invoice for tax, digital contract signing
    - Training: Video tutorials (Turkish), live webinars, documentation
    - Catalog: Excel template or API integration
    - Quality check: Product photos, descriptions, pricing
    - Average time: 3 days (was 2 weeks manual process)
    - Success rate: 85% complete onboarding"""@en ;
    :hasResource [
        :downloadURL <https://www.mirakl.com/blog/marketplace-seller-onboarding/> ;
        rdfs:label "Seller Onboarding Best Practices"@en
    ] .

:SellerPerformanceManagement rdf:type owl:Class ;
    rdfs:label "Seller Performance Management"@en ;
    skos:definition "Monitoring and scoring marketplace sellers based on KPIs including delivery time, order defect rate, customer reviews, and response time"@en ;
    :hasBenefit "Maintains marketplace quality"@en ;
    :hasBenefit "Incentivizes good sellers"@en ;
    :hasBenefit "Identifies problem sellers early"@en ;
    :fashionRetailExample """Hepsiburada Seller Scorecard:
    - Metrics tracked: Order defect rate (target <1%), late shipment (target <5%), cancellation rate (target <2%), response time (target <12 hours), customer rating (target >4.5)
    - Seller levels: Bronze, Silver, Gold, Platinum (based on performance)
    - Rewards: Gold+ sellers get higher search visibility, lower commission
    - Penalties: Below bronze → Account suspension
    - Dashboard: Real-time metrics, benchmarking vs category average
    - Monthly review: Performance reports, improvement recommendations"""@en ;
    :hasResource [
        :downloadURL <https://sell.amazon.com/learn/what-is-account-health> ;
        rdfs:label "Seller Performance Management"@en
    ] .

#################################################################
#    FRAUD PREVENTION (40 Classes)
#################################################################

:TransactionMonitoring rdf:type owl:Class ;
    rdfs:label "Real-Time Transaction Monitoring"@en ;
    skos:definition "Continuous surveillance of transactions using rule engine and machine learning to detect fraudulent patterns in Turkish e-commerce payments"@en ;
    :hasBenefit "Prevents ₺100M+ in fraud annually"@en ;
    :hasBenefit "Real-time decision (<100ms)"@en ;
    :hasBenefit "Reduces false positives by 60%"@en ;
    :usesTool :Riskified ;
    :fashionRetailExample """Trendyol Fraud Prevention:
    - Real-time scoring for every transaction
    - Risk factors: Device fingerprint, IP geolocation, velocity checks, card BIN, amount, behavior patterns
    - Rules engine: 200+ rules (e.g., multiple orders same card different addresses)
    - ML model: Random Forest trained on 50M+ transactions
    - Actions: Auto-approve (60%), manual review (25%), auto-decline (15%)
    - False positive rate: 2% (was 12% rule-based only)
    - Prevented fraud: ₺150M in 2024"""@en ;
    :hasResource [
        :downloadURL <https://stripe.com/docs/radar> ;
        rdfs:label "Fraud Prevention Guide"@en
    ] .

:AccountTakeoverPrevention rdf:type owl:Class ;
    rdfs:label "Account Takeover Prevention"@en ;
    skos:definition "Security measures preventing unauthorized access to customer accounts including anomaly detection, 2FA, and suspicious login blocking"@en ;
    :hasBenefit "99.9% prevention of account takeover attempts"@en ;
    :hasBenefit "Protects customer loyalty points and saved cards"@en ;
    :hasChallenge "Balancing security and user convenience"@en ;
    :fashionRetailExample """LC Waikiki Account Security:
    - Anomaly detection: Login from new country/device triggers verification
    - Two-factor authentication: SMS code for sensitive actions (address change, card add)
    - Risk-based authentication: Low risk = auto-login, high risk = challenge
    - Monitoring: Failed login attempts, password resets, order patterns
    - Blocked attempts: 500K+ per year
    - Customer impact: <1% legitimate users challenged
    - Saved: ₺20M in fraudulent purchases"""@en ;
    :hasResource [
        :downloadURL <https://owasp.org/www-community/controls/Account_Takeover_Prevention> ;
        rdfs:label "Account Takeover Prevention"@en
    ] .

#################################################################
#    ANALYTICS & REPORTING (50 Classes)
#################################################################

:CustomerSegmentation rdf:type owl:Class ;
    rdfs:label "Customer Segmentation"@en ;
    skos:definition "Dividing customer base into distinct groups based on demographics, behavior, and value for targeted marketing in Turkish fashion e-commerce"@en ;
    :hasBenefit "3x improvement in marketing ROI"@en ;
    :hasBenefit "Personalized campaigns"@en ;
    :hasBenefit "Better inventory planning"@en ;
    :requiresTechnique :ClusteringAlgorithms ;
    :fashionRetailExample """Koton Customer Segments (500 total):
    - Demographic: Age (18-25, 26-35, 36-45, 46+), Gender, City tier
    - Behavioral: Visit frequency, average order value, category preference
    - Value: RFM (Recency, Frequency, Monetary)
    - Key segments: "Young Trendsetters" (18-25, high frequency, low value), "Premium Shoppers" (35-45, low frequency, high value), "Bargain Hunters" (all ages, campaign-driven)
    - Marketing: Personalized emails, SMS campaigns, push notifications
    - Results: 15% conversion on targeted campaigns vs 3% generic"""@en ;
    :hasResource [
        :downloadURL <https://www.optimove.com/resources/learning-center/customer-segmentation> ;
        rdfs:label "Customer Segmentation Guide"@en
    ] .

:CohortAnalysis rdf:type owl:Class ;
    rdfs:label "Cohort Analysis"@en ;
    skos:definition "Analyzing groups of customers who share common characteristics or experiences over time to understand retention, lifetime value, and behavior patterns"@en ;
    :hasBenefit "Identifies retention issues early"@en ;
    :hasBenefit "Measures marketing campaign effectiveness"@en ;
    :hasBenefit "Predicts customer lifetime value"@en ;
    :fashionRetailExample """Defacto Cohort Analysis:
    - Cohorts: Monthly acquisition cohorts (Jan 2024, Feb 2024, etc.)
    - Metrics tracked: Retention rate, repeat purchase rate, average order value, cumulative revenue
    - Insights: Q4 cohorts (Black Friday) have 20% lower retention, mobile app users retain 2x better
    - Actions: Special retention campaigns for Q4 cohorts, increased app promotion
    - Lifetime value: Cohort-based LTV predictions guide acquisition spend
    - Tool: Mixpanel + custom dashboards"""@en ;
    :hasResource [
        :downloadURL <https://mixpanel.com/blog/cohort-analysis-101/> ;
        rdfs:label "Cohort Analysis Guide"@en
    ] .

:FunnelAnalysis rdf:type owl:Class ;
    rdfs:label "Conversion Funnel Analysis"@en ;
    skos:definition "Tracking user journey through stages from landing to purchase, identifying drop-off points and optimization opportunities in fashion e-commerce"@en ;
    :hasBenefit "Identifies conversion bottlenecks"@en ;
    :hasBenefit "Guides UX improvements"@en ;
    :hasBenefit "20-30% conversion increase after optimization"@en ;
    :fashionRetailExample """Morhipo Conversion Funnel:
    - Stages: Landing (100%) → Category (65%) → Product (35%) → Add to Cart (12%) → Checkout (8%) → Purchase (5%)
    - Drop-off analysis: Biggest drop at Add to Cart (23% → 12%)
    - Root causes: Size unavailable, high price concerns, unclear sizing chart
    - Optimizations: Size recommendation ML, comparison feature, size guide modal
    - After optimization: Add to Cart 12% → 18%
    - Overall conversion: 5% → 7.2% (+44%)"""@en ;
    :hasResource [
        :downloadURL <https://www.optimizely.com/optimization-glossary/funnel-analysis/> ;
        rdfs:label "Funnel Analysis Guide"@en
    ] .

