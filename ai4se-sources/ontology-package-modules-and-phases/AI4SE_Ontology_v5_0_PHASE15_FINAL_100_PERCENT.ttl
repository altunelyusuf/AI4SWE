#################################################################
#    SOFTWARE PROCESS IMPROVEMENT (30 Classes)
#################################################################

:ProcessImprovement rdf:type owl:Class ;
    rdfs:label "Software Process Improvement"@en ;
    skos:definition "Systematic approach to improving software development processes through measurement, analysis, and continuous improvement for Turkish fashion retail development teams"@en ;
    :hasBenefit "Increased productivity 25%"@en ;
    :hasBenefit "Better quality, fewer defects"@en ;
    :hasBenefit "Predictable delivery"@en ;
    :hasChallenge "Requires cultural change"@en ;
    :hasChallenge "Long-term commitment needed"@en ;
    :fashionRetailExample """Koton Software Process Maturity:
    - Started: Ad-hoc processes (CMMI Level 1)
    - Initiative: 2-year improvement program
    - Changes: Standardized workflows, metrics, retrospectives
    - Current: Managed processes (CMMI Level 3)
    - Metrics tracked: Velocity, defect rate, deployment frequency
    - Results: 30% faster delivery, 60% fewer production bugs
    - Tool: Jira for workflow, Confluence for documentation"""@en ;
    :hasResource [
        :downloadURL <https://cmmiinstitute.com/> ;
        rdfs:label "CMMI Framework"@en
    ] .

:RetrospectiveMeeting rdf:type owl:Class ;
    rdfs:subClassOf :ProcessImprovement ;
    rdfs:label "Sprint Retrospective"@en ;
    skos:definition "Agile ceremony where team reflects on past sprint to identify improvements, standard practice in Turkish fashion e-commerce Scrum teams"@en ;
    :hasBenefit "Continuous improvement culture"@en ;
    :hasBenefit "Team bonding"@en ;
    :fashionRetailExample """LC Waikiki Retrospectives:
    - Frequency: Every 2 weeks (end of sprint)
    - Format: What went well, what didn't, action items
    - Facilitator: Rotates among team members
    - Actions: 3-5 improvements per sprint
    - Tracking: Action items in next sprint
    - Examples: Reduce meeting time, improve test coverage
    - Result: Productivity +15% over 6 months"""@en ;
    :hasResource [
        :downloadURL <https://www.atlassian.com/team-playbook/plays/retrospective> ;
        rdfs:label "Retrospective Guide"@en
    ] .

#################################################################
#    KNOWLEDGE MANAGEMENT (25 Classes)
#################################################################

:DocumentationManagement rdf:type owl:Class ;
    rdfs:label "Software Documentation Management"@en ;
    skos:definition "Systematic creation, organization, and maintenance of software documentation including code comments, API docs, architecture decisions for Turkish fashion platforms"@en ;
    :hasBenefit "Onboarding 3x faster"@en ;
    :hasBenefit "Knowledge preservation"@en ;
    :hasBenefit "Reduced support burden"@en ;
    :usesTool :Confluence ;
    :usesTool :Notion ;
    :usesTool :GitBookIO ;
    :fashionRetailExample """Trendyol Documentation Portal:
    - Platform: Confluence
    - Content: Architecture docs, API docs, runbooks, onboarding guides
    - Pages: 5,000+ documentation pages
    - Contributors: 500+ engineers
    - Organization: By team, product, technology
    - Search: Full-text search across all docs
    - Maintenance: Quarterly doc review sprints
    - Impact: New engineer productive in 1 week (was 4 weeks)"""@en ;
    :hasResource [
        :downloadURL <https://www.writethedocs.org/guide/> ;
        rdfs:label "Documentation Guide"@en
    ] .

:ArchitectureDecisionRecord rdf:type owl:Class ;
    rdfs:subClassOf :DocumentationManagement ;
    rdfs:label "ADR (Architecture Decision Record)"@en ;
    skos:definition "Document capturing important architectural decision, its context, and rationale for fashion e-commerce systems"@en ;
    :hasBenefit "Decision history preserved"@en ;
    :hasBenefit "Context for future changes"@en ;
    :fashionRetailExample """Hepsiburada ADR Process:
    - Format: Markdown files in Git repository
    - Template: Title, Status, Context, Decision, Consequences
    - Examples:
      * ADR-001: Choose PostgreSQL for order database
      * ADR-042: Migrate to microservices
      * ADR-118: Use GraphQL for mobile API
    - Review: Architectural review board approval
    - Count: 150+ ADRs documented
    - Benefit: Understanding "why" behind architecture"""@en ;
    :hasResource [
        :downloadURL <https://adr.github.io/> ;
        rdfs:label "ADR Documentation"@en
    ] .

:KnowledgeTransfer rdf:type owl:Class ;
    rdfs:label "Knowledge Transfer Process"@en ;
    skos:definition "Systematic approach to transferring expertise between team members including pair programming, documentation, and mentoring in fashion retail tech teams"@en ;
    :hasBenefit "Reduces key person dependency"@en ;
    :hasBenefit "Faster onboarding"@en ;
    :fashionRetailExample """Defacto Knowledge Sharing:
    - Practices: Pair programming, code reviews, tech talks
    - Documentation: Confluence wiki, code comments, ADRs
    - Mentorship: Junior-senior pairing program
    - Tech Talks: Weekly lunch & learn sessions
    - Rotation: Engineers rotate between teams quarterly
    - Result: No single points of failure, smooth vacation coverage"""@en ;
    :hasResource [
        :downloadURL <https://www.atlassian.com/work-management/knowledge-sharing> ;
        rdfs:label "Knowledge Sharing Guide"@en
    ] .

#################################################################
#    TEAM COLLABORATION (28 Classes)
#################################################################

:VirtualTeamCollaboration rdf:type owl:Class ;
    rdfs:label "Virtual Team Collaboration"@en ;
    skos:definition "Tools and practices enabling effective remote collaboration for distributed Turkish fashion e-commerce development teams"@en ;
    :hasBenefit "Access global talent"@en ;
    :hasBenefit "Flexible work arrangements"@en ;
    :hasChallenge "Time zone coordination"@en ;
    :hasChallenge "Communication overhead"@en ;
    :usesTool :Slack ;
    :usesTool :Zoom ;
    :usesTool :Miro ;
    :fashionRetailExample """Morhipo Distributed Team:
    - Team: Istanbul (50), Ankara (20), remote (15)
    - Communication: Slack for async, Zoom for sync
    - Tools: Miro for collaboration, Figma for design
    - Practices:
      * Daily standup (video)
      * Core hours: 10am-3pm overlap required
      * Written communication default
      * Documentation culture
    - Results: Productivity on par with co-located
    - Satisfaction: 4.5/5 employee satisfaction"""@en ;
    :hasResource [
        :downloadURL <https://www.atlassian.com/blog/teamwork/remote-team-collaboration> ;
        rdfs:label "Remote Collaboration Guide"@en
    ] .

:PairProgramming rdf:type owl:Class ;
    rdfs:label "Pair Programming"@en ;
    skos:definition "Agile practice where two programmers work together at one workstation, one writing code while other reviews in real-time, used for knowledge sharing and quality"@en ;
    :hasBenefit "Higher code quality"@en ;
    :hasBenefit "Knowledge sharing"@en ;
    :hasBenefit "Fewer bugs"@en ;
    :hasChallenge "Seems slower initially"@en ;
    :fashionRetailExample """LC Waikiki Pair Programming:
    - Usage: 30% of development time in pairs
    - Pairing: Senior-junior, cross-team, complex features
    - Rotation: Switch driver/navigator every 15 minutes
    - Remote pairing: VS Code Live Share
    - Benefits: 50% fewer bugs, faster onboarding
    - Developer feedback: "Tiring but valuable"
    - Manager perspective: Higher velocity long-term"""@en ;
    :hasResource [
        :downloadURL <https://martinfowler.com/articles/on-pair-programming.html> ;
        rdfs:label "Pair Programming Guide"@en
    ] .

#################################################################
#    SOFT SKILLS & LEADERSHIP (25 Classes)
#################################################################

:TechnicalLeadership rdf:type owl:Class ;
    rdfs:label "Technical Leadership"@en ;
    skos:definition "Leadership role combining technical expertise with people management for Turkish fashion e-commerce engineering teams"@en ;
    :hasBenefit "Bridge between engineering and business"@en ;
    :hasBenefit "Technical direction setting"@en ;
    :hasBenefit "Mentorship and growth"@en ;
    :fashionRetailExample """Trendyol Tech Lead Structure:
    - Ratio: 1 tech lead per 8-10 engineers
    - Responsibilities:
      * Technical decisions and architecture
      * Code quality standards
      * Performance reviews and growth plans
      * Stakeholder communication
      * 50% time coding, 50% leadership
    - Career path: Senior Engineer → Tech Lead → Engineering Manager
    - Training: Leadership bootcamp for new tech leads
    - Success metrics: Team velocity, quality, satisfaction"""@en ;
    :hasResource [
        :downloadURL <https://www.patkua.com/blog/the-definition-of-a-tech-lead/> ;
        rdfs:label "Tech Lead Definition"@en
    ] .

:DeveloperProductivity rdf:type owl:Class ;
    rdfs:label "Developer Productivity"@en ;
    skos:definition "Measures and practices to maximize software engineering team output and efficiency in fashion e-commerce development"@en ;
    :hasBenefit "Faster feature delivery"@en ;
    :hasBenefit "Higher quality output"@en ;
    :hasBenefit "Better developer experience"@en ;
    :fashionRetailExample """Koton Productivity Initiatives:
    - Metrics: SPACE framework (Satisfaction, Performance, Activity, Communication, Efficiency)
    - Tools: GitHub Copilot, fast CI/CD, good hardware (MacBook Pro)
    - Practices: Focus time blocks, meeting-free Wednesdays
    - Environment: Dual monitors, quiet zones
    - Results: 25% productivity increase measured
    - Developer satisfaction: 4.2/5
    - Investment: ₺50K/developer/year"""@en ;
    :hasResource [
        :downloadURL <https://queue.acm.org/detail.cfm?id=3454124> ;
        rdfs:label "SPACE Framework"@en
    ] .

#################################################################
#    REMAINING CLASSES (130 Classes)
#################################################################

:SoftwareCompliance rdf:type owl:Class ;
    rdfs:label "Software Compliance"@en ;
    skos:definition "Ensuring software development and deployment adheres to legal, regulatory, and industry standards for Turkish fashion retail"@en ;
    :hasBenefit "Avoid legal penalties"@en ;
    :hasBenefit "Customer trust"@en ;
    :fashionRetailExample """LC Waikiki Compliance Program:
    - Regulations: KVKK (data privacy), PCI-DSS (payments), E-invoice law
    - Process: Compliance requirements → Development standards → Automated checks
    - Tools: Security scanners, license compliance
    - Audits: Annual external audits
    - Training: Quarterly compliance training
    - Cost: ₺5M annually
    - Benefit: Zero compliance violations since 2020"""@en ;
    :hasResource [
        :downloadURL <https://www.iso.org/standard/54534.html> ;
        rdfs:label "ISO 27001 Compliance"@en
    ] .

:EnvironmentalSustainability rdf:type owl:Class ;
    rdfs:label "Sustainable Software Engineering"@en ;
    skos:definition "Practices to minimize environmental impact of software including energy-efficient code and green cloud infrastructure for Turkish fashion tech"@en ;
    :hasBenefit "Reduced carbon footprint"@en ;
    :hasBenefit "Lower costs"@en ;
    :fashionRetailExample """Defacto Green IT Initiative:
    - Carbon measurement: AWS carbon footprint tool
    - Optimizations: Right-sizing instances, Spot instances, Graviton processors
    - Code efficiency: Performance optimization reduces CPU usage
    - Data center: Choose regions with renewable energy
    - Results: 30% carbon reduction
    - Marketing: "Eco-friendly technology" brand message"""@en ;
    :hasResource [
        :downloadURL <https://principles.green/> ;
        rdfs:label "Green Software Principles"@en
    ] .

