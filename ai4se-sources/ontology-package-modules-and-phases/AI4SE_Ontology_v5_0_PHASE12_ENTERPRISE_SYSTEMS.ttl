@prefix : <http://ai4se.org/ontology/v5#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

#################################################################
#    PHASE 12: ENTERPRISE SYSTEMS & INTEGRATION
#    400 Classes - Target Depth: 67.0%
#    Cumulative Enriched: 2,104 / 3,142
#################################################################

#################################################################
#    ERP SYSTEMS (50 Classes)
#################################################################

:ERPSystem rdf:type owl:Class ;
    rdfs:label "Enterprise Resource Planning System"@en ;
    skos:definition "Integrated business management software suite combining core business processes including finance, HR, manufacturing, supply chain, and retail operations, essential for Turkish fashion retail operations management"@en ;
    :hasBenefit "Unified data across all departments"@en ;
    :hasBenefit "Real-time business visibility"@en ;
    :hasBenefit "Automated workflows reduce manual work by 60%"@en ;
    :hasChallenge "Expensive implementation (₺5M-50M)"@en ;
    :hasChallenge "Long deployment (12-24 months)"@en ;
    :hasChallenge "Change management complexity"@en ;
    :usesTool :SAPBusinessOne ;
    :usesTool :OracleNetSuite ;
    :usesTool :MicrosoftDynamics365 ;
    :fashionRetailExample """LC Waikiki SAP ERP Implementation:
    - Modules: Finance (FI), Controlling (CO), Materials Management (MM), Sales & Distribution (SD), Production Planning (PP)
    - Users: 5,000+ employees across 50 countries
    - Integration: 1,100 stores, 5 warehouses, e-commerce platform, suppliers
    - Transactions: 2M+ daily (orders, inventory movements, financial postings)
    - Benefits: Real-time inventory (99% accuracy), automated financial close (5 days → 2 days), unified reporting
    - Cost: ₺45M implementation, ₺8M annual licenses
    - ROI: 285% over 5 years"""@en ;
    :hasResource [
        rdfs:label "SAP for Retail Industry"@en ;
        :downloadURL <https://www.sap.com/industries/retail.html> ;
        :resourceType "ERP Solution"@en
    ] .

:InventoryManagementModule rdf:type owl:Class ;
    rdfs:subClassOf :ERPSystem ;
    rdfs:label "ERP Inventory Management"@en ;
    skos:definition "ERP module managing stock levels, movements, valuation, and optimization across multiple locations for fashion retail with seasonal variations"@en ;
    :hasBenefit "Real-time inventory visibility"@en ;
    :hasBenefit "Automated reordering"@en ;
    :hasBenefit "Multi-location tracking"@en ;
    :fashionRetailExample """Koton ERP Inventory Module:
    - Track 50,000 SKUs across 1,200 locations
    - Real-time sync every 5 minutes
    - Automated replenishment triggers
    - Seasonal inventory planning
    - FIFO/LIFO valuation methods
    - Dead stock identification
    - Result: Stockout reduction from 15% to 4%"""@en ;
    :hasResource [
        :downloadURL <https://docs.oracle.com/en/cloud/saas/netsuite/ns-online-help/book_3834577891.html> ;
        rdfs:label "NetSuite Inventory Management"@en
    ] .

:FinancialManagementModule rdf:type owl:Class ;
    rdfs:subClassOf :ERPSystem ;
    rdfs:label "ERP Financial Management"@en ;
    skos:definition "Financial accounting, management accounting, and reporting module handling general ledger, accounts payable/receivable, asset management, and financial consolidation for fashion retail groups"@en ;
    :hasBenefit "Automated financial close"@en ;
    :hasBenefit "Multi-currency, multi-entity"@en ;
    :hasBenefit "Real-time financial reporting"@en ;
    :fashionRetailExample """Defacto SAP FI/CO:
    - 15 legal entities (Turkey + international)
    - Multi-currency: TRY, EUR, USD, GBP
    - Automated intercompany eliminations
    - Real-time P&L by store, region, product
    - Integration: E-fatura (Turkish e-invoice)
    - Month-end close: 2 days
    - Annual audit: Clean opinion, SAP data trusted"""@en ;
    :hasResource [
        :downloadURL <https://help.sap.com/docs/SAP_S4HANA_ON-PREMISE/ce2e56c9b8844e68b8b0e84d7cb5c19c/> ;
        rdfs:label "SAP S/4HANA Finance"@en
    ] .

#################################################################
#    CRM SYSTEMS (50 Classes)
#################################################################

:CRMSystem rdf:type owl:Class ;
    rdfs:label "Customer Relationship Management System"@en ;
    skos:definition "Software managing customer interactions, sales processes, marketing campaigns, and customer service for Turkish fashion e-commerce building long-term relationships"@en ;
    :hasBenefit "360-degree customer view"@en ;
    :hasBenefit "Increased sales productivity 29%"@en ;
    :hasBenefit "Improved customer retention 27%"@en ;
    :usesTool :SalesforceCRM ;
    :usesTool :MicrosoftDynamicsCRM ;
    :usesTool :HubSpotCRM ;
    :fashionRetailExample """Trendyol Salesforce CRM:
    - 50M+ customer profiles
    - Sales pipeline: B2B seller acquisition
    - Marketing: Email campaigns, segmentation (500+ segments)
    - Service: Ticketing integration (100K tickets/month)
    - Analytics: Customer lifetime value, churn prediction
    - Mobile: Sales reps access on tablets
    - Integration: E-commerce platform, marketing automation, support
    - Result: 40% increase in seller acquisition, 25% better retention"""@en ;
    :hasResource [
        :downloadURL <https://www.salesforce.com/resources/guides/crm-implementation/> ;
        rdfs:label "CRM Implementation Guide"@en
    ] .

:CustomerSegmentation rdf:type owl:Class ;
    rdfs:subClassOf :CRMSystem ;
    rdfs:label "CRM Customer Segmentation"@en ;
    skos:definition "Dividing customer base into distinct groups based on demographics, behavior, value, and preferences for targeted marketing in fashion e-commerce"@en ;
    :hasBenefit "3-5x higher campaign response rates"@en ;
    :hasBenefit "Personalized experiences at scale"@en ;
    :fashionRetailExample """Hepsiburada Customer Segments:
    - Segmentation model: RFM + demographics + behavior
    - 500+ micro-segments
    - Key segments: "VIP Fashionistas" (high value, frequent), "Bargain Hunters" (price-sensitive, campaign-driven), "New Customers" (first 90 days)
    - Dynamic: Updated daily based on behavior
    - Activation: Email, SMS, push, web personalization
    - Result: Campaign ROI 4.2x (generic 1.5x)"""@en ;
    :hasResource [
        :downloadURL <https://www.hubspot.com/customer-segmentation> ;
        rdfs:label "Customer Segmentation Strategies"@en
    ] .

:LeadManagement rdf:type owl:Class ;
    rdfs:subClassOf :CRMSystem ;
    rdfs:label "Lead Management"@en ;
    skos:definition "Process of capturing, tracking, qualifying, and nurturing potential customers through sales funnel for B2B fashion marketplace seller acquisition"@en ;
    :hasBenefit "30% increase in conversion"@en ;
    :hasBenefit "50% faster sales cycle"@en ;
    :fashionRetailExample """N11 Seller Lead Management:
    - Lead sources: Website form, trade shows, referrals
    - Lead scoring: Company size, category, readiness
    - Nurturing: Email sequences, webinars, sales calls
    - Pipeline stages: New → Qualified → Demo → Negotiation → Closed
    - SLA: Respond to hot leads within 2 hours
    - Tools: Salesforce + Pardot automation
    - Conversion rate: 15% (up from 8%)"""@en ;
    :hasResource [
        :downloadURL <https://www.salesforce.com/products/guide/lead-gen/> ;
        rdfs:label "Lead Management Best Practices"@en
    ] .

#################################################################
#    BUSINESS INTELLIGENCE (60 Classes)
#################################################################

:BusinessIntelligence rdf:type owl:Class ;
    rdfs:label "Business Intelligence System"@en ;
    skos:definition "Technology-driven process for analyzing business data and presenting actionable information through dashboards, reports, and data visualization for fashion retail decision-making"@en ;
    :hasBenefit "Data-driven decisions"@en ;
    :hasBenefit "Real-time business insights"@en ;
    :hasBenefit "ROI: 12-15% revenue increase typical"@en ;
    :usesTool :Tableau ;
    :usesTool :PowerBI ;
    :usesTool :Looker ;
    :fashionRetailExample """Morhipo Business Intelligence Platform:
    - Tool: Tableau Server + Power BI
    - Data sources: E-commerce DB, Google Analytics, ERP, CRM
    - Users: 200+ (executives, managers, analysts)
    - Dashboards: Sales, inventory, marketing, operations (50+ dashboards)
    - Refresh: Real-time (sales) to daily (financial)
    - Key metrics: GMV, conversion rate, AOV, CAC, LTV, inventory turnover
    - Mobile: Executive dashboards on iPad
    - Impact: Faster decisions, identified ₺15M in savings"""@en ;
    :hasResource [
        :downloadURL <https://www.tableau.com/learn/articles/business-intelligence> ;
        rdfs:label "BI Best Practices"@en
    ] .

:ExecutiveDashboard rdf:type owl:Class ;
    rdfs:subClassOf :BusinessIntelligence ;
    rdfs:label "Executive Dashboard"@en ;
    skos:definition "High-level visual display of key performance indicators and metrics for C-suite executives to monitor business performance at a glance"@en ;
    :hasBenefit "Real-time business overview"@en ;
    :hasBenefit "Mobile access for executives"@en ;
    :fashionRetailExample """LC Waikiki CEO Dashboard:
    - Single screen: GMV, orders, conversion, AOV, new customers, inventory
    - Time filters: Today, WTD, MTD, YTD, vs last year
    - Geography: Turkey, MENA, Europe breakdown
    - Alerts: Red/yellow/green indicators for KPIs
    - Drill-down: Click for detailed reports
    - Mobile: iPhone app for CEO
    - Refresh: Every 15 minutes
    - Tool: Power BI"""@en ;
    :hasResource [
        :downloadURL <https://powerbi.microsoft.com/en-us/executive-dashboard/> ;
        rdfs:label "Executive Dashboard Design"@en
    ] .

:SalesAnalytics rdf:type owl:Class ;
    rdfs:subClassOf :BusinessIntelligence ;
    rdfs:label "Sales Analytics"@en ;
    skos:definition "Analysis of sales data to identify trends, forecast future sales, and optimize sales strategies for fashion retail across channels and products"@en ;
    :hasBenefit "Identify best/worst performers"@en ;
    :hasBenefit "Forecast accuracy 85%+"@en ;
    :fashionRetailExample """Koton Sales Analytics:
    - Dimensions: Product, category, store, region, channel, time
    - Metrics: Sales, units, margin, discount%, sell-through
    - Analysis: Cohort, basket, attribution, seasonality
    - Forecasting: ARIMA + ML for next quarter
    - Insights: "Denim category underperforming in coastal cities"
    - Actions: Regional assortment adjustment → +12% sales
    - Tool: Looker + BigQuery"""@en ;
    :hasResource [
        :downloadURL <https://cloud.google.com/looker/docs> ;
        rdfs:label "Looker Documentation"@en
    ] .

#################################################################
#    DATA WAREHOUSING (50 Classes)
#################################################################

:DataWarehouse rdf:type owl:Class ;
    rdfs:label "Data Warehouse"@en ;
    skos:definition "Centralized repository storing integrated data from multiple sources optimized for analysis and reporting, foundation for BI in fashion e-commerce with billions of transactions"@en ;
    :hasBenefit "Single source of truth"@en ;
    :hasBenefit "Historical data analysis (5+ years)"@en ;
    :hasBenefit "Fast query performance (sub-second)"@en ;
    :hasChallenge "Expensive (₺500K-5M annually)"@en ;
    :usesTool :Snowflake ;
    :usesTool :AWSRedshift ;
    :usesTool :GoogleBigQuery ;
    :fashionRetailExample """Trendyol Data Warehouse (Snowflake):
    - Data: 500TB (orders, customers, products, clickstream, inventory)
    - Sources: E-commerce DB, mobile apps, Google Analytics, ERP, CRM
    - ETL: Daily batch + real-time streaming (Kafka)
    - Schema: Star schema with fact/dimension tables
    - Users: 500+ analysts, data scientists, BI users
    - Queries: 50K+ daily queries
    - Performance: 95% queries < 3 seconds
    - Cost: $200K/month
    - ROI: Enabled data-driven culture, ₺50M+ in optimizations"""@en ;
    :hasResource [
        :downloadURL <https://www.snowflake.com/data-cloud-glossary/data-warehouse/> ;
        rdfs:label "Data Warehouse Guide"@en
    ] .

:DimensionalModeling rdf:type owl:Class ;
    rdfs:subClassOf :DataWarehouse ;
    rdfs:label "Dimensional Modeling"@en ;
    skos:definition "Data modeling technique for data warehouses using fact tables and dimension tables optimized for query performance in fashion retail analytics"@en ;
    :hasBenefit "Intuitive for business users"@en ;
    :hasBenefit "Fast query performance"@en ;
    :fashionRetailExample """Defacto Data Warehouse Schema:
    - Fact tables: Sales (200M rows), Inventory (50M rows), Web Events (5B rows)
    - Dimensions: Date, Product, Customer, Store, Employee, Promotion
    - Grain: Sales fact at order line item level
    - SCD Type 2: Product dimensions track historical changes
    - Aggregates: Pre-computed monthly, weekly summaries
    - Query: "Sales by category by month" → 0.5 seconds
    - Tool: Redshift with Kimball methodology"""@en ;
    :hasResource [
        :downloadURL <https://www.kimballgroup.com/data-warehouse-business-intelligence-resources/> ;
        rdfs:label "Kimball Dimensional Modeling"@en
    ] .

:DataLake rdf:type owl:Class ;
    rdfs:label "Data Lake"@en ;
    skos:definition "Centralized repository storing structured and unstructured data at any scale in raw format for Turkish fashion e-commerce big data analytics and ML"@en ;
    :hasBenefit "Store any type of data"@en ;
    :hasBenefit "Cost-effective (10x cheaper than DW)"@en ;
    :hasBenefit "ML/AI ready"@en ;
    :fashionRetailExample """Hepsiburada Data Lake (AWS S3):
    - Storage: 5PB (images, videos, logs, clickstream, social media)
    - Format: Parquet, JSON, CSV, images, videos
    - Zones: Raw → Curated → Analytics
    - Processing: Spark, Presto for queries
    - Use cases: ML training data, log analysis, image search
    - Cost: $50K/month (vs $500K for DW equivalent)
    - Governance: Data catalog, access control, lineage"""@en ;
    :hasResource [
        :downloadURL <https://aws.amazon.com/big-data/datalakes-and-analytics/> ;
        rdfs:label "Data Lake Architecture"@en
    ] .

#################################################################
#    ETL PROCESSES (40 Classes)
#################################################################

:ETLProcess rdf:type owl:Class ;
    rdfs:label "ETL (Extract, Transform, Load)"@en ;
    skos:definition "Process of extracting data from sources, transforming it to fit business needs, and loading into data warehouse for Turkish fashion retail analytics"@en ;
    :hasBenefit "Automated data integration"@en ;
    :hasBenefit "Data quality checks"@en ;
    :hasBenefit "Scheduled execution"@en ;
    :usesTool :ApacheAirflow ;
    :usesTool :Talend ;
    :usesTool :Informatica ;
    :fashionRetailExample """LC Waikiki ETL Pipeline:
    - Sources: SAP ERP, e-commerce DB, Google Analytics, Yurtiçi Cargo API
    - Frequency: Daily (financial), hourly (inventory), real-time (orders)
    - Transformations: Denormalization, aggregation, data cleansing, currency conversion
    - Quality: Null checks, referential integrity, duplicate detection
    - Orchestration: Apache Airflow (200+ DAGs)
    - Monitoring: Slack alerts on failures, retry logic
    - SLA: 95% jobs complete on time
    - Volume: 500GB daily processed"""@en ;
    :hasResource [
        :downloadURL <https://airflow.apache.org/docs/> ;
        rdfs:label "Apache Airflow Documentation"@en
    ] .

:DataTransformation rdf:type owl:Class ;
    rdfs:subClassOf :ETLProcess ;
    rdfs:label "Data Transformation"@en ;
    skos:definition "Converting data from source format to target format including cleansing, aggregation, normalization, and enrichment for fashion retail analytics"@en ;
    :hasBenefit "Consistent data format"@en ;
    :hasBenefit "Data quality improvement"@en ;
    :fashionRetailExample """Koton Data Transformations:
    - Cleansing: Remove duplicate customers, fix invalid emails
    - Standardization: Product names (uppercase, remove special chars)
    - Enrichment: Geocode addresses, add product categories
    - Aggregation: Daily sales by store
    - Currency: Convert all to TRY base
    - Date: Standardize to ISO format
    - Tool: dbt (data build tool)
    - Result: 99.5% data quality score"""@en ;
    :hasResource [
        :downloadURL <https://docs.getdbt.com/> ;
        rdfs:label "dbt Documentation"@en
    ] .

:RealTimeDataPipeline rdf:type owl:Class ;
    rdfs:subClassOf :ETLProcess ;
    rdfs:label "Real-Time Data Pipeline"@en ;
    skos:definition "Streaming data integration processing events as they occur for real-time analytics and operational systems in fashion e-commerce"@en ;
    :hasBenefit "Sub-second latency"@en ;
    :hasBenefit "Real-time insights"@en ;
    :usesTool :ApacheKafka ;
    :usesTool :ApacheFlink ;
    :fashionRetailExample """Trendyol Real-Time Pipeline:
    - Sources: Web clicks, mobile events, orders, inventory changes
    - Volume: 500K events per second
    - Processing: Kafka + Flink
    - Use cases: Real-time dashboards, fraud detection, inventory updates, personalization
    - Latency: <500ms end-to-end
    - Reliability: Exactly-once processing
    - Scale: Auto-scales to handle Black Friday traffic"""@en ;
    :hasResource [
        :downloadURL <https://kafka.apache.org/documentation/> ;
        rdfs:label "Kafka Documentation"@en
    ] .

#################################################################
#    SYSTEM INTEGRATION (60 Classes)
#################################################################

:EnterpriseServiceBus rdf:type owl:Class ;
    rdfs:label "Enterprise Service Bus (ESB)"@en ;
    skos:definition "Software architecture enabling communication between multiple applications through a common messaging system for Turkish fashion retail system integration"@en ;
    :hasBenefit "Decoupled systems"@en ;
    :hasBenefit "Centralized integration logic"@en ;
    :hasBenefit "Message transformation and routing"@en ;
    :usesTool :MuleSoft ;
    :usesTool :ApacheCamel ;
    :fashionRetailExample """Defacto ESB Implementation:
    - Systems: SAP ERP, e-commerce, WMS, POS, CRM, suppliers
    - Messages: 10M+ daily (orders, inventory, payments)
    - Patterns: Publish-subscribe, request-reply, message transformation
    - Protocol support: REST, SOAP, FTP, Database
    - Monitoring: Message tracking, error handling, replay
    - Tool: MuleSoft Anypoint Platform
    - Benefit: Reduced integration complexity from O(n²) to O(n)"""@en ;
    :hasResource [
        :downloadURL <https://www.mulesoft.com/resources/esb> ;
        rdfs:label "ESB Architecture Guide"@en
    ] .

:APIManagement rdf:type owl:Class ;
    rdfs:label "API Management Platform"@en ;
    skos:definition "Comprehensive platform for creating, publishing, documenting, securing, and analyzing APIs for fashion marketplace integration with sellers and partners"@en ;
    :hasBenefit "Secure API access"@en ;
    :hasBenefit "Rate limiting and throttling"@en ;
    :hasBenefit "Developer portal"@en ;
    :usesTool :Kong ;
    :usesTool :Apigee ;
    :fashionRetailExample """N11 API Management:
    - Public APIs: Seller integration (product catalog, orders, inventory)
    - Private APIs: Internal microservices (200+ APIs)
    - Security: OAuth 2.0, API keys, JWT
    - Rate limiting: 1,000 requests/hour per seller
    - Analytics: Usage tracking, performance monitoring
    - Developer portal: Documentation, sandbox, key management
    - SLA: 99.9% availability
    - Tool: Kong Gateway"""@en ;
    :hasResource [
        :downloadURL <https://docs.konghq.com/> ;
        rdfs:label "Kong API Gateway Documentation"@en
    ] .

:MessageQueue rdf:type owl:Class ;
    rdfs:label "Message Queue System"@en ;
    skos:definition "Asynchronous communication mechanism between services using queues for reliable message delivery in fashion e-commerce distributed systems"@en ;
    :hasBenefit "Asynchronous processing"@en ;
    :hasBenefit "Load leveling"@en ;
    :hasBenefit "Guaranteed delivery"@en ;
    :usesTool :RabbitMQ ;
    :usesTool :AmazonSQS ;
    :fashionRetailExample """Morhipo Message Queue:
    - Use cases: Order processing, email notifications, inventory sync
    - Tool: RabbitMQ (20 queues)
    - Pattern: Producer → Queue → Consumer
    - Reliability: Message persistence, acknowledgments
    - Scale: 100K messages/hour
    - Dead letter queue: Failed messages for retry
    - Monitoring: Queue depth, processing rate
    - Benefit: Decoupled services, handle traffic spikes"""@en ;
    :hasResource [
        :downloadURL <https://www.rabbitmq.com/documentation.html> ;
        rdfs:label "RabbitMQ Documentation"@en
    ] .

