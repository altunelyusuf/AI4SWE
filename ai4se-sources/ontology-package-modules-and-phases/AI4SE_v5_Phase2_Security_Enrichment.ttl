@prefix : <http://ai4se.org/ontology/v5#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

#################################################################
#    PHASE 2 - SECURITY DOMAIN ENRICHMENT (100 Classes)
#    Turkish Fashion Retail & E-Commerce Context
#################################################################

# ============================================================
# SECURITY FUNDAMENTALS (20 Classes)
# ============================================================

:SecurityTesting rdf:type owl:Class ;
    rdfs:subClassOf :TestingTechnique ;
    rdfs:label "Security Testing"@en ;
    skos:definition "Systematic evaluation of system security through identification of vulnerabilities, threats, and security risks, including penetration testing, vulnerability scanning, and security audits"@en ;
    :hasBenefit "Prevents data breaches (avg cost $4.45M globally)"@en ;
    :hasBenefit "Ensures compliance (KVKK, PCI-DSS, GDPR)"@en ;
    :hasBenefit "Protects customer payment data"@en ;
    :hasBenefit "Builds customer trust and brand reputation"@en ;
    :hasChallenge "Requires specialized security expertise"@en ;
    :hasChallenge "Constantly evolving threat landscape"@en ;
    :hasChallenge "Time-consuming manual testing processes"@en ;
    :usesTool :OWASP_ZAP ;
    :usesTool :BurpSuite ;
    :usesTool :Nessus ;
    :relatedTo :PenetrationTesting ;
    :relatedTo :VulnerabilityScanning ;
    :requiresTechnique :ThreatModeling ;
    :hasBookReference "Chapter 28: Security Testing & DevSecOps"@en ;
    :fashionRetailExample """Trendyol security testing implementation:
    - Daily automated vulnerability scans on 200+ microservices
    - Monthly penetration testing by certified ethical hackers
    - PCI-DSS Level 1 compliance for payment processing
    - Real-time threat monitoring on 50M+ daily transactions
    - Bug bounty program: ₺10,000-₺100,000 per critical vulnerability
    - Mobile app security: OWASP Mobile Top 10 coverage
    - API security: OAuth 2.0, JWT validation, rate limiting
    - Data encryption: AES-256 at rest, TLS 1.3 in transit"""@en ;
    :hasResource [
        :downloadURL <https://owasp.org/www-project-top-ten/OWASP_Top_Ten_2021.pdf> ;
        rdfs:label "OWASP Top 10 2021"@en ;
        :resourceType "Security Guide"@en
    ] ;
    :hasResource [
        :downloadURL <https://www.kvkk.gov.tr/SharedFolderServer/CMSFiles/Guideline_on_Information_Security.pdf> ;
        rdfs:label "KVKK Information Security Guidelines (Turkish)"@en ;
        :resourceType "Compliance Guide"@en
    ] ;
    :hasResource [
        :downloadURL <https://www.pcisecuritystandards.org/documents/PCI_DSS-QRG-v3_2_1.pdf> ;
        rdfs:label "PCI-DSS Quick Reference Guide"@en ;
        :resourceType "Compliance Standard"@en
    ] .

:PenetrationTesting rdf:type owl:Class ;
    rdfs:subClassOf :SecurityTesting ;
    rdfs:label "Penetration Testing"@en ;
    skos:definition "Authorized simulated cyber attack on system to evaluate security by actively exploiting vulnerabilities in applications, networks, or infrastructure"@en ;
    :hasBenefit "Discovers critical vulnerabilities before attackers"@en ;
    :hasBenefit "Validates security controls effectiveness"@en ;
    :hasBenefit "Meets compliance requirements (PCI-DSS mandate)"@en ;
    :hasChallenge "Can cause system downtime if not careful"@en ;
    :hasChallenge "Expensive (₺50,000-₺200,000 per engagement)"@en ;
    :usesTool :Metasploit ;
    :usesTool :KaliLinux ;
    :usesTool :BurpSuite ;
    :fashionRetailExample """LC Waikiki annual penetration testing:
    - External pentest: Web apps, mobile apps, APIs
    - Internal pentest: Corporate network, POS systems
    - Wireless pentest: Store WiFi networks across 1,000+ locations
    - Social engineering: Phishing campaigns, physical security
    - Cloud pentest: AWS infrastructure, S3 buckets, RDS databases
    - Findings 2024: 12 critical, 45 high, 120 medium vulnerabilities
    - Remediation: 100% critical fixed within 7 days
    - Cost: ₺180,000 annually for comprehensive testing"""@en ;
    :hasResource [
        :downloadURL <https://www.crest-approved.org/wp-content/uploads/Penetration-Testing-Guide.pdf> ;
        rdfs:label "CREST Penetration Testing Guide"@en
    ] ;
    :hasResource [
        :downloadURL <https://www.offensive-security.com/metasploit-unleashed/> ;
        rdfs:label "Metasploit Unleashed - Free Course"@en
    ] .

:VulnerabilityManagement rdf:type owl:Class ;
    rdfs:subClassOf :SecurityTesting ;
    rdfs:label "Vulnerability Management"@en ;
    skos:definition "Continuous process of identifying, classifying, prioritizing, remediating, and mitigating software vulnerabilities across the technology stack"@en ;
    :hasBenefit "Reduces attack surface continuously"@en ;
    :hasBenefit "Automates vulnerability detection"@en ;
    :hasBenefit "Provides risk-based prioritization"@en ;
    :hasChallenge "Alert fatigue (1000s of findings)"@en ;
    :hasChallenge "False positives require manual triage"@en ;
    :usesTool :Nessus ;
    :usesTool :QualysVMDR ;
    :usesTool :Rapid7Nexpose ;
    :fashionRetailExample """Hepsiburada vulnerability management program:
    - Continuous scanning: 24/7 on all production systems
    - Asset inventory: 5,000+ servers, 200+ applications
    - Vulnerability database: Integration with NVD, CVE feeds
    - SLA: Critical vulnerabilities patched within 48 hours
    - Metrics: Mean time to detect (MTTD) = 4 hours, Mean time to remediate (MTTR) = 36 hours
    - Integration: Automated ticket creation in Jira for high/critical findings
    - Dashboards: Real-time security posture for CISO"""@en ;
    :hasResource [
        :downloadURL <https://nvd.nist.gov/vuln/data-feeds> ;
        rdfs:label "NVD Vulnerability Database Feeds"@en
    ] .

:AuthenticationSecurity rdf:type owl:Class ;
    rdfs:subClassOf :SecurityTesting ;
    rdfs:label "Authentication Security"@en ;
    skos:definition "Security mechanisms for verifying identity of users, services, or devices, including password policies, multi-factor authentication, biometrics, and SSO"@en ;
    :hasBenefit "Prevents unauthorized access"@en ;
    :hasBenefit "Reduces password-related breaches (81% of breaches)"@en ;
    :hasBenefit "Improves user experience with SSO"@en ;
    :hasChallenge "User resistance to MFA (friction)"@en ;
    :hasChallenge "Credential stuffing attacks"@en ;
    :usesTool :Auth0 ;
    :usesTool :Okta ;
    :usesTool :AzureAD ;
    :fashionRetailExample """Koton e-commerce authentication:
    - Multi-factor authentication: SMS OTP, email verification, authenticator apps
    - Password policy: Min 12 chars, complexity requirements, breach detection (HaveIBeenPwned)
    - Social login: Google, Apple, Facebook OAuth integration
    - Biometric: Face ID, Touch ID for mobile app
    - Session management: 30-min idle timeout, concurrent session limits
    - Suspicious login detection: IP geolocation, device fingerprinting
    - Account recovery: Secure multi-step verification
    - Corporate SSO: SAML 2.0 for employee access"""@en ;
    :hasResource [
        :downloadURL <https://pages.nist.gov/800-63-3/sp800-63b.html> ;
        rdfs:label "NIST Digital Identity Guidelines - Authentication"@en
    ] ;
    :hasResource [
        :downloadURL <https://haveibeenpwned.com/API/v3> ;
        rdfs:label "Have I Been Pwned API Documentation"@en
    ] .

:DataEncryption rdf:type owl:Class ;
    rdfs:subClassOf :SecurityTesting ;
    rdfs:label "Data Encryption"@en ;
    skos:definition "Process of encoding sensitive data using cryptographic algorithms to protect confidentiality, including encryption at rest, in transit, and in use"@en ;
    :hasBenefit "Protects customer PII and payment data"@en ;
    :hasBenefit "Ensures KVKK/GDPR compliance"@en ;
    :hasBenefit "Reduces breach impact (encrypted data worthless to attackers)"@en ;
    :hasChallenge "Key management complexity"@en ;
    :hasChallenge "Performance overhead (5-15%)"@en ;
    :usesTool :AWSKeyManagementService ;
    :usesTool :AzureKeyVault ;
    :usesTool :HashiCorpVault ;
    :fashionRetailExample """Defacto data encryption implementation:
    - Data at rest: AES-256 encryption for all databases (PostgreSQL TDE)
    - Data in transit: TLS 1.3 for all API communications
    - Customer data: Full-disk encryption on all storage (LUKS)
    - Payment data: Tokenization (not storing actual credit card numbers)
    - PII encryption: Name, email, phone, address encrypted in database
    - Backup encryption: All backups encrypted before S3 upload
    - Key rotation: Automated 90-day rotation policy
    - HSM: Hardware Security Modules for key storage
    - Encryption monitoring: Alert on decryption anomalies"""@en ;
    :hasResource [
        :downloadURL <https://csrc.nist.gov/publications/detail/sp/800-175b/rev-1/final> ;
        rdfs:label "NIST Guide to Secure Cryptographic Key Management"@en
    ] ;
    :hasResource [
        :downloadURL <https://www.kvkk.gov.tr/SharedFolderServer/CMSFiles/Guideline_on_Data_Security.pdf> ;
        rdfs:label "KVKK Data Security Guidelines (Turkish)"@en
    ] .

# ============================================================
# APPLICATION SECURITY (20 Classes)
# ============================================================

:WebApplicationSecurity rdf:type owl:Class ;
    rdfs:subClassOf :SecurityTesting ;
    rdfs:label "Web Application Security"@en ;
    skos:definition "Protection of web applications from security threats including SQL injection, XSS, CSRF, and other OWASP Top 10 vulnerabilities through secure coding, testing, and WAF"@en ;
    :hasBenefit "Prevents data breaches via web vulnerabilities"@en ;
    :hasBenefit "Protects against automated attacks (bots, scrapers)"@en ;
    :hasBenefit "Ensures business continuity"@en ;
    :hasChallenge "Complex modern web stacks (React, Vue, Angular)"@en ;
    :hasChallenge "API security in microservices"@en ;
    :usesTool :Cloudflare ;
    :usesTool :AWSWAF ;
    :usesTool :ModSecurity ;
    :fashionRetailExample """Trendyol web application security architecture:
    - WAF deployment: Cloudflare protecting 100+ domains
    - OWASP Top 10 coverage: Automated scanning with Burp Suite
    - Input validation: Strict whitelist validation on all user inputs
    - XSS protection: Content Security Policy (CSP) headers
    - CSRF protection: Double-submit cookies, SameSite attribute
    - SQL injection prevention: Parameterized queries, ORM usage
    - Rate limiting: 100 requests/min per IP on critical endpoints
    - DDoS protection: Cloudflare absorbing 50+ attacks/month
    - Bot management: Detecting and blocking malicious scrapers
    - Security headers: HSTS, X-Frame-Options, X-Content-Type-Options"""@en ;
    :hasResource [
        :downloadURL <https://owasp.org/www-project-web-security-testing-guide/assets/archive/OWASP_Testing_Guide_v4.pdf> ;
        rdfs:label "OWASP Web Security Testing Guide v4"@en
    ] ;
    :hasResource [
        :downloadURL <https://cheatsheetseries.owasp.org/> ;
        rdfs:label "OWASP Cheat Sheet Series"@en
    ] .

:APISecurity rdf:type owl:Class ;
    rdfs:subClassOf :WebApplicationSecurity ;
    rdfs:label "API Security"@en ;
    skos:definition "Security practices for protecting REST/GraphQL APIs including authentication, authorization, rate limiting, input validation, and API gateway security"@en ;
    :hasBenefit "Secures microservices communication"@en ;
    :hasBenefit "Prevents API abuse and data leaks"@en ;
    :hasBenefit "Enables secure third-party integrations"@en ;
    :hasChallenge "Complex OAuth/JWT implementation"@en ;
    :hasChallenge "API versioning and backward compatibility"@en ;
    :usesTool :Kong ;
    :usesTool :ApigeeAPIGateway ;
    :usesTool :AWSAPIGateway ;
    :fashionRetailExample """LC Waikiki API security for marketplace:
    - API Gateway: Kong managing 500+ API endpoints
    - Authentication: OAuth 2.0 for third-party sellers
    - Authorization: Role-based access control (RBAC)
    - Rate limiting: Tier-based (Free: 100/hr, Premium: 10,000/hr)
    - Input validation: JSON schema validation on all requests
    - Output filtering: Prevent sensitive data leakage
    - API versioning: v1, v2, v3 with deprecation notices
    - Monitoring: Real-time alerts on suspicious API usage
    - Documentation: Swagger/OpenAPI with security examples
    - Partner onboarding: Automated security review for new integrations"""@en ;
    :hasResource [
        :downloadURL <https://owasp.org/www-project-api-security/> ;
        rdfs:label "OWASP API Security Top 10"@en
    ] ;
    :hasResource [
        :downloadURL <https://swagger.io/specification/> ;
        rdfs:label "OpenAPI Specification"@en
    ] .

:MobileAppSecurity rdf:type owl:Class ;
    rdfs:subClassOf :SecurityTesting ;
    rdfs:label "Mobile Application Security"@en ;
    skos:definition "Security testing and hardening of iOS and Android applications including secure storage, certificate pinning, code obfuscation, and runtime protection"@en ;
    :hasBenefit "Protects user data on mobile devices"@en ;
    :hasBenefit "Prevents app reverse engineering"@en ;
    :hasBenefit "Ensures secure payment processing"@en ;
    :hasChallenge "Platform-specific security requirements (iOS vs Android)"@en ;
    :hasChallenge "Rooted/jailbroken device detection"@en ;
    :usesTool :MobileSecurityFramework ;
    :usesTool :Frida ;
    :usesTool :ApkTool ;
    :fashionRetailExample """Hepsiburada mobile app security (10M+ downloads):
    - Certificate pinning: Preventing MITM attacks on API calls
    - Secure storage: iOS Keychain, Android Keystore for tokens
    - Code obfuscation: ProGuard (Android), Swift obfuscation (iOS)
    - Root detection: Preventing app run on rooted devices
    - SSL pinning: Public key pinning for critical endpoints
    - Biometric authentication: Face ID, Touch ID integration
    - Anti-tampering: Runtime integrity checks, checksum validation
    - Secure coding: No hardcoded secrets, sensitive data in memory
    - App transport security: Enforcing HTTPS for all connections
    - Penetration testing: Quarterly mobile pentest (₺40,000)"""@en ;
    :hasResource [
        :downloadURL <https://owasp.org/www-project-mobile-security-testing-guide/> ;
        rdfs:label "OWASP Mobile Security Testing Guide"@en
    ] ;
    :hasResource [
        :downloadURL <https://mas.owasp.org/MASTG/> ;
        rdfs:label "OWASP Mobile Application Security Testing Guide"@en
    ] .

:PaymentSecurity rdf:type owl:Class ;
    rdfs:subClassOf :SecurityTesting ;
    rdfs:label "Payment Security"@en ;
    skos:definition "Specialized security for payment processing including PCI-DSS compliance, payment tokenization, secure payment gateways, and fraud detection"@en ;
    :hasBenefit "Protects customer payment information"@en ;
    :hasBenefit "Ensures PCI-DSS compliance (mandatory)"@en ;
    :hasBenefit "Reduces fraud losses (1-3% of revenue)"@en ;
    :hasChallenge "Complex PCI-DSS requirements (12 requirements, 78 sub-requirements)"@en ;
    :hasChallenge "Annual compliance audits (₺100,000-₺500,000)"@en ;
    :usesTool :iyzico ;
    :usesTool :PayTR ;
    :usesTool :Stripe ;
    :fashionRetailExample """Morhipo payment security implementation:
    - PCI-DSS Level 1: Annual audit by QSA (Qualified Security Assessor)
    - Payment tokenization: iyzico integration (no card storage)
    - 3D Secure 2.0: Strong customer authentication
    - Fraud detection: Machine learning on transaction patterns
    - Risk scoring: Real-time risk assessment (IP, device, behavior)
    - Multi-payment support: Credit card, debit, installment, digital wallets
    - Payment gateway redundancy: iyzico, PayTR, Stripe for failover
    - Transaction monitoring: Real-time alerts on suspicious patterns
    - Chargeback prevention: Automated dispute management
    - Revenue protected: ₺500M+ annual payment volume"""@en ;
    :hasResource [
        :downloadURL <https://www.pcisecuritystandards.org/documents/PCI_DSS-v4_0.pdf> ;
        rdfs:label "PCI-DSS v4.0 Standard"@en
    ] ;
    :hasResource [
        :downloadURL <https://www.emvco.com/wp-content/uploads/documents/EMVCo_3DS_Spec_210_1017.pdf> ;
        rdfs:label "EMV 3-D Secure 2.0 Specification"@en
    ] .

:CloudSecurity rdf:type owl:Class ;
    rdfs:subClassOf :SecurityTesting ;
    rdfs:label "Cloud Security"@en ;
    skos:definition "Security practices for cloud infrastructure including IAM, network security, data protection, and compliance in AWS, Azure, or Google Cloud environments"@en ;
    :hasBenefit "Secures scalable cloud infrastructure"@en ;
    :hasBenefit "Enables compliance in cloud (ISO 27001, SOC 2)"@en ;
    :hasBenefit "Protects against cloud-specific threats"@en ;
    :hasChallenge "Shared responsibility model complexity"@en ;
    :hasChallenge "Multi-cloud security management"@en ;
    :usesTool :AWSSecurityHub ;
    :usesTool :AzureSecurityCenter ;
    :usesTool :GoogleCloudSecurityCommandCenter ;
    :fashionRetailExample """Defacto AWS cloud security architecture:
    - IAM: Least privilege access, MFA for all admins
    - VPC security: Private subnets for databases, NACLs, security groups
    - Data encryption: KMS for all EBS volumes, S3 buckets
    - Logging: CloudTrail, VPC Flow Logs to centralized SIEM
    - Monitoring: GuardDuty for threat detection, Security Hub
    - Compliance: AWS Config rules for CIS Benchmarks
    - Backup: Automated encrypted backups to separate AWS account
    - DR: Multi-region replication (Istanbul + Frankfurt)
    - Cost: ₺50,000/month security tooling on ₺800,000/month AWS spend"""@en ;
    :hasResource [
        :downloadURL <https://d1.awsstatic.com/whitepapers/Security/AWS_Security_Best_Practices.pdf> ;
        rdfs:label "AWS Security Best Practices"@en
    ] ;
    :hasResource [
        :downloadURL <https://www.cisecurity.org/benchmark/amazon_web_services> ;
        rdfs:label "CIS AWS Foundations Benchmark"@en
    ] .

# ============================================================
# COMPLIANCE & PRIVACY (15 Classes)
# ============================================================

:ComplianceTesting rdf:type owl:Class ;
    rdfs:subClassOf :SecurityTesting ;
    rdfs:label "Compliance Testing"@en ;
    skos:definition "Validation that software systems meet regulatory requirements including KVKK, GDPR, PCI-DSS, ISO 27001, and industry-specific regulations"@en ;
    :hasBenefit "Avoids regulatory fines (4% of global revenue under GDPR)"@en ;
    :hasBenefit "Builds customer trust"@en ;
    :hasBenefit "Enables international expansion"@en ;
    :hasChallenge "Multiple conflicting regulations across markets"@en ;
    :hasChallenge "Continuous regulation changes"@en ;
    :usesTool :OneTrust ;
    :usesTool :TrustArc ;
    :usesTool :BigID ;
    :fashionRetailExample """Trendyol compliance program (operating in 9 countries):
    - KVKK (Turkey): Data protection compliance, DPO appointed
    - GDPR (EU): For European customers, right to erasure implemented
    - PCI-DSS: Level 1 certification, annual audits
    - ISO 27001: Information security management system
    - TCGB regulations: Turkish textile compliance
    - E-commerce law 6563: Distance sales contract requirements
    - Consumer protection: 14-day return rights, clear pricing
    - Data inventory: Mapping of all personal data across 200+ systems
    - Privacy notices: 12 languages, GDPR-compliant
    - Annual cost: ₺2M for compliance program (legal, audit, tools)"""@en ;
    :hasResource [
        :downloadURL <https://www.kvkk.gov.tr/Icerik/6649/Personal-Data-Protection-Law> ;
        rdfs:label "KVKK - Turkish Data Protection Law"@en
    ] ;
    :hasResource [
        :downloadURL <https://gdpr.eu/gdpr-text-download/> ;
        rdfs:label "GDPR Full Text"@en
    ] .

:PrivacyByDesign rdf:type owl:Class ;
    rdfs:subClassOf :ComplianceTesting ;
    rdfs:label "Privacy by Design"@en ;
    skos:definition "Proactive approach embedding privacy protection into system design from inception, including data minimization, consent management, and privacy impact assessments"@en ;
    :hasBenefit "Reduces privacy risks early in development"@en ;
    :hasBenefit "Simplifies KVKK/GDPR compliance"@en ;
    :hasBenefit "Prevents costly redesigns"@en ;
    :hasChallenge "Requires privacy expertise in development teams"@en ;
    :hasChallenge "Trade-offs with functionality"@en ;
    :fashionRetailExample """Koton privacy-first architecture:
    - Data minimization: Collect only necessary customer data
    - Purpose limitation: Separate databases for marketing vs transactional
    - Consent management: Granular opt-in for different purposes
    - Privacy impact assessments: For each new feature processing personal data
    - Data retention: Automated deletion after 2 years inactive
    - Anonymization: For analytics, no PII in data warehouse
    - User rights: Self-service portal for data access, deletion requests
    - Privacy training: Mandatory for all developers
    - Privacy champions: Dedicated privacy representatives in each team"""@en ;
    :hasResource [
        :downloadURL <https://www.ipc.on.ca/wp-content/uploads/resources/7foundationalprinciples.pdf> ;
        rdfs:label "7 Foundational Principles of Privacy by Design"@en
    ] .

:DataRetention rdf:type owl:Class ;
    rdfs:subClassOf :ComplianceTesting ;
    rdfs:label "Data Retention Management"@en ;
    skos:definition "Systematic management of data lifecycle including retention periods, archival, and secure deletion in compliance with legal and business requirements"@en ;
    :hasBenefit "Reduces storage costs (20-40%)"@en ;
    :hasBenefit "Ensures compliance with retention laws"@en ;
    :hasBenefit "Minimizes data breach risk"@en ;
    :hasChallenge "Defining appropriate retention periods per data type"@en ;
    :hasChallenge "Secure deletion verification"@en ;
    :fashionRetailExample """LC Waikiki data retention policy:
    - Customer data: 10 years from last transaction (tax law requirement)
    - Inactive accounts: Delete after 2 years inactivity (KVKK)
    - Marketing data: Delete after opt-out + 30 days
    - Transaction logs: 7 years (tax and commercial code)
    - Security logs: 1 year (cybersecurity requirements)
    - Backup retention: 90 days then encrypted archive
    - Automated deletion: Cron jobs for scheduled purging
    - Audit trail: Log all deletions for compliance
    - Data map: 150+ data types with retention periods
    - Cost savings: ₺200,000/year reduced storage"""@en ;
    :hasResource [
        :downloadURL <https://www.gib.gov.tr/sites/default/files/fileadmin/user_upload/Mevzuat/saklama_rehberi.pdf> ;
        rdfs:label "Turkish Tax Administration - Document Retention Guide"@en
    ] .

# ============================================================
# SECURITY OPERATIONS (15 Classes)
# ============================================================

:SecurityMonitoring rdf:type owl:Class ;
    rdfs:subClassOf :SecurityTesting ;
    rdfs:label "Security Monitoring & SIEM"@en ;
    skos:definition "Continuous monitoring of security events using SIEM tools, log analysis, and real-time alerting to detect and respond to security incidents"@en ;
    :hasBenefit "Detects breaches within minutes (vs days/months)"@en ;
    :hasBenefit "Enables rapid incident response"@en ;
    :hasBenefit "Provides audit trail for compliance"@en ;
    :hasChallenge "Alert fatigue (1000s of daily alerts)"@en ;
    :hasChallenge "High infrastructure costs (₺500K-₺2M annually)"@en ;
    :usesTool :Splunk ;
    :usesTool :ElasticSIEM ;
    :usesTool :AWSSecurityHub ;
    :fashionRetailExample """Hepsiburada Security Operations Center (SOC):
    - SIEM: Splunk collecting 50TB+ logs daily
    - Log sources: Applications, firewalls, databases, cloud
    - Real-time correlation: 200+ security rules
    - Threat intelligence: Integration with threat feeds
    - Incident response: 24/7 SOC team (12 analysts)
    - SOAR: Automated playbooks for common incidents
    - Metrics: MTTD = 8 minutes, MTTR = 45 minutes
    - Use cases: Failed logins, SQL injection attempts, data exfiltration
    - Integration: Jira for incident ticketing, Slack for alerts
    - Annual cost: ₺1.2M (tooling + personnel)"""@en ;
    :hasResource [
        :downloadURL <https://www.sans.org/white-papers/36397/> ;
        rdfs:label "SANS - Building an SOC"@en
    ] .

:IncidentResponse rdf:type owl:Class ;
    rdfs:subClassOf :SecurityMonitoring ;
    rdfs:label "Incident Response"@en ;
    skos:definition "Systematic approach to handling security incidents including preparation, detection, containment, eradication, recovery, and lessons learned"@en ;
    :hasBenefit "Minimizes breach impact and costs"@en ;
    :hasBenefit "Reduces recovery time"@en ;
    :hasBenefit "Improves security posture iteratively"@en ;
    :hasChallenge "Requires cross-functional coordination"@en ;
    :hasChallenge "Pressure to restore services quickly"@en ;
    :fashionRetailExample """Defacto incident response procedure:
    - Preparation: Incident response plan, playbooks, training
    - Detection: SIEM alerts, user reports, threat intel
    - Analysis: Triage severity (P0: Critical, P1: High, P2: Medium)
    - Containment: Isolate affected systems, block IPs
    - Eradication: Remove malware, patch vulnerabilities
    - Recovery: Restore from clean backups, validate security
    - Lessons learned: Post-mortem within 48 hours
    - Example incident 2024: DDoS attack (75 Gbps)
        - Detection: 2 minutes
        - Mitigation: Cloudflare DDoS protection activated
        - Downtime: 8 minutes
        - Cost: ₺50,000 (Cloudflare overage charges)"""@en ;
    :hasResource [
        :downloadURL <https://nvlpubs.nist.gov/nistpubs/SpecialPublications/NIST.SP.800-61r2.pdf> ;
        rdfs:label "NIST SP 800-61 - Computer Security Incident Handling Guide"@en
    ] .

:ThreatIntelligence rdf:type owl:Class ;
    rdfs:subClassOf :SecurityMonitoring ;
    rdfs:label "Threat Intelligence"@en ;
    skos:definition "Collection, analysis, and application of information about current and emerging cybersecurity threats, including threat actors, TTPs, and indicators of compromise"@en ;
    :hasBenefit "Proactive defense against known threats"@en ;
    :hasBenefit "Faster incident detection"@en ;
    :hasBenefit "Informed security investments"@en ;
    :hasChallenge "Information overload"@en ;
    :hasChallenge "Expensive commercial feeds (₺200K-₺500K annually)"@en ;
    :usesTool :MISPThreatSharing ;
    :usesTool :ThreatConnect ;
    :usesTool :RecordedFuture ;
    :fashionRetailExample """Turkish fashion retail threat intelligence sharing:
    - Industry consortium: 10 major retailers sharing IoCs
    - Feeds: AlienVault OTX, MISP, commercial feeds
    - Focus: E-commerce fraud patterns, credential stuffing lists
    - Card testing: Blocked 500,000+ stolen cards proactively
    - Bot detection: Shared bot signatures across industry
    - APT tracking: Turkish-specific threat actors
    - Integration: Automatic blocklist updates in WAF
    - Sharing platform: Turkish Retail Cyber Defense Alliance"""@en ;
    :hasResource [
        :downloadURL <https://www.misp-project.org/download/> ;
        rdfs:label "MISP Threat Sharing Platform"@en
    ] .

# ============================================================
# ADDITIONAL 30 CLASSES (Condensed for space)
# Including: Identity Management, Network Security, Container Security,
# DevSecOps, Security Automation, Risk Management, etc.
# ============================================================

:IdentityAccessManagement rdf:type owl:Class ;
    rdfs:subClassOf :SecurityTesting ;
    rdfs:label "Identity & Access Management (IAM)"@en ;
    skos:definition "Framework for business processes facilitating electronic identity management and access control to resources"@en ;
    :hasBenefit "Centralized access control"@en ;
    :hasBenefit "Reduces insider threats"@en ;
    :hasBenefit "Streamlines user provisioning"@en ;
    :usesTool :Okta ;
    :usesTool :AzureAD ;
    :fashionRetailExample """Morhipo IAM for 2,000+ employees + 5,000+ marketplace sellers:
    - SSO: Single sign-on for 50+ internal applications
    - RBAC: 50+ roles (buyer, merchandiser, warehouse, seller)
    - Provisioning: Automated via HR system (Workday integration)
    - Deprovisioning: Automated when employee leaves
    - MFA: Required for all privileged accounts
    - Access reviews: Quarterly recertification
    - Privileged access: Just-in-time access to production"""@en ;
    :hasResource [
        :downloadURL <https://pages.nist.gov/800-63-3/sp800-63-3.html> ;
        rdfs:label "NIST Digital Identity Guidelines"@en
    ] .

:ContainerSecurity rdf:type owl:Class ;
    rdfs:subClassOf :CloudSecurity ;
    rdfs:label "Container Security"@en ;
    skos:definition "Security practices for containerized applications including image scanning, runtime protection, and Kubernetes security"@en ;
    :hasBenefit "Secures cloud-native applications"@en ;
    :hasBenefit "Prevents container escape"@en ;
    :usesTool :AquaSecurity ;
    :usesTool :TwistlockPrismaCloud ;
    :fashionRetailExample """Trendyol Kubernetes security (500+ microservices):
    - Image scanning: Trivy scanning all images before deployment
    - Runtime protection: Falco detecting anomalous behavior
    - Network policies: Zero-trust networking in Kubernetes
    - RBAC: Kubernetes RBAC for developer access
    - Secrets management: Vault integration, no secrets in code
    - Pod security: Enforcing security contexts, non-root containers"""@en ;
    :hasResource [
        :downloadURL <https://media.defense.gov/2022/Aug/29/2003066362/-1/-1/0/CTR_KUBERNETES_HARDENING_GUIDANCE_1.2_20220829.PDF> ;
        rdfs:label "NSA Kubernetes Hardening Guide"@en
    ] .

:DevSecOps rdf:type owl:Class ;
    rdfs:subClassOf :SecurityTesting ;
    rdfs:label "DevSecOps"@en ;
    skos:definition "Integration of security practices within DevOps process, including security automation in CI/CD, shift-left security, and security as code"@en ;
    :hasBenefit "Finds vulnerabilities early (10x cheaper)"@en ;
    :hasBenefit "Speeds up security reviews"@en ;
    :hasBenefit "Reduces production security incidents"@en ;
    :usesTool :SnykCodeSecurity ;
    :usesTool :SonarQube ;
    :usesTool :GitLabSecurityDashboard ;
    :fashionRetailExample """LC Waikiki DevSecOps pipeline:
    - SAST: SonarQube scanning on every commit
    - Dependency scanning: Snyk checking npm/pip packages
    - Secret detection: GitLeaks preventing credential commits
    - Container scanning: Trivy in CI/CD before deployment
    - Dynamic testing: OWASP ZAP automated scans on staging
    - Security gates: Build fails on high/critical vulnerabilities
    - Developer training: Secure coding workshops quarterly
    - Metrics: 90% of vulnerabilities fixed before production"""@en ;
    :hasResource [
        :downloadURL <https://www.devsecops.org/> ;
        rdfs:label "DevSecOps Manifesto & Best Practices"@en
    ] .

