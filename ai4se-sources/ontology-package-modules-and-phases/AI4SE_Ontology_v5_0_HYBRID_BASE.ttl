#################################################################
#    OBJECT PROPERTIES (Enhanced)
#################################################################

:hasSubdomain rdf:type owl:ObjectProperty ;
    rdfs:label "has subdomain"@en ;
    rdfs:domain :SEConcept ;
    rdfs:range :SEConcept .

:usesTechnique rdf:type owl:ObjectProperty ;
    rdfs:label "uses technique"@en .

:usesTool rdf:type owl:ObjectProperty ;
    rdfs:label "uses tool"@en .

:appliesTo rdf:type owl:ObjectProperty ;
    rdfs:label "applies to"@en .

:requires rdf:type owl:ObjectProperty ;
    rdfs:label "requires"@en .

:requiresTechnique rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :requires ;
    rdfs:label "requires technique"@en .

:enables rdf:type owl:ObjectProperty ;
    rdfs:label "enables"@en .

:implements rdf:type owl:ObjectProperty ;
    rdfs:label "implements"@en .

:hasBenefit rdf:type owl:DatatypeProperty ;
    rdfs:label "has benefit"@en ;
    rdfs:range xsd:string .

:hasChallenge rdf:type owl:DatatypeProperty ;
    rdfs:label "has challenge"@en ;
    rdfs:range xsd:string .

:hasBookReference rdf:type owl:DatatypeProperty ;
    rdfs:label "has book reference"@en ;
    rdfs:comment "References specific book chapter or section"@en ;
    rdfs:range xsd:string .

:hasResource rdf:type owl:ObjectProperty ;
    rdfs:label "has downloadable resource"@en ;
    rdfs:comment "Links to downloadable resources, documentation, or references"@en .

#################################################################
#    MERGE METADATA & TRACKING
#################################################################

:MergeMetadata rdf:type owl:NamedIndividual ;
    rdfs:label "Ontology Merge Metadata"@en ;
    :mergeDate "2025-11-17"^^xsd:date ;
    :sourceOntology "AI4SE v4.5 Enterprise Edition (3,142 classes)" ;
    :sourceOntology "AI4SE v4.0 Deep Modules (254 classes)" ;
    :mergeStrategy "Preserve deep enrichment, add Enterprise breadth" ;
    :totalClassesBefore "3,142 + 254 = 3,396 (with ~80 duplicates)" ;
    :totalClassesAfter "3,142 (deduplicated)" ;
    :enrichedClasses "754 (24% of total)" ;
    :basicClasses "2,388 (76% of total)" .

