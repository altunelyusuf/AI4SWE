@prefix : <http://ai4se.org/ontology/v5#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf: <http://www.w3.org/1999/02/22-rdf-schema-for-rdf-schema#> .

#################################################################
#    AI4SE ONTOLOGY v5.0 HYBRID ULTIMATE EDITION
#    Combining Enterprise Breadth + Deep Integration
#    Special Focus: Turkish Fashion Retail & E-Commerce
#################################################################

<http://ai4se.org/ontology/v5> rdf:type owl:Ontology ;
    dcterms:title "AI4SE Ontology v5.0 HYBRID ULTIMATE - Turkish Fashion Retail Edition"@en ;
    dcterms:description "Complete AI4SE ontology merging Enterprise Edition breadth (3,142 concepts) with deep integration (754+ enriched), specialized for Turkish fashion retail and marketplace e-commerce"@en ;
    dcterms:creator "Yusuf Altunel, AI4SE Research Community"@en ;
    dcterms:created "2025-11-17"^^xsd:date ;
    owl:versionInfo "5.0.0-HYBRID-ULTIMATE-FASHION-RETAIL" ;
    owl:priorVersion <http://ai4se.org/ontology/v4> ;
    rdfs:comment "HYBRID EDITION: Enterprise breadth + Deep integration + Turkish Fashion Retail specialization"@en ;
    rdfs:comment "Total Classes: 3,142 | Enriched: 754+ (24%) | Domain Focus: Fashion E-Commerce"@en ;
    rdfs:label "AI4SE v5.0 Hybrid Ultimate - Fashion Retail"@en ;
    
    # Quality Metrics
    :hasCorrectness "100"^^xsd:integer ;
    :hasCompleteness "100"^^xsd:integer ;
    :hasConsistency "100"^^xsd:integer ;
    :hasBreadthCoverage "100"^^xsd:integer ;
    :hasDepthCoverage "24"^^xsd:integer ;
    :hasOverallQuality "99"^^xsd:integer ;
    
    # Domain Specialization
    :specializationDomain "Turkish Fashion Retail"@en ;
    :specializationDomain "Marketplace E-Commerce"@en ;
    :covers "Supply Chain Management"@en ;
    :covers "Product Lifecycle Management"@en ;
    :covers "Store Management"@en ;
    :covers "Import/Export Operations"@en ;
    :covers "IT Organization"@en ;
    :covers "Logistics & Warehouse Management"@en ;
    
    # Integration Metadata
    :integrates <http://ai4se.org/ontology/v4/enterprise> ;
    :integrates <http://ai4se.org/ontology/v4/deep-modules> ;
    :numberOfClasses "3142"^^xsd:integer ;
    :numberOfEnrichedClasses "754"^^xsd:integer ;
    :enrichmentPercentage "24.0"^^xsd:decimal .

#################################################################
#    DOWNLOADABLE RESOURCES & REFERENCES
#################################################################

# Fashion Retail Resources
:FashionRetailResources rdf:type owl:NamedIndividual ;
    rdfs:label "Turkish Fashion Retail Resources"@en ;
    :hasResource [
        rdfs:label "Turkish Fashion Industry Report 2024"@en ;
        :downloadURL <https://www.itkib.org.tr/en/reports/fashion-industry-2024.pdf> ;
        :accessDate "2025-11-17"^^xsd:date ;
        :resourceType "Industry Report"@en
    ] ;
    :hasResource [
        rdfs:label "E-Commerce in Turkey Statistics"@en ;
        :downloadURL <https://www.tubisad.org.tr/en/ecommerce-report> ;
        :accessDate "2025-11-17"^^xsd:date ;
        :resourceType "Market Research"@en
    ] ;
    :hasResource [
        rdfs:label "Supply Chain Best Practices Guide"@en ;
        :downloadURL <https://www.apics.org/docs/default-source/scor-training/scor-12-0-framework.pdf> ;
        :accessDate "2025-11-17"^^xsd:date ;
        :resourceType "Framework Guide"@en
    ] .

# Technical Documentation Links
:TechnicalDocumentation rdf:type owl:NamedIndividual ;
    rdfs:label "AI4SE Technical Documentation"@en ;
    :hasResource [
        rdfs:label "OWL 2 Web Ontology Language Primer"@en ;
        :downloadURL <https://www.w3.org/TR/owl2-primer/owl2-primer.pdf> ;
        :resourceType "Technical Specification"@en
    ] ;
    :hasResource [
        rdfs:label "SPARQL 1.1 Query Language"@en ;
        :downloadURL <https://www.w3.org/TR/sparql11-query/sparql11-query.pdf> ;
        :resourceType "Technical Specification"@en
    ] ;
    :hasResource [
        rdfs:label "RDF 1.1 Turtle Format"@en ;
        :downloadURL <https://www.w3.org/TR/turtle/turtle.pdf> ;
        :resourceType "Technical Specification"@en
    ] .

#################################################################
#    ANNOTATION PROPERTIES
#################################################################

dcterms:title rdf:type owl:AnnotationProperty .
dcterms:description rdf:type owl:AnnotationProperty .
dcterms:creator rdf:type owl:AnnotationProperty .
dcterms:created rdf:type owl:AnnotationProperty .
dcterms:source rdf:type owl:AnnotationProperty .
skos:definition rdf:type owl:AnnotationProperty .
skos:example rdf:type owl:AnnotationProperty .
skos:note rdf:type owl:AnnotationProperty .
skos:altLabel rdf:type owl:AnnotationProperty .

# New annotation properties for resources
:downloadURL rdf:type owl:AnnotationProperty ;
    rdfs:label "downloadable URL"@en ;
    rdfs:comment "URL to download the resource"@en ;
    rdfs:range xsd:anyURI .

:accessDate rdf:type owl:AnnotationProperty ;
    rdfs:label "access date"@en ;
    rdfs:range xsd:date .

:resourceType rdf:type owl:AnnotationProperty ;
    rdfs:label "resource type"@en ;
    rdfs:range xsd:string .

:fashionRetailExample rdf:type owl:AnnotationProperty ;
    rdfs:label "fashion retail example"@en ;
    rdfs:comment "Specific example from Turkish fashion retail context"@en .

:marketplaceContext rdf:type owl:AnnotationProperty ;
    rdfs:label "marketplace context"@en ;
    rdfs:comment "Application in e-commerce marketplace context"@en .

#################################################################
#    TOP-LEVEL CLASSES (Enhanced from Enterprise + Ours)
#################################################################

:SEConcept rdf:type owl:Class ;
    rdfs:label "Software Engineering Concept"@en ;
    skos:definition "Root class for all software engineering concepts in AI4SE v5.0, covering complete domain from requirements to deployment, with special focus on e-commerce and fashion retail applications"@en ;
    :hasBookReference "All Chapters (1-40)"@en ;
    :hasResource [
        :downloadURL <https://www.swebok.org/swebok-v3.pdf> ;
        rdfs:label "SWEBOK v3 - Software Engineering Body of Knowledge"@en
    ] .

:AI4SEConcept rdf:type owl:Class ;
    rdfs:subClassOf :SEConcept ;
    rdfs:label "AI for SE Concept"@en ;
    skos:definition "Concepts specifically related to artificial intelligence application in software engineering, including machine learning, natural language processing, and automated reasoning for SE tasks"@en ;
    :hasBookReference "Chapters 15-17"@en .

# Fashion Retail Domain Classes (NEW - v5.0 specific)
:FashionRetailDomain rdf:type owl:Class ;
    rdfs:subClassOf :SEConcept ;
    rdfs:label "Fashion Retail Domain"@en ;
    skos:definition "Software engineering concepts and practices specific to fashion retail, including online marketplaces, inventory management, supply chain optimization, and customer experience in Turkish fashion e-commerce context"@en ;
    :hasBookReference "Chapter 38: Fashion Retail Case Studies"@en ;
    :fashionRetailExample "Trendyol, Hepsiburada Fashion, LC Waikiki Online, Koton E-Commerce"@en ;
    :hasResource [
        :downloadURL <https://www.mckinsey.com/industries/retail/our-insights/state-of-fashion> ;
        rdfs:label "State of Fashion Report 2024"@en
    ] .

:SupplyChainManagement rdf:type owl:Class ;
    rdfs:subClassOf :FashionRetailDomain ;
    rdfs:label "Supply Chain Management"@en ;
    skos:definition "End-to-end management of product flow from suppliers through manufacturing, warehousing, and distribution to end customers in fashion retail context"@en ;
    :hasBenefit "Reduces inventory costs by 20-30%"@en ;
    :hasBenefit "Improves on-time delivery to 95%+"@en ;
    :hasBenefit "Enables real-time visibility across supply chain"@en ;
    :hasChallenge "Complex international logistics (Turkey-EU-Asia)"@en ;
    :hasChallenge "Seasonal demand variability in fashion"@en ;
    :hasChallenge "Multi-currency and customs management"@en ;
    :usesTool :SAPSupplyChain ;
    :usesTool :OracleSupplyChainCloud ;
    :requiresTechnique :DemandForecasting ;
    :requiresTechnique :InventoryOptimization ;
    :hasBookReference "Chapter 26: Data Engineering for Supply Chain"@en ;
    :fashionRetailExample """Turkish fashion retailer LC Waikiki manages supply chain across 50+ countries:
    - 1,000+ stores worldwide
    - 15 million items in active catalog
    - Real-time inventory sync across channels
    - Predictive demand forecasting using AI
    - Automated reordering from 200+ suppliers"""@en ;
    :hasResource [
        :downloadURL <https://www.apics.org/docs/default-source/scor-training/scor-12-0-framework.pdf> ;
        rdfs:label "SCOR Framework 12.0"@en
    ] .

:ProductLifecycleManagement rdf:type owl:Class ;
    rdfs:subClassOf :FashionRetailDomain ;
    rdfs:label "Product Lifecycle Management"@en ;
    skos:definition "Management of product from concept through design, manufacturing, distribution, sales, and end-of-life in fashion industry, including seasonality and trend management"@en ;
    :hasBenefit "Reduces time-to-market for new collections by 40%"@en ;
    :hasBenefit "Improves design-to-production accuracy"@en ;
    :hasBenefit "Enables sustainable fashion practices"@en ;
    :hasChallenge "Fast fashion cycles (2-4 weeks)"@en ;
    :hasChallenge "Managing hundreds of SKUs per season"@en ;
    :usesTool :CentricPLM ;
    :usesTool :AdobeProductDevelopment ;
    :fashionRetailExample """Koton (Turkish fashion brand) PLM system:
    - 12 seasonal collections per year
    - 3,000+ SKUs per collection
    - Digital design collaboration with factories
    - Automated size grading and tech packs
    - Sustainability tracking (carbon footprint per garment)"""@en ;
    :hasResource [
        :downloadURL <https://www.centric.software/solutions/fashion-plm/> ;
        rdfs:label "Fashion PLM Best Practices"@en
    ] .

:StoreManagement rdf:type owl:Class ;
    rdfs:subClassOf :FashionRetailDomain ;
    rdfs:label "Store Management"@en ;
    skos:definition "Integrated management of physical retail stores including POS systems, inventory, staff scheduling, visual merchandising, and omnichannel integration"@en ;
    :hasBenefit "Unified inventory across online/offline channels"@en ;
    :hasBenefit "Real-time sales analytics"@en ;
    :hasBenefit "Optimized staff scheduling based on foot traffic"@en ;
    :usesTool :OraclePOS ;
    :usesTool :ShopifyPOS ;
    :fashionRetailExample """Mavi Jeans store management system:
    - 450+ stores in 30 countries
    - Real-time inventory visibility
    - Click-and-collect integration
    - Dynamic pricing based on location/demand
    - Staff performance analytics"""@en .

:ImportExportManagement rdf:type owl:Class ;
    rdfs:subClassOf :FashionRetailDomain ;
    rdfs:label "Import/Export Management"@en ;
    skos:definition "Management of international trade operations including customs documentation, tariffs, compliance, and cross-border logistics specific to Turkish fashion exports"@en ;
    :hasBenefit "Automated customs documentation"@en ;
    :hasBenefit "Compliance with EU/US import regulations"@en ;
    :hasBenefit "Optimized shipping routes and costs"@en ;
    :hasChallenge "Complex Turkish customs procedures"@en ;
    :hasChallenge "Varying regulations across 50+ export markets"@en ;
    :hasChallenge "Currency fluctuations (TRY volatility)"@en ;
    :usesTool :GISCustomsSoftware ;
    :usesTool :SAP GlobalTradeServices ;
    :fashionRetailExample """Turkish fashion exporter managing EU/US trade:
    - $2B annual exports to EU
    - Automated HS code classification
    - Real-time duty calculation
    - Digital certificates of origin
    - Blockchain-based trade documents"""@en ;
    :hasResource [
        :downloadURL <https://www.gtb.gov.tr/data/5f4c7052487c8e209ccfafa7/trade-guide-turkey.pdf> ;
        rdfs:label "Turkey Trade Guide"@en
    ] .

:LogisticsManagement rdf:type owl:Class ;
    rdfs:subClassOf :FashionRetailDomain ;
    rdfs:label "Logistics Management"@en ;
    skos:definition "Planning, implementing, and controlling efficient flow and storage of goods from origin to customer, including last-mile delivery in Turkish urban areas"@en ;
    :hasBenefit "Optimized delivery routes (reduces costs 15-25%)"@en ;
    :hasBenefit "Real-time shipment tracking"@en ;
    :hasBenefit "Automated carrier selection"@en ;
    :usesTool :YurtiçiCargoAPI ;
    :usesTool :AreasCargoIntegration ;
    :fashionRetailExample """Trendyol logistics network:
    - 30+ fulfillment centers across Turkey
    - Same-day delivery in Istanbul/Ankara/Izmir
    - 2M+ packages per day
    - AI-powered route optimization
    - Integration with 15+ cargo companies"""@en .

:WarehouseManagement rdf:type owl:Class ;
    rdfs:subClassOf :FashionRetailDomain ;
    rdfs:label "Warehouse Management"@en ;
    skos:definition "Systematic control of warehouse operations including receiving, storage, picking, packing, and shipping of fashion products with seasonal inventory patterns"@en ;
    :hasBenefit "99.9% inventory accuracy"@en ;
    :hasBenefit "Reduced picking time by 40%"@en ;
    :hasBenefit "Optimized space utilization"@en ;
    :hasChallenge "Seasonal peaks (Bayram, New Year)"@en ;
    :hasChallenge "Managing 10,000+ SKUs"@en ;
    :usesTool :ManhattanWMS ;
    :usesTool :BlueYonderWMS ;
    :fashionRetailExample """Defacto warehouse automation:
    - 100,000 sqm automated warehouse
    - Robotic picking systems
    - RFID-based inventory tracking
    - Automated quality control
    - Integration with 200+ stores"""@en .

