:RecommendationEngine rdf:type owl:Class ;
    rdfs:subClassOf :AI4SEConcept ;
    rdfs:label "Recommendation Engine"@en ;
    skos:definition "AI-powered system that suggests products to customers based on browsing history, purchase behavior, and similar user patterns, critical for fashion e-commerce personalization"@en ;
    :hasBenefit "Increases average order value by 30%"@en ;
    :hasBenefit "Improves conversion rate by 25%"@en ;
    :hasBenefit "Accounts for 35% of revenue in mature platforms"@en ;
    :hasChallenge "Cold start problem for new customers"@en ;
    :hasChallenge "Requires massive computational resources"@en ;
    :hasChallenge "Balancing personalization with diversity"@en ;
    :usesTool :AmazonPersonalize ;
    :usesTool :TensorFlowRecommenders ;
    :fashionRetailExample """Trendyol Recommendation Engine:
    - Collaborative filtering + content-based hybrid
    - 50M+ users, 20M+ products
    - Real-time recommendations (<50ms)
    - Factors: View history, purchases, cart, wishlist, size preferences
    - A/B testing: 15+ model variants in production
    - Results: 35% of revenue from recommendations
    - Technology: TensorFlow, Redis, Kafka
    - Personalized: Homepage, product pages, emails, push notifications"""@en ;
    :hasResource [
        rdfs:label "Building Recommendation Systems"@en ;
        :downloadURL <https://www.nvidia.com/content/dam/en-zz/Solutions/deep-learning/recommender-systems/recommendation-systems-guide.pdf> ;
        :resourceType "Implementation Guide"@en
    ] .

:DynamicPricing rdf:type owl:Class ;
    rdfs:subClassOf :AI4SEConcept ;
    rdfs:label "Dynamic Pricing"@en ;
    skos:definition "AI-driven pricing strategy that adjusts product prices in real-time based on demand, competition, inventory levels, and market conditions in fashion retail"@en ;
    :hasBenefit "Increases revenue by 15-25%"@en ;
    :hasBenefit "Optimizes inventory turnover"@en ;
    :hasBenefit "Responds to competitor pricing in real-time"@en ;
    :hasChallenge "Customer perception of fairness"@en ;
    :hasChallenge "Legal compliance in Turkey"@en ;
    :fashionRetailExample """Hepsiburada Fashion Dynamic Pricing:
    - ML models predict optimal price points
    - Factors: Competitor prices, demand forecast, inventory age, seasonality
    - Adjustments every 6 hours
    - 2M+ products with dynamic pricing
    - Revenue increase: 18%
    - Markdown optimization for end-of-season
    - Flash sale price optimization"""@en ;
    :hasResource [
        rdfs:label "Dynamic Pricing Strategies"@en ;
        :downloadURL <https://www.mckinsey.com/capabilities/growth-marketing-and-sales/our-insights/price-management-in-turbulent-times> ;
        :resourceType "Strategy Guide"@en
    ] .

:InventoryOptimization rdf:type owl:Class ;
    rdfs:subClassOf :AI4SEConcept ;
    rdfs:label "Inventory Optimization"@en ;
    skos:definition "AI/ML techniques to determine optimal inventory levels across warehouses and stores, minimizing stockouts while reducing carrying costs"@en ;
    :hasBenefit "Reduces inventory costs by 20-30%"@en ;
    :hasBenefit "Decreases stockouts by 50%"@en ;
    :hasBenefit "Improves cash flow significantly"@en ;
    :hasChallenge "Seasonal demand variability in fashion"@en ;
    :hasChallenge "Fast fashion short product lifecycles"@en ;
    :fashionRetailExample """Defacto Inventory Optimization:
    - ML forecasting for 15M+ SKUs
    - Predicts demand 12 weeks ahead
    - Factors: Historical sales, trends, weather, campaigns, Bayram holidays
    - Automated reordering from 200+ suppliers
    - Safety stock optimization by region
    - Result: 25% inventory cost reduction, 98% fill rate
    - Technology: Prophet (Facebook), XGBoost, custom models"""@en ;
    :hasResource [
        rdfs:label "Inventory Optimization Techniques"@en ;
        :downloadURL <https://www.scmr.com/wp-content/uploads/2023/inventory-optimization-guide.pdf> ;
        :resourceType "Operations Guide"@en
    ] .

:FraudDetection rdf:type owl:Class ;
    rdfs:subClassOf :AI4SEConcept ;
    rdfs:label "Fraud Detection"@en ;
    skos:definition "Real-time machine learning system to detect and prevent fraudulent transactions, fake accounts, and payment fraud in Turkish e-commerce"@en ;
    :hasBenefit "Prevents ₺50M+ fraud losses annually"@en ;
    :hasBenefit "Reduces manual review workload by 80%"@en ;
    :hasBenefit "Real-time detection (<100ms)"@en ;
    :hasChallenge "High false positive rate (legitimate customers blocked)"@en ;
    :hasChallenge "Sophisticated fraud techniques evolving"@en ;
    :usesTool :Riskified ;
    :usesTool :Sift ;
    :fashionRetailExample """N11.com Fraud Detection System:
    - Random Forest + Neural Network ensemble
    - Features: Device fingerprint, behavior patterns, transaction history, IP geolocation
    - 10M+ transactions analyzed monthly
    - Fraud detection rate: 95%
    - False positive rate: 2%
    - Saved: ₺75M in fraud losses (2024)
    - Real-time scoring + manual review for edge cases
    - Integration with credit card companies"""@en ;
    :hasResource [
        rdfs:label "E-Commerce Fraud Prevention Guide"@en ;
        :downloadURL <https://www.ravelin.com/insights/ecommerce-fraud-prevention-guide> ;
        :resourceType "Best Practices"@en
    ] .

:SearchEngine rdf:type owl:Class ;
    rdfs:subClassOf :AI4SEConcept ;
    rdfs:label "E-Commerce Search Engine"@en ;
    skos:definition "Specialized search system with NLP, typo tolerance, synonym handling, and faceted filtering optimized for Turkish fashion product discovery"@en ;
    :hasBenefit "40% of users start shopping with search"@en ;
    :hasBenefit "Search users convert 3x higher"@en ;
    :hasBenefit "Handles Turkish language nuances"@en ;
    :hasChallenge "Synonym management (jean/kot pantolon)"@en ;
    :hasChallenge "Size/color filtering complexity"@en ;
    :usesTool :Elasticsearch ;
    :usesTool :Algolia ;
    :fashionRetailExample """Trendyol Search Implementation:
    - Elasticsearch cluster: 20M+ products indexed
    - Turkish NLP: Morphological analysis, stemming
    - Features: Typo tolerance, synonyms, auto-complete, faceted search
    - Visual search: Image-based product discovery
    - Personalized ranking based on user preferences
    - Query understanding: "kırmızı elbise 38 beden" → structured filters
    - Performance: <50ms average response
    - Search accounts for 45% of product discoveries"""@en ;
    :hasResource [
        rdfs:label "Elasticsearch Guide"@en ;
        :downloadURL <https://www.elastic.co/guide/en/elasticsearch/reference/current/elasticsearch-intro.pdf> ;
        :resourceType "Technical Documentation"@en
    ] .

#################################################################
#    DOMAIN 5: DEVOPS EXTENDED (80 Classes)
#################################################################

:ContainerOrchestration rdf:type owl:Class ;
    rdfs:subClassOf :CloudTechnology ;
    rdfs:label "Container Orchestration"@en ;
    skos:definition "Automated deployment, scaling, and management of containerized applications using platforms like Kubernetes, essential for microservices-based fashion e-commerce platforms"@en ;
    :hasBenefit "Auto-scaling during traffic spikes (Black Friday: 50x)"@en ;
    :hasBenefit "Zero-downtime deployments"@en ;
    :hasBenefit "Efficient resource utilization (50% cost reduction)"@en ;
    :hasChallenge "Complex initial setup and learning curve"@en ;
    :hasChallenge "Monitoring distributed systems"@en ;
    :usesTool :Kubernetes ;
    :usesTool :DockerSwarm ;
    :fashionRetailExample """Hepsiburada Kubernetes Infrastructure:
    - 500+ microservices running on Kubernetes
    - 3 AWS regions (Istanbul, Frankfurt, Dublin)
    - Auto-scaling: 100 to 5,000 pods during campaigns
    - Deployment: 200+ deployments per day (zero downtime)
    - Cost savings: 45% vs traditional VMs
    - Service mesh: Istio for traffic management
    - Monitoring: Prometheus + Grafana
    - Disaster recovery: Multi-region active-active"""@en ;
    :hasResource [
        rdfs:label "Kubernetes Documentation"@en ;
        :downloadURL <https://kubernetes.io/docs/kubernetes.pdf> ;
        :resourceType "Platform Guide"@en
    ] .

:ObservabilityPlatform rdf:type owl:Class ;
    rdfs:subClassOf :DevOpsConcept ;
    rdfs:label "Observability Platform"@en ;
    skos:definition "Comprehensive monitoring, logging, and tracing system providing visibility into distributed fashion e-commerce platforms for troubleshooting and performance optimization"@en ;
    :hasBenefit "Reduces MTTR (Mean Time To Recovery) by 70%"@en ;
    :hasBenefit "Proactive issue detection before customer impact"@en ;
    :hasBenefit "Complete transaction visibility across 100+ microservices"@en ;
    :usesTool :Datadog ;
    :usesTool :NewRelic ;
    :usesTool :Prometheus ;
    :fashionRetailExample """Trendyol Observability Stack:
    - Metrics: Prometheus + Grafana (1B+ metrics/day)
    - Logging: ELK Stack (Elasticsearch, Logstash, Kibana) - 10TB logs/day
    - Tracing: Jaeger (distributed tracing across microservices)
    - APM: Datadog (application performance monitoring)
    - Alerts: PagerDuty integration for on-call engineers
    - Dashboards: Real-time visibility for executives
    - Cost: $200K/month, saves $5M+ in downtime prevention"""@en ;
    :hasResource [
        rdfs:label "Observability Engineering Guide"@en ;
        :downloadURL <https://www.oreilly.com/library/view/observability-engineering/9781492076438/> ;
        :resourceType "Engineering Book"@en
    ] .

