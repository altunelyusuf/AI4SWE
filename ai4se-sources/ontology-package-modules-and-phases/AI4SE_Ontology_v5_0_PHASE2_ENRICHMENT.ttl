:PersonalizationML rdf:type owl:Class ;
    rdfs:subClassOf :MachineLearningTechnique ;
    rdfs:label "Personalization ML"@en ;
    skos:definition "Machine learning algorithms that create personalized shopping experiences including recommendations, content, pricing, and promotions for individual customers in fashion e-commerce"@en ;
    :hasBenefit "Increases customer lifetime value by 40%"@en ;
    :hasBenefit "Improves engagement metrics across all channels"@en ;
    :hasBenefit "Reduces marketing costs through targeting"@en ;
    :hasChallenge "Privacy concerns (KVKK compliance)"@en ;
    :hasChallenge "Model drift as fashion trends change"@en ;
    :fashionRetailExample """Morhipo Personalization Engine:
    - User segmentation: 500 behavioral clusters
    - Personalized homepage for 5M+ users
    - Email personalization: 10M+ weekly emails, 6% CTR (vs 2% generic)
    - Push notifications: 3M+ daily, 8% open rate
    - Product recommendations: Collaborative filtering + content-based
    - Size prediction: 85% accuracy based on purchase history
    - Campaign targeting: ROI increased by 300%"""@en ;
    :hasResource [
        rdfs:label "Personalization Best Practices"@en ;
        :downloadURL <https://www.segment.com/resources/guides/personalization/> ;
        :resourceType "Strategy Guide"@en
    ] .

:ComputerVisionFashion rdf:type owl:Class ;
    rdfs:subClassOf :ComputerVision ;
    rdfs:label "Computer Vision for Fashion"@en ;
    skos:definition "Application of computer vision techniques for visual search, product tagging, quality control, and virtual try-on in fashion e-commerce"@en ;
    :hasBenefit "Automated product tagging (saves 1,000+ hours/month)"@en ;
    :hasBenefit "Visual search converts 30% higher"@en ;
    :hasBenefit "Quality control accuracy: 98%"@en ;
    :usesTool :OpenCV ;
    :usesTool :TensorFlow ;
    :fashionRetailExample """LC Waikiki Computer Vision Applications:
    - Visual search: Upload photo, find similar products
    - Automated tagging: Color, pattern, style, occasion (95% accuracy)
    - Quality control: Detect defects in warehouse (1M+ photos/day)
    - Size recommendation: Body measurement from photos
    - Style matching: "Complete the look" suggestions
    - Technology: ResNet-50, YOLO, custom models
    - Processed: 5M+ images monthly"""@en ;
    :hasResource [
        rdfs:label "Fashion Computer Vision Guide"@en ;
        :downloadURL <https://arxiv.org/pdf/2003.09960.pdf> ;
        :resourceType "Research Paper"@en
    ] .

:NLPProductSearch rdf:type owl:Class ;
    rdfs:subClassOf :NaturalLanguageProcessing ;
    rdfs:label "NLP for Product Search"@en ;
    skos:definition "Natural language processing techniques to understand search queries, extract intent, and match to products in Turkish language for fashion e-commerce"@en ;
    :hasBenefit "Handles Turkish morphology complexities"@en ;
    :hasBenefit "Understands colloquial fashion terms"@en ;
    :hasBenefit "Improves search success rate by 35%"@en ;
    :hasChallenge "Turkish language morphological richness"@en ;
    :hasChallenge "Fashion slang and regional variations"@en ;
    :fashionRetailExample """Trendyol Turkish NLP Search:
    - Query understanding: "kışlık kalın mavi kot pantolon 32 beden"
      → Extracts: Season=winter, Thickness=thick, Color=blue, Type=jeans, Size=32
    - Synonym handling: jean=kot pantolon, tişört=tshirt, ayakkabı=shoes
    - Typo tolerance: elsbise→elbise, pantolan→pantolon
    - Entity recognition: Brand names, style terms, materials
    - Technology: BERT fine-tuned on Turkish fashion corpus
    - Training data: 10M+ Turkish fashion queries"""@en ;
    :hasResource [
        rdfs:label "Turkish NLP Resources"@en ;
        :downloadURL <https://github.com/turkish-nlp-suite/resources> ;
        :resourceType "NLP Tools"@en
    ] .

:DemandForecasting rdf:type owl:Class ;
    rdfs:subClassOf :MachineLearningTechnique ;
    rdfs:label "Demand Forecasting"@en ;
    skos:definition "Predictive machine learning models forecasting future product demand for inventory planning, considering seasonality, trends, and external factors in Turkish fashion market"@en ;
    :hasBenefit "Reduces stockouts by 50%"@en ;
    :hasBenefit "Decreases excess inventory by 30%"@en ;
    :hasBenefit "Improves supply chain efficiency"@en ;
    :hasChallenge "Fast fashion rapid trend changes"@en ;
    :hasChallenge "External factors (weather, economy, holidays)"@en ;
    :fashionRetailExample """Koton Demand Forecasting System:
    - Forecasts demand for 50,000+ SKUs
    - Time horizon: 12 weeks ahead
    - Features: Historical sales, weather, Google Trends, Bayram holidays, campaigns
    - Models: Prophet (Facebook), LSTM, XGBoost ensemble
    - Accuracy: 85% for established products, 65% for new launches
    - Updated: Daily with latest sales data
    - Impact: ₺50M inventory cost savings annually"""@en ;
    :hasResource [
        rdfs:label "Demand Forecasting in Retail"@en ;
        :downloadURL <https://www.mckinsey.com/industries/retail/our-insights/demand-forecasting> ;
        :resourceType "Industry Research"@en
    ] .

