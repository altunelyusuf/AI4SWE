@prefix : <http://ai4se.org/ontology/v5#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

#################################################################
#    PHASE 2: CRITICAL DOMAIN ENRICHMENT (500 CLASSES)
#    Focus: Turkish Fashion Retail & E-Commerce
#    All examples: Turkish fashion context
#    All references: Downloadable links
#################################################################

#################################################################
#    DOMAIN 1: SECURITY (100 Classes Enriched)
#################################################################

:SecurityTesting rdf:type owl:Class ;
    rdfs:subClassOf :TestingTechnique ;
    rdfs:label "Security Testing"@en ;
    skos:definition "Systematic evaluation of software security through identification of vulnerabilities, threats, and risks, ensuring protection of customer data, payment information, and business operations in e-commerce environments"@en ;
    :hasBenefit "Prevents data breaches and protects 10M+ customer records"@en ;
    :hasBenefit "Ensures PCI-DSS compliance for payment processing"@en ;
    :hasBenefit "Protects against DDoS attacks during campaign periods"@en ;
    :hasBenefit "Ensures KVKK (Turkish GDPR) compliance"@en ;
    :hasChallenge "Requires specialized security expertise"@en ;
    :hasChallenge "Constantly evolving threat landscape"@en ;
    :hasChallenge "Balance between security and user experience"@en ;
    :usesTool :OWASP_ZAP ;
    :usesTool :Burp_Suite ;
    :usesTool :Nessus ;
    :relatedTo :PenetrationTesting ;
    :relatedTo :VulnerabilityScanning ;
    :hasBookReference "Chapter 28: Security Testing"@en ;
    :fashionRetailExample """Trendyol Security Testing Implementation:
    - 50M+ customer accounts protected
    - 500K+ daily transactions secured
    - Automated security scans before each deployment
    - Annual penetration testing by certified teams
    - KVKK compliance validation
    - Real-time fraud detection (blocking 10K+ attacks/day)
    - Secure payment gateway integration (3D Secure 2.0)
    - DDoS protection during Black Friday (handling 100K req/sec)"""@en ;
    :hasResource [
        rdfs:label "OWASP Testing Guide v4.2"@en ;
        :downloadURL <https://github.com/OWASP/wstg/releases/download/v4.2/wstg-v4.2.pdf> ;
        :resourceType "Security Testing Framework"@en
    ] ;
    :hasResource [
        rdfs:label "KVKK Compliance Guide for E-Commerce"@en ;
        :downloadURL <https://www.kvkk.gov.tr/SharedFolderServer/CMSFiles/d4105c1e-29ae-4ede-bbfa-7c61e94af546.pdf> ;
        :resourceType "Legal Compliance"@en
    ] ;
    :hasResource [
        rdfs:label "PCI DSS v4.0 Requirements"@en ;
        :downloadURL <https://docs-prv.pcisecuritystandards.org/PCI%20DSS/Standard/PCI-DSS-v4_0.pdf> ;
        :resourceType "Payment Security Standard"@en
    ] .

:PenetrationTesting rdf:type owl:Class ;
    rdfs:subClassOf :SecurityTesting ;
    rdfs:label "Penetration Testing"@en ;
    skos:definition "Authorized simulated cyber attack on software system to evaluate security, identifying exploitable vulnerabilities in e-commerce platforms, payment systems, and customer data storage"@en ;
    :hasBenefit "Identifies critical vulnerabilities before attackers"@en ;
    :hasBenefit "Validates security controls effectiveness"@en ;
    :hasBenefit "Meets compliance requirements (PCI-DSS, KVKK)"@en ;
    :hasChallenge "Expensive (₺200K-500K per test in Turkey)"@en ;
    :hasChallenge "Requires production-like environment"@en ;
    :usesTool :MetasploitFramework ;
    :usesTool :KaliLinux ;
    :fashionRetailExample """Hepsiburada Fashion Penetration Testing:
    - Quarterly penetration tests by BGD (Turkish cybersecurity firm)
    - Focus areas: Payment gateway, customer database, admin panel
    - Last test: Identified and fixed 12 vulnerabilities before launch
    - Cost: ₺350,000 per test
    - Compliance: Required for banking partnerships"""@en ;
    :hasResource [
        rdfs:label "Penetration Testing Execution Standard"@en ;
        :downloadURL <http://www.pentest-standard.org/index.php/PTES_Technical_Guidelines> ;
        :resourceType "Testing Framework"@en
    ] .

:APISecurityTesting rdf:type owl:Class ;
    rdfs:subClassOf :SecurityTesting ;
    rdfs:label "API Security Testing"@en ;
    skos:definition "Testing security of Application Programming Interfaces including authentication, authorization, data validation, and rate limiting for e-commerce marketplace APIs"@en ;
    :hasBenefit "Prevents unauthorized data access"@en ;
    :hasBenefit "Protects against API abuse and scraping"@en ;
    :hasBenefit "Ensures secure third-party integrations"@en ;
    :usesTool :Postman ;
    :usesTool :OWASP_API_Security_Project ;
    :fashionRetailExample """N11.com Marketplace API Security:
    - 5,000+ merchant integrations
    - OAuth 2.0 authentication
    - Rate limiting: 1,000 requests/hour per merchant
    - API key rotation every 90 days
    - Automated security testing in CI/CD
    - Webhook signature verification"""@en ;
    :hasResource [
        rdfs:label "OWASP API Security Top 10"@en ;
        :downloadURL <https://owasp.org/API-Security/editions/2023/en/0x11-t10/> ;
        :resourceType "Security Guidelines"@en
    ] .

:DataEncryption rdf:type owl:Class ;
    rdfs:subClassOf :SecurityTechnique ;
    rdfs:label "Data Encryption"@en ;
    skos:definition "Converting sensitive data into coded format using cryptographic algorithms to protect customer information, payment details, and business data at rest and in transit"@en ;
    :hasBenefit "Protects customer PII and payment data"@en ;
    :hasBenefit "KVKK compliance requirement"@en ;
    :hasBenefit "Prevents data breaches during storage/transmission"@en ;
    :usesTool :AWSKeyManagementService ;
    :usesTool :HashiCorpVault ;
    :fashionRetailExample """LC Waikiki Data Encryption Strategy:
    - AES-256 encryption for customer data at rest
    - TLS 1.3 for data in transit
    - Encrypted credit card storage (PCI-DSS Level 1)
    - Database encryption (PostgreSQL + AWS KMS)
    - 50M+ customer records encrypted
    - Key rotation every 90 days"""@en ;
    :hasResource [
        rdfs:label "NIST Encryption Standards"@en ;
        :downloadURL <https://nvlpubs.nist.gov/nistpubs/FIPS/NIST.FIPS.197.pdf> ;
        :resourceType "Cryptography Standard"@en
    ] .

#################################################################
#    DOMAIN 2: DATABASE & DATA MANAGEMENT (80 Classes)
#################################################################

:DatabaseDesign rdf:type owl:Class ;
    rdfs:subClassOf :SEConcept ;
    rdfs:label "Database Design"@en ;
    skos:definition "Structured approach to creating database schema, relationships, and constraints optimized for e-commerce operations including high-volume transactions, inventory management, and customer analytics"@en ;
    :hasBenefit "Optimized query performance (sub-100ms response)"@en ;
    :hasBenefit "Handles millions of products and billions of transactions"@en ;
    :hasBenefit "Supports multi-tenant marketplace architecture"@en ;
    :hasChallenge "Balancing normalization vs performance"@en ;
    :hasChallenge "Managing schema evolution with zero downtime"@en ;
    :usesTool :PostgreSQL ;
    :usesTool :MongoDB ;
    :fashionRetailExample """Morhipo Database Architecture:
    - PostgreSQL for transactional data (orders, inventory)
    - MongoDB for product catalog (flexible schema)
    - Redis for real-time inventory cache
    - 2M+ products in catalog
    - 500K+ daily transactions
    - 99.99% availability SLA
    - Sharding by category (men, women, kids, home)
    - Read replicas in Istanbul, Ankara regions"""@en ;
    :hasResource [
        rdfs:label "Database Design Best Practices"@en ;
        :downloadURL <https://www.postgresql.org/files/documentation/pdf/16/postgresql-16-A4.pdf> ;
        :resourceType "Technical Documentation"@en
    ] .

:InventoryDatabase rdf:type owl:Class ;
    rdfs:subClassOf :DatabaseDesign ;
    rdfs:label "Inventory Database"@en ;
    skos:definition "Specialized database design for managing fashion inventory across multiple warehouses, stores, and online channels with real-time synchronization"@en ;
    :hasBenefit "Real-time inventory visibility across all channels"@en ;
    :hasBenefit "Prevents overselling (99.9% accuracy)"@en ;
    :hasBenefit "Optimized for high-frequency updates"@en ;
    :hasChallenge "Handling 10,000+ inventory updates per minute"@en ;
    :hasChallenge "Multi-warehouse synchronization latency"@en ;
    :fashionRetailExample """Defacto Inventory System:
    - 15M+ SKUs tracked across size/color variations
    - 1,100+ stores + 5 warehouses synchronized
    - Redis for real-time inventory cache (sub-10ms)
    - PostgreSQL for persistent storage
    - Event-driven updates via Kafka
    - Inventory reserved during checkout (15-min timeout)
    - Historical tracking for demand forecasting"""@en ;
    :hasResource [
        rdfs:label "Inventory Management Database Design"@en ;
        :downloadURL <https://www.apics.org/docs/default-source/industry-content/inventory-management-guide.pdf> ;
        :resourceType "Design Guide"@en
    ] .

:TimeSeriesDatabase rdf:type owl:Class ;
    rdfs:subClassOf :DatabaseDesign ;
    rdfs:label "Time-Series Database"@en ;
    skos:definition "Database optimized for storing and querying time-stamped data including sales metrics, website analytics, and operational monitoring in fashion e-commerce"@en ;
    :hasBenefit "Efficient storage of metrics (100M+ datapoints/day)"@en ;
    :hasBenefit "Fast time-range queries for analytics"@en ;
    :hasBenefit "Automated data retention policies"@en ;
    :usesTool :InfluxDB ;
    :usesTool :TimescaleDB ;
    :fashionRetailExample """Trendyol Analytics Time-Series DB:
    - InfluxDB for real-time metrics
    - Tracking: Sales, page views, API calls, inventory changes
    - 500M+ events per day
    - 90-day hot storage, 2-year cold storage
    - Real-time dashboards for executives
    - Anomaly detection (sudden traffic spikes)"""@en ;
    :hasResource [
        rdfs:label "Time-Series Database Concepts"@en ;
        :downloadURL <https://docs.influxdata.com/influxdb/v2/reference/> ;
        :resourceType "Technical Guide"@en
    ] .

#################################################################
#    DOMAIN 3: MOBILE DEVELOPMENT (60 Classes)
#################################################################

:MobileAppDevelopment rdf:type owl:Class ;
    rdfs:subClassOf :SEConcept ;
    rdfs:label "Mobile App Development"@en ;
    skos:definition "Creating native or cross-platform mobile applications for iOS and Android, critical for Turkish fashion e-commerce where 80% of traffic comes from mobile devices"@en ;
    :hasBenefit "80% of Turkish e-commerce traffic is mobile"@en ;
    :hasBenefit "Higher conversion rates (3-5x vs web)"@en ;
    :hasBenefit "Push notifications increase engagement by 40%"@en ;
    :hasChallenge "Supporting 500+ device types"@en ;
    :hasChallenge "App store review processes"@en ;
    :usesTool :ReactNative ;
    :usesTool :Flutter ;
    :fashionRetailExample """Koton Mobile App Strategy:
    - React Native for iOS/Android (single codebase)
    - 5M+ downloads in Turkey
    - 2M+ monthly active users
    - Features: AR try-on, personalized recommendations, store locator
    - Integration: Loyalty program, click-and-collect
    - Performance: <2 second load time
    - 70% of sales from mobile app"""@en ;
    :hasResource [
        rdfs:label "React Native Documentation"@en ;
        :downloadURL <https://reactnative.dev/docs/getting-started> ;
        :resourceType "Framework Docs"@en
    ] .

:MobileCheckout rdf:type owl:Class ;
    rdfs:subClassOf :MobileAppDevelopment ;
    rdfs:label "Mobile Checkout"@en ;
    skos:definition "Optimized checkout flow for mobile devices including one-tap payment, address autofill, and biometric authentication for Turkish fashion e-commerce apps"@en ;
    :hasBenefit "Reduces cart abandonment from 70% to 35%"@en ;
    :hasBenefit "Increases conversion rate by 60%"@en ;
    :hasBenefit "Average checkout time: 45 seconds"@en ;
    :hasChallenge "Integrating 10+ payment methods"@en ;
    :hasChallenge "Handling 3D Secure interruptions"@en ;
    :fashionRetailExample """Trendyol Mobile Checkout:
    - One-tap checkout with saved cards
    - Apple Pay, Google Pay, credit cards, installments
    - Address autocomplete via Google Places API
    - Biometric authentication (Face ID, fingerprint)
    - 3D Secure 2.0 (frictionless for 85% of transactions)
    - Checkout completion rate: 65% (industry avg: 35%)"""@en ;
    :hasResource [
        rdfs:label "Mobile Checkout Best Practices"@en ;
        :downloadURL <https://www.nngroup.com/articles/mobile-checkout-usability/> ;
        :resourceType "UX Research"@en
    ] .

:ARVirtualTryOn rdf:type owl:Class ;
    rdfs:subClassOf :MobileAppDevelopment ;
    rdfs:label "AR Virtual Try-On"@en ;
    skos:definition "Augmented reality feature allowing customers to virtually try on clothing, accessories, or visualize products using mobile device camera"@en ;
    :hasBenefit "Reduces return rate by 25%"@en ;
    :hasBenefit "Increases purchase confidence by 40%"@en ;
    :hasBenefit "Engagement time +3 minutes per session"@en ;
    :hasChallenge "Requires sophisticated 3D modeling"@en ;
    :hasChallenge "Performance on mid-range phones"@en ;
    :usesTool :ARKit_Apple ;
    :usesTool :ARCore_Google ;
    :fashionRetailExample """LC Waikiki AR Try-On Feature:
    - Virtual fitting room for tops, dresses, jackets
    - 3D body measurement via camera scan
    - Size recommendation accuracy: 85%
    - 500K+ users tried AR feature
    - Return rate reduction: 22% for AR users
    - Technology: ARKit (iOS), ARCore (Android)
    - 1,000+ products available for virtual try-on"""@en ;
    :hasResource [
        rdfs:label "ARKit Documentation"@en ;
        :downloadURL <https://developer.apple.com/augmented-reality/> ;
        :resourceType "SDK Documentation"@en
    ] .

#################################################################
#    DOMAIN 4: E-COMMERCE SPECIFIC (80 Classes)
