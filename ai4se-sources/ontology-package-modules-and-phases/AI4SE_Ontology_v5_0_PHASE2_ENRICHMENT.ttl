:StaticCodeAnalysis rdf:type owl:Class ;
    rdfs:subClassOf :CodeAnalysisTechnique ;
    rdfs:label "Static Code Analysis"@en ;
    skos:definition "Automated examination of source code without execution to identify bugs, security vulnerabilities, code smells, and technical debt in e-commerce applications"@en ;
    :hasBenefit "Catches 70% of bugs before production"@en ;
    :hasBenefit "Enforces coding standards automatically"@en ;
    :hasBenefit "Reduces code review time by 40%"@en ;
    :hasChallenge "High false positive rate requires tuning"@en ;
    :hasChallenge "Integration into CI/CD pipeline"@en ;
    :usesTool :SonarQube ;
    :usesTool :ESLint ;
    :usesTool :Checkmarx ;
    :fashionRetailExample """Hepsiburada Static Analysis Pipeline:
    - SonarQube integrated in GitLab CI/CD
    - Scans: 500+ repositories, 5M+ lines of code
    - Languages: Java, JavaScript, TypeScript, Python
    - Quality gates: <5% code duplication, >80% coverage, 0 critical bugs
    - Security: OWASP Top 10 vulnerability detection
    - Blocked deployments: 50+ per month (critical issues)
    - Developer training: Monthly code quality workshops"""@en ;
    :hasResource [
        rdfs:label "SonarQube Documentation"@en ;
        :downloadURL <https://docs.sonarqube.org/latest/sonarqube-docs.pdf> ;
        :resourceType "Tool Documentation"@en
    ] .

:CodeReview rdf:type owl:Class ;
    rdfs:subClassOf :SoftwareProcess ;
    rdfs:label "Code Review"@en ;
    skos:definition "Systematic examination of code changes by peers to improve quality, share knowledge, and maintain standards in fashion e-commerce development teams"@en ;
    :hasBenefit "Reduces defects by 60%"@en ;
    :hasBenefit "Knowledge sharing across team"@en ;
    :hasBenefit "Maintains code consistency"@en ;
    :hasChallenge "Time-consuming (2-4 hours per PR)"@en ;
    :hasChallenge "Bottleneck if not enough reviewers"@en ;
    :fashionRetailExample """Trendyol Code Review Process:
    - All code changes require 2 approvals
    - GitLab merge requests + Slack integration
    - Automated checks: Tests pass, SonarQube gate, security scan
    - Review SLA: 4 hours max response time
    - 2,000+ pull requests per month
    - Code ownership: CODEOWNERS file for automatic reviewer assignment
    - Metrics tracked: Review time, defect escape rate"""@en ;
    :hasResource [
        rdfs:label "Code Review Best Practices"@en ;
        :downloadURL <https://google.github.io/eng-practices/review/> ;
        :resourceType "Engineering Guide"@en
    ] .

