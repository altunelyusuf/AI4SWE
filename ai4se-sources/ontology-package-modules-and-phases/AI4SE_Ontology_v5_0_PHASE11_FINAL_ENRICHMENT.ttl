:TicketingSystem rdf:type owl:Class ;
    rdfs:label "Customer Support Ticketing"@en ;
    skos:definition "Centralized platform managing customer inquiries, issues, and requests across multiple channels for Turkish fashion e-commerce customer service"@en ;
    :hasBenefit "Organized issue tracking"@en ;
    :hasBenefit "Multi-channel unified view"@en ;
    :hasBenefit "SLA management and reporting"@en ;
    :usesTool :Zendesk ;
    :usesTool :Freshdesk ;
    :fashionRetailExample """N11 Customer Support Operations:
    - Tool: Zendesk (200 agents)
    - Channels: Email, phone, live chat, WhatsApp, social media
    - Volume: 100K+ tickets per month
    - Categories: Order status, returns, payment issues, product questions
    - SLA targets: 
      * First response: <2 hours
      * Resolution: <24 hours (80% of cases)
    - Automation: 30% of tickets auto-resolved (FAQ suggestions, chatbot)
    - Prioritization: VIP customers, high-value orders prioritized
    - Knowledge base: 1,000+ articles, 40% self-service resolution
    - Agent performance: Tracked via CSAT, resolution time, tickets handled
    - Integration: CRM, OMS, payment systems (full customer context)
    - Cost: Zendesk $50/agent/month = $120K/year
    - CSAT: 4.3/5 average customer satisfaction"""@en ;
    :hasResource [
        :downloadURL <https://www.zendesk.com/service/help-desk/> ;
        rdfs:label "Zendesk Documentation"@en
    ] .

:Chatbot rdf:type owl:Class ;
    rdfs:label "AI Chatbot"@en ;
    skos:definition "Conversational AI handling customer inquiries automatically in Turkish language, reducing support workload and providing 24/7 assistance"@en ;
    :hasBenefit "24/7 availability"@en ;
    :hasBenefit "Instant responses"@en ;
    :hasBenefit "Handles 60-70% of simple queries"@en ;
    :hasChallenge "Turkish language NLP complexity"@en ;
    :hasChallenge "Handling edge cases"@en ;
    :usesTool :DialogFlow ;
    :usesTool :RasaAI ;
    :fashionRetailExample """Trendyol AI Chatbot "Trendy":
    - Platform: Custom NLP model + DialogFlow
    - Language: Turkish (Zemberek NLP library)
    - Training: 10M+ historical support conversations
    - Capabilities:
      * Order tracking: "Siparişim nerede?" → Real-time status
      * Return process: Step-by-step guidance
      * Product questions: Size guide, material, availability
      * Payment issues: Transaction status check
    - Handoff: Complex issues → Human agent with full context
    - Volume: 2M+ conversations/month
    - Resolution rate: 65% (no human needed)
    - CSAT: 4.0/5 (chatbot only)
    - Cost savings: ₺5M/year (vs hiring 100+ agents)
    - Continuous learning: Weekly model retraining with new data"""@en ;
    :hasResource [
        :downloadURL <https://cloud.google.com/dialogflow/docs> ;
        rdfs:label "DialogFlow Documentation"@en
    ] .

:SelfServicePortal rdf:type owl:Class ;
    rdfs:label "Self-Service Customer Portal"@en ;
    skos:definition "Online portal allowing customers to manage orders, returns, account settings independently without contacting support"@en ;
    :hasBenefit "Reduces support ticket volume by 40%"@en ;
    :hasBenefit "24/7 availability"@en ;
    :hasBenefit "Customer empowerment"@en ;
    :fashionRetailExample """LC Waikiki Self-Service Portal:
    - Features:
      * Order tracking: Real-time status, delivery updates
      * Returns: Initiate return, print label, track refund
      * Account: Update address, payment methods, preferences
      * Loyalty: View points, redeem rewards
      * Invoice: Download digital invoices
      * Support: FAQ, knowledge base, contact forms
    - Usage: 3M+ monthly active users
    - Self-service rate: 55% (vs 25% before portal)
    - Most used: Order tracking (60%), returns (25%), account (15%)
    - Mobile app: 70% of self-service on mobile
    - Cost: ₺2M development, ₺200K annual maintenance
    - Savings: ₺10M/year (reduced support staff needs)"""@en ;
    :hasResource [
        :downloadURL <https://www.zendesk.com/blog/self-service-portal/> ;
        rdfs:label "Self-Service Best Practices"@en
    ] .

