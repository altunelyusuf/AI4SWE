#################################################################
#    DEPLOYMENT & RELEASE MANAGEMENT (40 Classes)
#################################################################

:BlueGreenDeployment rdf:type owl:Class ;
    rdfs:subClassOf :DeploymentStrategy ;
    rdfs:label "Blue-Green Deployment"@en ;
    skos:definition "Deployment technique maintaining two identical production environments (blue and green) allowing instant rollback and zero-downtime deployments for Turkish fashion e-commerce platforms"@en ;
    :hasBenefit "Zero downtime during deployments"@en ;
    :hasBenefit "Instant rollback capability (<1 minute)"@en ;
    :hasBenefit "Safe testing in production-like environment"@en ;
    :hasChallenge "Requires double infrastructure cost during deployment"@en ;
    :hasChallenge "Database migrations complexity"@en ;
    :usesTool :Kubernetes ;
    :usesTool :AWSelasticBeanstalk ;
    :fashionRetailExample """Trendyol Blue-Green Deployment:
    - Blue environment: Current production (50M users)
    - Green environment: New version deployment
    - Testing: Green receives 5% traffic for validation
    - Switch: DNS/load balancer flip to green (30 seconds)
    - Rollback: Instant switch back to blue if issues
    - Frequency: 50+ deployments per week
    - Success rate: 99.8% (rollback in 0.2% cases)
    - Zero customer-impacting incidents in 2024"""@en ;
    :hasResource [
        rdfs:label "Blue-Green Deployment Guide"@en ;
        :downloadURL <https://martinfowler.com/bliki/BlueGreenDeployment.html> ;
        :resourceType "Deployment Pattern"@en
    ] .

:CanaryRelease rdf:type owl:Class ;
    rdfs:subClassOf :DeploymentStrategy ;
    rdfs:label "Canary Release"@en ;
    skos:definition "Gradual rollout technique releasing new version to small subset of users before full deployment, detecting issues early with minimal customer impact"@en ;
    :hasBenefit "Early problem detection (1% of users exposed)"@en ;
    :hasBenefit "Real production validation"@en ;
    :hasBenefit "Controlled blast radius"@en ;
    :hasChallenge "Requires sophisticated monitoring"@en ;
    :hasChallenge "Complex rollout orchestration"@en ;
    :fashionRetailExample """Hepsiburada Canary Process:
    - Stage 1: 1% traffic (internal employees + beta users) - 2 hours
    - Stage 2: 5% traffic (random users) - 4 hours  
    - Stage 3: 25% traffic - 8 hours
    - Stage 4: 100% traffic - full rollout
    - Monitoring: Error rates, latency, conversion, revenue per user
    - Automatic rollback: If error rate >0.5% or conversion drops >10%
    - Saved: 5 major incidents caught at 1% in 2024
    - Customer impact: 50K vs 50M (if full rollout)"""@en ;
    :hasResource [
        :downloadURL <https://martinfowler.com/bliki/CanaryRelease.html> ;
        rdfs:label "Canary Release Pattern"@en
    ] .

:FeatureToggle rdf:type owl:Class ;
    rdfs:subClassOf :DeploymentTechnique ;
    rdfs:label "Feature Toggle (Feature Flag)"@en ;
    skos:definition "Software development technique allowing features to be enabled/disabled at runtime without code deployment, enabling testing in production and gradual rollouts"@en ;
    :hasBenefit "Deploy code anytime, release features when ready"@en ;
    :hasBenefit "A/B testing different features"@en ;
    :hasBenefit "Emergency kill switch"@en ;
    :usesTool :LaunchDarkly ;
    :usesTool :Unleash ;
    :fashionRetailExample """LC Waikiki Feature Flag System:
    - 200+ active feature flags
    - Use cases: New recommendation algorithm (A/B test), Black Friday features (scheduled activation), Bug workaround (quick disable)
    - Targeting: User segment, percentage rollout, device type, location
    - Example: New checkout flow enabled for 10% mobile users in Istanbul
    - Management: Developer dashboard, automatic cleanup of old flags
    - Impact: Deploy 20+ times/day, release features independently
    - Cost: LaunchDarkly $500/month vs deployment flexibility worth millions"""@en ;
    :hasResource [
        :downloadURL <https://launchdarkly.com/blog/what-are-feature-flags/> ;
        rdfs:label "Feature Flag Guide"@en
    ] .

:DatabaseMigration rdf:type owl:Class ;
    rdfs:label "Database Schema Migration"@en ;
    skos:definition "Controlled process of evolving database schema with zero-downtime for fashion e-commerce supporting continuous deployment"@en ;
    :hasBenefit "Zero downtime schema changes"@en ;
    :hasBenefit "Reversible migrations"@en ;
    :hasBenefit "Version controlled schemas"@en ;
    :hasChallenge "Backward compatibility required"@en ;
    :hasChallenge "Large table migrations slow (billions of rows)"@en ;
    :usesTool :Flyway ;
    :usesTool :Liquibase ;
    :fashionRetailExample """Koton Database Migration Strategy:
    - Tool: Flyway for PostgreSQL migrations
    - Process: 
      1. Add new column (nullable) - deploy code reading both old/new
      2. Backfill data (background job, 1M rows/hour)
      3. Deploy code writing to new column
      4. Remove old column (after 2 weeks safety period)
    - Large migrations: Product table (50M rows) migration took 48 hours
    - Zero downtime maintained throughout
    - Rollback plan: Every migration has down script
    - Testing: All migrations tested on production copy first"""@en ;
    :hasResource [
        :downloadURL <https://flywaydb.org/documentation/> ;
        rdfs:label "Flyway Documentation"@en
    ] .

#################################################################
#    MONITORING & OBSERVABILITY EXTENDED (35 Classes)
#################################################################

:ApplicationPerformanceMonitoring rdf:type owl:Class ;
    rdfs:label "APM (Application Performance Monitoring)"@en ;
    skos:definition "Real-time monitoring of application performance including response times, throughput, error rates, and user experience for fashion e-commerce platforms"@en ;
    :hasBenefit "Proactive issue detection before customer impact"@en ;
    :hasBenefit "Root cause analysis in minutes vs hours"@en ;
    :hasBenefit "Performance optimization insights"@en ;
    :usesTool :Datadog ;
    :usesTool :NewRelic ;
    :usesTool :Dynatrace ;
    :fashionRetailExample """Defacto APM Implementation:
    - Tool: New Relic APM across 100+ microservices
    - Metrics tracked: Response time (p50, p95, p99), throughput, error rate, Apdex score
    - Distributed tracing: Full request journey across services
    - Alerts: Latency >500ms, error rate >1%, Apdex <0.9
    - Business transactions: Homepage load, product search, checkout flow
    - Real user monitoring: Actual customer experience measured
    - Saved: 20+ critical issues caught before customer complaints
    - MTTR: 15 minutes (was 2 hours without APM)"""@en ;
    :hasResource [
        :downloadURL <https://newrelic.com/resources/ebooks/apm-best-practices> ;
        rdfs:label "APM Best Practices"@en
    ] .

:SyntheticMonitoring rdf:type owl:Class ;
    rdfs:label "Synthetic Monitoring"@en ;
    skos:definition "Automated simulation of user journeys and transactions to proactively detect issues before real customers encounter them"@en ;
    :hasBenefit "24/7 proactive monitoring"@en ;
    :hasBenefit "Geographic performance validation"@en ;
    :hasBenefit "SLA validation"@en ;
    :usesTool :Pingdom ;
    :usesTool :Datadog_Synthetics ;
    :fashionRetailExample """Morhipo Synthetic Monitoring:
    - 50 synthetic tests running every 5 minutes
    - Critical journeys: Homepage load, search "elbise", product view, add to cart, checkout
    - Test locations: Istanbul, Ankara, Izmir, Frankfurt (CDN validation)
    - SLA target: 95% of tests complete in <3 seconds
    - Alerts: Test failure, latency spike, functionality break
    - Caught issues: CDN misconfiguration (before customer traffic), payment gateway downtime (5am, fixed before 9am rush)
    - Cost: Pingdom $200/month
    - Value: Prevented 3 major outages in 2024"""@en ;
    :hasResource [
        :downloadURL <https://www.datadoghq.com/knowledge-center/synthetic-monitoring/> ;
        rdfs:label "Synthetic Monitoring Guide"@en
    ] .

:RealUserMonitoring rdf:type owl:Class ;
    rdfs:label "RUM (Real User Monitoring)"@en ;
    skos:definition "Monitoring actual user interactions and performance experienced by real customers in their browsers and mobile apps"@en ;
    :hasBenefit "Real customer experience data"@en ;
    :hasBenefit "Device/browser/network performance insights"@en ;
    :hasBenefit "Geographic performance breakdown"@en ;
    :fashionRetailExample """Trendyol RUM Analytics:
    - Tool: Google Analytics 4 + Datadog RUM
    - Metrics: Page load time, first contentful paint, time to interactive, cumulative layout shift
    - Segmentation: Device (iOS/Android/Desktop), browser, network (WiFi/4G/3G), location
    - Insights discovered:
      * Mobile users in rural areas: 8 second load time (4G weak)
      * iOS 14 users: 30% slower (Safari issue identified)
      * Checkout page: Layout shift causing accidental clicks (fixed, conversion +2%)
    - Sample: 100% of traffic (50M sessions/day)
    - Cost: Included in Datadog plan
    - Impact: Core Web Vitals optimization increased SEO traffic by 15%"""@en ;
    :hasResource [
        :downloadURL <https://web.dev/vitals/> ;
        rdfs:label "Core Web Vitals Guide"@en
    ] .

:ErrorTracking rdf:type owl:Class ;
    rdfs:label "Error Tracking & Management"@en ;
    skos:definition "Automated collection, aggregation, and alerting of application errors with context for rapid debugging in fashion e-commerce applications"@en ;
    :hasBenefit "Automatic error discovery"@en ;
    :hasBenefit "Rich context (user, device, stack trace)"@en ;
    :hasBenefit "Error trend analysis"@en ;
    :usesTool :Sentry ;
    :usesTool :Rollbar ;
    :fashionRetailExample """N11 Error Tracking:
    - Tool: Sentry (frontend + backend)
    - Errors collected: 10M+ events/month
    - Deduplication: Similar errors grouped
    - Context captured: User ID, session, browser, device, breadcrumbs (last actions)
    - Alerting: Critical errors → PagerDuty, High priority → Slack
    - Example error: "Payment failed for user X" → Full context shows old iOS version incompatible with 3D Secure 2.0
    - Resolution: 80% of errors fixed within 24 hours
    - Source maps: JavaScript errors show original TypeScript code
    - Cost: $200/month
    - Value: Prevented revenue loss of ₺5M+ (caught payment issues immediately)"""@en ;
    :hasResource [
        :downloadURL <https://docs.sentry.io/> ;
        rdfs:label "Sentry Documentation"@en
    ] .

#################################################################
#    COST OPTIMIZATION (30 Classes)
#################################################################

:CloudCostOptimization rdf:type owl:Class ;
    rdfs:label "Cloud Cost Optimization"@en ;
    skos:definition "Strategies and techniques to reduce cloud infrastructure costs while maintaining performance and availability for Turkish fashion e-commerce platforms"@en ;
    :hasBenefit "30-50% cost reduction typical"@en ;
    :hasBenefit "Better resource utilization"@en ;
    :hasBenefit "Cost visibility and forecasting"@en ;
    :hasChallenge "Requires continuous monitoring"@en ;
    :hasChallenge "Balancing cost vs performance"@en ;
    :usesTool :AWSCostExplorer ;
    :usesTool :Kubecost ;
    :fashionRetailExample """Hepsiburada Cloud Cost Optimization (AWS):
    - Initial monthly cost: $800K
    - Optimizations:
      * Reserved instances: -35% ($280K savings/year)
      * Spot instances for batch jobs: -70% ($150K savings/year)
      * Right-sizing: Over-provisioned EC2 → Smaller instances (-25%, $200K/year)
      * S3 lifecycle: Move old images to Glacier (-50% storage, $50K/year)
      * Unused resources: Deleted 200+ forgotten resources ($30K/year)
      * Database optimization: RDS right-sizing ($80K/year)
    - Total savings: $790K/year (9% cost reduction)
    - Final monthly cost: $734K
    - Tools: AWS Cost Explorer, Kubecost for Kubernetes
    - Process: Weekly cost review meetings, automated alerts for anomalies"""@en ;
    :hasResource [
        :downloadURL <https://aws.amazon.com/architecture/cost-optimization/> ;
        rdfs:label "AWS Cost Optimization Guide"@en
    ] .

:AutoScaling rdf:type owl:Class ;
    rdfs:label "Auto-Scaling"@en ;
    skos:definition "Automatic adjustment of compute resources based on demand, ensuring performance during traffic spikes while minimizing costs during low traffic"@en ;
    :hasBenefit "Handles traffic spikes automatically (Black Friday: 50x)"@en ;
    :hasBenefit "Reduces costs during off-peak (nights: 60% less resources)"@en ;
    :hasBenefit "No manual intervention required"@en ;
    :fashionRetailExample """LC Waikiki Auto-Scaling (Kubernetes HPA):
    - Metrics: CPU utilization, memory, custom (requests per second)
    - Web pods: Min 20, Max 500, Target: 70% CPU
    - Scaling behavior:
      * Normal: 50 pods, $5K/day
      * Campaign day: 350 pods, $35K/day
      * Night: 25 pods, $2.5K/day
    - Scaling speed: Scale up in 2 minutes, scale down in 10 minutes (gradual)
    - Black Friday 2024: Handled 100x traffic spike automatically
    - Cost savings: $200K/month vs fixed capacity for peak
    - Availability: 99.95% maintained throughout"""@en ;
    :hasResource [
        :downloadURL <https://kubernetes.io/docs/tasks/run-application/horizontal-pod-autoscale/> ;
        rdfs:label "Kubernetes HPA Documentation"@en
    ] .

#################################################################
#    COMPLIANCE & LEGAL (35 Classes)
#################################################################

:KVKKCompliance rdf:type owl:Class ;
    rdfs:label "KVKK Compliance (Turkish GDPR)"@en ;
    skos:definition "Compliance with Turkish Personal Data Protection Law (KVKK) requiring consent management, data minimization, and user rights for Turkish fashion e-commerce"@en ;
    :hasBenefit "Legal compliance (mandatory)"@en ;
    :hasBenefit "Customer trust"@en ;
    :hasBenefit "Avoids ₺20M fines"@en ;
    :hasChallenge "Complex implementation"@en ;
    :hasChallenge "Ongoing compliance maintenance"@en ;
    :fashionRetailExample """Trendyol KVKK Compliance Program:
    - Explicit consent: Cookie banner, marketing opt-in, data processing consent
    - Data inventory: Catalog of all personal data collected (50+ data points)
    - Privacy policy: Clear, accessible, Turkish language
    - User rights: Access, deletion, correction, portability (self-service portal)
    - Data minimization: Only collect necessary data, delete after retention period
    - Security: Encryption at rest/transit, access controls, audit logs
    - DPO: Dedicated Data Protection Officer
    - KVKK registry: Registered with Turkish Data Protection Authority
    - Vendor management: KVKK compliance in all supplier contracts
    - Training: Annual KVKK training for all employees
    - Audits: Annual external KVKK audit
    - Cost: ₺2M setup, ₺500K annual maintenance
    - Requests handled: 50K+ data subject requests (2024)"""@en ;
    :hasResource [
        :downloadURL <https://www.kvkk.gov.tr/Icerik/6649/Personal-Data-Protection-Law> ;
        rdfs:label "KVKK Law (Turkish GDPR)"@en
    ] .

:PaymentCardCompliance rdf:type owl:Class ;
    rdfs:label "PCI DSS Compliance"@en ;
    skos:definition "Payment Card Industry Data Security Standard compliance required for handling credit card information in Turkish fashion e-commerce"@en ;
    :hasBenefit "Required for payment processing"@en ;
    :hasBenefit "Prevents payment fraud"@en ;
    :hasBenefit "Customer trust in payment security"@en ;
    :hasChallenge "Expensive certification (₺500K+)"@en ;
    :hasChallenge "Quarterly scans and annual audits"@en ;
    :fashionRetailExample """Hepsiburada PCI DSS Level 1 Compliance:
    - Level 1: 6M+ transactions/year (highest level)
    - Requirements: 12 categories, 300+ controls
    - Key controls:
      * No cardholder data storage (tokenization via İyzico)
      * Network segmentation (payment systems isolated)
      * Encryption: TLS 1.3 for data in transit
      * Access control: Role-based, MFA for admins
      * Vulnerability scanning: Weekly automated scans
      * Penetration testing: Annual by QSA
      * Security awareness: Quarterly training
    - Audit: Annual onsite audit by qualified assessor (5 days, ₺300K)
    - Cost: ₺800K annual (tools, audits, personnel)
    - Alternative: Payment tokenization offloads 80% of PCI scope"""@en ;
    :hasResource [
        :downloadURL <https://docs-prv.pcisecuritystandards.org/PCI%20DSS/Standard/PCI-DSS-v4_0.pdf> ;
        rdfs:label "PCI DSS v4.0 Standard"@en
    ] .

:EInvoiceCompliance rdf:type owl:Class ;
    rdfs:label "E-Invoice (e-Fatura) Compliance"@en ;
    skos:definition "Turkish electronic invoicing system compliance mandatory for all companies, requiring structured XML invoices sent through government portal"@en ;
    :hasBenefit "Legal requirement (mandatory)"@en ;
    :hasBenefit "Automated invoice processing"@en ;
    :hasBenefit "Faster payment cycles"@en ;
    :fashionRetailExample """Koton E-Fatura Integration:
    - System: GIB (Turkish Revenue Administration) e-Fatura portal
    - Volume: 500K+ invoices per month
    - Format: UBL-TR XML standard
    - Process: Order completed → Invoice generated → Signed with e-Signature → Sent to GIB → Delivered to customer
    - Integration: SAP ERP → e-Fatura provider → GIB
    - Provider: Logo e-Fatura (₺50K/year)
    - Compliance: 100% of B2B invoices electronic (mandatory)
    - Archiving: 10-year digital archive required
    - Benefit: Reduced invoice processing time from 3 days to 1 hour"""@en ;
    :hasResource [
        :downloadURL <https://www.gib.gov.tr/e-fatura> ;
        rdfs:label "Turkish E-Invoice System"@en
    ] .

