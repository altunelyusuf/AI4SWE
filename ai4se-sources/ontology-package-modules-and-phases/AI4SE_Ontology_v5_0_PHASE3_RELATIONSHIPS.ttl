@prefix : <http://ai4se.org/ontology/v5#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
#    PHASE 3: STRUCTURAL ENHANCEMENT
#    Adding Relationships & OWL Axioms
#    Focus: Turkish Fashion Retail Domain Connections
#################################################################

#################################################################
#    ENHANCED OBJECT PROPERTIES FOR RELATIONSHIPS
#################################################################

:complementsWith rdf:type owl:ObjectProperty ;
    rdfs:label "complements with"@en ;
    rdfs:comment "Indicates techniques/tools that work well together"@en ;
    owl:inverseOf :complementsWith .

:requiresForProduction rdf:type owl:ObjectProperty ;
    rdfs:label "requires for production"@en ;
    rdfs:comment "Mandatory requirement for production deployment in e-commerce"@en .

:optimizesFor rdf:type owl:ObjectProperty ;
    rdfs:label "optimizes for"@en ;
    rdfs:comment "Technique optimizes specific aspect of system"@en .

:scalesTo rdf:type owl:ObjectProperty ;
    rdfs:label "scales to"@en ;
    rdfs:comment "System can scale to handle specified load"@en .

:integratesWith rdf:type owl:ObjectProperty ;
    rdfs:label "integrates with"@en ;
    rdfs:comment "Technical integration between tools/systems"@en .

:supportsDomain rdf:type owl:ObjectProperty ;
    rdfs:label "supports domain"@en ;
    rdfs:comment "Technique/tool specifically supports business domain"@en .

#################################################################
#    FASHION RETAIL DOMAIN RELATIONSHIPS
#################################################################

# Supply Chain Management Relationships
:SupplyChainManagement :requiresForProduction :InventoryOptimization ;
    :requiresForProduction :DemandForecasting ;
    :requiresForProduction :LogisticsManagement ;
    :requiresForProduction :WarehouseManagement ;
    :complementsWith :ProductLifecycleManagement ;
    :integratesWith :ERPSystem ;
    :integratesWith :WMSSystem ;
    :scalesTo :MillionTransactionsPerDay ;
    :optimizesFor :CostReduction ;
    :optimizesFor :DeliverySpeed ;
    :supportsDomain :FashionRetailDomain .

# Product Lifecycle Management Relationships
:ProductLifecycleManagement :requires :CollaborationTools ;
    :requires :VersionControl ;
    :complementsWith :SupplyChainManagement ;
    :complementsWith :DesignTools ;
    :enables :RapidPrototyping ;
    :enables :SustainableFashion ;
    :integratesWith :ERPSystem ;
    :integratesWith :DesignSoftware ;
    :supportsDomain :FashionRetailDomain .

# Store Management Relationships
:StoreManagement :requires :POSSystem ;
    :requires :InventoryDatabase ;
    :requires :StaffSchedulingSystem ;
    :complementsWith :OmnichannelRetail ;
    :integratesWith :ECommerceplatform ;
    :integratesWith :LoyaltyProgram ;
    :enables :ClickAndCollect ;
    :enables :EndlessAisle ;
    :supportsDomain :FashionRetailDomain .

# Import/Export Management Relationships
:ImportExportManagement :requires :CustomsSoftware ;
    :requires :TradeCompliance ;
    :requires :CurrencyManagement ;
    :complementsWith :LogisticsManagement ;
    :complementsWith :SupplyChainManagement ;
    :integratesWith :BankingSystem ;
    :integratesWith :GovernmentPortals ;
    :supportsDomain :InternationalTrade .

# Logistics Management Relationships
:LogisticsManagement :requires :RouteOptimization ;
    :requires :CarrierIntegration ;
    :requires :TrackingSystem ;
    :complementsWith :WarehouseManagement ;
    :complementsWith :LastMileDelivery ;
    :enables :SameDayDelivery ;
    :enables :RealTimeTracking ;
    :optimizesFor :DeliveryCost ;
    :optimizesFor :DeliverySpeed ;
    :supportsDomain :FashionRetailDomain .

# Warehouse Management Relationships
:WarehouseManagement :requires :WMSSystem ;
    :requires :RFIDTracking ;
    :requires :BarcodeScanners ;
    :complementsWith :LogisticsManagement ;
    :complementsWith :InventoryOptimization ;
    :enables :AutomatedPicking ;
    :enables :RealTimeInventory ;
    :optimizesFor :SpaceUtilization ;
    :optimizesFor :PickingSpeed ;
    :supportsDomain :FashionRetailDomain .

