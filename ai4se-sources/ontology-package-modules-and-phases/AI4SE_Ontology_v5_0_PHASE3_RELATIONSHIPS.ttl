#################################################################
#    OWL AXIOMS & CONSTRAINTS
#################################################################

# Disjoint Classes
:UnitTesting owl:disjointWith :IntegrationTesting .
:MicroservicesArchitecture owl:disjointWith :MonolithicArchitecture .
:OnPremise owl:disjointWith :CloudHosted .

# Equivalent Classes
:PenetrationTesting owl:equivalentClass :PenTesting .
:ECommerce owl:equivalentClass :ElectronicCommerce .
:AI owl:equivalentClass :ArtificialIntelligence .

# Property Restrictions
:SecurityTesting rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :requiresForProduction ;
    owl:someValuesFrom :SecurityExpertise
] .

:MicroservicesArchitecture rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :requires ;
    owl:someValuesFrom :ContainerOrchestration
] .

:FashionRetailDomain rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :requires ;
    owl:someValuesFrom :InventoryDatabase
] .

:ECommerceplatform rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :complementsWith ;
    owl:someValuesFrom :PaymentGateway
] .

# Cardinality Restrictions
:MobileAppDevelopment rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :supportsPlatform ;
    owl:minCardinality "2"^^xsd:nonNegativeInteger  # At least iOS and Android
] .

:FashionRetailDomain rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :integratesWith ;
    owl:minCardinality "5"^^xsd:nonNegativeInteger  # Multiple system integrations
] .

#################################################################
#    TURKISH FASHION RETAIL SPECIFIC RELATIONSHIPS
#################################################################

# Trendyol Architecture Relationships
:TrendyolArchitecture rdf:type owl:NamedIndividual ;
    rdfs:label "Trendyol Platform Architecture"@en ;
    :implements :MicroservicesArchitecture ;
    :uses :Kubernetes ;
    :uses :PostgreSQL ;
    :uses :Redis ;
    :uses :Kafka ;
    :scalesTo "50 million users" ;
    :handles "500K concurrent users" ;
    :processes "10M orders per month" ;
    :supportsDomain :FashionRetailDomain ;
    :supportsDomain :MarketplaceEcommerce .

# Hepsiburada Technology Stack
:HepsiburadaTechStack rdf:type owl:NamedIndividual ;
    rdfs:label "Hepsiburada Technology Stack"@en ;
    :implements :MicroservicesArchitecture ;
    :implements :EventDrivenArchitecture ;
    :uses :Kubernetes ;
    :uses :Java ;
    :uses :ReactNative ;
    :integratesWith "500+ third-party services" ;
    :supportsDomain :FashionRetailDomain ;
    :supportsDomain :MarketplaceEcommerce .

# LC Waikiki Digital Platform
:LCWaikikDigitalPlatform rdf:type owl:NamedIndividual ;
    rdfs:label "LC Waikiki Digital Commerce Platform"@en ;
    :implements :OmnichannelArchitecture ;
    :uses :SAPCommerce ;
    :uses :ARTechnology ;
    :integrates "1,100+ physical stores" ;
    :supports "50+ countries" ;
    :supportsDomain :FashionRetailDomain .

#################################################################
#    INTEGRATION PATTERNS
#################################################################

# E-Commerce Integration Pattern
:ECommerceIntegrationPattern rdf:type owl:Class ;
    rdfs:label "E-Commerce Integration Pattern"@en ;
    skos:definition "Common integration pattern for Turkish fashion e-commerce connecting core systems"@en ;
    :requires :APIGateway ;
    :requires :EventBus ;
    :requires :ServiceRegistry ;
    :integratesWith :ProductCatalog ;
    :integratesWith :InventorySystem ;
    :integratesWith :OrderManagement ;
    :integratesWith :PaymentSystem ;
    :integratesWith :ShippingSystem ;
    :integratesWith :CustomerService ;
    :fashionRetailExample """Standard Turkish Fashion E-Commerce Stack:
    Frontend: React/React Native
    API Gateway: Kong/AWS API Gateway
    Microservices: Java/Node.js
    Database: PostgreSQL (transactional) + MongoDB (catalog)
    Cache: Redis
    Message Bus: Kafka/RabbitMQ
    Search: Elasticsearch
    CDN: CloudFlare
    Payments: İyzico, PayU, 3D Secure
    Shipping: Yurtiçi, Aras, PTT Cargo APIs
    Analytics: Google Analytics, Mixpanel
    Monitoring: Datadog, Sentry"""@en .

