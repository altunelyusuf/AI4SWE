# ============================================================
# MOBILE DEVELOPMENT (60 Classes)
# ============================================================

:MobileDevelopment rdf:type owl:Class ;
    rdfs:subClassOf :SEConcept ;
    rdfs:label "Mobile Development"@en ;
    skos:definition "Development of applications for mobile devices including iOS and Android, with focus on e-commerce shopping experiences, payment integration, and omnichannel retail"@en ;
    :hasBenefit "Direct customer channel (70% of e-commerce traffic)"@en ;
    :hasBenefit "Push notifications for engagement"@en ;
    :hasBenefit "Location-based services for stores"@en ;
    :hasChallenge "iOS and Android platform differences"@en ;
    :hasChallenge "App store review processes"@en ;
    :usesTool :ReactNative ;
    :usesTool :Flutter ;
    :usesTool :Swift ;
    :usesTool :Kotlin ;
    :fashionRetailExample """Trendyol mobile apps (30M+ downloads):
    - iOS app: Swift, native development
    - Android app: Kotlin, native development
    - Features:
        - Personalized product feed (ML-powered)
        - AR try-on for clothing and accessories
        - Barcode scanner for in-store price comparison
        - One-click checkout with saved cards
        - Live video shopping
        - Social sharing
        - Push notifications (abandoned cart, price drops, personalized offers)
    - Performance: 4.7 rating (iOS), 4.5 rating (Android)
    - Conversion: 5.2% mobile vs 2.8% web
    - Team: 80 mobile developers
    - Release: Bi-weekly releases via CI/CD"""@en ;
    :hasResource [
        :downloadURL <https://developer.apple.com/library/archive/documentation/iPhone/Conceptual/iPhoneOSProgrammingGuide/Introduction/Introduction.html> ;
        rdfs:label "iOS App Programming Guide"@en
    ] ;
    :hasResource [
        :downloadURL <https://developer.android.com/guide> ;
        rdfs:label "Android Developer Guide"@en
    ] .

:CrossPlatformDevelopment rdf:type owl:Class ;
    rdfs:subClassOf :MobileDevelopment ;
    rdfs:label "Cross-Platform Mobile Development"@en ;
    skos:definition "Development approach using single codebase for iOS and Android using frameworks like React Native or Flutter, reducing development time and cost"@en ;
    :hasBenefit "Single codebase (50% cost reduction)"@en ;
    :hasBenefit "Faster time to market"@en ;
    :hasBenefit "Easier maintenance"@en ;
    :hasChallenge "Performance vs native apps"@en ;
    :hasChallenge "Platform-specific features require native modules"@en ;
    :usesTool :ReactNative ;
    :usesTool :Flutter ;
    :fashionRetailExample """LC Waikiki Flutter migration:
    - Before: Separate iOS (Swift) and Android (Java) teams
    - After: Single Flutter codebase
    - Team: 40 developers → 20 Flutter developers
    - Development time: 6 months → 3 months per major feature
    - Code sharing: 95% shared, 5% platform-specific
    - Performance: 60 FPS on most devices
    - App size: 45 MB (iOS), 38 MB (Android)
    - Challenges: Camera integration, payment SDKs needed native bridges
    - Results: ₺500K annual savings in development costs"""@en ;
    :hasResource [
        :downloadURL <https://flutter.dev/docs/resources/architectural-overview> ;
        rdfs:label "Flutter Architectural Overview"@en
    ] ;
    :hasResource [
        :downloadURL <https://reactnative.dev/docs/getting-started> ;
        rdfs:label "React Native Documentation"@en
    ] .

:MobileUIUX rdf:type owl:Class ;
    rdfs:subClassOf :MobileDevelopment ;
    rdfs:label "Mobile UI/UX Design"@en ;
    skos:definition "User interface and experience design for mobile applications following platform guidelines and e-commerce best practices for conversion optimization"@en ;
    :hasBenefit "Increases conversion rates 20-50%"@en ;
    :hasBenefit "Reduces cart abandonment"@en ;
    :hasBenefit "Improves user satisfaction"@en ;
    :fashionRetailExample """Koton mobile app UX optimization:
    - A/B testing: 50+ experiments per quarter
    - Key improvements:
        - Sticky "Add to Cart" button: +15% conversion
        - Quick filters (size, color) at top: +25% engagement
        - Infinite scroll on product listing: +40% products viewed
        - One-tap reorder: +60% repeat purchases
        - Size recommendation AI: -30% returns
        - Swipe gestures for product images: +20% engagement
    - Design system: Material Design (Android), HIG (iOS)
    - Accessibility: WCAG 2.1 Level AA compliance
    - User research: Monthly usability testing sessions"""@en ;
    :hasResource [
        :downloadURL <https://material.io/design> ;
        rdfs:label "Material Design Guidelines"@en
    ] ;
    :hasResource [
        :downloadURL <https://developer.apple.com/design/human-interface-guidelines/> ;
        rdfs:label "Apple Human Interface Guidelines"@en
    ] .

:MobilePaymentIntegration rdf:type owl:Class ;
    rdfs:subClassOf :MobileDevelopment ;
    rdfs:label "Mobile Payment Integration"@en ;
    skos:definition "Integration of payment methods in mobile apps including credit cards, digital wallets, buy-now-pay-later, and local payment methods for Turkish market"@en ;
    :hasBenefit "Seamless checkout experience"@en ;
    :hasBenefit "Higher conversion (one-click payments)"@en ;
    :hasBenefit "Supports multiple payment methods"@en ;
    :hasChallenge "PCI-DSS compliance complexity"@en ;
    :hasChallenge "Payment provider SDK integration"@en ;
    :fashionRetailExample """Hepsiburada mobile payment options:
    - Credit/Debit cards: iyzico SDK integration
    - Digital wallets: Apple Pay, Google Pay
    - Bank transfers: QR code via BKM Express
    - BNPL: Taksit, Hopi Pay
    - Gift cards: Internal system
    - HepsiPay: Proprietary digital wallet (3M users)
    - Features:
        - Save cards with tokenization
        - 3D Secure 2.0 biometric authentication
        - One-click checkout for returning customers
        - Installment options (2-12 months)
        - Dynamic installment rates by bank
    - Conversion: Payment completion rate 85%
    - Fraud rate: 0.08% (industry avg: 1.2%)"""@en ;
    :hasResource [
        :downloadURL <https://developer.apple.com/apple-pay/implementation/> ;
        rdfs:label "Apple Pay Integration Guide"@en
    ] .

:MobilePushNotifications rdf:type owl:Class ;
    rdfs:subClassOf :MobileDevelopment ;
    rdfs:label "Mobile Push Notifications"@en ;
    skos:definition "System for sending notifications to mobile devices for user engagement, abandoned cart recovery, and personalized promotions in fashion retail"@en ;
    :hasBenefit "Recovers 20-30% of abandoned carts"@en ;
    :hasBenefit "Increases app engagement 3-10x"@en ;
    :hasBenefit "Personalized promotions drive sales"@en ;
    :hasChallenge "Notification fatigue (opt-out risk)"@en ;
    :hasChallenge "iOS notification permission rates (40-50%)"@en ;
    :usesTool :OneSignal ;
    :usesTool :Firebase CloudMessaging ;
    :usesTool :AmazonSNS ;
    :fashionRetailExample """Defacto push notification strategy:
    - Opt-in rate: iOS 45%, Android 85%
    - Segmentation: 200+ user segments
    - Personalization: ML-powered recommendations
    - Types:
        - Abandoned cart: 1 hour, 24 hours after abandonment
        - Price drops: On followed items
        - Back in stock: For out-of-stock items
        - Flash sales: Limited-time offers
        - Order updates: Shipped, delivered
        - Personalized: Based on browsing history
    - A/B testing: Message copy, timing, images
    - Results:
        - Open rate: 12% (industry avg: 7%)
        - Conversion rate: 4.5% (industry avg: 2%)
        - Revenue: ₺15M annually from push notifications
    - Best practices:
        - Max 2 promotional notifications per week
        - Transactional notifications unlimited
        - Time-zone aware sending"""@en ;
    :hasResource [
        :downloadURL <https://firebase.google.com/docs/cloud-messaging> ;
        rdfs:label "Firebase Cloud Messaging Documentation"@en
    ] .

:MobileAppAnalytics rdf:type owl:Class ;
    rdfs:subClassOf :MobileDevelopment ;
    rdfs:label "Mobile App Analytics"@en ;
    skos:definition "Tracking and analyzing mobile app usage, user behavior, conversion funnels, and performance metrics for data-driven optimization"@en ;
    :hasBenefit "Data-driven product decisions"@en ;
    :hasBenefit "Identifies friction points in user journey"@en ;
    :hasBenefit "Measures feature adoption"@en ;
    :usesTool :GoogleAnalytics4 ;
    :usesTool :Mixpanel ;
    :usesTool :Amplitude ;
    :fashionRetailExample """Morhipo mobile analytics dashboard:
    - Platform: Google Analytics 4 + Mixpanel
    - Tracked events: 150+ custom events
    - Key metrics:
        - DAU/MAU: 500K / 2.5M (20% stickiness)
        - Session length: 8.5 minutes average
        - Screens per session: 12.3
        - Conversion funnel:
            - App open: 100%
            - Product view: 60%
            - Add to cart: 15%
            - Checkout: 8%
            - Purchase: 5.2%
        - Retention: D1=40%, D7=25%, D30=15%
    - Cohort analysis: Monthly cohorts tracked for 12 months
    - Attribution: AppsFlyer for marketing campaign attribution
    - Crash reporting: Firebase Crashlytics (99.5% crash-free rate)
    - Performance monitoring: App load time, API response time"""@en ;
    :hasResource [
        :downloadURL <https://support.google.com/analytics/answer/9304153> ;
        rdfs:label "Google Analytics 4 for Mobile Apps"@en
    ] .

