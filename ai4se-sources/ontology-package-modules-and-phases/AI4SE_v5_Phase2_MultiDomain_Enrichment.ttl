@prefix : <http://ai4se.org/ontology/v5#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
#    PHASE 2 PART 2 - CRITICAL DOMAINS ENRICHMENT (400 Classes)
#    Turkish Fashion Retail & E-Commerce Marketplace Context
#################################################################

# ============================================================
# DATABASE ENGINEERING (80 Classes)
# ============================================================

:DatabaseDesign rdf:type owl:Class ;
    rdfs:subClassOf :SEConcept ;
    rdfs:label "Database Design"@en ;
    skos:definition "Process of producing detailed data model of database, including schema design, normalization, indexing strategy, and performance optimization for e-commerce workloads"@en ;
    :hasBenefit "Optimizes query performance (10-100x faster)"@en ;
    :hasBenefit "Ensures data integrity"@en ;
    :hasBenefit "Scales to millions of records"@en ;
    :hasChallenge "Balance between normalization and performance"@en ;
    :hasChallenge "Handling seasonal traffic spikes (10x normal)"@en ;
    :usesTool :PostgreSQL ;
    :usesTool :MySQL ;
    :usesTool :MongoDB ;
    :fashionRetailExample """Trendyol database architecture (50M+ products):
    - Product catalog: PostgreSQL with 120+ tables
    - Sharding: 16 shards by category (fashion, electronics, home)
    - Read replicas: 8 read replicas for search queries
    - Caching: Redis for hot products (95% cache hit rate)
    - Indexing: 200+ optimized indexes on search columns
    - Partitioning: Order tables partitioned by month
    - Performance: Product search <50ms p95
    - Scale: 50,000 orders/hour during campaigns
    - Data volume: 500TB total, 5TB/day growth"""@en ;
    :hasResource [
        :downloadURL <https://www.postgresql.org/files/documentation/pdf/15/postgresql-15-A4.pdf> ;
        rdfs:label "PostgreSQL 15 Documentation"@en
    ] ;
    :hasResource [
        :downloadURL <https://db-engines.com/en/system/PostgreSQL> ;
        rdfs:label "DB-Engines PostgreSQL Profile"@en
    ] .

:DatabaseOptimization rdf:type owl:Class ;
    rdfs:subClassOf :DatabaseDesign ;
    rdfs:label "Database Query Optimization"@en ;
    skos:definition "Techniques for improving database query performance including index optimization, query rewriting, execution plan analysis, and database tuning"@en ;
    :hasBenefit "Reduces page load time by 50-80%"@en ;
    :hasBenefit "Cuts infrastructure costs 30-50%"@en ;
    :hasBenefit "Handles higher concurrent users"@en ;
    :hasChallenge "Requires DBA expertise"@en ;
    :hasChallenge "Trade-offs between write and read performance"@en ;
    :fashionRetailExample """LC Waikiki query optimization project:
    - Slow query log: Identified 50 queries >1 second
    - EXPLAIN ANALYZE: Analyzed execution plans
    - Missing indexes: Added 25 new indexes
    - Query rewrite: Optimized JOIN sequences
    - Materialized views: For complex reporting queries
    - Connection pooling: PgBouncer (3,000 connections → 100 DB connections)
    - Result: Homepage load 2.5s → 0.8s
    - Cost savings: Downgraded from db.r5.4xlarge to db.r5.2xlarge (₺120K/year)"""@en ;
    :hasResource [
        :downloadURL <https://use-the-index-luke.com/sql/table-of-contents> ;
        rdfs:label "Use The Index, Luke! - SQL Performance Guide"@en
    ] .

:DataModeling rdf:type owl:Class ;
    rdfs:subClassOf :DatabaseDesign ;
    rdfs:label "Data Modeling"@en ;
    skos:definition "Process of creating abstract data model including entity-relationship diagrams, schema design, and defining relationships for e-commerce domain"@en ;
    :hasBenefit "Clear data structure understanding"@en ;
    :hasBenefit "Reduces development time"@en ;
    :hasBenefit "Facilitates team communication"@en ;
    :usesTool :ERWin ;
    :usesTool :Lucidchart ;
    :fashionRetailExample """Koton e-commerce data model (simplified):
    Entities:
    - Customer (5M records): ID, name, email, phone, addresses[]
    - Product (200K): SKU, name, description, category, brand, price
    - ProductVariant (2M): Size, color, stock, barcode
    - Order (10M): Order#, customer, date, status, total
    - OrderItem (30M): Order, product, quantity, price
    - Payment (10M): Order, method, status, transaction_id
    - Shipment (10M): Order, carrier, tracking#, status
    - Review (500K): Product, customer, rating, text, date
    
    Key relationships:
    - Customer 1→N Orders
    - Order 1→N OrderItems
    - Product 1→N ProductVariants
    - Product 1→N Reviews"""@en ;
    :hasResource [
        :downloadURL <https://www.vertabelo.com/blog/technical-articles/database-model-for-an-online-shop> ;
        rdfs:label "E-Commerce Database Model Best Practices"@en
    ] .

:DatabaseScaling rdf:type owl:Class ;
    rdfs:subClassOf :DatabaseDesign ;
    rdfs:label "Database Scaling"@en ;
    skos:definition "Strategies for scaling databases to handle increased load including vertical scaling, horizontal scaling, sharding, and read replicas"@en ;
    :hasBenefit "Handles 10-100x traffic growth"@en ;
    :hasBenefit "Reduces query latency"@en ;
    :hasBenefit "Improves availability"@en ;
    :hasChallenge "Complex distributed transactions"@en ;
    :hasChallenge "Data consistency across shards"@en ;
    :fashionRetailExample """Hepsiburada database scaling journey:
    Phase 1 (2010): Single PostgreSQL (1M products)
    Phase 2 (2015): Master-replica setup (10M products)
    Phase 3 (2018): Sharding by category (25M products)
    Phase 4 (2022): Multi-region replication (50M products)
    
    Current architecture:
    - 32 database shards across 8 physical servers
    - 64 read replicas for search/listing queries
    - Citus for distributed PostgreSQL
    - Write capacity: 100,000 TPS
    - Read capacity: 1M QPS
    - Latency: <10ms p95 for key-value lookups
    - High availability: 99.99% uptime SLA"""@en ;
    :hasResource [
        :downloadURL <https://www.citusdata.com/resources/citus-real-world-postgres.pdf> ;
        rdfs:label "Scaling PostgreSQL with Citus"@en
    ] .

:NoSQLDatabases rdf:type owl:Class ;
    rdfs:subClassOf :DatabaseDesign ;
    rdfs:label "NoSQL Databases"@en ;
    skos:definition "Non-relational databases including document stores, key-value stores, column-family stores, and graph databases for specific use cases"@en ;
    :hasBenefit "Flexible schema for product catalogs"@en ;
    :hasBenefit "High performance for specific access patterns"@en ;
    :hasBenefit "Horizontal scalability"@en ;
    :usesTool :MongoDB ;
    :usesTool :Redis ;
    :usesTool :Elasticsearch ;
    :fashionRetailExample """Defacto polyglot persistence strategy:
    - MongoDB: Product catalog (flexible attributes per category)
        - 500K fashion products with varying attributes
        - Example: Dress has 'length', 'neckline'; Shoe has 'heel_height', 'material'
    - Redis: Session store, cart, real-time inventory
        - 5M active sessions
        - <1ms read latency
    - Elasticsearch: Product search, faceted filtering
        - 30+ search filters (brand, price, size, color, etc.)
        - Typo tolerance, synonym handling
        - Turkish language analyzer
    - PostgreSQL: Orders, payments, customer data (ACID requirements)
    - Neo4j: Product recommendations, similar items
        - Graph of product relationships
        - "Customers who bought X also bought Y\""""@en ;
    :hasResource [
        :downloadURL <https://www.mongodb.com/docs/manual/MongoDB-manual-master.pdf> ;
        rdfs:label "MongoDB Manual"@en
    ] ;
    :hasResource [
        :downloadURL <https://redis.io/docs/latest/> ;
        rdfs:label "Redis Documentation"@en
    ] .

:DatabaseReplication rdf:type owl:Class ;
    rdfs:subClassOf :DatabaseScaling ;
    rdfs:label "Database Replication"@en ;
    skos:definition "Technique of copying data from master database to one or more replica databases for high availability, load distribution, and disaster recovery"@en ;
    :hasBenefit "99.99%+ availability"@en ;
    :hasBenefit "Read load distribution"@en ;
    :hasBenefit "Disaster recovery capability"@en ;
    :fashionRetailExample """Morhipo multi-region replication:
    - Primary: AWS Istanbul (eu-central-1)
    - Replica 1: AWS Frankfurt (eu-central-1) - sync replication
    - Replica 2: AWS Ireland (eu-west-1) - async replication
    - Use cases:
        - Replica 1: Read queries from Istanbul region
        - Replica 2: Reporting and analytics
    - Replication lag: <100ms sync, <5s async
    - Failover: Automatic promotion in <30 seconds
    - Tested quarterly: Disaster recovery drills"""@en .

:DataWarehouse rdf:type owl:Class ;
    rdfs:subClassOf :DatabaseDesign ;
    rdfs:label "Data Warehouse"@en ;
    skos:definition "Central repository of integrated data from multiple sources, optimized for analytics and business intelligence in retail context"@en ;
    :hasBenefit "Single source of truth for analytics"@en ;
    :hasBenefit "Historical trend analysis"@en ;
    :hasBenefit "Business intelligence and reporting"@en ;
    :usesTool :Snowflake ;
    :usesTool :AmazonRedshift ;
    :usesTool :GoogleBigQuery ;
    :fashionRetailExample """LC Waikiki data warehouse (Snowflake):
    - Data sources: PostgreSQL, MongoDB, Salesforce, GA4, Facebook Ads
    - ETL: Fivetran for automated data pipelines
    - Data volume: 100TB historical data
    - Update frequency: Near real-time (5-minute delay)
    - Star schema: Fact tables (sales, inventory) + Dimension tables
    - Use cases:
        - Sales dashboards for executives
        - Inventory forecasting (ML models)
        - Customer segmentation for marketing
        - Supplier performance analysis
    - Users: 200+ business analysts, data scientists
    - Cost: $50K/month for compute + storage"""@en ;
    :hasResource [
        :downloadURL <https://www.snowflake.com/wp-content/uploads/2021/08/Snowflake-Data-Warehouse-Architecture.pdf> ;
        rdfs:label "Snowflake Architecture White Paper"@en
    ] .

:DatabaseBackup rdf:type owl:Class ;
    rdfs:subClassOf :DatabaseDesign ;
    rdfs:label "Database Backup & Recovery"@en ;
    skos:definition "Strategies for backing up databases and recovering from failures including full backups, incremental backups, and point-in-time recovery"@en ;
    :hasBenefit "Protects against data loss"@en ;
    :hasBenefit "Enables disaster recovery (RTO <1 hour)"@en ;
    :hasBenefit "Meets compliance requirements (7-10 year retention)"@en ;
    :fashionRetailExample """Trendyol backup strategy:
    - Full backups: Daily at 2 AM (low traffic)
    - Incremental backups: Every 4 hours
    - Transaction log backups: Every 15 minutes
    - Retention: 30 days hot, 7 years cold (S3 Glacier)
    - Backup verification: Weekly restore tests
    - Encryption: AES-256 for all backups
    - Geo-redundant: Replicated to 3 AWS regions
    - Recovery time objective (RTO): 1 hour
    - Recovery point objective (RPO): 15 minutes
    - Tested: Quarterly disaster recovery drills"""@en ;
    :hasResource [
        :downloadURL <https://www.postgresql.org/docs/current/backup.html> ;
        rdfs:label "PostgreSQL Backup & Restore Guide"@en
    ] .

