# ============================================================
# EXTENDED DEVOPS (80 Classes beyond our existing 35)
# ============================================================

:InfrastructureAsCode rdf:type owl:Class ;
    rdfs:subClassOf :DevOpsPractice ;
    rdfs:label "Infrastructure as Code (IaC)"@en ;
    skos:definition "Managing and provisioning infrastructure through machine-readable definition files rather than manual configuration, enabling version control and automation"@en ;
    :hasBenefit "Reproducible infrastructure deployments"@en ;
    :hasBenefit "Version-controlled infrastructure changes"@en ;
    :hasBenefit "Reduces configuration drift"@en ;
    :hasChallenge "Learning curve for IaC tools"@en ;
    :hasChallenge "State management complexity (Terraform)"@en ;
    :usesTool :Terraform ;
    :usesTool :AWSCloudFormation ;
    :usesTool :Pulumi ;
    :fashionRetailExample """LC Waikiki Terraform infrastructure:
    - Modules: 50+ reusable Terraform modules
    - Environments: Dev, staging, production (100% identical)
    - Resources managed: VPCs, EC2, RDS, S3, CloudFront, etc.
    - State: Remote state in S3 with DynamoDB locking
    - Workflow:
        1. Developer writes Terraform code
        2. `terraform plan` in CI pipeline
        3. Manual approval for production
        4. `terraform apply` automated
    - Drift detection: Daily scans for manual changes
    - Cost: Infrastructure provisioning time: 3 days → 30 minutes
    - Disaster recovery: Complete infrastructure recreation in 2 hours
    - Team: 5 platform engineers manage 2,000+ resources"""@en ;
    :hasResource [
        :downloadURL <https://www.terraform.io/docs/index.html> ;
        rdfs:label "Terraform Documentation"@en
    ] ;
    :hasResource [
        :downloadURL <https://registry.terraform.io/browse/modules> ;
        rdfs:label "Terraform Module Registry"@en
    ] .

:ContainerOrchestration rdf:type owl:Class ;
    rdfs:subClassOf :DevOpsPractice ;
    rdfs:label "Container Orchestration"@en ;
    skos:definition "Automated arrangement, coordination, and management of containerized applications using platforms like Kubernetes for microservices deployments"@en ;
    :hasBenefit "Automated scaling (10x during campaigns)"@en ;
    :hasBenefit "Self-healing (automatic restarts)"@en ;
    :hasBenefit "Zero-downtime deployments"@en ;
    :hasChallenge "Complex Kubernetes concepts"@en ;
    :hasChallenge "Resource overhead"@en ;
    :usesTool :Kubernetes ;
    :usesTool :AmazonEKS ;
    :usesTool :Helm ;
    :fashionRetailExample """Trendyol Kubernetes platform (500+ microservices):
    - Clusters: 5 production clusters across 3 AWS regions
    - Nodes: 200+ EC2 instances (auto-scaling)
    - Namespaces: 50+ (per team/domain)
    - Deployments: 500+ microservices
    - Traffic: 1M requests/minute peak
    - Scaling:
        - HPA: Horizontal Pod Autoscaler on CPU/memory
        - VPA: Vertical Pod Autoscaler recommendations
        - Cluster Autoscaler: Add/remove nodes
        - Example: Product service scales from 10 → 100 pods during campaigns
    - Deployment strategy: Rolling updates with max surge 25%
    - Service mesh: Istio for traffic management
    - Monitoring: Prometheus + Grafana
    - Logging: Fluentd → Elasticsearch
    - Cost: ₺800K/month Kubernetes infrastructure"""@en ;
    :hasResource [
        :downloadURL <https://kubernetes.io/docs/home/> ;
        rdfs:label "Kubernetes Documentation"@en
    ] .

:ObservabilityEngineering rdf:type owl:Class ;
    rdfs:subClassOf :DevOpsPractice ;
    rdfs:label "Observability Engineering"@en ;
    skos:definition "Practice of understanding internal system state by examining outputs (metrics, logs, traces) to enable debugging and troubleshooting of distributed systems"@en ;
    :hasBenefit "Faster incident resolution (MTTR)"@en ;
    :hasBenefit "Proactive problem detection"@en ;
    :hasBenefit "Better customer experience"@en ;
    :usesTool :Datadog ;
    :usesTool :NewRelic ;
    :usesTool :Prometheus ;
    :usesTool :Grafana ;
    :fashionRetailExample """Hepsiburada observability stack:
    - Metrics: Prometheus collecting 10M+ metrics/min
        - RED method: Rate, Errors, Duration
        - Golden signals: Latency, Traffic, Errors, Saturation
    - Logs: ELK stack (Elasticsearch, Logstash, Kibana)
        - 50TB logs daily
        - 14-day retention
        - Structured logging (JSON format)
    - Traces: Jaeger for distributed tracing
        - Trace every request end-to-end
        - Identify slow microservices
    - Dashboards: 200+ Grafana dashboards
        - Executive: Revenue, orders, conversion
        - Engineering: Latency, error rate, throughput
        - SRE: Infrastructure metrics
    - Alerting: 500+ alert rules
        - PagerDuty integration for on-call
    - MTTR: 15 minutes (incidents detected → resolved)"""@en ;
    :hasResource [
        :downloadURL <https://www.honeycomb.io/observability-engineering-book> ;
        rdfs:label "Observability Engineering Book (Free)"@en
    ] .

:SiteReliabilityEngineering rdf:type owl:Class ;
    rdfs:subClassOf :DevOpsPractice ;
    rdfs:label "Site Reliability Engineering (SRE)"@en ;
    skos:definition "Discipline incorporating software engineering aspects to IT operations, focusing on reliability, availability, and performance of e-commerce platforms"@en ;
    :hasBenefit "99.99%+ uptime (52 minutes downtime/year)"@en ;
    :hasBenefit "Reduced toil through automation"@en ;
    :hasBenefit "Error budgets balance innovation vs stability"@en ;
    :fashionRetailExample """Defacto SRE practice:
    - SLOs (Service Level Objectives):
        - Availability: 99.95% (21.6 minutes downtime/month)
        - Latency: p95 <500ms, p99 <1s
        - Error rate: <0.1% of requests
    - Error budget: 5 hours/month
        - If budget exhausted: Freeze new features, focus on stability
        - If budget remaining: Ship features faster
    - On-call: 24/7 rotation (5 SRE engineers)
        - Primary + secondary on-call
        - Max 2 incidents per week per person
    - Incident management:
        - Severity levels: P0 (critical), P1 (high), P2 (medium)
        - P0 response time: 5 minutes
        - Post-mortems: Blameless, focus on process improvement
    - Toil reduction: 50% time on automation
        - Automated runbooks for common incidents
        - Self-service tools for developers"""@en ;
    :hasResource [
        :downloadURL <https://sre.google/sre-book/table-of-contents/> ;
        rdfs:label "Google SRE Book (Free Online)"@en
    ] .

:ChaosEngineering rdf:type owl:Class ;
    rdfs:subClassOf :SiteReliabilityEngineering ;
    rdfs:label "Chaos Engineering"@en ;
    skos:definition "Practice of intentionally injecting failures into production systems to build confidence in system resilience and identify weaknesses before they cause outages"@en ;
    :hasBenefit "Proactively finds weaknesses"@en ;
    :hasBenefit "Builds confidence in system resilience"@en ;
    :hasBenefit "Reduces MTTR (teams practice incident response)"@en ;
    :usesTool :ChaosMonkey ;
    :usesTool :LitmusChaos ;
    :usesTool :GremlinChaosEngineering ;
    :fashionRetailExample """Koton chaos experiments:
    - Game days: Monthly chaos experiments
    - Experiments conducted:
        1. Kill random pods (test auto-recovery)
        2. Inject network latency (test timeouts)
        3. Fail database replica (test failover)
        4. Exhaust memory (test resource limits)
        5. Simulate AWS region outage (test DR)
    - Example experiment: Database failover
        - Hypothesis: System switches to replica within 30s
        - Method: Kill primary RDS instance
        - Blast radius: Staging environment first
        - Metrics: Monitored error rate, latency
        - Result: Failover took 45s → tuned to 25s
    - Benefits: Found 12 critical issues before production impact
    - Team confidence: Increased from 60% to 90%"""@en ;
    :hasResource [
        :downloadURL <https://principlesofchaos.org/> ;
        rdfs:label "Principles of Chaos Engineering"@en
    ] .

