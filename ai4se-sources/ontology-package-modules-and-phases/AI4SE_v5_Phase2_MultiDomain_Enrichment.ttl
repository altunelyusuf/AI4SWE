# ============================================================
# CODE ANALYSIS & QUALITY (80 Classes)
# ============================================================

:StaticCodeAnalysis rdf:type owl:Class ;
    rdfs:subClassOf :CodeQuality ;
    rdfs:label "Static Code Analysis"@en ;
    skos:definition "Automated analysis of source code without execution to detect bugs, code smells, security vulnerabilities, and adherence to coding standards"@en ;
    :hasBenefit "Finds bugs before production (shift-left)"@en ;
    :hasBenefit "Enforces coding standards"@en ;
    :hasBenefit "Reduces technical debt"@en ;
    :usesTool :SonarQube ;
    :usesTool :ESLint ;
    :usesTool :Pylint ;
    :fashionRetailExample """Morhipo static analysis pipeline:
    - Tools:
        - SonarQube: Overall code quality
        - ESLint: JavaScript/TypeScript linting
        - Pylint: Python code analysis
        - Checkstyle: Java code style
    - Integration: Runs on every commit (CI/CD)
    - Quality gates:
        - 0 blocker issues
        - 0 critical issues
        - Code coverage >80%
        - Duplicated code <3%
        - Technical debt ratio <5%
    - Metrics tracked:
        - Code smells: Reduced from 5,000 → 500
        - Bugs: Avg 2 per 1,000 lines (industry: 15-50)
        - Security hotspots: 0 high-severity
    - Developer workflow:
        1. Write code
        2. SonarLint plugin flags issues in IDE
        3. Fix before commit
        4. SonarQube scans on push
        5. Build fails if quality gates violated
    - ROI: Bugs caught pre-production: 120/quarter
        Cost to fix in production: ₺500K → ₺50K (10x savings)"""@en ;
    :hasResource [
        :downloadURL <https://docs.sonarqube.org/latest/> ;
        rdfs:label "SonarQube Documentation"@en
    ] .

:CodeReview rdf:type owl:Class ;
    rdfs:subClassOf :CodeQuality ;
    rdfs:label "Code Review"@en ;
    skos:definition "Systematic examination of source code by peers to identify bugs, improve code quality, share knowledge, and ensure adherence to standards"@en ;
    :hasBenefit "Catches 60% of bugs before testing"@en ;
    :hasBenefit "Knowledge sharing across team"@en ;
    :hasBenefit "Maintains code quality"@en ;
    :fashionRetailExample """LC Waikiki code review process:
    - Tool: GitHub Pull Requests
    - Policy: All code reviewed before merge
    - Reviewers: 2 approvals required
    - Checklist:
        - Correctness: Does it work?
        - Tests: Are there unit/integration tests?
        - Performance: Any performance concerns?
        - Security: Vulnerable code patterns?
        - Maintainability: Clear and understandable?
        - Standards: Follows style guide?
    - Turnaround: <4 hours during business hours
    - Automation:
        - CI runs tests automatically
        - SonarQube provides quality report
        - Security scanner (Snyk) checks dependencies
    - Metrics:
        - 95% of PRs approved within 8 hours
        - Avg 3.2 comments per PR
        - Rejection rate: 2% (most fixed and resubmitted)
    - Benefits:
        - Bug escape rate: 0.5% (industry: 5%)
        - Post-deployment defects: 80% reduction"""@en .

:TechnicalDebtManagement rdf:type owl:Class ;
    rdfs:subClassOf :CodeQuality ;
    rdfs:label "Technical Debt Management"@en ;
    skos:definition "Systematic tracking and reduction of technical debt including code smells, outdated dependencies, and architectural deficiencies"@en ;
    :hasBenefit "Improves development velocity"@en ;
    :hasBenefit "Reduces bug rate"@en ;
    :hasBenefit "Easier onboarding"@en ;
    :fashionRetailExample """Trendyol technical debt initiative:
    - Measurement:
        - SonarQube debt ratio: 8.5% → 3.2%
        - Code duplication: 12% → 4%
        - Cyclomatic complexity: Avg 8 → 5
    - Debt categories:
        1. Code smells (40%): Overly complex methods
        2. Outdated dependencies (25%): Security vulnerabilities
        3. Missing tests (20%): Legacy code without coverage
        4. Documentation gaps (15%): Undocumented APIs
    - Remediation:
        - 20% of sprint capacity for tech debt
        - Quarterly tech debt sprints
        - Refactoring champions in each team
    - Prioritization:
        - High business impact: Checkout, payment
        - Security vulnerabilities: Critical/high first
        - Developer pain points: Most complained about
    - Results (1 year):
        - Development velocity: +25%
        - Onboarding time: 6 weeks → 3 weeks
        - P0 incidents: 15/quarter → 5/quarter
        - Developer satisfaction: +35%"""@en .

:CodeCoverageAnalysis rdf:type owl:Class ;
    rdfs:subClassOf :CodeQuality ;
    rdfs:label "Code Coverage Analysis"@en ;
    skos:definition "Measurement of which code lines are executed by automated tests, indicating test completeness and finding untested code paths"@en ;
    :hasBenefit "Identifies untested code"@en ;
    :hasBenefit "Prevents regressions"@en ;
    :hasBenefit "Encourages testable design"@en ;
    :usesTool :JaCoCo ;
    :usesTool :Coverage.py ;
    :usesTool :IstanbulJS ;
    :fashionRetailExample """Hepsiburada code coverage standards:
    - Target: 80% coverage for all services
    - Current: 83% average across codebase
    - Breakdown:
        - Payment service: 95% (critical path)
        - Product catalog: 78%
        - Recommendation engine: 70% (ML code harder to test)
    - Types:
        - Line coverage: 83%
        - Branch coverage: 75%
        - Function coverage: 90%
    - Quality gates:
        - New code: Must have 85%+ coverage
        - PR rejected if coverage decreases
    - Challenges:
        - Legacy code: Lower coverage acceptable temporarily
        - UI code: Harder to test, 60% target
    - Tools integration:
        - Coverage report in every PR
        - Badge on README showing coverage
        - Historical trend tracking
    - Impact: Bug escape rate correlation
        - >80% coverage: 0.3% bug rate
        - <80% coverage: 2.1% bug rate"""@en ;
    :hasResource [
        :downloadURL <https://www.jacoco.org/jacoco/trunk/doc/> ;
        rdfs:label "JaCoCo Java Code Coverage"@en
    ] .

:RefactoringTechniques rdf:type owl:Class ;
    rdfs:subClassOf :CodeQuality ;
    rdfs:label "Refactoring Techniques"@en ;
    skos:definition "Disciplined techniques for restructuring existing code without changing external behavior, improving internal structure and maintainability"@en ;
    :hasBenefit "Improves code readability"@en ;
    :hasBenefit "Makes code easier to modify"@en ;
    :hasBenefit "Prevents bugs"@en ;
    :fashionRetailExample """Defacto refactoring project (checkout service):
    - Before: 2,500-line God class handling entire checkout
    - Refactoring techniques applied:
        1. Extract Method: Break down long methods
        2. Extract Class: Separate concerns
        3. Move Method: Proper object placement
        4. Replace Conditional with Polymorphism
        5. Introduce Parameter Object
    - After: 15 classes with clear responsibilities
    - Metrics improvement:
        - Cyclomatic complexity: 45 → 8
        - Lines per method: Avg 120 → 25
        - Test coverage: 45% → 85%
        - Build time: 8 min → 2 min
    - Process:
        - 4 weeks dedicated refactoring sprint
        - Pair programming
        - Incremental changes (small PRs)
        - Extensive test suite first
    - Business impact:
        - New feature development: 2 weeks → 3 days
        - Bug rate: 50% reduction
        - Onboarding: New developer productive in 1 week vs 4"""@en ;
    :hasResource [
        :downloadURL <https://refactoring.com/catalog/> ;
        rdfs:label "Refactoring Catalog (Martin Fowler)"@en
    ] .

