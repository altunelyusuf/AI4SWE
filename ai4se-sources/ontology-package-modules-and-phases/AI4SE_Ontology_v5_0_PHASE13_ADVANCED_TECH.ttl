:5GCommerce rdf:type owl:Class ;
    rdfs:label "5G-Enabled Commerce"@en ;
    skos:definition "Ultra-fast mobile commerce leveraging 5G networks for enhanced experiences including AR, live streaming shopping, and instant checkout in Turkish fashion retail"@en ;
    :hasBenefit "10x faster than 4G"@en ;
    :hasBenefit "Ultra-low latency (<10ms)"@en ;
    :hasBenefit "Support for AR/VR shopping"@en ;
    :fashionRetailExample """Turkish Fashion 5G Initiatives:
    - Partnership: Turkcell 5G + Fashion retailers
    - Use cases:
      * AR try-on: Instant rendering on 5G
      * Live shopping: HD streaming with no lag
      * Instant checkout: <1 second payment processing
    - Pilot: Istanbul flagship stores (Trendyol, LC Waikiki)
    - Performance: AR try-on latency 20ms (was 200ms on 4G)
    - Rollout: Following 5G network expansion in Turkey"""@en ;
    :hasResource [
        :downloadURL <https://www.gsma.com/futurenetworks/ip_services/understanding-5g/> ;
        rdfs:label "5G Applications Guide"@en
    ] .

:LiveStreamShopping rdf:type owl:Class ;
    rdfs:subClassOf :5GCommerce ;
    rdfs:label "Live Stream Shopping"@en ;
    skos:definition "Real-time video shopping format where hosts demonstrate products and viewers can purchase instantly, popular format in Turkish fashion e-commerce"@en ;
    :hasBenefit "60% higher conversion vs regular"@en ;
    :hasBenefit "Engaging, entertainment shopping"@en ;
    :fashionRetailExample """Trendyol Live Shopping:
    - Format: Daily live streams (2-3 hours)
    - Hosts: Fashion influencers, brand representatives
    - Platform: Mobile app, integrated checkout
    - Features: Live chat, instant "add to cart", limited-time deals
    - Viewership: 50K-200K per session
    - Conversion: 15% of viewers purchase
    - AOV: 2.5x higher than regular shopping
    - Technology: 5G enables HD streaming, no buffering
    - Revenue: ₺100M monthly from live shopping"""@en ;
    :hasResource [
        :downloadURL <https://www.youtube.com/creators/live-streaming/> ;
        rdfs:label "Live Streaming Best Practices"@en
    ] .

