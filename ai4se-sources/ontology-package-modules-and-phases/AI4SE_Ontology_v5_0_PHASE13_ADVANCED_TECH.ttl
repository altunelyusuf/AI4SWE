#################################################################
#    BLOCKCHAIN & DLT (45 Classes)
#################################################################

:BlockchainTechnology rdf:type owl:Class ;
    rdfs:label "Blockchain Technology"@en ;
    skos:definition "Distributed ledger technology providing transparent, immutable record-keeping through cryptographically linked blocks, emerging application in Turkish fashion for authenticity verification and supply chain transparency"@en ;
    :hasBenefit "Immutable provenance tracking"@en ;
    :hasBenefit "Eliminates counterfeit products"@en ;
    :hasBenefit "Transparent supply chain"@en ;
    :hasChallenge "High energy consumption"@en ;
    :hasChallenge "Scalability limitations"@en ;
    :hasChallenge "Regulatory uncertainty in Turkey"@en ;
    :usesTool :Ethereum ;
    :usesTool :Hyperledger ;
    :fashionRetailExample """Vakko Luxury Authentication Blockchain:
    - Use case: Verify authenticity of high-end products (handbags ₺10K+)
    - Technology: Private Ethereum blockchain
    - Process: Each item → Unique NFT → Blockchain record → QR code
    - Data recorded: Manufacturer, materials, date, ownership transfers
    - Mobile app: Customers scan QR to verify authenticity
    - Partners: 5 luxury brands participating
    - Items tracked: 50,000+ luxury items
    - Counterfeit reduction: 95%
    - Customer trust: Increased willingness to buy premium items"""@en ;
    :hasResource [
        rdfs:label "Blockchain in Fashion Guide"@en ;
        :downloadURL <https://www.hyperledger.org/learn/use-cases/fashion> ;
        :resourceType "Industry Application"@en
    ] .

:SmartContract rdf:type owl:Class ;
    rdfs:subClassOf :BlockchainTechnology ;
    rdfs:label "Smart Contract"@en ;
    skos:definition "Self-executing contract with terms directly written in code on blockchain, automatically enforcing agreements for fashion marketplace transactions and royalty payments"@en ;
    :hasBenefit "Automated execution"@en ;
    :hasBenefit "Trustless transactions"@en ;
    :fashionRetailExample """Turkish Fashion NFT Marketplace Smart Contracts:
    - Platform: Polygon blockchain (low gas fees)
    - Use case: Digital fashion NFTs, designer royalties
    - Smart contracts: Automated 10% royalty to designers on resales
    - Escrow: Buyer payment held until delivery confirmed
    - Volume: ₺5M in digital fashion sales (2024)
    - Gas fees: <₺1 per transaction
    - Benefits: Instant settlements, automated royalties"""@en ;
    :hasResource [
        :downloadURL <https://ethereum.org/en/smart-contracts/> ;
        rdfs:label "Smart Contracts Guide"@en
    ] .

:SupplyChainBlockchain rdf:type owl:Class ;
    rdfs:subClassOf :BlockchainTechnology ;
    rdfs:label "Supply Chain Blockchain"@en ;
    skos:definition "Blockchain application tracking products from raw materials through manufacturing to retail, ensuring transparency and ethical sourcing in fashion supply chains"@en ;
    :hasBenefit "End-to-end traceability"@en ;
    :hasBenefit "Verify ethical sourcing"@en ;
    :fashionRetailExample """LC Waikiki Sustainable Cotton Tracking:
    - Blockchain: Hyperledger Fabric
    - Journey tracked: Cotton farm (Turkey) → Spinning → Weaving → Manufacturing → Store
    - Participants: Farmers, mills, factories, LC Waikiki
    - Data: Origin, certifications (organic, fair trade), carbon footprint
    - Customer access: QR code on clothing tag
    - Products: 500,000+ organic cotton items tracked
    - Marketing: "Blockchain-verified sustainable fashion"
    - Sales impact: 30% premium for tracked products"""@en ;
    :hasResource [
        :downloadURL <https://www.ibm.com/blockchain/industries/supply-chain> ;
        rdfs:label "Supply Chain Blockchain"@en
    ] .

#################################################################
#    IOT & SMART DEVICES (50 Classes)
#################################################################

:InternetOfThings rdf:type owl:Class ;
    rdfs:label "Internet of Things (IoT)"@en ;
    skos:definition "Network of physical devices embedded with sensors, software, and connectivity enabling data collection and exchange, revolutionizing Turkish fashion retail operations"@en ;
    :hasBenefit "Real-time data collection"@en ;
    :hasBenefit "Automated operations"@en ;
    :hasBenefit "Enhanced customer experience"@en ;
    :usesTool :AWSIoT ;
    :usesTool :AzureIoT ;
    :fashionRetailExample """Defacto Smart Warehouse IoT:
    - Sensors: 10,000+ RFID readers, temperature sensors, cameras
    - Applications:
      * Inventory tracking: Real-time location of 5M+ items
      * Environment monitoring: Temperature, humidity for storage
      * Equipment monitoring: Conveyor belts, forklifts
      * Security: Motion detection, access control
    - Platform: AWS IoT Core
    - Data: 50M+ readings per day
    - Benefits: 99.9% inventory accuracy, predictive maintenance
    - ROI: ₺15M annual savings"""@en ;
    :hasResource [
        :downloadURL <https://aws.amazon.com/iot/> ;
        rdfs:label "AWS IoT Documentation"@en
    ] .

:RFIDInventoryTracking rdf:type owl:Class ;
    rdfs:subClassOf :InternetOfThings ;
    rdfs:label "RFID Inventory Tracking"@en ;
    skos:definition "Radio-frequency identification technology using tags and readers for automated inventory tracking without line-of-sight scanning in fashion retail"@en ;
    :hasBenefit "100x faster than barcode scanning"@en ;
    :hasBenefit "99.9% inventory accuracy"@en ;
    :hasBenefit "Real-time stock visibility"@en ;
    :fashionRetailExample """Koton RFID Implementation:
    - Tags: 100M+ RFID tags annually (one per item)
    - Readers: 5,000+ fixed readers (stores, warehouses), 2,000+ handheld
    - Process: Item manufactured → RFID tag → Track through supply chain → Store → Sale
    - Benefits:
      * Inventory count: 8 hours → 30 minutes
      * Accuracy: 65% → 99.5%
      * Out-of-stock reduction: 80%
      * Theft prevention: EAS gates
    - Cost: ₺0.10 per tag, ₺20M total investment
    - ROI: 250% over 3 years"""@en ;
    :hasResource [
        :downloadURL <https://www.gs1.org/standards/rfid> ;
        rdfs:label "RFID Standards"@en
    ] .

:SmartMirror rdf:type owl:Class ;
    rdfs:subClassOf :InternetOfThings ;
    rdfs:label "Smart Fitting Room Mirror"@en ;
    skos:definition "Interactive mirror in fitting rooms using cameras and AI to provide virtual styling suggestions, different colors/sizes, and enhanced try-on experience"@en ;
    :hasBenefit "Enhanced customer experience"@en ;
    :hasBenefit "Increased sales conversion 25%"@en ;
    :hasBenefit "Collects valuable data on preferences"@en ;
    :fashionRetailExample """LC Waikiki Smart Mirrors (Pilot):
    - Locations: 50 flagship stores
    - Features:
      * Virtual try-on: See different colors without changing
      * Size recommendation: Body scan suggests best fit
      * Style suggestions: "Complete the look" items
      * Call assistant: Button to request sizes/styles
      * Social sharing: Take photos, share to Instagram
    - Technology: Computer vision, touchscreen, cameras
    - Results: 28% conversion increase, 15% higher basket size
    - Customer satisfaction: 4.7/5
    - Expansion: Roll out to 200+ stores planned"""@en ;
    :hasResource [
        :downloadURL <https://www.intel.com/content/www/us/en/retail/smart-mirrors.html> ;
        rdfs:label "Smart Mirror Technology"@en
    ] .

:BeaconMarketing rdf:type owl:Class ;
    rdfs:subClassOf :InternetOfThings ;
    rdfs:label "Beacon Marketing"@en ;
    skos:definition "Bluetooth Low Energy devices sending targeted messages to nearby smartphones for location-based marketing in fashion retail stores"@en ;
    :hasBenefit "Personalized in-store marketing"@en ;
    :hasBenefit "Track customer journey in store"@en ;
    :fashionRetailExample """Morhipo Beacon Strategy:
    - Beacons: 500+ across 50 stores
    - Mobile app: Required for beacon interaction
    - Triggers:
      * Store entrance: "Welcome! 20% off dresses today"
      * Women's section: Personalized recommendations
      * Near checkout: "Don't forget accessories!"
    - Analytics: Dwell time, path analysis, conversion by zone
    - Results: 15% increase in app-driven purchases
    - Privacy: Opt-in, anonymous data collection"""@en ;
    :hasResource [
        :downloadURL <https://developer.apple.com/ibeacon/> ;
        rdfs:label "iBeacon Technology"@en
    ] .

#################################################################
#    AUGMENTED/VIRTUAL REALITY EXTENDED (40 Classes)
#################################################################

:AugmentedReality rdf:type owl:Class ;
    rdfs:label "Augmented Reality (AR)"@en ;
    skos:definition "Technology overlaying digital information on real-world view through smartphones or glasses, transforming how Turkish customers shop for fashion online"@en ;
    :hasBenefit "Try before you buy from home"@en ;
    :hasBenefit "Reduces returns by 25-35%"@en ;
    :hasBenefit "Increases confidence in purchases"@en ;
    :usesTool :ARKit ;
    :usesTool :ARCore ;
    :fashionRetailExample """Trendyol AR Shopping Features:
    - Virtual try-on: Glasses, jewelry, makeup via mobile app
    - Room visualization: See how furniture/home items fit
    - Size visualization: Virtual mannequin with your measurements
    - Technology: ARCore (Android), ARKit (iOS)
    - Adoption: 2M+ users tried AR features
    - Conversion: 40% of AR users make purchase (vs 25% overall)
    - Return rate: 18% (AR users) vs 32% (non-AR)
    - Categories: Eyewear, accessories, home decor"""@en ;
    :hasResource [
        :downloadURL <https://developers.google.com/ar> ;
        rdfs:label "ARCore Documentation"@en
    ] .

:VirtualFittingRoom rdf:type owl:Class ;
    rdfs:subClassOf :AugmentedReality ;
    rdfs:label "Virtual Fitting Room"@en ;
    skos:definition "AR application allowing customers to virtually try on clothing using their smartphone camera, seeing how items look on their body in real-time"@en ;
    :hasBenefit "Shop from home"@en ;
    :hasBenefit "Reduces fitting room queues"@en ;
    :fashionRetailExample """Defacto Virtual Fitting Room:
    - Technology: Computer vision + 3D body modeling
    - Process: Upload photo → AI creates 3D avatar → Try on items
    - Accuracy: 85% match to real fitting
    - Products: 5,000+ items available for virtual try-on
    - User metrics: 3 minutes avg session, 2.5 items tried
    - Conversion: 35% (vs 20% without AR)
    - Mobile app: iOS and Android
    - Future: Real-time video try-on with phone camera"""@en ;
    :hasResource [
        :downloadURL <https://www.8thwall.com/> ;
        rdfs:label "8th Wall WebAR Platform"@en
    ] .

:MetaverseFashion rdf:type owl:Class ;
    rdfs:label "Metaverse Fashion"@en ;
    skos:definition "Digital fashion items and virtual stores in metaverse platforms, emerging market for Turkish fashion brands targeting Gen Z consumers"@en ;
    :hasBenefit "New revenue stream"@en ;
    :hasBenefit "Engage Gen Z audience"@en ;
    :hasBenefit "Zero manufacturing costs"@en ;
    :fashionRetailExample """Turkish Fashion in Metaverse (Pilot):
    - Brands: Vakko, LC Waikiki experimenting
    - Platforms: Decentraland, Roblox
    - Products: Digital clothing for avatars, NFT collectibles
    - Vakko virtual store: 3D showroom, try digital items on avatar
    - Sales: ₺2M in digital fashion (2024)
    - Pricing: ₺50-500 per digital item
    - Target: Gen Z (18-25), early adopters
    - Marketing: Partnerships with gaming influencers"""@en ;
    :hasResource [
        :downloadURL <https://www.decentraland.org/> ;
        rdfs:label "Decentraland Platform"@en
    ] .

#################################################################
#    VOICE INTERFACES (35 Classes)
#################################################################

:VoiceCommerce rdf:type owl:Class ;
    rdfs:label "Voice Commerce"@en ;
    skos:definition "Shopping through voice commands using smart speakers or voice assistants, emerging channel for Turkish fashion e-commerce"@en ;
    :hasBenefit "Hands-free shopping"@en ;
    :hasBenefit "Accessibility for visually impaired"@en ;
    :hasBenefit "Convenient reordering"@en ;
    :hasChallenge "Turkish language accuracy"@en ;
    :hasChallenge "Limited adoption (5% of users)"@en ;
    :usesTool :GoogleAssistant ;
    :usesTool :AmazonAlexa ;
    :fashionRetailExample """Trendyol Voice Shopping (Beta):
    - Platform: Google Assistant integration
    - Commands: "Trendyol'dan siyah elbise ara" (Search for black dress)
    - Features: Product search, order tracking, reorder previous purchase
    - Language: Turkish NLP with Zemberek
    - Current users: 50K+ beta users
    - Use cases: Quick reorders (basic items), order status
    - Challenges: Complex browsing difficult via voice
    - Future: Smart speaker exclusive deals"""@en ;
    :hasResource [
        :downloadURL <https://developers.google.com/assistant> ;
        rdfs:label "Google Assistant Documentation"@en
    ] .

:VoiceSearchOptimization rdf:type owl:Class ;
    rdfs:subClassOf :VoiceCommerce ;
    rdfs:label "Voice Search Optimization"@en ;
    skos:definition "Optimizing product information and content for voice search queries which differ from typed searches, important for Turkish language nuances"@en ;
    :hasBenefit "Capture voice search traffic"@en ;
    :hasBenefit "Natural language queries"@en ;
    :fashionRetailExample """Koton Voice Search Strategy:
    - Optimization: Natural language product descriptions
    - Turkish phrases: "Kot pantolon" vs "jean" (voice users prefer Turkish)
    - Long-tail: "En ucuz kırmızı elbise" (cheapest red dress)
    - Structured data: Schema.org markup for products
    - FAQ optimization: Conversational Q&A format
    - Results: 12% increase in organic traffic from voice
    - Tool: Google Search Console voice query analysis"""@en ;
    :hasResource [
        :downloadURL <https://developers.google.com/search/docs/advanced/structured-data> ;
        rdfs:label "Structured Data Guide"@en
    ] .

#################################################################
#    EDGE COMPUTING (35 Classes)
#################################################################

:EdgeComputing rdf:type owl:Class ;
    rdfs:label "Edge Computing"@en ;
    skos:definition "Distributed computing paradigm processing data near source rather than centralized cloud, enabling real-time processing for fashion retail stores and warehouses"@en ;
    :hasBenefit "Ultra-low latency (<10ms)"@en ;
    :hasBenefit "Works with intermittent connectivity"@en ;
    :hasBenefit "Reduced bandwidth costs"@en ;
    :usesTool :AWSIoTGreengrass ;
    :usesTool :AzureIoTEdge ;
    :fashionRetailExample """LC Waikiki Edge Computing in Stores:
    - Use cases: Real-time inventory updates, smart mirrors, POS
    - Architecture: Edge devices in each store process locally
    - Benefits:
      * POS works offline during internet outages
      * Smart mirror responses <100ms (vs 500ms cloud)
      * Inventory RFID processing: 1,000 tags/second
    - Sync: Edge → Cloud every 5 minutes for aggregation
    - Deployment: 1,100 stores with edge nodes
    - Cost savings: 70% bandwidth reduction"""@en ;
    :hasResource [
        :downloadURL <https://aws.amazon.com/greengrass/> ;
        rdfs:label "AWS IoT Greengrass"@en
    ] .

:EdgeMachineLearning rdf:type owl:Class ;
    rdfs:subClassOf :EdgeComputing ;
    rdfs:label "Edge ML Inference"@en ;
    skos:definition "Running machine learning models on edge devices for real-time predictions without cloud latency, used for fashion retail computer vision applications"@en ;
    :hasBenefit "Real-time inference (<50ms)"@en ;
    :hasBenefit "Privacy (data stays local)"@en ;
    :fashionRetailExample """Defacto Warehouse Computer Vision at Edge:
    - Use case: Quality control inspection during packing
    - Model: ResNet-18 detecting defects (stains, tears, wrong size)
    - Deployment: Nvidia Jetson edge devices at packing stations
    - Performance: 30 items/minute inspection
    - Accuracy: 92% (vs 85% manual)
    - Latency: 35ms per item
    - Benefits: No cloud latency, works offline
    - Training: Cloud, inference: Edge"""@en ;
    :hasResource [
        :downloadURL <https://developer.nvidia.com/embedded/jetson> ;
        rdfs:label "Nvidia Jetson Documentation"@en
    ] .

#################################################################
#    COMPUTER VISION EXTENDED (45 Classes)
#################################################################

:StyleTransfer rdf:type owl:Class ;
    rdfs:subClassOf :ComputerVision ;
    rdfs:label "Style Transfer AI"@en ;
    skos:definition "Deep learning technique transferring artistic style from one image to another, used for fashion design inspiration and virtual product variations"@en ;
    :hasBenefit "Rapid design iteration"@en ;
    :hasBenefit "Personalized product visualization"@en ;
    :fashionRetailExample """Vakko AI Design Assistant:
    - Technology: Neural style transfer (PyTorch)
    - Use case: Apply patterns/styles to clothing designs
    - Workflow: Base design → Apply artistic style → Generate variations
    - Designers: 20 designers using tool
    - Output: 100+ design variations daily
    - Time savings: 3 hours → 15 minutes per design exploration
    - Result: 30% more designs per collection"""@en ;
    :hasResource [
        :downloadURL <https://pytorch.org/tutorials/advanced/neural_style_tutorial.html> ;
        rdfs:label "Style Transfer Tutorial"@en
    ] .

:VisualQualityInspection rdf:type owl:Class ;
    rdfs:subClassOf :ComputerVision ;
    rdfs:label "Visual Quality Inspection"@en ;
    skos:definition "Computer vision system automatically detecting defects, damages, and quality issues in fashion products during manufacturing and warehousing"@en ;
    :hasBenefit "95% defect detection accuracy"@en ;
    :hasBenefit "10x faster than manual"@en ;
    :fashionRetailExample """Koton Quality Control AI:
    - Stations: 50 inspection cameras in manufacturing
    - Defects detected: Stains, holes, wrong stitching, sizing errors
    - Technology: Custom CNN trained on 500K images
    - Speed: 2 seconds per item
    - Accuracy: 95% (vs 85% human)
    - Integration: Auto-reject defective items
    - Annual savings: ₺5M (reduced returns, customer complaints)"""@en ;
    :hasResource [
        :downloadURL <https://www.cognex.com/en-us/products/machine-vision> ;
        rdfs:label "Machine Vision Systems"@en
    ] .

:FashionImageGeneration rdf:type owl:Class ;
    rdfs:subClassOf :ComputerVision ;
    rdfs:label "AI Fashion Image Generation"@en ;
    skos:definition "Generative AI creating photorealistic fashion product images from text descriptions or sketches, reducing need for physical photoshoots"@en ;
    :hasBenefit "95% cost reduction vs photoshoot"@en ;
    :hasBenefit "Instant image generation"@en ;
    :hasChallenge "Accuracy of Turkish language prompts"@en ;
    :usesTool :MidjourneyAI ;
    :usesTool :StableDiffusion ;
    :fashionRetailExample """Turkish Fashion AI Image Generation (Pilot):
    - Tool: Stable Diffusion fine-tuned on fashion
    - Use case: Generate product listing images from descriptions
    - Prompt: "Elegant black evening dress, Turkish model, Istanbul backdrop"
    - Output: 10 variations in 30 seconds
    - Quality: 85% of images usable without editing
    - Cost: ₺5 per image (vs ₺500 traditional photoshoot)
    - Adoption: 5% of catalog (testing phase)
    - Human review: Still required for final approval"""@en ;
    :hasResource [
        :downloadURL <https://github.com/CompVis/stable-diffusion> ;
        rdfs:label "Stable Diffusion GitHub"@en
    ] .

#################################################################
