# ============================================================
# OWL AXIOMS & CONSTRAINTS
# ============================================================

# Disjoint classes
:SecurityTesting owl:disjointWith :PerformanceTesting .
:UnitTesting owl:disjointWith :IntegrationTesting .
:FunctionalRequirement owl:disjointWith :NonFunctionalRequirement .
:RelationalDatabase owl:disjointWith :NoSQLDatabase .

# Equivalence
:PenetrationTesting owl:equivalentClass :PenTesting .
:ContinuousIntegration owl:equivalentClass :CI .
:ContinuousDeployment owl:equivalentClass :CD .

# Property restrictions
:SecurityTesting rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :usesTool ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

:MicroservicesArchitecture rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :requiresPattern ;
    owl:someValuesFrom :DesignPattern
] .

:PaymentSecurity rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :enables ;
    owl:hasValue :PCIDSSCompliance
] .

:MachineLearning rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :requires ;
    owl:someValuesFrom :DataEngineering
] .

# Cardinality constraints for Turkish fashion retail context
:EcommercePlatform rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :supportsBusinessProcess ;
    owl:minCardinality "3"^^xsd:nonNegativeInteger
] .

:SupplyChainManagement rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :integrates ;
    owl:minCardinality "2"^^xsd:nonNegativeInteger
] .

# ============================================================
# FASHION RETAIL PROCESS TAXONOMY
# ============================================================

:BusinessProcess rdf:type owl:Class ;
    rdfs:label "Business Process"@en ;
    skos:definition "Core business process in fashion retail and e-commerce"@en .

:CustomerAcquisition rdfs:subClassOf :BusinessProcess ;
    :relatedTo :DigitalMarketing ;
    :relatedTo :SEO ;
    :relatedTo :SocialMediaMarketing .

:CustomerEngagement rdfs:subClassOf :BusinessProcess ;
    :relatedTo :Personalization ;
    :relatedTo :MobilePushNotifications ;
    :relatedTo :EmailMarketing .

:ProductDiscovery rdfs:subClassOf :BusinessProcess ;
    :relatedTo :SearchOptimization ;
    :relatedTo :RecommendationSystems ;
    :relatedTo :VisualSearch .

:OrderFulfillment rdfs:subClassOf :BusinessProcess ;
    :relatedTo :WarehouseManagement ;
    :relatedTo :LogisticsManagement ;
    :relatedTo :InventoryManagement .

:CustomerSupport rdfs:subClassOf :BusinessProcess ;
    :relatedTo :Chatbots ;
    :relatedTo :TicketingSystem ;
    :relatedTo :LiveChat .

:RevenueOptimization rdfs:subClassOf :BusinessProcess ;
    :relatedTo :DynamicPricing ;
    :relatedTo :RecommendationSystems ;
    :relatedTo :ConversionOptimization .

# ============================================================
# TURKISH MARKET SPECIFIC ENTITIES
# ============================================================

:TurkishCargoProvider rdf:type owl:Class ;
    rdfs:subClassOf :LogisticsProvider ;
    rdfs:label "Turkish Cargo Provider"@en .

:YurticiCargo rdf:type :TurkishCargoProvider ;
    rdfs:label "Yurtiçi Kargo"@en ;
    :hasWebsite <https://www.yurticikargo.com> ;
    :APIAvailable "Yes"@en .

:ArasCargo rdf:type :TurkishCargoProvider ;
    rdfs:label "Aras Kargo"@en ;
    :hasWebsite <https://www.araskargo.com.tr> ;
    :APIAvailable "Yes"@en .

:PTTCargo rdf:type :TurkishCargoProvider ;
    rdfs:label "PTT Kargo"@en ;
    :hasWebsite <https://www.ptt.gov.tr> ;
    :APIAvailable "Yes"@en .

:TurkishPaymentProvider rdf:type owl:Class ;
    rdfs:subClassOf :PaymentGateway ;
    rdfs:label "Turkish Payment Provider"@en .

:iyzico rdf:type :TurkishPaymentProvider ;
    rdfs:label "iyzico"@en ;
    :hasWebsite <https://www.iyzico.com> ;
    :PCIDSSCompliant "Yes"@en ;
    :supports3DSecure "Yes"@en .

:PayTR rdf:type :TurkishPaymentProvider ;
    rdfs:label "PayTR"@en ;
    :hasWebsite <https://www.paytr.com> ;
    :PCIDSSCompliant "Yes"@en .

:TurkishEcommerceMarketplace rdf:type owl:Class ;
    rdfs:subClassOf :EcommercePlatform ;
    rdfs:label "Turkish E-commerce Marketplace"@en .

:Trendyol rdf:type :TurkishEcommerceMarketplace ;
    rdfs:label "Trendyol"@en ;
    :hasWebsite <https://www.trendyol.com> ;
    :monthlyVisitors "75000000"^^xsd:integer ;
    :foundedYear "2010"^^xsd:integer .

:Hepsiburada rdf:type :TurkishEcommerceMarketplace ;
    rdfs:label "Hepsiburada"@en ;
    :hasWebsite <https://www.hepsiburada.com> ;
    :monthlyVisitors "65000000"^^xsd:integer ;
    :foundedYear "1998"^^xsd:integer .

