@prefix : <http://ai4se.org/ontology/v5#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
#    PHASE 3 - STRUCTURAL ENHANCEMENT
#    Rich Relationships & OWL Axioms for 3,142 Classes
#    Turkish Fashion Retail E-Commerce Context
#################################################################

# ============================================================
# ENHANCED OBJECT PROPERTIES (Rich Relationships)
# ============================================================

# Existing properties extended with domains and ranges
:requires rdf:type owl:ObjectProperty ;
    rdfs:label "requires"@en ;
    rdfs:comment "Indicates that one concept requires another as a prerequisite"@en ;
    rdfs:domain :SEConcept ;
    rdfs:range :SEConcept ;
    rdf:type owl:TransitiveProperty .

:enables rdf:type owl:ObjectProperty ;
    rdfs:label "enables"@en ;
    rdfs:comment "Indicates that one concept enables or facilitates another"@en ;
    rdfs:domain :SEConcept ;
    rdfs:range :SEConcept .

:complementsWellWith rdf:type owl:ObjectProperty ;
    rdfs:label "complements well with"@en ;
    rdfs:comment "Indicates concepts that work well together synergistically"@en ;
    rdfs:domain :SEConcept ;
    rdfs:range :SEConcept ;
    rdf:type owl:SymmetricProperty .

:isAlternativeTo rdf:type owl:ObjectProperty ;
    rdfs:label "is alternative to"@en ;
    rdfs:comment "Indicates concepts that serve as alternatives to each other"@en ;
    rdfs:domain :SEConcept ;
    rdfs:range :SEConcept ;
    rdf:type owl:SymmetricProperty .

:isPrerequisiteFor rdf:type owl:ObjectProperty ;
    rdfs:label "is prerequisite for"@en ;
    rdfs:comment "Indicates that this concept must be implemented before another"@en ;
    rdfs:domain :SEConcept ;
    rdfs:range :SEConcept ;
    owl:inverseOf :requires .

:conflictsWith rdf:type owl:ObjectProperty ;
    rdfs:label "conflicts with"@en ;
    rdfs:comment "Indicates concepts that should not be used together"@en ;
    rdfs:domain :SEConcept ;
    rdfs:range :SEConcept ;
    rdf:type owl:SymmetricProperty .

:supersedes rdf:type owl:ObjectProperty ;
    rdfs:label "supersedes"@en ;
    rdfs:comment "Indicates that this concept replaces an older concept"@en ;
    rdfs:domain :SEConcept ;
    rdfs:range :SEConcept .

:worksWellWith rdf:type owl:ObjectProperty ;
    rdfs:label "works well with"@en ;
    rdfs:comment "Indicates compatible concepts in fashion retail context"@en ;
    rdfs:domain :SEConcept ;
    rdfs:range :SEConcept ;
    rdf:type owl:SymmetricProperty .

# Domain-specific relationships
:integrates rdf:type owl:ObjectProperty ;
    rdfs:label "integrates with"@en ;
    rdfs:comment "Indicates technical integration between systems or tools"@en .

:optimizes rdf:type owl:ObjectProperty ;
    rdfs:label "optimizes"@en ;
    rdfs:comment "Indicates that one concept optimizes another"@en .

:mitigates rdf:type owl:ObjectProperty ;
    rdfs:label "mitigates"@en ;
    rdfs:comment "Indicates that one concept mitigates risks in another"@en .

:monitors rdf:type owl:ObjectProperty ;
    rdfs:label "monitors"@en ;
    rdfs:comment "Indicates monitoring relationships"@en .

# Fashion retail specific
:supportsBusinessProcess rdf:type owl:ObjectProperty ;
    rdfs:label "supports business process"@en ;
    rdfs:comment "Links technical concepts to fashion retail business processes"@en ;
    rdfs:domain :SEConcept ;
    rdfs:range :FashionRetailDomain .

:applicableToIndustry rdf:type owl:ObjectProperty ;
    rdfs:label "applicable to industry"@en ;
    rdfs:comment "Indicates industry applicability"@en .

# ============================================================
# ENHANCED DATATYPE PROPERTIES
# ============================================================

:maturityLevel rdf:type owl:DatatypeProperty ;
    rdfs:label "maturity level"@en ;
    rdfs:comment "Technology maturity: Emerging, Maturing, Mature, Declining"@en ;
    rdfs:range xsd:string .

:complexityRating rdf:type owl:DatatypeProperty ;
    rdfs:label "complexity rating"@en ;
    rdfs:comment "Implementation complexity: Low, Medium, High, Very High"@en ;
    rdfs:range xsd:string .

:adoptionRate rdf:type owl:DatatypeProperty ;
    rdfs:label "adoption rate"@en ;
    rdfs:comment "Adoption rate in Turkish fashion retail: percentage"@en ;
    rdfs:range xsd:decimal .

:implementationTime rdf:type owl:DatatypeProperty ;
    rdfs:label "implementation time"@en ;
    rdfs:comment "Typical implementation time in weeks"@en ;
    rdfs:range xsd:integer .

:costRange rdf:type owl:DatatypeProperty ;
    rdfs:label "cost range"@en ;
    rdfs:comment "Typical cost range in Turkish Lira"@en ;
    rdfs:range xsd:string .

:skillLevel rdf:type owl:DatatypeProperty ;
    rdfs:label "required skill level"@en ;
    rdfs:comment "Required skill level: Junior, Mid, Senior, Expert"@en ;
    rdfs:range xsd:string .

:turkishMarketRelevance rdf:type owl:DatatypeProperty ;
    rdfs:label "Turkish market relevance"@en ;
    rdfs:comment "Relevance score for Turkish fashion retail (0-10)"@en ;
    rdfs:range xsd:integer .

