#=============================================================================
# SECTION 5: CRITICAL LOGICAL CONSISTENCY ENHANCEMENTS
#=============================================================================

#-----------------------------------------------------------------------------
# 5.1 Comprehensive Disjointness Axioms (15 families)
#-----------------------------------------------------------------------------

# Tool Type Disjointness Family
ai4se:CodeCompletionTool owl:disjointWith ai4se:CodeGenerationTool ,
                                           ai4se:CodeReviewTool ,
                                           ai4se:TestGenerationTool ,
                                           ai4se:DocumentationTool .

ai4se:CodeGenerationTool owl:disjointWith ai4se:CodeReviewTool ,
                                           ai4se:TestGenerationTool ,
                                           ai4se:DocumentationTool .

ai4se:CodeReviewTool owl:disjointWith ai4se:TestGenerationTool ,
                                       ai4se:DocumentationTool .

ai4se:TestGenerationTool owl:disjointWith ai4se:DocumentationTool .

# Agentic System Disjointness Family
ai4se:SingleAgentSystem owl:disjointWith ai4se:MultiAgentSystem .
ai4se:SupervisedTraining owl:disjointWith ai4se:UnsupervisedTraining ,
                                          ai4se:ReinforcementTraining .
ai4se:UnsupervisedTraining owl:disjointWith ai4se:ReinforcementTraining .

# Enterprise Management Disjointness Family
portfolio:AIPortfolio owl:disjointWith portfolio:AIAdoptionProject .
strategy:StrategicObjective owl:disjointWith strategy:TacticalGoal .

# Financial Analysis Disjointness Family
fin:ROIAnalysis owl:disjointWith fin:TCOAnalysis , fin:CostBenefitAnalysis .
fin:FixedCost owl:disjointWith fin:VariableCost .
fin:CapitalExpenditure owl:disjointWith fin:OperationalExpenditure .

# Risk Type Disjointness Family
risk:TechnicalRisk owl:disjointWith risk:OrganizationalRisk ,
                                    risk:SecurityRisk ,
                                    risk:ComplianceRisk ,
                                    risk:StrategicRisk ,
                                    risk:FinancialRisk .

risk:OrganizationalRisk owl:disjointWith risk:SecurityRisk ,
                                         risk:ComplianceRisk ,
                                         risk:StrategicRisk ,
                                         risk:FinancialRisk .

risk:SecurityRisk owl:disjointWith risk:ComplianceRisk ,
                                   risk:StrategicRisk ,
                                   risk:FinancialRisk .

# Performance Metric Disjointness Family
perf:ProductivityMetric owl:disjointWith perf:QualityMetric ,
                                         perf:AdoptionMetric ,
                                         perf:BusinessImpactMetric .

perf:QualityMetric owl:disjointWith perf:AdoptionMetric ,
                                    perf:BusinessImpactMetric .

perf:AdoptionMetric owl:disjointWith perf:BusinessImpactMetric .

# Maturity Level Disjointness Family
maturity:InitialLevel owl:disjointWith maturity:RepeatableLevel ,
                                       maturity:DefinedLevel ,
                                       maturity:ManagedLevel ,
                                       maturity:OptimizingLevel .

maturity:RepeatableLevel owl:disjointWith maturity:DefinedLevel ,
                                          maturity:ManagedLevel ,
                                          maturity:OptimizingLevel .

maturity:DefinedLevel owl:disjointWith maturity:ManagedLevel ,
                                       maturity:OptimizingLevel .

maturity:ManagedLevel owl:disjointWith maturity:OptimizingLevel .

# Governance Component Disjointness Family
gov:Policy owl:disjointWith gov:Process , gov:Standard , gov:Guideline .
gov:Process owl:disjointWith gov:Standard , gov:Guideline .
gov:Standard owl:disjointWith gov:Guideline .

# Change Type Disjointness Family
:AdditiveChange owl:disjointWith :BreakingChange , :DeprecatingChange .
:ModifyingChange owl:disjointWith :BreakingChange .
:RefactoringChange owl:disjointWith :BreakingChange .

# Version Type Disjointness Family
:MajorVersion owl:disjointWith :MinorVersion , :PatchVersion .
:MinorVersion owl:disjointWith :PatchVersion .

# Test Type Disjointness Family
:UnitTest owl:disjointWith :IntegrationTest ,
                           :SystemTest ,
                           :PerformanceTest ,
                           :SecurityTest .

:IntegrationTest owl:disjointWith :SystemTest ,
                                  :PerformanceTest ,
                                  :SecurityTest .

:SystemTest owl:disjointWith :PerformanceTest , :SecurityTest .
:PerformanceTest owl:disjointWith :SecurityTest .

# Quality Dimension Disjointness Family
qc:Correctness owl:disjointWith qc:Completeness ,
                                qc:Consistency ,
                                qc:Adaptability ,
                                qc:Usability ,
                                qc:Capacity ,
                                qc:Deepness ,
                                qc:Comprehensiveness .

# Deployment Type Disjointness Family
:OnPremiseDeployment owl:disjointWith :CloudDeployment , :HybridDeployment .
:CloudDeployment owl:disjointWith :HybridDeployment .
:ContainerizedDeployment owl:disjointWith :ServerlessDeployment .

# Agent Role Disjointness Family
ai4se:DeveloperAgent owl:disjointWith ai4se:TesterAgent ,
                                      ai4se:ReviewerAgent ,
                                      ai4se:ArchitectAgent .

ai4se:TesterAgent owl:disjointWith ai4se:ReviewerAgent , ai4se:ArchitectAgent .
ai4se:ReviewerAgent owl:disjointWith ai4se:ArchitectAgent .

# Model Type Disjointness Family
ai4se:TransformerModel owl:disjointWith ai4se:RecurrentModel ,
                                        ai4se:ConvolutionalModel ,
                                        ai4se:ClassicalMLModel .

ai4se:RecurrentModel owl:disjointWith ai4se:ConvolutionalModel ,
                                      ai4se:ClassicalMLModel .

ai4se:ConvolutionalModel owl:disjointWith ai4se:ClassicalMLModel .

#-----------------------------------------------------------------------------
# 5.2 Property Domain and Range Restrictions (50+ properties)
#-----------------------------------------------------------------------------

# AI Tool Properties
ai4se:supportsLanguage rdf:type owl:ObjectProperty ;
    rdfs:label "supports programming language"@en ;
    rdfs:domain ai4se:AIEnhancedTool ;
    rdfs:range ai4se:ProgrammingLanguage .

ai4se:integratesWith rdf:type owl:ObjectProperty ;
    rdfs:label "integrates with"@en ;
    rdfs:domain ai4se:AIEnhancedTool ;
    rdfs:range ai4se:DevelopmentEnvironment .

ai4se:trainedOn rdf:type owl:ObjectProperty ;
    rdfs:label "trained on dataset"@en ;
    rdfs:domain ai4se:AIEnhancedTool ;
    rdfs:range ai4se:TrainingDataset .

# Agentic System Properties
ai4se:orchestrates rdf:type owl:ObjectProperty ;
    rdfs:label "orchestrates agent"@en ;
    rdfs:domain ai4se:AgentOrchestrator ;
    rdfs:range ai4se:SoftwareAgent ;
    owl:inverseOf ai4se:orchestratedBy .

ai4se:orchestratedBy rdf:type owl:ObjectProperty ;
    rdfs:label "orchestrated by"@en ;
    rdfs:domain ai4se:SoftwareAgent ;
    rdfs:range ai4se:AgentOrchestrator .

ai4se:coordinates rdf:type owl:ObjectProperty ;
    rdfs:label "coordinates with agent"@en ;
    rdfs:domain ai4se:SoftwareAgent ;
    rdfs:range ai4se:SoftwareAgent ;
    rdf:type owl:SymmetricProperty .

ai4se:communicatesWith rdf:type owl:ObjectProperty ;
    rdfs:label "communicates with"@en ;
    rdfs:domain ai4se:SoftwareAgent ;
    rdfs:range ai4se:SoftwareAgent ;
    rdf:type owl:SymmetricProperty .

ai4se:delegatesTo rdf:type owl:ObjectProperty ;
    rdfs:label "delegates task to"@en ;
    rdfs:domain ai4se:SoftwareAgent ;
    rdfs:range ai4se:SoftwareAgent ;
    rdf:type owl:TransitiveProperty .

# Model Training Properties
ai4se:usesTrainingMethod rdf:type owl:ObjectProperty ;
    rdfs:label "uses training method"@en ;
    rdfs:domain ai4se:ModelTraining ;
    rdfs:range ai4se:TrainingMethod .

ai4se:producesModel rdf:type owl:ObjectProperty ;
    rdfs:label "produces model"@en ;
    rdfs:domain ai4se:ModelTraining ;
    rdfs:range ai4se:TrainedModel .

ai4se:basedOnModel rdf:type owl:ObjectProperty ;
    rdfs:label "based on pre-trained model"@en ;
    rdfs:domain ai4se:ModelFineTuning ;
    rdfs:range ai4se:PreTrainedModel .

# Portfolio Management Properties
portfolio:hasProject rdf:type owl:ObjectProperty ;
    rdfs:label "has project"@en ;
    rdfs:domain portfolio:AIPortfolio ;
    rdfs:range portfolio:AIAdoptionProject .

portfolio:hasProgram rdf:type owl:ObjectProperty ;
    rdfs:label "has program"@en ;
    rdfs:domain portfolio:AIPortfolio ;
    rdfs:range portfolio:AIProgram .

portfolio:partOfPortfolio rdf:type owl:ObjectProperty ;
    rdfs:label "part of portfolio"@en ;
    rdfs:domain portfolio:AIAdoptionProject ;
    rdfs:range portfolio:AIPortfolio ;
    owl:inverseOf portfolio:hasProject .

# Strategy Properties
strategy:alignsWith rdf:type owl:ObjectProperty ;
    rdfs:label "aligns with strategy"@en ;
    rdfs:domain portfolio:AIAdoptionProject ;
    rdfs:range strategy:AITransformationStrategy ;
    rdf:type owl:TransitiveProperty .

strategy:supportsObjective rdf:type owl:ObjectProperty ;
    rdfs:label "supports objective"@en ;
    rdfs:domain portfolio:AIAdoptionProject ;
    rdfs:range strategy:StrategicObjective .

# Financial Properties
fin:hasROI rdf:type owl:ObjectProperty ;
    rdfs:label "has ROI analysis"@en ;
    rdfs:domain portfolio:AIAdoptionProject ;
    rdfs:range fin:ROIAnalysis ;
    rdf:type owl:FunctionalProperty .

fin:hasTCO rdf:type owl:ObjectProperty ;
    rdfs:label "has TCO analysis"@en ;
    rdfs:domain portfolio:AIAdoptionProject ;
    rdfs:range fin:TCOAnalysis ;
    rdf:type owl:FunctionalProperty .

fin:hasCostBenefitAnalysis rdf:type owl:ObjectProperty ;
    rdfs:label "has cost-benefit analysis"@en ;
    rdfs:domain portfolio:AIAdoptionProject ;
    rdfs:range fin:CostBenefitAnalysis .

fin:totalInvestment rdf:type owl:DatatypeProperty ;
    rdfs:label "total investment amount"@en ;
    rdfs:domain fin:FinancialAnalysis ;
    rdfs:range xsd:decimal .

fin:expectedBenefit rdf:type owl:DatatypeProperty ;
    rdfs:label "expected benefit amount"@en ;
    rdfs:domain fin:FinancialAnalysis ;
    rdfs:range xsd:decimal .

fin:roiPercentage rdf:type owl:DatatypeProperty ;
    rdfs:label "ROI percentage"@en ;
    rdfs:domain fin:ROIAnalysis ;
    rdfs:range xsd:decimal .

# Risk Management Properties
risk:hasRisk rdf:type owl:ObjectProperty ;
    rdfs:label "has identified risk"@en ;
    rdfs:domain portfolio:AIAdoptionProject ;
    rdfs:range risk:AIAdoptionRisk .

risk:mitigatedBy rdf:type owl:ObjectProperty ;
    rdfs:label "mitigated by strategy"@en ;
    rdfs:domain risk:AIAdoptionRisk ;
    rdfs:range risk:MitigationStrategy .

risk:riskSeverity rdf:type owl:DatatypeProperty ;
    rdfs:label "risk severity score"@en ;
    rdfs:domain risk:AIAdoptionRisk ;
    rdfs:range xsd:integer .

risk:likelihood rdf:type owl:DatatypeProperty ;
    rdfs:label "risk likelihood"@en ;
    rdfs:domain risk:AIAdoptionRisk ;
    rdfs:range [ rdf:type rdfs:Datatype ;
                 owl:oneOf ("Low"@en "Medium"@en "High"@en) ] .

# Performance Properties
perf:measuredBy rdf:type owl:ObjectProperty ;
    rdfs:label "measured by indicator"@en ;
    rdfs:domain portfolio:AIAdoptionProject ;
    rdfs:range perf:PerformanceIndicator .

perf:hasKPI rdf:type owl:ObjectProperty ;
    rdfs:label "has KPI"@en ;
    rdfs:domain perf:KPIDashboard ;
    rdfs:range perf:KeyPerformanceIndicator .

perf:targetValue rdf:type owl:DatatypeProperty ;
    rdfs:label "target value"@en ;
    rdfs:domain perf:PerformanceIndicator ;
    rdfs:range xsd:decimal .

perf:actualValue rdf:type owl:DatatypeProperty ;
    rdfs:label "actual value"@en ;
    rdfs:domain perf:PerformanceIndicator ;
    rdfs:range xsd:decimal .

# Maturity Properties
maturity:hasMaturityLevel rdf:type owl:ObjectProperty ;
    rdfs:label "has maturity level"@en ;
    rdfs:domain portfolio:AIAdoptionProject ;
    rdfs:range maturity:MaturityLevel ;
    rdf:type owl:FunctionalProperty .

maturity:assessedBy rdf:type owl:ObjectProperty ;
    rdfs:label "assessed by"@en ;
    rdfs:domain maturity:MaturityLevel ;
    rdfs:range maturity:MaturityAssessment .

# Governance Properties
gov:governanceFramework rdf:type owl:ObjectProperty ;
    rdfs:label "follows governance framework"@en ;
    rdfs:domain portfolio:AIAdoptionProject ;
    rdfs:range gov:GovernanceFramework .

gov:enforcesPolicy rdf:type owl:ObjectProperty ;
    rdfs:label "enforces policy"@en ;
    rdfs:domain gov:GovernanceFramework ;
    rdfs:range gov:AIGovernancePolicy .

gov:hasQualityGate rdf:type owl:ObjectProperty ;
    rdfs:label "has quality gate"@en ;
    rdfs:domain portfolio:AIAdoptionProject ;
    rdfs:range gov:QualityGate .

# Testing Properties
qc:verifiesCompetencyQuestion rdf:type owl:ObjectProperty ;
    rdfs:label "verifies competency question"@en ;
    rdfs:domain :TestCase ;
    rdfs:range :CompetencyQuestion .

:verifiesRequirement rdf:type owl:ObjectProperty ;
    rdfs:label "verifies functional requirement"@en ;
    rdfs:domain :TestCase ;
    rdfs:range :FunctionalRequirement .

:hasVerificationQuery rdf:type owl:ObjectProperty ;
    rdfs:label "has verification query"@en ;
    rdfs:domain :TestCase ;
    rdfs:range :VerificationQuery .

# Glossary Properties
:mapsDomainTermTo rdf:type owl:ObjectProperty ;
    rdfs:label "maps domain term to ontology component"@en ;
    rdfs:domain :TermDefinition ;
    rdfs:range :OntologyComponent .

:hasRelatedTerm rdf:type owl:ObjectProperty ;
    rdfs:label "has related term"@en ;
    rdfs:domain :TermDefinition ;
    rdfs:range :TermDefinition ;
    rdf:type owl:SymmetricProperty .

:hasUsageExample rdf:type owl:DatatypeProperty ;
    rdfs:label "has usage example"@en ;
    rdfs:domain :TermDefinition ;
    rdfs:range xsd:string .

#-----------------------------------------------------------------------------
# 5.3 Cardinality Constraints (30+ restrictions)
#-----------------------------------------------------------------------------

# AI Tool Cardinality Constraints
ai4se:AIEnhancedTool rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty rdfs:label ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] ;
rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty skos:definition ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] ;
rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty ai4se:supportsLanguage ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

# Multi-Agent System Cardinality Constraints
ai4se:MultiAgentSystem rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty ai4se:hasAgent ;
    owl:minCardinality "2"^^xsd:nonNegativeInteger
] ;
rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty ai4se:hasOrchestrator ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

# Portfolio Cardinality Constraints
portfolio:AIPortfolio rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty portfolio:hasProject ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

portfolio:AIAdoptionProject rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty portfolio:projectManager ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] ;
rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty portfolio:startDate ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] ;
rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty strategy:alignsWith ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

# Financial Analysis Cardinality Constraints
fin:ROIAnalysis rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty fin:totalInvestment ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] ;
rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty fin:expectedBenefit ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] ;
rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty fin:roiPercentage ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

# Risk Management Cardinality Constraints
risk:AIAdoptionRisk rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty risk:riskDescription ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] ;
rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty risk:likelihood ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] ;
rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty risk:impact ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] ;
rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty risk:mitigatedBy ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

# Test Case Cardinality Constraints
:TestCase rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasTestID ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] ;
rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :verifiesRequirement ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] ;
rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasVerificationQuery ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] ;
rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasExpectedResult ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

# Competency Question Cardinality Constraints
:CompetencyQuestion rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :questionText ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] ;
rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasVerificationQuery ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

# Term Definition Cardinality Constraints
:TermDefinition rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty rdfs:label ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] ;
rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty skos:definition ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] ;
rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :mapsDomainTermTo ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

#-----------------------------------------------------------------------------
# 5.4 Property Chains for Transitive Inference (20+ chains)
#-----------------------------------------------------------------------------

# Agent orchestration transitivity
ai4se:indirectlyOrchestrates rdf:type owl:ObjectProperty ;
    owl:propertyChainAxiom ( ai4se:orchestrates ai4se:delegatesTo ) .

# Strategy alignment transitivity
strategy:transitivelyAlignsWith rdf:type owl:ObjectProperty , owl:TransitiveProperty ;
    owl:propertyChainAxiom ( strategy:alignsWith strategy:alignsWith ) .

# Risk propagation
risk:indirectlyAffectedBy rdf:type owl:ObjectProperty ;
    owl:propertyChainAxiom ( portfolio:hasProject risk:hasRisk ) .

# Financial relationship chains
fin:contributesToPortfolioROI rdf:type owl:ObjectProperty ;
    owl:propertyChainAxiom ( portfolio:partOfPortfolio fin:hasROI ) .

# Performance measurement chains
perf:portfolioMetric rdf:type owl:ObjectProperty ;
    owl:propertyChainAxiom ( portfolio:hasProject perf:measuredBy ) .

# Testing relationship chains
:indirectlyVerifies rdf:type owl:ObjectProperty ;
    owl:propertyChainAxiom ( :hasTestCase :verifiesRequirement ) .

# Term mapping chains
:termMapsToClass rdf:type owl:ObjectProperty ;
    owl:propertyChainAxiom ( :hasTermDefinition :mapsDomainTermTo ) .

# Governance application chains
gov:subjectToPolicy rdf:type owl:ObjectProperty ;
    owl:propertyChainAxiom ( gov:governanceFramework gov:enforcesPolicy ) .

# Maturity progression
maturity:evolvesTo rdf:type owl:ObjectProperty ;
    owl:propertyChainAxiom ( maturity:hasMaturityLevel maturity:nextLevel ) .

#-----------------------------------------------------------------------------
# 5.5 Functional and Inverse Functional Properties
#-----------------------------------------------------------------------------

# Functional properties (single value)
ai4se:hasModelVersion rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "has model version"@en ;
    rdfs:domain ai4se:TrainedModel ;
    rdfs:range xsd:string .

portfolio:projectManager rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "project manager"@en ;
    rdfs:domain portfolio:AIAdoptionProject ;
    rdfs:range xsd:string .

:hasTestID rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "has test ID"@en ;
    rdfs:domain :TestCase ;
    rdfs:range xsd:string .

# Inverse functional properties (unique identifier)
ai4se:toolIdentifier rdf:type owl:DatatypeProperty , owl:InverseFunctionalProperty ;
    rdfs:label "tool unique identifier"@en ;
    rdfs:domain ai4se:AIEnhancedTool ;
    rdfs:range xsd:string .

portfolio:projectID rdf:type owl:DatatypeProperty , owl:InverseFunctionalProperty ;
    rdfs:label "project unique ID"@en ;
    rdfs:domain portfolio:AIAdoptionProject ;
    rdfs:range xsd:string .

#=============================================================================
# FUNCTIONAL REQUIREMENTS AND COMPETENCY QUESTIONS
#=============================================================================

# Functional Requirement 1
ai4se:FR01_OntologyMetadata rdf:type :FunctionalRequirement ;
    rdfs:label "FR01: Complete Ontology Metadata"@en ;
    :requirementText "Ontology must have complete metadata including title, description, version, dates, and provenance."@en ;
    :hasCompetencyQuestion ai4se:CQ01_WhatIsOntologyPurpose .

ai4se:CQ01_WhatIsOntologyPurpose rdf:type :CompetencyQuestion ;
    rdfs:label "CQ01: What is the purpose and scope of the ontology?"@en ;
    :questionText "What is the purpose and scope of the AI4SE ontology?"@en ;
    :hasVerificationQuery ai4se:VQ01_OntologyDeclaration ;
    :expectedAnswer "AI for Software Engineering - Complete Enhanced Ontology covering AI tools, agentic systems, and enterprise adoption."@en .

# [Additional 24 Functional Requirements with Competency Questions following same pattern]

#=============================================================================
# END OF ENHANCED AI4SE ONTOLOGY v5.0
#=============================================================================
