        portfolio:AIPortfolio a owl:Class .
        portfolio:AIAdoptionProject a owl:Class .
        strategy:AITransformationStrategy a owl:Class .
        gov:GovernanceFramework a owl:Class .
    }
    """@en ;
    :expectedResult "true"^^xsd:boolean .

