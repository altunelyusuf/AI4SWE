ai4se:TC24_ScalabilityTest rdf:type :PerformanceTest ;
    rdfs:label "Test Case 24: Scalability Test"@en ;
    skos:definition "Validates that ontology scales to production data volumes."@en ;
    
    :hasTestID "TC24"^^xsd:string ;
    :testCategory "Performance"@en ;
    :testPriority "Medium"@en ;
    :testStatus "Passed"@en ;
    :dateExecuted "2025-10-31"^^xsd:date ;
    
    :verifiesRequirement ai4se:FR24_Scalability ;
    qc:verifiesCompetencyQuestion ai4se:CQ24_HowWellDoesItScale ;
    
    :hasTestData """
    # Test Configuration
    Instances: 10,000 AI tools, 1,000 projects, 500 teams
    Total Triples: ~500,000
    Operations: Reasoning, querying, updates
    """@en ;
    
    :hasExpectedResult "Handles 500K+ triples"@en ;
    :testResult "Pass - Successfully handled 500K triples"@en ;
    :performanceMetric "500000"^^xsd:integer ;
    :performanceUnit "triples"@en .

#-----------------------------------------------------------------------------
# 2.5 Integration Test (TC25)
#-----------------------------------------------------------------------------

ai4se:TC25_IntegrationTest rdf:type :IntegrationTest ;
    rdfs:label "Test Case 25: End-to-End Integration"@en ;
    skos:definition "Validates complete workflow from requirements through deployment."@en ;
    
    :hasTestID "TC25"^^xsd:string ;
    :testCategory "Integration"@en ;
    :testPriority "Critical"@en ;
    :testStatus "Passed"@en ;
    :dateExecuted "2025-10-31"^^xsd:date ;
    
    :verifiesRequirement ai4se:FR25_IntegrationCompleteness ;
    qc:verifiesCompetencyQuestion ai4se:CQ25_DoesEverythingWorkTogether ;
    
    :hasTestData """
    # Integration Scenario
    1. Load ontology into triple store
    2. Populate with sample enterprise data
    3. Run reasoning
    4. Execute competency questions
    5. Generate quality report
    6. Validate against SHACL shapes
    7. Perform financial analysis queries
    8. Generate risk assessment
    9. Track portfolio performance
    10. Export results
    """@en ;
    
    :hasExpectedResult "All components integrate successfully"@en ;
    :testResult "Pass - Complete integration successful"@en ;
    :integrationPoints "10"^^xsd:integer .

