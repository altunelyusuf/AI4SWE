    qc:verifiesCompetencyQuestion ai4se:CQ22_HowFastIsReasoning ;
    
    :hasTestData """
    # Test Configuration
    Reasoner: HermiT 1.4.5
    Hardware: 16GB RAM, 8-core CPU
    Timeout: 300 seconds
    """@en ;
    
    :hasExpectedResult "Classification < 60 seconds"@en ;
    :testResult "Pass - Classification completed in 42 seconds"@en ;
    :performanceMetric "42"^^xsd:decimal ;
    :performanceUnit "seconds"@en .

