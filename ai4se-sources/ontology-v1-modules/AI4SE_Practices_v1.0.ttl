#=============================================================================
# SECTION 7: PRACTICE INTEGRATION PROPERTIES
#=============================================================================

# --- Object Properties for Practices ---

ai4se:enhancesPractice a owl:ObjectProperty ;
    rdfs:label "enhances practice"@en ;
    rdfs:comment "Indicates AI enhances a software practice"@en ;
    rdfs:domain ai4se:AI4SESSystem ;
    rdfs:range o4se:SoftwarePractice ;
    rdfs:subPropertyOf ai4se:enhances .

ai4se:replacesPractice a owl:ObjectProperty ;
    rdfs:label "replaces practice"@en ;
    rdfs:comment "Indicates AI replaces a manual practice"@en ;
    rdfs:domain ai4se:AI4SESSystem ;
    rdfs:range o4se:SoftwarePractice .

ai4se:complementsPractice a owl:ObjectProperty ;
    rdfs:label "complements practice"@en ;
    rdfs:comment "Indicates AI complements existing practice"@en ;
    rdfs:domain ai4se:AI4SESSystem ;
    rdfs:range o4se:SoftwarePractice .

ai4se:enablesMethodology a owl:ObjectProperty ;
    rdfs:label "enables methodology"@en ;
    rdfs:comment "Indicates AI enables new methodology"@en ;
    rdfs:domain ai4se:AI4SESSystem ;
    rdfs:range o4se:Methodology .

ai4se:improvesMetric a owl:ObjectProperty ;
    rdfs:label "improves metric"@en ;
    rdfs:comment "Indicates AI improves a practice metric"@en ;
    rdfs:domain ai4se:AI4SESSystem ;
    rdfs:range o4se:Metric .

# --- Data Properties for Practices ---

ai4se:practiceAdoptionRate a owl:DatatypeProperty ;
    rdfs:label "practice adoption rate"@en ;
    rdfs:comment "Rate of AI practice adoption"@en ;
    rdfs:domain ai4se:AIEnhancedProcess ;
    rdfs:range xsd:decimal .

ai4se:practiceEffectiveness a owl:DatatypeProperty ;
    rdfs:label "practice effectiveness"@en ;
    rdfs:comment "Effectiveness measure of AI-enhanced practice"@en ;
    rdfs:domain ai4se:AIEnhancedProcess ;
    rdfs:range xsd:decimal .

ai4se:practiceMaturityLevel a owl:DatatypeProperty ;
    rdfs:label "practice maturity level"@en ;
    rdfs:comment "Maturity level of AI practice (1-5)"@en ;
    rdfs:domain ai4se:AIEnhancedProcess ;
    rdfs:range xsd:integer .

ai4se:learningCurveTime a owl:DatatypeProperty ;
    rdfs:label "learning curve time"@en ;
    rdfs:comment "Time to learn AI-enhanced practice"@en ;
    rdfs:domain ai4se:AIEnhancedProcess ;
    rdfs:range xsd:duration .

#=============================================================================
# SECTION 8: COMPETENCY QUESTIONS FOR PRACTICES
#=============================================================================

ai4se:CQ_Practice1 a meta:CompetencyQuestion ;
    rdfs:label "Which AI systems enhance agile practices?"@en ;
    meta:hasVerificationQuery """
        SELECT ?system ?practice WHERE {
            ?system rdfs:subClassOf ai4se:IntelligentAgileSystem .
            ?system ai4se:enhancesPractice ?practice .
        }
    """ .

ai4se:CQ_Practice2 a meta:CompetencyQuestion ;
    rdfs:label "What is the effectiveness of AI-enhanced practices?"@en ;
    meta:hasVerificationQuery """
        SELECT ?practice ?effectiveness WHERE {
            ?practice ai4se:practiceEffectiveness ?effectiveness .
            ?practice rdfs:subClassOf ai4se:AIEnhancedProcess .
        }
    """ .

ai4se:CQ_Practice3 a meta:CompetencyQuestion ;
    rdfs:label "How do AI systems improve DevOps metrics?"@en ;
    meta:hasVerificationQuery """
        SELECT ?system ?metric WHERE {
            ?system rdfs:subClassOf ai4se:IntelligentDevOpsSystem .
            ?system ai4se:improvesMetric ?metric .
        }
    """ .

#=============================================================================
# SECTION 9: FUNCTIONAL REQUIREMENTS FOR PRACTICES
#=============================================================================

ai4se:FR_Practice1 a meta:FunctionalRequirement ;
    rdfs:label "Methodology Coverage"@en ;
    rdfs:comment "Support major SE methodologies with AI enhancement"@en ;
    meta:hasPriority "Critical" ;
    meta:hasTestCase ai4se:TC_MethodologyCoverage .

ai4se:FR_Practice2 a meta:FunctionalRequirement ;
    rdfs:label "Practice Metrics"@en ;
    rdfs:comment "Track effectiveness metrics for AI practices"@en ;
    meta:hasPriority "High" ;
    meta:hasTestCase ai4se:TC_PracticeMetrics .

ai4se:FR_Practice3 a meta:FunctionalRequirement ;
    rdfs:label "Practice Integration"@en ;
    rdfs:comment "Support integration of multiple AI-enhanced practices"@en ;
    meta:hasPriority "High" ;
    meta:hasTestCase ai4se:TC_PracticeIntegration .

#=============================================================================
# SECTION 10: DISJOINTNESS AXIOMS FOR PRACTICES
#=============================================================================

[ a owl:AllDisjointClasses ;
  owl:members ( ai4se:IntelligentAgileSystem
                ai4se:IntelligentDevOpsSystem
                ai4se:QualityIntelligenceSystem
                ai4se:ProjectIntelligenceSystem
                ai4se:CollaborationIntelligenceSystem
                ai4se:DocumentationIntelligenceSystem ) ] .

[ a owl:AllDisjointClasses ;
  owl:members ( ai4se:SprintPlanner
                ai4se:VelocityPredictor
                ai4se:BacklogOptimizer
                ai4se:StoryPointEstimator
                ai4se:RetrospectiveAnalyzer ) ] .

#=============================================================================
# END OF PRACTICES MODULE
#=============================================================================
