@prefix ai4se: <http://www.semanticweb.org/ontologies/2025/AI4SE#> .
@prefix o4se: <http://www.semanticweb.org/ontologies/2025/O4SE#> .
@prefix ai: <http://example.org/o4ai#> .
@prefix meta: <http://example.org/ontology-engineering#> .
@prefix qc: <http://example.org/quality#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

#=============================================================================
# AI4SE - AI-POWERED SOFTWARE ENGINEERING PRACTICES
# MODULE 3: METHODOLOGIES, TECHNIQUES, AND BEST PRACTICES WITH AI
#=============================================================================
# This module defines AI-enhanced software engineering practices, methodologies,
# and techniques including Agile, DevOps, quality assurance, and project management.
#=============================================================================

<http://www.semanticweb.org/ontologies/2025/AI4SE/Practices> rdf:type owl:Ontology ;
    owl:imports <http://www.semanticweb.org/ontologies/2025/AI4SE> ;
    dcterms:title "AI4SE Practices - AI-Powered SE Methodologies"@en ;
    dcterms:created "2025-10-27"^^xsd:date ;
    dcterms:description "Comprehensive representation of AI-enhanced software engineering practices and methodologies"@en .

#=============================================================================
# SECTION 1: AI-ENHANCED AGILE PRACTICES
#=============================================================================

# --- Intelligent Agile Systems ---

ai4se:IntelligentAgileSystem a owl:Class ;
    rdfs:label "Intelligent Agile System"@en ;
    rdfs:comment "AI system supporting agile software development practices"@en ;
    rdfs:subClassOf ai4se:AI4SESSystem ;
    skos:definition "System using AI to enhance agile methodologies and practices"@en .

ai4se:SprintPlanner a owl:Class ;
    rdfs:label "Sprint Planner"@en ;
    rdfs:comment "AI system for intelligent sprint planning"@en ;
    rdfs:subClassOf ai4se:IntelligentAgileSystem ,
                    ai:PlanningSystem .

ai4se:VelocityPredictor a owl:Class ;
    rdfs:label "Velocity Predictor"@en ;
    rdfs:comment "AI system predicting team velocity"@en ;
    rdfs:subClassOf ai4se:IntelligentAgileSystem ,
                    ai:PredictiveAnalytics .

ai4se:BacklogOptimizer a owl:Class ;
    rdfs:label "Backlog Optimizer"@en ;
    rdfs:comment "AI system optimizing product backlog ordering"@en ;
    rdfs:subClassOf ai4se:IntelligentAgileSystem ,
                    ai:OptimizationSystem .

ai4se:StoryPointEstimator a owl:Class ;
    rdfs:label "Story Point Estimator"@en ;
    rdfs:comment "AI system estimating user story complexity"@en ;
    rdfs:subClassOf ai4se:IntelligentAgileSystem ,
                    ai:EstimationSystem .

ai4se:RetrospectiveAnalyzer a owl:Class ;
    rdfs:label "Retrospective Analyzer"@en ;
    rdfs:comment "AI system analyzing sprint retrospectives"@en ;
    rdfs:subClassOf ai4se:IntelligentAgileSystem ,
                    ai:TextAnalytics .

ai4se:ScrumMasterAssistant a owl:Class ;
    rdfs:label "Scrum Master Assistant"@en ;
    rdfs:comment "AI assistant for Scrum Masters"@en ;
    rdfs:subClassOf ai4se:IntelligentAgileSystem ,
                    ai:VirtualAssistant .

# --- AI-Enhanced Agile Practices ---

ai4se:AIEnhancedScrum a owl:Class ;
    rdfs:label "AI-Enhanced Scrum"@en ;
    rdfs:comment "Scrum methodology augmented with AI capabilities"@en ;
    rdfs:subClassOf o4se:Scrum ,
                    ai4se:AIEnhancedProcess .

ai4se:IntelligentKanban a owl:Class ;
    rdfs:label "Intelligent Kanban"@en ;
    rdfs:comment "Kanban system with AI optimization"@en ;
    rdfs:subClassOf o4se:Kanban ,
                    ai4se:AIEnhancedProcess .

ai4se:AdaptiveExtremeProgramming a owl:Class ;
    rdfs:label "Adaptive Extreme Programming"@en ;
    rdfs:comment "XP practices adapted by AI analysis"@en ;
    rdfs:subClassOf o4se:ExtremeProgramming ,
                    ai4se:AIEnhancedProcess .

ai4se:PredictiveAgileMetrics a owl:Class ;
    rdfs:label "Predictive Agile Metrics"@en ;
    rdfs:comment "AI-driven predictive metrics for agile teams"@en ;
    rdfs:subClassOf ai4se:AIEnhancedProcess .

