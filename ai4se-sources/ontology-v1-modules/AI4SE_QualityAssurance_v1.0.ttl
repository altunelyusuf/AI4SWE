#=============================================================================
# SECTION 8: SELF-VALIDATION AXIOMS
#=============================================================================

# Ensure ontology is consistent
[] a owl:AllDifferent ;
   owl:distinctMembers ( 
       ai4se:AI4SESSystem
       ai4se:AIEnhancedProcess
       ai4se:IntegrationPattern
       ai4se:AIPoweredTool
       ai4se:AIInfrastructure
   ) .

# Ensure quality scores are within valid range
ai4se:QualityScoreRestriction a owl:Class ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty qc:hasScore ;
        owl:allValuesFrom [
            a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions (
                [ xsd:minInclusive 0 ]
                [ xsd:maxInclusive 100 ]
            )
        ]
    ] .

#=============================================================================
# END OF QUALITY ASSURANCE MODULE
#=============================================================================
